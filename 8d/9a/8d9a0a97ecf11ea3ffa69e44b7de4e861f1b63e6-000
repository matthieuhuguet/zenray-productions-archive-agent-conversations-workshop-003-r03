{"parentUuid":"1c423151-8207-48c3-bad7-eb1f2d554af4","isSidechain":false,"promptId":"53e73537-e2ec-4a70-8fbe-e392f85066b0","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C7XGvrzxcPCPcDYLdyzR2o","type":"tool_result","content":"1\t{\"groups\": [\n2\t{\"name\": \"B1 G1 — Aborder sans être lourd\", \"items\": [\n3\t{\"jp\": \"すみません、ちょっといいですか？\", \"romaji\": \"sumimasen, chotto ii desu ka?\", \"meaning\": \"excusez-moi, je peux vous déranger deux secondes ?\", \"lit\": \"l'ouverture universelle vers un inconnu\", \"register\": \"◇\", \"note\": \"revu (terrain jour 3)\", \"dial\": \"A: すみません、ちょっといいですか？\\nB: はい、どうぞ。\"},\n4\t{\"jp\": \"今（いま）、大丈夫（だいじょうぶ）？\", \"romaji\": \"ima, daijoubu?\", \"meaning\": \"t'as deux minutes, là ?\", \"lit\": \"« maintenant, ça va ? »\", \"manual\": \"今、お時間ありますか\", \"register\": \"○\", \"dial\": \"A: 今（いま）、大丈夫（だいじょうぶ）？\\nB: うん、どうしたの？\"},\n5\t{\"jp\": \"ここ、空（あ）いてますか？\", \"romaji\": \"koko, aitemasu ka?\", \"meaning\": \"cette place est libre ? (bar, comptoir : LE point d'entrée)\", \"manual\": \"こちらの席は空いていますか\", \"register\": \"◇\", \"dial\": \"A: ここ、空（あ）いてますか？\\nB: どうぞどうぞ。\"},\n6\t{\"jp\": \"隣（となり）、いいですか？\", \"romaji\": \"tonari, ii desu ka?\", \"meaning\": \"je peux m'asseoir à côté ?\", \"register\": \"◇\", \"dial\": \"A: 隣（となり）、いいですか？\\nB: はい、もちろん。\"},\n7\t{\"jp\": \"よく来（く）るんですか？\", \"romaji\": \"yoku kurun desu ka?\", \"meaning\": \"vous venez souvent ici ? (cliché mais fonctionne)\", \"manual\": \"よくいらっしゃるのですか\", \"register\": \"◇\", \"dial\": \"A: よく来（く）るんですか？\\nB: 週（しゅう）1くらいですね。\"},\n8\t{\"jp\": \"それ、おいしそうですね\", \"romaji\": \"sore, oishisou desu ne\", \"meaning\": \"ça a l'air bon, ce que vous avez pris (ouvre via la bouffe, naturel au comptoir)\", \"register\": \"◇\", \"dial\": \"A: それ、おいしそうですね。何（なん）ですか？\\nB: 煮込（にこ）みです。おすすめですよ。\"},\n9\t{\"jp\": \"初（はじ）めて来（き）たんですけど\", \"romaji\": \"hajimete kitan desu kedo\", \"meaning\": \"c'est la première fois que je viens… (invite l'autre à conseiller)\", \"lit\": \"le けど laisse la porte ouverte\", \"register\": \"◇\", \"dial\": \"A: 初（はじ)めて来（き）たんですけど、何（なに）がおすすめですか？\\nB: ここはレモンサワーがうまいよ。\"},\n10\t{\"jp\": \"日本語（にほんご）、勉強中（べんきょうちゅう）なんです\", \"romaji\": \"nihongo benkyouchuu nan desu\", \"meaning\": \"j'apprends le japonais (ta meilleure carte : déclenche la bienveillance)\", \"register\": \"◇\", \"dial\": \"A: 日本語（にほんご）、勉強中（べんきょうちゅう）なんです。\\nB: え、上手（じょうず）ですね！\"},\n11\t{\"jp\": \"間違（まちが）ってたら教（おし）えてください\", \"romaji\": \"machigattetara oshiete kudasai\", \"meaning\": \"corrigez-moi si je me trompe\", \"register\": \"◇\", \"dial\": \"A: 間違（まちが）ってたら教（おし）えてください。\\nB: いいですよ、頑張（がんば）って！\"},\n12\t{\"jp\": \"フランスから来（き）ました\", \"romaji\": \"furansu kara kimashita\", \"meaning\": \"je viens de France (déclencheur de conversation garanti)\", \"register\": \"◇\", \"note\": \"revu (jiko shoukai)\", \"dial\": \"A: どちらから？\\nB: フランスから来（き）ました。\"},\n13\t{\"jp\": \"え、なんて言（い）うんですか、これ\", \"romaji\": \"e, nante iun desu ka, kore\", \"meaning\": \"comment on dit, ça ? (montre du doigt = apprend + connecte)\", \"register\": \"◇\", \"dial\": \"A: これ、なんて言（い）うんですか？\\nB: 「おしぼり」です。\"},\n14\t{\"jp\": \"声（こえ）かけてもいいですか？\", \"romaji\": \"koe kaketemo ii desu ka?\", \"meaning\": \"je peux vous adresser la parole ? (très direct, à doser)\", \"lit\": \"声をかける = interpeller\", \"register\": \"◇\", \"note\": \"⚠️ formel-direct, mieux en événement qu'en rue\", \"dial\": \"A: あの、声（こえ）かけてもいいですか？\\nB: はい？\"},\n15\t{\"jp\": \"写真（しゃしん）、撮（と）りましょうか？\", \"romaji\": \"shashin, torimashou ka?\", \"meaning\": \"je vous prends en photo ? (service = pont social parfait)\", \"register\": \"◇\", \"dial\": \"A: 写真（しゃしん）、撮（と）りましょうか？\\nB: え、いいんですか？ありがとうございます！\"},\n16\t{\"jp\": \"一緒（いっしょ）にどうですか？\", \"romaji\": \"issho ni dou desu ka?\", \"meaning\": \"ça vous dit de vous joindre à nous ?\", \"register\": \"◇\", \"dial\": \"A: よかったら一緒（いっしょ）にどうですか？\\nB: いいんですか？じゃあお言葉（ことば）に甘（あま）えて。\"},\n17\t{\"jp\": \"お疲（つか）れさまです\", \"romaji\": \"otsukaresama desu\", \"meaning\": \"bonjour/bonsoir entre gens qui « travaillent » (salle de sport, coworking, événement)\", \"lit\": \"salut universel du monde actif\", \"register\": \"◇\", \"dial\": \"A: お疲（つか）れさまです。\\nB: お疲（つか）れさまです。今日（きょう）も来（き）てますね。\"},\n18\t{\"jp\": \"いつもこの時間（じかん）ですか？\", \"romaji\": \"itsumo kono jikan desu ka?\", \"meaning\": \"vous venez toujours à cette heure ? (gym, café : reconnaît un habitué)\", \"register\": \"◇\", \"dial\": \"A: いつもこの時間（じかん）ですか？\\nB: そうですね、仕事（しごと）帰（がえ）りに。\"}\n19\t]},\n20\t{\"name\": \"B1 G2 — Se présenter comme un humain (pas le script scolaire)\", \"items\": [\n21\t{\"jp\": \"マチューです。呼（よ）びにくかったら「マット」で\", \"romaji\": \"Machuu desu. yobinikukattara Matto de\", \"meaning\": \"moi c'est Matthieu. Si c'est dur à dire : Matt\", \"lit\": \"offrir un surnom = cadeau social au Japon\", \"register\": \"○\", \"dial\": \"A: お名前（なまえ）は？\\nB: マチューです。呼（よ）びにくかったら「マット」で。\"},\n22\t{\"jp\": \"3Dの仕事（しごと）をしてます\", \"romaji\": \"surii dii no shigoto wo shitemasu\", \"meaning\": \"je bosse dans la 3D\", \"lit\": \"version simple de tech artist\", \"manual\": \"3Dの仕事をしています\", \"register\": \"◇\", \"dial\": \"A: お仕事（しごと）は？\\nB: 3Dの仕事（しごと）をしてます。ゲームとか映像（えいぞう）の。\"},\n23\t{\"jp\": \"ゲームを作（つく）る仕事（しごと）です\", \"romaji\": \"geemu wo tsukuru shigoto desu\", \"meaning\": \"je fais des jeux vidéo (la version qui fait briller les yeux)\", \"register\": \"◇\", \"dial\": \"A: へえ、どんな仕事（しごと）？\\nB: ゲームを作（つく）る仕事（しごと）です。\"},\n24\t{\"jp\": \"東京（とうきょう）に住（す）んで1か月（いっかげつ）です\", \"romaji\": \"toukyou ni sunde ikkagetsu desu\", \"meaning\": \"ça fait un mois que je vis à Tokyo\", \"register\": \"◇\", \"dial\": \"A: 旅行（りょこう）ですか？\\nB: いえ、東京（とうきょう）に住（す）んで1か月（いっかげつ）です。\"},\n25\t{\"jp\": \"日本（にほん）のゲームで育（そだ）ちました\", \"romaji\": \"nihon no geemu de sodachimashita\", \"meaning\": \"j'ai grandi avec les jeux japonais (crée le lien instantané)\", \"register\": \"◇\", \"dial\": \"A: なんで日本（にほん）に？\\nB: 日本（にほん）のゲームで育（そだ）ちました。憧（あこが）れの国（くに）です。\"},\n26\t{\"jp\": \"〜が好（す）きで、日本（にほん）に来（き）ました\", \"romaji\": \"~ ga suki de, nihon ni kimashita\", \"meaning\": \"je suis venu au Japon par amour de… (moule à compléter)\", \"register\": \"◇\", \"dial\": \"A: きっかけは？\\nB: アニメが好（す）きで、日本（にほん）に来（き）ました。\"},\n27\t{\"jp\": \"まだ日本語（にほんご）へたですけど\", \"romaji\": \"mada nihongo heta desu kedo\", \"meaning\": \"mon japonais est encore mauvais, mais… (humilité = points)\", \"register\": \"◇\", \"dial\": \"A: 日本語（にほんご）うまいですね。\\nB: いえいえ、まだへたですけど、頑張（がんば）ってます。\"},\n28\t{\"jp\": \"何（なん)て呼（よ）べばいいですか？\", \"romaji\": \"nante yobeba ii desu ka?\", \"meaning\": \"je vous appelle comment ?\", \"lit\": \"demande le prénom SANS demander « votre nom » frontal\", \"register\": \"◇\", \"dial\": \"A: 何（なん）て呼（よ）べばいいですか？\\nB: ユウキでいいよ。\"},\n29\t{\"jp\": \"下（した）の名前（なまえ）は？\", \"romaji\": \"shita no namae wa?\", \"meaning\": \"et ton prénom ? (une fois le nom de famille donné)\", \"lit\": \"« le nom du bas » = prénom\", \"register\": \"○\", \"dial\": \"A: 田中（たなか）です。\\nB: 下（した）の名前（なまえ）は？\\nA: ヒロシ。\"},\n30\t{\"jp\": \"おいくつですか？…って聞（き）いていいのかな\", \"romaji\": \"oikutsu desu ka... tte kiite ii no kana\", \"meaning\": \"vous avez quel âge ?… si je peux me permettre\", \"lit\": \"l'âge se demande, mais avec une pincette\", \"register\": \"◇\", \"dial\": \"A: おいくつですか？って聞（き）いていいのかな。\\nB: あはは、28です。\"},\n31\t{\"jp\": \"タメ口（ぐち）でいいよ\", \"romaji\": \"tameguchi de ii yo\", \"meaning\": \"tu peux me tutoyer (= parler casual)\", \"lit\": \"タメ = même âge → parler d'égal à égal\", \"register\": \"○\", \"note\": \"à dire ou à recevoir : le feu vert du casual\", \"dial\": \"A: 敬語（けいご）じゃなくていいよ、タメ口（ぐち）で。\\nB: あ、じゃあそうする！\"},\n32\t{\"jp\": \"敬語（けいご）、まだむずいんで\", \"romaji\": \"keigo, mada muzuin de\", \"meaning\": \"le keigo, c'est encore chaud pour moi (excuse ton casual avec le sourire)\", \"register\": \"○\", \"dial\": \"A: 敬語（けいご）、まだむずいんで、変（へん）だったらごめんなさい。\\nB: 全然（ぜんぜん）大丈夫（だいじょうぶ）！\"},\n33\t{\"jp\": \"出身（しゅっしん）はどちらですか？\", \"romaji\": \"shusshin wa dochira desu ka?\", \"meaning\": \"vous êtes d'où ? (poli, passe-partout)\", \"manual\": \"ご出身はどちらですか\", \"register\": \"◇\", \"dial\": \"A: 出身（しゅっしん）はどちらですか？\\nB: 大阪（おおさか）です。\"},\n34\t{\"jp\": \"どこ住（す）み？\", \"romaji\": \"doko zumi?\", \"meaning\": \"t'habites où ? (casual, entre jeunes)\", \"lit\": \"どこに住んでるの ultra-réduit\", \"manual\": \"どこに住んでいますか\", \"register\": \"○\", \"note\": \"jeune ; avec inconnu poli, préférer la forme longue\", \"dial\": \"A: どこ住（す）み？\\nB: 中野（なかの）。\"},\n35\t{\"jp\": \"趣味（しゅみ）とかあるんですか？\", \"romaji\": \"shumi toka arun desu ka?\", \"meaning\": \"t'as des hobbies ? (le とか adoucit)\", \"register\": \"◇\", \"dial\": \"A: 趣味（しゅみ）とかあるんですか？\\nB: 最近（さいきん）はサウナですね。\"},\n36\t{\"jp\": \"僕（ぼく）もです！\", \"romaji\": \"boku mo desu!\", \"meaning\": \"moi aussi ! (l'arme du lien)\", \"register\": \"◇\", \"note\": \"♂ ; ♀ : わたしも\", \"dial\": \"A: ゲーム好（す）きなんです。\\nB: 僕（ぼく）もです！何（なに）やってます？\"}\n37\t]},\n38\t{\"name\": \"B1 G3 — あいづち : montrer qu'on écoute (le moteur de TOUTE conversation)\", \"items\": [\n39\t{\"jp\": \"へえ\", \"romaji\": \"hee\", \"meaning\": \"ah ouais ? (intérêt neutre, ton montant = plus d'intérêt)\", \"register\": \"○\", \"dial\": \"A: 昔（むかし）、京都（きょうと）に住（す）んでたんだ。\\nB: へえ、いいなあ。\"},\n40\t{\"jp\": \"うんうん\", \"romaji\": \"un un\", \"meaning\": \"oui oui, je suis (hoche la tête sonore)\", \"register\": \"○\", \"dial\": \"A: それでね、駅（えき）着（つ）いたら…\\nB: うんうん。\"},\n41\t{\"jp\": \"そうなんですね\", \"romaji\": \"sou nan desu ne\", \"meaning\": \"ah, je vois (poli, chaleureux)\", \"manual\": \"そうですか\", \"register\": \"◇\", \"dial\": \"A: 実（じつ）は転職（てんしょく）したんです。\\nB: そうなんですね！おめでとうございます。\"},\n42\t{\"jp\": \"まじですか\", \"romaji\": \"maji desu ka\", \"meaning\": \"sérieux ?! (poli-casual hybride, très 20-30 ans)\", \"register\": \"○\", \"dial\": \"A: 宝（たから）くじ当（あ）たったんですよ。\\nB: え、まじですか。\"},\n43\t{\"jp\": \"うそ！\", \"romaji\": \"uso!\", \"meaning\": \"non ?! / pas possible !\", \"lit\": \"« mensonge ! » = incrédulité, pas accusation\", \"register\": \"○\", \"dial\": \"A: 明日（あした）から3連休（さんれんきゅう）だって。\\nB: うそ！最高（さいこう）じゃん。\"},\n44\t{\"jp\": \"え〜！\", \"romaji\": \"ee~!\", \"meaning\": \"quoi ?! / nooon ! (surprise, l'allongement fait tout)\", \"register\": \"○\", \"dial\": \"A: 猫（ねこ）5匹（ごひき）飼（か）ってる。\\nB: え〜！見（み）たい！\"},\n45\t{\"jp\": \"それで？\", \"romaji\": \"sore de?\", \"meaning\": \"et alors, la suite ? (relance active)\", \"register\": \"○\", \"dial\": \"A: 告白（こくはく）したんだけど…\\nB: それで？！\"},\n46\t{\"jp\": \"どういうこと？\", \"romaji\": \"dou iu koto?\", \"meaning\": \"comment ça ? (demande le détail, montre l'intérêt)\", \"register\": \"○\", \"dial\": \"A: 実（じつ）は会社（かいしゃ）やめた。\\nB: え、どういうこと？\"},\n47\t{\"jp\": \"いいなあ\", \"romaji\": \"ii naa\", \"meaning\": \"la chance ! / j'envie\", \"register\": \"○\", \"dial\": \"A: 来週（らいしゅう）沖縄（おきなわ）行（い）く。\\nB: いいなあ〜。\"},\n48\t{\"jp\": \"大変（たいへん）でしたね\", \"romaji\": \"taihen deshita ne\", \"meaning\": \"ça a dû être dur (empathie polie)\", \"register\": \"◇\", \"dial\": \"A: 終電（しゅうでん）逃（のが）して歩（ある）いて帰（かえ）った。\\nB: 大変（たいへん）でしたね…\"},\n49\t{\"jp\": \"わかります\", \"romaji\": \"wakarimasu\", \"meaning\": \"je comprends (empathie, poli)\", \"register\": \"◇\", \"dial\": \"A: 満員電車（まんいんでんしゃ）、きついです。\\nB: わかります。\"},\n50\t{\"jp\": \"ですよね\", \"romaji\": \"desu yone\", \"meaning\": \"hein, n'est-ce pas (accord poli-casual)\", \"register\": \"◇\", \"dial\": \"A: この店（みせ）、いい雰囲気（ふんいき）ですね。\\nB: ですよね。\"},\n51\t{\"jp\": \"たしかに！\", \"romaji\": \"tashika ni!\", \"meaning\": \"ah oui, vu comme ça ! (concède avec énergie)\", \"register\": \"○\", \"note\": \"revu (L49)\", \"dial\": \"A: 歩（ある）いた方（ほう）が早（はや）いんじゃない？\\nB: たしかに！\"},\n52\t{\"jp\": \"なるほど\", \"romaji\": \"naruhodo\", \"meaning\": \"je vois / logique\", \"register\": \"◇\", \"note\": \"⚠️ éviter en boucle avec un supérieur, ça fait mécanique\", \"dial\": \"A: ここを押（お）すと開（あ）くんです。\\nB: なるほど！\"},\n53\t{\"jp\": \"すごいですね！\", \"romaji\": \"sugoi desu ne!\", \"meaning\": \"impressionnant ! (compliment réflexe, toujours bien reçu)\", \"register\": \"◇\", \"dial\": \"A: フルマラソン走（はし）りました。\\nB: すごいですね！\"},\n54\t{\"jp\": \"初（はじ）めて聞（き）きました\", \"romaji\": \"hajimete kikimashita\", \"meaning\": \"première fois que j'entends ça ! (valorise l'autre)\", \"register\": \"◇\", \"dial\": \"A: 実（じつ）は納豆（なっとう）って外国産（がいこくさん）が多（おお）いんですよ。\\nB: え、初（はじ）めて聞（き）きました。\"}\n55\t]},\n56\t{\"name\": \"B1 G4 — Poser des questions qui relancent\", \"items\": [\n57\t{\"jp\": \"最近（さいきん）どうですか？\", \"romaji\": \"saikin dou desu ka?\", \"meaning\": \"ça va, en ce moment ? (retrouvailles)\", \"register\": \"◇\", \"dial\": \"A: 最近（さいきん）どうですか？\\nB: ぼちぼちですね。\"},\n58\t{\"jp\": \"休（やす）みの日（ひ）、何（なに）してるんですか？\", \"romaji\": \"yasumi no hi, nani shiterun desu ka?\", \"meaning\": \"tu fais quoi de tes jours off ? (LA question passe-partout)\", \"register\": \"◇\", \"dial\": \"A: 休（やす）みの日（ひ）、何（なに）してるんですか？\\nB: だいたいカフェ巡（めぐ）りかな。\"},\n59\t{\"jp\": \"それ、どこで買（か）ったんですか？\", \"romaji\": \"sore, doko de kattan desu ka?\", \"meaning\": \"vous l'avez acheté où ? (compliment déguisé en question)\", \"register\": \"◇\", \"dial\": \"A: その靴（くつ）いいですね。どこで買（か）ったんですか？\\nB: 下北（しもきた）の古着屋（ふるぎや）で。\"},\n60\t{\"jp\": \"おすすめあります？\", \"romaji\": \"osusume arimasu?\", \"meaning\": \"une reco ? (bouffe, quartier, musique : tout marche)\", \"register\": \"◇\", \"note\": \"revu (L48)\", \"dial\": \"A: この辺（へん）でおすすめあります？\\nB: 角（かど）の焼鳥屋（やきとりや）、最高（さいこう）だよ。\"},\n61\t{\"jp\": \"どうやって知（し）り合（あ）ったんですか？\", \"romaji\": \"dou yatte shiriattan desu ka?\", \"meaning\": \"vous vous êtes connus comment ? (à un groupe)\", \"register\": \"◇\", \"dial\": \"A: お二人（ふたり）、どうやって知（し）り合（あ）ったんですか？\\nB: 大学（だいがく）の同級生（どうきゅうせい）なんです。\"},\n62\t{\"jp\": \"地元（じもと）はどんなところ？\", \"romaji\": \"jimoto wa donna tokoro?\", \"meaning\": \"c'est comment, ta région ? (les Japonais adorent parler du 地元)\", \"register\": \"○\", \"dial\": \"A: 地元（じもと）はどんなところ？\\nB: 何（なに）もない田舎（いなか）だよ〜。でも飯（めし）はうまい。\"},\n63\t{\"jp\": \"それって、どんな感（かん）じですか？\", \"romaji\": \"sore tte, donna kanji desu ka?\", \"meaning\": \"et c'est comment ? (relance ouverte universelle)\", \"register\": \"◇\", \"dial\": \"A: 夜勤（やきん）なんです。\\nB: それって、どんな感（かん）じですか？\"},\n64\t{\"jp\": \"なんでまた？\", \"romaji\": \"nande mata?\", \"meaning\": \"ah bon, comment ça se fait ? (curiosité amusée)\", \"lit\": \"また adoucit le pourquoi\", \"register\": \"○\", \"dial\": \"A: 来月（らいげつ）から福岡（ふくおか）です。\\nB: え、なんでまた？\"},\n65\t{\"jp\": \"詳（くわ）しいですね！\", \"romaji\": \"kuwashii desu ne!\", \"meaning\": \"vous vous y connaissez ! (compliment qui fait parler)\", \"register\": \"◇\", \"dial\": \"A: この日本酒（にほんしゅ）は山形（やまがた）の…\\nB: 詳（くわ）しいですね！\"},\n66\t{\"jp\": \"例（たと）えば？\", \"romaji\": \"tatoeba?\", \"meaning\": \"par exemple ? (relance courte)\", \"register\": \"○\", \"dial\": \"A: 変（へん）な客（きゃく）多（おお）いんだよ。\\nB: 例（たと）えば？\"},\n67\t{\"jp\": \"逆（ぎゃく）に〜はどうですか？\", \"romaji\": \"gyaku ni ~ wa dou desu ka?\", \"meaning\": \"et vous, alors ? (retourne la question, très naturel)\", \"lit\": \"逆に = à l'inverse, tic verbal des 20-30 ans\", \"register\": \"○\", \"dial\": \"A: フランスってパン毎日（まいにち）？\\nB: まあね。逆（ぎゃく）に日本（にほん）は毎日（まいにち）お米（こめ）？\"},\n68\t{\"jp\": \"ずっと気（き）になってたんですけど\", \"romaji\": \"zutto ki ni nattetan desu kedo\", \"meaning\": \"ça m'intriguait depuis un moment… (introduit une question personnelle)\", \"register\": \"◇\", \"dial\": \"A: ずっと気（き）になってたんですけど、そのタトゥー、意味（いみ）あるんですか？\\nB: お、気（き）づいた？\"},\n69\t{\"jp\": \"仕事（しごと）、楽（たの）しいですか？\", \"romaji\": \"shigoto, tanoshii desu ka?\", \"meaning\": \"tu te plais dans ton boulot ? (plus humain que « quel est votre métier »)\", \"register\": \"◇\", \"dial\": \"A: 仕事（しごと）、楽（たの）しいですか？\\nB: うーん、半々（はんはん）かな（笑）\"},\n70\t{\"jp\": \"今度（こんど）教（おし）えてください\", \"romaji\": \"kondo oshiete kudasai\", \"meaning\": \"il faudra me montrer ça un jour (crée un futur prétexte)\", \"register\": \"◇\", \"dial\": \"A: ボルダリングやってるんです。\\nB: いいなあ、今度（こんど）教（おし）えてください。\"},\n71\t{\"jp\": \"続（つづ）きは？\", \"romaji\": \"tsuzuki wa?\", \"meaning\": \"et la suite ? (quand l'histoire s'arrête)\", \"register\": \"○\", \"dial\": \"A: …で、その話（はなし）はまた今度（こんど）。\\nB: え、続（つづ）きは？！\"},\n72\t{\"jp\": \"私（わたし）だけ？\", \"romaji\": \"watashi dake?\", \"meaning\": \"il y a que moi qui… ? (auto-dérision qui invite l'accord)\", \"register\": \"○\", \"dial\": \"A: 夏（なつ）より冬（ふゆ）が好（す）きなの、私（わたし）だけ？\\nB: いや、わかるよ。\"}\n73\t]}\n74\t]}\n75\t"}]},"uuid":"3a8688ac-6e32-4dc3-8a28-bb0760f7c1d4","timestamp":"2026-07-08T15:14:21.603Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/zenray/Create/Build/Memory/Japanese/Lessons/StreetJapanese/specs/m2_part1.json","content":"{\"groups\": [\n{\"name\": \"B1 G1 — Aborder sans être lourd\", \"items\": [\n{\"jp\": \"すみません、ちょっといいですか？\", \"romaji\": \"sumimasen, chotto ii desu ka?\", \"meaning\": \"excusez-moi, je peux vous déranger deux secondes ?\", \"lit\": \"l'ouverture universelle vers un inconnu\", \"register\": \"◇\", \"note\": \"revu (terrain jour 3)\", \"dial\": \"A: すみません、ちょっといいですか？\\nB: はい、どうぞ。\"},\n{\"jp\": \"今（いま）、大丈夫（だいじょうぶ）？\", \"romaji\": \"ima, daijoubu?\", \"meaning\": \"t'as deux minutes, là ?\", \"lit\": \"« maintenant, ça va ? »\", \"manual\": \"今、お時間ありますか\", \"register\": \"○\", \"dial\": \"A: 今（いま）、大丈夫（だいじょうぶ）？\\nB: うん、どうしたの？\"},\n{\"jp\": \"ここ、空（あ）いてますか？\", \"romaji\": \"koko, aitemasu ka?\", \"meaning\": \"cette place est libre ? (bar, comptoir : LE point d'entrée)\", \"manual\": \"こちらの席は空いていますか\", \"register\": \"◇\", \"dial\": \"A: ここ、空（あ）いてますか？\\nB: どうぞどうぞ。\"},\n{\"jp\": \"隣（となり）、いいですか？\", \"romaji\": \"tonari, ii desu ka?\", \"meaning\": \"je peux m'asseoir à côté ?\", \"register\": \"◇\", \"dial\": \"A: 隣（となり）、いいですか？\\nB: はい、もちろん。\"},\n{\"jp\": \"よく来（く）るんですか？\", \"romaji\": \"yoku kurun desu ka?\", \"meaning\": \"vous venez souvent ici ? (cliché mais fonctionne)\", \"manual\": \"よくいらっしゃるのですか\", \"register\": \"◇\", \"dial\": \"A: よく来（く）るんですか？\\nB: 週（しゅう）1くらいですね。\"},\n{\"jp\": \"それ、おいしそうですね\", \"romaji\": \"sore, oishisou desu ne\", \"meaning\": \"ça a l'air bon, ce que vous avez pris (ouvre via la bouffe, naturel au comptoir)\", \"register\": \"◇\", \"dial\": \"A: それ、おいしそうですね。何（なん）ですか？\\nB: 煮込（にこ）みです。おすすめですよ。\"},\n{\"jp\": \"初（はじ）めて来（き）たんですけど\", \"romaji\": \"hajimete kitan desu kedo\", \"meaning\": \"c'est la première fois que je viens… (invite l'autre à conseiller)\", \"lit\": \"le けど laisse la porte ouverte\", \"register\": \"◇\", \"dial\": \"A: 初（はじ)めて来（き）たんですけど、何（なに）がおすすめですか？\\nB: ここはレモンサワーがうまいよ。\"},\n{\"jp\": \"日本語（にほんご）、勉強中（べんきょうちゅう）なんです\", \"romaji\": \"nihongo benkyouchuu nan desu\", \"meaning\": \"j'apprends le japonais (ta meilleure carte : déclenche la bienveillance)\", \"register\": \"◇\", \"dial\": \"A: 日本語（にほんご）、勉強中（べんきょうちゅう）なんです。\\nB: え、上手（じょうず）ですね！\"},\n{\"jp\": \"間違（まちが）ってたら教（おし）えてください\", \"romaji\": \"machigattetara oshiete kudasai\", \"meaning\": \"corrigez-moi si je me trompe\", \"register\": \"◇\", \"dial\": \"A: 間違（まちが）ってたら教（おし）えてください。\\nB: いいですよ、頑張（がんば）って！\"},\n{\"jp\": \"フランスから来（き）ました\", \"romaji\": \"furansu kara kimashita\", \"meaning\": \"je viens de France (déclencheur de conversation garanti)\", \"register\": \"◇\", \"note\": \"revu (jiko shoukai)\", \"dial\": \"A: どちらから？\\nB: フランスから来（き）ました。\"},\n{\"jp\": \"え、なんて言（い）うんですか、これ\", \"romaji\": \"e, nante iun desu ka, kore\", \"meaning\": \"comment on dit, ça ? (montre du doigt = apprend + connecte)\", \"register\": \"◇\", \"dial\": \"A: これ、なんて言（い）うんですか？\\nB: 「おしぼり」です。\"},\n{\"jp\": \"声（こえ）かけてもいいですか？\", \"romaji\": \"koe kaketemo ii desu ka?\", \"meaning\": \"je peux vous adresser la parole ? (très direct, à doser)\", \"lit\": \"声をかける = interpeller\", \"register\": \"◇\", \"note\": \"⚠️ formel-direct, mieux en événement qu'en rue\", \"dial\": \"A: あの、声（こえ）かけてもいいですか？\\nB: はい？\"},\n{\"jp\": \"写真（しゃしん）、撮（と）りましょうか？\", \"romaji\": \"shashin, torimashou ka?\", \"meaning\": \"je vous prends en photo ? (service = pont social parfait)\", \"register\": \"◇\", \"dial\": \"A: 写真（しゃしん）、撮（と）りましょうか？\\nB: え、いいんですか？ありがとうございます！\"},\n{\"jp\": \"一緒（いっしょ）にどうですか？\", \"romaji\": \"issho ni dou desu ka?\", \"meaning\": \"ça vous dit de vous joindre à nous ?\", \"register\": \"◇\", \"dial\": \"A: よかったら一緒（いっしょ）にどうですか？\\nB: いいんですか？じゃあお言葉（ことば）に甘（あま）えて。\"},\n{\"jp\": \"お疲（つか）れさまです\", \"romaji\": \"otsukaresama desu\", \"meaning\": \"bonjour/bonsoir entre gens qui « travaillent » (salle de sport, coworking, événement)\", \"lit\": \"salut universel du monde actif\", \"register\": \"◇\", \"dial\": \"A: お疲（つか）れさまです。\\nB: お疲（つか）れさまです。今日（きょう）も来（き）てますね。\"},\n{\"jp\": \"いつもこの時間（じかん）ですか？\", \"romaji\": \"itsumo kono jikan desu ka?\", \"meaning\": \"vous venez toujours à cette heure ? (gym, café : reconnaît un habitué)\", \"register\": \"◇\", \"dial\": \"A: いつもこの時間（じかん）ですか？\\nB: そうですね、仕事（しごと）帰（がえ）りに。\"}\n]},\n{\"name\": \"B1 G2 — Se présenter comme un humain (pas le script scolaire)\", \"items\": [\n{\"jp\": \"マチューです。呼（よ）びにくかったら「マット」で\", \"romaji\": \"Machuu desu. yobinikukattara Matto de\", \"meaning\": \"moi c'est Matthieu. Si c'est dur à dire : Matt\", \"lit\": \"offrir un surnom = cadeau social au Japon\", \"register\": \"○\", \"dial\": \"A: お名前（なまえ）は？\\nB: マチューです。呼（よ）びにくかったら「マット」で。\"},\n{\"jp\": \"3Dの仕事（しごと）をしてます\", \"romaji\": \"surii dii no shigoto wo shitemasu\", \"meaning\": \"je bosse dans la 3D\", \"lit\": \"version simple de tech artist\", \"manual\": \"3Dの仕事をしています\", \"register\": \"◇\", \"dial\": \"A: お仕事（しごと）は？\\nB: 3Dの仕事（しごと）をしてます。ゲームとか映像（えいぞう）の。\"},\n{\"jp\": \"ゲームを作（つく）る仕事（しごと）です\", \"romaji\": \"geemu wo tsukuru shigoto desu\", \"meaning\": \"je fais des jeux vidéo (la version qui fait briller les yeux)\", \"register\": \"◇\", \"dial\": \"A: へえ、どんな仕事（しごと）？\\nB: ゲームを作（つく）る仕事（しごと）です。\"},\n{\"jp\": \"東京（とうきょう）に住（す）んで1か月（いっかげつ）です\", \"romaji\": \"toukyou ni sunde ikkagetsu desu\", \"meaning\": \"ça fait un mois que je vis à Tokyo\", \"register\": \"◇\", \"dial\": \"A: 旅行（りょこう）ですか？\\nB: いえ、東京（とうきょう）に住（す）んで1か月（いっかげつ）です。\"},\n{\"jp\": \"日本（にほん）のゲームで育（そだ）ちました\", \"romaji\": \"nihon no geemu de sodachimashita\", \"meaning\": \"j'ai grandi avec les jeux japonais (crée le lien instantané)\", \"register\": \"◇\", \"dial\": \"A: なんで日本（にほん）に？\\nB: 日本（にほん）のゲームで育（そだ）ちました。憧（あこが）れの国（くに）です。\"},\n{\"jp\": \"〜が好（す）きで、日本（にほん）に来（き）ました\", \"romaji\": \"~ ga suki de, nihon ni kimashita\", \"meaning\": \"je suis venu au Japon par amour de… (moule à compléter)\", \"register\": \"◇\", \"dial\": \"A: きっかけは