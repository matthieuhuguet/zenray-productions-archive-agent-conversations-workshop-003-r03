radical d'abord, l'image ensuite.</li>\n215\t<li><strong>Recopie en DISANT l'histoire à chaque fois</strong>, par salves de 10-15 (jamais 100 d'un coup) réparties dans la journée.</li>\n216\t<li><strong>Teste-toi avant de vérifier</strong> : cache la carte, écris le kanji depuis le mot de vocabulaire seul, puis compare.</li>\n217\t<li><strong>Ce soir, rappel espacé</strong> : « on l'a vu tout à l'heure, une fois de plus » — pas une relecture, une récupération.</li>\n218\t</ol>\n219\t</div>\n220\t\"\"\"\n221\t\n222\tREG_MAP = {\n223\t    \"○\": (\"casual\", \"reg-casual\"),\n224\t    \"◇\": (\"neutre\", \"reg-neutre\"),\n225\t    \"◆\": (\"formel\", \"reg-formel\"),\n226\t}\n227\t\n228\t\n229\tdef esc(s):\n230\t    if s is None:\n231\t        return \"\"\n232\t    return str(s)\n233\t\n234\t\n235\tdef render_root(r):\n236\t    unlocks = \" · \".join(r.get(\"unlocks\", []))\n237\t    link = r.get(\"card_link\")\n238\t    kanji_html = f'<a href=\"{esc(link)}\">{esc(r[\"kanji\"])}</a>' if link else esc(r[\"kanji\"])\n239\t    return (f'<div class=\"root\"><div class=\"kanji\">{kanji_html}</div>'\n240\t            f'<div class=\"reading\">{esc(r.get(\"kun\",\"\"))}{\" · \" if r.get(\"kun\") and r.get(\"on\") else \"\"}{esc(r.get(\"on\",\"\"))}</div>'\n241\t            f'<div class=\"meaning\">{esc(r.get(\"meaning\",\"\"))}</div>'\n242\t            f'<div class=\"unlocks\">→ {unlocks}</div></div>')\n243\t\n244\t\n245\tdef render_item(it):\n246\t    reg = it.get(\"register\")\n247\t    reg_html = \"\"\n248\t    if reg and reg in REG_MAP:\n249\t        label, cls = REG_MAP[reg]\n250\t        reg_html = f'<span class=\"reg {cls}\">{reg} {label}</span>'\n251\t    kana = f'<span class=\"kana\">（{esc(it[\"kana\"])}）</span>' if it.get(\"kana\") else \"\"\n252\t    note = f' <span class=\"note\">{esc(it[\"note\"])}</span>' if it.get(\"note\") else \"\"\n253\t    romaji = f'<span class=\"romaji\">{esc(it[\"romaji\"])}</span>' if it.get(\"romaji\") else \"\"\n254\t    lit = f'<span class=\"lit\">litt. : {esc(it[\"lit\"])}</span>' if it.get(\"lit\") else \"\"\n255\t    manual = f'<span class=\"manual\">forme manuel : {esc(it[\"manual\"])}</span>' if it.get(\"manual\") else \"\"\n256\t    dial = f'<span class=\"dial\">{esc(it[\"dial\"])}</span>' if it.get(\"dial\") else \"\"\n257\t    return (f'<div class=\"item\"><span class=\"jp\">{esc(it[\"jp\"])}</span>{kana}{romaji}{reg_html}'\n258\t            f'<span class=\"meaning\">{esc(it[\"meaning\"])}{note}</span>{lit}{manual}{dial}</div>')\n259\t\n260\t\n261\tdef render_kanji_card(k, open_default=False):\n262\t    stroke_svg, n = fetch_stroke_svg(k[\"char\"])\n263\t    strokes_html = (f'<div class=\"kcard-strokes\">{stroke_svg}</div>' if stroke_svg\n264\t                     else '<div class=\"kcard-strokes\" style=\"color:#999;font-size:.82rem\">(tracé indisponible hors ligne)</div>')\n265\t    op = \" open\" if open_default else \"\"\n266\t    vocab = f'{esc(k.get(\"vocab_jp\",\"\"))}' + (f'<span class=\"kana\">（{esc(k[\"vocab_kana\"])}）</span>' if k.get(\"vocab_kana\") else \"\")\n267\t    return (\n268\t        f'<details class=\"kcard\"{op}>'\n269\t        f'<summary><span class=\"kanji\">{esc(k[\"char\"])}</span>'\n270\t        f'<span class=\"vocab\">{vocab}</span>'\n271\t        f'<span class=\"meaning\">{esc(k.get(\"vocab_fr\",\"\"))}</span></summary>'\n272\t        f'<div class=\"kcard-body\">'\n273\t        f'<div class=\"kcard-meta\"><span><strong>ON</strong> {esc(k.get(\"on\",\"—\"))}</span>'\n274\t        f'<span><strong>KUN</strong> {esc(k.get(\"kun\",\"—\"))}</span>'\n275\t        f'<span><strong>Radical</strong> {esc(k.get(\"radical\",\"\"))}</span>'\n276\t        f'{f\"<span><strong>{n} traits</strong></span>\" if n else \"\"}</div>'\n277\t        f'{strokes_html}'\n278\t        f'<div class=\"kcard-mnemo\">{k.get(\"mnemo\",\"\")}</div>'\n279\t        f'</div></details>'\n280\t    )\n281\t\n282\t\n283\tdef render_group(g, open_default=True):\n284\t    items_html = \"\\n\".join(render_item(it) for it in g[\"items\"])\n285\t    n = len(g[\"items\"])\n286\t    op = \" open\" if g.get(\"open\", open_default) else \"\"\n287\t    return (f'<details class=\"group\"{op}><summary>{esc(g[\"name\"])} <span style=\"color:#999;font-weight:400\">'\n288\t            f'{n}</span></summary><div class=\"group-body\">{items_html}</div></details>')\n289\t\n290\t\n291\tdef build_html(spec):\n292\t    title = spec[\"title\"]\n293\t    subtitle = spec.get(\"subtitle\", \"\")\n294\t    legend = spec.get(\"legend\", \"\")\n295\t    roots = spec.get(\"roots\", [])\n296\t    groups = spec.get(\"groups\", [])\n297\t    kanji_cards = spec.get(\"kanji_cards\", [])\n298\t\n299\t    roots_html = \"\"\n300\t    if roots:\n301\t        roots_html = f'<div class=\"roots\">{\"\".join(render_root(r) for r in roots)}</div>'\n302\t\n303\t    kcards_html = \"\"\n304\t    if kanji_cards:\n305\t        cards = \"\".join(render_kanji_card(k, open_default=(i == 0)) for i, k in enumerate(kanji_cards))\n306\t        kcards_html = STUDY_PROTOCOL_HTML + f'<div class=\"kcards\">{cards}</div>'\n307\t\n308\t    groups_html = \"\\n\".join(render_group(g) for g in groups)\n309\t\n310\t    legend_html = \"\"\n311\t    if legend:\n312\t        legend_html = f'<div class=\"legend\"><span>{esc(legend)}</span></div>'\n313\t\n314\t    return f\"\"\"<!DOCTYPE html>\n315\t<html lang=\"fr\"><head><meta charset=\"UTF-8\">\n316\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n317\t<title>{esc(title)}</title>\n318\t<style>{CSS}</style></head>\n319\t<body>\n320\t<header><h1>{esc(title)}</h1><div class=\"subtitle\">{esc(subtitle)}</div>{legend_html}</header>\n321\t{roots_html}\n322\t{kcards_html}\n323\t{groups_html}\n324\t<footer>Généré via lesson-card-html + kanji-stroke-order-html — Memory/Japanese</footer>\n325\t</body></html>\n326\t\"\"\"\n327\t\n328\t\n329\tdef main():\n330\t    if len(sys.argv) != 2:\n331\t        sys.exit(\"usage: python3 generate_lesson_card.py spec.json\")\n332\t    with open(sys.argv[1], encoding=\"utf-8\") as f:\n333\t        spec = json.load(f)\n334\t\n335\t    out_dir = spec.get(\"out_dir\") or _DEFAULT_OUTDIR\n336\t    if not os.path.isabs(out_dir):\n337\t        out_dir = os.path.join(_DEFAULT_OUTDIR, out_dir)\n338\t    os.makedirs(out_dir, exist_ok=True)\n339\t\n340\t    fname = (spec.get(\"file\") or re.sub(r\"[^\\w\\-]+\", \"_\", spec[\"title\"])) + \".html\"\n341\t    path = os.path.join(out_dir, fname)\n342\t    html = build_html(spec)\n343\t    with open(path, \"w\", encoding=\"utf-8\") as f:\n344\t        f.write(html)\n345\t\n346\t    n_items = sum(len(g[\"items\"]) for g in spec.get(\"groups\", []))\n347\t    n_kcards = len(spec.get(\"kanji_cards\", []))\n348\t    print(f\"{spec['title']} -> {len(spec.get('roots', []))} racines + {n_kcards} kanji_cards (tracés inlinés) + {n_items} mots -> {path}\")\n349\t\n350\t\n351\tif __name__ == \"__main__\":\n352\t    main()\n353\t"}]},"uuid":"303c56c9-d3c9-4711-baac-f06ee14cc5ae","timestamp":"2026-07-08T15:00:13.993Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/zenray/Create/Build/Memory/Japanese/_system/skills/lesson-card-html/generate_lesson_card.py","content":"#!/usr/bin/env python3\n\"\"\"Génère une fiche de leçon HTML auto-suffisante, mobile-first (portrait-safe).\n\nProblème résolu : les grands tableaux markdown (16-64 mots) débordent en\nportrait sur mobile — lisibles seulement en paysage. Cette fiche remplace le\ntableau large par des LIGNES qui s'enroulent (flex-wrap), regroupées en\nsections repliables natives (<details>, sans JS), imprimables en PDF\n(Fichier > Partager > Imprimer sur iPhone/Safari).\n\nUsage:\n    python3 generate_lesson_card.py spec.json\n\nVoir SKILL.md pour le format du spec JSON. Aucune dépendance externe\n(stdlib only), même esprit que kanji-stroke-order-html/generate_kanji_card.py.\n\"\"\"\nimport json, os, sys, re, math, urllib.request\n\n_HERE = os.path.dirname(os.path.abspath(__file__))\n# Réorganisation 2026-07-03 : skills/ vit désormais sous Japanese/_system/skills/,\n# un niveau plus profond qu'avant (Japanese/skills/). LessonCards/ renommé Lessons/.\n_DEFAULT_OUTDIR = os.path.normpath(os.path.join(_HERE, \"..\", \"..\", \"..\", \"Lessons\"))\n\n# --- Fusion avec kanji-stroke-order-html : tracés KanjiVG inlinés dans la fiche\n# de leçon elle-même (jamais de fichier .md, jamais de lien externe). Logique\n# dupliquée (pas importée) pour que chaque skill reste auto-suffisant.\nKANJIVG_URL = \"https://raw.githubusercontent.com/KanjiVG/kanjivg/master/kanji/{cp}.svg\"\n\n\ndef _codepoint(char):\n    return format(ord(char), \"05x\")\n\n\ndef _parse_paths(svg):\n    return re.findall(r'<path[^>]*\\bd=\"([^\"]+)\"', svg)\n\n\ndef _parse_numbers(svg):\n    out = []\n    for m in re.finditer(r'<text[^>]*transform=\"matrix\\(1 0 0 1 ([\\d.]+) ([\\d.]+)\\)\"', svg):\n        out.append((float(m.group(1)), float(m.group(2))))\n    return out\n\n\ndef _path_endpoints(d):\n    tokens = re.findall(r'[MmLlCcSsQqTtHhVvZz]|[-+]?\\d*\\.?\\d+(?:e[-+]?\\d+)?', d)\n    i = 0\n    cur = (0.0, 0.0)\n    start = None\n    cmd = None\n\n    def num():\n        nonlocal i\n        v = float(tokens[i]); i += 1; return v\n\n    while i < len(tokens):\n        t = tokens[i]\n        if re.match(r'[A-Za-z]', t):\n            cmd = t; i += 1\n        rel = cmd.islower()\n        c = cmd.upper()\n        if c == 'M':\n            x = num(); y = num()\n            cur = (cur[0] + x, cur[1] + y) if rel and start else (x, y)\n            if start is None:\n                start = cur\n            cmd = 'l' if rel else 'L'\n        elif c == 'L':\n            x = num(); y = num(); cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n        elif c == 'H':\n            x = num(); cur = (cur[0] + x, cur[1]) if rel else (x, cur[1])\n        elif c == 'V':\n            y = num(); cur = (cur[0], cur[1] + y) if rel else (cur[0], y)\n        elif c == 'C':\n            num(); num(); num(); num(); x = num(); y = num()\n            cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n        elif c == 'S':\n            num(); num(); x = num(); y = num()\n            cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n        elif c == 'Q':\n            num(); num(); x = num(); y = num()\n            cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n        elif c == 'T':\n            x = num(); y = num(); cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n        elif c == 'Z':\n            pass\n        else:\n            i += 1\n    return start, cur\n\n\ndef _arrow(start, end):\n    dx = end[0] - start[0]; dy = end[1] - start[1]\n    ang = math.degrees(math.atan2(dy, dx))\n    dirs = [(0, '→'), (45, '↘'), (90, '↓'), (135, '↙'),\n            (180, '←'), (-135, '↖'), (-90, '↑'), (-45, '↗')]\n    best = min(dirs, key=lambda d: abs((ang - d[0] + 180) % 360 - 180))\n    return best[1]\n\n\ndef _build_stroke_svg(paths, nums):\n    n = len(paths)\n    cols = 6\n    rows = math.ceil(n / cols)\n    W = 8 + cols * 117\n    H = 26 + rows * 117\n    out = [f'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {W} {H}\" width=\"{W}\" height=\"{H}\">']\n    out.append('<rect width=\"100%\" height=\"100%\" fill=\"#ffffff\"/>')\n    for i in range(n):\n        col = i % cols; row = i // cols\n        tx = 8 + col * 117; ty = 26 + row * 117\n        out.append(f'<g transform=\"translate({tx},{ty})\"><rect x=\"0\" y=\"0\" width=\"109\" height=\"109\" fill=\"none\" stroke=\"#eeeeee\" stroke-width=\"1\"/>')\n        for j in range(i + 1, n):\n            out.append(f'<path d=\"{paths[j]}\" stroke=\"#d6d6d6\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>')\n        for j in range(0, i):\n            out.append(f'<path d=\"{paths[j]}\" stroke=\"#1a1a1a\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>')\n        out.append(f'<path d=\"{paths[i]}\" stroke=\"#000000\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>')\n        s, e = _path_endpoints(paths[i])\n        ar = _arrow(s, e)\n        lx, ly = nums[i] if i < len(nums) else (max(6, s[0] - 4), max(8, s[1] - 4))\n        out.append(f'<text x=\"{lx:.2f}\" y=\"{ly:.2f}\" font-family=\"sans-serif\" font-size=\"9\" font-weight=\"bold\" fill=\"#cc0033\">{i + 1}{ar}</text></g>')\n    out.append('</svg>')\n    return \"\\n\".join(out), n\n\n\ndef fetch_stroke_svg(char):\n    \"\"\"Récupère + construit la grille de traits KanjiVG pour un caractère. None si échec réseau.\"\"\"\n    try:\n        svg_src = urllib.request.urlopen(KANJIVG_URL.format(cp=_codepoint(char)), timeout=20).read().decode(\"utf-8\")\n    except Exception:\n        return None, 0\n    paths = _parse_paths(svg_src)\n    nums = _parse_numbers(svg_src)\n    return _build_stroke_svg(paths, nums)\n\nCSS = \"\"\"\nbody{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;max-width:720px;margin:0 auto;padding:0 1.1rem 3rem;color:#1a1a1a;line-height:1.5;background:#fff}\nheader{border-bottom:2px solid #1a1a1a;padding:1.4rem 0 .9rem;margin-bottom:1.1rem;position:sticky;top:0;background:#fff}\nh1{margin:0;font-size:1.5rem;font-weight:700;line-height:1.25}\n.subtitle{color:#555;font-size:.92rem;margin-top:.35rem}\n.legend{display:flex;gap:.9rem;flex-wrap:wrap;margin-top:.6rem;font-size:.82rem;color:#555}\n.legend span{white-space:nowrap}\n\n.roots{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:.6rem;margin-bottom:1.6rem}\n.root{background:#fff8e6;border-left:3px solid #d4a017;border-radius:6px;padding:.55rem .7rem}\n.root .kanji{font-size:1.5rem;font-weight:700;line-height:1.1}\n.root .reading{font-size:.78rem;color:#7a6212;margin-top:.1rem}\n.root .meaning{font-size:.85rem;margin-top:.2rem}\n.root .unlocks{font-size:.76rem;color:#8a6d00;margin-top:.35rem}\n.root a{color:#4a6fa5;text-decoration:none}\n.root a:hover{text-decoration:underline}\n\ndetails.group{background:#fafafa;border:1px solid