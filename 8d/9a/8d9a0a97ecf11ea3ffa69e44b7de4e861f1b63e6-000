aning\": \"hein / quoi, c'est évident (cherche l'accord)\", \"lit\": \"じゃないか contracté\", \"manual\": \"〜ではないですか\", \"register\": \"○\", \"note\": \"Tokyo/Kanto à l'origine, national aujourd'hui\", \"dial\": \"A: この店（みせ）高（たか）くない？\\nB: 安（やす）いじゃん。\"},\n58\t{\"jp\": \"〜でしょ\", \"romaji\": \"-desho\", \"meaning\": \"pas vrai ? / je te l'avais dit\", \"lit\": \"でしょう raccourci\", \"manual\": \"〜でしょう\", \"register\": \"○\", \"dial\": \"A: うまい！\\nB: でしょ？\"},\n59\t{\"jp\": \"〜だろ\", \"romaji\": \"-daro\", \"meaning\": \"hein / évidemment (version ♂ brute)\", \"lit\": \"だろう raccourci\", \"manual\": \"〜でしょう\", \"register\": \"○\", \"note\": \"♂, brusque\", \"dial\": \"A: 勝（か）てるかな。\\nB: 無理（むり）だろ。\"},\n60\t{\"jp\": \"〜っしょ\", \"romaji\": \"-ssho\", \"meaning\": \"hein / clairement (jeune)\", \"lit\": \"でしょう ultra-contracté\", \"manual\": \"〜でしょう\", \"register\": \"○\", \"note\": \"très casual, jeune\", \"dial\": \"A: 行（い）くの？\\nB: 行（い）くっしょ。\"},\n61\t{\"jp\": \"〜かな\", \"romaji\": \"-kana\", \"meaning\": \"je me demande si… (doute doux)\", \"lit\": \"question à soi-même\", \"register\": \"○\", \"dial\": \"A: 間（ま）に合（あ）うかな。\\nB: 走（はし）れば大丈夫（だいじょうぶ）。\"},\n62\t{\"jp\": \"〜かも\", \"romaji\": \"-kamo\", \"meaning\": \"peut-être bien\", \"lit\": \"かもしれない tronqué\", \"manual\": \"〜かもしれません\", \"register\": \"○\", \"dial\": \"A: 雨（あめ）降（ふ）る？\\nB: 降（ふ）るかも。\"},\n63\t{\"jp\": \"〜し\", \"romaji\": \"-shi\", \"meaning\": \"…et puis / en plus (raison laissée ouverte)\", \"lit\": \"liste de raisons, souvent une seule à l'oral\", \"register\": \"○\", \"dial\": \"A: なんで帰（かえ）るの？\\nB: 明日（あした）早（はや）いし。\"},\n64\t{\"jp\": \"〜けど…\", \"romaji\": \"-kedo...\", \"meaning\": \"…mais bon (phrase laissée en suspens, poli à la japonaise)\", \"lit\": \"le contraste reste implicite\", \"register\": \"○\", \"note\": \"revu (L48 : 〜んですが)\", \"dial\": \"A: 予約（よやく）してないんだけど…\\nB: 大丈夫（だいじょうぶ）ですよ、どうぞ。\"},\n65\t{\"jp\": \"〜のに\", \"romaji\": \"-noni\", \"meaning\": \"alors que… / dommage (reproche ou regret)\", \"lit\": \"contraste