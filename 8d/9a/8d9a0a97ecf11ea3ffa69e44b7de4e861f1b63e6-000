,\n{\"jp\": \"変（へん)なこと言（い）ってたら教（おし）えてください\", \"romaji\": \"henna koto ittetara oshiete kudasai\", \"meaning\": \"si je dis un truc bizarre, dites-le-moi\", \"register\": \"◇\", \"dial\": \"A: 変（へん）なこと言（い）ってたら教（おし）えてください。\\nB: 今（いま）のところ完璧（かんぺき）（笑）\"},\n{\"jp\": \"今（いま）の、失礼（しつれい）でした？\", \"romaji\": \"ima no, shitsurei deshita?\", \"meaning\": \"c'était impoli, ce que je viens de dire ? (check culturel direct)\", \"register\": \"◇\", \"dial\": \"A: 今（いま）の、失礼（しつれい）でした？\\nB: 全然（ぜんぜん）！むしろ面白（おもしろ）かった。\"},\n{\"jp\": \"冗談（じょうだん）です（笑）\", \"romaji\": \"joudan desu\", \"meaning\": \"je plaisante ! (désamorce vite)\", \"register\": \"○\", \"dial\": \"A: え、ほんとに？\\nB: 冗談（じょうだん）です（笑）\"},\n{\"jp\": \"気（き）にしないでください\", \"romaji\": \"ki ni shinaide kudasai\", \"meaning\": \"ne vous en faites pas\", \"register\": \"◇\", \"dial\": \"A: さっきはごめんなさい。\\nB: 気（き）にしないでください。\"},\n{\"jp\": \"全然（ぜんぜん）大丈夫（だいじょうぶ）です\", \"romaji\": \"zenzen daijoubu desu\", \"meaning\": \"aucun souci (le pardon standard)\", \"register\": \"◇\", \"dial\": \"A: 遅（おく）れてすみません！\\nB: 全然（ぜんぜん）大丈夫（だいじょうぶ）です。\"},\n{\"jp\": \"こちらこそ\", \"romaji\": \"kochira koso\", \"meaning\": \"c'est moi qui… (retourne un merci ou une excuse)\", \"register\": \"◇\", \"dial\": \"A: 今日（きょう）はありがとうございました。\\nB: こちらこそ！\"},\n{\"jp\": \"助（たす）かりました\", \"romaji\": \"tasukarimashita\", \"meaning\": \"vous m'avez sauvé / merci beaucoup (gratitude concrète)\", \"register\": \"◇\", \"dial\": \"A: 駅（えき）まで案内（あんない）しますよ。\\nB: 助（たす）かりました！\"},\n{\"jp\": \"おかげさまで\", \"romaji\": \"okagesama de\", \"meaning\": \"grâce à vous (gratitude élégante)\", \"register\": \"◆\", \"dial\": \"A: 無事（ぶじ）着（つ）いた？\\nB: おかげさまで。\"},\n{\"jp\": \"また変（へん）な日本語（にほんご）言（い）ったら笑（わら）ってください\", \"romaji\": \"mata henna nihongo ittara waratte kudasai\", \"meaning\": \"si je ressors un japonais bizarre, riez, c'est permis (transforme l'erreur en jeu)\", \"register\": \"○\", \"dial\": \"A: また変（へん）な日本語（にほんご）言（い）ったら笑（わら）ってください。\\nB: もう笑（わら）ってる（笑）\"},\n{\"jp\": \"覚（おぼ）えたてなんです\", \"romaji\": \"oboetate