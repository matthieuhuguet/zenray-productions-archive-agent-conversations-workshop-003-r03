]*transform=\"matrix\\(1 0 0 1 ([\\d.]+) ([\\d.]+)\\)\"', svg):\n40\t        out.append((float(m.group(1)), float(m.group(2))))\n41\t    return out\n42\t\n43\t\n44\tdef _path_endpoints(d):\n45\t    tokens = re.findall(r'[MmLlCcSsQqTtHhVvZz]|[-+]?\\d*\\.?\\d+(?:e[-+]?\\d+)?', d)\n46\t    i = 0\n47\t    cur = (0.0, 0.0)\n48\t    start = None\n49\t    cmd = None\n50\t\n51\t    def num():\n52\t        nonlocal i\n53\t        v = float(tokens[i]); i += 1; return v\n54\t\n55\t    while i < len(tokens):\n56\t        t = tokens[i]\n57\t        if re.match(r'[A-Za-z]', t):\n58\t            cmd = t; i += 1\n59\t        rel = cmd.islower()\n60\t        c = cmd.upper()\n61\t        if c == 'M':\n62\t            x = num(); y = num()\n63\t            cur = (cur[0] + x, cur[1] + y) if rel and start else (x, y)\n64\t            if start is None:\n65\t                start = cur\n66\t            cmd = 'l' if rel else 'L'\n67\t        elif c == 'L':\n68\t            x = num(); y = num(); cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n69\t        elif c == 'H':\n70\t            x = num(); cur = (cur[0] + x, cur[1]) if rel else (x, cur[1])\n71\t        elif c == 'V':\n72\t            y = num(); cur = (cur[0], cur[1] + y) if rel else (cur[0], y)\n73\t        elif c == 'C':\n74\t            num(); num(); num(); num(); x = num(); y = num()\n75\t            cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n76\t        elif c == 'S':\n77\t            num(); num(); x = num(); y = num()\n78\t            cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n79\t        elif c == 'Q':\n80\t            num(); num(); x = num(); y = num()\n81\t            cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n82\t        elif c == 'T':\n83\t            x = num(); y = num(); cur = (cur[0] + x, cur[1] + y) if rel else (x, y)\n84\t        elif c == 'Z':\n85\t            pass\n86\t        else:\n87\t            i += 1\n88\t    return start, cur\n89\t\n90\t\n91\tdef _arrow(start, end):\n92\t    dx = end[0] - start[0]; dy = end[1] - start[1]\n93\t    ang = math.degrees(math.atan2(dy, dx))\n94\t    dirs = [(0, '→'), (45, '↘'), (90, '↓'), (135, '↙'),\n95\t            (180, '←'), (-135, '↖'), (-90, '↑'), (-45, '↗')]\n96\t    best = min(dirs, key=lambda d: abs((ang - d[0] + 180) % 360 - 180))\n97\t    return best[1]\n98\t\n99\t\n100\tdef _build_stroke_svg(paths, nums):\n101\t    n = len(paths)\n102\t    cols = 6\n103\t    rows = math.ceil(n / cols)\n104\t    W = 8 + cols * 117\n105\t    H = 26 + rows * 117\n106\t    out = [f'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {W} {H}\" width=\"{W}\" height=\"{H}\">']\n107\t    out.append('<rect width=\"100%\" height=\"100%\" fill=\"#ffffff\"/>')\n108\t    for i in range(n):\n109\t        col = i % cols; row = i // cols\n110\t        tx = 8 + col * 117; ty = 26 + row * 117\n111\t        out.append(f'<g transform=\"translate({tx},{ty})\"><rect x=\"0\" y=\"0\" width=\"109\" height=\"109\" fill=\"none\" stroke=\"#eeeeee\" stroke-width=\"1\"/>')\n112\t        for j in range(i + 1, n):\n113\t            out.append(f'<path d=\"{paths[j]}\" stroke=\"#d6d6d6\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>')\n114\t        for j in range(0, i):\n115\t            out.append(f'<path d=\"{paths[j]}\" stroke=\"#1a1a1a\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>')\n116\t        out.append(f'<path d=\"{paths[i]}\" stroke=\"#000000\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>')\n117\t        s, e = _path_endpoints(paths[i])\n118\t        ar = _arrow(s, e)\n119\t        lx, ly = nums[i] if i < len(nums) else (max(6, s[0] - 4), max(8, s[1] - 4))\n120\t        out.append(f'<text x=\"{lx:.2f}\" y=\"{ly:.2f}\" font-family=\"sans-serif\" font-size=\"9\" font-weight=\"bold\" fill=\"#cc0033\">{i + 1}{ar}</text></g>')\n121\t    out.append('</svg>')\n122\t    return \"\\n\".join(out), n\n123\t\n124\t\n125\tdef fetch_stroke_svg(char):\n126\t    \"\"\"Récupère + construit la grille de traits KanjiVG pour un caractère. None si échec réseau.\"\"\"\n127\t    try:\n128\t        svg_src = urllib.request.urlopen(KANJIVG_URL.format(cp=_codepoint(char)), timeout=20).read().decode(\"utf-8\")\n129\t    except Exception:\n130\t        return None, 0\n131\t    paths = _parse_paths(svg_src)\n132\t    nums = _parse_numbers(svg_src)\n133\t    return _build_stroke_svg(paths, nums)\n134\t\n135\tCSS = \"\"\"\n136\tbody{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;max-width:720px;margin:0 auto;padding:0 1.1rem 3rem;color:#1a1a1a;line-height:1.5;background:#fff}\n137\theader{border-bottom:2px solid #1a1a1a;padding:1.4rem 0 .9rem;margin-bottom:1.1rem;position:sticky;top:0;background:#fff}\n138\th1{margin:0;font-size:1.5rem;font-weight:700;line-height:1.25}\n139\t.subtitle{color:#555;font-size:.92rem;margin-top:.35rem}\n140\t.legend{display:flex;gap:.9rem;flex-wrap:wrap;margin-top:.6rem;font-size:.82rem;color:#555}\n141\t.legend span{white-space:nowrap}\n142\t\n143\t.roots{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:.6rem;margin-bottom:1.6rem}\n144\t.root{background:#fff8e6;border-left:3px solid #d4a017;border-radius:6px;padding:.55rem .7rem}\n145\t.root .kanji{font-size:1.5rem;font-weight:700;line-height:1.1}\n146\t.root .reading{font-size:.78rem;color:#7a6212;margin-top:.1rem}\n147\t.root .meaning{font-size:.85rem;margin-top:.2rem}\n148\t.root .unlocks{font-size:.76rem;color:#8a6d00;margin-top:.35rem}\n149\t.root a{color:#4a6fa5;text-decoration:none}\n150\t.root a:hover{text-decoration:underline}\n151\t\n152\tdetails.group{background:#fafafa;border:1px solid #e8e8e8;border-radius:8px;margin-bottom:.7rem;overflow:hidden}\n153\tdetails.group summary{list-style:none;cursor:pointer;padding:.75rem .9rem;font-weight:700;font-size:.98rem;background:#f0f0f0;border-bottom:1px solid #e8e8e8;display:flex;justify-content:space-between;align-items:center}\n154