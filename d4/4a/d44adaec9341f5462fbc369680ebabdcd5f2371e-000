{"timestamp":"2026-05-31T16:26:34.537Z","ordinal":142,"type":"response_item","payload":{"type":"function_call_output","call_id":"call_ReuTSLxofShCArOq6cfcAqnw","output":"Chunk ID: bb3e3c\nWall time: 0.0000 seconds\nProcess exited with code 0\nOriginal token count: 4132\nOutput:\n     1\t// transcode-worker.mjs — WORKER LOCAL de transcodage vidéo (tourne sur le Mac, à côté de local-server.mjs).\n     2\t//\n     3\t// RÔLE : c'est le « chaînon manquant ». Quand on dépose une vidéo non lisible par le navigateur\n     4\t// (mkv/avi/mov…) ou trop lourde, le front écrit juste un placeholder {transcoding:true} + une ligne\n     5\t// dans la file pages/.zr-transcode-queue.json, et PERSONNE ne consomme cette file -> la vidéo reste\n     6\t// « en cours de transcodage » pour toujours. Ce worker consomme la file : il transcode au format MSE\n     7\t// (vidéo H.264 + 1 audio AAC par piste + sous-titres VTT), pousse les chunks HASHÉS sur le shard privé,\n     8\t// écrit le manifest mse-av final dans zenray-content, met à jour la progression, puis dépile l'entrée.\n     9\t//\n    10\t// COMMENT LE WORKER RETROUVE LE FICHIER SOURCE (RISQUE 1 du plan) :\n    11\t//   Le drag-drop / Ctrl-V web ne donne PAS de chemin disque fiable au Mac. Deux modes, dans l'ordre :\n    12\t//     1. l'entrée de file porte un champ `sourcePath` (chemin absolu local) -> on lit directement.\n    13\t//     2. sinon, on cherche un fichier nommé exactement `entry.name` dans le DOSSIER SURVEILLÉ\n    14\t//        (--watch <dir>, défaut ~/Movies/ZenRayInbox). C'est le mode « je dépose mon mkv dans un\n    15\t//        dossier, le worker le voit et le transcode ». Simple, zéro upload de source, zéro double trafic.\n    16\t//   (Le mode « upload de la source brute sur le shard puis re-download côté worker » est une étape\n    17\t//    FRONTEND ultérieure ; ce worker le supportera sans changement dès que l'entrée portera\n    18\t//    `source:{repo,dir,parts}` — voir resolveSource().)\n    19\t//\n    20\t// PROGRESSION : le worker met à jour `status` + `progress` (0..100) dans l'entrée de file ET réécrit\n    21\t// le .media.json placeholder avec {transcoding:true, progress, stage} pour que le Finder affiche une\n    22\t// barre. Pas de SSE : un petit serveur HTTP local expose GET /transcode/status (JSON) pour le polling.\n    23\t//\n    24\t// LANCEMENT : GITHUB_TOKEN=$(gh auth token) node scripts/transcode-worker.mjs \\\n    25\t//               [--api http://localhost:3000] [--watch ~/Movies/ZenRayInbox] [--interval 10] [--crf 21] [--t N] [--port 3010]\n    26\t//   --api      : base URL du local-server (pour lire/écrire la file via /api/page et résoudre le shard). Défaut http://localhost:3000\n    27\t//   --watch    : dossier surveillé où retrouver les sources par nom. Défaut $HOME/Movies/ZenRayInbox\n    28\t//   --interval : secondes entre deux polls de la file. Défaut 10\n    29\t//   --t N      : limite d'échantillon en secondes (validation rapide). Omis = vidéo complète\n    30\t//   --port     : port du serveur de statut HTTP. Défaut 3010\n    31\t//\n    32\t// SÉCURITÉ : token via env (jamais committé) ; la source vient d'un chemin local connu (sourcePath\n    33\t// validé absolu, ou fichier du dossier surveillé), jamais d'un path arbitraire reçu du web -> pas de\n    34\t// path traversal. Le worker n'écrit que sur le shard privé (binaires) et zenray-content (manifests).\n    35\t\n    36\timport http from 'node:http'\n    37\timport path from 'node:path'\n    38\timport os from 'node:os'\n    39\timport { readdir, rm, mkdir, writeFile } from 'node:fs/promises'\n    40\timport { existsSync } from 'node:fs'\n    41\timport { transcodeOne, pushToShard } from './video-mse-lib.mjs'\n    42\timport { transcodeHls, pushHls } from './video-hls-lib.mjs'\n    43\t\n    44\tconst args = process.argv.slice(2)\n    45\tconst getArg = (k, d) => { const i = args.indexOf(k); return i >= 0 ? args[i + 1] : d }\n    46\tconst TOKEN = process.env.GITHUB_TOKEN\n    47\tconst API = (getArg('--api', 'http://localhost:3000')).replace(/\\/$/, '')\n    48\tconst WATCH = (getArg('--watch', path.join(os.homedir(), 'Movies', 'ZenRayInbox'))).replace(/^~(?=$|\\/)/, os.homedir())\n    49\tconst INTERVAL = Math.max(3, parseInt(getArg('--interval', '10'), 10)) * 1000\n    50\tconst CRF = getArg('--crf', '21')\n    51\tconst SAMPLE = getArg('--t', null)\n    52\tconst STATUS_PORT = parseInt(getArg('--port', '3010'), 10)\n    53\t// Format de sortie : HLS par défaut (décision Matthieu, standard + évolutif multi-qualité/CDN). --mse force l'ancien pipeline.\n    54\tconst USE_HLS = !args.includes('--mse')\n    55\tconst QUEUE_PATH = 'pages/.zr-transcode-queue.json'\n    56\tconst VIDEO_RE = /\\.(mkv|mp4|webm|avi|mov|m4v|ts)$/i\n    57\t\n    58\tif (!TOKEN) { console.error('GITHUB_TOKEN absent. Lancer : GITHUB_TOKEN=$(gh auth token) node scripts/transcode-worker.mjs'); process.exit(1) }\n    59\t\n    60\t// état en mémoire exposé par le serveur de statut HTTP (polling).\n    61\tconst state = { current: null, lastDone: null, lastError: null, queueLen: 0, scannedAt: null }\n    62\tconst log = (...a) => console.log('[worker]', ...a)\n    63\t\n    64\t// --- file (via /api/page du local-server) -----------------------------------\n    65\tasync function readQueue() {\n    66\t  try {\n    67\t    const r = await fetch(`${API}/api/page?action=read&path=${encodeURIComponent(QUEUE_PATH)}`).then((x) => x.json())\n    68\t    const raw = r && (r.markdown != null ? r.markdown : r.content)\n    69\t    if (!raw) return { items: [], sha: r && r.sha }\n    70\t    const parsed = JSON.parse(raw)\n    71\t    const items = Array.isArray(parsed) ? parsed : (Array.isArray(parsed.items) ? parsed.items : [])\n    72\t    return { items, sha: r && r.sha }\n    73\t  } catch { return { items: [], sha: null } }\n    74\t}\n    75\tasync function writeQueue(items, sha) {\n    76\t  const r = await fetch(`${API}/api/page`, {\n    77\t    method: 'POST', headers: { 'content-type': 'application/json' },\n    78\t    body: JSON.stringify({ action: 'save', path: QUEUE_PATH, markdown: JSON.stringify(items, null, 2), ...(sha ? { sha } : {}) }),\n    79\t  }).then((x) => x.json()).catch(() => null)\n    80\t  if (!r || r.error || !r.ok) throw new Error('queue save: ' + ((r && r.error) || 'fail'))\n    81\t  return r\n    82\t}\n    83\t\n    84\t// Met à jour le statut/progress d'UNE entrée dans la file (relit pour le sha frais, réécrit).\n    85\tasync function updateEntry(nodePath, patch) {\n    86\t  const { items, sha } = await readQueue()\n    87\t  const idx = items.findIndex((it) => it && it.nodePath === nodePath)\n    88\t  if (idx < 0) return\n    89\t  items[idx] = { ...items[idx], ...patch }\n    90\t  try { await writeQueue(items, sha) } catch (e) { log('maj file échouée (non bloquant):', String(e.message || e).slice(0, 120)) }\n    91\t}\n    92\tasync function dequeue(nodePath) {\n    93\t  const { items, sha } = await readQueue()\n    94\t  await writeQueue(items.filter((it) => it && it.nodePath !== nodePath), sha)\n    95\t}\n    96\t\n    97\t// Réécrit le .media.json placeholder avec la progression (le Finder lit transcoding/progress/stage).\n    98\tasync function writePlaceholderProgress(nodePath, entry, progress, stage) {\n    99\t  try {\n   100\t    const rr = await fetch(`${API}/api/page?action=read&path=${encodeURIComponent(nodePath)}`).then((x) => x.json())\n   101\t    let manifest = {}\n   102\t    try { manifest = JSON.parse(rr.markdown || '{}') } catch { manifest = {} }\n   103\t    manifest = { type: 'chunked-media', v: 1, name: entry.name, mime: entry.mime || 'video/x-matroska', size: entry.size || 0, ...manifest, transcoding: true, progress, stage, probe: manifest.probe || {} }\n   104\t    await fetch(`${API}/api/page`, {\n   105\t      method: 'POST', headers: { 'content-type': 'application/json' },\n   106\t      body: JSON.stringify({ action: 'save', path: nodePath, markdown: JSON.stringify(manifest), sha: rr.sha || undefined }),\n   107\t    })\n   108\t  } catch { /* progression best-effort */ }\n   109\t}\n   110\t\n   111\t// Réécrit le placeholder en MANIFEST FINAL mse-av (remplace transcoding:true). pushToShard a déjà\n   112\t// écrit le manifest au CHEMIN CANONIQUE (dest/<base>.mp4.media.json) ; on écrase ICI le nœud placeholder\n   113\t// d'origine (celui visible dans le Finder) avec le même contenu, pour que la vidéo devienne lisible\n   114\t// SUR PLACE sans changer son chemin.\n   115\tasync function finalizePlaceholder(nodePath, manifest) {\n   116\t  try {\n   117\t    const rr = await fetch(`${API}/api/page?action=read&path=${encodeURIComponent(nodePath)}`).then((x) => x.json())\n   118\t    await fetch(`${API}/api/page`, {\n   119\t      method: 'POST', headers: { 'content-type': 'application/json' },\n   120\t      body: JSON.stringify({ action: 'save', path: nodePath, markdown: JSON.stringify(manifest, null, 2), sha: rr.sha || undefined }),\n   121\t    })\n   122\t  } catch (e) { log('finalize placeholder échec (le manifest canonique reste écrit):', String(e.message || e).slice(0, 120)) }\n   123\t}\n   124\t\n   125\t// Télécharge la SOURCE brute depuis le shard privé (chunks media/<id>/NNN.bin) et la reconstitue dans\n   126\t// un fichier temporaire. C'est le cas DRAG-DROP WEB : le front a uploadé la source chunkée et a noté\n   127\t// source:{repo,dir,parts}. /api/shard sert chaque chunk binaire (repo privé via token serveur).\n   128\tconst TMP_IN = path.join(os.tmpdir(), 'zr_mse', 'in')\n   129\tasync function downloadShardSource(src, name, log = () => {}) {\n   130\t  if (!src || !/^zenray-media-\\d{2,}$/.test(String(src.repo || '')) || !src.dir || !Array.isArray(src.parts) || !src.parts.length) return null\n   131\t  if (String(src.dir).includes('..')) return null\n   132\t  await mkdir(TMP_IN, { recursive: true })\n   133\t  const outPath = path.join(TMP_IN, `${Date.now().toString(36)}_${path.basename(name || 'source.mkv').replace(/[^\\w.\\- ]+/g, '_')}`)\n   134\t  log(`  source via shard ${src.repo} (${src.parts.length} chunks) -> ${outPath}`)\n   135\t  const buffers = []\n   136\t  for (const part of src.parts) {\n   137\t    const rel = `${src.dir}/${part}.bin`\n   138\t    const url = `${API}/api/shard?repo=${encodeURIComponent(src.repo)}&path=${encodeURIComponent(rel)}`\n   139\t    const r = await fetch(url)\n   140\t    if (!r.ok) throw new Error(`shard chunk ${rel}: HTTP ${r.status}`)\n   141\t    buffers.push(Buffer.from(await r.arrayBuffer()))\n   142\t  }\n   143\t  await writeFile(outPath, Buffer.concat(buffers))\n   144\t  return outPath\n   145\t}\n   146\t\n   147\t// --- résolution de la SOURCE locale ------------------------------------------\n   148\tasync function resolveSource(entry) {\n   149\t  // 1) chemin absolu explicite dans l'entrée (mode local : sourcePath fourni à la main)\n   150\t  if (entry.sourcePath && path.isAbsolute(entry.sourcePath) && !entry.sourcePath.includes('..') && existsSync(entry.sourcePath)) {\n   151\t    return entry.sourcePath\n   152\t  }\n   153\t  // 2) source uploadée sur le shard par le front (drag-drop web) -> on reconstitue dans /tmp\n   154\t  if (entry.source) {\n   155\t    try { const dl = await downloadShardSource(entry.source, entry.name, log); if (dl) return dl }\n   156\t    catch (e) { log('download source shard échec, fallback dossier surveillé:', String(e.message || e).slice(0, 120)) }\n   157\t  }\n   158\t  // 3) fichier de même nom dans le dossier surveillé (mode --watch)\n   159\t  if (entry.name && existsSync(WATCH)) {\n   160\t    const direct = path.join(WATCH, path.basename(entry.name))\n   161\t    if (existsSync(direct)) return direct\n   162\t    // tolérance : même base, extension vidéo différente (ex le nom de nœud a été sanitizé)\n   163\t    const baseWanted = path.basename(entry.name).replace(/\\.[^.]+$/, '').toLowerCase()\n   164\t    try {\n   165\t      const files = await readdir(WATCH)\n   166\t      const hit = files.find((f) => VIDEO_RE.test(f) && f.replace(/\\.[^.]+$/, '').toLowerCase() === baseWanted)\n   167\t      if (hit) return path.join(WATCH, hit)\n   168\t    } catch { /* dossier illisible */ }\n   169\t  }\n   170\t  return null\n   171\t}\n   172\t\n   173\t// --- traitement d'une entrée -------------------------------------------------\n   174\tasync function processEntry(entry) {\n   175\t  const nodePath = entry.nodePath\n   176\t  log(`traitement: ${entry.name} (${nodePath})`)\n   177\t  state.current = { name: entry.name, nodePath, stage: 'resolving', progress: 0 }\n   178\t\n   179\t  const src = await resolveSource(entry)\n   180\t  if (!src) {\n   181\t    log(`SOURCE INTROUVABLE pour \"${entry.name}\". Déposer le fichier dans ${WATCH} (ou renseigner sourcePath). On laisse l'entrée en file.`)\n   182\t    await updateEntry(nodePath, { status: 'source-introuvable', sourceHint: WATCH })\n   183\t    state.current = null\n   184\t    return\n   185\t  }\n   186\t  log(`  source: ${src}`)\n   187\t  await updateEntry(nodePath, { status: 'encoding', progress: 0 })\n   188\t\n   189\t  // throttle des mises à jour de progression (évite de spammer GitHub à chaque frame).\n   190\t  let lastPush = 0\n   191\t  const onProgress = (stage, pct) => {\n   192\t    state.current = { name: entry.name, nodePath, stage, progress: Math.round(pct) }\n   193\t    const now = Date.now()\n   194\t    if (now - lastPush > 5000) {\n   195\t      lastPush = now\n   196\t      updateEntry(nodePath, { status: `encoding ${stage} ${Math.round(pct)}%`, progress: Math.round(pct) })\n   197\t      writePlaceholderProgress(nodePath, entry, Math.round(pct), stage)\n   198\t    }\n   199\t  }\n   200\t\n   201\t  // 1) transcode local (ffmpeg multi-thread sature les coeurs automatiquement)\n   202\t  //    HLS par défaut (segments + playlists m3u8), MSE legacy si --mse.\n   203\t  const transcode = USE_HLS ? transcodeHls : transcodeOne\n   204\t  const push = USE_