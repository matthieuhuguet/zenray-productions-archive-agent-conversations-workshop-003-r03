= await putBlob(repo, abToB64(slAb))\n   204\t    files.push({ path: `${dir}/${pad(i)}.bin`, sha })\n   205\t    sent += slice.size\n   206\t    if (onProgress) onProgress(Math.min(0.9, sent / file.size))\n   207\t  }\n   208\t  await commitShard(repo, files, file.size)\n   209\t  const parts = Array.from({ length: count }, (_, i) => pad(i))\n   210\t  return { repo, dir, parts, count, size: file.size }\n   211\t}\n   212\t\n   213\t// VIDEO web-native (mp4/webm/ogg) : chunke + nœud .media.json (probe.duration).\n   214\tasync function captureVideoNative(file, folder, onProgress) {\n   215\t  const duration = await videoDuration(file)\n   216\t  const { repo, dir, parts, count, size } = await uploadBinaryChunks(file, onProgress)\n   217\t  const manifest = {\n   218\t    type: 'chunked-media', v: 1, name: file.name, mime: file.type || 'video/mp4',\n   219\t    size, chunkSize: CHUNK_SIZE, count, dir, parts,\n   220\t    repo, probe: { duration: duration || 0, audio: [], subs: [] },\n   221\t  }\n   222\t  const nodePath = `${destFolder(folder)}/${sanitize(file.name)}.${rand()}.media.json`\n   223\t  await writeNode(nodePath, JSON.stringify(manifest))\n   224\t  if (onProgress) onProgress(1)\n   225\t  return { ok: true, type: 'video', nodePath, name: file.name }\n   226\t}\n   227\t\n   228\t// VIDEO non web-native (mkv/avi/mov…) OU web-native trop lourde : le navigateur ne sait pas la\n   229\t// streamer correctement telle quelle (pas de switch de piste audio, lecture Range fragile sur gros\n   230\t// fichier). Le transcodage (ffmpeg) se fait EN LOCAL sur le Mac via le worker scripts/transcode-worker.mjs.\n   231\t//\n   232\t// Le drag-drop / Ctrl-V web ne donne AUCUN chemin disque fiable : le Mac ne peut pas « retrouver »\n   233\t// le fichier source tout seul. La solution retenue (plan, RISQUE 1) : on UPLOADE la source brute,\n   234\t// découpée en chunks, sur le shard PRIVÉ, et on note son emplacement {repo,dir,parts} dans l'entrée de\n   235\t// file. Le worker reconstitue alors la source depuis le shard, transcode, puis remplace le placeholder\n   236\t// par le manifest mse-av final. Trois écritures ici :\n   237\t//  (a) upload de la source brute chunkée -> shard privé (pour que le Mac ait le fichier) ;\n   238\t//  (b) nœud .media.json PLACEHOLDER {transcoding:true} (la vidéo apparaît tout de suite dans le Finder) ;\n   239\t//  (c) entrée dans la file pages/.zr-transcode-queue.json (avec source:{repo,dir,parts}).\n   240\tasync function captureVideoTranscode(file, folder, onProgress) {\n   241\t  const mime = file.type || 'video/x-matroska'\n   242\t  const nodePath = `${destFolder(folder)}/${sanitize(file.name)}.${rand()}.media.json`\n   243\t\n   244\t  // (a) Upload de la source brute chunkée sur le shard privé. C'est ce qui permet au worker Mac de\n   245\t  //     récupérer le fichier (le web n'expose pas son chemin disque). Best-effort : si l'upload échoue,\n   246\t  //     le placeholder + la file restent (le worker pourra retomber sur le dossier surveillé --watch).\n   247\t  let source = null\n   248\t  try {\n   249\t    const up = await uploadBinaryChunks(file, (r) => { if (onProgress) onProgress(Math.min(0.85, r * 0.85)) })\n   250\t    source = { repo: up.repo, dir: up.dir, parts: up.parts, count: up.count, size: up.size }\n   251\t  } catch { /* source non uploadée : fallback dossier surveillé côté worker */ }\n   252\t  if (onProgress) onProgress(0.9)\n   253\t\n   254\t  // (b) Nœud placeholder : pas de dir/parts de SORTIE (rien de lisible encore), transcoding:true.\n   255\t  const manifest = {\n   256\t    type: 'chunked-media', v: 1, name: file.name, mime,\n   257\t    size: file.size, transcoding: true, progress: 0, stage: 'en file', probe: {},\n   258\t  }\n   259\t  await writeNode(nodePath, JSON.stringify(manifest))\n   260\t\n   261\t  // (c) File persistée des vidéos en attente de transcodage local (porte la source pour le worker).\n   262\t  try {\n   263\t    await enqueueTranscode({\n   264\t      nodePath,\n   265\t      name: file.name,\n   266\t      mime,\n   267\t      size: file.size,\n   268\t      status: 'a-transcoder-localement',\n   269\t      addedAt: new Date().toISOString(),\n   270\t      dest: destFolder(folder),\n   271\t      ...(source ? { source } : {}),\n   272\t    })\n   273\t  } catch { /* la file est best-effort : le placeholder reste visible quoi qu'il arrive */ }\n   274\t\n   275\t  if (onProgress) onProgress(1)\n   276\t  return { ok: true, type: 'video-queued', nodePath, name: file.name }\n   277\t}\n   278\t\n   279\t// MÉDIA binaire générique (audio, pdf) : chunke + nœud .media.json (mime adapté).\n   280\tasync function captureBinaryMedia(file, folder, mime, onProgress) {\n   281\t  const { repo, dir, parts, count, size } = await uploadBinaryChunks(file, onProgress)\n   282\t  const manifest = {\n   283\t    type: 'chunked-media', v: 1, name: file.name, mime: mime || file.type || 'application/octet-stream',\n   284\t    size, chunkSize: CHUNK_SIZE, count, dir, parts,\n   285\t    repo, probe: { duration: 0, audio: [], subs: [] },\n   286\t  }\n   287\t  const nodePath = `${destFolder(folder)}/${sanitize(file.name)}.${rand()}.media.json`\n   288\t  await writeNode(nodePath, JSON.stringify(manifest))\n   289\t  if (onProgress) onProgress(1)\n   290\t  return { ok: true, type: 'media', nodePath, name: file.name }\n   291\t}\n   292\t\n   293\t// TEXTE (.md/.txt, text/markdown) : crée une page .md avec le texte brut.\n   294\tasync function captureText(file, folder, onProgress) {\n   295\t  const text = await file.text()\n   296\t  const nodePath = `${destFolder(folder)}/${sanitize(file.name)}.md`\n   297\t  await writeNode(nodePath, text)\n   298\t  if (onProgress) onProgress(1)\n   299\t  return { ok: true, type: 'page', nodePath, name: file.name }\n   300\t}\n   301\t\n   302\t// --- routeur principal -----------------------------------------------------\n   303\t\n   304\tasync function routeFile(file, folder, o