68\t    .slice(0, 80) || 'item'\n    69\t}\n    70\t\n    71\tconst rand = () => Math.random().toString(36).slice(2, 8)\n    72\t\n    73\t// POST /api/upload-shard (binaire vers shard privé).\n    74\tasync function shardApi(payload) {\n    75\t  const r = await fetch('/api/upload-shard', {\n    76\t    method: 'POST', headers: { 'content-type': 'application/json' },\n    77\t    body: JSON.stringify(payload),\n    78\t  }).then((x) => x.json()).catch(() => null)\n    79\t  return r\n    80\t}\n    81\t\n    82\t// Récupère le shard actif (repo zenray-media-NN qui a de la place).\n    83\tasync function activeShard() {\n    84\t  const r = await shardApi({ action: 'active-shard' })\n    85\t  if (!r || r.error || !r.repo) throw new Error('active-shard: ' + ((r && r.error) || 'fail'))\n    86\t  return r.repo\n    87\t}\n    88\t\n    89\t// Crée un blob brut dans le shard, avec 1 retry léger (re-create = même sha, idempotent).\n    90\tasync function putBlob(repo, b64) {\n    91\t  let sha = null\n    92\t  for (let attempt = 0; attempt < 2 && !sha; attempt++) {\n    93\t    const r = await shardApi({ action: 'blob', repo, b64 })\n    94\t    if (r && r.ok && r.sha) sha = r.sha\n    95\t  }\n    96\t  if (!sha) throw new Error('blob failed')\n    97\t  return sha\n    98\t}\n    99\t\n   100\t// Commit atomique d'une liste de fichiers {path, sha} dans le shard.\n   101\tasync function commitShard(repo, files, addBytes) {\n   102\t  const r = await shardApi({ action: 'commit', repo, files, addBytes })\n   103\t  if (!r || r.error || !r.ok) throw new Error('commit: ' + ((r && r.error) || 'fail'))\n   104\t  return r\n   105\t}\n   106\t\n   107\t// Écrit un nœud (manifest texte) dans zenray-content via /api/page action save.\n   108\tasync function writeNode(path, markdown) {\n   109\t  const r = await fetch('/api/page', {\n   110\t    method: 'POST', headers: { 'content-type': 'application/json' },\n   111\t    body: JSON.stringify({ action: 'save', path, markdown }),\n   112\t  }).then((x) => x.json()).catch(() => null)\n   113\t  if (!r || r.error || !r.ok) throw new Error('save: ' + ((r && r.error) || 'fail'))\n   114\t  return r\n   115\t}\n   116\t\n   117\t// Dimensions image best-effort.\n   118\tasync function imageDims(fileOrBlob) {\n   119\t  try {\n   120\t    const bmp = await createImageBitmap(fileOrBlob)\n   121\t    const d = { w: bmp.width, h: bmp.height }\n   122\t    bmp.close && bmp.close()\n   123\t    return d\n   124\t  } catch { return {} }\n   125\t}\n   126\t\n   127\t// Durée vidéo best-effort via élément <video> (probe.duration).\n   128\tasync function videoDuration(file) {\n   129\t  try {\n   130\t    return await new Promise((res) => {\n   131\t      const v = document.createElement('video')\n   132\t      v.preload = 'metadata'\n   133\t      const u = URL.createObjectURL(file)\n   134\t      const done = (val) => { res(val); URL.revokeObjectURL(u) }\n   135\t      v.onloadedmetadata = () => done(v.duration || 0)\n   136\t      v.onerror = () => done(0)\n   137\t      v.src = u\n   138\t      setTimeout(() => done(0), 4000)\n   139\t    })\n   140\t  } catch { return 0 }\n   141\t}\n   142\t\n   143\t// --- routage par type ------------------------------------------------------\n   144\t\n   145\tfunction destFolder(folder) {\n   146\t  return String(folder || 'pages').replace(/\\/$/, '')\n   147\t}\n   148\t\n   149\t// IMAGE : hash -> shard ab/cd/<hash>.<ext> + vignette webp dérivée -> nœud .img.json.\n   150\tasync function captureImage(file, folder, onProgress) {\n   151\t  const ab = await file.arrayBuffer()\n   152\t  const hash = await sha256Hex(ab)\n   153\t  const ext = extOf(file.name, file.type)\n   154\t  const path = shardPathFor(hash, ext)\n   155\t\n   156\t  const repo = await activeShard()\n   157\t  if (onProgress) onProgress(0.1)\n   158\t\n   159\t  const binSha = await putBlob(repo, abToB64(ab))\n   160\t  if (onProgress) onProgress(0.5)\n   161\t\n   162\t  const files = [{