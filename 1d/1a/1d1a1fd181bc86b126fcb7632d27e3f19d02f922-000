 = Array.from({ length: count }, (_, i) => pad(i))\n   207\t  return { repo, dir, parts, count, size: file.size }\n   208\t}\n   209\t\n   210\t// VIDEO web-native (mp4/webm/ogg) : chunke + nœud .media.json (probe.duration).\n   211\tasync function captureVideoNative(file, folder, onProgress) {\n   212\t  const duration = await videoDuration(file)\n   213\t  const { repo, dir, parts, count, size } = await uploadBinaryChunks(file, onProgress)\n   214\t  const manifest = {\n   215\t    type: 'chunked-media', v: 1, name: file.name, mime: file.type || 'video/mp4',\n   216\t    size, chunkSize: CHUNK_SIZE, count, dir, parts,\n   217\t    repo, probe: { duration: duration || 0, audio: [], subs: [] },\n   218\t  }\n   219\t  const nodePath = `${destFolder(folder)}/${sanitize(file.name)}.${rand()}.media.json`\n   220\t  await writeNode(nodePath, JSON.stringify(manifest))\n   221\t  if (onProgress) onProgress(1)\n   222\t  return { ok: true, type: 'video', nodePath, name: file.name }\n   223\t}\n   224\t\n   225\t// VIDEO non web-native (mkv/avi/mov, etc.) : le navigateur ne sait pas la lire.\n   226\t// On NE chunke RIEN ici (le binaire brut serait illisible). À la place :\n   227\t//  (a) on écrit tout de suite un nœud .media.json PLACEHOLDER {transcoding:true}\n   228\t//      pour que la vidéo apparaisse dans le Finder avec un statut visible ;\n   229\t//  (b) on enregistre la vidéo dans la file pages/.zr-transcode-queue.json.\n   230\t// Le transcodage mkv->mp4 (ffmpeg) se fait ensuite EN LOCAL via\n   231\t// scripts/video-transcode.mjs ; ce script remplit le .media.json final.\n   232\tasync function captureVideoTranscode(file, folder, onProgress) {\n   233\t  const mime = file.type || 'video/x-matroska'\n   234\t  const nodePath = `${destFolder(folder)}/${sanitize(file.name)}.${rand()}.media.json`\n   235\t\n   236\t  // (a) Nœud placeholder : pas de parts/dir/repo (rien d'uploadé), transcoding:true.\n   237\t  const manifest = {\n   238\t    type: 'chunked-media', v