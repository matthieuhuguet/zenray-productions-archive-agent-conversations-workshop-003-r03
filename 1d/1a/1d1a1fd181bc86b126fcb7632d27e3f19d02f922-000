n    73\t    method: 'POST', headers: { 'content-type': 'application/json' },\n    74\t    body: JSON.stringify(payload),\n    75\t  }).then((x) => x.json()).catch(() => null)\n    76\t  return r\n    77\t}\n    78\t\n    79\t// Récupère le shard actif (repo zenray-media-NN qui a de la place).\n    80\tasync function activeShard() {\n    81\t  const r = await shardApi({ action: 'active-shard' })\n    82\t  if (!r || r.error || !r.repo) throw new Error('active-shard: ' + ((r && r.error) || 'fail'))\n    83\t  return r.repo\n    84\t}\n    85\t\n    86\t// Crée un blob brut dans le shard, avec 1 retry léger (re-create = même sha, idempotent).\n    87\tasync function putBlob(repo, b64) {\n    88\t  let sha = null\n    89\t  for (let attempt = 0; attempt < 2 && !sha; attempt++) {\n    90\t    const r = await shardApi({ action: 'blob', repo, b64 })\n    91\t    if (r && r.ok && r.sha) sha = r.sha\n    92\t  }\n    93\t  if (!sha) throw new Error('blob failed')\n    94\t  return sha\n    95\t}\n    96\t\n    97\t// Commit atomique d'une liste de fichiers {path, sha} dans le shard.\n    98\tasync function commitShard(repo, files, addBytes) {\n    99\t  const r = await shardApi({ action: 'commit', repo, files, addBytes })\n   100\t  if (!r || r.error || !r.ok) throw new Error('commit: ' + ((r && r.error) || 'fail'))\n   101\t  return r\n   102\t}\n   103\t\n   104\t// Écrit un nœud (manifest texte) dans zenray-content via /api/page action save.\n   105\tasync function writeNode(path, markdown) {\n   106\t  const r = await fetch('/api/page', {\n   107\t    method: 'POST', headers: { 'content-type': 'application/json' },\n   108\t    body: JSON.stringify({ action: 'save', path, markdown }),\n   109\t  }).then((x) => x.json()).catch(() => null)\n   110\t  if (!r || r.error || !r.ok) throw new Error('save: ' + ((r && r.error) || 'fail'))\n   111\t  return r\n   112\t}\n   113\t\n   114\t// Dimensions image best-effort.\n   115\tasync function imageDims(fileOrBlob) {\n   116\t  try {\n   117\t    const bmp = await createImageBitmap(fileOrBlob)\n   118\t    const d = { w: bmp.width, h: bmp.height }\n   119\t    bmp.close && bmp.close()\n   120\t    return d\n   121\t  } catch { return {} }\n   122\t}\n   123\t\n   124\t// Durée vidéo best-effort via élément <video> (probe.duration).\n   125\tasync function videoDuration(file) {\n   126\t  try {\n   127\t    return await new Promise((res) => {\n   128\t      const v = document.createElement('video')\n   129\t      v.preload = 'metadata'\n   130\t      const u = URL.createObjectURL(file)\n   131\t      const done = (val) => { res(val); URL.revokeObjectURL(u) }\n   132\t      v.onloadedmetadata = () => done(v.duration || 0)\n   133\t      v.onerror = () => done(0)\n   134\t      v.src = u\n   135\t      setTimeout(() => done(0), 4000)\n   136\t    })\n   137\t  } catch { return 0 }\n   138\t}\n   139\t\n   140\t// --- routage par type ------------------------------------------------------\n   141\t\n   142\tfunction destFolder(folder) {\n   143\t  return String(folder || 'pages').replace(/\\/$/, '')\n   144\t}\n   145\t\n   146\t// IMAGE : hash -> shard ab/cd/<hash>.<ext> + vignette webp dérivée -> nœud .img.json.\n   147\tasync function captureImage(file, folder, onProgress) {\n   148\t  const ab = await file.arrayBuffer()\n   149\t  const hash = await sha256Hex(ab)\n   150\t  const ext = extOf(file.name, file.type)\n   151\t  const path = shardPathFor(hash, ext)\n   152\t\n   153\t  const repo = await activeShard()\n   154\t  if (onProgress) onProgress(0.1)\n   155\t\n   156\t  const binSha = await putBlob(repo, abToB64(ab))\n   157\t  if (onProgress) onProgress(0.5)\n   158\t\n   159\t  const files = [{ path, sha: binSha }]\n   160\t  let addBytes = file.size\n   161\t\n   162\t  // Vignette webp dérivée (même path en .webp), best-effort : un échec ne bloque pas.\n   163\t  const thumb = await makeThumbWebp(file, 384)\n   164\t  if (thumb) {\n   165\t    try {\n   166\t      const thumbAb =