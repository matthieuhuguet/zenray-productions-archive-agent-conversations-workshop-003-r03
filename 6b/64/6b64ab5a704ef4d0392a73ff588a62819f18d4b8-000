{"timestamp":"2026-08-05T18:45:07.257Z","ordinal":72,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019fd33e-5c39-7c33-9302-bd4b45d63ad7","call_id":"call_62u9Wrj1FapA1bdZ4tSnnXaK","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"__PLAN_CONSTANTS_AND_FORMATTERS__\nimport React, { useEffect, useMemo, useRef, useState } from 'react'\nimport { UI } from '../config/colors.js'\nimport Icon from '../components/Icon.jsx'\nimport { PALETTE } from '../theme.js'\nimport { readJson, saveJsonWithRetry } from '../lib/saveJson.js'\nimport { getIndexPaths, getNodeThumb, loadSearchIndex } from '../search/searchIndexClient.js'\nimport { interpolatedScore, planScore } from './planScore.js'\nimport './PlanBoard.css'\n\n// ZenRay Plan (2026-07-20) -- calendrier/tâches, port fidèle de Memory/Design/ui-design/\n// ui-components-zenray-v14.html (section ZenRay Plan). Un fichier .plan.json = un calendrier complet\n// (titre + liste de tâches), au même titre qu'une playlist .media.json contient ses pistes.\n//\n// TOUTE l'interface est en ANGLAIS : le fichier de référence est écrit intégralement en anglais\n// (Today, \"19 July 2026\", Mon..Sun, Missed deadlines, Time block, Add/Cancel...) -- retour Matthieu\n// 2026-07-20 après un premier passage traduit en français par erreur.\n\nconst MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']\nconst MONTHS_SHORT = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']\nconst WEEKDAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']\n// Libellés LITTÉRAUX de la référence (markup v14 : \"30\" / \"90\" / \"2h\" / \"4h\"), jamais calculés.\nconst DURATION_PRESETS = [{ minutes: 30, label: '30' }, { minutes: 90, label: '90' }, { minutes: 120, label: '2h' }, { minutes: 240, label: '4h' }]\n\nconst pad2 = (n) => String(n).padStart(2, '0')\nconst isoOf = (d) => `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`\nconst todayIso = () => isoOf(new Date())\nconst parseIso = (s) => { const [y, m, d] = String(s || '').split('-').map(Number); return new Date(y || 2026, (m || 1) - 1, d || 1) }\nconst addDays = (iso, delta) => { const d = parseIso(iso); d.setDate(d.getDate() + delta); return isoOf(d) }\nconst fmtDuration = (min) => (min >= 60 ? (min % 60 ? `${Math.floor(min / 60)}h${min % 60}` : `${min / 60}h`) : `${min}m`)\n// \"19 July 2026\" -- format exact du readout de la référence (fullDateForDay).\nconst fmtFullDate = (iso) => { const d = parseIso(iso); return `${d.getDate()} ${MONTHS[d.getMonth()]} ${d.getFullYear()}` }\n// \"Jul 18\" -- format court des lignes Overdue de la référence (\"Missed Jul 18 · 90m\").\nconst fmtShortDate = (iso) => { const d = parseIso(iso); return `${MONTHS_SHORT[d.getMonth()]} ${d.getDate()}` }\nconst uid = () => `${Date.now().toString(36)}${Math.random().toString(36).slice(2, 7)}`\n// Verrou d'engagement (retour Matthieu 2026-07-20, choix de design assumé) : une tâche créée il y a\n// plus de 4 heures ne peut PLUS être supprimée -- \"si tu t'engages à créer une tâche, tu t'y tiens\",\n// c'est exactement pour ça que les manquées s'accumulent dans Missed deadlines au lieu de disparaître.\nconst DELETE_WINDOW_MS = 4 * 3600 * 1000\nconst canDeleteTask = (task) => !task?.createdAt || (Date.now() - Date.parse(task.createdAt)) < DELETE_WINDOW_MS\n// Images d'une tâche : nouveau champ `images` (tableau d'URLs/dataURLs) ; l'ancien champ `image`\n// ('placeholder' du prototype) est ignoré s'il ne pointe pas une vraie image.\nconst imagesOf = (task) => Array.isArray(task?.images) ? task.images : (task?.image && task.image !== 'placeholder' ? [task.image] : [])\n// Fréquences de streak : jamais plus d'une occurrence PAR JOUR (décision explicite), donc l'intervalle\n// minimal est 1 jour. Libellés courts affichés DANS les ronds (mêmes ronds que les presets de durée).\nconst STREAK_PRESETS = [{ days: 1, label: '1d' }, { days: 2, label: '2d' }, { days: 3, label: '3d' }, { days: 7, label: '7d' }]\nconst STREAK_MAX_OCCURRENCES = 120\n// Réduction d'une image collée : dataURL JPEG bornée à 1024px de large -- un screenshot brut pèserait\n// des centaines de Ko dans le .plan.json (sauvé via l'API GitHub), le canvas le ramène à ~50-120 Ko.\nconst shrinkImageFile = (file) => new Promise((resolve) => {\n  const url = URL.createObjectURL(file)\n  const img = new Image()\n  img.onload = () => {\n    const scale = Math.min(1, 1024 / img.width)\n    const canvas = document.createElement('canvas')\n    canvas.width = Math.round(img.width * scale)\n    canvas.height = Math.round(img.height * scale)\n    canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height)\n    URL.revokeObjectURL(url)\n    resolve(canvas.toDataURL('image/jpeg', 0.82))\n  }\n  img.onerror = () => { URL.revokeObjectURL(url); resolve(null) }\n  img.src = url\n})\nconst wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms))\nconst emptyBoard = () => ({ type: 'plan', v: 1, title: 'Plan', tasks: [], createdAt: new Date().toISOString() })\n\n// Grille mensuelle : autant de rangées de 7 que nécessaire pour couvrir le mois (4/5/6 selon les mois),\n// jamais un padding fixe à 6 -- chaque cellule porte sa vraie date, `outside` = mois adjacent.\nfunction buildMonthGrid(year, month) {\n  const firstWeekday = (new Date(year, month, 1).getDay() + 6) % 7 // lundi = 0\n  const daysInMonth = new Date(year, month + 1, 0).getDate()\n  const total = Math.ceil((firstWeekday + daysInMonth) / 7) * 7\n  const cells = []\n  for (let i = 0; i < total; i++) {\n    const d = new Date(year, month, i - firstWeekday + 1)\n    cells.push({ iso: isoOf(d), day: d.getDate(), outside: d.getMonth() !== month })\n  }\n  return cells\n}\n\n// Algorithme de placement EXACT du fichier de référence (performOpen, script v14) : préférence colonnes\n// de droite, bascule à gauche près du bord, bascule vers le haut sur la dernière rangée. L'ancre (la\n// cellule de la tâche cliquée) n'est JAMAIS absorbée : le bloc occupe les 2x2 cellules voisines.\nfunction computePlacement(cellIndex, totalCells) {\n  const row = Math.floor(cellIndex / 7) + 1\n  const col = (cellIndex % 7) + 1\n  const side = col <= 5 ? 'right' : 'left'\n  const maxRows = Math.ceil(totalCells / 7)\n  const vertical = row < maxRows ? 'down' : 'up'\n  const startCol = side === 'right' ? col + 1 : col - 2\n  const startRow = vertical === 'down' ? row : Math.max(1, row - 1)\n  return { side, vertical, startCol, startRow }\n}\nfunction absorbedIsosFor(cells, { startCol, startRow }) {\n  const out = []\n  cells.forEach((cell, index) => {\n    const r = Math.floor(index / 7) + 1\n    const c = (index % 7) + 1\n    if (r >= startRow && r < startRow + 2 && c >= startCol && c < startCol + 2) out.push(cell.iso)\n  })\n  return out\n}\n\n// Statut affiché = DÉRIVÉ à la lecture (jamais stocké \"late\" tel quel) : en retard = date passée et pas\n// terminé. `overdueSince` se fixe une seule fois et ne bouge plus -- badge \"Missed ...\" conservé même\n// après un rescue \"Today\" (règle explicite : jamais traité comme une tâche neuve). Libellés = ceux du\n// statusFor de la référence.\nfunction statusOf(task, today) {\n  if (task.status === 'late-complete') return { key: 'late-complete', tone: 'violet', label: 'Finished later' }\n  if (task.status === 'done') return { key: 'done', tone: 'green', label: 'Done on time' }\n  if (task.date < today) return { key: 'late', tone: 'orange', label: 'Past deadline' }\n  return { key: 'planned', tone: '', label: 'Planned' }\n}\n\n// Éditeur du bloc de détail (titre + note) -- bug réel corrigé le 2026-07-20 (\"à mesure que j'écris,\n// l'écriture se désagrège\") : les champs étaient contrôlés par le board GLOBAL avec sauvegarde débouncée ;\n// quand le round-trip GitHub (1-2 s) revenait, son setBoard(res.data) écrasait les frappes tapées ENTRE\n// TEMPS -- caractères perdus, curseur qui saute. Solution (le pattern Notion/Apple Notes) : la frappe vit\n// dans un BUFFER LOCAL, rien ne part au réseau pendant qu'on tape ; le commit se fait au blur du champ et\n// à la fermeture du bloc (unmount -- y compris fermeture auto/Escape/changement de tâche). key={task.id}\n// posé par l'appelant garantit un buffer neuf par tâche ouverte.\n// Sélecteur d'images DU SITE : uniquement l'index auto-généré (getIndexPaths + getNodeThumb) --\n// ZÉRO appel REST/raw par résultat (règle dure post-incident quota du 2026-07-20). thumb.u est une\n// URL CDN directe, utilisée telle quelle comme vignette ET comme image stockée dans la tâche.\n// Sélecteur de date maison (retour Matthieu 2026-07-20 : \"je ne veux pas taper la date, je veux un\n// tableau/widget avec le bon liseré\" -- le calendrier natif du navigateur (\"truc Windows moche\") est\n// remplacé partout par ce mini-calendrier, même recette glass/rim que le reste du Plan (--zrp-rim,\n// pas l'opaque .zrp-popover). Réutilise buildMonthGrid/MONTHS déjà définis plus haut dans ce fichier.\nfunction MiniCalendar({ value, min, onSelect }) {\n  const base = parseIso(value || todayIso())\n  const [view, setView] = useState({ year: base.getFullYear(), month: base.getMonth() })\n  const cells = useMemo(() => buildMonthGrid(view.year, view.month), [view])\n  const shiftMonth = (delta) => setView((v) => { const d = new Date(v.year, v.month + delta, 1); return { year: d.getFullYear(), month: d.getMonth() } })\n  const today = todayIso()\n  return (\n    <div className=\"zrp-mini-cal\" onClick={(e) => e.stopPropagation()}>\n      <div className=\"zrp-mini-cal-head\">\n        <button type=\"button\" aria-label=\"Previous month\" onClick={() => shiftMonth(-1)}><Icon name=\"chevron.left\" size={12} /></button>\n        <span>{MONTHS[view.month]} {view.year}</span>\n        <button type=\"button\" aria-label=\"Next month\" onClick={() => shiftMonth(1)}><Icon name=\"chevron.right\" size={12} /></button>\n__TASK_INTERACTIONS__\n  const draftRef = useRef(null)\n  draftRef.current = { title, note, changed: title !== task.title || note !== (task.note || '') }\n  const onCommitRef = useRef(onCommit)\n  onCommitRef.current = onCommit\n  useEffect(() => () => {\n    const draft = draftRef.current\n    if (draft.changed) onCommitRef.current({ title: draft.title.trim() || 'Untitled', note: draft.note })\n  }, [])\n  const commitNow = () => {\n    const draft = draftRef.current\n    if (draft.changed) onCommit({ title: draft.title.trim() || 'Untitled', note: draft.note })\n  }\n  const status = statusOf(task, today)\n  const images = imagesOf(task)\n  const deletable = canDeleteTask(task)\n  // Le titre suit EXACTEMENT le verrou d'engagement de la corbeille, pas une règle à lui : si une tâche\n  // de plus de quatre heures ne peut plus être supprimée, la renommer serait la même échappatoire par\n  // un autre chemin. En deçà, l'erreur de frappe se corrige librement.\n  const refuseTitle = () => {\n    const el = titleInputRef.current\n    if (!el || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return\n    // ANIMATION PILOTÉE, PAS UNE CLASSE CSS. Rejouer une animation par ajout et retrait de classe\n    // demande de laisser passer une image entre les deux, donc un `requestAnimationFrame`, donc un\n    // état React et un minuteur à nettoyer : quatre pièces mobiles pour un clignotement. L'API\n    // d'animation le fait en un appel, et surtout elle se MESURE (`el.getAnimations()`), alors\n    // qu'une classe posée pendant une frame ne se vérifie pas.\n    // `cancel()` avant de rejouer : sans lui, un second refus pendant le clignotement ne produit\n    // rien du tout, et l'interface paraît morte au moment précis où elle doit répondre.\n    for (const a of el.getAnimations()) a.cancel()\n    el.animate(\n      [{ opacity: 1, filter: 'none' }, { opacity: 0.5, filter: 'contrast(0.4)' }, { opacity: 1, filter: 'none' }],\n      { duration: 700, easing: 'ease-in-out' },   // 0,35 s à l'aller, 0,35 s au retour\n    )\n  }\n  return (\n    <>\n      <header className=\"zrp-detail-head\">\n        <input ref={titleInputRef} className={`zrp-detail-title${deletable ? '' : ' zrp-locked-title'}`}\n          value={title} aria-label=\"Task title\" readOnly={!deletable}\n          title={deletable ? undefined : 'Locked — a goal older than 4h can’t be renamed'}\n          onMouseDown={deletable ? undefined : refuseTitle}\n          onChange={(e) => { if (deletable) setTitle(e.target.value) }}\n          onBlur={deletable ? commitNow : undefined}\n          onKeyDown={(e) => { if (!deletable) { refuseTitle(); return } if (e.key === 'Enter') { e.preventDefault(); e.currentTarget.blur() } }} />\n        <div className=\"zrp-detail-tools\">\n          <button type=\"button\" className={`zrp-detail-icon${images.length ? ' zrp-active' : ''}`} title=\"Images\" aria-label=\"Add images\"\n            onClick={() => setPickerOpen((v) => !v)}><Icon name=\"photo\" size={13} /></button>\n          {/* Verrou d'engagement : au-delà de 4h après création, la corbeille est grisée et inerte. */}\n          <button type=\"button\" className={`zrp-detail-icon${deletable ? '' : ' zrp-locked'}`} disabled={!deletable}\n            title={deletable ? 'Delete task' : 'Locked — a goal older than 4h can’t be deleted'}\n            aria-label=\"Delete task\" onClick={deletable ? onDelete : undefined}><Icon name=\"trash\" size={13} /></button>\n          <button type=\"button\" className=\"zrp-detail-icon\" title=\"Close\" aria-label=\"Close task detail\" onClick={onClose}><Icon name=\"xmark\" size={13} /></button>\n        </div>\n      </header>\n      <div className=\"zrp-detail-status\">\n        <i className={`zrp-status-dot zrp-${status.tone}`} />\n        <span className=\"zrp-status-copy\">{status.label}{task.overdueSince && status.key !== 'planned' ? ` · Missed ${fmtShortDate(task.overdueSince)}` : ''}{task.streakId ? ' · Streak' : ''}{task.publish ? ' · Publication' : ''}{task.firstMovement ? ' · First movement' : ''}</span>\n      </div>\n      {pickerOpen && <ImagePicker onPick={(url) => { onPatch({ images: [...images, url], image: null }) }} onClose={() => setPickerOpen(false)} />}\n      <textarea className=\"zrp-detail-note\" placeholder=\"Write a short note…\" aria-label=\"Task note\" value={note}\n        onChange={(e) => setNote(e.target.value)} onBlur={commitNow} />\n      {images.length > 0 && (\n        <div className=\"zrp-images\" role=\"list\" aria-label=\"Task images\">\n          {images.map((src, index) => (\n            <div key={`${index}:${src.slice(0, 32)}`} className=\"zrp-image\" role=\"listitem\" style={{ backgroundImage: `url(${src})` }}>\n              <button type=\"button\" className=\"zrp-image-remove\" title=\"Remove image\" aria-label=\"Remove image\"\n                onClick={() => onPatch({ images: images.filter((_, i) => i !== index), image: null })}><Icon name=\"xmark\" size={10} /></button>\n            </div>\n          ))}\n        </div>\n      )}\n      <footer className=\"zrp-detail-meta\">\n        <button type=\"button\" className={`zrp-meta-chip${editingMeta === 'date' ? ' zrp-active' : ''}`}\n          onClick={() => setEditingMeta((v) => v === 'date' ? null : 'date')}><strong>Date</strong>{fmtFullDate(task.date)}</button>\n        <button type=\"button\" className={`zrp-meta-chip${editingMeta === 'start' ? ' zrp-active' : ''}`}\n          onClick={() => setEditingMeta((v) => v === 'start' ? null : 'start')}><strong>Start</strong>{fmt12(task.startTime)}</button>\n        <button type=\"button\" className={`zrp-meta-chip${editingMeta === 'block' ? ' zrp-active' : ''}`}\n          onClick={() => setEditingMeta((v) => v === 'block' ? null : 'block')}><strong>Block</strong>{fmtDuration(task.durationMin || 0)}</button>\n      </footer>\n      {editingMeta === 'date' && (\n        <div className=\"zrp-meta-editor zrp-meta-editor-cal\">\n          <MiniCalendar value={task.date} onSelect={(iso) => { onPatch({ date: iso }); setEditingMeta(null) }} />\n        </div>\n      )}\n      {editingMeta === 'start' && (\n        <div className=\"zrp-meta-editor zrp-meta-editor-cal\">\n          <button type=\"button\" className=\"zrp-meta-now\" title=\"Use current time\" onClick={() => { const n = new Date(); onPatch({ startTime: `${pad2(n.getHours())}:${pad2(n.getMinutes())}` }); setEditingMeta(null) }}><Icon name=\"clock.arrow.2.circlepath\" size={13} />Now</button>\n          <MiniTimePicker value={task.startTime} onSelect={(time) => onPatch({ startTime: time })} />\n        </div>\n      )}\n      {editingMeta === 'block' && (\n        <div className=\"zrp-meta-editor zrp-meta-editor-block\">\n          {DURATION_PRESETS.map(({ minutes, label }) => (\n            <button key={minutes} type=\"button\" className={`zrp-duration zrp-duration-sm${(task.durationMin || 0) === minutes ? ' zrp-active' : ''}`}\n              onClick={() => onPatch({ durationMin: minutes })}>{label}</button>\n          ))}\n          <input type=\"number\" min={5} max={240} step={5} value={task.durationMin || 0} aria-label=\"Custom minutes\"\n            onChange={(e) => { const v = Math.max(5, Math.min(240, Number(e.target.value) || 5)); onPatch({ durationMin: v }) }} />\n        </div>\n      )}\n    </>\n  )\n}\n\nfunction TaskTile({ task, today, onOpen, onToggleDone }) {\n  const status = statusOf(task, today)\n  const completed = status.key === 'done' || status.key === 'late-complete'\n  const tileRef = useRef(null)\n  const toggleDone = () => {\n    if (!completed && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n      for (const animation of tileRef.current?.getAnimations() || []) animation.cancel()\n      tileRef.current?.animate(\n        [\n          { transform: 'scale(1)', filter: 'brightness(1.06)' },\n          { transform: 'scale(.975)', filter: 'brightness(.99)', offset: .38 },\n          { transform: 'scale(1.014)', filter: 'brightness(1.08)', offset: .72 },\n          { transform: 'scale(1)', filter: 'brightness(1)' },\n        ],\n        { duration: 200, easing: 'cubic-bezier(.16,1,.3,1)' },\n      )\n    }\n    onToggleDone(task)\n  }\n  return (\n    // stopPropagation : bug réel corrigé le 2026-07-20 (\"les tâches disparaissent immédiatement au\n    // clic\") -- sans lui, le clic REMONTAIT jusqu'à la cellule du jour, dont le onClick appelle\n    // closePanel() : l'ouverture (requête posée par CE clic) était aussitôt écrasée par une demande de\n    // fermeture posée par LE MÊME clic, et la boucle d'animation ouvrait puis refermait le bloc dans la\n    // foulée. La référence évite ça avec un unique listener sur la grille (closest('.goal') -> return).\n    <button ref={tileRef} type=\"button\" className={`zrp-task${status.key === 'done' ? ' zrp-done' : ''}${status.key === 'late-complete' ? ' zrp-late-complete' : ''}${status.key === 'late' && !task.publish ? ' zrp-late' : ''}${task.publish && status.key === 'planned' ? ' zrp-publish' : ''}${task.publish && status.key === 'late' ? ' zrp-publish-late' : ''}${task.publish && (status.key === 'done' || status.key === 'late-complete') ? ' zrp-publish-done' : ''}${imagesOf(task).length ? ' zrp-has-image' : ''}`}\n      onClick={(e) => { e.stopPropagation(); onOpen(task) }} title={task.title}>\n      <input type=\"checkbox\" checked={completed}\n        onClick={(e) => e.stopPropagation()} onChange={toggleDone} aria-label={`${task.title} done`} />\n      {task.startTime && <span className=\"zrp-task-time\">{fmt12(task.startTime)}</span>}\n      <span className=\"zrp-task-title\">{task.title}</span>\n      {imagesOf(task).length > 0 && <span className=\"zrp-task-image-badge\"><Icon name=\"photo\" size={10} /></span>}\n__DETAIL_MOTION_COMPLETE__\n  const [legendOpen, setLegendOpen] = useState(false)\n  const [draft, setDraft] = useState({ title: '', date: today, time: '09:00', duration: 90, customOpen: false, customMinutes: 60, streak: false, streakEvery: 1, streakEnd: '', publish: false, firstMovement: false })\n  // Popovers des 3 champs date/heure du composer (Date / Start / Streak Ends) -- un seul ouvert à la\n  // fois, fermeture au clic ailleurs (même patron que editingMeta du DetailEditor).\n  const [composerPicker, setComposerPicker] = useState(null) // 'date' | 'start' | 'end' | null\n\n  // Bloc 2x2 : `renderedId` piloté aussi via ref (pas seulement state) -- la chorégraphie async\n  // (performOpen/performClose) doit toujours lire la valeur FRAÎCHE, jamais une closure figée au moment\n  // de l'await précédent.\n  const [renderedId, setRenderedIdState] = useState(null)\n  const renderedIdRef = useRef(null)\n  const setRenderedId = (id) => { renderedIdRef.current = id; setRenderedIdState(id) }\n  const [absorbedIsos, setAbsorbedIsos] = useState([])\n  const [panelGeometry, setPanelGeometry] = useState(null)\n  const [shellVisible, setShellVisible] = useState(false)\n  const [contentVisible, setContentVisible] = useState(false)\n  const motionRunningRef = useRef(false)\n  const requestedRef = useRef(undefined)\n  // Instantané de la tâche ouverte : permet à l'animation de FERMETURE de continuer à afficher le\n  // contenu même si la tâche vient d'être SUPPRIMÉE du board (sinon le bloc disparaissait brutalement\n  // et les cellules absorbées restaient invisibles pour toujours).\n  const renderedTaskRef = useRef(null)\n  const titleInputRef = useRef(null)\n  // UNE SEULE PISTE MONTÉE À LA FOIS, et c'est un correctif de PERTE DE DONNÉES.\n  //\n  // Le CSS masque `.zrp-calendar` sous 680 px et `.zrp-mobile-days` au-dessus, mais React montait les\n  // DEUX en permanence. `DetailEditor` existait donc en deux instances simultanées, chacune avec son\n  // propre `useState(task.title)`. On tapait dans celle qu'on voyait ; l'autre, invisible, gardait\n  // l'ancien titre. Au démontage, les deux nettoyages tiraient : celui de la piste visible ne faisait\n  // rien puisque son titre égalait désormais celui de la tâche, et celui de la piste FANTÔME comparait\n  // son ancien titre au nouveau, se croyait porteur d'une frappe en attente, et RÉÉCRIVAIT l'ancien.\n  //\n  // Le titre était donc bien enregistré, puis écrasé dans la milliseconde par un éditeur qu'on ne voit\n  // pas. La note subissait le même sort et `titleInputRef` était écrasé par le second montage.\n  // `display:none` cache un composant, il ne l'empêche ni de tenir un état ni de l'écrire.\n  const [isNarrow, setIsNarrow] = useState(() => typeof window !== 'undefined' && window.matchMedia('(max-width: 680px)').matches)\n  useEffect(() => {\n    const mq = window.matchMedia('(max-width: 680px)')\n    const onChange = (e) => setIsNarrow(e.matches)\n    mq.addEventListener('change', onChange)\n    return () => mq.removeEventListener('change', onChange)\n  }, [])\n  // Piste mobile \"un jour = un slot plein écran\" (retour Matthieu 2026-07-20) : synchro bidirectionnelle\n  // avec selectedIso -- Today/‹ › (stepDay/goToday) scrollent la piste jusqu'au jour choisi (effet ci-\n  // dessous) ; le swipe manuel remonte l'info dans l'autre sens (onStripScroll, débattu 120ms pour ne\n  // lire la position qu'une fois le scroll-snap posé).\n  const mobileStripRef = useRef(null)\n  const stripSettleRef = useRef(null)\n\n  useEffect(() => {\n    let live = true\n    setLoading(true)\n    readJson(path).then(({ data }) => { if (live) { setBoard(data && data.type === 'plan' ? data : emptyBoard()); setLoading(false) } })\n    return () => { live = false }\n  }, [path])\n\n  const cells = useMemo(() => buildMonthGrid(cursor.year, cursor.month), [cursor])\n  const score = useMemo(() => planScore(board?.tasks), [board])\n  const tasksByDate = useMemo(() => {\n    const map = new Map()\n    for (const task of (board?.tasks || [])) { if (!map.has(task.date)) map.set(task.date, []); map.get(task.date).push(task) }\n    // TRI PAR HEURE DE DÉBUT. Sans lui, les tâches d'un jour se rangeaient dans l'ordre de création :\n    // on posait une tâche à 19 h, elle s'affichait au-dessus de celle de 9 h, et l'heure choisie ne se\n    // voyait donc nulle part. Le symptôme se lisait « l'horaire n'est pas sauvegardé » alors qu'il\n    // l'était depuis le début ; il n'était ni affiché ni ordonnant. Les tâches sans heure ferment la\n    // journée : une tâche sans horaire n'a pas de place particulière, elle n'en a aucune.\n    for (const list of map.values()) {\n      list.sort((a, b) => (a.startTime || '99:99').localeCompare(b.startTime || '99:99'))\n    }\n    return map\n  }, [board])\n  // La pile Missed deadlines REPART À NEUF chaque mois (retour Matthieu 2026-07-20) : seules les\n  // échéances manquées du MOIS CALENDAIRE COURANT s'accumulent ici -- celles des mois précédents\n  // restent orange dans leurs cellules, mais ne hantent plus la boîte de réception indéfiniment.\n  const monthStartIso = `${today.slice(0, 7)}-01`\n  const overdueTasks = useMemo(() => (board?.tasks || []).filter((task) => statusOf(task, today).key === 'late' && task.date >= monthStartIso), [board, today, monthStartIso])\n\n  // Garde de séquence (2026-07-20, la moitié serveur du bug \"l'écriture se désagrège\") : le résultat\n  // d'un save GitHub (1-2 s de round-trip) ne ré-écrase le board QUE s'il est encore le plus récent --\n  // sinon un res.data périmé annulait les modifications faites pendant le vol (frappes, coche, rescue).\n  const saveSeqRef = useRef(0)\n  const persist = (mutateFn) => {\n    setBoard((prev) => mutateFn(prev || emptyBoard()))\n    const seq = ++saveSeqRef.current\n    saveJsonWithRetry(path, (cur) => mutateFn(cur && cur.type === 'plan' ? cur : emptyBoard()))\n      .then((res) => { if (res.ok && seq === saveSeqRef.current) setBoard(res.data) })\n  }\n  const updateTask = (taskId, patch) => persist((cur) => ({ ...cur, tasks: cur.tasks.map((tk) => (tk.id === taskId ? { ...tk, ...patch } : tk)) }))\n\n  // ── Bloc de détail Lego Fusion 2x2 -- chorégraphie et timings EXACTS de la référence ──────────────\n  const performClose = async () => {\n    if (!renderedIdRef.current) return\n    setContentVisible(false)\n    await wait(100)\n    setShellVisible(false)\n    await wait(150)\n    setRenderedId(null)\n    setPanelGeometry(null)\n    setAbsorbedIsos([])\n    renderedTaskRef.current = null\n    await wait(100)\n  }\n  const performOpen = async ({ taskId, cellIndex, totalCells, cellsSnapshot }) => {\n    const task = (board?.tasks || []).find((tk) => tk.id === taskId)\n    if (!task) return\n    setSelectedIso(task.date)\n    const placement = computePlacement(cellIndex, totalCells)\n    setAbsorbedIsos(absorbedIsosFor(cellsSnapshot, placement))\n    await wait(150)\n    renderedTaskRef.current = task\n    setPanelGeometry(placement)\n    setRenderedId(taskId)\n    await new Promise((resolve) => requestAnimationFrame(resolve))\n    setShellVisible(true)\n    await wait(65)\n    setContentVisible(true)\n    await wait(140)\n    titleInputRef.current?.focus({ preventScroll: true })\n  }\n  const runMotion = async () => {\n    if (motionRunningRef.current) return\n    motionRunningRef.current = true\n    try {\n      while (requestedRef.current !== undefined) {\n        const target = requestedRef.current\n        requestedRef.current = undefined\n        if (renderedIdRef.current) await performClose()\n        if (target) await performOpen(target)\n      }\n    } finally {\n      motionRunningRef.current = false\n    }\n  }\n  const requestPanel = (target) => {\n    requestedRef.current = (target && renderedIdRef.current === target.taskId) ? null : target\n    runMotion()\n  }\n  const openTaskAt = (task, cellIndex) => requestPanel({ taskId: task.id, cellIndex, totalCells: cells.length, cellsSnapshot: cells })\n  const closePanel = () => requestPanel(null)\n\n  useEffect(() => {\n    const onKey = (e) => { if (e.key === 'Escape' && renderedIdRef.current) closePanel() }\n    document.addEventListener('keydown', onKey)\n    return () => document.removeEventListener('keydown', onKey)\n  }, []) // eslint-disable-line react-hooks/exhaustive-deps\n\n  // Lookup vivant d'abord (édition en direct), instantané en secours (fermeture après suppression).\n  const panelTask = (board && renderedId ? board.tasks.find((tk) => tk.id === renderedId) : null) || (renderedId ? renderedTaskRef.current : null)\n\n  // ── Navigation jour par jour (v14 remplace le mois-par-mois de v11) ───────────────────────────────\n  const selectDay = (cell) => { setSelectedIso(cell.iso); closePanel() }\n__GLOBAL_FONT_SIZE_DISTRIBUTION_CSS__\n   2  8.5px\n   1 8.5px\n   5  9px\n   1 9px\n   3  9.5px\n   3 9.5px\n   6  10px\n  11  10.5px\n   2 10.5px\n  10  11px\n  19  11.5px\n   4 11.5px\n  74  12px\n  19  12.5px\n  12  13px\n   2  13.5px\n   5  14px\n   5  15px\n   1 15px\n   5  16px\n   1 16px\n   1  17px\n   1  19px\n   1  34px\n__GLOBAL_INLINE_FONT_SIZE_DISTRIBUTION__\n   4  9\n  10  9.5\n  43  10\n  18  10.5\n  81  11\n  35  11.5\n  93  12\n  83  12.5\n 123  13\n  36  13.5\n  34  14\n   6  14.5\n  19  15\n   2  15.5\n  12  16\n   7  17\n   7  18\n   2  19\n   4  20\n   6  21\n   5  22\n   1  23\n   3  24\n   1  25\n   1  26\n   1  28\n   2  30\n   1  32\n   1  38\n   2  40\n   2  46\n__SMALL_FONT_OCCURRENCE_COUNTS__\ncss<=12:      141\ninline<=12:      284\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019fd33d-54f4-7573-bf60-023b62ad88c7"}}}
