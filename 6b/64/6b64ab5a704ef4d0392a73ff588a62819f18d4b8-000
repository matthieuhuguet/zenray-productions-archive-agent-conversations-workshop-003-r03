 />\n    </svg>\n  )\n}\n\nfunction AnimatedDollar({ value }) {\n  const mountedRef = useRef(false)\n  useEffect(() => { mountedRef.current = true }, [])\n  return <span key={value} className={mountedRef.current ? 'zrp-score-icon-mark zrp-score-icon-mark-animated' : 'zrp-score-icon-mark'}><DollarScoreIcon /></span>\n}\n\nfunction AnimatedScore({ value }) {\n  const tweenRef = useRef({ current: value, from: value, to: value })\n  const [tween, setTween] = useState(tweenRef.current)\n\n  useEffect(() => {\n    const from = tweenRef.current.current\n    if (from === value) return undefined\n    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n      const finalTween = { current: value, from: value, to: value }\n      tweenRef.current = finalTween\n      setTween(finalTween)\n      return undefined\n    }\n\n    let frameId\n    let startedAt\n    const draw = (now) => {\n      if (startedAt === undefined) startedAt = now\n      const progress = Math.min(1, (now - startedAt) / 350)\n      const nextTween = { current: interpolatedScore(from, value, progress), from, to: value }\n      tweenRef.current = nextTween\n      setTween(nextTween)\n      if (progress < 1) frameId = window.requestAnimationFrame(draw)\n    }\n    frameId = window.requestAnimationFrame(draw)\n    return () => window.cancelAnimationFrame(frameId)\n  }, [value])\n\n  const direction = tween.to >= tween.from ? 'up' : 'down'\n  const currentInteger = direction === 'up' ? Math.floor(tween.current) : Math.ceil(tween.current)\n  const adjacentInteger = direction === 'up'\n    ? Math.min(currentInteger + 1, tween.to)\n    : Math.max(currentInteger - 1, tween.to)\n  const fraction = direction === 'up' ? tween.current - currentInteger : currentInteger - tween.current\n  const width = Math.max(String(Math.round(tween.from)).length, String(Math.round(tween.to)).length)\n  const currentDigits = String(Math.round(currentInteger)).padStart(width, '\\u00a0')\n  const adjacentDigits = String(Math.round(adjacentInteger)).padStart(width, '\\u00a0')\n  const trackTransform = direction === 'up'\n    ? `translateY(${-fraction}em)`\n    : `translateY(${-1 + fraction}em)`\n\n  return (\n    <span className=\"zrp-score-number\" aria-label={String(value)}>\n      <span aria-hidden=\"true\" className=\"zrp-score-digits\">\n        {Array.from({ length: width }, (_, column) => {\n          const digits = direction === 'up'\n            ? [currentDigits[column], adjacentDigits[column]]\n            : [adjacentDigits[column], currentDigits[column]]\n          return (\n          <span className=\"zrp-score-digit\" key={column}>\n            <span className=\"zrp-score-digit-track\" style={{ transform: trackTransform }}>\n              {digits.map((digit, index) => <span key={index}>{digit}</span>)}\n            </span>\n          </span>\n          )\n        })}\n      </span>\n    </span>\n  )\n}\n\nexport default function PlanBoard({ t, path }) {\n  const [loading, setLoading] = useState(true)\n  const [board, setBoard] = useState(null)\n  const today = todayIso()\n  const [cursor, setCursor] = useState(() => { const d = new Date(); return { year: d.getFullYear(), month: d.getMonth() } })\n  const [selectedIso, setSelectedIso] = useState(today)\n  const [composerOpen, setComposerOpen] = useState(false)\n  const [menuOpen, setMenuOpen] = useState(false)\n  // Sémantique de la RÉFÉRENCE : \"Show completed\" est un interrupteur ALLUMÉ par défaut (les terminées\n  // se voient) ; l'éteindre les masque. Pas un \"Masquer les terminées\" inversé.\n  const [showCompleted, setShowCompleted] = useState(true)\n  const [hideWeekends, setHideWeekends] = useState(false)\n  const [overdueOpen, setOverdueOpen] = useState(true)\n  // Légende repliée par défaut : elle sert une fois, quand on découvre le code couleur, et n'a pas\n  // à occuper le bas de la vue ensuite. Le triangle la rend visible sans la rendre encombrante.\n  const [legendOpen, setLegendOpen] = useState(false)\n  const [draft, setDraft] = useState({ title: '', date: today, time: '09:00', duration: 90, customOpen: false, customMinutes: 60, streak: false, streakEvery: 1, streakEnd: '', publish: false, firstMovement: false })\n  // Popovers des 3 champs date/heure du composer (Date / Start / Streak Ends) -- un seul ouvert à la\n  // fois, fermeture au clic ailleurs (même patron que editingMeta du DetailEditor).\n  const [composerPicker, setComposerPicker] = useState(null) // 'date' | 'start' | 'end' | null\n\n            ? [currentDigits[column], adjacentDigits[column]]\n            : [adjacentDigits[column], currentDigits[column]]\n          return (\n          <span className=\"zrp-score-digit\" key={column}>\n            <span className=\"zrp-score-digit-track\" style={{ transform: trackTransform }}>\n              {digits.map((digit, index) => <span key={index}>{digit}</span>)}\n            </span>\n          </span>\n          )\n        })}\n      </span>\n    </span>\n  )\n}\n\nexport default function PlanBoard({ t, path }) {\n  const [loading, setLoading] = useState(true)\n  const [board, setBoard] = useState(null)\n  const today = todayIso()\n  const [cursor, setCursor] = useState(() => { const d = new Date(); return { year: d.getFullYear(), month: d.getMonth() } })\n  const [selectedIso, setSelectedIso] = useState(today)\n  const [composerOpen, setComposerOpen] = useState(false)\n  const [menuOpen, setMenuOpen] = useState(false)\n  // Sémantique de la RÉFÉRENCE : \"Show completed\" est un interrupteur ALLUMÉ par défaut (les terminées\n  // se voient) ; l'éteindre les masque. Pas un \"Masquer les terminées\" inversé.\n  const [showCompleted, setShowCompleted] = useState(true)\n  const [hideWeekends, setHideWeekends] = useState(false)\n  const [overdueOpen, setOverdueOpen] = useState(true)\n  // Légende repliée par défaut : elle sert une fois, quand on découvre le code couleur, et n'a pas\n  // à occuper le bas de la vue ensuite. Le triangle la rend visible sans la rendre encombrante.\n  const [legendOpen, setLegendOpen] = useState(false)\n  const [draft, setDraft] = useState({ title: '', date: today, time: '09:00', duration: 90, customOpen: false, customMinutes: 60, streak: false, streakEvery: 1, streakEnd: '', publish: false, firstMovement: false })\n  // Popovers des 3 champs date/heure du composer (Date / Start / Streak Ends) -- un seul ouvert à la\n  // fois, fermeture au clic ailleurs (même patron que editingMeta du DetailEditor).\n  const [composerPicker, setComposerPicker] = useState(null) // 'date' | 'start' | 'end' | null\n\n  // Bloc 2x2 : `renderedId` piloté aussi via ref (pas seulement state) -- la chorégraphie async\n  // (performOpen/performClose) doit toujours lire la valeur FRAÎCHE, jamais une closure figée au moment\n  // de l'await précédent.\n  const [renderedId, setRenderedIdState] = useState(null)\n  const renderedIdRef = useRef(null)\n  const setRenderedId = (id) => { renderedIdRef.current = id; setRenderedIdState(id) }\n  const [absorbedIsos, setAbsorbedIsos] = useState([])\n  const [panelGeometry, setPanelGeometry] = useState(null)\n  const [shellVisible, setShellVisible] = useState(false)\n  const [contentVisible, setContentVisible] = useState(false)\n  const motionRunningRef = useRef(false)\n  const requestedRef = useRef(undefined)\n  // Instantané de la tâche ouverte : permet à l'animation de FERMETURE de continuer à afficher le\n  // contenu même si la tâche vient d'être SUPPRIMÉE du board (sinon le bloc disparaissait brutalement\n  // et les cellules absorbées restaient invisibles pour toujours).\n  const renderedTaskRef = useRef(null)\n  const titleInputRef = useRef(null)\n  // UNE SEULE PISTE MONTÉE À LA FOIS, et c'est un correctif de PERTE DE DONNÉES.\n  //\n  // Le CSS masque `.zrp-calendar` sous 680 px et `.zrp-mobile-days` au-dessus, mais React montait les\n  // DEUX en permanence. `DetailEditor` existait donc en deux instances simultanées, chacune avec son\n  // propre `useState(task.title)`. On tapait dans celle qu'on voyait ; l'autre, invisible, gardait\n  // l'ancien titre. Au démontage, les deux nettoyages tiraient : celui de la piste visible ne faisait\n  // rien puisque son titre égalait désormais celui de la tâche, et celui de la piste FANTÔME comparait\n  // son ancien titre au nouveau, se croyait porteur d'une frappe en attente, et RÉÉCRIVAIT l'ancien.\n  //\n  // Le titre était donc bien enregistré, puis écrasé dans la milliseconde par un éditeur qu'on ne voit\n  // pas. La note subissait le même sort et `titleInputRef` était écrasé par le second montage.\n  // `display:none` cache un composant, il ne l'empêche ni de tenir un état ni de l'écrire.\n  const [isNarrow, setIsNarrow] = useState(() => typeof window !== 'undefined' && window.matchMedia('(max-width: 680px)').matches)\n  useEffect(() => {\n    const mq = window.matchMedia('(max-width: 680px)')\n    const onChange = (e) => setIsNarrow(e.matches)\n    mq.addEventListener('change', onChange)\n    return () => mq.removeEventListener('change', onChange)\n  }, [])\n  // Piste mobile \"un jour = un slot plein écran\" (retour Matthieu 2026-07-20) : synchro bidirectionnelle\n  // avec selectedIso -- Today/‹ › (stepDay/goToday) scrollent la piste jusqu'au jour choisi (effet ci-\n  // dessous) ; le swipe manuel remonte l'info dans l'autre sens (onStripScroll, débattu 120ms pour ne\n  // lire la position qu'une fois le scroll-snap posé).\n  const mobileStripRef = useRef(null)\n  const stripSettleRef = useRef(null)\n\n  useEffect(() => {\n    let live = true\n    setLoading(true)\n    readJson(path).then(({ data }) => { if (live) { setBoard(data && data.type === 'plan' ? data : emptyBoard()); setLoading(false) } })\n    return () => { live = false }\n  }, [path])\n\n  const cells = useMemo(() => buildMonthGrid(cursor.year, cursor.month), [cursor])\n  const score = useMemo(() => planScore(board?.tasks), [board])\n  const tasksByDate = useMemo(() => {\n    const map = new Map()\n    for (const task of (board?.tasks || [])) { if (!map.has(task.date)) map.set(task.date, []); map.get(task.date).push(task) }\n    // TRI PAR HEURE DE DÉBUT. Sans lui, les tâches d'un jour se rangeaient dans l'ordre de création :\n    // on posait une tâche à 19 h, elle s'affichait au-dessus de celle de 9 h, et l'heure choisie ne se\n    // voyait donc nulle part. Le symptôme se lisait « l'horaire n'est pas sauvegardé » alors qu'il\n    // l'était depuis le début ; il n'était ni affiché ni ordonnant. Les tâches sans heure ferment la\n    // journée : une tâche sans horaire n'a pas de place particulière, elle n'en a aucune.\n    for (const list of map.values()) {\n      list.sort((a, b) => (a.startTime || '99:99').localeCompare(b.startTime || '99:99'))\n    }\n    return map\n  }, [board])\n  // La pile Missed deadlines REPART À NEUF chaque mois (retour Matthieu 2026-07-20) : seules les\n  // échéances manquées du MOIS CALENDAIRE COURANT s'accumulent ici -- celles des mois précédents\n  // restent orange dans leurs cellules, mais ne hantent plus la boîte de réception indéfiniment.\n  const monthStartIso = `${today.slice(0, 7)}-01`\n  const overdueTasks = useMemo(() => (board?.tasks || []).filter((task) => statusOf(task, today).key === 'late' && task.date >= monthStartIso), [board, today, monthStartIso])\n\n  // Garde de séquence (2026-07-20, la moitié serveur du bug \"l'écriture se désagrège\") : le résultat\n  // d'un save GitHub (1-2 s de round-trip) ne ré-écrase le board QUE s'il est encore le plus récent --\n  // sinon un res.data périmé annulait les modifications faites pendant le vol (frappes, coche, rescue).\n  const saveSeqRef = useRef(0)\n  const persist = (mutateFn) => {\n    setBoard((prev) => mutateFn(prev || emptyBoard()))\n    const seq = ++saveSeqRef.current\n    saveJsonWithRetry(path, (cur) => mutateFn(cur && cur.type === 'plan' ? cur : emptyBoard()))\n      .then((res) => { if (res.ok && seq === saveSeqRef.current) setBoard(res.data) })\n  }\n  const updateTask = (taskId, patch) => persist((cur) => ({ ...cur, tasks: cur.tasks.map((tk) => (tk.id === taskId ? { ...tk, ...patch } : tk)) }))\n\n  // ── Bloc de détail Lego Fusion 2x2 -- chorégraphie et timings EXACTS de la référence ──────────────\n  const performClose = async () => {\n    if (!renderedIdRef.current) return\n    setContentVisible(false)\n    await wait(100)\n    setShellVisible(false)\n    await wait(150)\n    setRenderedId(null)\n    setPanelGeometry(null)\n    setAbsorbedIsos([])\n    renderedTaskRef.current = null\n    await wait(100)\n  }\n  const performOpen = async ({ taskId, cellIndex, totalCells, cellsSnapshot }) => {\n    const task = (board?.tasks || []).find((tk) => tk.id === taskId)\n    if (!task) return\n    setSelectedIso(task.date)\n    const placement = computePlacement(cellIndex, totalCells)\n    setAbsorbedIsos(absorbedIsosFor(cellsSnapshot, placement))\n    await wait(150)\n    renderedTaskRef.current = task\n    setPanelGeometry(placement)\n    setRenderedId(taskId)\n    await new Promise((resolve) => requestAnimationFrame(resolve))\n    setShellVisible(true)\n    await wait(65)\n    setContentVisible(true)\n    await wait(140)\n    titleInputRef.current?.focus({ preventScroll: true })\n  }\n  const runMotion = async () => {\n    if (motionRunningRef.current) return\n    motionRunningRef.current = true\n    try {\n      while (requestedRef.current !== undefined) {\n        const target = requestedRef.current\n        requestedRef.current = undefined\n        if (renderedIdRef.current) await performClose()\n        if (target) await performOpen(target)\n      }\n    } finally {\n      motionRunningRef.current = false\n    }\n  }\n  const requestPanel = (target) => {\n    requestedRef.current = (target && renderedIdRef.current === target.taskId) ? null : target\n    runMotion()\n  }\n  const openTaskAt = (task, cellIndex) => requestPanel({ taskId: task.id, cellIndex, totalCells: cells.length, cellsSnapshot: cells })\n  const closePanel = () => requestPanel(null)\n\n  useEffect(() => {\n    const onKey = (e) => { if (e.key === 'Escape' && renderedIdRef.current) closePanel() }\n    document.addEventListener('keydown', onKey)\n    return () => document.removeEventListener('keydown', onKey)\n  }, []) // eslint-disable-line react-hooks/exhaustive-deps\n\n  // Lookup vivant d'abord (édition en direct), instantané en secours (fermeture après suppression).\n  const panelTask = (board && renderedId ? board.tasks.find((tk) => tk.id === renderedId) : null) || (renderedId ? renderedTaskRef.current : null)\n\n  // ── Navigation jour par jour (v14 remplace le mois-par-mois de v11) ───────────────────────────────\n  const selectDay = (cell) => { setSelectedIso(cell.iso); closePanel() }\n  const stepDay = (delta) => {\n    const next = addDays(selectedIso, delta)\n    setSelectedIso(next)\n    const d = parseIso(next)\n    if (d.getFullYear() !== cursor.year || d.getMonth() !== cursor.month) setCursor({ year: d.getFullYear(), month: d.getMonth() })\n    closePanel()\n  }\n  const goToday = () => {\n    setSelectedIso(today)\n    const d = new Date()\n    setCursor({ year: d.getFullYear(), month: d.getMonth() })\n    closePanel()\n  }\n\n  // Piste mobile : scrolle jusqu'au jour sélectionné dès qu'il change (Today/‹ ›/tap sur une tâche\n  // d'un autre jour) -- no-op si l'utilisateur est déjà dessus (le swipe qui a POSÉ ce selectedIso).\n  useEffect(() => {\n    const el = mobileStripRef.current\n    if (!el || !el.clientWidth) return\n    const index = cells.findIndex((c) => c.iso === selectedIso)\n    if (index < 0) return\n    const target = index * el.clientWidth\n    if (Math.abs(el.scrollLeft - target) > 4) el.scrollTo({ left: target, behavior: 'smooth' })\n  }, [selectedIso, cells])\n  const onStripScroll = () => {\n    const el = mobileStripRef.current\n    if (!el || !el.clientWidth) return\n    window.clearTimeout(stripSettleRef.current)\n    stripSettleRef.current = window.setTimeout(() => {\n      const index = Math.round(el.scrollLeft / el.clientWidth)\n      const cell = cells[index]\n      if (!cell || cell.iso === selectedIso) return\n      setSelectedIso(cell.iso)\n      const d = parseIso(cell.iso)\n      if (d.getFullYear() !== cursor.year || d.getMonth() !== cursor.month) setCursor({ year: d.getFullYear(), month: d.getMonth() })\n      closePanel()\n    }, 120)\n  }\n\n  // ── Cycle de vie d'une tâche ───────────────────────────────────────────────────────────────────────\n  const toggleDone = (task) => {\n    persist((cur) => ({ ...cur, tasks: cur.tasks.map((tk) => {\n      if (tk.id !== task.id) return tk\n      const isDone = tk.status === 'done' || tk.status === 'late-complete'\n      if (isDone) return { ...tk, status: 'planned', doneAt: null } // décoche : redevient \"en retard\" si sa date est déjà passée\n      const nowLate = tk.date < today\n      return { ...tk, status: nowLate ? 'late-complete' : 'done', doneAt: new Date().toISOString(), overdueSince: nowLate ? (tk.overdueSince || tk.date) : tk.overdueSince }\n    }) }))\n  }\n  const rescueToday = (task) => {\n    persist((cur) => ({ ...cur, tasks: cur.tasks.map((tk) => (tk.id === task.id ? { ...tk, overdueSince: tk.overdueSince || tk.date, date: today } : tk)) }))\n  }\n  // Suppression (demande explicite 2026-07-20, absente de la référence-prototype) : la fermeture animée\n  // part D'ABORD (le bloc continue d'afficher l'instantané renderedTaskRef pendant qu'elle se joue),\n  // la donnée est retirée en parallèle. Récupérable via l'historique Git du .plan.json.\n  const deleteTask = (task) => {\n    if (!canDeleteTask(task)) return // verrou d'engagement 4h (l'UI grise déjà la corbeille)\n    closePanel()\n    persist((cur) => ({ ...cur, tasks: cur.tasks.filter((tk) => tk.id !== task.id) }))\n  }\n  const submitComposer = () => {\n    const title = draft.title.trim()\n    if (!title) return\n    const duration = Math.max(5, Math.min(240, draft.duration))\n    const baseTask = (date, streakId) => ({\n      id: uid(), title, date, startTime: draft.time || null, durationMin: duration,\n      status: 'planned', note: '', images: [], overdueSince: null, doneAt: null,\n      createdAt: new Date().toISOString(), ...(streakId ? { streakId, streakEvery: draft.streakEvery } : {}),\n      ...(draft.publish ? { publish: true } : {}),\n      ...(draft.firstMovement ? { firstMovement: true } : {}),\n    })\n    // Streak task (retour Matthieu 2026-07-20) : une occurrence tous les N jours, de la date de départ\n    // jusqu'à la date d'arrêt incluse (plafond de sécurité STREAK_MAX_OCCURRENCES). Chaque occurrence\n    // est une tâche à part entière (cochable/manquable indépendamment), reliée par streakId.\n    if (draft.streak && draft.streakEnd && draft.streakEnd >= draft.date) {\n      const streakId = uid()\n      const occurrences = []\n      let iso = draft.date\n      while (iso <= draft.streakEnd && occurrences.length < STREAK_MAX_OCCURRENCES) {\n        occurrences.push(baseTask(iso, streakId))\n        iso = addDays(iso, Math.max(1, draft.streakEvery))\n      }\n      persist((cur) => ({ ...cur, tasks: [...cur.tasks, ...occurrences] }))\n    } else {\n      persist((cur) => ({ ...cur, tasks: [...cur.tasks, baseTask(draft.date, null)] }))\n    }\n    setComposerOpen(false)\n  }\n  const openComposer = () => {\n    setMenuOpen(false)\n    setComposerPicker(null)\n    setComposerOpen((v) => {\n      const next = !v\n      if (next) setDraft({ title: '', date: selectedIso, time: '09:00', duration: 90, customOpen: false, customMinutes: 60, streak: false, streakEvery: 1, streakEnd: '', publish: false, firstMovement: false })\n      return next\n    })\n  }\n  // Fermeture au clic ailleurs dans le popover (le composer lui-même se ferme déjà au clic à\n  // l'extérieur -- ce listener local ne gère QUE les 3 mini-widgets date/heure, plus précis).\n  useEffect(() => {\n    if (!composerPicker) return undefined\n    const close = () => setComposerPicker(null)\n    window.addEventListener('pointerdown', close)\n    return () => window.removeEventListener('pointerdown', close)\n  }, [composerPicker])\n\n  if (loading) return <div className={`zrp-shell${t.textPrimary === PALETTE.textPrimaryDark ? '' : ' zrp-light'}`}><div className=\"zrp-loading\">Loading plan…</div></div>\n\n  const dark = t.textPrimary === PALETTE.textPrimaryDark\n\n}\n@media (max-width: 720px) {\n  .zrp-popover { position: fixed; left: 10px; right: 10px; top: auto; bottom: 12px; width: auto; }\n  .zrp-schedule-row { grid-template-columns: 1fr; }\n  .zrp-selected-date { min-width: 124px; padding-inline: 10px; font-size: 12px; }\n}\n\n/* Vue \"un jour = un slot plein écran\" (mobile, retour Matthieu 2026-07-20 : la grille 7 colonnes du\n   mois entier était illisible en dessous de 680px, cellules quasi vides). Remplace ENTIÈREMENT\n   .zrp-calendar sous 680px -- pas une variante compactée de la grille, une piste horizontale à\n   ancrage (scroll-snap) où chaque jour de buildMonthGrid occupe 100% de la largeur. La navigation\n   Today/‹ › du toolbar (stepDay/goToday, INCHANGÉE) reste la source de vérité de `selectedIso` ; un\n   effet React scrolle la piste jusqu'au jour sélectionné, et le swipe manuel remonte l'info dans\n   l'autre sens (onStripScroll -> setSelectedIso) -- synchro bidirectionnelle, voir PlanBoard.jsx. */\n.zrp-mobile-days { display: none; }\n@media (max-width: 680px) {\n  .zrp-shell { padding: 10px; }\n  .zrp-stage { padding: 7px; border-radius: 23px; }\n  .zrp-toolbar { gap: 8px; padding: 0 4px 8px; }\n  .zrp-brand { font-size: 13px; }\n  .zrp-brand-cluster { gap: 7px; }\n  .zrp-score-value { min-width: 30px; padding-inline: 9px; }\n  .zrp-detail-title { font-size: 15px; }\n  .zrp-overdue-dock { padding: 8px; border-radius: 15px; }\n\n  .zrp-calendar { display: none; }\n  .zrp-mobile-days {\n    display: flex; overflow-x: auto; overflow-y: visible; scroll-snap-type: x mandatory;\n    -webkit-overflow-scrolling: touch; scrollbar-width: none; border-radius: 22px;\n    background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));\n    box-shadow: var(--zrp-rim);\n  }\n  .zrp-mobile-days::-webkit-scrollbar { display: none; }\n  .zrp-mobile-day {\n    flex: 0 0 100%; min-width: 100%; box-sizing: border-box; scroll-snap-align: start; scroll-snap-stop: always;\n    display: flex; flex-direction: column; gap: 12px; padding: 16px 14px 18px;\n  }\n  .zrp-mobile-day-head { display: flex; align-items: baseline; gap: 9px; padding: 0 2px; }\n  .zrp-mobile-day-weekday { color: var(--g9-soft); font-size: 12px; font-weight: 400; text-transform: uppercase; letter-spacing: .08em; }\n  .zrp-mobile-day-date { color: var(--g9-fg); font-size: 15px; font-weight: 400; }\n  .zrp-mobile-today-badge { margin-left: auto; padding: 3px 11px; border-radius: 999px; background: var(--zrp-blue); color: #fff; font-size: 12px; font-weight: 400; }\n  .zrp-mobile-day-tasks { display: grid; gap: 8px; }\n  .zrp-mobile-day-tasks .zrp-task { min-height: 46px; padding: 10px 11px; font-size: 13.5px; }\n  .zrp-mobile-day-tasks .zrp-task-title { -webkit-line-clamp: 3; font-size: 13.5px; }\n  .zrp-mobile-day-empty { padding: 26px 4px; text-align: center; color: var(--g9-muted); font-size: 12px; font-weight: 300; }\n  .zrp-mobile-detail { margin-top: 2px; }\n}\n@media (prefers-reduced-motion: reduce) {\n  .zrp-day, .zrp-detail, .zrp-detail-content { transition: none; }\n  .zrp-score-icon-mark-animated { animation: none; }\n}\n\n/* LÉGENDE DES COULEURS (2026-08-01). Volontairement minimale : une rangée qui passe à la ligne, des\n   pastilles à la hauteur de capitale comme partout ailleurs dans l'application, aucun cadre propre.\n   Elle prolonge le socle des échéances manquées au lieu de former une seconde boîte, sans quoi le bas\n   de la vue accumulerait deux conteneurs de verre pour trois lignes de texte. */\n.zrp-legend-dock { margin: 0 2px; padding: 2px 16px 4px; }\n.zrp-legend-head {\n  display: inline-flex; align-items: center; gap: 6px; padding: 6px 0