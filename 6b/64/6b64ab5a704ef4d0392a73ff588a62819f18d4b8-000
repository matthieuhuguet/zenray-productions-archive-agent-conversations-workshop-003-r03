 #ff6254; /* rouge publication dépassée -- teinte exacte validée par Matthieu (2026-07-21) */\n  /* Liseré complet \"verre standard\" (outer + rim-main x2 + rim-soft x2 + rim-side x2). */\n  --zrp-rim:\n    var(--g9-outer-line),\n    inset 0 1px 0 var(--g9-rim-main), inset 0 -1px 0 var(--g9-rim-main),\n    inset 0 2px 0 var(--g9-rim-soft), inset 0 -2px 0 var(--g9-rim-soft),\n    inset 1px 0 0 var(--g9-rim-side), inset -1px 0 0 var(--g9-rim-side);\n  /* Ombres portées de la référence (--plan-shadow-a/-b), par thème. */\n  --zrp-shadow-a: 0 12px 32px rgba(0, 0, 0, .18);\n  --zrp-shadow-b: 0 2px 8px rgba(0, 0, 0, .10);\n  --zrp-stage-shadow: 0 28px 80px rgba(0, 0, 0, .20);\n  --zrp-detail-shadow: 0 18px 48px rgba(0, 0, 0, .22);\n  /* Filet fin des séparateurs (--plan-grid de la référence : .075 dark / .09 light) -- PAS --g9-rail\n     (trop appuyé, emprunté par erreur au premier passage). */\n  --zrp-grid: rgba(255, 255, 255, .075);\n  position: relative;\n  padding: 18px;\n  color: var(--g9-fg);\n  /* AnthropicSans en graisses légères (300/400 selon la cascade de la référence) -- retour Matthieu\n     2026-07-20 : les TAILLES restent celles du fichier HTML (cohérentes entre elles), mais la police\n     redevient celle du site. AUCUN fond ici : le shell empilait un 3e fond opaque sous le stage et les\n     cartes (\"ça fait trop\") -- le stage en verre fait maintenant l'overlay glassmorphisme directement\n     sur le fond de l'app, exactement comme les cartes elles-mêmes. */\n  font-family: 'AnthropicSans', -apple-system, sans-serif;\n  font-synthesis: none;\n}\n.zrp-shell.zrp-light {\n  --zrp-shadow-a: 0 12px 32px rgba(62, 67, 78, .09);\n  --zrp-shadow-b: 0 2px 8px rgba(62, 67, 78, .05);\n  --zrp-stage-shadow: 0 24px 65px rgba(62, 67, 78, .10);\n  --zrp-detail-shadow: 0 16px 42px rgba(62, 67, 78, .13);\n  --zrp-grid: rgba(25, 27, 31, .09);\n}\n/* font-FAMILY seulement (pas le shorthand `font: inherit` du premier passage, qui écrasait aussi la\n   taille et l'interligne posés par les classes zrp-* -- une des causes du rendu \"fontes au hasard\"). */\n.zrp-shell button, .zrp-shell input, .zrp-shell textarea { font-family: inherit; }\n.zrp-stage {\n  padding: 10px;\n  border-radius: 31px;\n  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));\n  backdrop-filter: blur(27px) saturate(169%);\n  -webkit-backdrop-filter: blur(27px) saturate(169%);\n  box-shadow: var(--zrp-rim), var(--zrp-stage-shadow);\n}\n\n.zrp-toolbar { position: relative; min-height: 52px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 18px; padding: 0 10px 10px; }\n.zrp-brand-cluster { display: flex; align-items: center; gap: 10px; min-width: 0; }\n.zrp-brand { display: flex; align-items: center; min-height: 38px; font-size: 14px; font-weight: 400; letter-spacing: -.01em; }\n.zrp-nav { display: flex; align-items: center; gap: 7px; }\n\n.zrp-score-capsule {\n  height: 38px; display: inline-flex; flex: 0 0 auto; align-items: center; overflow: hidden; border-radius: 999px;\n  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));\n  box-shadow: var(--zrp-rim), var(--zrp-shadow-b);\n}\n.zrp-score-icon { width: 38px; height: 100%; display: inline-flex; align-items: center; justify-content: center; }\n.zrp-score-icon-mark { width: 17px; height: 17px; display: block; transform-origin: 50% 55%; }\n.zrp-score-icon-mark svg { width: 100%; height: 100%; display: block; }\n.zrp-score-icon-mark-animated { animation: zrp-dollar-confirm .35s cubic-bezier(.16,1,.3,1); }\n.zrp-score-value {\n  min-width: 38px; height: 100%; display: inline-flex; align-items: center; justify-content: center;\n  padding: 0 12px; border-left: 1px solid var(--zrp-grid); color: var(--g9-fg);\n  font-family: 'AnthropicSerif', Georgia, serif; font-size: 14px; font-variant-numeric: tabular-nums;\n}\n.zrp-score-number, .zrp-score-digits, .zrp-score-digit { height: 1em; display: inline-flex; overflow: hidden; line-height: 1; }\n.zrp-score-digit { width: .62em; }\n.zrp-score-digit-track { display: flex; flex-direction: column; width: 100%; height: max-content; }\n.zrp-score-digit-track > span { flex: 0 0 1em; height: 1em; display: grid; place-items: center; }\n@keyframes zrp-dollar-confirm {\n  0% { transform: scale(1) rotate(0); filter: brightness(1); }\n  38% { transform: scale(.9) rotate(-5deg); filter: brightness(.96); }\n  72% { transform: scale(1.16) rotate(3deg); filter: brightness(1.14); }\n  100% { transform: scale(1) rotate(0); filter: brightness(1); }\n}\n\n.zrp-date-capsule {\n  height: 38px; display: inline-flex; align-items: center; overflow: hidden; border-radius: 999px;\n  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));\n  box-shadow: var(--zrp-rim), var(--zrp-shadow-b);\n}\n.zrp-today-btn { height: 100%; padding: 0 12px; border: 0; border-radius: 999px 0 0 999px; color: var(--g9-fg); background: transparent; font-size: 12px; font-weight: 400; cursor: pointer; }\n.zrp-today-btn:hover { background: color-mix(in srgb, var(--g9-fg) 7%, transparent); }\n.zrp-selected-date { min-width: 132px; padding: 0 14px 0 12px; border-left: 1px solid var(--zrp-grid); color: var(--g9-muted); font-size: 12px; font-weight: 300; line-height: 38px; text-align: left; white-space: nowrap; }\n\n.zrp-actions { display: flex; justify-content: flex-end; align-items: center; gap: 8px; min-height: 38px; }\n.zrp-btn {\n  box-sizing: border-box; height: 38px; display: inline-flex; align-items: center; justify-content: center;\n  gap: 7px; padding: 0 13px; border: 0; border-radius: 999px; color: var(--g9-fg);\n  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));\n  cursor: pointer; font-size: 12px; font-weight: 400; line-height: 1; white-space: nowrap;\n  box-shadow: var(--zrp-rim), var(--zrp-shadow-a), var(--zrp-shadow-b);\n  transition: transform .15s ease;\n}\n.zrp-btn:hover { transform: translateY(-1px); }\n.zrp-btn.zrp-icon { width: 38px; padding: 0; }\n.zrp-btn.zrp-primary { background: var(--zrp-blue); color: #fff; backdrop-filter: none; -webkit-backdrop-filter: none; box-shadow: inset 0 1px 0 rgba(255,255,255,.30), inset 0 -1px 0 rgba(0,60,145,.30); }\n/* Bouton \"New goal\" : cercle plein, pas une pilule texte (v12 final polish). */\n.zrp-new { width: 38px; min-width: 38px; padding: 0; border-radius: 50%; }\n\n/* Popover : la référence lui réserve un fond BEAUCOUP plus opaque que le verre générique -- son propre\n   commentaire (v14 final push) : \"Dark overlays must remain legible glass, never transparent\n   grey-on-grey\". Liseré dark = valeurs FIXES du fichier (pas le ratio), ombre 0 26px 72px. */\n/* OPAQUE DANS LES DEUX THÈMES (retour Matthieu 2026-08-01). Les deux dégradés portaient une alpha de\n   .91 à .97, si bien que le calendrier transparaissait derrière les champs et que le popover se lisait\n   comme un calque plutôt que comme une surface. Une opacité « presque totale » est le pire des deux\n   mondes : elle ne donne pas l'effet de verre, qui demanderait un flou franc, et elle abîme la\n   lisibilité du contenu. Les valeurs passent donc en `rgb()` plein, thème clair comme sombre. */\n.zrp-popover {\n  /* PREMIER PLAN ABSOLU (corrigé le 2026-08-01). Le popover était à 20 et `.zrp-detail` à 25 : le\n     panneau de détail passait donc PAR-DESSUS, et comme son fond ne monte qu'à 94 % d'opacité, on\n     voyait le popover à travers lui. Le symptôme ressemblait à s'y méprendre à un popover translucide,\n     et rendre son propre fond opaque n'y changeait rien — ce n'était pas une affaire d'opacité mais\n     d'ordre d'empilement. Il porte les informations qu'on est en train de saisir : rien de ce qui\n     existe déjà ne doit le recouvrir. */\n  position: absolute; z-index: 60; top: 48px; right: 0; width: min(430px, calc(100vw - 32px));\n  padding: 15px; border-radius: 25px; color: #f7f7f8;\n  background:\n    radial-gradient(circle at 12% 0%, rgba(255, 255, 255, .12), transparent 34%),\n    linear-gradient(145deg, rgb(60, 64, 75), rgb(20, 22, 29));\n  \n  box-shadow:\n    var(--g9-outer-line),\n    inset 0 1px 0 rgba(255, 255, 255, .34), inset 0 -1px 0 rgba(255, 255, 255, .22),\n    inset 0 2px 0 rgba(255, 255, 255, .08), inset 0 -2px 0 rgba(255, 255, 255, .06),\n    inset 1px 0 0 rgba(255, 255, 255, .05), inset -1px 0 0 rgba(255, 255, 255, .05),\n    0 26px 72px rgba(0, 0, 0, .52);\n}\n.zrp-shell.zrp-light .zrp-popover {\n  color: #1d1d1f;\n  background:\n    radial-gradient(circle at 14% 0%, rgba(255, 255, 255, .96), transparent 38%),\n    linear-gradient(145deg, rgb(250, 251, 253), rgb(218, 223, 231));\n  \n  box-shadow: var(--zrp-rim), var(--zrp-shadow-a), var(--zrp-shadow-b);\n}\n/* Contenu du popover sombre : blanc/gris clair forcé (mêmes listes que le v14 de la référence). */\n.zrp-shell:not(.zrp-light) .zrp-popover button:not(.zrp-primary), .zrp-shell:not(.zrp-light) .zrp-popover input,\n.zrp-shell:not(.zrp-light) .zrp-popover textarea, .zrp-shell:not(.zrp-light) .zrp-menu-item { color: #f7f7f8; }\n.zrp-shell:not(.zrp-light) .zrp-composer-head span, .zrp-shell:not(.zrp-light) .zrp-field-label, .zrp-shell:not(.zrp-light) .zrp-field > span,\n.zrp-shell:not(.zrp-light) .zrp-duration-head, .zrp-shell:not(.zrp-light) .zrp-duration-head small { color: rgba(255, 255, 255, .62); }\n.zrp-shell:not(.zrp-light) .zrp-popover :is(input, textarea)::placeholder { color: rgba(255, 255, 255, .43); }\n.zrp-shell:not(.zrp-light) .zrp-menu-item:hover { background: rgba(255, 255, 255, .10); }\n.zrp-composer-head { display: flex; align-items: center; justify-content: flex-end; min-height: 18px; margin: 0 1px 9px; }\n.zrp-composer-head span { color: var(--g9-muted); font-size: 12px; font-weight: 300; line-height: 1; }\n.zrp-field-label { display: block; margin: 0 0 7px; padding-left: 2px; color: var(--g9-muted); font-size: 12px; font-weight: 300; }\n.zrp-input {\n  /* box-sizing: border-box -- bug réel corrigé le 2026-07-20 (\"Plan… dépasse toujours de sa capsule\") :\n     width:100% + padding 0 15px SANS border-box = 100% + 30px de large, l'input débordait réellement à\n     droite de sa capsule et du popover. */\n  box-sizing: border-box;\n  width: 100%; height: 48px; padding: 0 15px; border: 0; border-radius: 15px; outline: none;\n  color: var(--g9-fg); background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));\n  font-size: 15px; font-weight: 400; line-height: 1;\n  box-shadow: var(--zrp-rim), var(--zrp-shadow-a), var(--zrp-shadow-b);\n}\n.zrp-input::placeholder { color: var(--g9-soft); }\n.zrp-schedule-row { display: grid; grid-template-columns: minmax(0,1.25fr) minmax(170px,.75fr); align-items: stretch; gap: 9px; margin-top: 9px; }\n__PLANBOARD_CSS_260_420__\n.zrp-menu-item.zrp-on .zrp-switch::after { transform: translateX(11px); }\n\n/* Calendrier : liseré complet, pas d'ombre (override tardif de la référence). */\n.zrp-calendar {\n  position: relative; overflow: hidden; border-radius: 22px; background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));\n  box-shadow: var(--zrp-rim);\n}\n.zrp-weekdays { display: grid; grid-template-columns: repeat(7,1fr); padding: 10px 8px 7px; }\n.zrp-weekdays span { padding: 0 9px; color: var(--g9-soft); font-size: 12px; font-weight: 400; text-transform: uppercase; letter-spacing: .08em; }\n.zrp-grid { position: relative; display: grid; grid-template-columns: repeat(7, minmax(0,1fr)); gap: 7px; padding: 0 8px 8px; }\n\n/* Case du jour : fond verre PERMANENT (pas seulement au survol) + liseré haut/bas SANS côtés ni ombre\n   -- exactement l'override .v11-plan-day du bloc feedback-polish de la référence. */\n.zrp-day {\n  position: relative; min-height: 126px; padding: 9px; border: 0; border-radius: 17px; color: var(--g9-fg);\n  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));\n  box-shadow: var(--g9-outer-line), inset 0 1px 0 var(--g9-rim-main), inset 0 -1px 0 var(--g9-rim-main),\n    inset 0 2px 0 var(--g9-rim-soft), inset 0 -2px 0 var(--g9-rim-soft);\n  cursor: pointer; text-align: left; transition: filter .16s ease, opacity 150ms ease, transform 150ms cubic-bezier(.16,1,.3,1);\n}\n.zrp-day:hover { filter: brightness(1.06); }\n.zrp-day.zrp-selected { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--zrp-blue) 68%, transparent), inset 0 1px 0 var(--g9-rim-main), inset 0 -1px 0 var(--g9-rim-main); }\n.zrp-day.zrp-outside { opacity: .34; }\n.zrp-day.zrp-today .zrp-day-num { background: var(--zrp-blue); color: #fff; }\n.zrp-day.zrp-absorbed { opacity: 0; pointer-events: none; transform: scale(.985); }\n.zrp-day-num { width: 25px; height: 25px; display: grid; place-items: center; border-radius: 999px; font-size: 12px; font-weight: 400; color: var(--g9-muted); }\n.zrp-day-tasks { display: grid; gap: 5px; margin-top: 7px; }\n\n/* Tuile de tâche neutre : liseré volontairement ASYMÉTRIQUE (rim-main haut, rim-soft bas -- override\n   .v11-plan-goal de la référence), qui la distingue des tuiles colorées (symétriques 4 côtés). */\n.zrp-task {\n  /* align-items/align-content: center (retour Matthieu 2026-07-20) : la pastille de check (et sa ligne)\n     est centrée VERTICALEMENT dans la tuile, toujours alignée à gauche -- plus collée en haut à gauche\n     comme le align-items:start du premier passage. */\n  position: relative; display: grid; grid-template-columns: 15px minmax(0,1fr); align-items: center; align-content: center; gap: 5px;\n  min-height: 38px; padding: 6px 7px; overflow: hidden; border: 0; border-radius: 10px; width: 100%;\n  color: var(--g9-fg); background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b)); font-size: 12px; font-weight: 400;\n  text-align: left; cursor: pointer;\n  box-shadow: var(--g9-outer-line), inset 0 1px 0 var(--g9-rim-main), inset 0 -1px 0 var(--g9-rim-soft);\n}\n.zrp-task:hover { filter: brightness(1.06); }\n.zrp-task input[type=\"checkbox\"] { appearance: none; width: 14px; height: 14px; margin: 0; border-radius: 999px; border: 1px solid var(--g9-soft); display: grid; place-items: center; cursor: pointer; }\n.zrp-task input[type=\"checkbox\"]:checked { border-color: var(--zrp-green); background: var(--zrp-green); }\n.zrp-task input[type=\"checkbox\"]:checked::after { content: '✓'; font-size: 9px; color: #fff; line-height: 1; }\n/* LE TITRE PREND TOUTE LA LARGEUR DÈS QU'UNE HEURE EST AFFICHÉE (régression corrigée le 2026-08-01).\n   `.zrp-task` est une grille à DEUX colonnes, `15px` pour la case à cocher et le reste pour le titre.\n   En ajoutant l'heure comme troisième enfant le 2026-07-30, je n'ai pas touché à la grille : la case\n   prenait la colonne 1, l'heure la colonne 2, et le titre repartait à la ligne DANS LA COLONNE DE\n   15 px. D'où des capsules affichant une lettre par ligne suivie de points de suspension, symptôme\n   qui ressemblait à une troncature du texte alors que c'était un défaut de placement.\n   `:has()` plutôt qu'une règle constante : sans heure, les enfants ne sont que deux et le titre doit\n   rester à droite de la case, sur la même ligne. La règle est donc conditionnelle, comme le cas. */\n.zrp-task:has(.zrp-task-time) .zrp-task-title { grid-column: 1 / -1; }\n.zrp-task-title { display: -webkit-box; overflow: hidden; text-overflow: ellipsis; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-height: 1.22; letter-spacing: -.005em; }\n\n/* 3 états couleur (jamais d'autre) : vert = terminé à temps, violet = terminé en retard, orange = en\n   retard non terminé. Liseré SYMÉTRIQUE 4 côtés pour les 3 (\"no left notch\", v13). */\n.zrp-task.zrp-done, .zrp-task.zrp-late-complete, .zrp-task.zrp-late { box-shadow: var(--zrp-rim); }\n.zrp-task.zrp-done {\n  padding-right: 27px;\n  background: linear-gradient(135deg, color-mix(in srgb, var(--zrp-green) 28%, var(--g9-glass-a)), color-mix(in srgb, var(--zrp-green) 17%, var(--g9-glass-b)));\n}\n.zrp-task.zrp-done::after { content: '✦'; position: absolute; right: 9px; top: 50%; transform: translateY(-50%); font-size: 11px; color: color-mix(in srgb, var(--zrp-green) 78%, white); }\n.zrp-task.zrp-late-complete {\n  padding-right: 7px;\n  background: linear-gradient(135deg, color-mix(in srgb, var(--zrp-violet) 27%, var(--g9-glass-a)), color-mix(in srgb, var(--zrp-violet) 16%, var(--g9-glass-b)));\n}\n.zrp-task.zrp-late {\n  background: linear-gradient(135deg, color-mix(in srgb, var(--zrp-orange) 34%, var(--g9-glass-a)), color-mix(in srgb, var(--zrp-orange) 22%, var(--g9-glass-b)));\n}\n.zrp-task.zrp-late input[type=\"checkbox\"] { border-color: color-mix(in srgb, var(--zrp-orange) 72%, white); }\n/* Publication : planifiée = fond ROSE pâle (même recette color-mix que les tuiles vert/violet),\n   dépassée = ROUGE pâle (remplace l'orange pour ces tâches spéciales), liseré symétrique. */\n.zrp-task.zrp-publish, .zrp-task.zrp-publish-late { box-shadow: var(--zrp-rim); }\n.zrp-task.zrp-publish {\n  background: linear-gradient(135deg, color-mix(in srgb, var(--zrp-pink) 26%, var(--g9-glass-a)), color-mix(in srgb, var(--zrp-pink) 15%, var(--g9-glass-b)));\n}\n.zrp-task.zrp-publish-late {\n  background: linear-gradient(135deg, color-mix(in srgb, var(--zrp-red) 32%, var(--g9-glass-a)), color-mix(in srgb, var(--zrp-red) 20%, var(--g9-glass-b)));\n}\n.zrp-task.zrp-publish-late input[type=\"checkbox\"] { border-color: color-mix(in srgb, var(--zrp-red) 72%, white); }\n/* Publication FAITE : la tuile garde son vert (à temps) ou son violet (en retard), l'étoile passe\n   ROSE -- c'est elle qui marque le caractère publication (déclaré APRÈS .zrp-done::after pour gagner\n   la cascade à spécificité supérieure). */\n.zrp-task.zrp-publish-done { padding-right: 27px; }\n.zrp-task.zrp-publish-done::after { content: '✦'; position: absolute; right: 9px; top: 50%; transform: translateY(-50%); font-size: 11px; color: var(--zrp-pink); }\n/* Toggle ✦ du composer : actif = rond PLEIN rose (pas le bleu des presets). */\n.zrp-duration.zrp-publish-toggle { font-size: 15px; }\n.zrp-duration.zrp-publish-toggle.zrp-publish-on { color: #fff; background: 