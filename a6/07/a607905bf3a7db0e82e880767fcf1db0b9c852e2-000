{"timestamp":"2026-07-15T18:53:06.244Z","ordinal":116,"type":"response_item","payload":{"type":"custom_tool_call_output","call_id":"call_6xOG2KWZLH9RX1JWmvCJPsHX","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"RESULT_1\nimport React from 'react'\nimport { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'\nimport { afterEach, describe, expect, it, vi } from 'vitest'\nimport { THEMES } from '../../src/theme.js'\nimport { ActionColumnMenu, ActionColumnPopover } from '../../src/components/ActionColumnMenu.jsx'\nimport { ColumnMenuColumn, ColumnMenuShell } from '../../src/components/ColumnMenu.jsx'\n\nconst t = THEMES.light\n\nafterEach(cleanup)\n\nfunction columns(count, width = 238) {\n  return Array.from({ length: count }, (_, index) => (\n    <ColumnMenuColumn key={index} t={t} width={width} index={index} label={`Colonne ${index + 1}`}>\n      <button type=\"button\">Item {index + 1}</button>\n    </ColumnMenuColumn>\n  ))\n}\n\ndescribe('ColumnMenuShell', () => {\n  it('garde la première colonne ancrée et borne toute la coque dans le viewport', () => {\n    Object.defineProperty(window, 'innerWidth', { configurable: true, value: 800 })\n    Object.defineProperty(window, 'innerHeight', { configurable: true, value: 600 })\n\n    const { rerender } = render(\n      <ColumnMenuShell t={t} anchor={{ left: 100, top: 80, triggerTop: 40 }} onClose={() => {}} columns={columns(1)} />,\n    )\n    const menu = screen.getByRole('menu')\n    expect(menu.style.left).toBe('100px')\n    expect(menu.style.width).toBe('238px')\n\n    rerender(\n      <ColumnMenuShell t={t} anchor={{ left: 100, top: 80, triggerTop: 40 }} onClose={() => {}} columns={columns(3)} />,\n    )\n    expect(menu.style.left).toBe('100px')\n    expect(menu.style.width).toBe('688px')\n    expect(Number.parseFloat(menu.style.left) + Number.parseFloat(menu.style.width)).toBeLessThanOrEqual(788)\n  })\n\n  it('révèle