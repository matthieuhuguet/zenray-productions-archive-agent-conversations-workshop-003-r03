r', borderRadius: RADII.sm, fontSize: 13.5, background: on ? PALETTE.primarySoft : 'transparent', color: on ? PALETTE.primary : t.textPrimary, transition: TRANSITIONS.base }}>\n    19\t          <span>{it.label}</span>{on && <Icon name=\"checklist\" size={13} color={PALETTE.primary} />}\n    20\t        </button>\n    21\t      )})}\n    22\t    </div>\n    23\t  )\n    24\t}\n    25\t\n    26\texport default function StreamVideo({ t, path, manifest }) {\n    27\t  const v = React.useRef(null)\n    28\t  const [playing, setPlaying] = React.useState(false)\n    29\t  const [cur, setCur] = React.useState(0)\n    30\t  const [dur, setDur] = React.useState((manifest && manifest.probe && manifest.probe.duration) || (manifest && manifest.duration) || 0)\n    31\t  const [buffered, setBuffered] = React.useState(0)\n    32\t  const [speed, setSpeed] = React.useState(1)\n    33\t  const [openMenu, setOpenMenu] = React.useState(null)\n    34\t  const [audioTracks, setAudioTracks] = React.useState([]) // [{id,label}]\n    35\t  const [audioSel, setAudioSel] = React.useState(0)\n    36\t  const [subSel, setSubSel] = React.useState(null)\n    37\t\n    38\t  const streamUrl = `/api/stream?path=${enc(path)}`\n    39\t\n    40\t  // PRÉCHARGEUR — combat le stuttering : <video> demande ses Range au fil de l'eau, chaque Range\n    41\t  // = aller-retour GitHub (~1s) -> stalls (pire en x2). On garde ~60s d'octets d'avance toujours\n    42\t  // chauds dans le cache HTTP (navigateur + edge, /api/stream renvoie cache immutable) en tirant\n    43\t  // des fenêtres de 4Mo dont on jette le corps. Un seul fetch à la fois, curseur en octets.\n    44\t  const mediaSize = (manifest && manifest.size) || 0\n    45\t  const mediaDur = (manifest && manifest.probe && manifest.probe.duration) || (manifest && manifest.duration) || 0\n    46\t  const bytesPerSec = (mediaSize > 0 && mediaDur > 0) ? mediaSize / mediaDur : 0\n    47\t  const prefetchTo = React.useRef(0)   // octet jusqu'où c'est préch