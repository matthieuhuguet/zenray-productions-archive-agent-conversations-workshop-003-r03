   setStatus('upload…'); const added = []\n   159\t    for (const f of [...files]) { if (!f.type || !f.type.startsWith('audio/')) continue; const dataUrl = await new Promise((res) => { const r = new FileReader(); r.onload = () => res(r.result); r.readAsDataURL(f) }); const j = await fetch('/api/img', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ dataUrl, dir: 'sfx' }) }).then((r) => r.json()).catch(() => null); if (j && j.path) added.push({ path: j.path, name: f.name.replace(/\\.[^.]+$/, ''), tags: [], dur: 0 }) }\n   160\t    await save([...(sfx || []), ...added]); setStatus(`${added.length} ajouté(s)`)\n   161\t  }\n   162\t  const allTags = [...new Set((sfx || []).flatMap((s) => s.tags || []))]\n   163\t  const shown = tag ? (sfx || []).filter((s) => (s.tags || []).includes(tag)) : (sfx || [])\n   164\t  return (\n   165\t    <div style={{ padding: '2px 6px 16px' }}>\n   166\t      <div style={{ display: 'flex', alignItems: 'center', gap: 10, marginBottom: 10 }}>\n   167\t        <span style={{ fontFamily: FONTS.serif, fontSize: 20, color: C.text }}>SFX</span>\n   168\t        <span style={{ fontFamily: FONTS.mono, fontSize: 10, color: C.sub }}>{(sfx || []).length} sons · {status}</span>\n   169\t        <label style={{ marginLeft: 'auto', background: '#1db954', color: '#fff', borderRadius: 99, padding: '5px 14px', fontSize: 12.5, fontWeight: 600, cursor: 'pointer' }}>+ Importer<input type=\"file\" accept=\"audio/*\" multiple style={{ display: 'none' }} onChange={(e) => add(e.target.files)} /></label>\n   170\t      </div>\n   171\t      {allTags.length > 0 && <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap', marginBottom: 10 }}>{allTags.map((tg) => <button key={tg} onClick={() => setTag(tag === tg ? null : tg)} style={{ background: tag === tg ? C.accent : C.panelHi, color: tag === tg ? '#000' : C.sub, border: 'none', borderRadius: 99, padding: '2px 10px', fontSize: 12, cursor: 'pointer' }}>{tg}</button>)}</div>}\n   172\t      <div onDragOver={(e) => { e.preventDefault(); setOver(true) }} onDragLeave={() => setOver(false)} onDrop={(e) => { e.preventDefault(); setOver(false); if (e.dataTransfer.files.length) add(e.dataTransfer.files) }}\n   173\t        style={{ border: `1.5px dashed ${over ? C.accent : C.panelHi}`, borderRadius: 10, padding: 12, textAlign: 'center', color: C.sub, fontSize: 12.5, marginBottom: 12, background: over ? 'rgba(255,255,255,0.04)' : 'transparent' }}>Glisse des fichiers audio ici (mp3/wav/ogg)</div>\n   174\t      {sfx === null && <div style={{ color: C.sub }}>chargement…</div>}\n   175\t      {sfx && shown.length === 0 && <div style={{ color: C.sub, padding: 16 }}>Aucun SFX. Importe-en ou teste via yt-dlp.</div>}\n   176\t      {shown.map((s, i) => {\n   177\t        const on = player.current && player.current.path === s.path\n   178\t        return (\n   179\t          <div key={s.path || i} onClick={() => player.playTrack({ path: s.path, title: s.name, source: 'local' })} style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '7px 10px', borderRadius: 6, cursor: 'pointer', color: on ? C.accent : C.text }} onMouseEnter={(e) => e.currentTarget.style.background = 'rgba(255,255,255,0.05)'} onMouseLeave={(e) => e.currentTarget.style.background = 'transparent'}>\n   180\t            <span style={{ color: C.sub, fontFamily: FONTS.mono, fontSize: 12, width: 16 }}>{on && player.playing ? '▶' : '🔊'}</span>\n   181\t            <span style={{ flex: 1, fontSize: 13.5, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{s.name}</span>\n   182\t            <span style={{ fontFamily: FONTS.mono, fontSize: 11, color: C.sub }}>{(s.tags || []).join(' ')}</span>\n   183\t          </div>\n   184\t        )\n   185\t      })}\n   186\t    </div>\n   187\t  )\n   188\t}\n   189\t\n   190\t// C74/C75 — vue Spotify : login OAuth, profil, playlists, recherche, lecture via embed (marche pour tous, sans Premium).\n   191\tconst uriToEmbed = (uri) => { const p = (uri || '').split(':'); return p.length === 3 ? `https://open.spotify.com/embed/${p[1]}/${p[2]}` : null }\n   192\tfunction SpotifyView() {\n   193\t  const [logged, setLogged] = useState(isLoggedIn())\n   194\t  const [profile, setProfile] = useState(null)\n   195\t  const [pls, setPls] = useState(null)\n   196\t  const [q, setQ] = useState('')\n   197\t  const [results, setResults] = useState(null)\n   198\t  const player = usePlayer()\n   199\t  useEffect(() => { if (!logged) return; me().then(setProfile); myPlaylists().then((j) => setPls(j && j.items ? j.items : [])) }, [logged])\n   200\t  const doSearch = async () => { if (!q.trim()) return; const j = await search(q); setResults(j && j.tracks ? j.tracks.items : []) }\n   201\t  const isOnUri = (uri) => player.current && player.current.uri === uri\n   202\t\n   203\t  if (!hasConfig()) return <div style={{ color: C.sub, padding: 24 }}>Config Spotify absente (clés non chargées au build).</div>\n   204\t  if (!logged) return (\n   205\t    <div style={{ padding: 40, textAlign: 'center' }}>\n   206\t      <div style={{ fontFamily: FONTS.serif, fontSize: 24, color: C.text, marginBottom: 6 }}>Spotify</div>\n   207\t      <div style={{ color: C.sub, marginBottom: 18, lineHeight: 1.6 }}>Connecte ton compte. Ta session est gardée (refresh automatique). Lecture in-app via embed (et Web Playback SDK si Premium).</div>\n   208\t      <button onClick={login} style={{ background: '#1db954', color: '#fff', border: 'none', borderRadius: 99, padding: '11px 26px', fontSize: 14, fontWeight: 700, cursor: 'pointer', fontFamily: FONTS.sans }}>Se connecter à Spotify</button>\n   209\t    </div>\n   210\t  )\n   211\t  return (\n   212\t    <div style={{ padding: '4px 8px 18px' }}>\n   213\t      <div style={{ display: 'flex', alignItems: 'center', gap: 12, marginBottom: 14 }}>\n   214\t        {profile && profile.images && profile.images[0] && <img src={profile.images[0].url} alt=\"\" style={{ width: 32, height: