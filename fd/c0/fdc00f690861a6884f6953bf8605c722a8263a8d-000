playableInline(m.mime)\n    42\t  const isVideo = m && m.mime && m.mime.startsWith('video/')\n    43\t  const isAudio = m && m.mime && m.mime.startsWith('audio/')\n    44\t  const isImage = m && m.mime && m.mime.startsWith('image/')\n    45\t\n    46\t  // téléchargement reconstitué (pour les formats non lisibles inline)\n    47\t  const download = async () => {\n    48\t    setDlProgress(0)\n    49\t    try {\n    50\t      const { url } = await loadChunked(path, (r) => setDlProgress(r))\n    51\t      if (urlRef.current) URL.revokeObjectURL(urlRef.current)\n    52\t      urlRef.current = url; setDlUrl(url); setDlProgress(1)\n    53\t    } catch (e) { setDlProgress(null); setErr(String(e.message || e)) }\n    54\t  }\n    55\t\n    56\t  const card = { background: t.surface, border: `1px solid ${t.border}`, borderRadius: RADII.lg, boxShadow: SHADOWS.md, padding: 22, maxWidth: 900, margin: '0 auto' }\n    57\t  const button = { padding: '8px 18px', borderRadius: RADII.md, border: `1px solid ${PALETTE.primary}`, background: PALETTE.primarySoft, color: PALETTE.primary, cursor: 'pointer', fontSize: 13, fontWeight: 600, textDecoration: 'none', display: 'inline-block' }\n    58\t\n    59\t  return (\n    60\t    <div style={{ padding: 24 }}>\n    61\t      <div style={card}>\n    62\t        <div style={{ fontFamily: \"'AnthropicSans', sans-serif\", fontSize: 24, fontWeight: 700, marginBottom: 6, color: t.textPrimary }}>{title || (m && m.name)}</div>\n    63\t        {m && <div style={{ color: t.textSecondary, fontSize: 12.5, marginBottom: 16 }}>{(m.size / 1048576).toFixed(1)} Mo · {m.count} parties · {m.mime}</div>}\n    64\t\n    65\t        {phase === 'error' && <div style={{ color: PALETTE.red, fontSize: 13 }}>Erreur : {err}</div>}\n    66\t\n    67\t        {phase === 'ready' && inline && (\n    68\t          <div>\n    69\t            {isVideo && (m.type === 'mse-av'\n    70\t              ? <React.Suspense fallback={<div style={{ color: t.textSecondary, fontSize: 