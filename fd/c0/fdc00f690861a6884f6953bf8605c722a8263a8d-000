 => { try { return localStorage.getItem('zr:create:folder') || 'pages' } catch { return 'pages' } })\n   695\t  const setFolder = (f) => { setFolderRaw(f); try { localStorage.setItem('zr:create:folder', f || 'pages') } catch {} }\n   696\t  const [uploadProgress, setUploadProgress] = useState(null) // C202 ratio 0..1 pendant un upload média chunké\n   697\t  const [dragging, setDragging] = useState(false) // capture universelle : survol d'un drop de fichiers sur le Finder\n   698\t  const [captureToast, setCaptureToast] = useState('') // petit toast (ex : vidéo à transcoder)\n   699\t  const dragDepth = useRef(0) // compteur d'entrée/sortie pour un overlay stable malgré les enfants\n   700\t  const [split, setSplit] = useState(() => { try { return localStorage.getItem('zr:split') === '1' } catch { return false } }) // C51 mode split\n   701\t  const [zoom, setZoom] = useState(() => { try { return Number(localStorage.getItem('zr:create:zoom')) || 132 } catch { return 132 } }) // C212 zoom grille\n   702\t  useEffect(() => { try { localStorage.setItem('zr:create:zoom', String(zoom)) } catch {} }, [zoom])\n   703\t  const [eagleIdx, setEagleIdx] = useState(null) // C211d/C212b index Eagle BORNÉ au dossier courant (pas global)\n   704\t  const [eagleNonce, setEagleNonce] = useState(0) // C211j force la reconstruction de l'index\n   705\t  const [smartFolders, setSmartFolders] = useState([]) // C211i smart folders\n   706\t  const smartSha = useRef(null)\n   707\t  const [smartActive, setSmartActive] = useState(null)\n   708\t  useEffect(() => { readSmartFolders().then(({ smart, sha }) => { setSmartFolders(smart); smartSha.current = sha }) }, [])\n   709\t  useEffect(() => { try { localStorage.setItem('zr:split', split ? '1' : '0') } catch {} }, [split])\n   710\t  const [peek, setPeek] = useState(null) // C50 page en aperçu latéral { path }\n   711\t  const [sort, setSort] = useState({ key: 'name', dir: 'asc' }) // C18 tri Finder\n   712\t  const [ctx, setCtx] = useState(null) // C21 menu contextuel { x, y, entry }\n   713\t  const [renaming, setRenaming] = useState(null) // C22 dir de l'entrée en cours de renommage\n   714\t  const [renameVal, setRenameVal] = useState('')\n   715\t  const [selected, setSelected] = useState(() => new Set()) // C17 sélection multiple\n   716\t  const [quick, setQuick] = useState(null) // C24 Quick Look { entry }\n   717\t  const [dropDir, setDropDir] = useState(null) // C23 cible de drop survolée\n   718\t  const lastSel = useRef(null)\n   719\t  const gridScrollRef = useRef(null) // conteneur scrollable de la grille (virtualisation >200 tuiles)\n   720\t  const shownRef = useRef([])\n   721\t  const histRef = useRef([]) // historique des pages ouvertes (bouton retour)\n   722\t  // C217 — Finder responsive : sous 860px on empile (colonnes favoris/inspecteur masquées inline, ouvrables en drawers).\n   723\t  // P9 — seuil aligné sur celui de la sidebar (860) pour supprimer la zone bâtarde 760-860 où la sidebar flottait\n   724\t  // déjà mais le Finder gardait ses colonnes inline dans un espace serré.\n   725\t  const [narrowFinder, setNarrowFinder] = useState(typeof window !== 'undefined' ? window.innerWidth < 860 : false)\n   726\t  const [drawer, setDrawer] = useState(null) // 'fav' | 'inspect' | null\n   727\t  useEffect(() => {\n   728\t    const onR = () => { const n = window.innerWidth < 860; setNarrowFinder(n); if (!n) setDrawer(null) }\n   729\t    window.addEventListener('resize', onR); return () => window.removeEventListener('resize', onR)\n   730\t  }, [])\n   731\t\n   732\t  const [tags, setTags] = useState({})       // { 'pages/x.md': 'red' } — tags couleur façon Finder\n   733\t  const [tagFilter, setTagFilter] = useState(null)\n   734\t  const [eagleView, setEagleView] = useState(null) // C211h vue système Eagle: 'untagged'|'recent-added'|'random'\n   735\t  const tagSha = useRef(null)\n   736\t  const TAGS_PATH = 'pages/.zr-tags.json'\n   737\t\n   738\t  // C27 — favoris : épingler n'importe quelle page OU dossier (y compris sous-pages) dans la barre latérale. Stocké localStorage.\n   739\t  const [favorites, setFavorites] = useState(() => { try { return JSON.parse(localStorage.getItem('zr:favorites') || '[]') } catch { return [] } })\n   740\t  useEffect(() => { try { localStorage.setItem('zr:favorites', JSON.stringify(favorites)) } catch {} }, [favorites])\n   741\t  const isFav = (dir) => favorites.some((f) => f.dir === dir)\n   742\t  const toggleFav = (e) => setFavorites((fs) => fs.some((f) => f.dir === e.dir)\n   743\t    ? fs.filter((f) => f.dir !== e.dir)\n   744\t    : [...fs, { dir: e.dir, name: e.name, contentPath: e.contentPath || null, hasKids: !!e.hasKids }])\n   745\t\n   746\t  // CHARGEMENT PARESSEUX (lazy) du Finder : on ne liste QUE les enfants du dossier courant (action 'children',\n   747\t  // Contents API non récursive) -> jamais tronqué, scalable à 45k+ nœuds. `paths` (arbre global, action 'tree')\n   748\t  // reste chargé en SECONDAIRE pour la recherche et les sélecteurs de relation (best-effort, peut être tronqué).\n   749\t  const [dirEntries, setDirEntries] = useState(null) // entrées du dossier courant (source navigation)\n   750\t  const buildDirEntries = (entries, dir) => {\n   751\t    // reconstruit des chemins synthétiques pour réutiliser entriesOfNodes (fusion jumeaux + typage)\n   752\t    const synth = []\n   753\t    for (const e of (entries || [])) synth.push(e.type === 'dir' ? `${dir}/${e.name}/` : e.path)\n   754\t    return entriesOfNodes(synth, dir)\n   755\t  }\n   756\t  const loadDir = (f) => fetch(`/api/page?action=children&dir=${encodeURIComponent(f)}`, { cache: 'no-store' })\n   757\t    .then((r) => r.json()).then((j) => setDirEntries(buildDirEntries(j.entries, f))).catch(() => setDirEntries([]))\n   758\t  const loadPaths = () => fetch('/api/page?action=tree', { cache: 'no-store' }).then((r) => r.json()).then((j) => { setPaths(j.paths || []) }).catch(() => setPaths([]))\n   759\t  // loadTree() = rafraîchit le dossier courant (rapide) + l'index global (secondaire). Appelé après chaque écriture.\n   760\t  const loadTree = () => { loadDir(folder); return loadPaths() }\n   761\t  useEffect(() => { loadPaths() }, [])\n   762\t  useEffect(() => { setDirEntries(null); loadDir(folder) }, [folder]) // changement de dossier = liste paresseuse\n   763\t  useEffect(() => { fetch(`/api/page?action=read&path=${TAGS_PATH}`, { cache: 'no-store' }).then((r) => r.json()).then((j) => { if (j && j.markdown && !j.missing) { tagSha.current = j.sha; try { setTags(JSON.parse(j.markdown) || {}) } catch {} } }).catch(() => {}) }, [])\n   764\t  const setTag = (pagePath, color) => {\n   765\t    const next = { ...tags }; if (!color || next[pagePath] === color) delete next[pagePath]; else next[pagePath] = color\n   766\t    setTags(next)\n   767\t    fetch('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'save', path: TAGS_PATH, markdown: JSON.stringify(next), sha: tagSha.current }) }).then((r) => r.json()).then((j) => { if (j && j.ok) tagSha.current = j.sha }).catch(() => {})\n   768\t  }\n   769\t\n   770\t  const newPage = () => {\n   771\t    const title = (window.prompt('Titre de la page ?', 'Nouvelle page') || '').trim()\n   772\t    if (!title) return\n   773\t    const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || 'page'\n   774\t    const path = `pages/${slug}-${Date.now().toString(36).slice(-4)}.md`\n   775\t    fetch('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'save', path, markdown: `# ${title}\\n\\n` }) })\n   776\t      .then((r) => r.json()).then((j) => { if (j.ok) { fetch('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'save', path: path.replace(/\\.md$/, '.props.json'), markdown: JSON.stringify({ icon: 'doc.text' }) }) }).catch(() => {}); setCur({ path }); setStatus('créée ✓'); loadTree() } else setStatus('erreur ' + (j.error || '')) })\n   777\t  }\n   778\t  // C2 : créer une sous-page sous un dossier (clic \"+\" au survol d'un nœud de l'arbre). folderPath inclut déjà \"pages/...\".\n   779\t  const addChild = (folderPath) => {\n   780\t    const title = (window.prompt('Titre de la sous-page ?', 'Nouvelle page') || '').trim()\n   781\t    if (!title) return\n   782\t    const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || 'page'\n   783\t    const path = `${folderPath}/${slug}-${Date.now().toString(36).slice(-4)}.md`\n   784\t    fetch('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'save', path, markdown: `# ${title}\\n\\n` }) })\n   785\t      .then((r) => r.json()).then((j) => { if (j.ok) { fetch('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'save', path: path.replace(/\\.md$/, '.props.json'), markdown: JSON.stringify({ icon: 'doc.text' }) }) }).catch(() => {}); setCur({ path }); setStatus('sous-page créée ✓'); loadTree() } else setStatus('erreur ' + (j.error || '')) })\n   786\t  }\n   787\t  // C200 : créer une base de données (fichier .db.json) dans le dossier courant.\n   788\t  const newDatabase = (folderPath) => {\n   789\t    const title = (window.prompt('Nom de la base ?', 'Nouvelle base') || '').trim()\n   790\t    if (!title) return\n   791\t    const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || 'base'\n   792\t    const path = `${folderPath}/${slug}-${Date.now().toString(36).slice(-4)}.db.json`\n   793\t    const seed = { name: title, columns: [{ id: 'c' + Date.now().toString(36), name: 'Nom', type: 'text', w: 220 }], rows: [], views: [] }\n   794\t    fetch('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'save', path, markdown: JSON.stringify(seed) }) })\n   795\t      .then((r) => r.json()).then((j) => { if (j.ok) { setCur({ path }); setStatus('base créée ✓'); loadTree() } else setStatus('erreur ' + (j.error || '')) })\n   796\t  }\n   797\t  // C2b : déplacer (re-parenter) un nœud-feuille par drag. Marche pour page (.md), image (.img.json),\n   798\t  // média (.media.json), base (.db.json). Sûr : refuse si le nœud a des sous-pages (pas de move de sous-arbre).\n   799\t  // Le serveur (action move) gère les jumeaux d'une page et ne déplace que le descripteur d'une image/média.\n   800\t  const movePage = async (fromPath, toFolder) => {\n   801\t    const fromBase = stripLeafExt(fromPath) // identité du nœud, indépendante du type\n   802\t    const fileName = fromPath.split('/').pop()\n   803\t    const to = `${toFolder}/${fileName}`\n   804\t    if (to === fromPath || toFolder === fromBase) return // déjà au bon endroit / sur soi-même\n   805\t    if ((toFolder + '/').startsWith(fromBase + '/')) { setStatus('move impossible (dans soi-même)'); return }\n   806\t    const hasChildren = (paths || []).some((p) => stripLeafExt(p).startsWith(fromBase + '/'))\n   807\t    if (hasChildren) { window.alert('Ce nœud a des sous-pages. Le déplacement de sous-arbre n\\'est pas encore supporté (sécurité anti-perte). Déplace d\\'abord les enfants.'); return }\n   808\t    // C211f — drop silencieux façon Finder : le glisser est délibéré, pas de popup. Statut suffit.\n   809\t    setStatus('déplacement…')\n   810\t    const j = await fetch('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'move', from: fromPath, to }) }).then((r) => r.json()).catch(() => null)\n   811\t    if (j && j.ok) { if (cur && cur.path === fromPath) setCur({ path: to }); setStatus('déplacée ✓'); loadTree() }\n   812\t    else setStatus('erreur move ' + ((j && j.error) || ''))\n   813\t  }\n   814\t  // C21/C22 : trash d'une entrée Finder, GÉNÉRALISÉ à tous les types de nœuds (page/image/média/base).\n   815\t  // Mécanisme = corbeille restaurable (soft delete) : on COPIE le ou les fichiers du nœud sous trash/<reste>,\n   816\t  // puis on supprime l'original dans pages/. On ne touche JAMAIS les binaires :\n   817\t  //  - image (.img.json) : le binaire + vignette restent sur le shard privé (référencés par hash) -> restaurables.\n   818\t  //  - média (.media.json) : les parts media/<id>/NNN.bin restent en place (chemin absolu stable) -> restaurables.\n   819\t  //    NB : on n'utilise PAS l'action delete serveur ici (elle purge les parts = perte définitive).\n   820\t  //  - base (.db.json) : un seul fichier.\n   821\t  //  - page (.md) : le .md + ses 3 jumeaux (.blocknote/.comments/.props.json).\n   822\t  // Les fichiers d'un nœud à déplacer, selon son type.\n   823\t  const trashTwins = (contentPath) => {\n   824\t    const ty = typeOfPath(contentPath)\n   825\t    if (ty === 'page') return [contentPath, ...['.blocknote.json', '.comments.json', '.props.json'].map((e) => contentPath.replace(/\\.md$/, e))]\n   826\t    return [contentPath] // image / média / base / autres : descripteur unique\n   827\t  }\n   828\t  const trashPath = async (contentPath) => {\n   829\t    for (const src of trashTwins(contentPath)) {\n   830\t      const r = await fetch(`/api/page?action=read&path=${encodeURIComponent(src)}`, { cache: 'no-store' }).then((x) => x.json()).catch(() => null)\n   831\t      if (r && r.sha && !r.missing) {\n   832\t        const dst = 'trash/' + src.replace(/^pages\\//, '')\n   833\t        await fetch('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'save', path: dst, markdown: r.markdown }) })\n   834\t        await fetch('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'delete', path: src, sha: r.sha }) })\n   835\t      }\n   836\t    }\n   837\t  }\n   838\t  const delEntry = async (entry