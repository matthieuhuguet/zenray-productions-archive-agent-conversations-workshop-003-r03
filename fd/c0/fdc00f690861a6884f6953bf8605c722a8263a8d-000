, i) => ({ id: i, label: `${LANG[a.lang] || a.lang || 'Piste'} ${i + 1}${a.codec ? ' · ' + a.codec : ''}` }))\n    67\t\n    68\t  // pistes audio : lues sur l'élément (Safari les expose ; Chrome souvent non -> sélecteur masqué)\n    69\t  const readAudio = () => {\n    70\t    const el = v.current; const list = el && el.audioTracks\n    71\t    if (!list || list.length <= 1) { setAudioTracks([]); return }\n    72\t    const arr = []; let sel = 0\n    73\t    for (let i = 0; i < list.length; i++) { const tr = list[i]; arr.push({ id: i, label: `${tr.language && tr.language !== 'und' ? tr.language : 'Piste'} ${i + 1}${tr.label ? ' · ' + tr.label : ''}` }); if (tr.enabled) sel = i }\n    74\t    setAudioTracks(arr); setAudioSel(sel)\n    75\t  }\n    76\t  // LIMITE NAVIGATEUR sur le switch audio : le menu s'affiche dès que le MANIFEST liste 2+ pistes\n    77\t  // (probeAudio), mais le changement effectif passe par HTMLMediaElement.audioTracks. Cette API n'est\n    78\t  // peuplée que par Safari (et Edge legacy). Chrome/Firefox lisant un mp4 multi-pistes en <video src>\n    79\t  // simple n'exposent PAS audioTracks (souvent length<=1) -> el.audioTracks est vide, la boucle ne\n    80\t  // touche rien, on ne fait que mémoriser la sélection (UI cohérente) sans changer le son réel.\n    81\t  // Pour un switch fiable hors Safari il faudrait soit MSE/sourceBuffer multi-pistes, soit un fichier\n    82\t  // par langue côté serveur. Donc : menu visible partout, switch réel garanti seulement sur Safari.\n    83\t  const pickAudio = (id) => { setOpenMenu(null); const el = v.current; setAudioSel(id); if (!el || !el.audioTracks || el.audioTracks.length <= 1) return; for (let i = 0; i < el.audioTracks.length; i++) el.audioTracks[i].enabled = (i === id) }\n    84\t  const pickSub = (id) => {\n    85\t    setOpenMenu(null); setSubSel(id); const el = v.current; if (!el) return\n    86\t    const tt = el.textTracks; for (let i = 0; i < tt.length; i++) tt[i].mode = (id != null && i === id) ? 'showing' : 'disabled'\n    87\t  }\n    88\t  const applySpeed = (s) => { setSpeed(s); setOpenMenu(null); const el = v.current; if (el) { el.playbackRate = s; for (const k of ['preservesPitch', 'webkitPreservesPitch']) if (k in el) el[k] = true } }\n    89\t\n    90\t  const onMeta = () => { const el = v.current; if (el && isFinite(el.duration) && el.duration) setDur(el.duration); readAudio(); el.playbackRate = speed }\n    91\t  const onTime = () => { const el = v.current; setCur(el.currentTime); if (el.buffered.length) setBuffered(el.buffered.end(el.buffered.length - 1)); pump() }\n    92\t\n    93\t  // pump() : tire la prochaine fenêtre de 4Mo si on n'a pas encore 60s d'avance. Recale le curseur\n    94\t  // sur un seek arrière (currentTime revenu loin derrière le curseur préchauffé).\n    95\t  const pump = React.useCallback(() => {\n    96\t    if (!bytesPerSec) return\n    97\t    const el = v.current; if (!el) return\n    98\t    const targetByte = Math.min(mediaSize, Math.ceil((el.currentTime + PREFETCH_AHEAD) * bytesPerSec))\n    99\t    const curByte = Math.floor(el.currentTime * bytesPerSec)\n   100\t    // seek arrière : le lecteur est revenu nettement avant le curseur -> on repart de currentTime\n   101\t    if (curByte < prefetchTo.current - WINDOW) { prefetchTo.current = curByte; if (aborter.current) { aborter.current.abort(); aborter.current = null; inFlight.current = false } }\n   102\t    if (inFlight.current) return\n   103\t    if (prefetchTo.current >= targetByte || prefetchTo.current >= mediaSize) return\n   104\t    const a = prefetchTo.current\n   105\t    const b = Math.min(mediaSize - 1, a + WINDOW - 1)\n   106\t    inFlight.current = true\n   107\t    const ac = new AbortController(); aborter.current = ac\n   108\t    fetch(streamUrl, { headers: { Range: `bytes=${a}-${b}` }, signal: ac.signal })\n   109\t      .then((r) => r.arrayBuffer())\n   110\t      .then(() => { prefetchTo.current = b + 1 })\n   111\t      .catch(() => 