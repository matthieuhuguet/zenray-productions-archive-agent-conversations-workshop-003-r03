 'spotify' ? player.playSpotify([tr.uri]) : player.playTrack(tr)} style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '8px 12px', borderRadius: 6, cursor: 'pointer', color: C.text }} onMouseEnter={(e) => e.currentTarget.style.background = 'rgba(255,255,255,0.05)'} onMouseLeave={(e) => e.currentTarget.style.background = 'transparent'}>\n   100\t                    <div style={{ flex: '0 0 38px', width: 38, height: 38, borderRadius: 4, background: '#333', overflow: 'hidden' }}>{tr.cover && <img src={tr.source === 'spotify' ? tr.cover : src(tr.cover)} alt=\"\" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />}</div>\n   101\t                    <div style={{ minWidth: 0, flex: 1 }}><div style={{ fontSize: 14, fontWeight: 600, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{tr.title}</div><div style={{ fontSize: 12, color: C.sub }}>{tr.artist || '—'} · {tr.source}</div></div>\n   102\t                    <Heart tr={tr} fav />\n   103\t                  </div>\n   104\t                ))}\n   105\t              </div>\n   106\t            )}\n   107\t\n   108\t            {sub === 'spotify' && <SpotifyView />}\n   109\t            {sub === 'sfx' && <SfxView />}\n   110\t          </div>\n   111\t        </div>\n   112\t      </div>\n   113\t\n   114\t      {/* Barre lecteur (consomme le PlayerContext global) */}\n   115\t      <div style={{ flex: '0 0 auto', background: C.panel, borderTop: '1px solid #282828', padding: '10px 16px', display: 'flex', alignItems: 'center', gap: 16 }}>\n   116\t        <div style={{ display: 'flex', alignItems: 'center', gap: 10, flex: '0 0 230px', minWidth: 0 }}>\n   117\t          <div style={{ flex: '0 0 48px', width: 48, height: 48, borderRadius: 4, background: '#333', overflow: 'hidden' }}>{now && now.cover && <img src={src(now.cover)} alt=\"\" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />}</div>\n   118\t          <div style={{ minWidth: 0 }}>\n   119\t            <