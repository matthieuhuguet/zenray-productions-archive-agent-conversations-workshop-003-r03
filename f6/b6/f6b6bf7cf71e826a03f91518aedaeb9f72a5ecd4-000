le","description":"Rename a Codex thread in the background.","inputSchema":{"type":"object","additionalProperties":false,"properties":{"threadId":{"type":"string","description":"Thread id to rename."},"title":{"type":"string","description":"New thread title."}},"required":["threadId","title"]},"deferLoading":true}]}],"history_mode":"paginated","git":{"commit_hash":"78ea03089a509fdd1890b38897d7f0444ec91b32","branch":"main","repository_url":"https://github.com/matthieuhuguet/ZenRayProgress.git"}}}
