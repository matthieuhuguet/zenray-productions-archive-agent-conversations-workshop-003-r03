idth,initial-scale=1\">\n  <title>Procedural Modeling Commercial HDA</title>\n  <style>\n    /* 2026-09-16 23:58, all visual values are supplied by the HDA parameter interface. */\n    @font-face { font-family: '{{FONT_FAMILY}}'; src: url('{{FONT_PATH}}') format('opentype'); font-weight: 700; }\n    :root {\n      --canvas-width: 1920px; --canvas-height: 1080px; --content-width: 45.5%;\n      --content-padding-x: 5.4%; --content-padding-y: 8.8%; --title-size: 76px;\n      --subtitle-size: 34px; --body-size: 22px; --small-size: 17px; --cta-size: 25px;\n      --media-left: 40%; --media-width: 65%; --slice-gap: 8px; --slice-angle: -10deg;\n      --background: #111211; --panel: #171817; --silver: #c5c8cd; --orange: #f19e46;\n      --muted: #85898f; --tracking: .035em; --image-brightness: .72;\n      --image-contrast: 1.08; --image-saturation: .82; --panel-shadow: 0 0 72px rgba(0,0,0,.62);\n    }\n    * { box-sizing: border-box; }\n    html, body { margin: 0; min-height: 100%; background: #090909; font-family: '{{FONT_FAMILY}}', sans-serif; }\n    body { display: grid; place-items: center; }\n    .canvas { position: relative; width: var(--canvas-width); height: var(--canvas-height); overflow: hidden; background: var(--background); color: var(--silver); isolation: isolate; }\n    .media { position: absolute; inset: 0 0 0 var(--media-left); width: var(--media-width); overflow: hidden; background: var(--background); }\n    .slice { position: absolute; top: -8%; height: 116%; overflow: hidden; transform: skewX(var(--slice-angle)); border-left: var(--slice-gap) solid var(--background); filter: brightness(var(--image-brightness)) contrast(var(--image-contrast)) saturate(var(--image-saturation)); }\n    .slice img { width: 150%; height: 100%; object-fit: cover; transform: skewX(calc(var(--slice-angle) * -1)) scale(1.08); transform-origin: center; }\n    .slice:nth-child(1) { left: var(--slice-one-x); width: var(--slice-one-width); z-index: 1; }\n    .slice:nth-child(2) { left: var(--slice-two-x); width: var(--slice-two-width); z-index: 2; }\n    .slice:nth-child(3) { left: var(--slice-three-x); width: var(--slice-three-width); z-index: 3; }\n    .slice:nth-child(1) img { object-position: var(--slice-one-position); }\n    .slice:nth-child(2) img { object-position: var(--slice-two-position); }\n    .slice:nth-child(3) img { object-position: var(--slice-three-position); }\n    .media-shade { position: absolute; inset: 0; z-index: 5; pointer-events: none; background: linear-gradient(90deg, rgba(0,0,0,.54), transparent 22%, transparent 77%, rgba(0,0,0,.38)); }\n    .panel { position: absolute; z-index: 10; inset: 0 auto 0 0; width: var(--content-width); padding: var(--content-padding-y) var(--content-padding-x); background: var(--panel); box-shadow: var(--panel-shadow); clip-path: polygon(0 0, 100% 0, 84% 100%, 0 100%); display: flex; flex-direction: column; }\n    .eyebrow, .subtitle, .name, .specialty, .proof-label, .proof-value, .url { letter-spacing: var(--tracking); text-transform: uppercase; }\n    .eyebrow { color: var(--muted); font-size: var(--small-size); margin-bottom: 4.2%; }\n    .title { margin: 0; font-size: var(--title-size); line-height: .89; letter-spacing: .005em; max-width: 90%; }\n    .title span { display: block; }\n    .title .silver { color: var(--silver); }\n    .title .orange { color: var(--orange); }\n    .subtitle { margin-top: 2.7%; color: var(--silver); font-size: var(--subtitle-size); line-height: 1.02; max-width: 83%; }\n    .identity { margin-top: 7.5%; }\n    .name { color: var(--silver); font-size: var(--body-size); }\n    .specialty { margin-top: 1.3%; color: var(--muted); font-size: var(--small-size); line-height: 1.35; max-width: 78%; }\n    .spacer { flex: 1; }\n    .proof { margin-bottom: 5.8%; }\n    .proof-label { color: var(--silver); font-size: var(--small-size); }\n    .proof-value { margin-top: 1.1%; color: var(--orange); font-size: var(--body-size); line-height: 1.06; max-width: 78%; }\n    .cta { align-self: flex-start; padding: .62em 1.28em .58em; background: var(--orange); color: var(--panel); font-size: var(--cta-size); letter-spacing: .03em; line-height: 1; }\n    .url { margin-top: 2.8%; color: var(--muted); font-size: var(--small-size); }\n    .brand-mark { position: absolute; z-index: 20; right: 2.4%; bottom: 2.7%; color: var(--silver); opacity: .72; font-size: var(--small-size); letter-spacing: .18em; }\n    .controls { position: fixed; z-index: 999; right: 18px; top: 18px; width: 286px; max-height: calc(100vh - 36px); overflow: auto; padding: 15px; color: var(--silver); background: rgba(18,19,18,.94); border: 1px solid rgba(197,200,205,.2); border-radius: 12px; font: 12px/1.35 '{{FONT_FAMILY}}', sans-serif; box-shadow: 0 18px 60px rgba(0,0,0,.5); }\n    .controls h2 { margin: 0 0 10px; font-size: 15px; color: var(--orange); }\n    .controls label { display: block; margin: 9px 0; }\n    .controls .row { display: flex; justify-content: space-between; margin-bottom: 3px; }\n    .controls input[type=range] { width: 100%; accent-color: var(--orange); }\n    .controls select, .controls button { width: 100%; padding: 8px; border: 1px solid rgba(197,200,205,.22); border-radius: 7px; color: var(--silver); background: #242524; font: inherit; }\n    .controls button { margin-top: 8px; color: var(--panel); background: var(--orange); border: 0; cursor: pointer; }\n    .controls output { color: var(--orange); }\n    .render .controls { display: none; }\n  </style>\n</head>\n<body>\n  <main class=\"canvas\" aria-label=\"Procedural modeling commercial poster\">\n    <section class=\"media\" aria-label=\"Portfolio images\">\n      <div class=\"slice\"><img src=\"{{IMAGE_1}}\" alt=\"{{IMAGE_1_ALT}}\"></div>\n      <div class=\"slice\"><img src=\"{{IMAGE_2}}\" alt=\"{{IMAGE_2_ALT}}\"></div>\n      <div class=\"slice\"><img src=\"{{IMAGE_3}}\" alt=\"{{IMAGE_3_ALT}}\"></div>\n      <div class=\"media-shade\"></div>\n    </section>\n    <section class=\"panel\">\n      <div class=\"eyebrow\">{{EYEBROW}}</div>\n      <h1 class=\"title\"><span class=\"silver\">{{TITLE_SILVER}}</span><span class=\"orange\">{{TITLE_ORANGE}}</span></h1>\n      <div class=\"subtitle\">{{SUBTITLE}}</div>\n      <div class=\"identity\"><div class=\"name\">{{NAME}}</div><div class=\"specialty\">{{SPECIALTY}}</div></div>\n      <div class=\"spacer\"></div>\n      <div class=\"proof\"><div class=\"proof-label\">{{PROOF_LABEL}}</div><div class=\"proof-value\">{{PROOF_VALUE}}</div></div>\n      <div class=\"cta\">{{CTA}}</div>\n      <div class=\"url\">{{URL}}</div>\n    </section>\n    <div class=\"brand-mark\">ZENRAY</div>\n  </main>\n  <aside class=\"controls\">\n    <h2>Poster HDA</h2>\n    <label>Format<select id=\"format\"><option value=\"16x9\">16:9</option><option value=\"4x5\">4:5</option></select></label>\n    <div id=\"sliders\"></div>\n    <button id=\"copy\">Copy values for prompt</button>\n  </aside>\n  <script>\n    const CONFIG = {{CONFIG_JSON}};\n    const ROOT = document.documentElement;\n    const query = new URLSearchParams(location.search);\n    const formatSelect = document.getElementById('format');\n    const formatId = query.get('format') || '16x9';\n    const sliderDefinitions = [\n      ['Title size', '--title-size', 42, 96, 1, 'px'], ['Subtitle size', '--subtitle-size', 18, 46, 1, 'px'],\n      ['Panel width', '--content-width', 36, 70, .5, '%'], ['Media left', '--media-left', 32, 62, .5, '%'],\n      ['Slice angle', '--slice-angle', -18, -2, .5, 'deg'], ['Image brightness', '--image-brightness', .35, 1.15, .01, ''],\n      ['Image contrast', '--image-contrast', .8, 1.5, .01, ''], ['Image saturation', '--image-saturation', .2, 1.4, .01, '']\n    ];\n    function applyFormat(id) {\n      const f = CONFIG.formats[id];\n      const map = {\n        canvasWidth:'--canvas-width', canvasHeight:'--canvas-height', contentWidth:'--content-width',\n        contentPaddingX:'--content-padding-x', contentPaddingY:'--content-padding-y', titleSize: