\"\n}\n\nIsYouTubeURL() {\n  case \"${1:l}\" in\n    https://youtube.com|https://youtube.com/*|https://www.youtube.com|https://www.youtube.com/*|https://m.youtube.com|https://m.youtube.com/*|https://music.youtube.com|https://music.youtube.com/*|https://youtu.be|https://youtu.be/*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\nIsFeedURL() {\n  local path; path=\"$(UrlPath \"$1\")\"\n  [[ \"$path\" == */feed/subscriptions || \"$path\" == */feed/subscriptions/* ]]\n}\n\nIsAllowedChannelURL() {\n  local path; path=\"$(UrlPath \"$1\")\"\n  case \"$path\" in\n    */@icijapon|*/@icijapon/*|*/@icijaponcorp|*/@icijaponcorp/*) return 0 ;;\n  esac\n  [[ \"$path\" == */channel/ucege5vmbdmzksbgeedoylbkw ||\n     \"$path\" == */channel/ucege5vmbdmzksbgeedoylbkw/* ||\n     \"$path\" == */channel/uc_r99mjdkzksbgeedoylbkw ||\n     \"$path\" == */channel/uc_r99mjdkzksbgeedoylbkw/* ||\n     \"$path\" == */channel/uct11zynefnunokgcrso9uyg ||\n     \"$path\" == */channel/uct11zynefnunokgcrso9uyg/* ]]\n}\n\nIsVideoURL() {\n  local path; path=\"$(UrlPath \"$1\")\"\n  case \"$path\" in\n    */watch|*/shorts/*|*/live/*|*/embed/*|https://youtu.be/*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\nChannelIdFor() {\n  local url=\"$1\" cache id\n  EnsureState\n  cache=\"$STATE_DIR/channel_$(printf '%s' \"$url\" | shasum -a 256 | awk '{print $1}').txt\"\n  [[ -s \"$cache\" ]] && { cat \"$cache\"; return 0; }\n  command -v yt-dlp >/dev/null 2>&1 || return 0\n  id=\"$(yt-dlp --print '%(channel_id)s' --skip-download --no-playlist \\\n    --no-warnings --socket-timeout 4 --extractor-retries 1 --retries 1 \\\n    \"$url\" 2>/dev/null | head -1)\"\n  [[ \"$id\" == \"NA\" ]] && id=\"\"\n  id=\"${id:l}\"\n  [[ -n \"$id\" ]] && printf '%s\\n' \"$id\" > \"$cache\"\n  printf '%s\\n' \"$id\"\n}\n\nIsAllowedId() {\n  local id=\"${1:l}\" allowed\n  for allowed in \"${ICI_JAPON_IDS[@]}\"; do\n    [[ \"$id\" == \"$allowed\" ]] && return 0\n  done\n  return 1\n}\n\nIsFreeYouTube() {\n  local url=\"$1\" id\n  IsFeedURL \"$url\" && return 0\n  IsAllowedChannelURL \"$url\" && return 0\n  IsVideoURL \"$url\" || return 1\n  id=\"$(ChannelIdFor \"$url\")\"\n  IsAllowedId \"$id\"\n}\n\nGrantStillActive() {\n  local until\n  [[ -s \"$GRANT_UNTIL_FILE\" ]] || return 1\n  until=\"$(cat \"$GRANT_UNTIL_FILE\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ '^[0-9]+$' ]] || return 1\n  (( $(Now) < until ))\n}\n\nClearGrant() {\n  pkill -x SocialMediaGuardTimer >/dev/null 2>&1 || true\n  rm -f \"$GRANT_UNTIL_FILE\" \"$GRANT_CHANNEL_FILE\" \"$GRANT_URL_FILE\"\n}\n\nGrantMatches() {\n  local url=\"$1\" granted channel current\n  GrantStillActive || { ClearGrant; return 1; }\n  granted=\"$(cat \"$GRANT_CHANNEL_FILE\" 2>/dev/null || true)\"\n  if [[ -n \"$granted\" ]]; then\n    current=\"$(ChannelIdFor \"$url\")\"\n    [[ -n \"$current\" && \"$current\" == \"$granted\" ]]\n    return\n  fi\n  [[ \"$(UrlPath \"$url\")\" == \"$(cat \"$GRANT_URL_FILE\" 2>/dev/null || true)\" ]]\n}\n\nStartGrant() {\n  local target=\"$1\" until channel\n  until=$(( $(Now) + 15 * 60 ))\n  channel=\"$(ChannelIdFor \"$target\")\"\n  printf '%s\\n' \"$until\" > \"$GRANT_UNTIL_FILE\"\n  printf '%s\\n' \"$channel\" > \"$GRANT_CHANNEL_FILE\"\n  printf '%s\\n' \"$(UrlPath \"$target\")\" > \"$GRANT_URL_FILE\"\n  pkill -x SocialMediaGuardTimer >/dev/null 2>&1 || true\n  nohup \"$TIMER_BIN\" \"$GRANT_UNTIL_FILE\" >/dev/null 2>&1 </dev/null &\n}\n\nWriteBlockPage() {\n  cat > \"$BLOCK_PAGE_FILE\" <<'HTML'\n<!doctype html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>YouTube bloqué</title>\n<style>\n  :root { color-scheme: dark }\n  * { box-sizing: border-box }\n  body { margin: 0; min-height: 100vh; display: grid; place-items: center;\n         background: #202020; color: #f3f3f3; font: 300 18px system-ui, sans-serif }\n  main { width: min(620px, calc(100vw - 40px)); padding: 56px 40px; text-align: center;\n         border-radius: 18p