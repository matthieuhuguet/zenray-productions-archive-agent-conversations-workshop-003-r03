{"timestamp":"2026-08-13T06:34:45.974Z","ordinal":766,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019ff9d4-9356-7f22-9a7f-8a0eac192353","call_id":"call_ZcdwtzqkwGRm0dpRrZb56yte","output":[{"type":"input_text","text":"Script completed\nWall time 0.0 seconds\nOutput:\n"},{"type":"input_text","text":"#!/bin/zsh\nset -euo pipefail\nexport PATH=\"/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin\"\n\n# ===========================================================================\n#  SOCIAL MEDIA GUARD\n#  Closes the creators (YouTube + Instagram/TikTok/X/Facebook) that Matthieu\n#  chose to stop watching. Instead of a hard block, the tab switches to a\n#  block page: one button opens the content for 15 minutes. A native floating\n#  timer stays visible over the real page and exits when the allowance ends.\n#\n#  How blocking stays fast (no visible frame of the real page):\n#    - FAST pass  (~0.1s): checks only the ACTIVE tab and redirects it inside\n#      AppleScript. Runs only while a browser is frontmost. Kills the frame.\n#    - DEEP pass  (~1s):   full sweep of every tab, resolves YouTube videos\n#      through yt-dlp, handles the reward, catches background tabs.\n#\n#  File map:\n#     1. Config              - paths, timings, browsers\n#     2. Blocked creators    - BLOCKED_PATTERNS (single editable source)\n#     3. Small helpers       - dates, text, url encoding\n#     4. Files and migration - folders, password, old names\n#     5. On / Off            - disabled, suspended, active window\n#     6. Match engine        - does this text point to a blocked creator?\n#     7. Reward (grace)      - temporary earned access, per creator\n#     8. Timer               - native bottom-right access timer\n#     9. Block page          - the HTML shown in the tab\n#    10. Browser control     - list tabs, redirect one tab\n#    11. Fast pass           - instant redirect of the active tab\n#    12. Watch loop          - the loop the background service runs\n#    13. Install             - user service (+ optional root layer)\n#    14. Commands            - status, suspend, disable/enable, uninstall\n#    15. Entry point         - command line dispatch\n#\n#  Usage: SocialMediaGuard.sh <command>\n#    install-user | status | enable | disable | suspend [min] |\n#    enforce | watch-tabs | close-tabs | uninstall-user |\n#    install-root | uninstall-root | cleanup-root\n# ===========================================================================\n\n\n# --- 1. Config -------------------------------------------------------------\n\nOWNER=\"zenray\"\nMEMORY_ROOT=\"${MEMORY_ROOT:-/Users/zenray/Create/Build/Memory}\"\nFOCUS_DIR=\"$MEMORY_ROOT/Focus\"\n\nSECRET_FILE=\"$FOCUS_DIR/.SocialMediaGuardPassword\"     # local password (git-ignored)\nSTATE_DIR=\"$FOCUS_DIR/.SocialMediaGuardState\"          # internal state (git-ignored)\nDISABLED_FILE=\"$STATE_DIR/disabled\"                    # present = guard turned off\nSUSPEND_FILE=\"$STATE_DIR/suspend_until\"                # epoch when suspension ends\nBLOCK_PAGE_FILE=\"$FOCUS_DIR/SocialMediaBlocked.html\"   # the page shown in the tab\nBLOCK_PAGE_URL=\"file://$BLOCK_PAGE_FILE\"\nILLUSTRATION_URL=\"file://$MEMORY_ROOT/ArtDirection/output_v3.png\"\n\n# YouTube daytime gate (separate from the creator list below): all of\n# youtube.com/youtu.be is closed during this window, every day. \"Ask for\n# time\" opens it immediately once for 15 minutes, then stays closed for the day.\nYT_DAY_START_HOUR=\"${SMG_YT_START_HOUR:-10}\"\nYT_DAY_END_HOUR=\"${SMG_YT_END_HOUR:-19}\"\nYT_GRANT_MINUTES=(15)             # one 15-minute allowance per day\nYT_BLOCK_PAGE_FILE=\"$FOCUS_DIR/YouTubeDaytimeBlocked.html\"\nYT_BLOCK_PAGE_URL=\"file://$YT_BLOCK_PAGE_FILE\"\nYT_DAY_FILE=\"$STATE_DIR/youtube_daytime_day\"              # YYYY-MM-DD of last reset\nYT_GRANTS_USED_FILE=\"$STATE_DIR/youtube_daytime_grants_used\"\nYT_UNTIL_FILE=\"$STATE_DIR/youtube_daytime_until\"           # epoch, current grant expiry\nACTIVE_GRANT_FILE=\"$STATE_DIR/active_grant_until\"         # epoch for native timer\nTIMER_SOURCE=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuardTimer.swift\"\nTIMER_BIN=\"$STATE_DIR/SocialMediaGuardTimer\"\n\n# The creator allowance is intentionally fixed. There is no second countdown.\nREWARD_MINUTES=15\nSTART_HOUR=\"${SMG_START_HOUR:-0}\"           # active window: 0..24 = always on\nEND_HOUR=\"${SMG_END_HOUR:-24}\"\nFAST_SLEEP=\"${SMG_FAST_SLEEP:-0.1}\"         # active-tab poll interval (seconds)\nDEEP_EVERY=\"${SMG_DEEP_EVERY:-10}\"          # deep sweep once every N fast passes\n\n# Background service (LaunchAgent).\nUSER_LABEL=\"com.zenray.social-media-guard.tabs\"\nROOT_LABEL=\"com.zenray.social-media-guard\"\nUSER_PLIST=\"$HOME/Library/LaunchAgents/$USER_LABEL.plist\"\nROOT_PLIST=\"/Library/LaunchDaemons/$ROOT_LABEL.plist\"\nSCRIPT_PATH=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuard.sh\"\nUSER_LOG=\"$HOME/Library/Logs/SocialMediaGuard.tabs.log\"\nUSER_ERR_LOG=\"$HOME/Library/Logs/SocialMediaGuard.tabs.err.log\"\n\n# Optional root layer (hosts + Chrome policy). Inactive without sudo.\nHOSTS_FILE=\"/etc/hosts\"\nHOSTS_MARK_START=\"# ZENRAY_SOCIAL_MEDIA_GUARD_START\"\nHOSTS_MARK_END=\"# ZENRAY_SOCIAL_MEDIA_GUARD_END\"\nCHROME_POLICY_FILE=\"/Library/Managed Preferences/com.google.Chrome.plist\"\nCHROME_POLICY_BACKUP=\"$STATE_DIR/com.google.Chrome.plist.before-guard\"\nCHROME_POLICY_MARKER=\"$STATE_DIR/chrome_policy_backup_state\"\nHOST_DOMAINS=()\nCHROME_BLOCKLIST=()\n\n# Browsers we drive. Every Chromium shares Google Chrome's tab vocabulary\n# (\"using terms from\"); Safari has its own.\nCHROMIUM_BROWSERS=(\n  \"Google Chrome\" \"Google Chrome Beta\" \"Google Chrome Canary\" \"Chromium\"\n  \"Brave Browser\" \"Brave Browser Beta\" \"Microsoft Edge\" \"Microsoft Edge Beta\"\n  \"Vivaldi\" \"Opera\" \"Opera GX\"\n)\n\n\n# --- 2. Blocked creators (single source of truth) --------------------------\n#\n# Each entry is matched as a substring, case-insensitive and separator-\n# insensitive (see Normalize), against two things:\n#   1) the tab URL (any network) - blocks YouTube, Instagram, TikTok,\n#      Facebook and X as soon as the entry is the account handle;\n#   2) the identity yt-dlp returns for a /watch page (channel name, uploader)\n#      - catches every video and side channel of a creator, even without\n#      knowing their exact handle.\n# Safety: an entry that matches nothing blocks nothing (harmless miss). So we\n# can be broad on NAMES and stay precise (joined handle or URL) to never block\n# a third party by accident.\n#\n# A few entries keep accents on purpose: they are real creator names, and a\n# channel identity like \"HugoDecrypte\" written with the accent is only caught\n# by the accented form.\n\nBLOCKED_PATTERNS=(\n  # --- Ici Japon ---\n  \"youtube.com/@icijaponcorp\"  \"youtube.com/channel/uct11zynefnunokgcrso9uyg\"  \"ici japon\"\n  # --- Silicon Carne / Carlos Diaz ---\n  \"youtube.com/@siliconcarnepod\"  \"siliconcarne\"  \"silicon carne\"  \"carlosdiaz\"  \"carlos diaz\"\n  # --- Oussama Ammar ---\n  \"youtube.com/@oussamaammaroff\"  \"youtube.com/channel/ucxh-b8b2sx4kgshsvj3ngza\"\n  \"oussamaammaroff\"  \"oussamaammar\"  \"oussama ammar\"\n  # --- Yomi Denzel ---\n  \"youtube.com/@yomidenzel\"  \"youtube.com/yomidenzel\"  \"youtube.com/channel/uchge6r4qaugajalyijoccgw\"\n  \"yomidenzel\"  \"yomi.denzel\"  \"yomi denzel\"\n  # --- Antoine Blanco (+ business channel) ---\n  \"youtube.com/@antoineblanco\"  \"youtube.com/@antoineblanco99\"  \"youtube.com/@antoineblancobusiness\"\n  \"youtube.com/channel/uc0kcckhmqfiguifkqco-iya\"  \"antoineblanco\"  \"antoine blanco\"\n  # --- Sixtine Moulle-Berteaux ---\n  \"youtube.com/@sixtinemoulleberteaux\"  \"sixtinemoulleberteaux\"  \"sixtine.moulleberteaux\"\n  \"sixtine moulle\"  \"sixtine moulle-berteaux\"\n  # --- Wallerand Moulle-Berteaux ---\n  \"wallerandmoulleberteaux\"  \"wallerand.moulleberteaux\"  \"wallerand moulle\"  \"wallerand moulle-berteaux\"\n  # --- Eric Larcheveque ---\n  \"ericlarcheveque\"  \"eric larcheveque\"  \"eric l'archeveque\"  \"eric larchevêque\"\n  # --- Guillaume Moubeche ---\n  \"guillaumemoubeche\"  \"guillaume moubeche\"  \"guillaume moubèche\"\n  # --- Alex Hitchens (+ side channels via identity) ---\n  \"alexhitchens\"  \"alex hitchens\"\n  # --- Julien Chieze (gaming news) ---\n  \"julienchieze\"  \"julien chieze\"\n  # --- HugoDecrypte (news, all channels) ---\n  \"youtube.com/@hugodecrypte\"  \"youtube.com/@hugodecrypteactus\"  \"youtube.com/@hugodecryptegrandsformats\"\n  \"hugodecrypte\"  \"hugo decrypte\"  \"hugo décrypte\"\n  # --- Le Crayon (news/media) ---\n  \"youtube.com/@lecrayon\"  \"le crayon\"\n  # --- La Chapelle Radio / Hugo Bentz ---\n  \"youtube.com/@la-chapelle-radio-hugo-bentz\"  \"la chapelle radio\"  \"hugo bentz\"\n  # --- Matthieu Stefani / Generation Do It Yourself ---\n  \"matthieu stefani\"  \"generation do it yourself\"  \"génération do it yourself\"  \"gdiy\"\n  # --- Pauline Laigneau ---\n  \"youtube.com/@paulinelaigneau\"  \"pauline laigneau\"\n  # --- Les Decouvreurs ---\n  \"youtube.com/@les_decouvreurs\"  \"les decouvreurs\"  \"les découvreurs\"\n  # --- Theophile Eliet (hyphen handle, handled by Normalize) ---\n  \"youtube.com/@theophile-eliet\"  \"theophile eliet\"  \"théophile eliet\"\n  # --- Le Precepteur ---\n  \"le precepteur\"  \"le précepteur\"\n  # --- My Better Self ---\n  \"mybetterself\"  \"my better self\"\n  # --- LouisSan (+ side channels: LouisSanCorp...) ---\n  \"louissan\"  \"louissancorp\"\n  # --- Business / make-money / mindset / manosphere sphere (NAMES only) ---\n  \"iman gadzhi\"  \"imangadzhi\"  \"andrew tate\"  \"tristan tate\"  \"cobratate\"\n  \"enzo honore\"  \"enzo honoré\"  \"franck nicolas\"  \"idriss aberkane\"  \"anthony bourbon\"\n  \"hasheur\"  \"owen simonin\"  \"lorenzo ferrante\"  \"mick levy\"  \"younes belghazi\"\n  \"yann darwin\"  \"yan darwin\"  \"raoul pop\"  \"david laroche\"  \"fabien 