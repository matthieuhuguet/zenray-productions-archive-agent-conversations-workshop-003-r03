{"timestamp":"2026-08-13T06:42:42.401Z","ordinal":793,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019ff9db-d861-7ad2-a820-b600f7fa8dac","call_id":"call_s1GGeBSmKUc6of6IynAoOGPe","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"\n\n# --- 3. Small helpers ------------------------------------------------------\n\nSay()      { printf '%s\\n' \"$*\"; }\nNowEpoch() { date '+%s'; }\n\n# Drop case AND separators: \"Theophile-Eliet\", \"theophile.eliet\" and\n# \"theophile eliet\" all become \"theophileeliet\". One place that removes the\n# whole family of separator bugs (hyphen vs dot vs space).\nNormalize() {\n  local s=\"${1:l}\"\n  printf '%s' \"${s//[-._ ]/}\"\n}\n\nUrlEncode() { python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1], safe=\"\"))' \"$1\"; }\nUrlDecode() { python3 -c 'import sys,urllib.parse;print(urllib.parse.unquote(sys.argv[1]))'         \"$1\"; }\n\n# Value (decoded) of query parameter $2 in the URL $1.\nExtractParam() {\n  local u=\"$1\" name=\"$2\" q pair\n  q=\"${u#*\\?}\"\n  [[ \"$q\" == \"$u\" ]] && return 0          # no '?' means no query string\n  for pair in ${(s:&:)q}; do\n    [[ \"$pair\" == \"$name=\"* ]] && { UrlDecode \"${pair#$name=}\"; return 0; }\n  done\n}\n\n# Normalized form of every entry, computed ONCE at load (not inside the loop\n# that runs many times per second), to avoid needless work.\nNORMALIZED_PATTERNS=()\nfor _p in \"${BLOCKED_PATTERNS[@]}\"; do NORMALIZED_PATTERNS+=(\"$(Normalize \"$_p\")\"); done\nunset _p\n\n# The subset the fast pass uses: entries that can appear in a URL (no spaces),\n# lowercased. Spaced names never appear in a URL, so they stay for the deep\n# pass only (matched against the yt-dlp identity).\nFAST_PATTERNS=()\nfor _p in \"${BLOCKED_PATTERNS[@]}\"; do\n  [[ \"$_p\" == *\" \"* ]] && continue\n  FAST_PATTERNS+=(\"${_p:l}\")\ndone\nunset _p\n\n\n# --- 4. Files and migration ------------------------------------------------\n\n# Rename the files from older versions (YouTube*, then SocialMediaFocus*) to\n# the current names, so we keep the local password and any running reward.\n# Idempotent: after migration the old ones are gone. Never overwrites a file\n# that already exists under the new name.\nMigrateLegacy() {\n  local old\n  for old in \"$FOCUS_DIR/.SocialMediaFocusGuardPassword\" \"$FOCUS_DIR/.YouTubeFocusGuardPassword\"; do\n    [[ -f \"$old\" && ! -f \"$SECRET_FILE\" ]] && mv \"$old\" \"$SECRET_FILE\" 2>/dev/null\n  done\n  for old in \"$FOCUS_DIR/.SocialMediaFocusGuardState\" \"$FOCUS_DIR/.YouTubeFocusGuardState\"; do\n    [[ -d \"$old\" && ! -d \"$STATE_DIR\" ]] && mv \"$old\" \"$STATE_DIR\" 2>/dev/null\n  done\n  rm -f \"$FOCUS_DIR/YouTubeBlocked.html\" 2>/dev/null\n  return 0\n}\n\nEnsureDirs() {\n  MigrateLegacy\n  mkdir -p \"$FOCUS_DIR\" \"$STATE_DIR\"\n  chmod 700 \"$STATE_DIR\" 2>/dev/null || true\n}\n\n# Create a local password on first run (Matthieu does not memorize it; the\n# assistant can read it on disk if a real unlock is ever needed).\nEnsureSecret() {\n  EnsureDirs\n  EnsureBlockPage\n  EnsureYouTubeDayBlockPage\n  if [[ ! -f \"$SECRET_FILE\" ]]; then\n    umask 077\n    /opt/homebrew/bin/openssl rand -base64 48 | tr -d '\\n' > \"$SECRET_FILE\"\n    printf '\\n' >> \"$SECRET_FILE\"\n  fi\n  chmod 600 \"$SECRET_FILE\" 2>/dev/null || true\n  if [[ \"$EUID\" -eq 0 ]]; then\n    chown \"${OWNER}:staff\" \"$SECRET_FILE\" \"$FOCUS_DIR\" \"$STATE_DIR\" 2>/dev/null || true\n  fi\n}\n\n# Barrier against the reflex for the sensitive commands (suspend/disable/uninstall).\nRequireGuardPassword() {\n  EnsureSecret\n  local expected input\n  expected=\"$(cat \"$SECRET_FILE\")\"\n  if [[ -n \"${SMG_PASSWORD:-}\" ]]; then\n    input=\"$SMG_PASSWORD\"\n  else\n    printf 'Focus password: ' >&2\n    stty -echo; IFS= read -r input; stty echo\n    printf '\\n' >&2\n  fi\n  [[ \"$input\" == \"$expected\" ]] || { Say \"Wrong focus password.\"; exit 2; }\n}\n\n\n# --- 5. On / Off -----------------------------------------------------------\n\nIsDisabled() { [[ -f \"$DISABLED_FILE\" ]]; }\n\nIsSuspended() {\n  [[ -f \"$SUSPEND_FILE\" ]] || return 1\n  local until; until=\"$(cat \"$SUSPEND_FILE\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ '^[0-9]+$' ]] || return 1\n  [[ \"$(NowEpoch)\" -lt \"$until\" ]]\n}\n\n# Active time window (default 0..24, so always).\nIsProtectedNow() {\n  local hour; hour=\"$(date '+%H')\"; hour=\"${hour#0}\"; [[ -z \"$hour\" ]] && hour=0\n  [[ \"$hour\" -ge \"$START_HOUR\" && \"$hour\" -lt \"$END_HOUR\" ]]\n}\n\n# Should we block right now? No if turned off, suspended, or out of window.\nShouldBlock() {\n  IsDisabled  && return 1\n  IsSuspended && return 1\n  IsProtectedNow\n}\n\n# Is a browser the frontmost app? The fast pass only runs then: while Matthieu\n# works in Houdini or Unreal there is no visible tab to flash, so we stay idle.\nBrowserIsFrontmost() {\n  local front\n  front=\"$(lsappinfo info -only name \"$(lsappinfo front 2>/dev/null)\" 2>/dev/null)\"\n  case \"$front\" in\n    *\"Google Chrome\"*|*Safari*|*\"Brave Browser\"*|*\"Microsoft Edge\"*|*Vivaldi*|*Opera*|*Chromium*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\n\n# --- 5b. YouTube daytime gate -----------------------------------------------\n#\n# Independent from the creator list: between YT_DAY_START_HOUR and\n<title>Blocked</title>\n<style>\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Medium.ttf\") format(\"truetype\"); font-weight:500 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Regular.ttf\") format(\"truetype\"); font-weight:400 }\n  :root { color-scheme:d