{"timestamp":"2026-08-13T06:44:59.456Z","ordinal":884,"type":"event_msg","payload":{"type":"item_completed","thread_id":"019ff46f-5a4c-7ad2-82b8-a4a81080d31d","turn_id":"019ff9db-6aa0-7492-8a52-90b74ef6cb6d","item":{"type":"FileChange","id":"exec-e826afa3-ef47-4564-bcfb-04aa1ba731f3","changes":{"/Users/zenray/Create/Build/Memory/Tools/FocusGuard/SocialMediaGuard.sh":{"type":"delete","content":"#!/bin/zsh\nset -euo pipefail\nexport PATH=\"/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin\"\n\n# ===========================================================================\n#  SOCIAL MEDIA GUARD\n#  Closes the creators (YouTube + Instagram/TikTok/X/Facebook) that Matthieu\n#  chose to stop watching. Instead of a hard block, the tab switches to a\n#  block page: one button opens the content for 15 minutes. A native floating\n#  timer stays visible over the real page and exits when the allowance ends.\n#\n#  How blocking stays fast (no visible frame of the real page):\n#    - FAST pass  (~0.1s): checks only the ACTIVE tab and redirects it inside\n#      AppleScript. Runs only while a browser is frontmost. Kills the frame.\n#    - DEEP pass  (~1s):   full sweep of every tab, resolves YouTube videos\n#      through yt-dlp, handles the reward, catches background tabs.\n#\n#  File map:\n#     1. Config              - paths, timings, browsers\n#     2. Blocked creators    - BLOCKED_PATTERNS (single editable source)\n#     3. Small helpers       - dates, text, url encoding\n#     4. Files and migration - folders, password, old names\n#     5. On / Off            - disabled, suspended, active window\n#     6. Match engine        - does this text point to a blocked creator?\n#     7. Reward (grace)      - temporary earned access, per creator\n#     8. Timer               - native bottom-right access timer\n#     9. Block page          - the HTML shown in the tab\n#    10. Browser control     - list tabs, redirect one tab\n#    11. Fast pass           - instant redirect of the active tab\n#    12. Watch loop          - the loop the background service runs\n#    13. Install             - user service (+ optional root layer)\n#    14. Commands            - status, suspend, disable/enable, uninstall\n#    15. Entry point         - command line dispatch\n#\n#  Usage: SocialMediaGuard.sh <command>\n#    install-user | status | enable | disable | suspend [min] |\n#    enforce | watch-tabs | close-tabs | uninstall-user |\n#    install-root | uninstall-root | cleanup-root\n# ===========================================================================\n\n\n# --- 1. Config -------------------------------------------------------------\n\nOWNER=\"zenray\"\nMEMORY_ROOT=\"${MEMORY_ROOT:-/Users/zenray/Create/Build/Memory}\"\nFOCUS_DIR=\"$MEMORY_ROOT/Focus\"\n\nSECRET_FILE=\"$FOCUS_DIR/.SocialMediaGuardPassword\"     # local password (git-ignored)\nSTATE_DIR=\"$FOCUS_DIR/.SocialMediaGuardState\"          # internal state (git-ignored)\nDISABLED_FILE=\"$STATE_DIR/disabled\"                    # present = guard turned off\nSUSPEND_FILE=\"$STATE_DIR/suspend_until\"                # epoch when suspension ends\nBLOCK_PAGE_FILE=\"$FOCUS_DIR/SocialMediaBlocked.html\"   # the page shown in the tab\nBLOCK_PAGE_URL=\"file://$BLOCK_PAGE_FILE\"\nILLUSTRATION_URL=\"file://$MEMORY_ROOT/ArtDirection/output_v3.png\"\n\n# YouTube daytime gate (separate from the creator list below): all of\n# youtube.com/youtu.be is closed during this window, every day. \"Ask for\n# time\" opens it immediately once for 15 minutes, then stays closed for the day.\nYT_DAY_START_HOUR=\"${SMG_YT_START_HOUR:-10}\"\nYT_DAY_END_HOUR=\"${SMG_YT_END_HOUR:-19}\"\nYT_GRANT_MINUTES=(15)             # one 15-minute allowance per day\nYT_BLOCK_PAGE_FILE=\"$FOCUS_DIR/YouTubeDaytimeBlocked.html\"\nYT_BLOCK_PAGE_URL=\"file://$YT_BLOCK_PAGE_FILE\"\nYT_DAY_FILE=\"$STATE_DIR/youtube_daytime_day\"              # YYYY-MM-DD of last reset\nYT_GRANTS_USED_FILE=\"$STATE_DIR/youtube_daytime_grants_used\"\nYT_UNTIL_FILE=\"$STATE_DIR/youtube_daytime_until\"           # epoch, current grant expiry\nACTIVE_GRANT_FILE=\"$STATE_DIR/active_grant_until\"         # epoch for native timer\nTIMER_SOURCE=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuardTimer.swift\"\nTIMER_BIN=\"$STATE_DIR/SocialMediaGuardTimer\"\n\n# The creator allowance is intentionally fixed. There is no second countdown.\nREWARD_MINUTES=15\nSTART_HOUR=\"${SMG_START_HOUR:-0}\"           # active window: 0..24 = always on\nEND_HOUR=\"${SMG_END_HOUR:-24}\"\nFAST_SLEEP=\"${SMG_FAST_SLEEP:-0.1}\"         # active-tab poll interval (seconds)\nDEEP_EVERY=\"${SMG_DEEP_EVERY:-10}\"          # deep sweep once every N fast passes\n\n# Background service (LaunchAgent).\nUSER_LABEL=\"com.zenray.social-media-guard.tabs\"\nROOT_LABEL=\"com.zenray.social-media-guard\"\nUSER_PLIST=\"$HOME/Library/LaunchAgents/$USER_LABEL.plist\"\nROOT_PLIST=\"/Library/LaunchDaemons/$ROOT_LABEL.plist\"\nSCRIPT_PATH=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuard.sh\"\nUSER_LOG=\"$HOME/Library/Logs/SocialMediaGuard.tabs.log\"\nUSER_ERR_LOG=\"$HOME/Library/Logs/SocialMediaGuard.tabs.err.log\"\n\n# Optional root layer (hosts + Chrome policy). Inactive without sudo.\nHOSTS_FILE=\"/etc/hosts\"\nHOSTS_MARK_START=\"# ZENRAY_SOCIAL_MEDIA_GUARD_START\"\nHOSTS_MARK_END=\"# ZENRAY_SOCIAL_MEDIA_GUARD_END\"\nCHROME_POLICY_FILE=\"/Library/Managed Preferences/com.google.Chrome.plist\"\nCHROME_POLICY_BACKUP=\"$STATE_DIR/com.google.Chrome.plist.before-guard\"\nCHROME_POLICY_MARKER=\"$STATE_DIR/chrome_policy_backup_state\"\nHOST_DOMAINS=()\nCHROME_BLOCKLIST=()\n\n# Browsers we drive. Every Chromium shares Google Chrome's tab vocabulary\n# (\"using terms from\"); Safari has its own.\nCHROMIUM_BROWSERS=(\n  \"Google Chrome\" \"Google Chrome Beta\" \"Google Chrome Canary\" \"Chromium\"\n  \"Brave Browser\" \"Brave Browser Beta\" \"Microsoft Edge\" \"Microsoft Edge Beta\"\n  \"Vivaldi\" \"Opera\" \"Opera GX\"\n)\n\n\n# --- 2. Blocked creators (single source of truth) --------------------------\n#\n# Each entry is matched as a substring, case-insensitive and separator-\n# insensitive (see Normalize), against two things:\n#   1) the tab URL (any network) - blocks YouTube, Instagram, TikTok,\n#      Facebook and X as soon as the entry is the account handle;\n#   2) the identity yt-dlp returns for a /watch page (channel name, uploader)\n#      - catches every video and side channel of a creator, even without\n#      knowing their exact handle.\n# Safety: an entry that matches nothing blocks nothing (harmless miss). So we\n# can be broad on NAMES and stay precise (joined handle or URL) to never block\n# a third party by accident.\n#\n# A few entries keep accents on purpose: they are real creator names, and a\n# channel identity like \"HugoDecrypte\" written with the accent is only caught\n# by the accented form.\n\nBLOCKED_PATTERNS=(\n  # --- Ici Japon ---\n  \"youtube.com/@icijaponcorp\"  \"youtube.com/channel/uct11zynefnunokgcrso9uyg\"  \"ici japon\"\n  # --- Silicon Carne / Carlos Diaz ---\n  \"youtube.com/@siliconcarnepod\"  \"siliconcarne\"  \"silicon carne\"  \"carlosdiaz\"  \"carlos diaz\"\n  # --- Oussama Ammar ---\n  \"youtube.com/@oussamaammaroff\"  \"youtube.com/channel/ucxh-b8b2sx4kgshsvj3ngza\"\n  \"oussamaammaroff\"  \"oussamaammar\"  \"oussama ammar\"\n  # --- Yomi Denzel ---\n  \"youtube.com/@yomidenzel\"  \"youtube.com/yomidenzel\"  \"youtube.com/channel/uchge6r4qaugajalyijoccgw\"\n  \"yomidenzel\"  \"yomi.denzel\"  \"yomi denzel\"\n  # --- Antoine Blanco (+ business channel) ---\n  \"youtube.com/@antoineblanco\"  \"youtube.com/@antoineblanco99\"  \"youtube.com/@antoineblancobusiness\"\n  \"youtube.com/channel/uc0kcckhmqfiguifkqco-iya\"  \"antoineblanco\"  \"antoine blanco\"\n  # --- Sixtine Moulle-Berteaux ---\n  \"youtube.com/@sixtinemoulleberteaux\"  \"sixtinemoulleberteaux\"  \"sixtine.moulleberteaux\"\n  \"sixtine moulle\"  \"sixtine moulle-berteaux\"\n  # --- Wallerand Moulle-Berteaux ---\n  \"wallerandmoulleberteaux\"  \"wallerand.moulleberteaux\"  \"wallerand moulle\"  \"wallerand moulle-berteaux\"\n  # --- Eric Larcheveque ---\n  \"ericlarcheveque\"  \"eric larcheveque\"  \"eric l'archeveque\"  \"eric larchevêque\"\n  # --- Guillaume Moubeche ---\n  \"guillaumemoubeche\"  \"guillaume moubeche\"  \"guillaume moubèche\"\n  # --- Alex Hitchens (+ side channels via identity) ---\n  \"alexhitchens\"  \"alex hitchens\"\n  # --- Julien Chieze (gaming news) ---\n  \"julienchieze\"  \"julien chieze\"\n  # --- HugoDecrypte (news, all channels) ---\n  \"youtube.com/@hugodecrypte\"  \"youtube.com/@hugodecrypteactus\"  \"youtube.com/@hugodecryptegrandsformats\"\n  \"hugodecrypte\"  \"hugo decrypte\"  \"hugo décrypte\"\n  # --- Le Crayon (news/media) ---\n  \"youtube.com/@lecrayon\"  \"le crayon\"\n  # --- La Chapelle Radio / Hugo Bentz ---\n  \"youtube.com/@la-chapelle-radio-hugo-bentz\"  \"la chapelle radio\"  \"hugo bentz\"\n  # --- Matthieu Stefani / Generation Do It Yourself ---\n  \"matthieu stefani\"  \"generation do it yourself\"  \"génération do it yourself\"  \"gdiy\"\n  # --- Pauline Laigneau ---\n  \"youtube.com/@paulinelaigneau\"  \"pauline laigneau\"\n  # --- Les Decouvreurs ---\n  \"youtube.com/@les_decouvreurs\"  \"les decouvreurs\"  \"les découvreurs\"\n  # --- Theophile Eliet (hyphen handle, handled by Normalize) ---\n  \"youtube.com/@theophile-eliet\"  \"theophile eliet\"  \"théophile eliet\"\n  # --- Le Precepteur ---\n  \"le precepteur\"  \"le précepteur\"\n  # --- My Better Self ---\n  \"mybetterself\"  \"my better self\"\n  # --- LouisSan (+ side channels: LouisSanCorp...) ---\n  \"louissan\"  \"louissancorp\"\n  # --- Business / make-money / mindset / manosphere sphere (NAMES only) ---\n  \"iman gadzhi\"  \"imangadzhi\"  \"andrew tate\"  \"tristan tate\"  \"cobratate\"\n  \"enzo honore\"  \"enzo honoré\"  \"franck nicolas\"  \"idriss aberkane\"  \"anthony bourbon\"\n  \"hasheur\"  \"owen simonin\"  \"lorenzo ferrante\"  \"mick levy\"  \"younes belghazi\"\n  \"yann darwin\"  \"yan darwin\"  \"raoul pop\"  \"david laroche\"  \"fabien snauwaert\"\n  \"romain pichon\"  \"tugan bara\"  \"tugan.baranovsky\"  \"morgan prevel\"  \"morgan prével\"\n  \"valentin decker\"  \"jean riviere\"  \"jean rivière\"  \"jeremy kohlmann\"  \"aurelien amacker\"  \"aurélien amacker\"\n  \"squeezie\"  \"naval ravikant\"  \"navalravikant\"  \"laurent alexandre\"  \"alexandre cicoupoulos\"\n)\n\n\n# --- 3. Small helpers ------------------------------------------------------\n\nSay()      { printf '%s\\n' \"$*\"; }\nNowEpoch() { date '+%s'; }\n\n# Drop case AND separators: \"Theophile-Eliet\", \"theophile.eliet\" and\n# \"theophile eliet\" all become \"theophileeliet\". One place that removes the\n# whole family of separator bugs (hyphen vs dot vs space).\nNormalize() {\n  local s=\"${1:l}\"\n  printf '%s' \"${s//[-._ ]/}\"\n}\n\nUrlEncode() { python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1], safe=\"\"))' \"$1\"; }\nUrlDecode() { python3 -c 'import sys,urllib.parse;print(urllib.parse.unquote(sys.argv[1]))'         \"$1\"; }\n\n# Value (decoded) of query parameter $2 in the URL $1.\nExtractParam() {\n  local u=\"$1\" name=\"$2\" q pair\n  q=\"${u#*\\?}\"\n  [[ \"$q\" == \"$u\" ]] && return 0          # no '?' means no query string\n  for pair in ${(s:&:)q}; do\n    [[ \"$pair\" == \"$name=\"* ]] && { UrlDecode \"${pair#$name=}\"; return 0; }\n  done\n}\n\n# Normalized form of every entry, computed ONCE at load (not inside the loop\n# that runs many times per second), to avoid needless work.\nNORMALIZED_PATTERNS=()\nfor _p in \"${BLOCKED_PATTERNS[@]}\"; do NORMALIZED_PATTERNS+=(\"$(Normalize \"$_p\")\"); done\nunset _p\n\n# The subset the fast pass uses: entries that can appear in a URL (no spaces),\n# lowercased. Spaced names never appear in a URL, so they stay for the deep\n# pass only (matched against the yt-dlp identity).\nFAST_PATTERNS=()\nfor _p in \"${BLOCKED_PATTERNS[@]}\"; do\n  [[ \"$_p\" == *\" \"* ]] && continue\n  FAST_PATTERNS+=(\"${_p:l}\")\ndone\nunset _p\n\n\n# --- 4. Files and migration ------------------------------------------------\n\n# Rename the files from older versions (YouTube*, then SocialMediaFocus*) to\n# the current names, so we keep the local password and any running reward.\n# Idempotent: after migration the old ones are gone. Never overwrites a file\n# that already exists under the new name.\nMigrateLegacy() {\n  local old\n  for old in \"$FOCUS_DIR/.SocialMediaFocusGuardPassword\" \"$FOCUS_DIR/.YouTubeFocusGuardPassword\"; do\n    [[ -f \"$old\" && ! -f \"$SECRET_FILE\" ]] && mv \"$old\" \"$SECRET_FILE\" 2>/dev/null\n  done\n  for old in \"$FOCUS_DIR/.SocialMediaFocusGuardState\" \"$FOCUS_DIR/.YouTubeFocusGuardState\"; do\n    [[ -d \"$old\" && ! -d \"$STATE_DIR\" ]] && mv \"$old\" \"$STATE_DIR\" 2>/dev/null\n  done\n  rm -f \"$FOCUS_DIR/YouTubeBlocked.html\" 2>/dev/null\n  return 0\n}\n\nEnsureDirs() {\n  MigrateLegacy\n  mkdir -p \"$FOCUS_DIR\" \"$STATE_DIR\"\n  chmod 700 \"$STATE_DIR\" 2>/dev/null || true\n}\n\n# Create a local password on first run (Matthieu does not memorize it; the\n# assistant can read it on disk if a real unlock is ever needed).\nEnsureSecret() {\n  EnsureDirs\n  EnsureBlockPage\n  EnsureYouTubeDayBlockPage\n  if [[ ! -f \"$SECRET_FILE\" ]]; then\n    umask 077\n    /opt/homebrew/bin/openssl rand -base64 48 | tr -d '\\n' > \"$SECRET_FILE\"\n    printf '\\n' >> \"$SECRET_FILE\"\n  fi\n  chmod 600 \"$SECRET_FILE\" 2>/dev/null || true\n  if [[ \"$EUID\" -eq 0 ]]; then\n    chown \"${OWNER}:staff\" \"$SECRET_FILE\" \"$FOCUS_DIR\" \"$STATE_DIR\" 2>/dev/null || true\n  fi\n}\n\n# Barrier against the reflex for the sensitive commands (suspend/disable/uninstall).\nRequireGuardPassword() {\n  EnsureSecret\n  local expected input\n  expected=\"$(cat \"$SECRET_FILE\")\"\n  if [[ -n \"${SMG_PASSWORD:-}\" ]]; then\n    input=\"$SMG_PASSWORD\"\n  else\n    printf 'Focus password: ' >&2\n    stty -echo; IFS= read -r input; stty echo\n    printf '\\n' >&2\n  fi\n  [[ \"$input\" == \"$expected\" ]] || { Say \"Wrong focus password.\"; exit 2; }\n}\n\n\n# --- 5. On / Off -----------------------------------------------------------\n\nIsDisabled() { [[ -f \"$DISABLED_FILE\" ]]; }\n\nIsSuspended() {\n  [[ -f \"$SUSPEND_FILE\" ]] || return 1\n  local until; until=\"$(cat \"$SUSPEND_FILE\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ '^[0-9]+$' ]] || return 1\n  [[ \"$(NowEpoch)\" -lt \"$until\" ]]\n}\n\n# Active time window (default 0..24, so always).\nIsProtectedNow() {\n  local hour; hour=\"$(date '+%H')\"; hour=\"${hour#0}\"; [[ -z \"$hour\" ]] && hour=0\n  [[ \"$hour\" -ge \"$START_HOUR\" && \"$hour\" -lt \"$END_HOUR\" ]]\n}\n\n# Should we block right now? No if turned off, suspended, or out of window.\nShouldBlock() {\n  IsDisabled  && return 1\n  IsSuspended && return 1\n  IsProtectedNow\n}\n\n# Is a browser the frontmost app? The fast pass only runs then: while Matthieu\n# works in Houdini or Unreal there is no visible tab to flash, so we stay idle.\nBrowserIsFrontmost() {\n  local front\n  front=\"$(lsappinfo info -only name \"$(lsappinfo front 2>/dev/null)\" 2>/dev/null)\"\n  case \"$front\" in\n    *\"Google Chrome\"*|*Safari*|*\"Brave Browser\"*|*\"Microsoft Edge\"*|*Vivaldi*|*Opera*|*Chromium*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\n\n# --- 5b. YouTube daytime gate -----------------------------------------------\n#\n# Independent from the creator list: between YT_DAY_START_HOUR and\n# YT_DAY_END_HOUR, every youtube.com/youtu.be tab is closed by default.\n# \"Ask for time\" grants access immediately (no wait), for the only value in\n# YT_GRANT_MINUTES. Once that allowance is spent, YouTube stays closed until\n# the next day.\n\nEnsureYouTubeDayState() {\n  EnsureDirs\n  local today; today=\"$(date '+%Y-%m-%d')\"\n  if [[ \"$(cat \"$YT_DAY_FILE\" 2>/dev/null || true)\" != \"$today\" ]]; then\n    printf '%s\\n' \"$today\" > \"$YT_DAY_FILE\"\n    printf '0\\n' > \"$YT_GRANTS_USED_FILE\"\n    printf '0\\n' > \"$YT_UNTIL_FILE\"\n  fi\n  [[ -f \"$YT_GRANTS_USED_FILE\" ]] || printf '0\\n' > \"$YT_GRANTS_USED_FILE\"\n  [[ -f \"$YT_UNTIL_FILE\" ]] || printf '0\\n' > \"$YT_UNTIL_FILE\"\n}\n\nIsYouTubeDayWindow() {\n  local hour; hour=\"$(date '+%H')\"; hour=\"${hour#0}\"; [[ -z \"$hour\" ]] && hour=0\n  [[ \"$hour\" -ge \"$YT_DAY_START_HOUR\" && \"$hour\" -lt \"$YT_DAY_END_HOUR\" ]]\n}\n\nYouTubeGrantsUsedToday() {\n  EnsureYouTubeDayState\n  cat \"$YT_GRANTS_USED_FILE\" 2>/dev/null || printf '0'\n}\n\n# Minutes the NEXT \"Ask for time\" click would grant; 0 once spent for today.\nNextYouTubeGrantMinutes() {\n  local used; used=\"$(YouTubeGrantsUsedToday)\"\n  [[ \"$used\" =~ ^[0-9]+$ ]] || used=0\n  if (( used < ${#YT_GRANT_MINUTES[@]} )); then\n    printf '%s\\n' \"${YT_GRANT_MINUTES[used+1]}\"\n  else\n    printf '0\\n'\n  fi\n}\n\nYouTubeAccessGranted() {\n  EnsureYouTubeDayState\n  local until; until=\"$(cat \"$YT_UNTIL_FILE\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ ^[0-9]+$ ]] || return 1\n  [[ \"$(NowEpoch)\" -lt \"$until\" ]]\n}\n\n# Should the daytime YouTube gate fire right now?\nShouldBlockYouTubeDay() {\n  IsDisabled  && return 1\n  IsSuspended && return 1\n  EnsureYouTubeDayState\n  IsYouTubeDayWindow || return 1\n  YouTubeAccessGranted && return 1\n  return 0\n}\n\n# Consumes the next rung of the ladder and opens access for that many\n# minutes. Returns non-zero if the ladder is already spent for today.\nGrantYouTubeTime() {\n  EnsureYouTubeDayState\n  local minutes; minutes=\"$(NextYouTubeGrantMinutes)\"\n  [[ \"$minutes\" -gt 0 ]] || return 1\n  local used; used=\"$(YouTubeGrantsUsedToday)\"\n  local until; until=\"$(( $(NowEpoch) + minutes * 60 ))\"\n  printf '%s\\n' \"$(( used + 1 ))\" > \"$YT_GRANTS_USED_FILE\"\n  printf '%s\\n' \"$until\" > \"$YT_UNTIL_FILE\"\n  StartGrantTimer \"$until\"\n  return 0\n}\n\nYouTubeGateUrlFor() {\n  printf '%s?u=%s&remaining=%s' \"$YT_BLOCK_PAGE_URL\" \"$(UrlEncode \"$1\")\" \"$(NextYouTubeGrantMinutes)\"\n}\n\n# The block page. Same visual language as the creator block page. The button\n# label and remaining minutes come from the \"remaining\" query param so the\n# page never needs regenerating between grants.\nEnsureYouTubeDayBlockPage() {\n  EnsureDirs\n  local F=\"/Users/zenray/Library/Fonts\"\n  cat > \"$YT_BLOCK_PAGE_FILE\" <<HTML\n<!doctype html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>YouTube bloqué</title>\n<style>\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Medium.ttf\") format(\"truetype\"); font-weight:500 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Regular.ttf\") format(\"truetype\"); font-weight:400 }\n  :root { color-scheme:dark }\n  * { box-sizing:border-box }\n  body {\n    margin:0; min-height:100vh; display:grid; place-items:center;\n    background:#242424; color:#f2f2f2;\n    font-family:\"AnthropicSans\", system-ui, sans-serif; font-weight:300;\n  }\n  main { width:min(1500px, calc(100vw - 48px)); text-align:center }\n  .art { display:block; width:min(640px, calc(100vw - 120px)); margin:0 auto 34px;\n         border-radius:8px; box-shadow:0 16px 48px rgba(0,0,0,.28) }\n  .eyebrow { font-weight:500; font-size:13px; letter-spacing:.14em; text-transform:uppercase;\n             color:#cc7c5e; margin:0 0 18px }\n  .head { font-family:\"AnthropicSerif\", serif; font-weight:300;\n          font-size:clamp(30px, 4vw, 52px); line-height:1.2; color:#f4f4f4; margin:0 }\n  .cap { font-size:15px; color:#8c857d; margin:14px 0 0 }\n  .num { font-family:\"AnthropicSerif\", serif }\n  .btn { display:inline-block; margin-top:26px; padding:14px 32px; border-radius:999px;\n         background:#f2f2f2; color:#242424; text-decoration:none; font-weight:500 }\n</style>\n</head>\n<body>\n<main>\n  <img class=\"art\" src=\"$ILLUSTRATION_URL\" alt=\"\">\n  <p class=\"eyebrow\">YouTube en journée</p>\n  <p class=\"head\" id=\"headline\">YouTube est bloqué en journée.<br>Remets-toi au travail.</p>\n  <div id=\"askBox\"></div>\n</main>\n<script>\n(function () {\n  var p = new URLSearchParams(location.search);\n  var target = p.get('u') || 'https://www.youtube.com';\n  var remaining = parseInt(p.get('remaining') || '0', 10) || 0;\n  var box = document.getElementById('askBox');\n  if (remaining > 0) {\n    var href = location.pathname + '?u=' + encodeURIComponent(target) +\n               '&remaining=' + remaining + '&askfortime=1';\n    box.innerHTML = '<a class=\"btn\" href=\"' + href + '\">Ask for time (+<span class=\"num\">' +\n      remaining + '</span> min)</a><p class=\"cap\">Prochain palier : <span class=\"num\">' +\n      remaining + '</span> minute(s).</p>';\n  } else {\n    document.getElementById('headline').textContent = 'Temps écoulé.';\n    box.innerHTML = '<p class=\"cap\">YouTube est fini pour aujourd\\\\'hui.</p>';\n  }\n})();\n</script>\n</body>\n</html>\nHTML\n  chmod 644 \"$YT_BLOCK_PAGE_FILE\" 2>/dev/null || true\n}\n\n\n# --- 6. Match engine: does this text point to a blocked creator? -----------\n\n# One elementary test, raw form OR normalized form. GrantGrace and\n# TextMatchesBlocked both use it: they MUST agree on \"which entries this text\n# triggers\", otherwise a granted reward would miss an entry that only matches\n# after normalization (e.g. \"silicon carne\" with a space) and re-block right\n# away despite the earned reward.\nPatternMatches() {\n  local lpattern=\"$1\" npattern=\"$2\" text=\"$3\" ntext=\"$4\"\n  [[ \"$text\" == *\"$lpattern\"* ]] && return 0\n  [[ -n \"$npattern\" && \"$ntext\" == *\"$npattern\"* ]] && return 0\n  return 1\n}\n\n# True if the text (a URL or a yt-dlp identity) names a blocked creator AND is\n# not currently covered by a reward.\nTextMatchesBlocked() {\n  local raw=\"$1\" text=\"${1:l}\" ntext anyGrace=0 i n\n  local -a graceFiles\n  ntext=\"$(Normalize \"$raw\")\"\n  graceFiles=(\"$STATE_DIR\"/grace_*.until(N))\n  (( ${#graceFiles[@]} > 0 )) && anyGrace=1\n  n=${#BLOCKED_PATTERNS[@]}\n  for (( i = 1; i <= n; i++ )); do\n    if PatternMatches \"${BLOCKED_PATTERNS[i]:l}\" \"${NORMALIZED_PATTERNS[i]}\" \"$text\" \"$ntext\"; then\n      if (( anyGrace )) && PatternIsGraced \"${BLOCKED_PATTERNS[i]}\"; then continue; fi\n      return 0\n    fi\n  done\n  return 1\n}\n\n# YouTube pages whose real channel yt-dlp can resolve (a video URL does not\n# always carry the handle).\nIsResolvableYouTubeUrl() {\n  local url=\"${1:l}\"\n  case \"$url\" in\n    *youtube.com/watch\\?*|*youtube.com/shorts/*|*youtube.com/live/*|*youtube.com/post/*|*youtu.be/*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\n# The real identity behind a YouTube URL: first a direct test on the URL\n# (handle visible), otherwise ask yt-dlp (channel name, uploader...), cached\n# so we do not repeat the network call on every pass.\nYouTubeIdentityForUrl() {\n  local url=\"$1\"\n  TextMatchesBlocked \"$url\" && { printf '%s\\n' \"$url\"; return 0; }\n  IsResolvableYouTubeUrl \"$url\" || return 1\n\n  local ytdlp cacheDir cache json identity\n  ytdlp=\"$(command -v yt-dlp 2>/dev/null || true)\"\n  [[ -n \"$ytdlp\" ]] || return 1\n\n  cacheDir=\"$STATE_DIR/youtube-identity-cache\"; mkdir -p \"$cacheDir\"\n  cache=\"$cacheDir/$(printf '%s' \"$url\" | shasum -a 256 | awk '{print $1}').txt\"\n  [[ -s \"$cache\" ]] && { cat \"$cache\"; return 0; }\n\n  json=\"$(\"$ytdlp\" --dump-single-json --no-playlist --skip-download \\\n    --socket-timeout 4 --extractor-retries 1 --retries 1 \"$url\" 2>/dev/null || true)\"\n  identity=\"$(printf '%s' \"$json\" | jq -r '\n    [ .channel, .uploader, .channel_id, .uploader_id, .channel_url,\n      .uploader_url, .creator, .webpage_url, .original_url ]\n    | map(select(type == \"string\" and length > 0)) | join(\" \")' 2>/dev/null || true)\"\n\n  [[ -n \"$identity\" ]] && printf '%s\\n' \"$identity\" > \"$cache\"\n  printf '%s\\n' \"$identity\"\n}\n\n\n# --- 7. Reward (grace): temporary earned access, per creator ---------------\n\nCompileTimer() {\n  EnsureDirs\n  command -v swiftc >/dev/null 2>&1 || return 1\n  swiftc -O \"$TIMER_SOURCE\" -o \"$TIMER_BIN\"\n  chmod 700 \"$TIMER_BIN\" 2>/dev/null || true\n}\n\nStartGrantTimer() {\n  EnsureDirs\n  if [[ ! -x \"$TIMER_BIN\" || \"$TIMER_SOURCE\" -nt \"$TIMER_BIN\" ]]; then\n    CompileTimer || return 0\n  fi\n  printf '%s\\n' \"$1\" > \"$ACTIVE_GRANT_FILE\"\n  pkill -x SocialMediaGuardTimer >/dev/null 2>&1 || true\n  \"$TIMER_BIN\" \"$ACTIVE_GRANT_FILE\" >/dev/null 2>&1 &\n}\n\nStopGrantTimer() {\n  pkill -x SocialMediaGuardTimer >/dev/null 2>&1 || true\n  rm -f \"$ACTIVE_GRANT_FILE\"\n}\n\n# Path of a pattern's reward marker (a safe file name, no shasum fork).\nGraceFileFor() {\n  printf '%s/grace_%s.until' \"$STATE_DIR\" \"$(printf '%s' \"${1:l}\" | tr -c 'a-z0-9' '_')\"\n}\n\n# True if this pattern has a reward that is still valid.\nPatternIsGraced() {\n  local f until; f=\"$(GraceFileFor \"$1\")\"\n  [[ -f \"$f\" ]] || return 1\n  until=\"$(cat \"$f\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ ^[0-9]+$ ]] || return 1\n  [[ \"$(NowEpoch)\" -lt \"$until\" ]]\n}\n\nTargetHasActiveGrace() {\n  local target=\"$1\" ltarget nltarget i n\n  ltarget=\"${target:l}\"; nltarget=\"$(Normalize \"$target\")\"\n  n=${#BLOCKED_PATTERNS[@]}\n  for (( i = 1; i <= n; i++ )); do\n    if PatternMatches \"${BLOCKED_PATTERNS[i]:l}\" \"${NORMALIZED_PATTERNS[i]}\" \"$ltarget\" \"$nltarget\" \\\n      && PatternIsGraced \"${BLOCKED_PATTERNS[i]}\"; then\n      return 0\n    fi\n  done\n  return 1\n}\n\n# Grant REWARD_MINUTES to every entry the target URL triggers, and only those:\n# earning access to one creator never unblocks the others.\nGrantGrace() {\n  local target=\"$1\" ltarget nltarget until i n\n  ltarget=\"${target:l}\"; nltarget=\"$(Normalize \"$target\")\"\n  until=\"$(( $(NowEpoch) + REWARD_MINUTES * 60 ))\"\n  EnsureDirs\n  n=${#BLOCKED_PATTERNS[@]}\n  for (( i = 1; i <= n; i++ )); do\n    if PatternMatches \"${BLOCKED_PATTERNS[i]:l}\" \"${NORMALIZED_PATTERNS[i]}\" \"$ltarget\" \"$nltarget\"; then\n      printf '%s\\n' \"$until\" > \"$(GraceFileFor \"${BLOCKED_PATTERNS[i]}\")\"\n    fi\n  done\n  StartGrantTimer \"$until\"\n}\n\n# The block-page URL for a target, timestamped (lets the page recompute the\n# time left even after the tab is reloaded).\nGateUrlFor() {\n  printf '%s?u=%s&t=%s' \"$BLOCK_PAGE_URL\" \"$(UrlEncode \"$1\")\" \"$(NowEpoch)\"\n}\n\n\n# --- 9. Block page (the HTML shown in the tab) -----------------------------\n# English, plain tone. The real-page timer is native, not part of this page.\n\nEnsureBlockPage() {\n  EnsureDirs\n  local F=\"/Users/zenray/Library/Fonts\"\n  cat > \"$BLOCK_PAGE_FILE\" <<HTML\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Blocked</title>\n<style>\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Medium.ttf\") format(\"truetype\"); font-weight:500 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Regular.ttf\") format(\"truetype\"); font-weight:400 }\n  :root { color-scheme:dark }\n  * { box-sizing:border-box }\n  body {\n    margin:0; min-height:100vh; display:grid; place-items:center;\n    background:#242424; color:#f2f2f2;\n    font-family:\"AnthropicSans\", system-ui, sans-serif; font-weight:300;\n  }\n  main { width:min(760px, calc(100vw - 48px)); text-align:center;\n         padding:56px 48px; border-radius:22px; background:#292929;\n         box-shadow:0 24px 80px rgba(0,0,0,.24) }\n  .art { display:block; width:min(640px, calc(100vw - 120px)); margin:0 auto 34px;\n         border-radius:8px; box-shadow:0 16px 48px rgba(0,0,0,.28) }\n  .eyebrow { font-weight:500; font-size:13px; letter-spacing:.14em; text-transform:uppercase;\n             color:#cc7c5e; margin:0 0 18px }\n  .head { font-family:\"AnthropicSerif\", serif; font-weight:300;\n          font-size:clamp(30px, 4vw, 52px); line-height:1.12; color:#efefef; margin:0 }\n  .num { font-family:\"AnthropicSerif\", serif }\n  .cap { font-size:15px; color:#8c857d; margin:14px 0 0 }\n  .btn { display:inline-block; margin-top:22px; padding:14px 32px; border-radius:999px;\n         background:#f2f2f2; color:#242424; text-decoration:none; font-weight:500 }\n</style>\n</head>\n<body>\n<main>\n  <img class=\"art\" src=\"$ILLUSTRATION_URL\" alt=\"\">\n  <p class=\"eyebrow\">Social media guard</p>\n  <p class=\"head\">This page is blocked.</p>\n  <a id=\"rewardLink\" class=\"btn\" href=\"#\">Open for 15 minutes</a>\n  <p class=\"cap\">A timer stays visible in the bottom-right corner and closes access automatically.</p>\n</main>\n<script>\n(function () {\n  var p = new URLSearchParams(location.search);\n  var target = p.get('u') || '';\n  var startedSec = parseInt(p.get('t') || '0', 10) || 0;\n  if (!target || !startedSec) return;\n  document.getElementById('rewardLink').href =\n    location.pathname + '?u=' + encodeURIComponent(target) + '&t=' + startedSec + '&unlock=1';\n})();\n</script>\n</body>\n</html>\nHTML\n  chmod 644 \"$BLOCK_PAGE_FILE\" 2>/dev/null || true\n}\n\n\n# --- 9. Browser control ----------------------------------------------------\n\n# List open tabs as \"browser<TAB>window<TAB>tab<TAB>url\" per line. One osascript\n# per RUNNING browser (pgrep), so we never name an app that is not installed\n# (which would pop a blocking \"Where is X?\" dialog), and a browser that fails\n# does not stop us from reading the others.\nListBrowserTabs() {\n  local b\n  for b in \"${CHROMIUM_BROWSERS[@]}\"; do\n    pgrep -x \"$b\" >/dev/null 2>&1 || continue\n    osascript <<APPLESCRIPT 2>/dev/null || true\nset Output to \"\"\nset T to ASCII character 9\nusing terms from application \"Google Chrome\"\n  tell application \"$b\"\n    repeat with W from 1 to (count of windows)\n      repeat with I from 1 to (count of tabs of window W)\n        try\n          set Output to Output & \"$b\" & T & W & T & I & T & (URL of tab I of window W as text) & linefeed\n        end try\n      end repeat\n    end repeat\n  end tell\nend using terms from\nreturn Output\nAPPLESCRIPT\n  done\n  if pgrep -x \"Safari\" >/dev/null 2>&1; then\n    osascript <<'APPLESCRIPT' 2>/dev/null || true\nset Output to \"\"\nset T to ASCII character 9\ntell application \"Safari\"\n  repeat with W from 1 to (count of windows)\n    repeat with I from 1 to (count of tabs of window W)\n      try\n        set Output to Output & \"Safari\" & T & W & T & I & T & (URL of tab I of window W as text) & linefeed\n      end try\n    end repeat\n  end repeat\nend tell\nreturn Output\nAPPLESCRIPT\n  fi\n}\n\n# Change one specific tab's URL (to the block page, or to the real content when\n# a reward is granted). Chromium through \"using terms from\", Safari natively.\nRedirectBrowserTab() {\n  local browser=\"$1\" windowIndex=\"$2\" tabIndex=\"$3\" destUrl=\"$4\"\n  osascript - \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$destUrl\" <<'APPLESCRIPT' >/dev/null 2>&1 || true\non run argv\n  set BrowserName to item 1 of argv\n  set W to (item 2 of argv) as integer\n  set I to (item 3 of argv) as integer\n  set DestUrl to item 4 of argv\n  if BrowserName is \"Safari\" then\n    tell application \"Safari\" to set URL of tab I of window W to DestUrl\n  else\n    using terms from application \"Google Chrome\"\n      tell application BrowserName to set URL of tab I of window W to DestUrl\n    end using terms from\n  end if\nend run\nAPPLESCRIPT\n}\n\n# Decide and act for ONE tab (deep pass):\n#  - already on the block page with unlock=1 (button clicked)\n#    -> grant the 15-minute allowance and open the real content;\n#  - on a social network pointing at a blocked creator -> switch to the block\n#    page (with the target and a request timestamp).\nHandleTab() {\n  local browser=\"$1\" windowIndex=\"$2\" tabIndex=\"$3\" url=\"$4\"\n\n  # YouTube daytime gate page: a click on \"Ask for time\" carries askfortime=1.\n  if [[ \"$url\" == \"$YT_BLOCK_PAGE_URL\"* ]]; then\n    [[ \"$url\" == *\"askfortime=1\"* ]] || return 0\n    local ytTarget; ytTarget=\"$(ExtractParam \"$url\" u)\"\n    [[ -n \"$ytTarget\" ]] || ytTarget=\"https://www.youtube.com\"\n    if GrantYouTubeTime; then\n      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$ytTarget\"\n    else\n      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(YouTubeGateUrlFor \"$ytTarget\")\"\n    fi\n    return 0\n  fi\n\n  if [[ \"$url\" == \"$BLOCK_PAGE_URL\"* ]]; then\n    [[ \"$url\" == *\"unlock=1\"* ]] || return 0\n    local target startedAt\n    target=\"$(ExtractParam \"$url\" u)\"\n    startedAt=\"$(ExtractParam \"$url\" t)\"\n    [[ -n \"$target\" && \"$startedAt\" =~ ^[0-9]+$ ]] || return 0\n    if TargetHasActiveGrace \"$target\"; then\n      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$target\"\n    else\n      GrantGrace \"$target\"\n      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$target\"\n    fi\n    return 0\n  fi\n\n  local lurl=\"${url:l}\"\n  case \"$lurl\" in\n    *youtube.com*|*youtu.be*|*instagram.com*|*tiktok.com*|*facebook.com*|*fb.watch*|*twitter.com*|*x.com*) ;;\n    *) return 0 ;;\n  esac\n\n  local identity=\"$url\"\n  if [[ \"$lurl\" == *youtube.com* || \"$lurl\" == *youtu.be* ]]; then\n    identity=\"$(YouTubeIdentityForUrl \"$url\" || true)\"\n    [[ -n \"$identity\" ]] || identity=\"$url\"\n  fi\n\n  if TextMatchesBlocked \"$identity\"; then\n    RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(GateUrlFor \"$url\")\"\n    return 0\n  fi\n\n  # Not a specific blocked creator: still subject to the daytime YouTube gate.\n  if [[ \"$lurl\" == *youtube.com* || \"$lurl\" == *youtu.be* ]] && ShouldBlockYouTubeDay; then\n    RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(YouTubeGateUrlFor \"$url\")\"\n  fi\n}\n\n# One full sweep over every tab of every running browser (deep pass).\nEnforceTabs() {\n  local browser windowIndex tabIndex url\n  while IFS=$'\\t' read -r browser windowIndex tabIndex url; do\n    [[ -n \"$browser\" && -n \"$windowIndex\" && -n \"$tabIndex\" && -n \"$url\" ]] || continue\n    HandleTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$url\"\n  done < <(ListBrowserTabs)\n}\n\n\n# --- 10. Fast pass: instant redirect of the active tab ---------------------\n\n# The AppleScript \"if URL contains ...\" lines, built from FAST_PATTERNS minus\n# any pattern that currently has a reward. Rebuilt each fast pass; cheap\n# because there is usually no reward in flight.\nBuildFastClauses() {\n  local p anyGrace=0\n  local -a graceFiles\n  graceFiles=(\"$STATE_DIR\"/grace_*.until(N))\n  (( ${#graceFiles[@]} > 0 )) && anyGrace=1\n  for p in \"${FAST_PATTERNS[@]}\"; do\n    if (( anyGrace )) && PatternIsGraced \"$p\"; then continue; fi\n    printf '              if u contains \"%s\" then set doBlock to true\\n' \"${p//\\\"/\\\\\\\"}\"\n  done\n}\n\n# Check only the ACTIVE tab of each window, in one osascript that both detects\n# and redirects. No shell round-trip and no yt-dlp: this is what removes the\n# visible frame of the real page. The target keeps its handle so the reward\n# reopens the right creator.\nFastPassActiveTabs() {\n  local now clauses script b hasTarget=0 ytActive=0 ytMinutes=0\n  clauses=\"$(BuildFastClauses)\"\n  if ShouldBlockYouTubeDay; then ytActive=1; ytMinutes=\"$(NextYouTubeGrantMinutes)\"; fi\n  [[ -n \"$clauses\" || \"$ytActive\" -eq 1 ]] || return 0\n  now=\"$(NowEpoch)\"\n\n  local ytClauses=\"\"\n  if (( ytActive )); then\n    ytClauses='              if u contains \"youtube.com\" then set doBlockYT to true'$'\\n'\n    ytClauses+='              if u contains \"youtu.be\" then set doBlockYT to true'$'\\n'\n  fi\n\n  script=\"global blockUrl, ytBlockUrl, nowStr, ytMinutesStr\"$'\\n'\n  script+=\"set blockUrl to \\\"$BLOCK_PAGE_URL\\\"\"$'\\n'\n  script+=\"set ytBlockUrl to \\\"$YT_BLOCK_PAGE_URL\\\"\"$'\\n'\n  script+=\"set nowStr to \\\"$now\\\"\"$'\\n'\n  script+=\"set ytMinutesStr to \\\"$ytMinutes\\\"\"$'\\n'\n  script+='on stripQuery(u)'$'\\n'\n  script+='  if u contains \"?\" then set u to text 1 thru ((offset of \"?\" in u) - 1) of u'$'\\n'\n  script+='  if u contains \"#\" then set u to text 1 thru ((offset of \"#\" in u) - 1) of u'$'\\n'\n  script+='  return u'$'\\n'\n  script+='end stripQuery'$'\\n'\n  script+='on gateFor(u)'$'\\n'\n  script+='  return blockUrl & \"?u=\" & my stripQuery(u) & \"&t=\" & nowStr'$'\\n'\n  script+='end gateFor'$'\\n'\n  script+='on ytGateFor(u)'$'\\n'\n  script+='  return ytBlockUrl & \"?u=\" & my stripQuery(u) & \"&remaining=\" & ytMinutesStr'$'\\n'\n  script+='end ytGateFor'$'\\n'\n\n  for b in \"${CHROMIUM_BROWSERS[@]}\"; do\n    pgrep -x \"$b\" >/dev/null 2>&1 || continue\n    hasTarget=1\n    script+='using terms from application \"Google Chrome\"'$'\\n'\n    script+='  tell application \"'\"$b\"'\"'$'\\n'\n    script+='    try'$'\\n'\n    script+='      repeat with W in windows'$'\\n'\n    script+='        try'$'\\n'\n    script+='          set theTab to active tab of W'$'\\n'\n    script+='          set u to (URL of theTab as text)'$'\\n'\n    script+='          if not (u starts with blockUrl) and not (u starts with ytBlockUrl) then'$'\\n'\n    script+='            set doBlock to false'$'\\n'\n    script+='            set doBlockYT to false'$'\\n'\n    script+='            ignoring case'$'\\n'\n    script+=\"$clauses\"\n    script+=\"$ytClauses\"\n    script+='            end ignoring'$'\\n'\n    script+='            if doBlock then'$'\\n'\n    script+='              set URL of theTab to my gateFor(u)'$'\\n'\n    script+='            else if doBlockYT then'$'\\n'\n    script+='              set URL of theTab to my ytGateFor(u)'$'\\n'\n    script+='            end if'$'\\n'\n    script+='          end if'$'\\n'\n    script+='        end try'$'\\n'\n    script+='      end repeat'$'\\n'\n    script+='    end try'$'\\n'\n    script+='  end tell'$'\\n'\n    script+='end using terms from'$'\\n'\n  done\n\n  if pgrep -x \"Safari\" >/dev/null 2>&1; then\n    hasTarget=1\n    script+='tell application \"Safari\"'$'\\n'\n    script+='  try'$'\\n'\n    script+='    repeat with W in windows'$'\\n'\n    script+='      try'$'\\n'\n    script+='        set theTab to current tab of W'$'\\n'\n    script+='        set u to (URL of theTab as text)'$'\\n'\n    script+='        if not (u starts with blockUrl) and not (u starts with ytBlockUrl) then'$'\\n'\n    script+='          set doBlock to false'$'\\n'\n    script+='          set doBlockYT to false'$'\\n'\n    script+='          ignoring case'$'\\n'\n    script+=\"$clauses\"\n    script+=\"$ytClauses\"\n    script+='          end ignoring'$'\\n'\n    script+='          if doBlock then'$'\\n'\n    script+='            set URL of theTab to my gateFor(u)'$'\\n'\n    script+='          else if doBlockYT then'$'\\n'\n    script+='            set URL of theTab to my ytGateFor(u)'$'\\n'\n    script+='          end if'$'\\n'\n    script+='        end if'$'\\n'\n    script+='      end try'$'\\n'\n    script+='    end repeat'$'\\n'\n    script+='  end try'$'\\n'\n    script+='end tell'$'\\n'\n  fi\n\n  (( hasTarget )) || return 0\n  print -r -- \"$script\" | osascript - >/dev/null 2>&1 || true\n}\n\n\n# --- 11. Watch loop --------------------------------------------------------\n\n# Single pass (also used by the root layer, which cleans hosts/policy).\nEnforce() {\n  EnsureSecret\n  ShouldBlock && EnforceTabs\n  RemoveHostsBlock\n  RemoveChromePolicy\n}\n\n# The background service. Adaptive:\n#  - browser frontmost -> fast pass every FAST_SLEEP, deep pass every DEEP_EVERY;\n#  - browser in the background -> just a deep pass every second (no frame to\n#    hide, so no need to burn CPU polling);\n#  - out of the active window -> idle a minute.\nWatchTabs() {\n  EnsureSecret\n  local i=0\n  while true; do\n    if ! ShouldBlock; then sleep 60; continue; fi\n    # A hiccup in one pass must never kill the loop (KeepAlive would just\n    # restart it in a churn); swallow non-zero and keep going.\n    if BrowserIsFrontmost; then\n      FastPassActiveTabs || true\n      if (( i % DEEP_EVERY == 0 )); then EnforceTabs || true; fi\n      i=$(( (i + 1) % 1000000 ))\n      sleep \"$FAST_SLEEP\"\n    else\n      EnforceTabs || true\n      i=0\n      sleep 1\n    fi\n  done\n}\n\n\n# --- 12. Install -----------------------------------------------------------\n\nWriteUserPlist() {\n  mkdir -p \"$HOME/Library/LaunchAgents\" \"$HOME/Library/Logs\"\n  cat > \"$USER_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>Label</key><string>$USER_LABEL</string>\n  <key>ProgramArguments</key>\n  <array><string>$SCRIPT_PATH</string><string>watch-tabs</string></array>\n  <key>RunAtLoad</key><true/>\n  <key>KeepAlive</key><true/>\n  <key>StandardOutPath</key><string>$USER_LOG</string>\n  <key>StandardErrorPath</key><string>$USER_ERR_LOG</string>\n</dict>\n</plist>\nPLIST\n  plutil -lint \"$USER_PLIST\" >/dev/null\n}\n\nInstallUser() {\n  EnsureSecret\n  CompileTimer\n  WriteUserPlist\n  chmod 644 \"$USER_PLIST\" 2>/dev/null || true\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  # macOS keeps a per-LABEL \"disabled\" flag, separate from our own\n  # DISABLED_FILE: if this guard was ever stopped, that bit sticks and makes\n  # the load fail (I/O error) until we explicitly clear it here.\n  launchctl enable \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 || true\n  launchctl bootstrap \"gui/$(id -u)\" \"$USER_PLIST\"\n  Say \"User tab guard installed.\"\n}\n\nUninstallUser() {\n  RequireGuardPassword\n  StopGrantTimer\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$USER_PLIST\"\n  Say \"User tab guard uninstalled.\"\n}\n\n# Optional root layer: /etc/hosts + Chrome policy (with IncognitoModeAvailability=1,\n# which forces normal windows, so the watcher can see them).\n\nFlushDns() { dscacheutil -flushcache 2>/dev/null || true; killall -HUP mDNSResponder 2>/dev/null || true; }\n\nStripHostsBlock() {\n  awk -v s=\"$HOSTS_MARK_START\" -v e=\"$HOSTS_MARK_END\" \\\n    '$0==s{skip=1;next} $0==e{skip=0;next} skip!=1{print}' \"$1\"\n}\n\nApplyHostsBlock() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp; tmp=\"$(mktemp)\"\n  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"\n  { cat \"$tmp\"; printf '\\n%s\\n' \"$HOSTS_MARK_START\"\n    local d; for d in \"${HOST_DOMAINS[@]}\"; do printf '0.0.0.0\\t%s\\n::1\\t%s\\n' \"$d\" \"$d\"; done\n    printf '%s\\n' \"$HOSTS_MARK_END\"; } > \"$tmp.new\"\n  cp \"$tmp.new\" \"$HOSTS_FILE\"; rm -f \"$tmp\" \"$tmp.new\"; FlushDns\n}\n\nRemoveHostsBlock() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp; tmp=\"$(mktemp)\"\n  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"; cp \"$tmp\" \"$HOSTS_FILE\"; rm -f \"$tmp\"; FlushDns\n}\n\n# URL-shaped entries -> Chrome URLBlocklist entries (also covers incognito).\nBuildChromeBlocklist() {\n  CHROME_BLOCKLIST=(); local p\n  for p in \"${BLOCKED_PATTERNS[@]}\"; do [[ \"$p\" == *\"/\"* ]] && CHROME_BLOCKLIST+=(\"$p\"); done\n}\n\nApplyChromePolicy() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp entry; BuildChromeBlocklist\n  mkdir -p \"/Library/Managed Preferences\"\n  if [[ ! -f \"$CHROME_POLICY_MARKER\" ]]; then\n    if [[ -f \"$CHROME_POLICY_FILE\" ]]; then cp \"$CHROME_POLICY_FILE\" \"$CHROME_POLICY_BACKUP\"; printf 'existed\\n' > \"$CHROME_POLICY_MARKER\"\n    else printf 'absent\\n' > \"$CHROME_POLICY_MARKER\"; fi\n  fi\n  tmp=\"$(mktemp)\"\n  cat > \"$tmp\" <<'PLIST'\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>IncognitoModeAvailability</key><integer>1</integer>\n  <key>URLBlocklist</key>\n  <array>\nPLIST\n  for entry in \"${CHROME_BLOCKLIST[@]}\"; do printf '    <string>%s</string>\\n' \"$entry\" >> \"$tmp\"; done\n  printf '  </array>\\n</dict>\\n</plist>\\n' >> \"$tmp\"\n  plutil -lint \"$tmp\" >/dev/null\n  cp \"$tmp\" \"$CHROME_POLICY_FILE\"; rm -f \"$tmp\"\n  chown root:wheel \"$CHROME_POLICY_FILE\"; chmod 644 \"$CHROME_POLICY_FILE\"\n  plutil -lint \"$CHROME_POLICY_FILE\" >/dev/null\n}\n\nRemoveChromePolicy() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  [[ -f \"$CHROME_POLICY_MARKER\" ]] || return 0\n  local state; state=\"$(cat \"$CHROME_POLICY_MARKER\" 2>/dev/null || printf 'absent')\"\n  if [[ \"$state\" == \"existed\" && -f \"$CHROME_POLICY_BACKUP\" ]]; then cp \"$CHROME_POLICY_BACKUP\" \"$CHROME_POLICY_FILE\"\n  else rm -f \"$CHROME_POLICY_FILE\"; fi\n}\n\nWriteRootPlist() {\n  [[ \"$EUID\" -eq 0 ]] || { Say \"Root install needs admin rights.\"; exit 1; }\n  cat > \"$ROOT_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>Label</key><string>$ROOT_LABEL</string>\n  <key>ProgramArguments</key>\n  <array><string>$SCRIPT_PATH</string><string>enforce</string></array>\n  <key>RunAtLoad</key><true/>\n  <key>StartInterval</key><integer>60</integer>\n  <key>StandardOutPath</key><string>/var/log/SocialMediaGuard.log</st