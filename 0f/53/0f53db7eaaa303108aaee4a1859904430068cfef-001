nd try\n    end repeat\n  end repeat\nend tell\nreturn output\nAPPLESCRIPT\n  fi\n}\n\nRedirectTab() {\n  local browser=\"$1\" window=\"$2\" tab=\"$3\" target=\"$4\"\n  osascript - \"$browser\" \"$window\" \"$tab\" \"$target\" <<'APPLESCRIPT' >/dev/null 2>&1 || true\non run argv\n  set browserName to item 1 of argv\n  set windowIndex to (item 2 of argv) as integer\n  set tabIndex to (item 3 of argv) as integer\n  set targetURL to item 4 of argv\n  if browserName is \"Safari\" then\n    tell application \"Safari\" to set URL of tab tabIndex of window windowIndex to targetURL\n  else\n    using terms from application \"Google Chrome\"\n      tell application browserName to set URL of tab tabIndex of window windowIndex to targetURL\n    end using terms from\n  end if\nend run\nAPPLESCRIPT\n}\n\nHandleTab() {\n  local browser=\"$1\" window=\"$2\" tab=\"$3\" url=\"$4\" target\n\n  if [[ \"$url\" == \"$BLOCK_PAGE_URL\"* ]]; then\n    [[ \"$url\" == *\"unlock=1\"* ]] || return 0\n    target=\"$(Param \"$url\" u)\"\n    IsYouTubeURL \"$target\" || return 0\n    if GrantMatches \"$target\"; then\n      RedirectTab \"$browser\" \"$window\" \"$tab\" \"$target\"\n    elif GrantStillActive; then\n      :\n    else\n      StartGrant \"$target\"\n      RedirectTab \"$browser\" \"$window\" \"$tab\" \"$target\"\n    fi\n    return 0\n  fi\n\n  IsYouTubeURL \"$url\" || return 0\n  IsFreeYouTube \"$url\" && return 0\n  GrantMatches \"$url\" && return 0\n  RedirectTab \"$browser\" \"$window\" \"$tab\" \"$BLOCK_PAGE_URL?u=$(UrlEncode \"$url\")\"\n}\n\nEnforce() {\n  local browser window tab url\n  while IFS=$'\\t' read -r browser window tab url; do\n    [[ -n \"$browser\" && -n \"$window\" && -n \"$tab\" && -n \"$url\" ]] || continue\n    HandleTab \"$browser\" \"$window\" \"$tab\" \"$url\"\n  done < <(ListTabs)\n}\n\nCompileTimer() {\n  command -v swiftc >/dev/null 2>&1 || { Say \"swiftc introuvable.\"; return 1; }\n  swiftc -O \"$TIMER_SOURCE\" -o \"$TIMER_BIN\"\n  chmod 700 \"$TIMER_BIN\"\n}\n\nInstallUser() {\n  EnsureState\n  WriteBlockPage\n  ClearGrant\n  CompileTimer\n  mkdir -p \"$HOME/Library/LaunchAgents\" \"$HOME/Library/Logs\"\n  cat > \"$USER_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\"><dict>\n  <key>Label</key><string>$USER_LABEL</string>\n  <key>ProgramArguments</key><array><string>$SCRIPT_PATH</string><string>watch-tabs</string></array>\n  <key>RunAtLoad</key><true/>\n  <key>KeepAlive</key><true/>\n  <key>StandardOutPath</key><string>$HOME/Library/Logs/SocialMediaGuard.tabs.log</string>\n  <key>StandardErrorPath</key><string>$HOME/Library/Logs/SocialMediaGuard.tabs.err.log</string>\n</dict></plist>\nPLIST\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  launchctl bootstrap \"gui/$(id -u)\" \"$USER_PLIST\"\n  Say \"YouTube Guard installé : tout est bloqué sauf Ici Japon, Ici Japon Corp et les abonnements.\"\n}\n\nUninstallUser() {\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  ClearGrant\n  rm -f \"$USER_PLIST\"\n  Say \"YouTube Guard désinstallé.\"\n}\n\nStatus() {\n  local loaded=no\n  launchctl print \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 && loaded=yes\n  Say \"youtube_only=yes\"\n  Say \"subscriptions_unlimited=yes\"\n  Say \"ici_japon_unlimited=yes\"\n  Say \"grant_minutes=15\"\n  Say \"user_tab_guard_loaded=$loaded\"\n  Say \"timer_binary_present=$([[ -x \"$TIMER_BIN\" ]] && printf yes || printf no)\"\n}\n\ncase \"${1:-status}\" in\n  install-user) InstallUser ;;\n  uninstall-user) UninstallUser ;;\n  watch-tabs) while true; do Enforce; sleep 1; done ;;\n  enforce) EnsureState; WriteBlockPage; Enforce ;;\n  status) Status ;;\n  *) Say \"Usage: $0 {install-user|uninstall-user|watch-tabs|enforce|status}\"; exit 1 ;;\nesac\n`;\nconst patch = \"*** Begin Patch\\n*** Add File: /Users/zenray/Create/Build/Memory/Tool