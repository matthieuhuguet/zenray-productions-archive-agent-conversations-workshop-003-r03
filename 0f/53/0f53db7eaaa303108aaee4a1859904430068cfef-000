rent grant expiry\n\n# Timings (overridable from the plist via environment variables).\nWAIT_MINUTES=\"${SMG_WAIT_MINUTES:-0}\"       # no waiting by default\nREWARD_MINUTES=\"${SMG_REWARD_MINUTES:-15}\"  # short allowance once opened\nSTART_HOUR=\"${SMG_START_HOUR:-0}\"           # active window: 0..24 = always on\nEND_HOUR=\"${SMG_END_HOUR:-24}\"\nFAST_SLEEP=\"${SMG_FAST_SLEEP:-0.1}\"         # active-tab poll interval (seconds)\nDEEP_EVERY=\"${SMG_DEEP_EVERY:-10}\"          # deep sweep once every N fast passes\n\n# Background service (LaunchAgent).\nUSER_LABEL=\"com.zenray.social-media-guard.tabs\"\nROOT_LABEL=\"com.zenray.social-media-guard\"\nUSER_PLIST=\"$HOME/Library/LaunchAgents/$USER_LABEL.plist\"\nROOT_PLIST=\"/Library/LaunchDaemons/$ROOT_LABEL.plist\"\nSCRIPT_PATH=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuard.sh\"\nUSER_LOG=\"$HOME/Library/Logs/SocialMediaGuard.tabs.log\"\nUSER_ERR_LOG=\"$HOME/Library/Logs/SocialMediaGuard.tabs.err.log\"\n\n# Optional root layer (hosts + Chrome policy). Inactive without sudo.\nHOSTS_FILE=\"/etc/hosts\"\nHOSTS_MARK_START=\"# ZENRAY_SOCIAL_MEDIA_GUARD_START\"\nHOSTS_MARK_END=\"# ZENRAY_SOCIAL_MEDIA_GUARD_END\"\nCHROME_POLICY_FILE=\"/Library/Managed Preferences/com.google.Chrome.plist\"\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019ff47b-ca81-7601-b681-a61358b682d9"}}}
