{"timestamp":"2026-08-13T06:17:55.299Z","ordinal":538,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019ff9c5-2763-7cf3-b2de-d92e47258f62","call_id":"call_VikRSwwrPBKKUtIyvgYkAWMh","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"# The background service. Adaptive:\n#  - browser frontmost -> fast pass every FAST_SLEEP, deep pass every DEEP_EVERY;\n#  - browser in the background -> just a deep pass every second (no frame to\n#    hide, so no need to burn CPU polling);\n#  - out of the active window -> idle a minute.\nWatchTabs() {\n  EnsureSecret\n  local i=0\n  while true; do\n    if ! ShouldBlock; then sleep 60; continue; fi\n    # A hiccup in one pass must never kill the loop (KeepAlive would just\n    # restart it in a churn); swallow non-zero and keep going.\n    if BrowserIsFrontmost; then\n      FastPassActiveTabs || true\n      if (( i % DEEP_EVERY == 0 )); then EnforceTabs || true; fi\n      i=$(( (i + 1) % 1000000 ))\n      sleep \"$FAST_SLEEP\"\n    else\n      EnforceTabs || true\n      i=0\n      sleep 1\n    fi\n  done\n}\n\n\n# --- 12. Install -----------------------------------------------------------\n\nWriteUserPlist() {\n  mkdir -p \"$HOME/Library/LaunchAgents\" \"$HOME/Library/Logs\"\n  cat > \"$USER_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>Label</key><string>$USER_LABEL</string>\n  <key>ProgramArguments</key>\n  <array><string>$SCRIPT_PATH</string><string>watch-tabs</string></array>\n  <key>RunAtLoad</key><true/>\n  <key>KeepAlive</key><true/>\n  <key>StandardOutPath</key><string>$USER_LOG</string>\n  <key>StandardErrorPath</key><string>$USER_ERR_LOG</string>\n</dict>\n</plist>\nPLIST\n  plutil -lint \"$USER_PLIST\" >/dev/null\n}\n\nInstallUser() {\n  EnsureSecret\n  CompileTimer\n  WriteUserPlist\n  chmod 644 \"$USER_PLIST\" 2>/dev/null || true\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  # macOS keeps a per-LABEL \"disabled\" flag, separate from our own\n  # DISABLED_FILE: if this guard was ever stopped, that bit sticks and makes\n  # the load fail (I/O error) until we explicitly clear it here.\n  launchctl enable \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 || true\n  launchctl bootstrap \"gui/$(id -u)\" \"$USER_PLIST\"\n  Say \"User tab guard installed.\"\n}\n\nUninstallUser() {\n  RequireGuardPassword\n  StopGrantTimer\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$USER_PLIST\"\n  Say \"User tab guard uninstalled.\"\n}\n\n# Optional root layer: /etc/hosts + Chrome policy (with IncognitoModeAvailability=1,\n# which forces normal windows, so the watcher can see them).\n\nFlushDns() { dscacheutil -flushcache 2>/dev/null || true; killall -HUP mDNSResponder 2>/dev/null || true; }\n\nStripHostsBlock() {\n  awk -v s=\"$HOSTS_MARK_START\" -v e=\"$HOSTS_MARK_END\" \\\n    '$0==s{skip=1;next} $0==e{skip=0;next} skip!=1{print}' \"$1\"\n}\n\nApplyHostsBlock() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp; tmp=\"$(mktemp)\"\n  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"\n  { cat \"$tmp\"; printf '\\n%s\\n' \"$HOSTS_MARK_START\"\n    local d; for d in \"${HOST_DOMAINS[@]}\"; do printf '0.0.0.0\\t%s\\n::1\\t%s\\n' \"$d\" \"$d\"; done\n    printf '%s\\n' \"$HOSTS_MARK_END\"; } > \"$tmp.new\"\n  cp \"$tmp.new\" \"$HOSTS_FILE\"; rm -f \"$tmp\" \"$tmp.new\"; FlushDns\n}\n\nRemoveHostsBlock() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp; tmp=\"$(mktemp)\"\n  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"; cp \"$tmp\" \"$HOSTS_FILE\"; rm -f \"$tmp\"; FlushDns\n}\n\n# URL-shaped entries -> Chrome URLBlocklist entries (also covers incognito).\nBuildChromeBlocklist() {\n  CHROME_BLOCKLIST=(); local p\n  for p in \"${BLOCKED_PATTERNS[@]}\"; do [[ \"$p\" == *\"/\"* ]] && CHROME_BLOCKLIST+=(\"$p\"); done\n}\n\nApplyChromePolicy() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp entry; BuildChromeBlocklist\n  mkdir -p \"/Library/Managed Preferences\"\n  if [[ ! -f \"$CHROME_POLICY_MARKER\" ]]; then\n    if [[ -f \"$CHROME_POLICY_FILE\" ]]; then cp \"$CHROME_POLICY_FILE\" \"$CHROME_POLICY_BACKUP\"; printf 'existed\\n' > \"$CHROME_POLICY_MARKER\"\n    else printf 'absent\\n' > \"$CHROME_POLICY_MARKER\"; fi\n  fi\n  tmp=\"$(mktemp)\"\n  cat > \"$tmp\" <<'PLIST'\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>IncognitoModeAvailability</key><integer>1</integer>\n  <key>URLBlocklist</key>\n  <array>\nPLIST\n  for entry in \"${CHROME_BLOCKLIST[@]}\"; do printf '    <string>%s</string>\\n' \"$entry\" >> \"$tmp\"; done\n  printf '  </array>\\n</dict>\\n</plist>\\n' >> \"$tmp\"\n  plutil -lint \"$tmp\" >/dev/null\n  cp \"$tmp\" \"$CHROME_POLICY_FILE\"; rm -f \"$tmp\"\n  chown root:wheel \"$CHROME_POLICY_FILE\"; chmod 644 \"$CHROME_POLICY_FILE\"\n  plutil -lint \"$CHROME_POLICY_FILE\" >/dev/null\n}\n\nRemoveChromePolicy() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  [[ -f \"$CHROME_POLICY_MARKER\" ]] || return 0\n  local state; state=\"$(cat \"$CHROME_POLICY_MARKER\" 2>/dev/null || printf 'absent')\"\n  if [[ \"$state\" == \"existed\" && -f \"$CHROME_POLICY_BACKUP\" ]]; then cp \"$CHROME_POLICY_BACKUP\" \"$CHROME_POLICY_FILE\"\n  else rm -f \"$CHROME_POLICY_FILE\"; fi\n}\n\nWriteRootPlist() {\n  [[ \"$EUID\" -eq 0 ]] || { Say \"Root install needs admin rights.\"; exit 1; }\n  cat > \"$ROOT_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>Label</key><string>$ROOT_LABEL</string>\n  <key>ProgramArguments</key>\n  <array><string>$SCRIPT_PATH</string><string>enforce</string></array>\n  <key>RunAtLoad</key><true/>\n  <key>StartInterval</key><integer>60</integer>\n  <key>StandardOutPath</key><string>/var/log/SocialMediaGuard.log</string>\n  <key>StandardErrorPath</key><string>/var/log/SocialMediaGuard.err.log</string>\n</dict>\n</plist>\nPLIST\n  chown root:wheel \"$ROOT_PLIST\"; chmod 644 \"$ROOT_PLIST\"; plutil -lint \"$ROOT_PLIST\" >/dev/null\n}\n\nInstallRoot() { EnsureSecret; CleanupRoot; }\n\nCleanupRoot() {\n  [[ \"$EUID\" -eq 0 ]] || { Say \"Root cleanup needs admin rights.\"; exit 1; }\n  RemoveHostsBlock; RemoveChromePolicy\n  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$ROOT_PLIST\"\n  Say \"Root network guard removed. UI guard is active through the user agent.\"\n}\n\nUninstallRoot() {\n  RequireGuardPassword\n  [[ \"$EUID\" -eq 0 ]] || { Say \"Root uninstall needs admin rights.\"; exit 1; }\n  RemoveHostsBlock; RemoveChromePolicy\n  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$ROOT_PLIST\"\n  Say \"Root host guard uninstalled.\"\n}\n\n\n# --- 13. Commands ----------------------------------------------------------\n\nSuspend() {\n  RequireGuardPassword\n  local minutes=\"${1:-30}\"\n  [[ \"$minutes\" =~ '^[0-9]+$' ]] || { Say \"Minutes must be a number.\"; exit 1; }\n  EnsureDirs\n  printf '%s\\n' \"$(( $(NowEpoch) + minutes * 60 ))\" > \"$SUSPEND_FILE\"\n  Enforce\n  Say \"Guard suspended for $minutes minutes.\"\n}\n\nDisable() {\n  RequireGuardPassword\n  EnsureDirs\n  StopGrantTimer\n  date '+%Y-%m-%d %H:%M:%S' > \"$DISABLED_FILE\"\n  Enforce\n  Say \"Guard disabled.\"\n}\n\nEnable() {\n  EnsureDirs\n  rm -f \"$DISABLED_FILE\" \"$SUSPEND_FILE\"\n  Enforce\n  Say \"Guard enabled.\"\n}\n\nStatus() {\n  local userLoaded=\"no\" rootLoaded=\"no\" chromePolicy=\"no\"\n  launchctl print \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 && userLoaded=\"yes\"\n  launchctl print \"system/$ROOT_LABEL\"        >/dev/null 2>&1 && rootLoaded=\"yes\"\n  [[ -f \"$CHROME_POLICY_FILE\" ]] && /usr/libexec/PlistBuddy -c \"Print :URLBlocklist\" \"$CHROME_POLICY_FILE\" >/dev/null 2>&1 && chromePolicy=\"yes\"\n\n  Say \"protected_hours=$(IsProtectedNow && printf yes || printf no)\"\n  Say \"disabled=$(IsDisabled && printf yes || printf no)\"\n  Say \"suspended=$(IsSuspended && printf yes || printf no)\"\n  Say \"user_tab_guard_loaded=$userLoaded\"\n  Say \"root_host_guard_loaded=$rootLoaded\"\n  Say \"hosts_block_present=$(grep -q \"$HOSTS_MARK_START\" \"$HOSTS_FILE\" 2>/dev/null && printf yes || printf no)\"\n  Say \"chrome_policy_present=$chromePolicy\"\n  Say \"block_page_present=$([[ -f \"$BLOCK_PAGE_FILE\" ]] && printf yes || printf no)\"\n  Say \"timer_binary_present=$([[ -x \"$TIMER_BIN\" ]] && printf yes || printf no)\"\n  Say \"secret_present=$([[ -f \"$SECRET_FILE\" ]] && printf yes || printf no)\"\n  Say \"blocked_patterns=${#BLOCKED_PATTERNS[@]}\"\n  Say \"fast_patterns=${#FAST_PATTERNS[@]}\"\n  Say \"youtube_daytime_window=${YT_DAY_START_HOUR}h-${YT_DAY_END_HOUR}h, now_in_window=$(IsYouTubeDayWindow && printf yes || printf no)\"\n  Say \"youtube_daytime_grants_used=$(YouTubeGrantsUsedToday)/${#YT_GRANT_MINUTES[@]}\"\n  Say \"youtube_daytime_access_active=$(YouTubeAccessGranted && printf yes || printf no)\"\n}\n\n\n# --- 14. Entry point -------------------------------------------------------\n\ncase \"${1:-status}\" in\n  install-user)   InstallUser ;;\n  install-root)   InstallRoot ;;\n  enforce)        Enforce ;;\n  watch-tabs)     WatchTabs ;;\n  close-tabs)     EnsureBlockPage; EnforceTabs ;;\n  suspend)        Suspend \"${2:-30}\" ;;\n  disable)        Disable ;;\n  enable)         Enable ;;\n  status)         Status ;;\n  uninstall-user) UninstallUser ;;\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019ff9c2-23d6-7613-a971-0f433407b764"}}}
