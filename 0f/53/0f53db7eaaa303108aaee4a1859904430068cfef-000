n        panel.contentView = view\n        self.panel = panel\n        self.view = view\n        position(panel)\n        panel.orderFrontRegardless()\n\n        NotificationCenter.default.addObserver(\n            self,\n            selector: #selector(reposition),\n            name: NSApplication.didChangeScreenParametersNotification,\n            object: nil\n        )\n        timer = Timer.scheduledTimer(withTimeInterval: 1, repeats: true) { [weak self] _ in\n            self?.refresh()\n        }\n        refresh()\n    }\n\n    @objc private func reposition() {\n        guard let panel else { return }\n        position(panel)\n    }\n\n    private func position(_ panel: NSPanel) {\n        let screen = NSScreen.main ?? NSScreen.screens.first\n        guard let visible = screen?.visibleFrame else { return }\n        let origin = NSPoint(\n            x: visible.maxX - panel.frame.width - 24,\n            y: visible.minY + 24\n        )\n        panel.setFrameOrigin(origin)\n    }\n\n    private func refresh() {\n        guard\n            let raw = try? String(contentsOf: stateURL, encoding: .utf8),\n            let until = Int(raw.trimmingCharacters(in: .whitespacesAndNewlines))\n        else {\n            finish()\n            return\n        }\n\n        let remaining = until - Int(Date().timeIntervalSince1970)\n        guard remaining > 0 else {\n            finish()\n            return\n        }\n        view?.remaining = remaining\n    }\n\n    private func finish() {\n        timer?.invalidate()\n        timer = nil\n        panel?.orderOut(nil)\n        try? FileManager.default.removeItem(at: stateURL)\n        NSApp.terminate(nil)\n    }\n}\n\nlet statePath = CommandLine.arguments.dropFirst().first\n    ?? \"/Users/zenray/Create/Build/Memory/Focus/.SocialMediaGuardState/active_grant_until\"\nlet application = NSApplication.shared\napplication.setActivationPolicy(.accessory)\nlet controller = TimerController(stateURL: URL(fileURLWithPath: statePath))\napplication.delegate = controller\napplication.run()\n"},{"type":"input_text","text":"--- RESULT 3 ---\n#!/bin/zsh\nset -euo pipefail\nexport PATH=\"/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin\"\n\n# ===========================================================================\n#  SOCIAL MEDIA GUARD\n#  Closes the creators (YouTube + Instagram/TikTok/X/Facebook) that Matthieu\n#  chose to stop watching. Instead of a hard block, the tab switches to a\n#  block page: one button opens the content for 15 minutes. A native floating\n#  timer stays visible over the real page and exits when the allowance ends.\n#\n#  How blocking stays fast (no visible frame of the real page):\n#    - FAST pass  (~0.1s): checks only the ACTIVE tab and redirects it inside\n#      AppleScript. Runs only while a browser is frontmost. Kills the frame.\n#    - DEEP pass  (~1s):   full sweep of every tab, resolves YouTube videos\n#      through yt-dlp, handles the reward, catches background tabs.\n#\n#  File map:\n#     1. Config              - paths, timings, browsers\n#     2. Blocked creators    - BLOCKED_PATTERNS (single editable source)\n#     3. Small helpers       - dates, text, url encoding\n#     4. Files and migration - folders, password, old names\n#     5. On / Off            - disabled, suspended, active window\n#     6. Match engine        - does this text point to a blocked creator?\n#     7. Reward (grace)      - temporary earned access, per creator\n#     8. Timer               - native bottom-right access timer\n#     9. Block page          - the HTML shown in the tab\n#    10. Browser control     - list tabs, redirect one tab\n#    11. Fast pass           - instant redirect of the active tab\n#    12. Watch loop          - the loop the background service runs\n#    13. Install             - user service (+ optional root layer)\n#    14. Commands            - status, suspend, disable/enable, uninstall\n#    15. Entry point         - command line dispatch\n#\n#  Usage: SocialMediaGuard.sh <command>\n#    install-user | status | enable | disable | suspend [min] |\n#    enforce | watch-tabs | close-tabs | uninstall-user |\n#    install-root | uninstall-root | cleanup-root\n# ===========================================================================\n\n\n# --- 1. Config -------------------------------------------------------------\n\nOWNER=\"zenray\"\nMEMORY_ROOT=\"${MEMORY_ROOT:-/Users/zenray/Create/Build/Memory}\"\nFOCUS_DIR=\"$MEMORY_ROOT/Focus\"\n\nSECRET_FILE=\"$FOCUS_DIR/.SocialMediaGuardPassword\"     # local password (git-ignored)\nSTATE_DIR=\"$FOCUS_DIR/.SocialMediaGuardState\"          # internal state (git-ignored)\nDISABLED_FILE=\"$STATE_DIR/disabled\"                    # present = guard turned off\nSUSPEND_FILE=\"$STATE_DIR/suspend_until\"                # epoch when suspension ends\nBLOCK_PAGE_FILE=\"$FOCUS_DIR/SocialMediaBlocked.html\"   # the page shown in the tab\nBLOCK_PAGE_URL=\"file://$BLOCK_PAGE_FILE\"\nILLUSTRATION_URL=\"file://$MEMORY_ROOT/ArtDirection/output_v3.png\"\n\n# YouTube daytime gate (separate from the creator list below): all of\n# youtube.com/youtu.be is closed during this window, every day. \"Ask for\n# time\" opens it immediately once for 15 minutes, then stays closed for the day.\nYT_DAY_START_HOUR=\"${SMG_YT_START_HOUR:-10}\"\nYT_DAY_END_HOUR=\"${SMG_YT_END_HOUR:-19}\"\nYT_GRANT_MINUTES=(15)             # one 15-minute allowance per day\nYT_BLOCK_PAGE_FILE=\"$FOCUS_DIR/YouTubeDaytimeBlocked.html\"\nYT_BLOCK_PAGE_URL=\"file://$YT_BLOCK_PAGE_FILE\"\nYT_DAY_FILE=\"$STATE_DIR/youtube_daytime_day\"              # YYYY-MM-DD of last reset\nYT_GRANTS_USED_FILE=\"$STATE_DIR/youtube_daytime_grants_used\"\nYT_UNTIL_FILE=\"$STATE_DIR/youtube_daytime_until\"           # epoch, current grant expiry\nACTIVE_GRANT_FILE=\"$STATE_DIR/active_grant_until\"         # epoch for native timer\nTIMER_SOURCE=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuardTimer.swift\"\nTIMER_BIN=\"$STATE_DIR/SocialMediaGuardTimer\"\n\n# The creator allowance is intentionally fixed. There is no second countdown.\nREWARD_MINUTES=15\nSTART_HOUR=\"${SMG_START_HOUR:-0}\"           # active window: 0..24 = always on\nEND_HOUR=\"${SMG_END_HOUR:-24}\"\nFAST_SLEEP=\"${SMG_FAST_SLEEP:-0.1}\"         # active-tab poll interval (seconds)\nDEEP_EVERY=\"${SMG_DEEP_EVERY:-10}\"          # deep sweep once every N fast passes\n\n# Background service (LaunchAgent).\nUSER_LABEL=\"com.zenray.social-media-guard.tabs\"\nROOT_LABEL=\"com.zenray.social-media-guard\"\nUSER_PLIST=\"$HOME/Library/LaunchAgents/$USER_LABEL.plist\"\nROOT_PLIST=\"/Library/LaunchDaemons/$ROOT_LABEL.plist\"\nSCRIPT_PATH=\"$MEMORY_ROOT/Tools/FocusGuard/SocialMediaGuard.sh\"\nUSER_LOG=\"$HOME/Library/Logs/SocialMediaGuard.tabs.log\"\nUSER_ERR_LOG=\"$HOME/Library/Logs/SocialMediaGuard.tabs.err.log\"\n\n# Optional root layer (hosts + Chrome policy). Inactive without sudo.\nHOSTS_FILE=\"/etc/hosts\"\nHOSTS_MARK_START=\"# ZENRAY_SOCIAL_MEDIA_GUARD_START\"\nHOSTS_MARK_END=\"# ZENRAY_SOCIAL_MEDIA_GUARD_END\"\nCHROME_POLICY_FILE=\"/Library/Managed Preferences/com.google.Chrome.plist\"\nCHROME_POLICY_BACKUP=\"$STATE_DIR/com.google.Chrome.plist.before-guard\"\nCHROME_POLICY_MARKER=\"$STATE_DIR/chrome_policy_backup_state\"\nHOST_DOMAINS=()\nCHROME_BLOCKLIST=()\n\n# Browsers we drive. Every Chromium shares Google Chrome's tab vocabulary\n# (\"using terms from\"); Safari has its own.\nCHROMIUM_BROWSERS=(\n  \"Google Chrome\" \"Google Chrome Beta\" \"Google Chrome Canary\" \"Chromium\"\n  \"Brave Browser\" \"Brave Browser Beta\" \"Microsoft Edge\" \"Microsoft Edge Beta\"\n  \"Vivaldi\" \"Opera\" \"Opera GX\"\n)\n\n\n# --- 2. Blocked creators (single source of truth) --------------------------\n#\n# Each entry is matched as a substring, case-insensitive and separator-\n# insensitive (see Normalize), against two things:\n#   1) the tab URL (any network) - blocks YouTube, Instagram, TikTok,\n#      Facebook and X as soon as the entry is the account handle;\n#   2) the identity yt-dlp returns for a /watch page (channel name, uploader)\n#      - catches every video and side channel of a creator, even without\n#      knowing their exact handle.\n# Safety: an entry that matches nothing blocks nothing (harmless miss). So we\n# can be broad on NAMES and stay precise (joined handle or URL) to never block\n# a third party by accident.\n#\n# A few entries keep accents on purpose: they are real creator names, and a\n# channel identity like \"HugoDecrypte\" written with the accent is only caught\n# by the accented form.\n\nBLOCKED_PATTERNS=(\n  # --- Ici Japon ---\n  \"youtube.com/@icijaponcorp\"  \"youtube.com/channel/uct11zynefnunokgcrso9uyg\"  \"ici japon\"\n  # --- Silicon Carne / Carlos Diaz ---\n  \"youtube.com/@siliconcarnepod\"  \"siliconcarne\"  \"silicon carne\"  \"carlosdiaz\"  \"carlos diaz\"\n  # --- Oussama Ammar ---\n  \"youtube.com/@oussamaammaroff\"  \"youtube.com/channel/ucxh-b8b2sx4kgshsvj3ngza\"\n  \"oussamaammaroff\"  \"oussamaammar\"  \"oussama ammar\"\n  [[ -s \"$cache\" ]] && { cat \"$cache\"; return 0; }\n\n  json=\"$(\"$ytdlp\" --dump-single-json --no-playlist --skip-download \\\n    --socket-timeout 4 --extractor-retries 1 --retries 1 \"$url\" 2>/dev/null || true)\"\n  identity=\"$(printf '%s' \"$json\" | jq -r '\n    [ .channel, .uploader, .channel_id, .uploader_id, .channel_url,\n      .uploader_url, .creator, .webpage_url, .original_url ]\n    | map(select(type == \"string\" and length > 0)) | join(\" \")' 2>/dev/null || true)\"\n\n  [[ -n \"$identity\" ]] && printf '%s\\n' \"$identity\" > \"$cache\"\n  printf '%s\\n' \"$identity\"\n}\n\n\n# --- 7. Reward (grace): temporary earned access, per creator ---------------\n\nCompileTimer() {\n  EnsureDirs\n  command -v swiftc >/dev/null 2>&1 || return 1\n  swiftc -O \"$TIMER_SOURCE\" -o \"$TIMER_BIN\"\n  chmod 700 \"$TIMER_BIN\" 2>/dev/null || true\n}\n\nStartGrantTimer() {\n  EnsureDirs\n  if [[ ! -x \"$TIMER_BIN\" || \"$TIMER_SOURCE\" -nt \"$TIMER_BIN\" ]]; then\n    CompileTimer || return 0\n  fi\n  printf '%s\\n' \"$1\" > \"$ACTIVE_GRANT_FILE\"\n  pkill -x SocialMediaGuardTimer >/dev/null 2>&1 || true\n  \"$TIMER_BIN\" \"$ACTIVE_GRANT_FILE\" >/dev/null 2>&1 &\n}\n\nStopGrantTimer() {\n  pkill -x SocialMediaGuardTimer >/dev/null 2>&1 || true\n  rm -f \"$ACTIVE_GRANT_FILE\"\n}\n\n# Path of a pattern's reward marker (a safe file name, no shasum fork).\nGraceFileFor() {\n  printf '%s/grace_%s.until' \"$STATE_DIR\" \"$(printf '%s' \"${1:l}\" | tr -c 'a-z0-9' '_')\"\n}\n\n# True if this pattern has a reward that is still valid.\nPatternIsGraced() {\n  local f until; f=\"$(GraceFileFor \"$1\")\"\n  [[ -f \"$f\" ]] || return 1\n  until=\"$(cat \"$f\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ ^[0-9]+$ ]] || return 1\n  [[ \"$(NowEpoch)\" -lt \"$until\" ]]\n}\n\nTargetHasActiveGrace() {\n  local target=\"$1\" ltarget nltarget i n\n  ltarget=\"${target:l}\"; nltarget=\"$(Normalize \"$target\")\"\n  n=${#BLOCKED_PATTERNS[@]}\n  for (( i = 1; i <= n; i++ )); do\n    if PatternMatches \"${BLOCKED_PATTERNS[i]:l}\" \"${NORMALIZED_PATTERNS[i]}\" \"$ltarget\" \"$nltarget\" \\\n      && PatternIsGraced \"${BLOCKED_PATTERNS[i]}\"; then\n      return 0\n    fi\n  done\n  return 1\n}\n\n# Grant REWARD_MINUTES to every entry the target URL triggers, and only those:\n# earning access to one creator never unblocks the others.\nGrantGrace() {\n  local target=\"$1\" ltarget nltarget until i n\n  ltarget=\"${target:l}\"; nltarget=\"$(Normalize \"$target\")\"\n  until=\"$(( $(NowEpoch) + REWARD_MINUTES * 60 ))\"\n  EnsureDirs\n  n=${#BLOCKED_PATTERNS[@]}\n  for (( i = 1; i <= n; i++ )); do\n    if PatternMatches \"${BLOCKED_PATTERNS[i]:l}\" \"${NORMALIZED_PATTERNS[i]}\" \"$ltarget\" \"$nltarget\"; then\n      printf '%s\\n' \"$until\" > \"$(GraceFileFor \"${BLOCKED_PATTERNS[i]}\")\"\n    fi\n  done\n  StartGrantTimer \"$until\"\n}\n\n# The block-page URL for a target, timestamped (lets the page recompute the\n# time left even after the tab is reloaded).\nGateUrlFor() {\n  printf '%s?u=%s&t=%s' \"$BLOCK_PAGE_URL\" \"$(UrlEncode \"$1\")\" \"$(NowEpoch)\"\n}\n\n\n# --- 9. Block page (the HTML shown in the tab) -----------------------------\n# English, plain tone. The real-page timer is native, not part of this page.\n\nEnsureBlockPage() {\n  EnsureDirs\n  local F=\"/Users/zenray/Library/Fonts\"\n  cat > \"$BLOCK_PAGE_FILE\" <<HTML\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Blocked</title>\n# --- 11. Watch loop --------------------------------------------------------\n\n# Single pass (also used by the root layer, which cleans hosts/policy).\nEnforce() {\n  EnsureSecret\n  ShouldBlock && EnforceTabs\n  RemoveHostsBlock\n  RemoveChromePolicy\n}\n\n# The background service. Adaptive:\n#  - browser frontmost -> fast pass every FAST_SLEEP, deep pass every DEEP_EVERY;\n#  - browser in the background -> just a deep pass every second (no frame to\n#    hide, so no need to burn CPU polling);\n#  - out of the active window -> idle a minute.\nWatchTabs() {\n  EnsureSecret\n  local i=0\n  while true; do\n    if ! ShouldBlock; then sleep 60; continue; fi\n    # A hiccup in one pass must never kill the loop (KeepAlive would just\n    # restart it in a churn); swallow non-zero and keep going.\n    if BrowserIsFrontmost; then\n      FastPassActiveTabs || true\n      if (( i % DEEP_EVERY == 0 )); then EnforceTabs || true; fi\n      i=$(( (i + 1) % 1000000 ))\n      sleep \"$FAST_SLEEP\"\n    else\n      EnforceTabs || true\n      i=0\n      sleep 1\n    fi\n  done\n}\n\n\n# --- 12. Install -----------------------------------------------------------\n\nWriteUserPlist() {\n  mkdir -p \"$HOME/Library/LaunchAgents\" \"$HOME/Library/Logs\"\n  cat > \"$USER_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>Label</key><string>$USER_LABEL</string>\n  <key>ProgramArguments</key>\n  <array><string>$SCRIPT_PATH</string><string>watch-tabs</string></array>\n  <key>RunAtLoad</key><true/>\n  <key>KeepAlive</key><true/>\n  <key>StandardOutPath</key><string>$USER_LOG</string>\n  <key>StandardErrorPath</key><string>$USER_ERR_LOG</string>\n</dict>\n</plist>\nPLIST\n  plutil -lint \"$USER_PLIST\" >/dev/null\n}\n\nInstallUser() {\n  EnsureSecret\n  CompileTimer\n  WriteUserPlist\n  chmod 644 \"$USER_PLIST\" 2>/dev/null || true\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  # macOS keeps a per-LABEL \"disabled\" flag, separate from our own\n  # DISABLED_FILE: if this guard was ever stopped, that bit sticks and makes\n  # the load fail (I/O error) until we explicitly clear it here.\n  launchctl enable \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 || true\n  launchctl bootstrap \"gui/$(id -u)\" \"$USER_PLIST\"\n  Say \"User tab guard installed.\"\n}\n\nUninstallUser() {\n  RequireGuardPassword\n  StopGrantTimer\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$USER_PLIST\"\n  Say \"User tab guard uninstalled.\"\n}\n\n# Optional root layer: /etc/hosts + Chrome policy (with IncognitoModeAvailability=1,\n# which forces normal windows, so the watcher can see them).\n\nFlushDns() { dscacheutil -flushcache 2>/dev/null || true; killall -HUP mDNSResponder 2>/dev/null || true; }\n\nStripHostsBlock() {\n  awk -v s=\"$HOSTS_MARK_START\" -v e=\"$HOSTS_MARK_END\" \\\n    '$0==s{skip=1;next} $0==e{skip=0;next} skip!=1{print}' \"$1\"\n}\n\nApplyHostsBlock() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp; tmp=\"$(mktemp)\"\n  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"\n  { cat \"$tmp\"; printf '\\n%s\\n' \"$HOSTS_MARK_START\"\n    local d; for d in \"${HOST_DOMAINS[@]}\"; do printf '0.0.0.0\\t%s\\n::1\\t%s\\n' \"$d\" \"$d\"; done\n    printf '%s\\n' \"$HOSTS_MARK_END\"; } > \"$tmp.new\"\n  cp \"$tmp.new\" \"$HOSTS_FILE\"; rm -f \"$tmp\" \"$tmp.new\"; FlushDns\n}\n\nRemoveHostsBlock() {\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019ff9c2-23d6-7613-a971-0f433407b764"}}}
