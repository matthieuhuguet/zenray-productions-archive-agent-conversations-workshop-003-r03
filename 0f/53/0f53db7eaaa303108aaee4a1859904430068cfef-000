local f until; f=\"$(GraceFileFor \"$1\")\"\n547:# Grant REWARD_MINUTES to every entry the target URL triggers, and only those:\n549:GrantGrace() {\n552:  until=\"$(( $(NowEpoch) + REWARD_MINUTES * 60 ))\"\n557:      printf '%s\\n' \"$until\" > \"$(GraceFileFor \"${BLOCKED_PATTERNS[i]}\")\"\n564:GateUrlFor() {\n565:  printf '%s?u=%s&t=%s' \"$BLOCK_PAGE_URL\" \"$(UrlEncode \"$1\")\" \"$(NowEpoch)\"\n572:EnsureBlockPage() {\n575:  cat > \"$BLOCK_PAGE_FILE\" <<HTML\n622:    <p class=\"cap\">Open for <span class=\"num\">$REWARD_MINUTES</span> min, then it closes.</p>\n634:  var WAIT_SECONDS = $((WAIT_MINUTES * 60));\n659:  chmod 644 \"$BLOCK_PAGE_FILE\" 2>/dev/null || true\n734:HandleTab() {\n738:  if [[ \"$url\" == \"$YT_BLOCK_PAGE_URL\"* ]]; then\n750:  if [[ \"$url\" == \"$BLOCK_PAGE_URL\"* ]]; then\n756:    if [[ \"$startedAt\" =~ ^[0-9]+$ && $(( $(NowEpoch) - startedAt )) -ge $(( WAIT_MINUTES * 60 )) ]]; then\n790:EnforceTabs() {\n819:FastPassActiveTabs() {\n833:  script+=\"set blockUrl to \\\"$BLOCK_PAGE_URL\\\"\"$'\\n'\n834:  script+=\"set ytBlockUrl to \\\"$YT_BLOCK_PAGE_URL\\\"\"$'\\n'\n926:WatchTabs() {\n1135:  Say \"block_page_present=$([[ -f \"$BLOCK_PAGE_FILE\" ]] && printf yes || printf no)\"\n1147:case \"${1:-status}\" in\n"},{"type":"input_text","text":"--- RESULT 5 ---\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Blocked</title>\n<style>\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file:///Users/zenray/Library/Fonts/AnthropicSans-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file:///Users/zenray/Library/Fonts/AnthropicSans-Medium.ttf\") format(\"truetype\"); font-weight:500 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file:///Users/zenray/Library/Fonts/AnthropicSerif-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file:///Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf\") format(\"truetype\"); font-weight:400 }\n  :root { color-scheme:dark }\n  * { box-sizing:border-box }\n  body {\n    margin:0; min-height:100vh; display:grid; place-items:center;\n    background:#242424; color:#f2f2f2;\n    font-family:\"AnthropicSans\", system-ui, sans-serif; font-weight:300;\n  }\n  main { width:min(1500px, calc(100vw - 48px)); text-align:center }\n  .art { display:block; width:min(640px, calc(100vw - 120px)); margin:0 auto 34px;\n         border-radius:8px; box-shadow:0 16px 48px rgba(0,0,0,.28) }\n  .eyebrow { font-weight:500; font-size:13px; letter-spacing:.14em; text-transform:uppercase;\n             color:#cc7c5e; margin:0 0 18px }\n  /* Numbers: always Serif. */\n  .timer { font-family:\"AnthropicSerif\", serif; font-weight:300;\n           font-size:clamp(64px, 12vw, 168px); line-height:1; color:#f4f4f4;\n           font-variant-numeric:tabular-nums; margin:0 }\n  .num { font-family:\"AnthropicSerif\", serif }\n  .head { font-weight:300; font-size:clamp(22px, 2.4vw, 34px); color:#efefef; margin:6px 0 0 }\n  .cap { font-size:15px; color:#8c857d; margin:14px 0 0 }\n  .btn { display:inline-block; margin-top:22px; padding:14px 32px; border-radius:999px;\n         background:#f2f2f2; color:#242424; text-decoration:none; font-weight:500 }\n</style>\n</head>\n<body>\n<main>\n  <img class=\"art\" src=\"file:///Users/zenray/Create/Build/Memory/ArtDirection/output_v3.png\" alt=\"\">\n  <section id=\"waitBox\">\n    <p class=\"eyebrow\">Creator mode</p>\n    <p class=\"timer\" id=\"countdown\">--:--</p>\n    <p class=\"cap\">until this opens</p>\n  </section>\n  <section id=\"rewardBox\" style=\"display:none\">\n    <p class=\"eyebrow\">Creator mode</p>\n    <p class=\"head\">Time's up.</p>\n    <a id=\"rewardLink\" class=\"btn\" href=\"#\">Open now</a>\n    <p class=\"cap\">Open for <span class=\"num\">15</span> min, then it closes.</p>\n  </section>\n  <section id=\"closedBox\" style=\"display:none\">\n    <p class=\"eyebrow\">Creator mode</p>\n    <p class=\"head\">Closed.</p>\n  </section>\n</main>\n<script>\n(function () {\n  var p = new URLSearchParams(location.search);\n  var target = p.get('u') || '';\n  var startedSec = parseInt(p.get('t') || '0', 10) || 0;\n  var WAIT_SECONDS = 0;\n  var waitBox = document.getElementById('waitBox');\n  var rewardBox = document.getElementById('rewardBox');\n  var closedBox = document.getElementById('closedBox');\n  if (!target || !startedSec) { waitBox.style.display = 'none'; closedBox.style.display = 'block'; return; }\n  var el = document.getElementById('countdown');\n  function fmt(s) { var m = Math.floor(s/60), r = s%60; return (m<10?'0':'')+m+':'+(r<10?'0':'')+r; }\n  function tick() {\n    var remain = WAIT_SECONDS - (Math.floor(Date.now()/1000) - startedSec);\n    if (remain <= 0) {\n      waitBox.style.display = 'none';\n      document.getElementById('rewardLink').href =\n        location.pathname + '?u=' + encodeURIComponent(target) + '&t=' + startedSec + '&unlock=1';\n      rewardBox.style.display = 'block';\n      return;\n    }\n    el.textContent = fmt(remain);\n    setTimeout(tick, 1000);\n  }\n  tick();\n})();\n</script>\n</body>\n</html>\n    --socket-timeout 4 --extractor-retries 1 --retries 1 \"$url\" 2>/dev/null || true)\"\n  identity=\"$(printf '%s' \"$json\" | jq -r '\n    [ .channel, .uploader, .channel_id, .uploader_id, .channel_url,\n      .uploader_url, .creator, .webpage_url, .original_url ]\n    | map(select(type == \"string\" and length > 0)) | join(\" \")' 2>/dev/null || true)\"\n\n  [[ -n \"$identity\" ]] && printf '%s\\n' \"$identity\" > \"$cache\"\n  printf '%s\\n' \"$identity\"\n}\n\n\n# --- 7. Reward (grace): temporary earned access, per creator ---------------\n\n# Path of a pattern's reward marker (a safe file name, no shasum fork).\nGraceFileFor() {\n  printf '%s/grace_%s.until' \"$STATE_DIR\" \"$(printf '%s' \"${1:l}\" | tr -c 'a-z0-9' '_')\"\n}\n\n# True if this pattern has a reward that is still valid.\nPatternIsGraced() {\n  local f until; f=\"$(GraceFileFor \"$1\")\"\n  [[ -f \"$f\" ]] || return 1\n  until=\"$(cat \"$f\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ ^[0-9]+$ ]] || return 1\n  [[ \"$(NowEpoch)\" -lt \"$until\" ]]\n}\n\n# Grant REWARD_MINUTES to every entry the target URL triggers, and only those:\n# earning access to one creator never unblocks the others.\nGrantGrace() {\n  local target=\"$1\" ltarget nltarget until i n\n  ltarget=\"${target:l}\"; nltarget=\"$(Normalize \"$target\")\"\n  until=\"$(( $(NowEpoch) + REWARD_MINUTES * 60 ))\"\n  EnsureDirs\n  n=${#BLOCKED_PATTERNS[@]}\n  for (( i = 1; i <= n; i++ )); do\n    if PatternMatches \"${BLOCKED_PATTERNS[i]:l}\" \"${NORMALIZED_PATTERNS[i]}\" \"$ltarget\" \"$nltarget\"; then\n      printf '%s\\n' \"$until\" > \"$(GraceFileFor \"${BLOCKED_PATTERNS[i]}\")\"\n    fi\n  done\n}\n\n# The block-page URL for a target, timestamped (lets the page recompute the\n# time left even after the tab is reloaded).\nGateUrlFor() {\n  printf '%s?u=%s&t=%s' \"$BLOCK_PAGE_URL\" \"$(UrlEncode \"$1\")\" \"$(NowEpoch)\"\n}\n\n\n# --- 8. Block page (the HTML shown in the tab) -----------------------------\n# English, plain tone. Numbers in Anthropic Serif, text in Anthropic Sans.\n\nEnsureBlockPage() {\n  EnsureDirs\n  local F=\"/Users/zenray/Library/Fonts\"\n  cat > \"$BLOCK_PAGE_FILE\" <<HTML\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Blocked</title>\n<style>\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Medium.ttf\") format(\"truetype\"); font-weight:500 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Regular.ttf\") format(\"truetype\"); font-weight:400 }\n  :root { color-scheme:dark }\n  * { box-sizing:border-box }\n  body {\n    margin:0; min-height:100vh; display:grid; place-items:center;\n    background:#242424; color:#f2f2f2;\n    font-family:\"AnthropicSans\", system-ui, sans-serif; font-weight:300;\n  }\n  main { width:min(1500px, calc(100vw - 48px)); text-align:center }\n  .art { display:block; width:min(640px, calc(100vw - 120px)); margin:0 auto 34px;\n         border-radius:8px; box-shadow:0 16px 48px rgba(0,0,0,.28) }\n  .eyebrow { font-weight:500; font-size:13px; letter-spacing:.14em; text-transform:uppercase;\n             color:#cc7c5e; margin:0 0 18px }\n  /* Numbers: always Serif. */\n  .timer { font-family:\"AnthropicSerif\", serif; font-weight:300;\n           font-size:clamp(64px, 12vw, 168px); line-height:1; color:#f4f4f4;\n           font-variant-numeric:tabular-nums; margin:0 }\n  .num { font-family:\"AnthropicSerif\", serif }\n  .head { font-weight:300; font-size:clamp(22px, 2.4vw, 34px); color:#efefef; margin:6px 0 0 }\n  .cap { font-size:15px; color:#8c857d; margin:14px 0 0 }\n  .btn { display:inline-block; margin-top:22px; padding:14px 32px; border-radius:999px;\n         background:#f2f2f2; color:#242424; text-decoration:none; font-weight:500 }\n</style>\n</head>\n<body>\n<main>\n  <img class=\"art\" src=\"$ILLUSTRATION_URL\" alt=\"\">\n  <section id=\"waitBox\">\n    <p class=\"eyebrow\">Creator mode</p>\n    <p class=\"timer\" id=\"countdown\">--:--</p>\n    <p class=\"cap\">until this opens</p>\n  </section>\n  <section id=\"rewardBox\" style=\"display:none\">\n    <p class=\"eyebrow\">Creator mode</p>\n    <p class=\"head\">Time's up.</p>\n    <a id=\"rewardLink\" class=\"btn\" href=\"#\">Open now</a>\n    <p class=\"cap\">Open for <span class=\"num\">$REWARD_MINUTES</span> min, then it closes.</p>\n  </section>\n  <section id=\"closedBox\" style=\"display:none\">\n    <p class=\"eyebrow\">Creator mode</p>\n    <p class=\"head\">Closed.</p>\n  </section>\n</main>\n<script>\n(function () {\n  var p = new URLSearchParams(location.search);\n  var target = p.get('u') || '';\n  var startedSec = parseInt(p.get('t') || '0', 10) || 0;\n  var WAIT_SECONDS = $((WAIT_MINUTES * 60));\n  var waitBox = document.getElementById('waitBox');\n  var rewardBox = document.getElementById('rewardBox');\n  var closedBox = document.getElementById('closedBox');\n  if (!target || !startedSec) { waitBox.style.display = 'none'; closedBox.style.display = 'block'; return; }\n  var el = document.getElementById('countdown');\n  function fmt(s) { var m = Math.floor(s/60), r = s%60; return (m<10?'0':'')+m+':'+(r<10?'0':'')+r; }\n  function tick() {\n    var remain = WAIT_SECONDS - (Math.floor(Date.now()/1000) - startedSec);\n    if (remain <= 0) {\n      waitBox.style.display = 'none';\n      document.getElementById('rewardLink').href =\n        location.pathname + '?u=' + encodeURIComponent(target) + '&t=' + startedSec + '&unlock=1';\n      rewardBox.style.display = 'block';\n      return;\n    }\n    el.textContent = fmt(remain);\n    setTimeout(tick, 1000);\n  }\n  tick();\n})();\n</script>\n</body>\n</html>\nHTML\n  chmod 644 \"$BLOCK_PAGE_FILE\" 2>/dev/null || true\n}\n\n\n# --- 9. Browser control ----------------------------------------------------\n\n# List open tabs as \"browser<TAB>window<TAB>tab<TAB>url\" per line. One osascript\n# per RUNNING browser (pgrep), so we never name an app that is not installed\n# (which would pop a blocking \"Where is X?\" dialog), and a browser that fails\n# does not stop us from reading the others.\nListBrowserTabs() {\n  local b\n  for b in \"${CHROMIUM_BROWSERS[@]}\"; do\n    pgrep -x \"$b\" >/dev/null 2>&1 || continue\n    osascript <<APPLESCRIPT 2>/dev/null || true\nset Output to \"\"\nset T to ASCII character 9\nusing terms from application \"Google Chrome\"\n  tell application \"$b\"\n    repeat with W from 1 to (count of windows)\n      repeat with I from 1 to (count of tabs of window W)\n        try\n          set Output to Output & \"$b\" & T & W & T & I & T & (URL of tab I of window W as text) & linefeed\n        end try\n      end repeat\n    end repeat\n  end tell\nend using terms from\nreturn Output\nAPPLESCRIPT\n  done\n  if pgrep -x \"Safari\" >/dev/null 2>&1; then\n    osascript <<'APPLESCRIPT' 2>/dev/null || true\nset Output to \"\"\nset T to ASCII character 9\ntell application \"Safari\"\n  repeat with W from 1 to (count of windows)\n    repeat with I from 1 to (count of tabs of window W)\n      try\n        set Output to Output & \"Safari\" & T & W & T & I & T & (URL of tab I of window W as text) & linefeed\n      end try\n    end repeat\n  end repeat\nend tell\nreturn Output\nAPPLESCRIPT\n  fi\n}\n\n# Change one specific tab's URL (to the block page, or to the real content when\n# a reward is granted). Chromium through \"using terms from\", Safari natively.\nRedirectBrowserTab() {\n  local browser=\"$1\" windowIndex=\"$2\" tabIndex=\"$3\" destUrl=\"$4\"\n  osascript - \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$destUrl\" <<'APPLESCRIPT' >/dev/null 2>&1 || true\non run argv\n  set BrowserName to item 1 of argv\n  set W to (item 2 of argv) as integer\n  set I to (item 3 of argv) as integer\n  set DestUrl to item 4 of argv\n  if BrowserName is \"Safari\" then\n    tell application \"Safari\" to set URL of tab I of window W to DestUrl\n  else\n    using terms from application \"Google Chrome\"\n      tell application BrowserName to set URL of tab I of window W to DestUrl\n    end using terms from\n  end if\nend run\nAPPLESCRIPT\n}\n\n# Decide and act for ONE tab (deep pass):\n#  - already on the block page with unlock=1 (button clicked, wait elapsed)\n#    -> grant the reward and open the real content;\n#  - on a social network pointing at a blocked creator -> switch to the block\n#    page (with the target and the countdown start time).\nHandleTab() {\n  local browser=\"$1\" windowIndex=\"$2\" tabIndex=\"$3\" url=\"$4\"\n\n  # YouTube daytime gate page: a click on \"Ask for time\" carries askfortime=1.\n  if [[ \"$url\" == \"$YT_BLOCK_PAGE_URL\"* ]]; then\n    [[ \"$url\" == *\"askfortime=1\"* ]] || return 0\n    local ytTarget; ytTarget=\"$(ExtractParam \"$url\" u)\"\n    [[ -n \"$ytTarget\" ]] || ytTarget=\"https://www.youtube.com\"\n    if GrantYouTubeTime; then\n      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$ytTarget\"\n    else\n      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(YouTubeGateUrlFor \"$ytTarget\")\"\n    fi\n    return 0\n  fi\n\n  if [[ \"$url\" == \"$BLOCK_PAGE_URL\"* ]]; then\n    [[ \"$url\" == *\"unlock=1\"* ]] || return 0\n    local target startedAt\n    target=\"$(ExtractParam \"$url\" u)\"\n    startedAt=\"$(ExtractParam \"$url\" t)\"\n    [[ -n \"$target\" ]] || return 0\n    if [[ \"$startedAt\" =~ ^[0-9]+$ && $(( $(NowEpoch) - startedAt )) -ge $(( WAIT_MINUTES * 60 )) ]]; then\n      GrantGrace \"$target\"\n      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$target\"\n    else\n      # Early or malformed unlock: restart from an honest countdown.\n      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(GateUrlFor \"$target\")\"\n    fi\n    return 0\n  fi\n\n  local lurl=\"${url:l}\"\n  case \"$lurl\" in\n    *youtube.com*|*youtu.be*|*instagram.com*|*tiktok.com*|*facebook.com*|*fb.watch*|*twitter.com*|*x.com*) ;;\n    *) return 0 ;;\n  esac\n\n  local identity=\"$url\"\n  if [[ \"$lurl\" == *youtube.com* || \"$lurl\" == *youtu.be* ]]; then\n    identity=\"$(YouTubeIdentityForUrl \"$url\" || true)\"\n    [[ -n \"$identity\" ]] || identity=\"$url\"\n  fi\n\n  if TextMatchesBlocked \"$identity\"; then\n    RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(GateUrlFor \"$url\")\"\n    return 0\n  fi\n\n  # Not a specific blocked creator: still subject to the daytime YouTube gate