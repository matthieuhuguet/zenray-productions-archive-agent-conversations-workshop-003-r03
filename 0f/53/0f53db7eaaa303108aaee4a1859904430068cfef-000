{"timestamp":"2026-08-12T05:28:13.456Z","ordinal":69,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019ff471-4b90-7072-ad0e-032c149ee4db","call_id":"call_GS7MOgeDk2r3sQmkBdrDQtH8","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"  IsSuspended && return 1\n  IsProtectedNow\n}\n\n# Is a browser the frontmost app? The fast pass only runs then: while Matthieu\n# works in Houdini or Unreal there is no visible tab to flash, so we stay idle.\nBrowserIsFrontmost() {\n  local front\n  front=\"$(lsappinfo info -only name \"$(lsappinfo front 2>/dev/null)\" 2>/dev/null)\"\n  case \"$front\" in\n    *\"Google Chrome\"*|*Safari*|*\"Brave Browser\"*|*\"Microsoft Edge\"*|*Vivaldi*|*Opera*|*Chromium*) return 0 ;;\n    *) return 1 ;;\n  esac\n}\n\n\n# --- 5b. YouTube daytime gate -----------------------------------------------\n#\n# Independent from the creator list: between YT_DAY_START_HOUR and\n# YT_DAY_END_HOUR, every youtube.com/youtu.be tab is closed by default.\n# \"Ask for time\" grants access immediately (no wait), for the next value in\n# YT_GRANT_MINUTES; each click consumes one rung of the ladder. Once the\n# ladder is spent, YouTube stays closed until the ladder resets at midnight.\n\nEnsureYouTubeDayState() {\n  EnsureDirs\n  local today; today=\"$(date '+%Y-%m-%d')\"\n  if [[ \"$(cat \"$YT_DAY_FILE\" 2>/dev/null || true)\" != \"$today\" ]]; then\n    printf '%s\\n' \"$today\" > \"$YT_DAY_FILE\"\n    printf '0\\n' > \"$YT_GRANTS_USED_FILE\"\n    printf '0\\n' > \"$YT_UNTIL_FILE\"\n  fi\n  [[ -f \"$YT_GRANTS_USED_FILE\" ]] || printf '0\\n' > \"$YT_GRANTS_USED_FILE\"\n  [[ -f \"$YT_UNTIL_FILE\" ]] || printf '0\\n' > \"$YT_UNTIL_FILE\"\n}\n\nIsYouTubeDayWindow() {\n  local hour; hour=\"$(date '+%H')\"; hour=\"${hour#0}\"; [[ -z \"$hour\" ]] && hour=0\n  [[ \"$hour\" -ge \"$YT_DAY_START_HOUR\" && \"$hour\" -lt \"$YT_DAY_END_HOUR\" ]]\n}\n\nYouTubeGrantsUsedToday() {\n  EnsureYouTubeDayState\n  cat \"$YT_GRANTS_USED_FILE\" 2>/dev/null || printf '0'\n}\n\n# Minutes the NEXT \"Ask for time\" click would grant; 0 once spent for today.\nNextYouTubeGrantMinutes() {\n  local used; used=\"$(YouTubeGrantsUsedToday)\"\n  [[ \"$used\" =~ ^[0-9]+$ ]] || used=0\n  if (( used < ${#YT_GRANT_MINUTES[@]} )); then\n    printf '%s\\n' \"${YT_GRANT_MINUTES[used+1]}\"\n  else\n    printf '0\\n'\n  fi\n}\n\nYouTubeAccessGranted() {\n  EnsureYouTubeDayState\n  local until; until=\"$(cat \"$YT_UNTIL_FILE\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ ^[0-9]+$ ]] || return 1\n  [[ \"$(NowEpoch)\" -lt \"$until\" ]]\n}\n\n# Should the daytime YouTube gate fire right now?\nShouldBlockYouTubeDay() {\n  IsDisabled  && return 1\n  IsSuspended && return 1\n  EnsureYouTubeDayState\n  IsYouTubeDayWindow || return 1\n  YouTubeAccessGranted && return 1\n  return 0\n}\n\n# Consumes the next rung of the ladder and opens access for that many\n# minutes. Returns non-zero if the ladder is already spent for today.\nGrantYouTubeTime() {\n  EnsureYouTubeDayState\n  local minutes; minutes=\"$(NextYouTubeGrantMinutes)\"\n  [[ \"$minutes\" -gt 0 ]] || return 1\n  local used; used=\"$(YouTubeGrantsUsedToday)\"\n  printf '%s\\n' \"$(( used + 1 ))\" > \"$YT_GRANTS_USED_FILE\"\n  printf '%s\\n' \"$(( $(NowEpoch) + minutes * 60 ))\" > \"$YT_UNTIL_FILE\"\n  return 0\n}\n\nYouTubeGateUrlFor() {\n  printf '%s?u=%s&remaining=%s' \"$YT_BLOCK_PAGE_URL\" \"$(UrlEncode \"$1\")\" \"$(NextYouTubeGrantMinutes)\"\n}\n\n# The block page. Same visual language as the creator block page. The button\n# label and remaining minutes come from the \"remaining\" query param so the\n# page never needs regenerating between grants.\nEnsureYouTubeDayBlockPage() {\n  EnsureDirs\n  local F=\"/Users/zenray/Library/Fonts\"\n  cat > \"$YT_BLOCK_PAGE_FILE\" <<HTML\n<!doctype html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>YouTube bloqué</title>\n<style>\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Medium.ttf\") format(\"truetype\"); font-weight:500 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Regular.ttf\") format(\"truetype\"); font-weight:400 }\n  :root { color-scheme:dark }\n  * { box-sizing:border-box }\n  body {\n  identity=\"$(printf '%s' \"$json\" | jq -r '\n    [ .channel, .uploader, .channel_id, .uploader_id, .channel_url,\n      .uploader_url, .creator, .webpage_url, .original_url ]\n    | map(select(type == \"string\" and length > 0)) | join(\" \")' 2>/dev/null || true)\"\n\n  [[ -n \"$identity\" ]] && printf '%s\\n' \"$identity\" > \"$cache\"\n  printf '%s\\n' \"$identity\"\n}\n\n\n# --- 7. Reward (grace): temporary earned access, per creator ---------------\n\n# Path of a pattern's reward marker (a safe file name, no shasum fork).\nGraceFileFor() {\n  printf '%s/grace_%s.until' \"$STATE_DIR\" \"$(printf '%s' \"${1:l}\" | tr -c 'a-z0-9' '_')\"\n}\n\n# True if this pattern has a reward that is still valid.\nPatternIsGraced() {\n  local f until; f=\"$(GraceFileFor \"$1\")\"\n  [[ -f \"$f\" ]] || return 1\n  until=\"$(cat \"$f\" 2>/dev/null || printf '0')\"\n  [[ \"$until\" =~ ^[0-9]+$ ]] || return 1\n  [[ \"$(NowEpoch)\" -lt \"$until\" ]]\n}\n\n# Grant REWARD_MINUTES to every entry the target URL triggers, and only those:\n# earning access to one creator never unblocks the others.\nGrantGrace() {\n  local target=\"$1\" ltarget nltarget until i n\n  ltarget=\"${target:l}\"; nltarget=\"$(Normalize \"$target\")\"\n  until=\"$(( $(NowEpoch) + REWARD_MINUTES * 60 ))\"\n  EnsureDirs\n  n=${#BLOCKED_PATTERNS[@]}\n  for (( i = 1; i <= n; i++ )); do\n    if PatternMatches \"${BLOCKED_PATTERNS[i]:l}\" \"${NORMALIZED_PATTERNS[i]}\" \"$ltarget\" \"$nltarget\"; then\n      printf '%s\\n' \"$until\" > \"$(GraceFileFor \"${BLOCKED_PATTERNS[i]}\")\"\n    fi\n  done\n}\n\n# The block-page URL for a target, timestamped (lets the page recompute the\n# time left even after the tab is reloaded).\nGateUrlFor() {\n  printf '%s?u=%s&t=%s' \"$BLOCK_PAGE_URL\" \"$(UrlEncode \"$1\")\" \"$(NowEpoch)\"\n}\n\n\n# --- 8. Block page (the HTML shown in the tab) -----------------------------\n# English, plain tone. Numbers in Anthropic Serif, text in Anthropic Sans.\n\nEnsureBlockPage() {\n  EnsureDirs\n  local F=\"/Users/zenray/Library/Fonts\"\n  cat > \"$BLOCK_PAGE_FILE\" <<HTML\n<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Blocked</title>\n<style>\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSans\"; src:url(\"file://$F/AnthropicSans-Medium.ttf\") format(\"truetype\"); font-weight:500 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Light.ttf\") format(\"truetype\"); font-weight:300 }\n  @font-face { font-family:\"AnthropicSerif\"; src:url(\"file://$F/AnthropicSerif-Regular.ttf\") format(\"truetype\"); font-weight:400 }\n  :root { color-scheme:dark }\n  * { box-sizing:border-box }\n  body {\n    margin:0; min-height:100vh; display:grid; place-items:center;\n    background:#242424; color:#f2f2f2;\n    font-family:\"AnthropicSans\", system-ui, sans-serif; font-weight:300;\n  }\n  main { width:min(1500px, calc(100vw - 48px)); text-align:center }\n  .art { display:block; width:min(640px, calc(100vw - 120px)); margin:0 auto 34px;\n         border-radius:8px; box-shadow:0 16px 48px rgba(0,0,0,.28) }\n  .eyebrow { font-weight:500; font-size:13px; letter-spacing:.14em; text-transform:uppercase;\n             color:#cc7c5e; margin:0 0 18px }\n  /* Numbers: always Serif. */\n  .timer { font-family:\"AnthropicSerif\", serif; font-weight:300;\n           font-size:clamp(64px, 12vw, 168px); line-height:1; color:#f4f4f4;\n           font-variant-numeric:tabular-nums; margin:0 }\n  .num { font-family:\"AnthropicSerif\", serif }\n  .head { font-weight:300; font-size:clamp(22px, 2.4vw, 34px); color:#efefef; margin:6px 0 0 }\n  .cap { font-size:15px; color:#8c857d; margin:14px 0 0 }\n  .btn { display:inline-block; margin-top:22px; padding:14px 32px; border-radius:999px;\n         background:#f2f2f2; color:#242424; text-decoration:none; font-weight:500 }\n</style>\n</head>\n<body>\n<main>\n  <img class=\"art\" src=\"$ILLUSTRATION_URL\" alt=\"\">\n  <section id=\"waitBox\">\n    <p class=\"eyebrow\">Creator mode</p>\n    <p class=\"timer\" id=\"countdown\">--:--</p>\n    <p class=\"cap\">until this opens</p>\n  </section>\n  <section id=\"rewardBox\" style=\"display:none\">\n    <p class=\"eyebrow\">Creator mode</p>\n    <p class=\"head\">Time's up.</p>\n    <a id=\"rewardLink\" class=\"btn\" href=\"#\">Open now</a>\n    <p class=\"cap\">Open for <span class=\"num\">$REWARD_MINUTES</span> min, then it closes.</p>\n  </section>\n  <section id=\"closedBox\" style=\"display:none\">\n    <p class=\"eyebrow\">Creator mode</p>\n    <p class=\"head\">Closed.</p>\n  </section>\n</main>\n<script>\n(function () {\n  var p = new URLSearchParams(location.search);\n  var target = p.get('u') || '';\n  var startedSec = parseInt(p.get('t') || '0', 10) || 0;\n  var WAIT_SECONDS = $((WAIT_MINUTES * 60));\n  var waitBox = document.getElementById('waitBox');\n  var rewardBox = document.getElementById('rewardBox');\n  var closedBox = document.getElementById('closedBox');\n  if (!target || !startedSec) { waitBox.style.display = 'none'; closedBox.style.display = 'block'; return; }\n  var el = document.getElementById('countdown');\n  function fmt(s) { var m = Math.floor(s/60), r = s%60; return (m<10?'0':'')+m+':'+(r<10?'0':'')+r; }\n  function tick() {\n    var remain = WAIT_SECONDS - (Math.floor(Date.now()/1000) - startedSec);\n    if (remain <= 0) {\n      waitBox.style.display = 'none';\n      document.getElementById('rewardLink').href =\n        location.pathname + '?u=' + encodeURIComponent(target) + '&t=' + startedSec + '&unlock=1';\n      rewardBox.style.display = 'block';\n      return;\n    }\n    el.textContent = fmt(remain);\n    setTimeout(tick, 1000);\n  }\n  tick();\n})();\n</script>\n</body>\n</html>\nHTML\n  chmod 644 \"$BLOCK_PAGE_FILE\" 2>/dev/null || true\n}\n\n\n# --- 9. Browser control ----------------------------------------------------\n\n# List open tabs as \"browser<TAB>window<TAB>tab<TAB>url\" per line. One osascript\n# per RUNNING browser (pgrep), so we never name an app that is not installed\n# (which would pop a blocking \"Where is X?\" dialog), and a browser that fails\n# does not stop us from reading the others.\nListBrowserTabs() {\n  local b\n  for b in \"${CHROMIUM_BROWSERS[@]}\"; do\n    pgrep -x \"$b\" >/dev/null 2>&1 || continue\n    osascript <<APPLESCRIPT 2>/dev/null || true\nset Output to \"\"\nset T to ASCII character 9\nusing terms from application \"Google Chrome\"\n  tell application \"$b\"\n    repeat with W from 1 to (count of windows)\n      repeat with I from 1 to (count of tabs of window W)\n        try\n          set Output to Output & \"$b\" & T & W & T & I & T & (URL of tab I of window W as text) & linefeed\n        end try\n      end repeat\n    end repeat\n  end tell\nend using terms from\nreturn Output\nAPPLESCRIPT\n  done\n  if pgrep -x \"Safari\" >/dev/null 2>&1; then\n    osascript <<'APPLESCRIPT' 2>/dev/null || true\nset Output to \"\"\nset T to ASCII character 9\ntell application \"Safari\"\n  repeat with W from 1 to (count of windows)\n    repeat with I from 1 to (count of tabs of window W)\n      try\n        set Output to Output & \"Safari\" & T & W & T & I & T & (URL of tab I of window W as text) & linefeed\n      end try\n    end repeat\n  end repeat\nend tell\nreturn Output\nAPPLESCRIPT\n  fi\n}\n\n# Change one specific tab's URL (to the block page, or to the real content when\n# a reward is granted). Chromium through \"using terms from\", Safari natively.\nRedirectBrowserTab() {\n  local browser=\"$1\" windowIndex=\"$2\" tabIndex=\"$3\" destUrl=\"$4\"\n  osascript - \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$destUrl\" <<'APPLESCRIPT' >/dev/null 2>&1 || true\non run argv\n  set BrowserName to item 1 of argv\n  set W to (item 2 of argv) as integer\n  set I to (item 3 of argv) as integer\n  set DestUrl to item 4 of argv\n  if BrowserName is \"Safari\" then\n    tell application \"Safari\" to set URL of tab I of window W to DestUrl\n  else\n    using terms from application \"Google Chrome\"\n      tell application BrowserName to set URL of tab I of window W to DestUrl\n    end using terms from\n  end if\nend run\nAPPLESCRIPT\n}\n\n# Decide and act for ONE tab (deep pass):\n#  - already on the block page with unlock=1 (button clicked, wait elapsed)\n#    -> grant the reward and open the real content;\n#  - on a social network pointing at a blocked creator -> switch to the block\n#    page (with the target and the countdown start time).\nHandleTab() {\n  local browser=\"$1\" windowIndex=\"$2\" tabIndex=\"$3\" url=\"$4\"\n\n  # YouTube daytime gate page: a click on \"Ask for time\" carries askfortime=1.\n  if [[ \"$url\" == \"$YT_BLOCK_PAGE_URL\"* ]]; then\n    [[ \"$url\" == *\"askfortime=1\"* ]] || return 0\n    local ytTarget; ytTarget=\"$(ExtractParam \"$url\" u)\"\n    [[ -n \"$ytTarget\" ]] || ytTarget=\"https://www.youtube.com\"\n    if GrantYouTubeTime; then\n      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$ytTarget\"\n    else\n      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(YouTubeGateUrlFor \"$ytTarget\")\"\n    fi\n    return 0\n  fi\n\n  if [[ \"$url\" == \"$BLOCK_PAGE_URL\"* ]]; then\n    [[ \"$url\" == *\"unlock=1\"* ]] || return 0\n    local target startedAt\n    target=\"$(ExtractParam \"$url\" u)\"\n    startedAt=\"$(ExtractParam \"$url\" t)\"\n    [[ -n \"$target\" ]] || return 0\n    if [[ \"$startedAt\" =~ ^[0-9]+$ && $(( $(NowEpoch) - startedAt )) -ge $(( WAIT_MINUTES * 60 )) ]]; then\n      GrantGrace \"$target\"\n      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$target\"\n    else\n      # Early or malformed unlock: restart from an honest countdown.\n      RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(GateUrlFor \"$target\")\"\n    fi\n    return 0\n  fi\n\n  local lurl=\"${url:l}\"\n  case \"$lurl\" in\n    *youtube.com*|*youtu.be*|*instagram.com*|*tiktok.com*|*facebook.com*|*fb.watch*|*twitter.com*|*x.com*) ;;\n    *) return 0 ;;\n  esac\n\n  local identity=\"$url\"\n  if [[ \"$lurl\" == *youtube.com* || \"$lurl\" == *youtu.be* ]]; then\n    identity=\"$(YouTubeIdentityForUrl \"$url\" || true)\"\n    [[ -n \"$identity\" ]] || identity=\"$url\"\n  fi\n\n  if TextMatchesBlocked \"$identity\"; then\n    RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(GateUrlFor \"$url\")\"\n    return 0\n  fi\n\n  # Not a specific blocked creator: still subject to the daytime YouTube gate.\n  if [[ \"$lurl\" == *youtube.com* || \"$lurl\" == *youtu.be* ]] && ShouldBlockYouTubeDay; then\n    RedirectBrowserTab \"$browser\" \"$windowIndex\" \"$tabIndex\" \"$(YouTubeGateUrlFor \"$url\")\"\n  fi\n}\n\n# One full sweep over every tab of every running browser (deep pass).\nEnforceTabs() {\n  local browser windowIndex tabIndex url\n    script+='    end repeat'$'\\n'\n    script+='  end try'$'\\n'\n    script+='end tell'$'\\n'\n  fi\n\n  (( hasTarget )) || return 0\n  print -r -- \"$script\" | osascript - >/dev/null 2>&1 || true\n}\n\n\n# --- 11. Watch loop --------------------------------------------------------\n\n# Single pass (also used by the root layer, which cleans hosts/policy).\nEnforce() {\n  EnsureSecret\n  ShouldBlock && EnforceTabs\n  RemoveHostsBlock\n  RemoveChromePolicy\n}\n\n# The background service. Adaptive:\n#  - browser frontmost -> fast pass every FAST_SLEEP, deep pass every DEEP_EVERY;\n#  - browser in the background -> just a deep pass every second (no frame to\n#    hide, so no need to burn CPU polling);\n#  - out of the active window -> idle a minute.\nWatchTabs() {\n  EnsureSecret\n  local i=0\n  while true; do\n    if ! ShouldBlock; then sleep 60; continue; fi\n    # A hiccup in one pass must never kill the loop (KeepAlive would just\n    # restart it in a churn); swallow non-zero and keep going.\n    if BrowserIsFrontmost; then\n      FastPassActiveTabs || true\n      if (( i % DEEP_EVERY == 0 )); then EnforceTabs || true; fi\n      i=$(( (i + 1) % 1000000 ))\n      sleep \"$FAST_SLEEP\"\n    else\n      EnforceTabs || true\n      i=0\n      sleep 1\n    fi\n  done\n}\n\n\n# --- 12. Install -----------------------------------------------------------\n\nWriteUserPlist() {\n  mkdir -p \"$HOME/Library/LaunchAgents\" \"$HOME/Library/Logs\"\n  cat > \"$USER_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>Label</key><string>$USER_LABEL</string>\n  <key>ProgramArguments</key>\n  <array><string>$SCRIPT_PATH</string><string>watch-tabs</string></array>\n  <key>RunAtLoad</key><true/>\n  <key>KeepAlive</key><true/>\n  <key>StandardOutPath</key><string>$USER_LOG</string>\n  <key>StandardErrorPath</key><string>$USER_ERR_LOG</string>\n</dict>\n</plist>\nPLIST\n  plutil -lint \"$USER_PLIST\" >/dev/null\n}\n\nInstallUser() {\n  EnsureSecret\n  WriteUserPlist\n  chmod 644 \"$USER_PLIST\" 2>/dev/null || true\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  # macOS keeps a per-LABEL \"disabled\" flag, separate from our own\n  # DISABLED_FILE: if this guard was ever stopped, that bit sticks and makes\n  # the load fail (I/O error) until we explicitly clear it here.\n  launchctl enable \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 || true\n  launchctl bootstrap \"gui/$(id -u)\" \"$USER_PLIST\"\n  Say \"User tab guard installed.\"\n}\n\nUninstallUser() {\n  RequireGuardPassword\n  launchctl bootout \"gui/$(id -u)\" \"$USER_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$USER_PLIST\"\n  Say \"User tab guard uninstalled.\"\n}\n\n# Optional root layer: /etc/hosts + Chrome policy (with IncognitoModeAvailability=1,\n# which forces normal windows, so the watcher can see them).\n\nFlushDns() { dscacheutil -flushcache 2>/dev/null || true; killall -HUP mDNSResponder 2>/dev/null || true; }\n\nStripHostsBlock() {\n  awk -v s=\"$HOSTS_MARK_START\" -v e=\"$HOSTS_MARK_END\" \\\n    '$0==s{skip=1;next} $0==e{skip=0;next} skip!=1{print}' \"$1\"\n}\n\nApplyHostsBlock() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp; tmp=\"$(mktemp)\"\n  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"\n  { cat \"$tmp\"; printf '\\n%s\\n' \"$HOSTS_MARK_START\"\n    local d; for d in \"${HOST_DOMAINS[@]}\"; do printf '0.0.0.0\\t%s\\n::1\\t%s\\n' \"$d\" \"$d\"; done\n    printf '%s\\n' \"$HOSTS_MARK_END\"; } > \"$tmp.new\"\n  cp \"$tmp.new\" \"$HOSTS_FILE\"; rm -f \"$tmp\" \"$tmp.new\"; FlushDns\n}\n\nRemoveHostsBlock() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp; tmp=\"$(mktemp)\"\n  StripHostsBlock \"$HOSTS_FILE\" > \"$tmp\"; cp \"$tmp\" \"$HOSTS_FILE\"; rm -f \"$tmp\"; FlushDns\n}\n\n# URL-shaped entries -> Chrome URLBlocklist entries (also covers incognito).\nBuildChromeBlocklist() {\n  CHROME_BLOCKLIST=(); local p\n  for p in \"${BLOCKED_PATTERNS[@]}\"; do [[ \"$p\" == *\"/\"* ]] && CHROME_BLOCKLIST+=(\"$p\"); done\n}\n\nApplyChromePolicy() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  local tmp entry; BuildChromeBlocklist\n  mkdir -p \"/Library/Managed Preferences\"\n  if [[ ! -f \"$CHROME_POLICY_MARKER\" ]]; then\n    if [[ -f \"$CHROME_POLICY_FILE\" ]]; then cp \"$CHROME_POLICY_FILE\" \"$CHROME_POLICY_BACKUP\"; printf 'existed\\n' > \"$CHROME_POLICY_MARKER\"\n    else printf 'absent\\n' > \"$CHROME_POLICY_MARKER\"; fi\n  fi\n  tmp=\"$(mktemp)\"\n  cat > \"$tmp\" <<'PLIST'\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>IncognitoModeAvailability</key><integer>1</integer>\n  <key>URLBlocklist</key>\n  <array>\nPLIST\n  for entry in \"${CHROME_BLOCKLIST[@]}\"; do printf '    <string>%s</string>\\n' \"$entry\" >> \"$tmp\"; done\n  printf '  </array>\\n</dict>\\n</plist>\\n' >> \"$tmp\"\n  plutil -lint \"$tmp\" >/dev/null\n  cp \"$tmp\" \"$CHROME_POLICY_FILE\"; rm -f \"$tmp\"\n  chown root:wheel \"$CHROME_POLICY_FILE\"; chmod 644 \"$CHROME_POLICY_FILE\"\n  plutil -lint \"$CHROME_POLICY_FILE\" >/dev/null\n}\n\nRemoveChromePolicy() {\n  [[ \"$EUID\" -eq 0 ]] || return 0\n  [[ -f \"$CHROME_POLICY_MARKER\" ]] || return 0\n  local state; state=\"$(cat \"$CHROME_POLICY_MARKER\" 2>/dev/null || printf 'absent')\"\n  if [[ \"$state\" == \"existed\" && -f \"$CHROME_POLICY_BACKUP\" ]]; then cp \"$CHROME_POLICY_BACKUP\" \"$CHROME_POLICY_FILE\"\n  else rm -f \"$CHROME_POLICY_FILE\"; fi\n}\n\nWriteRootPlist() {\n  [[ \"$EUID\" -eq 0 ]] || { Say \"Root install needs admin rights.\"; exit 1; }\n  cat > \"$ROOT_PLIST\" <<PLIST\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n  <key>Label</key><string>$ROOT_LABEL</string>\n  <key>ProgramArguments</key>\n  <array><string>$SCRIPT_PATH</string><string>enforce</string></array>\n  <key>RunAtLoad</key><true/>\n  <key>StartInterval</key><integer>60</integer>\n  <key>StandardOutPath</key><string>/var/log/SocialMediaGuard.log</string>\n  <key>StandardErrorPath</key><string>/var/log/SocialMediaGuard.err.log</string>\n</dict>\n</plist>\nPLIST\n  chown root:wheel \"$ROOT_PLIST\"; chmod 644 \"$ROOT_PLIST\"; plutil -lint \"$ROOT_PLIST\" >/dev/null\n}\n\nInstallRoot() { EnsureSecret; CleanupRoot; }\n\nCleanupRoot() {\n  [[ \"$EUID\" -eq 0 ]] || { Say \"Root cleanup needs admin rights.\"; exit 1; }\n  RemoveHostsBlock; RemoveChromePolicy\n  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$ROOT_PLIST\"\n  Say \"Root network guard removed. UI guard is active through the user agent.\"\n}\n\nUninstallRoot() {\n  RequireGuardPassword\n  [[ \"$EUID\" -eq 0 ]] || { Say \"Root uninstall needs admin rights.\"; exit 1; }\n  RemoveHostsBlock; RemoveChromePolicy\n  launchctl bootout system \"$ROOT_PLIST\" >/dev/null 2>&1 || true\n  rm -f \"$ROOT_PLIST\"\n  Say \"Root host guard uninstalled.\"\n}\n\n\n# --- 13. Commands ----------------------------------------------------------\n\nSuspend() {\n  RequireGuardPassword\n  local minutes=\"${1:-30}\"\n  [[ \"$minutes\" =~ '^[0-9]+$' ]] || { Say \"Minutes must be a number.\"; exit 1; }\n  EnsureDirs\n  printf '%s\\n' \"$(( $(NowEpoch) + minutes * 60 ))\" > \"$SUSPEND_FILE\"\n  Enforce\n  Say \"Guard suspended for $minutes minutes.\"\n}\n\nDisable() {\n  RequireGuardPassword\n  EnsureDirs\n  date '+%Y-%m-%d %H:%M:%S' > \"$DISABLED_FILE\"\n  Enforce\n  Say \"Guard disabled.\"\n}\n\nEnable() {\n  EnsureDirs\n  rm -f \"$DISABLED_FILE\" \"$SUSPEND_FILE\"\n  Enforce\n  Say \"Guard enabled.\"\n}\n\nStatus() {\n  local userLoaded=\"no\" rootLoaded=\"no\" chromePolicy=\"no\"\n  launchctl print \"gui/$(id -u)/$USER_LABEL\" >/dev/null 2>&1 && userLoaded=\"yes\"\n  launchctl print \"system/$ROOT_LABEL\"        >/dev/null 2>&1 && rootLoaded=\"yes\"\n  [[ -f \"$CHROME_POLICY_FILE\" ]] && /usr/libexec/PlistBuddy -c \"Print :URLBlocklist\" \"$CHROME_POLICY_FILE\" >/dev/null 2>&1 && chromePolicy=\"yes\"\n\n  Say \"protected_hours=$(IsProtectedNow && printf yes || printf no)\"\n  Say \"disabled=$(IsDisabled && printf yes || printf no)\"\n  Say \"suspended=$(IsSuspended && printf yes || printf no)\"\n  Say \"user_tab_guard_loaded=$userLoaded\"\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019ff470-03a7-7060-89c6-59955e678551"}}}
