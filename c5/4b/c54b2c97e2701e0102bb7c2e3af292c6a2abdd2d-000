'image/avif', '.woff2': 'font/woff2', '.ico': 'image/x-icon' }\n\nconst adaptRes = (res) => {\n  res.status = (c) => { res.statusCode = c; return res }\n  res.json = (o) => { res.setHeader('content-type', 'application/json'); res.end(JSON.stringify(o)); return res }\n  res.send = (d) => { res.end(d); return res }\n  return res\n}\n\n// ─── TRANSCODAGE VIDÉO NATIF (Phase 3) ────────────────────────────────────────────────────────────────\n// Drag-drop d'une vidéo dans l'app -> le navigateur STREAME les octets ici -> on écrit dans /tmp -> on spawn\n// le ffmpeg NATIF (rapide, Phase 2) via scripts/video-hls.mjs --push --emit-progress -> progression LIVE\n// poussée au navigateur en SSE. Plus de Terminal, plus de ffmpeg.wasm. UN seul ffmpeg à la fois (file série,\n// le GPU/CPU sature sinon). Le token vient de l'env du serveur (déjà présent), pas d'un sous-shell `gh`.\nconst jobs = new Map() // jobId -> { jobId, name, dest, srcPath, status, progress, stage, error, nodePath, listeners:Set }\nconst snapshot = (j) => ({ jobId: j.jobId, status: j.status, progress: j.progress, stage: j.stage, name: j.name, error: j.error || null, nodePath: j.nodePath || null })\nconst sseSend = (res, obj) => { try { res.write(`data: ${JSON.stringify(obj)}\\n\\n`) } catch {} }\nconst update = (job, patch) => { Object.assign(job, patch); for (const r of job.listeners) sseSend(r, snapshot(job)) }\nconst queue = []\nlet running = false\nconst pump = () => {\n  if (running) return\n  const job = queue.shift(); if (!job) return\n  running = true\n  runJob(job).catch(() => {}).finally(() => { running = false; pump() })\n}\nasync function runJob(job) {\n  update(job, { status: 'running', stage: 'transcodage', progress: 1 })\n  const proc = spawn('node', [path.join(ROOT, 'scripts/video-hls.mjs'), job.srcPath, '--push', '--dest', job.dest, '--api', `http://localhost:${PORT}`, '--emit-progress'], { cwd: ROOT, env: process.env })\n  let buf = ''\n  const onLine = (line) => {\n    let m = line.match(/^@@P (\\d+) (\\S+)/); if (m) { update(job, { progress: Number(m[1]), stage: m[2] }); return }\n    m = line.match(/^@@DONE (.+)/); if (m) { job.nodePath = m[1].trim(); return }\n    if (/^échec |Error|fatal/.test(line)) job.error = line.slice(0, 200)\n  }\n  proc.stdout.on('data', (d) => { buf += d; let i; while ((i = buf.indexOf('\\n')) >= 0) { onLine(buf.slice(0, i)); buf = buf.slice(i + 1) } })\n  proc.stderr.on('data', (d) => { const s = String(d); if (/Error|fatal|échec/.test(s)) job.error = s.slice(0, 200) })\n  const ok = await new Promise((resolve) => proc.on('close', (code) => {\n    if (job.nodePath) { update(job, { status: 'done', progress: 100, stage: 'terminé' }); resolve(true) }\n    else { update(job, { status: 'error', error: job.error || `ffmpeg code ${code}` }); resolve(false) }\n    for (const r of job.listeners) { try { r.end() } catch {} }\n  }))\n  // On ne supprime la source uploadee QUE sur SUCCES. Sur echec, on la CONSERVE pour permettre un retry sans\n  // re-uploader (et on log le chemin). Sinon un echec reseau effacait le fichier -> il fallait tout re-glisser.\n  if (ok) { try { await rm(path.dirname(job.srcPath), { recursive: true, force: true }) } catch {} }\n  else { job.srcKept = job.srcPath; console.error(`[transcode echoue] source conservee: ${job.srcPath} (job ${job.jobId})`) }\n  setTimeout(() => jobs.delete(job.jobId), 600000) // purge la trace après 10 min\n}\n\nconst server = http.createServer(async (req, res) => {\n  adaptRes(res)\n  const url = new URL(req.url, `http://localhost:${PORT}`)\n\n  // POST /api/transcode-local?dest=&name= : reçoit le fichier vidéo brut (stream), lance le job, renvoie {jobId}.\n  if (url.pathname === '/api/transcode-local' && req.method === 'POST') {\n    try {\n      const jobId = randomUUID().slice(0, 8)\n      const name = (url.searchParams.get('name') || 'video.mp4').replace(/[/\\\\]/g, '_')\n      // dest BORNÉ sous pages/ (pas de .. ni d'absolu) : l'endpoint spawn ffmpeg + pousse sur le drive, donc une\n      // dest arbitraire serait une injection de chemin. Defaut pages/Videos.\n      let dest = (url.searchParams.get('dest') || 'pages/Videos').replace(/\\/+$/, '')\n      if (!/^pages\\//.test(dest) || dest.includes('..')) dest = 'pages/Videos'\n      const dir = path.join('/tmp/zr_in', jobId); await mkdir(dir, { recursive: true })\n      const srcPath = path.join(dir, name)\n      const ws = createWriteStream(srcPath)\n      await new Promise((resolve, reject) => { req.pipe(ws); ws.on('finish', resolve); ws.on('error', reject); req.on('error', reject) })\n      const job = { jobId, name, dest, srcPath, status: 'queued', progress: 0, stage: 'en file', listeners: new Set() }\n      jobs.set(jobId, job); queue.push(job); pump()\n      return res.json({ ok: true, jobId })\n    } catch (e) { res.statusCode = 500; return res.json({ error: String(e.message || e) }) }\n  }\n  // GET /api/transcode-events?jobId= : flux SSE de progression d'un job.\n  if (url.pathname === '/api/transcode-events' && req.method === 'GET') {\n    const job = jobs.get(url.searchParams.get('jobId') || '')\n    res.writeHead(200, { 'content-type': 'text/event-stream', 'cache-control': 'no-cache', connection: 'keep-alive' })\n    if (!job) { sseSend(res, { status: 'unknown' }); return res.end() }\n    job.listeners.add(res); sseSend(res, snapshot(job))\n    if (job.status === 'done' || job.status === 'error') { try { res.end() } catch {}; return }\n    req.on('close', () => job.listeners.delete(res))\n    return\n  }\n  // GET /api/transcode-status : liste des jobs en cours (reprise d'affichage après reload).\n  if (url.pathname === '/api/transcode-status' && req.method === 'GET') {\n    return res.json({ jobs: [...jobs.values()].map(snapshot) })\n  }\n\n  // GET /api/ytdlp-download?videoId=&name= : extrait l'audio d'un lien YouTube (widget audio, bouton\n  // Télécharger) et le sert en MP3 (Content-Disposition: attachment). LOCAL UNIQUEMENT PAR DESIGN (cf.\n  // docs/ytdlp-terminal-design.md) : cette route n'existe que dans ce fichier, jamais dans api/[...route].js\n  // -> absente du déploiement Vercel, inatteignable en prod. videoId validé par regex stricte avant tout\n  // spawn (pas de shell, argv tableau -> aucune injection possible même avec un id malformé).\n  //\n  // PIÈGE trouvé en test réel (2026-07-04) : `-o -` (stdout direct) empêche yt-dlp/ffmpeg de POST-TRAITER\n  // (conversion réelle en mp3) — le flux ne peut pas être « remuxé » sur un pipe non-seekable, donc yt-dlp\n  // livre l'audio BRUT (webm/opus) sans le convertir, avec une extension .mp3 mensongère. Fix : écrire dans un\n  // fichier temporaire réel (conversion mp3 fonctionne), PUIS streamer ce fichier fini au navigateur, PUIS le\n  // supprimer. Le navigateur ne voit rien de cette étape intermédiaire (juste un délai avant que le\n  // téléchargement démarre, proportionnel à la durée de la piste).\n  if (url.pathname === '/api/ytdlp-download' && req.method === 'GET') {\n    const videoId = (url.searchParams.get('videoId') || '').trim()\n    if (!/^[A-Za-z0-9_-]{6,20}$/.test(videoId)) { res.statusCode = 400; return res.json({ error: 'bad-video-id' }) }\n    const name = (url.searchParams.get('name') || videoId).replace(/[/\\\\\":*?<>|]/g, '_').slice(0, 150)\n    const jobId = randomUUID().slice(0, 8)\n    const outDir = path.join('/tmp/zr_ytdlp', jobId)\n    try {\n      await mkdir(outDir, { recursive: true })\n      const outTemplate = path.join(outDir, 'audio.%(ext)s')\n      await new Promise((resolve, reject) => {\n        const proc = spawn('yt-dlp', ['-x', '--audio-format', 'mp3', '--audio-quality', '0', '-o', outTemplate, `https://www.youtube.com/watch?v=${videoId}`])\n        let errBuf = ''\n        proc.stderr.on('data', (d) => { errBuf += String(d) })\n        proc.on('error', reject)\n        proc.on('close', (code) => code === 0 ? resolve() : reject(new Error(errBuf.slice(-400) || `yt-dlp exit ${code}`)))\n      })\n      const outFile = path.join(outDir, 'audio.mp3')\n      const st = await stat(outFile)\n      res.writeHead(200, { 'content-type': 'audio/mpeg', 'content-length': String(st.size), 'content-disposition': `attachment; filename=\"${name}.mp3\"` })\n      const rs = createReadStream(outFile)\n      rs.pipe(res)\n      rs.on('close', () => { rm(outDir, { recursive: true, force: true }).catch(() => {}) })\n    } catch (e) {\n      console.error('[yt-dlp]', e.message || e)\n      try { rm(outDir, { recursive: true, force: true }) } catch {}\n      if (!res.headersSent) { res.statusCode = 500; return res.json({ error: String(e.message || e) }) }\n      try { res.end() } catch {}\n    }\n    return\n  }\n\n  // ── PARTAGE (miroir des rewrites vercel.json) : /watch, /view, /folder -> share-og (balises OG dynamiques). ──\n  const SHARE_TYPE = { '/watch': 'watch', '/view': 'view', '/folder': 'folder' }[url.pathname]\n  if (SHARE_TYPE) {\n    try {\n      const mod = await import(path.join(ROOT, 'api', '[...route].js'))\n      req.query = Object.fromEntries(url.searchParams)\n      req.query.route = ['share-og'] // miroir EXACT de vercel.json : un seul segment, le type voyage en query\n      req.query.shareType = SHARE_TYPE\n      await mod.default(req, res)\n    } catch (e) { res.statusCode = 500; res.end('share-og error: ' + (e.message || e)) }\n    return\n  }\n  // ── API ──\n  if (url.pathname.startsWith('/api/')) {\n    // Route via le MÊME catch-all que Vercel (api/[...route].js) : une seule source de vérité, handlers dans ../server/.\n    const parts = url.pathname.slice(5).split('/').filter(Boolean)\n    try {\n      const mod = await import(path.join(ROOT, 'api', '[...route].js'))\n      req.query = Object.fromEntries(url.searchParams)\n      req.query.route = parts // segment dynamique = `route` (ne PAS écraser ?path= des handlers)\n      if (req.method === 'POST' || req.method === 'PUT') {\n        const chunks = []; for await (const c of req) chunks.push(c)\n        const raw = Buffer.concat(chunks).toString('utf8')\n        try { req.body = JSON.parse(raw) } catch { req.body = raw }\n      }\n      await mod.default(req, res)\n    } catch (e) { res.statusCode = 500; res.end('api error: ' + (e.message || e)) }\n    return\n  }\n  // ── static (SPA) ──\n  let f = path.join(DIST, url.pathname === '/' ? 'index.html' : url.pathname)\n  try { await stat(f) } catch { f = path.join(DIST, 'index.html') } // fallback SPA\n  try {\n    const buf = await readFile(f)\n    res.setHeader('content-type', MIME[path.extname(f)] || 'application/octet-stream')\n    // index.html (et tout .html) : JAMAIS en cache. Sinon, après un rebuild, le navigateur garde un\n    // ancien index.html qui pointe vers des assets JS hashés SUPPRIMÉS -> 404 -> app blanche (bug observé).\n    // Les assets hashés (/assets/*.js) sont immuables -> cache long. Le reste : revalidation.\n    const ext = path.extname(f)\n    if (ext === '.html') res.setHeader('Cache-Control', 'no-cache, no-store, must-revalidate')\n    else if (/\\/assets\\//.test(f) && /\\.[0-9a-zA-Z_-]{8}\\.(js|css)$/.test(f)) res.setHeader('Cache-Control', 'public, max-age=31536000, immutable')\n    else res.setHeader('Cache-Control', 'no-cache')\n    res.end(buf)\n  } catch { res.statusCode = 404; res.end('not found') }\n})\n// SÉCURITÉ : on écoute UNIQUEMENT sur la loopback (127.0.0.1), JAMAIS sur 0.0.0.0. Sinon le serveur (qui porte\n// le GITHUB_TOKEN, sert la clé maître de déchiffrement et accepte les écritures sur le drive) serait joignable\n// par TOUT appareil du réseau local. Bind loopback = accessible seulement depuis cette machine.\nconst HOST = process.env.ZR_BIND || '127.0.0.1'\nserver.listen(PORT, HOST, () => console.log(`ZenRay local -> http://localhost:${PORT}  (bind ${HOST}, token: ${process.env.GITHUB_TOKEN ? 'OK' : 'ABSENT'})`))\n27:const PORT = parseInt(process.argv[2] || '3000', 10)\n56:  const proc = spawn('node', [path.join(ROOT, 'scripts/video-hls.mjs'), job.srcPath, '--push', '--dest', job.dest, '--api', `http://localhost:${PORT}`, '--emit-progress'], { cwd: ROOT, env: process.env })\n77:const server = http.createServer(async (req, res) => {\n79:  const url = new URL(req.url, `http://localhost:${PORT}`)\n206:server.listen(PORT, HOST, () => console.log(`ZenRay local -> http://localhost:${PORT}  (bind ${HOST}, token: ${process.env.GITHUB_TOKEN ? 'OK' : 'ABSENT'})`))\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f6085-288d-7eb0-ad41-d89410fe11e1"}}}
