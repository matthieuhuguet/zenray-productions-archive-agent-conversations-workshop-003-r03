m/customsearch/v1?key=${GCSE_KEY}&cx=${GCSE_ID}&searchType=image&num=10&safe=off&q=${encodeURIComponent(q)}`)\n  if (!j) return []\n  return ((j.items) || []).filter((i) => i.link).map((i) => ({ title: i.title || q, year: '', image: i.link, source: 'google' }))\n}\nasync function ddgImages(q) {\n  try {\n    const page = await fetch(`https://duckduckgo.com/?q=${encodeURIComponent(q)}&iax=images&ia=images`, { headers: { 'User-Agent': DDG_UA } }).then((r) => r.text())\n    const m = page.match(/vqd=[\"']?([\\d-]+)[\"']?/)\n    if (!m) return []\n    const j = await fetch(`https://duckduckgo.com/i.js?l=us-en&o=json&q=${encodeURIComponent(q)}&vqd=${m[1]}&f=,,,&p=1`, { headers: { 'User-Agent': DDG_UA, Referer: 'https://duckduckgo.com/' } }).then((r) => r.json()).catch(() => null)\n    return ((j && j.results) || []).filter((r) => r.image).map((r) => ({ title: r.title || q, year: '', image: r.image, source: 'web' }))\n  } catch { return [] }\n}\nasync function webImages(q) {\n  const g = await googleImages(q)\n  if (g !== null) return g // Google configuré -> source de vérité en prod (même si 0 résultat)\n  return ddgImages(q) // sinon fallback keyless (local)\n}\n\n// — RAWG (jeux) : background_image = art paysage du jeu.\nasync function rawg(q) {\n  if (!RAWG_KEY) return []\n  const j = await jget(`https://api.rawg.io/api/games?key=${RAWG_KEY}&search=${encodeURIComponent(q)}&page_size=8`)\n  return ((j && j.results) || []).filter((g) => g.background_image).map((g) => ({ title: g.name, year: (g.released || '').slice(0, 4), image: g.background_image, source: 'rawg' }))\n}\n\n// — TMDB (films / séries / docs / anime) : poster_path -> CDN image.tmdb.org (w500).\nasync function tmdb(q) {\n  if (!TMDB_KEY) return []\n  const j = await jget(`https://api.themoviedb.org/3/search/multi?api_key=${TMDB_KEY}&query=${encodeURIComponent(q)}&include_adult=false`)\n  return ((j && j.results) || []).filter((m) => m.poster_path).map((m) => ({\n    title: m.title || m.name || q,\n    year: ((m.release_date || m.first_air_date || '')).slice(0, 4),\n    image: `https://image.tmdb.org/t/p/w500${m.poster_path}`, source: 'tmdb',\n  }))\n}\n\n// — Open Library (livres, SANS clé, aucun quota constaté) : couverture du 1er résultat de recherche.\n// Ajouté 2026-07-08 pour la catégorie \"books\" (Shelf) — Google Books, testé en premier, est bloqué par un\n// quota partagé par IP (429 RESOURCE_EXHAUSTED) hors de notre contrôle ; Open Library est fiable et gratuit.\nasync function openLibrary(q) {\n  const j = await jget(`https://openlibrary.org/search.json?q=${encodeURIComponent(q)}&limit=8&fields=title,author_name,first_publish_year,cover_i`)\n  return ((j && j.docs) || []).filter((d) => d.cover_i).map((d) => ({\n    title: d.title || q,\n    year: d.first_publish_year ? String(d.first_publish_year) : '',\n    image: `https://covers.openlibrary.org/b/id/${d.cover_i}-L.jpg`, source: 'openlibrary',\n  }))\n}\n\n// — Jikan (MyAnimeList, SANS clé) : jaquettes anime ET manga. Marche en prod (API keyless mais hébergée, pas\n// bloquée par IP datacenter). Complète AniList (couvre mieux le manga). Limite Jikan ~3 req/s : 2 appels/recherche.\nasync function jikan(q) {\n  const map = (j, src) => ((j && j.data) || []).filter((x) => x.images && x.images.jpg && x.images.jpg.large_image_url).map((x) => ({ title: x.title || q, year: (x.year ? String(x.year) : ''), image: x.images.jpg.large_image_url, source: src }))\n  const [a, m] = await Promise.all([\n    jget(`https://api.jikan.moe/v4/anime?q=${encodeURIComponent(q)}&limit=6&sfw`),\n    jget(`https://api.jikan.moe/v4/manga?q=${encodeURIComponent(q)}&limit=6&sfw`),\n  ])\n  return [...map(a, 'mal'), ...map(m, 'mal')]\n}\n\n// — AniList (anime & manga) : GraphQL public, coverImage.extraLarge (jaquette portrait).\nasync function anilist(q) {\n  const query = `query($s:String){ Page(perPage:8){ media(search:$s, sort:SEARCH_MATCH){ title{romaji english} startDate{year} coverImage{extraLarge large} } } }`\n  const j = await jget('https://graphql.anilist.co', {\n    method: 'POST', headers: { 'content-type': 'application/json', Accept: 'application/json' },\n    body: JSON.stringify({ query, variables: { s: q } }),\n  })\n  const media = (j && j.data && j.data.Page && j.data.Page.media) || []\n  return media.filter((m) => m.coverImage && (m.coverImage.extraLarge || m.coverImage.large)).map((m) => ({\n    title: (m.title && (m.title.english || m.title.romaji)) || q,\n    year: (m.startDate && m.startDate.year) ? String(m.startDate.year) : '',\n    image: m.coverImage.extraLarge || m.coverImage.large, source: 'anilist',\n  }))\n}\n\n// Indice de catégorie ajouté à la requête web pour de meilleurs résultats (jaquette/affiche pertinente).\nconst WEB_HINT = { games: 'game cover', 'anime-manga': 'anime poster', movies: 'movie poster', books: 'book cover' }\n\nexport default async function handler(req, res) {\n  const q = ((req.query && req.query.q) || '').toString().trim()\n  const cat = ((req.query && req.query.cat) || '').toString()\n  const mode = ((req.query && req.query.mode) || '').toString()\n  if (!q) return res.status(200).json({ ok: false, error: 'no-query', results: [] })\n\n  // Recherche média par catégorie (RAWG/TMDB/AniList/Open Library).\n  const media = async () => {\n    if (cat === 'games') return rawg(q)\n    if (cat === 'anime-manga') { const [a, j, t] = await Promise.all([anilist(q), jikan(q), tmdb(q)]); return [...a, ...j, ...t] }\n    if (cat === 'movies') return tmdb(q)\n    if (cat === 'books') return openLibrary(q)\n    const [g, t, a, j] = await Promise.all([rawg(q), tmdb(q), anilist(q), jikan(q)]); return [...g, ...t, ...a, ...j]\n  }\n  let results = []\n  try {\n    if (mode === 'web') {\n      results = await webImages(`${q} ${WEB_HINT[cat] || ''}`.trim())\n    } else {\n      // DÉFAUT = on GARDE l'ancien système (API média) ET on AJOUTE la recherche web : média d'abord (jaquettes\n      // propres), puis web en complément. Le web peut échouer (IP datacenter bloquée) -> on a quand même le média.\n      const [m, w] = await Promise.all([media(), webImages(`${q} ${WEB_HINT[cat] || ''}`.trim())])\n      results = [...m, ...w]\n    }\n  } catch (e) { return res.status(200).json({ ok: false, error: 'search-exception', detail: e && e.message, results: [] }) }\n\n  // Dédupe par URL, borne à 30 (le picker en montre 3 à la fois + refresh).\n  const seen = new Set(); const out = []\n  for (const r of results) { if (!r.image || seen.has(r.image)) continue; seen.add(r.image); out.push(r); if (out.length >= 30) break }\n  res.setHeader('Cache-Control', 'public, max-age=600')\n  return res.status(200).json({ ok: true, results: out })\n}\n// INGESTION D'IMAGE RÉSILIENTE pour le Shelf.\n// Prend une URL externe (API média, web) OU un dataUrl (fichier local converti), télécharge les octets CÔTÉ\n// SERVEUR (pas de CORS), les stocke dans le repo PUBLIC `zenray-shelf-img`, et renvoie une URL jsDelivr\n// ÉPINGLÉE AU COMMIT (immuable, servie par le CDN). But : ne plus dépendre de l'hôte d'origine — les API média\n// peuvent tomber, jsDelivr non. Layout PLAT à la racine (cohérent avec le seed : `<slug>-<rand>.<ext>`).\nimport { logStart, logEnd, describeCommand } from './cmdlog.js'\n\nconst OWNER = process.env.CONTENT_OWNER || 'matthieuhuguet'\nconst REPO = process.env.SHELF_IMG_REPO || 'zenrayshards-img-124ff562adad' // ex zenray-shelf-img, renommé 2026-07-05 (rename v2) — les ÉCRITURES API ne suivent pas la redirection GitHub, d'où la mise à jour\nconst BRANCH = process.env.SHELF_IMG_BRANCH || 'main'\nconst MAX_BYTES = 12 * 1024 * 1024 // 12 Mo : large pour un poster, borne anti-abus.\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms))\n\nconst slug = (s) => (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '').slice(0, 48) || 'poster'\nconst extFor = (ct, url) => {\n  ct = (ct || '').toLowerCase()\n  if (ct.includes('webp')) return 'webp'\n  if (ct.includes('avif')) return 'avif'\n  if (ct.includes('png')) return 'png'\n  if (ct.includes('gif')) return 'gif'\n  if (ct.includes('jpeg') || ct.includes('jpg')) return 'jpg'\n  const m = (url || '').split('?')[0].match(/\\.(jpe?g|png|webp|avif|gif)$/i)\n  return m ? m[1].toLowerCase().replace('jpeg', 'jpg') : 'jpg'\n}\n\nexport default async function handler(req, res) {\n  if (req.method !== 'POST') { res.setHeader('Allow', 'POST'); return res.status(405).end() }\n  const token = process.env.GITHUB_TOKEN\n  if (!token) return res.status(200).json({ ok: false, error: 'no-token' })\n\n  let body = req.body\n  if (typeof body === 'string') { try { body = JSON.parse(body) } catch { body = {} } }\n  const { url, dataUrl, name, cat } = body || {}\n\n  // 1) Récupérer les octets : dataUrl direct, ou fetch serveur de l'URL externe.\n  let buf = null, ct = ''\n  try {\n    if (dataUrl && /^data:image\\//.test(dataUrl)) {\n      ct = dataUrl.slice(5, dataUrl.indexOf(';'))\n      buf = Buffer.from(dataUrl.split(',')[1] || '', 'base64')\n    } else if (url && /^https?:\\/\\//.test(url)) {\n      // Retry : la source (RAWG/TMDB/CDN) peut renvoyer un 5xx/timeout ponctuel. 3 tentatives -> évite l'échec\n      // d'ingestion qui laissait une image non stockée (donc noire) côté client.\n      let r = null, lastStatus = 0\n      for (let i = 0; i < 3; i++) {\n        try { r = await fetch(url, { headers: { 'User-Agent': 'Mozilla/5.0 zenray-progress', Accept: 'image/*,*/*' }, redirect: 'follow' }) } catch { r = null }\n        if (r && r.ok) break\n        lastStatus = r ? r.status : 0\n        if (i < 2) await sleep(500 * (i + 1))\n      }\n      if (!r || !r.ok) return res.status(200).json({ ok: false, error: 'fetch-failed', httpStatus: lastStatus })\n      ct = r.headers.get('content-type') || ''\n      buf = Buffer.from(await r.arrayBuffer())\n    } else {\n      return res.status(400).json({ ok: false, error: 'bad-input' })\n    }\n  } catch (e) { return res.status(200).json({ ok: false, error: 'fetc