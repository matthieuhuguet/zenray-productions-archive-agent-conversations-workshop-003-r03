{"timestamp":"2026-07-14T12:08:20.853Z","ordinal":82,"type":"response_item","payload":{"type":"custom_tool_call_output","call_id":"call_f887K1pIcnvq3lu4WJgdYHJH","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"// Routeur catch-all unique pour /api/* : SEULE fonction serverless de /api (passe SOUS la limite Vercel Hobby = 12).\n// Les handlers réels vivent dans ../server/ (HORS de /api/, donc NON déployés comme fonctions par Vercel).\n// Le client appelle /api/<name> ; Vercel route ici ; on délègue. local-server.mjs route AUSSI via ce fichier.\n// Comportement 100% identique : on relaie req/res au handler ciblé.\nimport pageHandler from '../server/page.js'\nimport imgHandler from '../server/img.js'\nimport mediaHandler from '../server/media.js'\nimport streamHandler from '../server/stream.js'\nimport shardHandler from '../server/shard.js'\nimport reposHandler from '../server/repos.js'\nimport uploadShardHandler from '../server/upload-shard.js'\nimport publishHandler from '../server/publish.js'\nimport stateHandler from '../server/state.js'\nimport unfurlHandler from '../server/unfurl.js'\nimport uploadHandler from '../server/upload.js'\nimport hlsHandler from '../server/hls.js'\nimport hlsKeyHandler from '../server/hls-key.js'\nimport hlsDownloadInfoHandler from '../server/hls-download-info.js'\nimport hlsCliHandler from '../server/hls-cli.js'\nimport hlsDownloadScriptHandler from '../server/hls-download-script.js'\nimport uploadCmdHandler from '../server/upload-cmd.js'\nimport uploadVidHandler from '../server/upload-vid.js'\nimport cmdlogHandler from '../server/cmdlog-api.js'\nimport mediaKeyHandler from '../server/media-key.js'\nimport rawTokenHandler from '../server/raw-token.js'\nimport rawProxyHandler from '../server/raw-proxy.js'\nimport shelfImgHandler from '../server/shelf-img.js'\nimport shelfSearchHandler from '../server/shelf-search.js'\nimport docHandler from '../server/doc.js'\nimport treeHandler from '../server/tree.js'\nimport videoCommentHandler from '../server/video-comment.js'\nimport sharedMediaHandler from '../server/shared-media.js'\nimport shareOgHandler from '../server/share-og.js'\nimport { timingSafeEqual } from 'node:crypto'\n\n// GATE APPLICATIF (sécurité, audit famille A). Quand ZENRAY_API_SECRET est défini (prod), chaque appel /api/*\n// SENSIBLE doit porter le header `x-zr-auth: <secret>` (sinon 401). Ça remplace la dépendance au seul toggle\n// Vercel : la clé maître (media-key), les écritures (page/upload-*/publish/state) et la gestion de repos sont\n// fermées par défaut. EXEMPTÉS : les endpoints servis comme src DOM (<img>/<video>/hls.js) qui NE PEUVENT PAS\n// porter de header custom — leur contenu est chiffré sur CDN public ou derrière la protection de déploiement.\n// Si ZENRAY_API_SECRET est ABSENT (dev local, serveur loopback) -> gate DÉSACTIVÉ, rien ne change.\nconst API_SECRET = process.env.ZENRAY_API_SECRET || ''\n// raw-proxy est EXEMPTÉ du gate (servi comme src DOM <img>, ne peut pas porter x-zr-auth) : il ne sert que\n// des binaires pinnés par commit du compte owner (posters), pas de secret. raw-token, lui, RESTE gated\n// (même surface que media-key : servi au client authentifié uniquement quand le gate est actif).\nconst PUBLIC_ROUTES = new Set(['img', 'stream', 'media', 'shard', 'hls', 'hls-key', 'hls-download-info', 'hls-cli', 'hls-download-script', 'shared-media', 'share-og', 'raw-proxy'])\nfunction authOk(req, name) {\n  if (!API_SECRET) return true\n  if (PUBLIC_ROUTES.has(name)) return true\n  // COMMENTAIRES VIDÉO : lecture ET écriture publiques (un visiteur d'un lien /watch commente sans le code\n  // du drive). Le contenu écrit est borné à { videoPath, name, text } sous pages/_comments/, rien de sensible.\n  if (name === 'video-comment') return true\n  // PARTAGE PUBLIC (liens /watch et /folder) : un lien de partage NE DOIT JAMAIS réclamer le code du drive.\n  // On autorise donc, SANS secret, deux LECTURES non sensibles sur la route `page` (jamais les écritures POST) :\n  //   1) action=read d'un MANIFESTE .media.json/.img.json -> ne contient que des URLs CDN publiques + poster.\n  //      Le contenu réel reste protégé : la vidéo brute est publique par design ; l'image chiffrée exige toujours\n  //      media-key (route gated). Donc exposer le manifeste ne fuit aucun secret.\n  //   2) action=tree BORNÉ à un sous-dossier (dir=pages/...) -> liste les chemins de CE dossier partagé seulement,\n  //      pas tout le drive (dir absent ou =pages refusé). Permet la galerie de dossier partagé sans tout exposer.\n  const method = (req.method || 'GET').toUpperCase()\n  if (name === 'page' && method === 'GET') {\n    const q = req.query || {}\n    const action = (q.action || '').toString()\n    const path = (q.path || '').toString()\n    const dir = (q.dir || '').toString()\n    if (action === 'read' && /\\.(media|img)\\.json$/.test(path)) return true\n    if (action === 'tree' && dir.startsWith('pages/') && dir !== 'pages') return true\n  }\n  const h = (req.headers && req.headers['x-zr-auth']) || (req.query && req.query.auth) || ''\n  if (typeof h !== 'string' || h.length !== API_SECRET.length) return false\n  try { return timingSafeEqual(Buffer.from(h), Buffer.from(API_SECRET)) } catch { return false }\n}\n\nconst routes = {\n  page: pageHandler,\n  img: imgHandler,\n  media: mediaHandler,\n  stream: streamHandler,\n  shard: shardHandler,\n  repos: reposHandler,\n  'upload-shard': uploadShardHandler,\n  publish: publishHandler,\n  state: stateHandler,\n  unfurl: unfurlHandler,\n  upload: uploadHandler,\n  hls: hlsHandler,\n  'hls-key': hlsKeyHandler,\n  'hls-download-info': hlsDownloadInfoHandler,\n  'hls-cli': hlsCliHandler,\n  'hls-download-script': hlsDownloadScriptHandler,\n  'upload-cmd': uploadCmdHandler,\n  'upload-vid': uploadVidHandler,\n  cmdlog: cmdlogHandler,\n  'media-key': mediaKeyHandler,\n  'raw-token': rawTokenHandler, // token de LECTURE des repos privés zenrayshards-* (SW vidéo + download) — gated comme media-key\n  'raw-proxy': rawProxyHandler, // <img> des posters privés (une balise img ne peut pas porter de header) — servi comme src DOM\n  'shelf-img': shelfImgHandler,   // télécharge une image et la stocke en repo public (jsDelivr)\n  'shelf-search': shelfSearchHandler, // recherche de posters via API média (RAWG/TMDB/AniList)\n  doc: docHandler,                // lecture live read-only d'un .md (repo Memory/.claude) — Documents\n  tree: treeHandler,              // liste les .md d'un repo perso — mode « parcourir tout »\n  'video-comment': videoCommentHandler, // commentaires publics sous une vidéo (lecteur + page /watch)\n  'shared-media': sharedMediaHandler,   // déchiffre côté serveur une image publique+chiffrée -> octets clairs (fix partage image + source OG)\n  'share-og': shareOgHandler,           // sert dist/index.html avec les balises Open Graph du média partagé (WhatsApp/Notion/iMessage)\n}\n\n// Vercel n'applique `export const config` que sur le fichier de fonction réellement déployé\n// (= ce routeur). media.js et upload-shard.js déclaraient un bodyParser à 8mb ; on relève donc\n// la limite ici à 8mb pour TOUT le routeur, sinon les uploads chunkés (parts 3 Mo) seraient\n// rejetés en 413. Les autres routes ne sont pas impactées par une limite plus haute.\nexport const config = { api: { bodyParser: { sizeLimit: '8mb' } } }\n\nexport default async function handler(req, res) {\n  // Le segment dynamique est nommé `route` (fichier [...route].js) et NON `path`, pour ne PAS écraser\n  // le paramètre de requête ?path= utilisé par les handlers (img/shard/hls/stream/page read).\n  // Vercel expose le segment catch-all sous la clé \"...route\" (avec les 3 points), PAS \"route\".\n  // local-server.mjs, lui, injecte req.query.route. On lit donc les deux pour marcher des deux côtés.\n  let parts = req.query.route ?? req.query['...route']\n  if (typeof parts === 'string') parts = parts.split('/')\n  const name = Array.isArray(parts) ? parts[0] : parts\n  const target = name && routes[name]\n  if (!target) return res.status(404).json({ error: 'not-found', route: name || null })\n  if (!authOk(req, name)) return res.status(401).json({ error: 'unauthorized' })\n  return target(req, res)\n}\napi/[...route].js:36:// GATE APPLICATIF (sécurité, audit famille A). Quand ZENRAY_API_SECRET est défini (prod), chaque appel /api/*\napi/[...route].js:37:// SENSIBLE doit porter le header `x-zr-auth: <secret>` (sinon 401). Ça remplace la dépendance au seul toggle\napi/[...route].js:41:// Si ZENRAY_API_SECRET est ABSENT (dev local, serveur loopback) -> gate DÉSACTIVÉ, rien ne change.\napi/[...route].js:42:const API_SECRET = process.env.ZENRAY_API_SECRET || ''\napi/[...route].js:48:  if (!API_SECRET) return true\napi/[...route].js:70:  if (typeof h !== 'string' || h.length !== API_SECRET.length) return false\napi/[...route].js:71:  try { return timingSafeEqual(Buffer.from(h), Buffer.from(API_SECRET)) } catch { return false }\napi/[...route].js:122:  if (!authOk(req, name)) return res.status(401).json({ error: 'unauthorized' })\nserver/doc.js:23:    if (r.status === 401 || r.status === 403) return res.status(200).json({ markdown: null, error: 'token-expired' })\nserver/publish.js:29:  if (!TOKEN) return res.status(401).json({ error: 'no-token' })\nserver/shared-media.js:6:// call returns 401 and the image stays white/broken. Verified in prod: `curl /api/media-key` -> 401.\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f6085-288d-7eb0-ad41-d89410fe11e1"}}}
