ch {}\n      setTimeout(() => g.remove(), 0)\n    },\n    dropOn: (targetId, targetStatus, after = false) => {\n      setDragActive(false) // efface le surlignage de TOUTES les sections — tourne sur CHAQUE drop (carte ou section)\n      const from = dragId.current; dragId.current = null\n      if (!from || from === targetId) return\n      persist((arr) => {\n        const a = [...arr]; const fi = a.findIndex((x) => x.id === from); if (fi < 0) return arr\n        const moved = { ...a[fi], status: targetStatus, updatedAt: nowIso() }\n        a.splice(fi, 1)\n        const ti = targetId ? a.findIndex((x) => x.id === targetId) : -1\n        // Insertion À GAUCHE (avant la cible) ou À DROITE (après) selon le côté du drop.\n        if (ti >= 0) a.splice(after ? ti + 1 : ti, 0, moved); else a.push(moved)\n        return a\n      })\n    },\n  }\n\n  // Filtre + tri. Score = décroissant (null en bas). Status = groupé dans l'ordre canonique, score décroissant dedans.\n  const qn = q.trim().toLowerCase()\n  const filtered = useMemo(() => {\n    let a = items || []\n    if (qn) a = a.filter((x) => `${x.name} ${(x.tags || []).join(' ')}`.toLowerCase().includes(qn))\n    return a\n  }, [items, qn])\n\n  // Score décroissant ; à score ÉGAL, l'ordre du tableau est conservé (sort stable) = le placement manuel par drag.\n  const byScore = (a, b) => (b.score ?? -1) - (a.score ?? -1)\n  // Split par statut (+ tri du « Done » par score), memoïsé sur `filtered` : sinon les 4 listes sont re-filtrées\n  // à CHAQUE render — y compris à chaque survol de section pendant un drag (coût inutile sur ~348 cartes).\n  // eslint-disable-next-line react-hooks/exhaustive-deps\n  const byStatus = useMemo(() => STATUS_ORDER.map((g) => {\n    const list = filtered.filter((x) => x.status === g)\n    return { g, list: g === 'done' ? [...list].sort(byScore) : list }\n  }), [filtered])\n\n  const selItem = useMemo(() => (items || []).find((x) => x.id === sel) || null, [items, sel])\n\n  const accent = (t && t.accent) || PALETTE.primary\n  const landscape = cat === 'games' // Games = cartes PAYSAGE 3:2 (art RAWG horizontal) ; anime & movies restent PORTRAIT 2:3\n\n  return (\n    <div style={{ fontFamily: FONTS.sans, color: '#ECECEA', display: 'flex', flexDirection: 'column', gap: 16 }}>\n      {/* Pulse discret (2026-07-08, demande Matthieu, corrigé même jour : le pulse en boucle automatique ne\n          répondait à aucune interaction réelle -> aucun signal quand on survolait. Le pulse se déclenche\n          maintenant UNIQUEMENT au survol (:hover pur CSS, pas de JS) de la capsule repliée : 0,33 s (scale\n          1 -> 1,05 -> 1) à chaque entrée de souris. S'arrête dès que la barre est dépliée (classe retirée). */}\n      <style>{`@keyframes shelfTabHint{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}\n        .shelf-tab-hint:hover{animation:shelfTabHint .33s ease-in-out}`}</style>\n      {/* En-tête : titre + onglets catégories + recherche */}\n      <div style={{ display: 'flex', alignItems: 'flex-end', gap: 16, flexWrap: 'wrap' }}>\n        <div>\n          <div style={{ fontFamily: FONTS.serif, fontSize: 30, fontWeight: 500, color: (t && t.textPrimary) || '#ECECEA', letterSpacing: 0.2 }}>Shelf</div>\n        </div>\n        {/* Recherche : verre Liquid Glass \"Normal\" (réf. Design/LiquidGlass-Themes) au lieu d'un fond plat —\n            2026-07-04, demande explicite de Matthieu de coller au style verre du reste du site. */}\n        <div className=\"zr-glass\" style={{ marginLeft: 'auto', borderRadius: 99, width: 240, maxWidth: '45%' }}>\n          <input value={q} onChange={(e) => setQ(e.target.value)} placeholder=\"Rechercher…\"\n            style={{ background: 'transparent', color: (t && t.textPrimary) || '#ECECEA', border: 'none', borderRadius: 99, padding: '8px 16px', fontSize: 13, outline: 'none', width: '100%', boxSizing: 'border-box', fontFamily: FONTS.sans }} />\n        </div>\n      </div>\n\n      {/* Barre onglets catégories — CAPSULE REPLIÉE (2026-07-08, demande Matthieu, 3e passe : uniquement le\n          CLIC, plus de survol — pas fan du hover). Au repos, SEULE la capsule active est visible. Un clic\n          dessus déplie les autres catégories À CÔTÉ pour choisir ; en choisir une la sélectionne ET replie\n          aussitôt sur la nouvelle capsule seule. Clic en dehors = repli sans rien changer. */}\n      <div style={{ display: 'flex', gap: 14, alignItems: 'center', flexWrap: 'wrap' }}>\n        <div ref={tabsRef} className=\"zr-glass\" style={{ display: 'inline-flex', gap: 4, borderRadius: 99, padding: 4 }}>\n          {CATS.map((c) => {\n            const on = cat === c.key\n            if (!tabsOpen && !on) return null // repos : seule la capsule active existe dans le DOM\n            return (\n              <button key={c.key} onClick={() => {\n                  // 1er clic sur l'unique capsule visible = déplier, PAS choisir (sinon le clic sur la seule\n                  // capsule qui existe encore se re-sélectionne et se referme aussitôt, impossible de jamais\n                  // voir les autres). Une fois dépliée, un clic choisit vraiment.\n                  if (!tabsOpen) { setTabsOpen(true); return }\n                  setCat(c.key); setSel(null); setTabsOpen(false)\n                }}\n                // Pulse UNIQUEMENT au repos (repliée) : une fois dépliée, plus besoin d'indiquer que c'est cliquable.\n                className={!tabsOpen ? 'shelf-tab-hint' : undefined}\n                style={{ padding: on ? '9px 20px' : '6px 14px', borderRadius: 99, border: 'none', cursor: 'pointer', fontFamily: FONTS.sans, fontSize: on ? 15 : 12.5, fontWeight: on ? 700 : 600, whiteSpace: 'nowrap', background: on ? accent : 'transparent', color: on ? '#fff' : ((t && t.textSecondary) || '#8E8E93'), transition: 'font-size .18s ease, padding .18s ease, background .15s, color .15s' }}>{c.label}</button>\n            )\n          })}\n        </div>\n\n        <button onClick={() => setAdding(true)}\n          style={{ display: 'inline-flex', alignItems: 'center', gap: 5, background: accent, color: '#fff', border: 'none', borderRadius: 99, padding: '8px 15px', fontSize: 13, fontWeight: 700, cursor: 'pointer', fontFamily: FONTS.sans }}>\n          <Icon name=\"plus\" size={15} color=\"#fff\" />Ajout…16302 tokens truncated…inmax(150px,1fr)), portrait 2:3, radius 12, gap 18, hover scale 1.05 + deeper shadow = Apple TV signature). Card = poster full-bleed + dark bottom gradient vignette; score top-left in a bold blurred pill; status dot top-right; title bottom-center in AnthropicSerif over the vignette. image:null -> deterministic elegant gradient (hash of id) with the title fully legible. Sort by Status renders grouped sections in order In Progress -> Backlog -> Done -> Dropped (each with a colored dot + count); sort by Score = one flat grid, score-descending.\\n\\nDetail panel = right slide-over (Notion-like): poster banner, editable Status (select) + Score (0-100 clamped), poster Image URL field, add/remove Tags, read-only \\\"Détails\\\" block from item.extra (studio/realisator/year…), and a Markdown notes editor with Édition (textarea) / Aperçu (rendered via the project's existing `marked` dep) tabs. Plus a Retirer (delete) action with confirm.\\n\\nAdd modal: title (required), status, score, optional image URL.\\n\\nStatus normalization + colors per spec: in_progress=blue (theme accent), backlog=gray, done=green, dropped=faded red (#9B5A57). Fonts: titles AnthropicSerif, meta AnthropicSans, numeric/mono AnthropicMono. Cards stay dark/cinematic regardless of light/dark theme (posters need dark vignettes); all chrome (header, panels, modal, fields) is theme-aware via the `t` prop with safe dark fallbacks.\\n\\nPersistence (seed+live, mirrors SfxView in Audio.jsx exactly): on first open of a category it reads the LIVE version via /api/page?action=read&path=shelf/<cat>.json; if missing/unparseable it falls back to the seed at /shelf/<cat>.json (fetch from public