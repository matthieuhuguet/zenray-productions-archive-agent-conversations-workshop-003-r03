0_000)\n    m, rem = divmod(rem, 60_000)\n    s, ms = divmod(rem, 1000)\n    return f\"{h:02d}:{m:02d}:{s:02d},{ms:03d}\"\n\ndef parse(path):\n    text = Path(path).read_text(encoding=\"utf-8\")\n    blocks = []\n    for raw in re.split(r\"\\n\\s*\\n\", text.strip()):\n        lines = raw.split(\"\\n\")\n        if len(lines) < 2:\n            continue\n        m = TC_RE.match(lines[1].strip())\n        if not m:\n            continue\n        blocks.append({\n            \"idx\": lines[0].strip(),\n            \"start\": tc_to_ms(*m.groups()[:4]),\n            \"end\": tc_to_ms(*m.groups()[4:]),\n            \"body\": lines[2:],\n        })\n    return blocks\n\ndef compute_duration(body):\n    text = \" \".join(b for b in body if b.strip() and b.strip() != \"&nbsp;\")\n    if not text:\n        return EMPTY_DUR_MS\n    desired = int(len(text) / CPS * 1000)\n    return max(MIN_DUR_MS, min(MAX_DUR_MS, desired))\n\ndef retime(blocks):\n    out = []\n    for i, b in enumerate(blocks):\n        new_end = b[\"start\"] + compute_duration(b[\"body\"])\n"}}
