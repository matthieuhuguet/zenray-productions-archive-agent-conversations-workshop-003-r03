ge). Gère .md / .db.json / .media.json /\n     3\t// .img.json / .canvas.json / .embed.json. Zéro régression : tout champ ancien est conservé.\n     4\timport { typeOfPath, stripLeafExt, legacyFlags } from './node.js'\n     5\t\n     6\t// Marqueur d'un DOSSIER VIDE persistant : `<dir>/.zrfolder.json`. Un dossier sans aucun nœud (ni sous-nœud)\n     7\t// n'existe pas en Git tout seul (Git ne suit pas les dossiers vides) ; ce fichier sentinelle le matérialise.\n     8\t// Il ne doit JAMAIS apparaître comme une entrée fichier : il prouve seulement l'existence de SON dossier parent.\n     9\tconst FOLDER_MARKER = '/.zrfolder.json'\n    10\tconst isFolderMarker = (p) => p.endsWith(FOLDER_MARKER)\n    11\tconst folderOfMarker = (p) => p.slice(0, -FOLDER_MARKER.length) // '<...>/Foo/.zrfolder.json' -> '<...>/Foo'\n    12\t\n    13\t// Arbre Notion : X (contenu) et le dossier X/ fusionnés sous le même nom. node.type = type du contentPath.\n    14\texport function buildTree(paths) {\n    15\t  const root = { name: '', children: {}, contentPath: null, type: 'folder' }\n    16\t  for (const p of paths) {\n    17\t    // Marqueur de dossier vide : on crée seulement la chaîne de dossiers, sans nœud-feuille.\n    18\t    const marker = isFolderMarker(p)\n    19\t    const base = marker ? folderOfMarker(p) : p\n    20\t    const stripped = (marker ? base : stripLeafExt(base)).replace(/^pages\\//, '')\n    21\t    if (!stripped) continue\n    22\t    const segs = stripped.split('/')\n    23\t    let node = root\n    24\t    segs.forEach((seg, i) => {\n    25\t      node.children[seg] = node.children[seg] || { name: seg, children: {}, contentPath: null, type: 'folder' }\n    26\t      node = node.children[seg]\n    27\t      if (!marker && i === segs.length - 1) { node.contentPath = p; node.type = typeOfPath(p) }\n    28\t    })\n    29\t  }\n    30\t  return root\n    31\t}\n    32\t\n    33\t// Entrées directement sous `dir`, fusionnant page (X.md) + dossier (X/) + bases/médias 