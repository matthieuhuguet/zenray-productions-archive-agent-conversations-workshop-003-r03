gth)}/${blobs.length})`)) throw new Error('manifests')\n   340\t  console.log(`  manifestes ${Math.min(i + 600, blobs.length)}/${blobs.length} ✓`)\n   341\t}\n   342\t\n   343\t// ── 5) VÉRIF 200 (raw.githubusercontent, parallèle x16) sur TOUT (toutes les parts) ─────────────\n   344\tconst urls = []\n   345\tfor (const r of records) {\n   346\t  for (const pt of r.parts) { const c = shardCommit[pt.shard]; for (const ch of pt.chunks) urls.push(`https://raw.githubusercontent.com/${OWNER}/${pt.shard}/${c}/${ch.split('/').map(encodeURIComponent).join('/')}`) }\n   347\t}\n   348\tconsole.log(`vérification ${urls.length} URLs ...`)\n   349\tlet vi = 0, ko = 0\n   350\tawait Promise.all(Array.from({ length: 16 }, async () => {\n   351\t  while (vi < urls.length) {\n   352\t    const u = urls[vi++]\n   353\t    let s = 0\n   354\t    for (let a = 0; a < 3 && s !== 200; a++) { s = await headStatus(u); if (s !== 200) await sleep(800 * (a + 1)) }\n   355\t    if (s !== 200) { ko++; console.error(`  vérif KO (${s}) ${u.slice(-80)}`) }\n   356\t  }\n   357\t}))\n   358\tconsole.log(ko === 0 ? `vérif COMPLÈTE : ${urls.length}/${urls.length} OK ✓` : `vérif: ${ko} KO sur ${urls.length} — NE PAS PURGER`)\n   359\t\n   360\t// ── 6) fin : reindex optionnel + consigne de purge (JAMAIS auto) ─────────────\n   361\tif (REINDEX && ko === 0) {\n   362\t  console.log('reindex ...')\n   363\t  await new Promise((res) => { const c = spawnSync('node', [path.join(path.dirname(new URL(import.meta.url).pathname), 'build-search-index.mjs'), '--apply'], { stdio: 'inherit', env: process.env }); res(c.status) })\n   364\t}\n   365\tawait rm(WORK, { recursive: true, force: true })\n   366\tconsole.log(`\\n=== TERMINÉ — ${records.length} fichiers archivés (${(totalBytes / 1e9).toFixed(2)} Go) ===`)\n   367\tconsole.log((ko === 0 && skipped.length === 0)\n   368\t  ? `Purge locale possible (à TA main, après contrôle dans Create) :\\n  rm -rf \"${SRC}\"`\n   369\t  : ko !== 0\n   370\t    ? `ÉCHECS de