dex-public/main'\n    25\tconst bytesFromB64 = (b64) => Uint8Array.from(atob(b64), (c) => c.charCodeAt(0))\n    26\t\n    27\tasync function fetchHead() {\n    28\t  try { const h = await fetch(`${IDX_BASE}/head.json`, { cache: 'no-store' }).then((r) => r.ok ? r.json() : null); return (h && Array.isArray(h.shards) && h.shards.length) ? h : null } catch { return null }\n    29\t}\n    30\tasync function loadFromCDN(head) {\n    31\t  head = head || await fetchHead()\n    32\t  if (!head) return null\n    33\t  const parts = await Promise.all(head.shards.map(async (s) => {\n    34\t    const fn = s.part != null ? `${s.h}-${s.part}.json` : `${s.h}.json`\n    35\t    try {\n    36\t      const blob = await fetch(`${IDX_BASE}/s/${fn}`).then((r) => r.ok ? r.json() : null)\n    37\t      if (!blob || !blob.ct) return null\n    38\t      const clear = await decryptBytes(bytesFromB64(blob.ct), blob.iv)\n    39\t      return JSON.parse(new TextDecoder().decode(new Uint8Array(clear)))\n    40\t    } catch { return null }\n    41\t  }))\n    42\t  const merged = { builtAt: null, paths: [], thumbs: {}, content: {}, sizes: {}, mimes: {} }\n    43\t  for (const r of parts) { if (!r) continue; if (Array.isArray(r.paths)) merged.paths.push(...r.paths); Object.assign(merged.thumbs, r.thumbs || {}); Object.assign(merged.content, r.content || {}); Object.assign(merged.sizes, r.sizes || {}); Object.assign(merged.mimes, r.mimes || {}) }\n    44\t  // DELTA : ajouts récents (drop/archive/push/HLS) pas encore repliés dans les shards. Petit, chiffré, fusionné.\n    45\t  let deltaAt = ''\n    46\t  try {\n    47\t    const dr = await fetch(`${IDX_BASE}/delta.json`, { cache: 'no-store' }).then((r) => r.ok ? r.json() : null)\n    48\t    if (dr && dr.ct) {\n    49\t      deltaAt = dr.builtAt || ''\n    50\t      const d = JSON.parse(new TextDecoder().decode(new Uint8Array(await decryptBytes(bytesFromB64(dr.ct), dr.iv))))\n    51\t      if (Array.isArray(d.paths)) { const seen = new Set(merged.paths); for (const p of d.paths) if (!seen.has(p)) merged.paths.push(p); Object.assign(merged.thumbs, d.thumbs || {}); Object.assign(merged.content, d.content || {}); Object.assign(merged.sizes, d.sizes || {}); Object.assign(merged.mimes, d.mimes || {}) }\n    52\t      // rm = chemins déplacés/supprimés : on les ôte des chemins issus des shards (sinon résultats périmés -> 404).\n    53\t      if (Array.isArray(d.rm) && d.rm.length) { const rm = new Set(d.rm); merged.paths = merged.paths.filter((p) => !rm.has(p)); for (const p of d.rm) { delete merged.thumbs[p]; delete merged.content[p] } }\n    54\t    }\n    55\t  } catch {}\n    56\t  merged.builtAt = `${head.builtAt || ''}|${deltaAt}` // jeton combiné : change si shards OU delta changent\n    57\t  return merged.paths.length ? merged : null\n    58\t}\n    59\t\n    60\tfunction openDB() {\n    61\t  if (dbPromise) return dbPromise\n    62\t  dbPromise = new Promise((resolve) => {\n    63\t    try {\n    64\t      if (typeof indexedDB === 'undefined') return resolve(null)\n    65\t      const req = indexedDB.open(DB_NAME, 1)\n    66\t      req.onupgradeneeded = () => {\n    67\t        try { const db = req.result; if (!db.objectStoreNames.contains(STORE)) db.createObjectStore(STORE) } catch {}\n    68\t      }\n    69\t      req.onsuccess = () => resolve(req.result)\n    70\t      req.onerror = () => resolve(null)\n    71\t    } catch { resolve(null) }\n    72\t  })\n    73\t  return dbPromise\n    74\t}\n    75\t\n    76\tfunction idbReadIndex() {\n    77\t  return openDB().then((db) => {\n    78\t    if (!db) return null\n    79\t    return new Promise((resolve) => {\n    80\t      try {\n    81\t        const rq = db.transaction(STORE, 'readonly').objectStore(STORE).get(KEY)\n    82\t        rq.onsuccess = () => resolve(rq.result && Array.isArray(rq.result.paths) ? rq.result : null)\n    83\t        rq.onerror = () => resolve(null)\n    84\t      } catch { resolve(null) }\n    85\t    })\n    86\t  }).catch(() => null)\n    87\t}\n    88\t\n    89\tfunction idbWriteIndex(rec) {\n    90\t  openDB().then((db) => {\n    91\t    if (!db) return\n    92\t    try { db.transaction(STORE, 'readwrite').objectStore(STORE).put(rec, KEY) } catch {}\n    93\t  }).catch(() => {})\n    94\t}\n    95\t\n    96\t// État mémoire (vivant tant que l'onglet est ouvert) : évite même le coût IndexedDB par frappe.\n    97\t// E (vignette dans l'index v2) : le record porte AUSSI `thumbs` (carte chemin->{u}|{r,p}) pour\n    98\t// que la recherche affiche les vignettes sans relire un .img.json par image. thumbs absent\n    99\t// (cache v1) -> traité comme {} -> fallback lecture manifeste (comportement actuel inchangé).\n   100\tlet mem = null // { builtAt, paths, thumbs }\n   101\tlet inflight = null\n   102\t\n   103\t// Charge l'index, en privilégiant le cache local. Vérifie le builtAt serveur (action=index est léger\n   104\t// à appeler côté GitHub car le serveur garde un cache mémoire 120 s). Si builtAt identique au cache\n   105\t// local, on garde la copie locale. Sinon on prend la liste fraîche renvoyée et on la persiste.\n   106\texport async function loadSearchIndex() {\n   107\t  if (mem) {\n   108\t    // Rafraîchissement opportuniste en arrière-plan (ne bloque pas l'appelant).\n   109\t    if (!inflight) refresh().catch(() => {})\n   110\t    return mem\n   111\t  }\n   112\t  if (inflight) return inflight\n   113\t  inflight = (async () => {\n   114\t    const local = await idbReadIndex()\n   115\t    if (local) { mem = { builtAt: local.builtAt || null, paths: local.paths, thumbs: (local.thumbs && typeof local.thumbs === 'object') ? local.thumbs : {}, content: (local.content && typeof local.content === 'object') ? local.content : {} } }\n   116\t    // 1) Source PRIMAIRE : index shardé chiffré servi par CDN (0 quota API GitHub).\n   117\t    try {\n   118\t      const fresh = await loadFromCDN()\n   119\t      if (fresh && fresh.paths.length && (!mem || mem.builtAt !== fresh.builtAt)) { mem = fresh; idbWriteIndex(fresh) }\n   120\t    } catch {}\n   121\t    // 2) FALLBACK : ancien index privé via l'API (si le CDN est indispo ou pas encore peuplé).\n   122\t    if (!mem || !mem.paths || !mem.paths.length) {\n   123\t      try {\n   124\t        const j = await fetch('/api/page?action=index', { cache: 'no-store' }).then((r) => r.json())\n   125\t        if (j && Array.isArray(j.paths) && j.paths.length) {\n   126\t          const fresh = { builtAt: j.builtAt || null, paths: j.paths, thumbs: (j.thumbs && typeof j.thumbs === 'object') ? j.thumbs : {}, content: (j.content && typeof j.content === 'object') ? j.content : {} }\n   127\t          if (!mem || mem.builtAt !== fresh.builtAt) { mem = fresh; idbWriteIndex(fresh) }\n   128\t        }\n   129\t      } catch {}\n   130\t    }\n   131\t    inflight = null\n   132\t    return mem\n   133\t  })()\n   134\t  return inflight\n   135\t}\n   136\t\n   137\t// Vérifie en arrière-plan si l'index a changé ; met à jour mem + IndexedDB le cas échéant.\n   138\t// search-6 : on demande d'abord la TÊTE (head=1, quelques octets) pour comparer builtAt. On ne\n   139\t// re-télécharge le corps complet (~11-28 Mo) QUE si le serveur annonce un builtAt différent. Évite\n   140\t// de transférer tout l'index à chaque rafraîchissement opportuniste alors qu'il n'a pas changé.\n   141\tasync function refresh() {\n   142\t  try {\n   143\t    // head.json + delta.json sont minuscules (raw, ~5 min de cache, 0 API). On ne recharge les shards que si le\n   144\t    // jeton combiné (shards|delta) a changé -> capte aussi bien un rebuild complet qu'un simple ajout récent.\n   145\t    const head = await fetchHead(); if (!head) return\n   146\t    let deltaAt = ''\n   147\t    try { const dr = await fetch(`${IDX_BASE}/delta.json`, { cache: 'no-store' }).then((r) => r.ok ? r.json() : null); if (dr) deltaAt = dr.builtAt || '' } catch {}\n   148\t    if (`${head.builtAt || ''}|${deltaAt}` === (mem ? mem.builtAt : null)) return\n   149\t    const fresh = await loadFromCDN(head)\n   150\t    if (fresh && fresh.paths.length && (!mem || mem.builtAt !== fresh.builtAt)) { mem = fresh; idbWriteIndex(fresh) }\n   151\t  } catch {}\n   152\t}\n   153\t\n   154\t// Invalide le cache mémoire (à appeler après un ajout de nœud pour forcer un rechargement frais).\n   155\texport function invalidateSearchIndex() { mem = null; inflight = null }\n   156\t\n   157\t// Carte chemin -> contenu plein-texte normalisé issue de l'index SERVEUR (v3). Vide tant que l'index n'a pas\n   158\t// été régénéré avec contenu. La recherche la fusionne avec le contenu LOCAL (contentIndex.js, auto-indexé).\n   159\texport function getIndexContent() { return (mem && mem.content) || {} }\n   160\t\n   161\t// Taille d'un nœud (octets) depuis l'index -> affichée dans l'app SANS aucun appel API. null si inconnue.\n   162\texport function getNodeSize(path) { const s = mem && mem.sizes; return (s && Number.isFinite(s[path])) ? s[path] : null }\n   163\texport function getNodeMime(path) { const m = mem && mem.mimes; return (m && m[path]) ? m[path] : null }\n   164\t\n   165\t// Méta de l'index chargé (pour l'indicateur bas de Create, à la place du quota API). builtAt = jeton combiné\n   166\t// \"shards|delta\" -> on n'en montre que la partie shards (date du dernier rebuild complet). source = CDN si on a\n   167\t// chargé depuis le repo public chiffré, sinon null.\n   168\texport function getIndexMeta() {\n   169\t  if (!mem || !mem.paths) return null\n   170\t  const at = typeof mem.builtAt === 'string' ? mem.builtAt.split('|')[0] : null\n   171\t  return { count: mem.paths.length, builtAt: at || null, source: 'CDN' }\n   172\t}\n   173\t\n   174\t// SCORING T6 : préfixe > nom > segment de chemin > contenu/sous-chaîne.\n   175\t// CONTRAT DE NORMALISATION (verrouillé, search-3) : nq, normPath et normName DOIVENT avoir été\n   176\t// passés par la MÊME normalisation que App.jsx `norm` -> minuscules, accents retirés (NFD),\n   177\t// séparateurs `/ - _ .` remplacés par des espaces, espaces compactés. La détection de \"segment de\n   178\t// chemin\" ci-dessous repose sur ce contrat (les segments sont délimités par des espaces, pas par `/`).\n   179\t// Si l'appelant change sa normalisation, ce contrat doit rester tenu sous peine de casser le score 1.\n   180\t// Plus le score est BAS, meilleur c'est (on trie ascendant).\n   181\t//   0  = le nom commence par la requête (préfixe exact du nom)        -> meilleur\n   182\t//   1  = un segment du chemin commence par la requête\n   183\t//   2  = le nom contient la requête (pas en préfixe)\n   184\t//   3  = le chemin contient la requête (contenu / sous-chaîne ailleurs)\n   185\t//   -1 = pas de match\n   186\texport function scoreMatch(normPath, normName, nq) {\n   187\t  if (!nq) return 3\n   188\t  if (normName.startsWith(nq)) return 0\n   189\t  // Segment de chemin commençant par la requête (ex: \"build/cal\" matche segment \"calendar\").\n   190\t  // split(/\\s+/) (tout blanc) plutôt qu'un espace littéral : robuste même si la normalisation laisse\n   191\t  // un double espace, sans rien changer au comportement nominal.\n   192\t  const segs = normPath.split(/\\s+/)\n   193\t  for (const s of segs) { if (s.startsWith(nq)) return 1 }\n   194\t  if (normName.includes(nq)) return 2\n   195\t  if (normPath.includes(nq)) return 3\n   196\t  return -1\n   197\t}\n     1\t// Construit l'INDEX DE RECHERCHE v2 de zenray-data (pages/.zr-search-index.json).\n     2\t//\n     3\t// EN CLAIR POUR TOUS : la recherche tape dans une grande liste de tous les fichiers. Avant (v1),\n     4\t// cette liste ne contenait QUE des chemins. Du coup, pour afficher la petite image (vignette) de\n     5\t// chaque résultat, l'appli devait, image par image, aller relire un petit fichier descripteur\n     6\t// (.img.json) juste pour reconstruire l'adresse de la vignette. Sur 1 million d'images, ce sont\n     7\t// 1 million de petits allers-retours = lent et ça épuise le quota GitHub.\n     8\t//\n     9\t// v2 ajoute, à côté de la liste de chemins, une CARTE \"thumbs\" : pour chaque image, l'adresse\n    10\t// directe de sa vignette, déjà calculée. L'appli n'a donc plus rien à relire : elle affiche tout\n    11\t// de suite. Deux formes possibles dans la carte :\n    12\t//   - PUBLIQUE : { \"u\": \"<url jsDelivr .webp figée sur un commit>\" }  -> immuable, hors quota.\n    13\t//   - PRIVÉE   : { \"r\": \"<repo shard>\", \"p\": \"<chemin .webp haché>\" } -> l'appli bâtit /api/shard.\n    14\t// Une image sans vignette calculable est OMISE (pas de fausse vignette : placeholder propre côté rendu).\n    15\t//\n    16\t// CONSTRUCTION EN GIT (hors quota REST, parallélisable) : on CLONE zenray-data en local (sparse sur\n    17\t// pages/, blob:none pour ne pas tirer l'historique), on marche l'arbre DISQUE pour la liste de\n    18\t// chemins (identique v1), et on lit/parse chaque .img.json SUR DISQUE (zéro réseau) pour bâtir la\n    19\t// carte thumbs. Aucune consommation de quota GitHub.\n    20\t//\n    21\t// DRY-RUN PAR DÉFAUT (CONTRAINTE P0) : par défaut le script NE PUSH RIEN. Il logge la taille, le\n    22\t// nombre d'images indexées et 5 exemples de thumbs. Le push (Git Data API : base_tree + 1 entrée,\n    23\t// préserve tout le reste) n'a lieu QUE si on passe le flag --apply (réservé à Matthieu après revue).\n    24\t//\n    25\t// Usage DRY-RUN : GITHUB_TOKEN=$(gh auth token) node scripts/build-search-index.mjs\n    26\t// Usage PUSH    : GITHUB_TOKEN=$(gh auth token) node scripts/build-search-index.mjs --apply\n    27\t\n    28\timport { readFile, readdir, rm, writeFile, mkdir, stat } from 'node:fs/promises'\n    29\timport { readFileSync } from 'node:fs'\n    30\timport { execFileSync } from 'node:child_process'\n    31\timport { webcrypto, createHash } from 'node:crypto'\n    32\timport { fileURLToPath } from 'node:url'\n    33\timport os from 'node:os'\n    34\timport path from 'node:path'\n    35\t\n    36\tconst OWNER = 'matthieuhuguet'\n    37\tconst REPO = `${OWNER}/zenray-data`\n    38\tconst BRANCH = 'main'\n    39\tconst TOKEN = process.env.GITHUB_TOKEN\n    40\tconst APPLY = process.argv.includes('--apply')\n    41\tconst WORK = path.join(os.tmpdir(), 'zr_index_build')\n    42\tconst INDEX_PATH = 'pages/.zr-search-index.json'\n    43\tconst NODE_RE = /\\.(md|db\\.json|media\\.json|img\\.json|canvas\\.json|embed\\.json|file\\.json)$/\n    44\tconst CPU = Math.max(1, (os.cpus() || []).length || 8)\n    45\t\n    46\tif (!TOKEN) { console.error('no GITHUB_TOKEN'); process.exit(1) }\n    47\t\n    48\t// URL jsDelivr PINNÉE commit (alignée sur shardNaming.js buildJsDelivrUrl côté client).\n    49\tconst buildJsDelivrUrl = (repo, commit, p) => (!repo || !commit || !p) ? null : `https://cdn.jsdelivr.net/gh/${OWNER}/${repo}@${commit}/${p}`\n    50\tconst toWebp = (p) => (typeof p === 'string' ? p.replace(/\\.[^./]+$/, '.webp') : null)\n    51\t\n    52\t// Valeur thumbs pour un manifeste .img.json, RÉUTILISE EXACTEMENT la logique de shardThumbUrl\n    53\t// (ImageNodeViewer.jsx) : public + cdnRepo/cdnPath/cdnCommit -> {u} jsDelivr .webp ; sinon repo+path\n    54\t// (privé/legacy) -> {r,p} avec path.webp ; sinon (rien de constructible) -> null (omis).\n    55\t// search-8 : MIROIR de thumbEntry (server/page.js index-add) et de shardThumbUrl (ImageNodeViewer.jsx).\n    56\t// Ces TROIS implémentations encodent le même invariant « manifeste -> vignette vis-aware ». Si la règle\n    57\t// de visibilité change, garder les trois synchronisées (sinon vignettes incohérentes selon le chemin).\n    58\t//\n    59\t// E (chiffrement public) : un thumb public peut désormais être CHIFFRÉ (modèle \"public + chiffré + jsDelivr\").\n    60\t// Dans ce cas l'URL jsDelivr pointe sur du CIPHERTEXT inutilisable tel quel dans <img> : la recherche doit\n    61\t// fetch + déchiffrer (AES-GCM) avec l'IV de la VIGNETTE avant d'afficher. On joint donc `iv` à l'entrée -> {u, iv}.\n    62\t// L'IV de la vignette est `thumbIv` (IV propre au .webp chiffré, distinct de l'IV du binaire plein). Rétro-compat :\n    63\t// un manifeste public NON chiffré (pas de thumbIv/alg) reste `{u}` seul -> URL servie directement à <img> (clair),\n    64\t// comportement inchangé. L'IV n'est PAS secret (juste unique par chiffrement) : aucune fuite à le publier dans l'index.\n    65\tfunction thumbEntry(m) {\n    66\t  if (!m || typeof m !== 'object') return null\n    67\t  if (m.vis === 'public' && m.cdnRepo && m.cdnPath && m.cdnCommit) {\n    68\t    const u = buildJsDelivrUrl(m.cdnRepo, m.cdnCommit, toWebp(m.cdnPath))\n    69\t    if (!u) return null\n    70\t    // Vignette chiffrée -> joindre l'IV du .webp (thumbIv) pour permettre le déchiffrement client.\n    71\t    if (m.thumbIv && m.alg) return { u, iv: m.thumbIv }\n    72\t    return { u }\n    73\t  }\n    74\t  if (m.repo) {\n    75\t    // Vignette = chemin haché + .webp (vérité unique ; aucun champ `thumb` n'est jamais écrit au manifest).\n    76\t    const p = toWebp(m.path)\n    77\t    if (p) return { r: m.repo, p }\n    78\t  }\n    79\t  return null\n    80\t}\n    81\t\n    82\t// Marche récursive de l'arbre disque (sous pages/) -> chemins de nœuds (relatifs à la racine du repo).\n    83\tasync function walk(absRoot, relDir, out) {\n    84\t  const abs = path.join(absRoot, relDir)\n    85\t  let entries\n    86\t  try { entries = await readdir(abs, { withFileTypes: true }) } catch { return }\n    87\t  const subdirs = []\n    88\t  for (const e of entries) {\n    89\t    const rel = relDir ? `${relDir}/${e.name}` : e.name\n    90\t    if (e.isDirectory()) subdirs.push(rel)\n    91\t    else if (e.isFile() && NODE_RE.test(e.name)) out.push(rel)\n    92\t  }\n    93\t  for (const d of subdirs) await walk(absRoot, d, out)\n    94\t}\n    95\t\n    96\t// CONTENU PLEIN-TEXTE (recherche par mot-clé dans les markdowns ET les tables).\n    97\t// .md  : on dégraisse la syntaxe markdown (liens/images/marqueurs) -> texte brut.\n    98\t// .db.json : noms de colonnes + toutes les valeurs de cellules concaténés.\n    99\t// Normalisé (minuscules, accents retirés, espaces compactés) + tronqué (~6 Ko) pour garder l'index léger.\n   100\tconst normTxt = (s) => (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\\s+/g, ' ').trim().slice(0, 6000)\n   101\tconst mdToText = (md) => (md || '')\n   102\t  .replace(/!\\[[^\\]]*\\]\\([^)]*\\)/g, ' ') // images\n   103\t  .replace(/\\[([^\\]]*)\\]\\([^)]*\\)/g, '$1') // liens -> texte\n   104\t  .replace(/[#>*_`~|-]+/g, ' ') // marqueurs\n   105\t  .replace(/<[^>]+>/g, ' ')\n   106\tconst dbToText = (json) => {\n   107\t  try {\n   108\t    const j = JSON.parse(json)\n   109\t    const heads = (j.columns || []).map((c) => c.name).join(' ')\n   110\t    const cells = (j.rows || []).map((r) => Object.values(r.cells || r || {}).map((v) => (v && typeof v === 'object') ? '' : String(v ?? '')).join(' ')).join(' ')\n   111\t    return `${j.name || ''} ${heads} ${cells}`\n   112\t  } catch { return '' }\n   113\t}\n   114\tasync function buildContent(absRoot, textPaths) {\n   115\t  const content = {}\n   116\t  let i = 0\n   117\t  async function worker() {\n   118\t    while (i < textPaths.length) {\n   119\t      const rel = textPaths[i++]\n   120\t      try {\n   121\t        const raw = await readFile(path.join(absRoot, rel), 'utf8')\n   122\t        const txt = normTxt(rel.endsWith('.db.json') ? dbToText(raw) : mdToText(raw))\n   123\t        if (txt) content[rel] = txt\n   124\t      } catch { /* illisible -> omis */ }\n   125\t    }\n   126\t  }\n   127\t  await Promise.all(Array.from({ length: Math.min(CPU, 16) }, worker))\n   128\t  return content\n   129\t}\n   130\t\n   131\t// Lecture + parse parallélisée (CPU cœurs) des .img.json -> remplit la carte thumbs.\n   132\tasync function buildThumbs(absRoot, imgPaths) {\n   133\t  const thumbs = {}\n   134\t  let i = 0\n   135\t  async function worker() {\n   136\