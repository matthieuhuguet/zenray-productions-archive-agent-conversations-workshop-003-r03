rPart = { shard, chunks: [] }\n   287\t      }\n   288\t      const cname = chunkPath(fid, ci)\n   289\t      const cdst = path.join(shardDir, cname)\n   290\t      await mkdir(path.dirname(cdst), { recursive: true })\n   291\t      const out = createWriteStream(cdst)\n   292\t      let written = 0\n   293\t      while (written < CHUNK && pos < curSize) {\n   294\t        const { bytesRead } = await fd.read(buf, 0, Math.min(buf.length, CHUNK - written), pos)\n   295\t        if (!bytesRead) break\n   296\t        await new Promise((res, rej) => out.write(buf.subarray(0, bytesRead), (e) => e ? rej(e) : res()))\n   297\t        written += bytesRead; pos += bytesRead\n   298\t      }\n   299\t      await new Promise((res) => out.end(res))\n   300\t      curPart.chunks.push(cname); ci++\n   301\t      shardBytes += written; sincePush += written\n   302\t      if (sincePush >= PUSH_CHUNK) { if (!await pushChunk()) throw new Error('push-incr') }\n   303\t    } while (pos < curSize)\n   304\t  } finally { await fd.close().catch(() => {}) }\n   305\t  if (curPart.chunks.length) rec.parts.push(curPart)\n   306\t  records.push(rec); done++\n   307\t  if (done % 25 === 0 || curSize > RAW_MAX) console.log(`  [${done} maj / ${unchanged} inchangés / ${skipped.length} skip / ${files.length}] ${f.rel} (${(curSize / 1048576).toFixed(1)} Mo, ${ci} chunk(s)${rec.parts.length > 1 ? `, ${rec.parts.length} parts` : ''}) [shard ${(shardBytes / 1073741824).toFixed(2)} Go]`)\n   308\t } catch (e) {\n   309\t  if (/push-/.test(e.message)) throw e // erreur réseau/push = fatale, on ne perd pas de données\n   310\t  skipped.push({ rel: f.rel, reason: e.code || e.message }); console.error(`  ⚠ SKIP (${e.code || e.message}) ${f.rel}`)\n   311\t }\n   312\t}\n   313\tawait flushShard()\n   314\tconsole.log(`\\n${records.length} fichier(s) nouveaux/modifiés · ${unchanged} inchangé(s) (déjà versionnés, non re-poussés)`)\n   315\tif (skipped.length) {\n   316\t  console.error(`\\n⚠ ${skipped.length}