AD:main'], 120000)\n   229\t    if (ps.status !== 0) throw new Error('push-init: ' + (ps.stderr || '').slice(-200))\n   230\t    console.log(`\\n>>> SHARD ${shard} ouvert (nouveau)`)\n   231\t  }\n   232\t  shardBytes = 0; sincePush = 0\n   233\t}\n   234\tasync function pushChunk() {\n   235\t  const st = git(shardDir, ['status', '--porcelain'])\n   236\t  if (!st.stdout.trim()) return true\n   237\t  git(shardDir, ['add', '-A…100 tokens truncated…al est déjà fait : chaque\n   241\t  // retry repousse le MÊME état (idempotent), donc patienter pendant l'outage puis reprendre est toujours sûr.\n   242\t  for (let a = 0; a < 40; a++) { const ps = git(shardDir, ['push', '-q', 'origin', 'HEAD:main'], 600000); if (ps.status === 0) { sincePush = 0; return true } console.error(`  push retry ${a + 1}/40`, (ps.stderr || '').slice(-140)); await sleep(Math.min(120000, 4000 * (a + 1))) }\n   243\t  return false\n   244\t}\n   245\tasync function flushShard() {\n   246\t  if (!await pushChunk()) throw new Error('push-final ' + shard)\n   247\t  shardCommit[shard] = git(shardDir, ['rev-parse', 'HEAD']).stdout.trim()\n   248\t  console.log(`  ✓ ${shard} poussé (commit ${shardCommit[shard].slice(0, 7)}, ${(shardBytes / 1073741824).toFixed(2)} Go)`)\n   249\t}\n   250\t\n   251\t// ── 3) COPIE (bruts + chunks) — séquentiel, RAM bornée ───────────────────────\n   252\tawait openShard()\n   253\tconst records = [] // nouveaux/modifiés seulement : { rel, size, sha256, mime, shard, chunks[], prevVersions }\n   254\tconst skipped = [] // fichiers illisibles/disparus pendant le run : { rel, reason } — JAMAIS silencieux, listés à la fin\n   255\tlet done = 0, unchanged = 0\n   256\tfor (const f of files) {\n   257\t // ROBUSTESSE : un seul fichier disparu (ENOENT) ou illisible (EACCES, I/O) ne doit PAS avorter un upload de\n   258\t // 100+ Go. On l'isole : log + skip + on continue. Les erreurs réseau (pushChunk) restent fatales (rethrow).\n   259\t try {\n   260\t  // Le fichier existe-t-