SHARD_CAP_BYTES, shardName, jsDelivrUrl,\n  buildPublicImgManifest, GIT_ENV,\n} from './lib/img-pipeline.mjs'\n\n// OUTILS IMAGE Node : cwebp (libwebp) pour la vignette .webp ; sips (natif macOS) pour les dimensions et\n// pour décoder les formats que cwebp ne lit pas (HEIC, TIFF exotiques) en PNG intermédiaire. ffprobe reste\n// un dernier recours pour les dimensions. Tous surchargeables par env pour portabilité.\nconst CWEBP = process.env.ZR_CWEBP || '/opt/homebrew/bin/cwebp'\nconst SIPS = process.env.ZR_SIPS || '/usr/bin/sips'\nconst FFPROBE = process.env.ZR_FFPROBE || '/opt/homebrew/bin/ffprobe'\nconst FFMPEG = process.env.ZR_FFMPEG || '/opt/homebrew/bin/ffmpeg'\n\n// BARREAU AFFICHAGE : version « plein écran » d'une grosse image. jsDelivr plafonne à 20 Mo/fichier ; un JPEG\n// DJI de 32 Mo ne s'ouvrirait donc PAS en grand via le CDN. On en fait une version ré-encodée (4K max, qualité\n// haute) garantie < ~19 Mo, servie par jsDelivr. L'original reste pour le téléchargement. Parallèle de l'échelle\n// vidéo. Renvoie un Buffer JPEG < cap, ou null (best-effort : un échec retombe sur l'original).\nconst DISP_CAP = 19.5 * 1024 * 1024\nfunction makeDisplayJpeg(abs, work) {\n  const out = path.join(work, `disp-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 7)}.jpg`)\n  const cleanup = () => { try { execFileSync('rm', ['-f', out]) } catch {} }\n  // QUALITÉ MAX D'ABORD, pleine résolution. On veut REMPLIR le budget 19,5 Mo (quasi pas de recompression), pas\n  // sur-compresser. On descend d'un cran SEULEMENT si le fichier dépasse le cap. -q:v 2 = qualité mjpeg quasi max.\n  // scale='iw' = pleine résolution (pas de downscale). On ne réduit la résolution qu'en tout dernier recours.\n  // q:v 1 = qualité mjpeg MAXIMALE (échelle 1=best … 31=worst). On garde la PLEINE résolution et le max de qualité ;\n  // on ne descend que si ça dépasse 19,5 Mo (rare : à pleine rés q1 les DJI font ~5-10 Mo).\n  const tries = [\n    { scale: 'iw', q: '1' }, { scale: 'iw', q: '2' }, { scale: 'iw', q: '3' },\n    { scale: 'min(6000,iw)', q: '1' }, { scale: 'min(5120,iw)', q: '2' }, { scale: 'min(4096,iw)', q: '3' },\n  ]\n  for (const tr of tries) {\n    try {\n      execFileSync(FFMPEG, ['-y', '-i', abs, '-vf', `scale='${tr.scale}':-2`, '-q:v', tr.q, out], { stdio: ['ignore', 'ignore', 'ignore'], timeout: 120000 })\n      const buf = readFileSync(out)\n      if (buf && buf.length && buf.length < DISP_CAP) { cleanup(); return buf }\n    } catch { /* tentative suivante / repli sips */ }\n  }\n  cleanup()\n  // repli sips (HEIC/RAW/exotique que ffmpeg ne lit pas) : qualité 92, pleine résolution.\n  try {\n    execFileSync(SIPS, ['-s', 'format', 'jpeg', '-s', 'formatOptions', '92', abs, '--out', out], { stdio: ['ignore', 'ignore', 'ignore'], timeout: 120000 })\n    let buf = readFileSync(out)\n    if (buf.length >= DISP_CAP) { execFileSync(SIPS, ['-Z', '4096', '-s', 'format', 'jpeg', '-s', 'formatOptions', '85', abs, '--out', out]); buf = readFileSync(out) }\n    cleanup()\n    return buf && buf.length && buf.length < DISP_CAP ? buf : null\n  } catch { cleanup(); return null }\n}\n\n// L'image est poussée TELLE QUELLE (octets d'origine chiffrés) : on ne ré-encode PAS le binaire principal\n// (préserve la qualité, garde l'idempotence par hash du clair d'origine). Seule la vignette est dérivée.\n\n// Mesure (w,h) : sips d'abord (natif, lit HEIC/RAW), ffprobe en repli. Best-effort : 0,0 si illisible.\nfunction imageDims(abs) {\n  try {\n    const out = execFileSync(SIPS, ['-g', 'pixelWidth', '-g', 'pixelHeight', abs], { stdio: ['ignore', 'pipe', 'ignore'], timeout: 30000 }).toString()\n    const w = (out.match(/pixelWidth:\\s*(\\d+)/) || [])[1]\n    const h = (out.match(/pixelHeight:\\s*(\\d+)/) || [])[1]\n    if (w && h) return { w: parseInt(w, 10), h: parseInt(h, 10) }\n  } catch {}\n  try {\n    const out = execFileSync(FFPROBE, ['-v', 'error', '-select_streams', 'v:0', '-show_entries', 'stream=width,height', '-of', 'csv=p=0:s=x', abs], { stdio: ['ignore', 'pipe', 'ignore'], timeout: 30000 }).toString().trim()\n    const m = out.match(/(\\d+)x(\\d+)/)\n    if (m) return { w: parseInt(m[1], 10), h: parseInt(m[2], 10) }\n  } catch {}\n  return { w: 0, h: 0 }\n}\n\n// Vignette .webp (≤384px de large, ratio préservé), comme makeThumbWebp côté app. cwebp -resize W 0 garde\n// le ratio (0 = auto). Si cwebp ne lit pas le format (HEIC/exotique), on passe par sips -> PNG temp d'abord.\n// Renvoie un Buffer webp, ou null si échec (vignette optionnelle : un échec ne casse jamais l'ingestion).\nfunction makeThumbWebp(abs, work) {\n  const tryCwebp = (src) => {\n    try {\n      const out = execFileSync(CWEBP, ['-quiet', '-q', '72', '-resize', '384', '0', src, '-o', '-'], { stdio: ['ignore', 'pipe', 'ignore'], timeout: 60000, maxBuffer: 1 << 26 })\n      return out && out.length ? out : null\n    } catch { return null }\n  }\n  // 0) PRIORITÉ : ImageMagick avec -auto-orient. cwebp IGNORE l'orientation EXIF -> les photos iPhone portrait\n  //    (EXIF RightTop/orientation 6/8) donnaient une VIGNETTE couchée alors que l'original s'affiche droit.\n  //    -auto-orient cuit la rotation dans les pixels (vignette uniquement, l'original n'est jamais touché).\n  try {\n    const out = execFileSync('magick', [abs + '[0]', '-auto-orient', '-resize', '384x', '-quality', '72', '-strip', 'webp:-'], { stdio: ['ignore', 'pipe', 'ignore'], timeout: 60000, maxBuffer: 1 << 26 })\n    if (out && out.length) return out\n  } catch {}\n  // 1) repli : cwebp direct (PNG/JPEG/TIFF/WebP) — sans correction d'orientation\n  const direct = tryCwebp(abs)\n  if (direct) return direct\n  // 2) repli : sips décode -> PNG temp -> cwebp\n  try {\n    const tmpPng = path.join(work, `thumbsrc-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 7)}.png`)\n    execFileSync(SIPS, ['-s', 'format', 'png', abs, '--out', tmpPng], { stdio: ['ignore', 'ignore', 'ignore'], timeout: 60000 })\n    const out = tryCwebp(tmpPng)\n    try { execFile