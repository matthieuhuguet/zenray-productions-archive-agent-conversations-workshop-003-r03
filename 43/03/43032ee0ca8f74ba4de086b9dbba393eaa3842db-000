lk) ───────────────────────────────────────────────────────\n// Pousse l'image chiffrée + sa vignette sur le shard public courant, renvoie le blob manifeste\n// { path:'<dest>/<rel>.img.json', content } à committer sur zenray-data par le bulk (avec les autres).\n// IMPORTANT : le commit SHA jsDelivr n'est connu qu'au flush() final. On renvoie donc un manifeste avec\n// un PLACEHOLDER de commit que le bulk RÉSOUT après flush (resolveImgManifests ci-dessous).\nexport async function ingestImageBulk(absPath, rel, dest, ctx) {\n  if (!ctx.dir) await ctx.openShard()\n  const clear = await readFile(absPath)\n  const hash = sha256Hex(clear)\n  const ext = (rel.match(/\\.([a-z0-9]+)$/i) || [, 'bin'])[1].toLowerCase()\n  const { w, h } = imageDims(absPath)\n\n  // binaire principal chiffré (IV déterministe = dédup)\n  const { cipher } = encryptDeterministic(clear, ctx.key, hash)\n  const cdnPath = shardPathFor(hash, ext)\n  const repo = await ctx.writeBinary(cdnPath, cipher)\n\n  // vignette webp chiffrée (best-effort), avec son PROPRE IV (contenu distinct)\n  let thumbIv = null\n  let thumbPath = null\n  const thumbBuf = makeThumbWebp(absPath, ctx.work)\n  if (thumbBuf) {\n    const tHash = sha256Hex(thumbBuf)\n    const enc = encryptDeterministic(thumbBuf, ctx.key, tHash)\n    thumbIv = enc.iv\n    thumbPath = shardPathFor(tHash, 'webp')\n    await ctx.writeBinary(thumbPath, enc.cipher)\n  }\n\n  // BARREAU AFFICHAGE : SEULEMENT si l'original dépasse la limite jsDelivr (~20 Mo). En dessous, jsDelivr sert\n  // déjà l'original en plein écran -> pas de version d'affichage (zéro coût). Au-dessus, on génère une version\n  // ré-encodée < 19 Mo (chiffrée, son propre IV) que le CDN servira en grand. L'original reste pour le download.\n  let dispIv = null, dispPath = null\n  if (clear.length > 19 * 1024 * 1024) { // seulement les originaux qui dépassent VRAIMENT la limite jsDelivr (~20 Mo)\n    const dispBuf = makeDisplayJpeg(absPath, ctx.work)\n    if (dispBuf) {\n      const dHash = sha256Hex(dispBuf)\n      const enc = encryptDeterministic(dispBuf, ctx.key, dHash)\n      dispIv = enc.iv\n      dispPath = shardPathFor(dHash, 'jpg')\n      await ctx.writeBinary(dispPath, enc.cipher)\n    }\n  }\n\n  // manifeste : on connaît tout SAUF le commit SHA (rempli au flush). On stocke les morceaux et on laissera\n  // le bulk résoudre cdnCommit + l'URL jsDelivr de la vignette. iv = IV déterministe (= ivFromHash du clair).\n  const iv = ivFromHash(hash).toString('base64')\n  const pending = {\n    path: `${dest}/${rel}.img.json`,\n    repo, cdnPath, iv, thumbIv, thumbPath, dispIv, dispPath,\n    base: { name: path.basename(rel), ext, w, h, clearSize: clear.length },\n  }\n  return pending // résolu en blob final par resolveImgManifest() après ctx.flush()\n}\n\n// Après flush() (commit SHA connus), transforme un `pending` en blob manifeste final { path, content }.\n// thumbUrl jsDelivr@sha (servie en clair côté CDN, déchiffrée par /api/media-key via thumbIv côté app).\nexport function resolveImgManifest(pending, ctx) {\n  const commit = ctx.commitOf[pending.repo]\n  if (!commit) throw new Error('commit img shard manquant pour ' + pending.repo)\n  const m = buildPublicImgManifest({\n    name: pending.base.name, ext: pending.base.ext, w: pending.base.w, h: pending.base.h,\n    clearSize: pending.base.clearSize, addedAt: new Date().toISOString(),\n    cdnRepo: pending.repo, cdnPath: pending.cdnPath, cdnCommit: commit,\n    iv: pending.iv, thumbIv: pending.thumbIv,\n  })\n  // thumb (URL jsDelivr@sha) si une vignette a été poussée — champ lu par le Drive/Finder pour l'aperçu.\n  if (pending.thumbPath) m.thumb = jsDelivrUrl(ctx.owner, pending.repo, commit, pending.thumbPath)\n  // BARREAU AFFICHAGE (original > 20 Mo) : chemin haché + IV. Le viewer le préfère en plein écran (servi par le\n  // CDN, < 20 Mo) ; l'original (cdnPath) reste pour le téléchargement.\n  if (pending.dispPath) { m.dispPath = pending.dispPath; m.dispIv = pending.dispIv }\n  return { 