 GENV }); hasContent = r.status === 0 && !!(r.stdout || '').toString().trim() } catch {}\n    if (hasContent) {\n      const cl = spawnSync('git', ['clone', '--quiet', url, ctx.dir], { encoding: 'utf8', env: GENV, timeout: 600000, killSignal: 'SIGKILL' })\n      if (cl.status !== 0) throw new Error('clone img shard: ' + (cl.stderr || '').slice(-200))\n      ctx.log(`  >>> shard image ${ctx.repo} rouvert`)\n    } else {\n      await mkdir(ctx.dir, { recursive: true })\n      git(ctx.dir, ['init', '-q']); git(ctx.dir, ['branch', '-M', 'main'])\n      git(ctx.dir, ['config', 'user.email', 'bot@zenray']); git(ctx.dir, ['config', 'user.name', 'zenray-bot'])\n      git(ctx.dir, ['config', 'http.version', 'HTTP/1.1'])\n      await writeFile(path.join(ctx.dir, 'README.md'), '# ZenRay image shard (public, chiffré AES-GCM, servi par jsDelivr)\\n\\nBinaires images chiffrés, nommés par empreinte. Clé maître hors de ce dépôt.\\n')\n      // créer le repo distant public (idempotent : déjà existant = 422 toléré)\n      const cr = spawnSync('gh', ['repo', 'create', `${owner}/${ctx.repo}`, '--public', '-d', 'ZenRay image shard (encrypted, jsDelivr)'], { encoding: 'utf8' })\n      if (cr.status !== 0 && !/already exists|Name already/i.test((cr.stderr || '') + (cr.stdout || ''))) {\n        // repli REST si gh indispo\n        spawnSync('curl', ['-s', '-o', '/dev/null', '-X', 'POST', '-H', `Authorization: Bearer ${token}`, 'https://api.github.com/user/repos', '-d', JSON.stringify({ name: ctx.repo, private: false })], { encoding: 'utf8' })\n      }\n      git(ctx.dir, ['add', '-A']); git(ctx.dir, ['commit', '-q', '-m', 'init'])\n      git(ctx.dir, ['remote', 'add', 'origin', url])\n      const ps = git(ctx.dir, ['push', '-q', '-f', 'origin', 'HEAD:main'], 120000)\n      if (ps.status !== 0) throw new Error('push-init img shard: ' + (ps.stderr || '').slice(-200))\n      ctx.log(`  >>> shard image ${ctx.repo} ouvert (nouveau)`)\n    }\n    ctx.bytes = 0; ctx.pending = 0\n  }\n\n  // push