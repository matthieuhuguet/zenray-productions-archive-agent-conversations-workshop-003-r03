main'], 600000)\n      await sleep(Math.min(60000, 3000 * (a + 1)))\n    }\n    return false\n  }\n\n  // Écrit une part (déjà hachée) dans le clone. Rollover AVANT écriture si le shard atteint le cap. Push\n  // incrémental tous les ~400 Mo (anti-RAM, anti-packfile géant). Renvoie le repo où elle a atterri.\n  async function writePart(hashedPath, buf) {\n    if (ctx.bytes >= SHARD_CAP) { if (!await pushShard()) throw new Error('push-incr vidraw'); ctx.commitOf[ctx.repo] = git(ctx.dir, ['rev-parse', 'HEAD']).stdout.trim(); await openShard() }\n    const dst = path.join(ctx.dir, hashedPath)\n    await mkdir(path.dirname(dst), { recursive: true })\n    await writeFile(dst, buf)\n    ctx.bytes += buf.length; ctx.pendingBytes += buf.length\n    if (ctx.pendingBytes >= 400 * 1024 * 1024) { if (!await pushShard()) throw new Error('push-incr vidraw') }\n    return ctx.repo\n  }\n\n  async function flush() {\n    if (ctx.dir && existsSync(ctx.dir)) {\n      if (!await pushShard()) throw new Error('push-final vidraw ' + ctx.repo)\n      ctx.commitOf[ctx.repo] = git(ctx.dir, ['rev-parse', 'HEAD']).stdout.trim()\n      log(`  ✓ ${ctx.repo} poussé (commit ${(ctx.commitOf[ctx.repo] || '').slice(0, 7)})`)\n    }\n  }\n  // commit SHA courant du shard (pour pinner raw.github tout de suite après le flush d'UNE vidéo)\n  function headSha() { return ctx.dir ? git(ctx.dir, ['rev-parse', 'HEAD']).stdout.trim() : null }\n\n  ctx.openShard = openShard; ctx.writePart = writePart; ctx.pushShard = pushShard; ctx.flush = flush; ctx.headSha = headSha\n  return ctx\n}\n\n// ── INGESTION D'UNE VIDÉO BRUTE ───────────────────────────────────────────────────────────────────────\n// Découpe le fichier ORIGINAL en parts de 95 Mo (lecture streamée, anti-OOM), les pousse via le ctx shard,\n// pousse le poster, et renvoie le manifeste .media.json (type 'video-raw') prêt à committer sur zenray-data.\n// CONFIRMÉ EN LIGNE = ce manifeste committé (le bulk le fait), pas avant. URLs raw.github pinnées sur le commit.\nexport async function ingestVideoRaw(file, { dest, base, vctx, posterCtx = null, workDir = '/tmp/zr_vidraw', log = noop }) {\n  const p = await probe(file)\n  const outDir = path.join(workDir, base.replace(/[^\\w.-]/g, '_') + '-' + Date.now().toString(36))\n  await mkdir(outDir, { recursive: true })\n\n  // 0) FASTSTART : index au début -> la lecture démarre avec la 1re part. Lossless (-c copy), pas d'encodage.\n  //    On découpe ENSUITE ce fichier (et plus l'original) pour que la part 1 contienne l'index.\n  const srcFile = await remuxFaststart(file, outDir, log)\n  const total = (await stat(srcFile)).size\n  const nParts = Math.ceil(total / PART)\n  log(`${base} — ${(total / 1073741824).toFixed(2)} Go, ${p.width}x${p.height} ${p.codec}, ${nParts} parts de 95 Mo (AUCUN réencodage)`)\n\n  // 1) poster (1 frame, best-effort) depuis l'original\n  const posterFile = await makePoster(file, outDir, p.duration ? p.duration / 2 : 1)\n\n  // 2) split streamé du fichier (faststart) + push part par part (jamais le fichier entier en RAM)\n  const parts = []           // { idx, repo, path, hash, size }\n  const fd = await open(srcFile, 'r')\n  const b = Buffer.alloc(PART)\n  try {\n    let off = 0, idx = 0\n    while (off < total) {\n      const { bytesRead } = await fd.read(b, 0, PART, off)\n      if (!bytesRead) break\n      const slice = Buffer.from(b.subarray(0, bytesRead)) // copie : writePart est async, on réutilise b\n      const h = sha256(slice); const hp = partPathFor(h)\n      const repo = await vctx.writePart(hp, slice)\n      parts.push({ idx, repo, path: hp, hash: h, size: bytesRead })\n      off += bytesRead; idx++\n      if (idx % 5 === 0 || off >= total) log(`  part ${idx}/${nParts} (${(off / 1073741824).toFixed(2)}/${(total / 1073741824).toFixed(2)} Go)`)\n    }\n  } finally { await fd.close() }\n\n  // poster en part raw (simple, toujours dispo) — petit, va dans le shard courant\n  let posterPart = null\n  if (posterFile) {\n    try {\n      const pb = await readFile(posterFile)\n      const h = sha256(pb); const hp = `${h.slice(0, 2)}/${h.slice(2, 4)}/${h}.jpg`\n      const repo = await vctx.writePart(hp, pb)\n      posterPart = { repo, path: hp }\n    } catch (e) { log(`  ⚠ poster: ${(e.message || e).toString().slice(0, 80)}`) }\n  }\n\n  // 3) flush du shard -> commit SHA connu -> URLs raw.github pinnées\n  await vctx.flush()\n  const shaOf = (repo) => vctx.commitOf[repo] || vctx.headSha()\n  const partUrls = parts.map((pt) => rawUrl(pt.repo, shaOf(pt.repo), pt.path))\n  const posterUrl = posterPart ? rawUrl(posterPart.repo, shaOf(posterPart.repo), posterPart.path) : null\n\n  // 4) manifeste .media.json (type 'video-raw'). offsets cumulés -> le Service Worker mappe un Range -> part(s).\n  let acc = 0\n  const partsMeta = parts.map((pt) => { const start = acc; acc += pt.size; return { url: partUrls[pt.idx], start, end: acc - 1, size: pt.size } })\n  const manifest = {\n    type: 'video-raw', v: 1, name: path.basename(file), mime: mimeOf(file),\n    size: total, codec: p.codec, width: p.width, height: p.height, duration: p.duration,\n    parts: partsMeta, poster: posterUrl,\n  }\n  const manifestPath = `${dest}/${base}.${path.basename(file).split('.').pop().toLowerCase()}.media.json`\n  await rm(outDir, { recursive: true, force: true }).catch(() => {})\n  return { manifestPath, manifest, posterUrl }\n}\n\n// ── INGESTION D'UN FICHIER QUELCONQUE (blob brut) ──────────────────────────────────────────────────────\n// Pour les fichiers NON ouvrables directement sur le site (wav, py, cube, zip, …) : on découpe le fichier\n// ORIGINAL en parts de 95 Mo (aucune transformation), on les pousse via le ctx shard, et on renvoie un\n// manifeste .file.json (type 'blob-raw'). Le téléchargement recolle les parts dans l'ordre = fichier BIT À BIT\n// identique (offsets cumulés + tailles + empreinte par part). Aucune perte. URLs raw.github pinnées sur commit.\nexport async function ingestBlobRaw(file, { dest, base, vctx, log = noop }) {\n  const total = (await stat(file)).size\n  const nParts = Math.ceil(total / PART) || 1\n  log(`${base} — ${(total / 1048576).toFixed(1)} Mo, ${nParts} part(s) de 95 Mo (fichier brut, aucune transformation)`)\n  const parts = []\n  const fd = await open(file, 'r')\n  const b = Buffer.alloc(PART)\n  try {\n    let off = 0, idx = 0\n    while (off < total) {\n      const { bytesRead } = await fd.read(b, 0, PART, off)\n      if (!bytesRead) break\n      const slice = Buffer.from(b.subarray(0, bytesRead))\n      const h = sha256(slice); const hp = partPathFor(h)\n      const repo = await vctx.writePart(hp, slice)\n      parts.push({ idx, repo, path: hp, hash: h, size: bytesRead })\n      off += bytesRead; idx++\n    }\n  } finally { await fd.close() }\n  if (!total) { // fichier vide : une part vide pour cohérence\n    const h = sha256(Buffer.alloc(0)); const hp = partPathFor(h)\n    const repo = await vctx.writePart(hp, Buffer.alloc(0)); parts.push({ idx: 0, repo, path: hp, hash: h, size: 0 })\n  }\n  await vctx.flush()\n  const shaOf = (repo) => vctx.commitOf[repo] || vctx.headSha()\n  let acc = 0\n  const partsMeta = parts.map((pt) => { const start = acc; acc += pt.size; return { url: rawUrl(pt.repo, shaOf(pt.repo), pt.path), start, end: acc - 1, size: pt.size, sha256: pt.hash } })\n  const manifest = { type: 'blob-raw', v: 1, name: path.basename(file), mime: mimeOf(file), size: total, parts: partsMeta }\n  const manifestPath = `${dest}/${path.basename(file)}.file.json`\n  return { manifestPath, manifest }\n}\n"}}
