t( hx, T_head, -hz) * rot;\\n    p[6] = center + set( hx, T_head,  hz) * rot;\\n    p[7] = center + set(-hx, T_butt,  hz) * rot;\\n    \\n    // Left side shingle (strictly outward normals)\\n    int ipt_l[];\\n    resize(ipt_l, 8);\\n    for (int k = 0; k < 8; ++k) ipt_l[k] = addpoint(0, p[k]);\\n    \\n    int pr0 = addprim(0, \\\"poly\\\", ipt_l[5], ipt_l[6], ipt_l[7], ipt_l[4]); // Top (+Y outward)\\n    int pr1 = addprim(0, \\\"poly\\\", ipt_l[3], ipt_l[2], ipt_l[1], ipt_l[0]); // Bottom (-Y outward)\\n    int pr2 = addprim(0, \\\"poly\\\", ipt_l[4], ipt_l[7], ipt_l[3], ipt_l[0]); // Butt (-X outward)\\n    int pr3 = addprim(0, \\\"poly\\\", ipt_l[2], ipt_l[6], ipt_l[5], ipt_l[1]); // Head (+X outward)\\n    int pr4 = addprim(0, \\\"poly\\\", ipt_l[1], ipt_l[5], ipt_l[4], ipt_l[0]); // -Z outward\\n    int pr5 = addprim(0, \\\"poly\\\", ipt_l[7], ipt_l[6], ipt_l[2], ipt_l[3]); // +Z outward\\n    \\n    int prims_l[] = array(pr0, pr1, pr2, pr3, pr4, pr5);\\n    foreach (int pr; prims_l) {\\n        setprimgroup(0, grp_name, pr, 1);\\n        setprimattrib(0, \\\"piece_id\\\", pr, pid);\\n    }\\n    \\n    // Right side shingle (mirrored across X=0 with strictly outward normals)\\n    int ipt_r[];\\n    resize(ipt_r, 8);\\n    for (int k = 0; k < 8; ++k) {\\n        vector pr_pos = set(-p[k].x, p[k].y, p[k].z);\\n        ipt_r[k] = addpoint(0, pr_pos);\\n    }\\n    \\n    int r0 = addprim(0, \\\"poly\\\", ipt_r[7], ipt_r[6], ipt_r[5], ipt_r[4]); // Top (+Y outward)\\n    int r1 = addprim(0, \\\"poly\\\", ipt_r[0], ipt_r[1], ipt_r[2], ipt_r[3]); // Bottom (-Y outward)\\n    int r2 = addprim(0, \\\"poly\\\", ipt_r[0], ipt_r[3], ipt_r[7], ipt_r[4]); // Butt (+X outward)\\n    int r3 = addprim(0, \\\"poly\\\", ipt_r[1], ipt_r[5], ipt_r[6], ipt_r[2]); // Head (-X outward)\\n    int r4 = addprim(0, \\\"poly\\\", ipt_r[0], ipt_r[4], ipt_r[5], ipt_r[1]); // -Z outward\\n    int r5 = addprim(0, \\\"poly\\\", ipt_r[3], ipt_r[2], ipt_r[6], ipt_r[7]); // +Z outward\\n    \\n    int prims_r[] = array(r0, r1, r2, r3, r4, r5);\\n    foreach (int pr; prims_r) {\\n        setprimgroup(0, grp_name, pr, 1);\\n        setprimattrib(0, \\\"piece_id\\\", pr, pid + 10000);\\n    }\\n}\\nfloat w = ch(\\\"../width\\\");\\nfloat l = ch(\\\"../length\\\");\\nfloat wh = ch(\\\"../wall_height\\\");\\nfloat gh = ch(\\\"../gable_height\\\");\\nfloat peak_y = wh + gh;\\n\\nfloat eave_oh = ch(\\\"../eave_overhang\\\");\\nfloat gable_oh = ch(\\\"../gable_overhang\\\");\\nfloat total_len = l + gable_oh * 2.0;\\n\\nfloat half_w = w * 0.5 + eave_oh;\\nfloat slope_len = sqrt(half_w * half_w + gh * gh);\\nfloat pitch_angle = atan2(gh, half_w);\\nfloat cos_p = cos(pitch_angle);\\nfloat sin_p = sin(pitch_angle);\\n\\nfloat rot_rand   = ch(\\\"../shingle_rot_random\\\");\\nfloat slope_tilt = ch(\\\"../shingle_slope_tilt\\\");\\n\\nint num_rows = chi(\\\"../shingle_rows\\\");\\nif (num_rows < 2) num_rows = 2;\\nint num_cols = chi(\\\"../shingle_cols\\\");\\nif (num_cols < 2) num_cols = 2;\\nfloat overlap = ch(\\\"../shingle_overlap\\\");\\nfloat sh_thick = ch(\\\"../shingle_thickness\\\");\\nfloat head_thick = max(0.003, sh_thick * 0.23);\\n\\nfloat row_step = slope_len / float(num_rows);\\nfloat base_sh_len = row_step + overlap;\\nfloat col_w = total_len / float(num_cols);\\n\\nint pid = 1000;\\n\\nvector dir_up_l = set( cos_p,  sin_p, 0.0);\\nvector norm_l   = set(-sin_p,  cos_p, 0.0);\\nvector eave_l   = set(-half_w, wh, 0.0);\\n\\nmatrix3 rot_l = ident();\\nrotate(rot_l, pitch_angle, set(0, 0, 1));\\n\\nfloat base_tilt = 1.8 + slope_tilt;\\n\\nfloat z_min_allowed = -total_len * 0.5 - 0.025;\\nfloat z_max_allowed =  total_len * 0.5 + 0.025;\\n\\nfloat max_slope_limit = slope_len - 0.05;\\n\\n// Supprimer UNIQUEMENT la derniere ligne des tuiles du haut (r < num_rows - 1)\\nfor (int r = 0; r < num_rows - 1; ++r) {\\n    float dist = float(r) * row_step;\\n    \\n    if (dist >= max_slope_limit - 0.04) continue;\\n    \\n    float z_offset = (r % 2 == 1) ? (col_w * 0.5) : 0.0;\\n    \\n    for (int c = -1; c <= num_cols; ++c) {\\n        float z_center = -total_len * 0.5 + float(c) * col_w + col_w * 0.5 + z_offset;\\n        \\n        float seed = float(r * 157 + (c + 2) * 43 + 9181);\\n        \\n        float raw_len = base_sh_len + (rand(seed + 1.1) - 0.5) * 0.015;\\n        float j_len = min(raw_len, max_slope_limit - dist);\\n        if (j_len < 0.08) continue;\\n        \\n        float j_thick_butt = sh_thick * (0.94 + 0.12 * rand(seed + 2.3));\\n        float j_thick_head = head_thick * (0.94 + 0.12 * rand(seed + 3.7));\\n        float raw_width = col_w * 0.95 + (rand(seed + 4.9) - 0.5) * 0.006;\\n        float j_z = (rand(seed + 5.1) - 0.5) * 0.004;\\n        \\n        float z_min = max(z_min_allowed, z_center - raw_width * 0.5);\\n        float z_max = min(z_max_allowed, z_center + raw_width * 0.5);\\n        if (z_max <= z_min + 0.035) continue;\\n        \\n        float j_width = z_max - z_min;\\n        float final_z = (z_min + z_max) * 0.5 + j_z;\\n        \\n        float j_tilt = (rand(seed + 6.3) - 0.5) * rot_rand * 0.25;\\n        float j_yaw  = (rand(seed + 7.5) - 0.5) * rot_rand * 0.40;\\n        \\n        float sh_tilt = max(0.2, base_tilt + j_tilt);\\n        float eave_adjust = (r == 0) ? -0.040 : 0.0;\\n        \\n        float head_elev = 0.004;\\n        float elev = head_elev + (j_len * 0.5) * sin(radians(sh_tilt));\\n        \\n        vector pos = eave_l + dir_up_l * (dist + j_len * 0.5 + eave_adjust) + norm_l * elev;\\n        pos.z = final_z;\\n        \\n        matrix3 rot_sh = rot_l;\\n        rotate(rot_sh, -radians(sh_tilt), set(0, 0, 1));\\n        rotate(rot_sh, radians(j_yaw), set(0, 1, 0));\\n        \\n        make_symmetric_wedge_shingle(pos, j_len, j_width, j_thick_butt, j_thick_head, rot_sh, \\\"group_shingles\\\", pid++);\\n    }\\n}\\n\",\n   \"/obj/Church/Component_Roof/build_roof_structure\": \"\\nvoid make_symmetric_prism_z(vector pts[]; float z_start, z_end; string grp_name; int pid) {\\n    int p_l[];\\n    resize(p_l, 8);\\n    for (int i = 0; i < 4; ++i) {\\n        p_l[i]   = addpoint(0, set(pts[i].x, pts[i].y, z_start));\\n        p_l[i+4] = addpoint(0, set(pts[i].x, pts[i].y, z_end));\\n    }\\n    \\n    // Left side faces (strictly outward normals)\\n    int pr0 = addprim(0, \\\"poly\\\", p_l[0], p_l[4], p_l[5], p_l[1]); // Top (+Y outward)\\n    int pr1 = addprim(0, \\\"poly\\\", p_l[1], p_l[5], p_l[6], p_l[2]); // Eave cut\\n    int pr2 = addprim(0, \\\"poly\\\", p_l[2], p_l[6], p_l[7], p_l[3]); // Bottom (-Y ceiling outward)\\n    int pr3 = addprim(0, \\\"poly\\\", p_l[3], p_l[7], p_l[4], p_l[0]); // Peak cut\\n    int pr4 = addprim(0, \\\"poly\\\", p_l[0], p_l[1], p_l[2], p_l[3]); // -Z end cap\\n    int pr5 = addprim(0, \\\"poly\\\", p_l[4], p_l[7], p_l[6], p_l[5]); // +Z end cap\\n    \\n    int prims_l[] = array(pr0, pr1, pr2, pr3, pr4, pr5);\\n    foreach (int pr; prims_l) {\\n        setprimgroup(0, grp_name, pr, 1);\\n        setprimattrib(0, \\\"piece_id\\\", pr, pid);\\n    }\\n    \\n    // Right side (mirrored across X=0 with reversed winding)\\n    int p_r[];\\n    resize(p_r, 8);\\n    for (int i = 0; i < 4; ++i) {\\n        p_r[i]   = addpoint(0, set(-pts[i].x, pts[i].y, z_start));\\n        p_r[i+4] = addpoint(0, set(-pts[i].x, pts[i].y, z_end));\\n    }\\n    \\n    int r0 = addprim(0, \\\"poly\\\", p_r[1], p_r[5], p_r[4], p_r[0]); // Top (+Y outward)\\n    int r1 = addprim(0, \\\"poly\\\", p_r[2], p_r[6], p_r[5], p_r[1]); // Eave cut\\n    int r2 = addprim(0, \\\"poly\\\", p_r[3], p_r[7], p_r[6], p_r[2]); // Bottom (-Y ceiling outward)\\n    int r3 = addprim(0, \\\"poly\\\", p_r[0], p_r[4], p_r[7], p_r[3]); // Peak cut\\n    int r4 = addprim(0, \\\"poly\\\", p_r[3], p_r[2], p_r[1], p_r[0]); // -Z end cap\\n    int r5 = addprim(0, \\\"poly\\\", p_r[5], p_r[6], p_r[7], p_r[4]); // +Z end cap\\n    \\n    int prims_r[] = array(r0, r1, r2, r3, r4, r5);\\n    foreach (int pr; prims_r) {\\n        setprimgroup(0, grp_name, pr, 1);\\n        setprimattrib(0, \\\"piece_id\\\", pr, pid + 10000);\\n    }\\n}\\nfloat w = ch(\\\"../width\\\");\\nfloat l = ch(\\\"../length\\\");\\nfloat wh = ch(\\\"../wall_height\\\");\\nfloat gh = ch(\\\"../gable_height\\\");\\nfloat peak_y = wh + gh;\\n\\nfloat eave_oh = ch(\\\"../eave_overhang\\\");\\nfloat gable_oh = ch(\\\"../gable_overhang\\\");\\nfloat deck_th = ch(\\\"../decking_thickness\\\");\\n\\nfloat total_len = l + gable_oh * 2.0;\\nfloat half_w = w * 0.5 + eave_oh;\\nfloat slope_len = sqrt(half_w * half_w + gh * gh);\\nfloat pitch_angle = atan2(gh, half_w);\\nfloat cos_p = cos(pitch_angle);\\nfloat sin_p = sin(pitch_angle);\\n\\nvector N = set(-sin_p, cos_p, 0.0);\\nvector T = set( cos_p, sin_p, 0.0);\\n\\nint pid = 100;\\n\\n// 1. Decking Slopes\\n{\\n    vector d_pts[];\\n    resize(d_pts, 4);\\n    d_pts[0] = set(0.0, peak_y, 0.0);\\n    d_pts[1] = set(-half_w, wh, 0.0);\\n    d_pts[2] = d_pts[1] - N * deck_th;\\n    d_pts[3] = set(0.0, peak_y - deck_th / cos_p, 0.0);\\n    \\n    make_symmetric_prism_z(d_pts, -total_len * 0.5, total_len * 0.5, \\\"group_decking\\\", pid++);\\n}\\n\\n// 2. Planche de facade d egout (Fascia Board)\\nfloat fascia_h = ch(\\\"../fascia_depth\\\");\\nfloat fascia_th = ch(\\\"../fascia_thickness\\\");\\n{\\n    vector f_pts[];\\n    resize(f_pts, 4);\\n    f_pts[0] = set(-half_w, wh, 0.0) - N * deck_th;\\n    f_pts[1] = f_pts[0] - N * fascia_h;\\n    f_pts[2] = f_pts[1] + T * fascia_th;\\n    f_pts[3] = f_pts[0] + T * fascia_th;\\n    \\n    make_symmetric_prism_z(f_pts, -total_len * 0.5, total_len * 0.5, \\\"group_fascia\\\", pid++);\\n}\\n\\n// 3. Planches de rive (Bargeboards)\\nfloat barge_w = 0.18;\\nfloat barge_th = 0.038;\\nfloat z_gables[] = array(l * 0.5 + gable_oh - barge_th * 0.5, -l * 0.5 - gable_oh + barge_th * 0.5);\\n\\nforeach (float z_pos; z_gables) {\\n    vector b_pts[];\\n    resize(b_pts, 4);\\n    b_pts[0] = set(0.0, peak_y + 0.005, 0.0);\\n    b_pts[1] = set(-half_w, wh, 0.0);\\n    b_pts[2] = set(-half_w, wh, 0.0) - N * barge_w;\\n    b_pts[3] = set(0.0, peak_y + 0.005 - barge_w / cos_p, 0.0);\\n    \\n    make_symmetric_prism_z(b_pts, z_pos - barge_th * 0.5, z_pos + barge_th * 0.5, \\\"group_bargeboard\\\", pid++);\\n}\\n\\n// 4. Chevrons interieurs (Rafters)\\nfloat rafter_w = 0.065;\\nfloat rafter_d = 0.075;\\nfloat beam_z_positions[] = array(l * 0.5, -l * 0.5);\\n\\nforeach (float z_beam; beam_z_positions) {\\n    vector r_pts[];\\n    resize(r_pts, 4);\\n    r_pts[0] = set(0.0, peak_y - deck_th / cos_p, 0.0);\\n    r_pts[1] = set(-half_w, wh, 0.0) - N * deck_th;\\n    r_pts[2] = set(-half_w, wh, 0.0) - N * (deck_th + rafter_d);\\n    r_pts[3] = set(0.0, peak_y - (deck_th + rafter_d) / cos_p, 0.0);\\n    \\n    make_symmetric_prism_z(r_pts, z_beam - rafter_w * 0.5, z_beam + rafter_w * 0.5, \\\"group_rafters\\\", pid++);\\n}\\n\"\n  }\n }\n}\n","exit_code":0,"duration":{"secs":0,"nanos":8084},"formatted_output":"{\n \"ok\": true,\n \"result\": {\n  \"parms\": {\n   \"stdswitcher1\": 0,\n   \"xOrd\": 0,\n   \"rOrd\": 0,\n   \"tx\": 0.0,\n   \"ty\": 0.0,\n   \"tz\": 0.0,\n   \"rx\": 0.0,\n   \"ry\": 0.0,\n   \"rz\": 0.0,\n   \"sx\": 1.0,\n   \"sy\": 1.0,\n   \"sz\": 1.0,\n   \"px\": 0.0,\n   \"py\": 0.0,\n   \"pz\": 0.0,\n   \"prx\": 0.0,\n   \"pry\": 0.0,\n   \"prz\": 0.0,\n   \"scale\": 1.0,\n   \"pre_xform\": \"clean\",\n   \"keeppos\": 0,\n   \"childcomp\": 0,\n   \"constraints_on\": 0,\n   \"constraints_path\": \"\",\n   \"lookatpath\": \"\",\n   \"lookupobjpath\": \"\",\n   \"lookup\": \"on\",\n   \"pathobjpath\": \"\",\n   \"roll\": 0.0,\n   \"pos\": 0.0,\n   \"uparmtype\": 1,\n   \"pathorient\": 1,\n   \"upx\": 0.0,\n   \"upy\": 1.0,\n   \"upz\": 0.0,\n   \"bank\": 0.0,\n   \"shop_materialpath\": \"\",\n   \"shop_materialopts\": \"override\",\n   \"tdisplay\": 1,\n   \"display\": 1,\n   \"use_dcolor\": 0,\n   \"dcolorr\": 1.0,\n   \"dcolorg\": 1.0,\n   \"dcolorb\": 1.0,\n   \"picking\": 1,\n   \"pickscript\": \"\",\n   \"cachin