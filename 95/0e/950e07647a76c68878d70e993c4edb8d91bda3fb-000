"\n    ]\n   },\n   {\n    \"name\": \"mat_tag_vestibule\",\n    \"inputs\": [\n     \"/obj/Church/Component_PorchVestibule\"\n    ]\n   },\n   {\n    \"name\": \"promote_mat_cd\",\n    \"inputs\": [\n     \"/obj/Church/merge_all\"\n    ]\n   },\n   {\n    \"name\": \"assign_material_path\",\n    \"inputs\": [\n     \"/obj/Church/promote_mat_cd\"\n    ]\n   },\n   {\n    \"name\": \"compute_plank_bounds\",\n    \"inputs\": [\n     \"/obj/Church/mat_tag_facade\"\n    ]\n   },\n   {\n    \"name\": \"apply_per_plank_uv\",\n    \"inputs\": [\n     \"/obj/Church/compute_plank_bounds\"\n    ]\n   },\n   {\n    \"name\": \"materials_for_unreal\",\n    \"inputs\": []\n   },\n   {\n    \"name\": \"cutter_points_A\",\n    \"inputs\": []\n   },\n   {\n    \"name\": \"cutter_box_A\",\n    \"inputs\": []\n   },\n   {\n    \"name\": \"cutter_copy_A\",\n    \"inputs\": [\n     \"/obj/Church/cutter_box_A\",\n     \"/obj/Church/cutter_points_A\"\n    ]\n   },\n   {\n    \"name\": \"cutter_points_B\",\n    \"inputs\": []\n   },\n   {\n    \"name\": \"cutter_box_B\",\n    \"inputs\": []\n   },\n   {\n    \"name\": \"cutter_copy_B\",\n    \"inputs\": [\n     \"/obj/Church/cutter_box_B\",\n     \"/obj/Church/cutter_points_B\"\n    ]\n   },\n   {\n    \"name\": \"cutters_merge\",\n    \"inputs\": [\n     \"/obj/Church/cutter_copy_A\",\n     \"/obj/Church/cutter_copy_B\"\n    ]\n   },\n   {\n    \"name\": \"boolean_window_cut\",\n    \"inputs\": [\n     \"/obj/Church/boolean_door_cut\",\n     \"/obj/Church/cutters_merge\"\n    ]\n   },\n   {\n    \"name\": \"window_cut_convex\",\n    \"inputs\": [\n     \"/obj/Church/boolean_window_cut\"\n    ]\n   },\n   {\n    \"name\": \"uv_whitepaint_facade\",\n    \"inputs\": [\n     \"/obj/Church/apply_per_plank_uv\"\n    ]\n   },\n   {\n    \"name\": \"uv_whitepaint_porch\",\n    \"inputs\": [\n     \"/obj/Church/mat_tag_vestibule\"\n    ]\n   },\n   {\n    \"name\": \"uv_roof_church\",\n    \"inputs\": [\n     \"/obj/Church/mat_tag_roof\"\n    ]\n   },\n   {\n    \"name\": \"uv_roof_porch\",\n    \"inputs\": [\n     \"/obj/Church/uv_whitepaint_porch\"\n    ]\n   }\n  ],\n  \"code\": {\n   \"/obj/Church/Component_WoodFacade/build_siding\": \"\\n// 8 October 2026 : siding with EXACT openings. EN: every clapboard row is cut analytically around the windows and the door (left, right, below the sill, above the lintel), so no boolean is needed and every piece stays a clean quad. The row count is multiplied by plank_multiplier (x1 = the old 28 rows, x2, x3). FR : ouvertures exactes, plus de boolean, nombre de planches multiplie.\\nint addq(vector a; vector b; vector c; vector d; int rid; string grp) {\\n    int p0 = addpoint(0, a); int p1 = addpoint(0, b); int p2 = addpoint(0, c); int p3 = addpoint(0, d);\\n    int pr = addprim(0, \\\"poly\\\", p0, p1, p2, p3);\\n    setprimattrib(0, \\\"piece_id\\\", pr, pr);\\n    setprimattrib(0, \\\"plank_row\\\", pr, rid);\\n    setprimgroup(0, grp, pr, 1);\\n    return pr;\\n}\\nvoid sq(int flip; float xb; float xt; float yb; float yt; float ya; float yc; float z0; float z1; int rid; string grp) {\\n    if (z1 - z0 < 0.0001 || yc - ya < 0.0001) return;\\n    float ta = (ya - yb) / max(yt - yb, 0.000001); float tc = (yc - yb) / max(yt - yb, 0.000001);\\n    float xa = lerp(xb, xt, ta); float xc = lerp(xb, xt, tc);\\n    if (flip == 0) addq(set(xa, ya, z0), set(xc, yc, z0), set(xc, yc, z1), set(xa, ya, z1), rid, grp);\\n    else addq(set(xa, ya, z1), set(xc, yc, z1), set(xc, yc, z0), set(xa, ya, z0), rid, grp);\\n}\\nvoid side_row(int flip; float xb; float xt; float yb; float yt; float l; float wz[]; float hw; float oy0; float oy1; int rid; string grp) {\\n    float cur = -l * 0.5;\\n    if (yb < oy1 && yt > oy0) {\\n        for (int i = 0; i < len(wz); ++i) {\\n            float z0 = wz[i] - hw; float z1 = wz[i] + hw;\\n            sq(flip, xb, xt, yb, yt, yb, yt, cur, z0, rid, grp);                          // column left of the window, full row\\n            if (yb < oy0) sq(flip, xb, xt, yb, yt, yb, min(yt, oy0), z0, z1, rid, grp);   // under the sill\\n            if (yt > oy1) sq(flip, xb, xt, yb, yt, max(yb, oy1), yt, z0, z1, rid, grp);   // over the lintel\\n            cur = z1;\\n        }\\n    }\\n    sq(flip, xb, xt, yb, yt, yb, yt, cur, l * 0.5, rid, grp);\\n}\\nvoid gq(int flip; float zb; float zt; float yb; float yt; float hb; float ht; float ya; float yc; float x0; float x1; int rid; string grp) {\\n    if (yc - ya < 0.0001) return;\\n    float ta = (ya - yb) / max(yt - yb, 0.000001); float tc = (yc - yb) / max(yt - yb, 0.000001);\\n    float ha = lerp(hb, ht, ta); float hc = lerp(hb, ht, tc);\\n    float xla = max(x0, -ha); float xra = min(x1, ha); float xlc = max(x0, -hc); float xrc = min(x1, hc);\\n    if (xra - xla < 0.0001 && xrc - xlc < 0.0001) return;\\n    float za = lerp(zb, zt, ta); float zc = lerp(zb, zt, tc);\\n    if (flip == 0) addq(set(xla, ya, za), set(xlc, yc, zc), set(xrc, yc, zc), set(xra, ya, za), rid, grp);\\n    else addq(set(xra, ya, za), set(xrc, yc, zc), set(xlc, yc, zc), set(xla, ya, za), rid, grp);\\n}\\nvoid gable_row(int flip; float zb; float zt; float yb; float yt; float hb; float ht; float ox0[]; float ox1[]; float oy0[]; float oy1[]; int rid; string grp) {\\n    float cur = -1000000.0;\\n    for (int i = 0; i < len(ox0); ++i) {\\n        if (yb < oy1[i] && yt > oy0[i]) {\\n            gq(flip, zb, zt, yb, yt, hb, ht, yb, yt, cur, ox0[i], rid, grp);\\n            if (yb < oy0[i]) gq(flip, zb, zt, yb, yt, hb, ht, yb, min(yt, oy0[i]), ox0[i], ox1[i], rid, grp);\\n            if (yt > oy1[i]) gq(flip, zb, zt, yb, yt, hb, ht, max(yb, oy1[i]), yt, ox0[i], ox1[i], rid, grp);\\n            cur = ox1[i];\\n        }\\n    }\\n    gq(flip, zb, zt, yb, yt, hb, ht, yb, yt, cur, 1000000.0, rid, grp);\\n}\\n\\nfloat w = ch(\\\"../../width\\\");\\nfloat l = ch(\\\"../../length\\\");\\nfloat wh = ch(\\\"../../wall_height\\\");\\nfloat fgh = ch(\\\"../../front_gable_height\\\");\\nfloat rgh = ch(\\\"../../rear_gable_height\\\");\\nint mult = chi(\\\"../../plank_multiplier\\\") + 1;     // menu index 0,1,2 = x1 (old 28 rows), x2 (default), x3 (finest)\\nint count = 28 * mult;\\nfloat th = 0.025;\\nfloat overlap = 0.02 / float(mult);\\nfloat max_gh = max(fgh, rgh);\\nfloat total_h = wh + max_gh;\\nfloat step_h = total_h / float(count);\\nfloat plank_h = step_h + overlap;\\n\\nfloat winA_w = ch(\\\"../../winA_width\\\");\\nfloat winA_h = ch(\\\"../../winA_height\\\");\\nfloat winA_sill = ch(\\\"../../winA_sill_y\\\");\\nfloat winA_sp = 1.60;\\nif (ch(\\\"../../winA_spacing\\\") > 0.0) winA_sp = ch(\\\"../../winA_spacing\\\");\\nint nwin = chi(\\\"../../Component_WindowA/num_side_windows\\\");\\nfloat winA_z[];\\nif (nwin == 4) winA_z = array(-1.5 * winA_sp, -0.5 * winA_sp, 0.5 * winA_sp, 1.5 * winA_sp);\\nelse if (nwin == 2) winA_z = array(-winA_sp, winA_sp);\\nelse if (nwin == 1) winA_z = array(0.0);\\nelse winA_z = array(-winA_sp, 0.0, winA_sp);\\nfloat hwA = winA_w * 0.5 - 0.02;\\nfloat winB_w = ch(\\\"../../winB_width\\\");\\nfloat winB_h = ch(\\\"../../winB_height\\\");\\nfloat winB_sill = ch(\\\"../../winB_sill_y\\\");\\nfloat hwB = winB_w * 0.5 - 0.025;\\n\\n// 1. LEFT WALL (X = -w/2) and 2. RIGHT WALL (X = +w/2)\\nfor (int k = 0; k < count; ++k) {\\n    float y_bot = float(k) * step_h;\\n    float y_top = min(y_bot + plank_h, wh);\\n    if (y_bot >= wh) break;\\n    side_row(0, -w * 0.5 - th, -w * 0.5, y_bot, y_top, l, winA_z, hwA, winA_sill, winA_sill + winA_h, k, \\\"left_wall\\\");\\n    side_row(1,  w * 0.5 + th,  w * 0.5, y_bot, y_top, l, winA_z, hwA, winA_sill, winA_sill + winA_h, 100000 + k, \\\"right_wall\\\");\\n}\\n\\n// 3. FRONT GABLE (Z = +l/2) : door and window B\\nfloat door_cx = -0.38; float door_hw = 0.34; float door_bot = 0.60; float door_top = 1.85;\\nfloat f_ox0[] = array(door_cx - door_hw, -hwB);\\nfloat f_ox1[] = array(door_cx + door_hw,  hwB);\\nfloat f_oy0[] = array(door_bot, winB_sill);\\nfloat f_oy1[] = array(door_top, winB_sill + winB_h);\\nfloat r_ox0[] = array(-hwB); float r_ox1[] = array(hwB); float r_oy0[] = array(winB_sill); float r_oy1[] = array(winB_sill + winB_h);\\nfloat peak_f = wh + fgh;\\nfor (int k = 0; k < count; ++k) {\\n    float y_bot = float(k) * step_h; float y_top = y_bot + plank_h;\\n    if (y_bot >= peak_f) break;\\n    float hb = w * 0.5; float ht = w * 0.5;\\n    if (y_bot > wh) hb = w * 0.5 * clamp(1.0 - (y_bot - wh) / fgh, 0.0, 1.0);\\n    if (y_top > wh) ht = w * 0.5 * clamp(1.0 - (y_top - wh) / fgh, 0.0, 1.0);\\n    gable_row(0, l * 0.5 + th, l * 0.5, y_bot, y_top, hb, ht, f_ox0, f_ox1, f_oy0, f_oy1, 200000 + k, \\\"front_wall\\\");\\n}\\n\\n// 4. REAR GABLE (Z = -l/2) : window B\\nfloat peak_r = wh + rgh;\\nfor (int k = 0; k < count; ++k) {\\n    float y_bot = float(k) * step_h; float y_top = y_bot + plank_h;\\n    if (y_bot >= peak_r) break;\\n    float hb = w * 0.5; float ht = w * 0.5;\\n    if (y_bot > wh) hb = w * 0.5 * clamp(1.0 - (y_bot - wh) / rgh, 0.0, 1.0);\\n    if (y_top > wh) ht = w * 0.5 * clamp(1.0 - (y_top - wh) / rgh, 0.0, 1.0);\\n    gable_row(1, -l * 0.5 - th, -l * 0.5, y_bot, y_top, hb, ht, r_ox0, r_ox1, r_oy0, r_oy1, 300000 + k, \\\"rear_wall\\\");\\n}\\n\",\n   \"/obj/Church/Component_Roof/build_shingles\": \"\\nvoid make_symmetric_wedge_shingle(vector center; float L, W, T_butt, T_head; matrix3 rot; string grp_name; int pid) {\\n    float hx = L * 0.5;\\n    float hz = W * 0.5;\\n    \\n    vector p[];\\n    resize(p, 8);\\n    p[0] = center + set(-hx, 0.0,    -hz) * rot;\\n    p[1] = center + set( hx, 0.0,    -hz) * rot;\\n    p[2] = center + set( hx, 0.0,     hz) * rot;\\n    p[3] = center + set(-hx, 0.0,     hz) * rot;\\n    p[4] = center + set(-hx, T_butt, -hz) * rot;\\n    p[5] = center + set( hx, T_head, -hz) * rot;\\n    p[6] = center + set( hx, T_head,  hz) * rot;\\n    p[7] = center + set(-hx, T_butt,  hz) * rot;\\n    \\n    // Left side shingle (strictly outward normals)\\n    int ipt_l[];\\n    resize(ipt_l, 8);\\n    for (int k = 0; k < 8; ++k) ipt_l[k] = addpoint(0, p[k]);\\n    \\n    int pr0 = addprim(0, \\\"poly\\\", ipt_l[5], ipt_l[6], ipt_l[7], ipt_l[4]); // Top (+Y outward)\\n    int pr1 = addprim(0, \\\"poly\\\", ipt_l[3], ipt_l[2], ipt_l[1], ipt_l[0]); // Bottom (-Y outward)\\n    int pr2 = addprim(0, \\\"poly\\\", ipt_l[4], ipt_l[7], ipt_l[3], ipt_l[0]); // Butt (-X outward)\\n    int pr3 = addprim(0, \\\"poly\\\", ipt_l[2], ipt_l[6], ipt_l[5], ipt_l[1]); // Head (+X outward)\\n    int pr4 = addprim(0, \\\"poly\\\", ipt_l[1], ipt_l[5], ipt_l[4], ipt_l[0]); // -Z outward\\n    int pr5 = addprim(0, \\\"poly\\\", ipt_l[7], ipt_l[6], ipt_l[2], ipt_l[3]); // +Z outward\\n    \\n    int prims_l[] = array(pr0, pr1, pr2, pr3, pr4, pr5);\\n    foreach (int pr; prims_l) {\\n        setprimgroup(0, grp_name, pr, 1);\\n        setprimattrib(0, \\\"piece_id\\\", pr, pid);\\n    }\\n    \\n    // Right side shingle (mirrored across X=0 with strictly outward normals)\\n    int ipt_r[];\\n    resize(ipt_r, 8);\\n    for (int k = 0; k < 8; ++k) {\\n        vector pr_pos = set(-p[k].x, p[k].y, p[k].z);\\n        ipt_r[k] = addpoint(0, pr_pos);\\n    }\\n    \\n    int r0 = addprim(0, \\\"poly\\\", ipt_r[7], ipt_r[6], ipt_r[5], ipt_r[4]); // Top (+Y outward)\\n    int r1 = addprim(0, \\\"poly\\\", ipt_r[0], ipt_r[1], ipt_r[2], ipt_r[3]); // Bottom (-Y outward)\\n    int r2 = addprim(0, \\\"poly\\\", ipt_r[0], ipt_r[3], ipt_r[7], ipt_r[4]); // Butt (+X outward)\\n    int r3 = addprim(0, \\\"poly\\\", ipt_r[1], ipt_r[5], ipt_r[6], ipt_r[2]); // Head (-X outward)\\n    int r4 = addprim(0, \\\"poly\\\", ipt_r[0], ipt_r[4], ipt_r[5], ipt_r[1]); // -Z outward\\n    int r5 = addprim(0, \\\"poly\\\", ipt_r[3], ipt_r[2], ipt_r[6], ipt_r[7]); // +Z outward\\n    \\n    int prims_r[] = array(r0, r1, r2, r3, r4, r5);\\n    foreach (int pr; prims_r) {\\n        setprimgroup(0, grp_name, pr, 1);\\n        setprimattrib(0, \\\"piece_id\\\", pr, pid + 10000);\\n    }\\n}\\nfloat w = ch(\\\"../width\\\");\\nfloat l = ch(\\\"../length\\\");\\nfloat wh = ch(\\\"../wall_height\\\");\\nfloat gh = ch(\\\"../gable_height\\\");\\nfloat peak_y = wh + gh;\\n\\nfloat eave_oh = ch(\\\"../eave_overhang\\\");\\nfloat gable_oh = ch(\\\"../gable_overhang\\\");\\nfloat total_len = l + gable_oh * 2.0;\\n\\nfloat half_w = w * 0.5 + eave_oh;\\nfloat slope_len = sqrt(half_w * half_w + gh * gh);\\nfloat pitch_angle = atan2(gh, half_w);\\nfloat cos_p = cos(pitch_angle);\\nfloat sin_p = sin(pitch_angle);\\n\\nfloat rot_rand   = ch(\\\"../shingle_rot_random\\\");\\nfloat slope_tilt = ch(\\\"../shingle_slope_tilt\\\");\\n\\nint num_rows = chi(\\\"../shingle_rows\\\");\\nif (num_rows < 2) num_rows = 2;\\nint num_cols = chi(\\\"../shingle_cols\\\");\\nif (num_cols < 2) num_cols = 2;\\nfloat overlap = ch(\\\"../shingle_overlap\\\");\\nfloat sh_thick = ch(\\\"../shingle_thickness\\\");\\nfloat head_thick = max(0.003, sh_thick * 0.23);\\n\\nfloat row_step = slope_len / float(num_rows);\\nfloat base_sh_len = row_step + overlap;\\nfloat col_w = total_len / float(num_cols);\\n\\nint pid = 1000;\\n\\nvector dir_up_l = set( cos_p,  sin_p, 0.0);\\nvector norm_l   = set(-sin_p,  cos_p, 0.0);\\nvector eave_l   = set(-half_w, wh, 0.0);\\n\\nmatrix3 rot_l = ident();\\nrotate(rot_l, pitch_angle, set(0, 0, 1));\\n\\nfloat base_tilt = 1.8 + slope_tilt;\\n\\nfloat z_min_allowed = -total_len * 0.5 - 0.025;\\nfloat z_max_allowed =  total_len * 0.5 + 0.025;\\n\\nfloat max_slope_limit = slope_len - 0.05;\\n\\n// Supprimer UNIQUEMENT la derniere ligne des tuiles du haut (r < num_rows - 1)\\nfor (int r = 0; r < num_rows - 1; ++r) {\\n    float dist = float(r) * row_step;\\n    \\n    if (dist >= max_slope_limit - 0.04) continue;\\n    \\n    float z_offset = (r % 2 == 1) ? (col_w * 0.5) : 0.0;\\n    \\n    for (int c = -1; c <= num_cols; ++c) {\\n        float z_center = -total_len * 0.5 + float(c) * col_w + col_w * 0.5 + z_offset;\\n        \\n        float seed = float(r * 157 + (c + 2) * 43 + 9181);\\n        \\n        float raw_len = base_sh_len + (rand(seed + 1.1) - 0.5) * 0.015;\\n        float j_len = min(raw_len, max_slope_limit - dist);\\n        if (j_len < 0.08) continue;\\n        \\n        float j_thick_butt = sh_thick * (0.94 + 0.12 * rand(seed + 2.3));\\n        float j_thick_head = head_thick * (0.94 + 0.12 * rand(seed + 3.7));\\n        float raw_width = col_w * 0.95 + (rand(seed + 4.9) - 0.5) * 0.006;\\n        float j_z = (rand(seed + 5.1) - 0.5) * 0.004;\\n        \\n        float z_min = max(z_min_allowed, z_center - raw_width * 0.5);\\n        float z_max = min(z_max_allowed, z_center + raw_width * 0.5);\\n        if (z_max <= z_min + 0.035) continue;\\n        \\n        float j_width = z_max - z_min;\\n        float final_z = (z_min + z_max) * 0.5 + j_z;\\n        \\n        float j_tilt = (rand(seed + 6.3) - 0.5) * rot_rand * 0.25;\\n        float j_yaw  = (rand(seed + 7.5) - 0.5) * rot_rand * 0.40;\\n        \\n        float sh_tilt = max(0.2, base_tilt + j_tilt);\\n        float eave_adjust = (r == 0) ? -0.040 : 0.0;\\n        \\n        float head_elev = 0.004;\\n        float elev = head_elev + (j_len * 0.5) * sin(radians(sh_tilt));\\n        \\n        vector pos = eave_l + dir_up_l * (dist + j_len * 0.5 + eave_adjust) + norm_l * elev;\\n        pos.z = final_z;\\n        \\n        matrix3 rot_sh = rot_l;\\n        rotate(rot_sh, -radians(sh_tilt), set(0, 0, 1));\\n        rotate(rot_sh, radians(j_yaw), set(0, 1, 0));\\n        \\n        make_symmetric_wedge_shingle(pos, j_len, j_width, j_thick_butt, j_thick_head, rot_sh, \\\"group_shingles\\\", pid++);\\n    }\\n}\\n\",\n   \"/obj/Church/Component_Roof/build_roof_structure\": \"\\nvoid make_symmetric_prism_z(vector pts[]; float z_start, z_end; string grp_name; int pid) {\\n    int p_l[];\\n    resize(p_l, 8);\\n    for (int i = 0; i < 4; ++i) {\\n        p_l[i]   = addpoint(0, set(pts[i].x, pts[i].y, z_start));\\n        p_l[i+4] = addpoint(0, set(pts[i].x, pts[i].y, z_end));\\n    }\\n    \\n    // Left side