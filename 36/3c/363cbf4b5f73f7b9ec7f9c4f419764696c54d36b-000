es fichiers statiques : elle ne déclenche jamais\n// une Function. `/folder` retombait donc sur la règle suivante, `/* /index.html`, et l'on recevait\n// l'`index.html` brut — sans la moindre balise Open Graph, pas même les valeurs par défaut. D'où\n// « ZenRayProgress — Matthieu Huguet » et l'icône Z partout.\n//\n// MESURÉ AVANT DE CORRIGER, pour ne pas réparer la mauvaise pièce : appelée en direct,\n// `/api/share-og?shareType=folder&d=…` rend le bon titre, la bonne description et une vignette de\n// 567 ko servie en `image/webp`. Le handler n'avait rien ; seul le chemin pour l'atteindre manquait.\n//\n// Sur Cloudflare, une route hors `/api/` s'obtient par un FICHIER de fonction portant son nom.\n// `functions/folder.js` répond donc à `/folder`, et délègue au routeur habituel en lui passant le\n// type de partage. Les trois fichiers ne portent que ce type ; toute la mécanique vit ici.\nimport { setPlatform, cloudflarePlatform } from '../server/_platform.js'\nimport { adapterHandlerNode } from '../server/_cloudflare-adapter.js'\nimport routeur from '../api/[...route].js'\n\nexport function partage(shareType) {\n  return function onRequest(context) {\n    setPlatform(cloudflarePlatform(context.env))\n    // Le type voyage en paramètre de requête, exactement comme le faisait la réécriture Vercel :\n    // `share-og` le lit dans `req.query.shareType`, et la query d'origine (`?d=…`) est conservée.\n    const url = new URL(context.request.url)\n    url.searchParams.set('shareType', shareType)\n    const requete = new Request(url.toString(), context.request)\n    // `route: ['share-og']` est ce que le routeur attend comme premier segment : c'est ainsi qu'il\n    // choisit le handler, sans que l'URL visible par le visiteur change d'un caractère.\n    return adapterHandlerNode(routeur, requete, context.waitUntil?.bind(context), { route: ['share-og'] })\n  }\n}\n"},{"type":"input_text","text":"/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/docs/H