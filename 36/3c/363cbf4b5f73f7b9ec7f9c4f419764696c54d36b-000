ay(donnee)\n      : encodeur.encode(String(donnee))\n    return ecrivain.write(octets)\n  }\n\n  const res = {\n    get statusCode() { return statut },\n    set statusCode(c) { statut = c },\n    get headersSent() { return reponseRendue },\n    status(c) { statut = c; return res },\n    setHeader(nom, valeur) {\n      // Un même nom peut porter plusieurs valeurs (Set-Cookie) : on ajoute au lieu d'écraser.\n      if (Array.isArray(valeur)) { entetes.delete(nom); for (const v of valeur) entetes.append(nom, String(v)) }\n      else entetes.set(nom, String(valeur))\n      return res\n    },\n    getHeader(nom) { return entetes.get(nom) },\n    removeHeader(nom) { entetes.delete(nom); return res },\n    write(donnee) { demarrer(); ecrire(donnee); return true },\n    json(objet) {\n      if (!entetes.has('content-type')) entetes.set('content-type', 'application/json; charset=utf-8')\n      demarrer(); ecrire(JSON.stringify(objet)); ecrivain.close(); return res\n    },\n    send(donnee) { demarrer(); ecrire(donnee); ecrivain.close(); return res },\n    end(donnee) { demarrer(); if (donnee !== undefined) ecrire(donnee); ecrivain.close(); return res },\n  }\n\n  // Le handler travaille pendant que la réponse est déjà partie : c'est tout l'intérêt du flux.\n  // On n'attend donc PAS sa fin avant de rendre, mais on ferme le flux s'il jette, sans quoi le\n  // client resterait suspendu sur une réponse qui ne se termine jamais.\n  const travail = Promise.resolve()\n    .then(() => handler(req, res))\n    .catch((e) => {\n      if (!reponseRendue) { statut = 500; entetes.set('content-type', 'application/json; charset=utf-8'); demarrer(); ecrire(JSON.stringify({ error: String((e && e.message) || e) })) }\n      try { ecrivain.close() } catch { /* déjà fermé par le handler */ }\n    })\n\n  // `waitUntil` garde le Worker en vie tant que le handler écrit, même après que la réponse est\n  // partie. Sans lui, un flux long serait coupé net dès le retour de cette fonction.\n  if (waitUntil) waitUntil(travail)\n\n  return reponse\n}\n\n--- routes ---\n{\n  \"version\": 1,\n  \"include\": [\n    \"/api/*\",\n    \"/watch\",\n    \"/view\",\n    \"/folder\"\n  ],\n  \"exclude\": []\n}\n\n--- redirects ---\n# Transposition de la section `rewrites` de vercel.json (2026-07-30).\n# Le code 200 signifie REECRITURE et non redirection : l'URL vue par le visiteur ne change pas.\n\n# /watch, /view et /folder ne sont PLUS ici : une reecriture `_redirects` de Cloudflare Pages ne\n# sert que des fichiers statiques et ne declenche jamais une Function, si bien que ces trois lignes\n# ne faisaient rien -- et c'est pire qu'une absence, elles donnaient a lire une regle qui semblait\n# couvrir le cas. Elles vivent maintenant dans functions/{watch,view,folder}.js.\n\n# Repli d'application a page unique, EN DERNIER : toute route inconnue rend index.html, qui laisse\n# le routeur du navigateur decider. Les chemins /api/* n'arrivent jamais ici, `_routes.json` les\n# ayant deja envoyes a la fonction.\n/*  /index.html  200\n\n--- headers ---\n# Transposition de la section `headers` de vercel.json (2026-07-30).\n# Cloudflare Pages lit ce fichier ; Vercel lit vercel.json. Les deux doivent rester EGAUX, et\n# `hebergement.test.js` echoue s'ils divergent : deux politiques de securite qui s'ecartent en\n# silence, c'est une faille qui n'apparait que sur l'hebergeur qu'on ne regarde pas ce jour-la.\n\n/*\n  X-Content-Type-Options: nosniff\n  Referrer-Policy: strict-origin-when-cross-origin\n  Strict-Transport-Security: max-age=31536000; includeSubDomains\n  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()\n  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://cdn.jsdelivr.net https://sdk.scdn.co https://www.youtube.com https://s.ytimg.com; worker-src 'self' blob: https://cdn.jsdelivr.net; frame-src 'self' https://open.spotify.com https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com; connect-src 'self' blob: data: https://api.spotify.com https://accounts.spotify.com https://api.github.com https://raw.githubusercontent.com https://cdn.jsdelivr.net https://www.youtube.com https://*.googleapis.com https://*.google.com; img-src 'self' blob: data: https:; media-src 'self' blob: data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;\n\n# index.html JAMAIS en cache : c'est lui qui porte les URL hashees des assets. Servi depuis un\n# cache, il reference des fichiers qui n'existent plus et l'application s'ouvre sur une page\n# blanche. Incident du 2026-06-01, voir la memoire `no_blank_screen_after_rebuild`.\n/\n  Cache-Control: no-cache, no-store, must-revalidate\n\n/index.html\n  Cache-Control: no-cache, no-store, must-revalidate\n\n# Les assets portent un hash dans leur nom : ils sont immuables, donc cachables un an.\n/assets/*\n  Cache-Control: public, max-age=31536000, immutable\n\n/zr-stream-sw.js\n  Cache-Control: no-cache, no-store, must-revalidate\n\n--- wrangler ---\n# Configuration Cloudflare Pages. Le pendant de vercel.json, préparé le 2026-07-30 et NON DÉPLOYÉ :\n# il attend le jour où l'on bascule, et ce jour-là il ne restera qu'à reporter les variables.\n\nname = \"zenray-progress\"\npages_build_output_dir = \"dist\"\n\n# LA DATE COMPTE AUTANT QUE LE DRAPEAU.\n#\n# `nodejs_compat` donne node:fs, node:crypto, node:path et node:url — ce qui permet aux\n# quarante-quatre handlers de `server/` de tourner sans être réécrits.\n#\n# Et surtout, `nodejs_compat_populate_process_env` peuple `process.env` avec les variables et les\n# secrets du Worker. Il est actif PAR DÉFAUT à partir d'une date de compatibilité au 2025-04-01,\n# et c'est lui qui rend inutile le portage des 112 lectures de `process.env` dans le code. Une date\n# antérieure les casserait toutes en silence : elles rendraient une chaîne vide, et l'application\n# se comporterait comme si aucun jeton n'était configuré.\ncompatibility_date = \"2025-06-01\"\ncompatibility_flags = [\"nodejs_compat\"]\n\n# Les 38 variables se posent en secrets dans l'interface, ou par `wrangler pages secret put`.\n# Elles ne sont volontairement PAS listées ici : ce fichier est commité, elles ne doivent pas\n# l'être. La liste vit dans docs/HEBERGEMENT-audit-cloudflare.md, sans les valeurs.\n\n.github/workflows/deploiement.yml\n--- .github/workflows/deploiement.yml\n# DÉPLOIEMENT À DEUX CIBLES — préparé le 2026-07-30, VOLONTAIREMENT DÉSACTIVÉ.\n#\n# Pourquoi ce fichier existe\n# --------------------------\n# Le 26 juillet, Vercel a bloqué tout déploiement sur une limite d'usage discrétionnaire. Le code\n# était prêt, poussé, vert, et il est resté quatre jours hors ligne. Un hébergeur unique est un\n# point de défaillance unique, et aucune correction de code ne répare cela.\n#\n# Ce workflow construit UNE fois et publie où on le lui dit. Basculer d'un hébergeur à l'autre ne\n# demande alors ni migration ni réécriture : on change une valeur.\n#\n# Il est déclenché À LA MAIN (`workflow_dispatch`) et non sur `push`, et c'est délibéré. Le\n# déploiement automatique de Vercel reste la voie normale tant qu'il fonctionne ; celui-ci est le\n# secours, et un secours qui part tout seul n'est plus un secours, c'est un doublon.\n#\n# Avant de s'en servir, trois choses à poser une seule fois\n# --------------------------------------------------------\n#   1. les secrets CLOUDFLARE_API_TOKEN et CLOUDFLARE_ACCOUNT_ID dans les réglages du dépôt ;\n#   2. les 38 variables d'environnement dans le projet Cloudflare Pages (voir l'audit, sans les\n#      valeurs, qui ne doivent jamais être commitées) ;\n#   3. le webhook GitHub de Vercel, actuellement DISPARU — c'est lui qui a masqué le blocage\n#      quatre jours durant, en faisant croire que tout allait bien côté Vercel.\n\nname: Déploiement\n\non:\n  workflow_dispatch:\n    inputs:\n      cible:\n        description: \"Où publier\"\n        required: true\n        default: cloudflare\n        type: choice\n        options: [cloudflare, vercel]\n\njobs:\n  publier:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n\n      - uses: actions/setup-node@v4\n        with:\n          node-version: '24'\n          cache: npm\n\n      - run: npm ci\n\n      # Les tests AVANT la publication, sans exception. Un déploiement de secours qui part cassé\n      # coûte plus cher que pas de déploiement du tout : on croit être revenu en ligne.\n      - run: npx vitest run\n\n      - run: npx vite build\n\n      # Le build est identique pour les deux cibles : `public/_headers`, `public/_redirects` et\n      # `public/_routes.json` sont ignorés par Vercel, `vercel.json` est ignoré par Cloudflare.\n      # Chacun lit ce qui le concerne et néglige le reste, ce qui permet de garder les deux.\n      - name: Publier sur Cloudflare Pages\n        if: ${{ inputs.cible == 'cloudflare' }}\n        uses: cloudflare/wrangler-action@v3\n        with:\n          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}\n          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}\n          command: pages deploy dist --project-name=zenray-progress\n\n      - name: Publier sur Vercel\n        if: ${{ inputs.cible == 'vercel' }}\n        run: npx vercel deploy --prod --yes --token=${{ secrets.VERCEL_TOKEN }}\n\n// LES DEUX HÉBERGEURS DOIVENT DIRE LA MÊME CHOSE.\n//\n// `vercel.json` et `public/_headers` décrivent la même politique de sécurité pour deux plateformes.\n// Rien n'oblige techniquement à les tenir égaux, et c'est précisément le danger : une politique\n// modifiée d'un seul côté ne casse rien, ne se voit nulle part, et n'apparaît que le jour où l'on\n// bascule sur l'hébergeur qu'on ne regardait pas. Ce test rend la divergence impossible à ignorer.\nimport { describe, it, expect } from 'vitest'\nimport { readFileSync, existsSync } from 'node:fs'\n\nconst vercel = JSON.parse(readFileSync('vercel.json', 'utf8'))\nconst headers = existsSync('public/_headers') ? readFileSync('public/_headers', 'utf8') : ''\nconst redirects = existsSync('public/_redirects') ? readFileSync('public/_redirects', 'utf8') : ''\n\nconst enTeteVercel = (source, cle) => {\n  const bloc = vercel.headers.find((b) => b.source === source)\n  return bloc?.headers.find((h) => h.key === cle)?.value\n}\n\ndescribe('parité Vercel / Cloudflare', () => {\n  it('porte la même politique de sécurité du contenu des deux côtés', () => {\n    const csp = enTeteVercel('/(.*)', 'Content-Security-Policy-Report-Only')\n    expect(csp, 'CSP absente de vercel.json').toBeTruthy()\n    expect(headers, 'CSP absente ou différente dans public/_headers').toContain(csp)\n  })\n\n  it('porte les mêmes en-têtes de sécurité', () => {\n    for (const cle of ['X-Content-Type-Options', 'Referrer-Policy', 'Strict-Transport-Security', 'Permissions-Policy']) {\n      const valeur = enTeteVercel('/(.*)', cle)\n      expect(headers, `${cle} diffère entre vercel.json et _headers`).toContain(`${cle}: ${valeur}`)\n    }\n  })\n\n  it('interdit le cache sur index.html des deux côtés', () => {\n    // Un index.html caché sert des URL d'assets qui n'existent plus après un build : l'application\n    // s'ouvre sur une page blanche. Incident réel du 2026-06-01.\n    expect(enTeteVercel('/index.html', 'Cache-Control')).toContain('no-store')\n    expect(headers).toMatch(/\\/index\\.html\\n\\s+Cache-Control: no-cache, no-store, must-revalidate/)\n  })\n\n  it('reprend chaque réécriture de vercel.json, en _redirects OU en Function', () => {\n    // CE TEST A ATTRAPÉ UN VRAI DÉFAUT LE 2026-08-05, et il faut dire lequel plutôt que de l'assouplir\n    // en silence. Les trois routes de partage étaient bien recopiées dans `_redirects`, à l'identique\n    // de vercel.json — la parité, au sens du texte, était tenue. Mais une réécriture `_redirects` de\n    // Cloudflare Pages ne sert QUE des fichiers statiques : elle ne déclenche jamais une Function.\n    // `/folder`