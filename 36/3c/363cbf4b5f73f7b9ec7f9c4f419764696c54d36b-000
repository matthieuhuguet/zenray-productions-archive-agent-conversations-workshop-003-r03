tring(donnee))\n    return ecrivain.write(octets)\n  }\n\n  const res = {\n    get statusCode() { return statut },\n    set statusCode(c) { statut = c },\n    get headersSent() { return reponseRendue },\n    status(c) { statut = c; return res },\n    setHeader(nom, valeur) {\n      // Un même nom peut porter plusieurs valeurs (Set-Cookie) : on ajoute au lieu d'écraser.\n      if (Array.isArray(valeur)) { entetes.delete(nom); for (const v of valeur) entetes.append(nom, String(v)) }\n      else entetes.set(nom, String(valeur))\n      return res\n    },\n    getHeader(nom) { return entetes.get(nom) },\n    removeHeader(nom) { entetes.delete(nom); return res },\n    write(donnee) { demarrer(); ecrire(donnee); return true },\n    json(objet) {\n      if (!entetes.has('content-type')) entetes.set('content-type', 'application/json; charset=utf-8')\n      demarrer(); ecrire(JSON.stringify(objet)); ecrivain.close(); return res\n    },\n    send(donnee) { demarrer(); ecrire(donnee); ecrivain.close(); return res },\n    end(donnee) { demarrer(); if (donnee !== undefined) ecrire(donnee); ecrivain.close(); return res },\n  }\n\n  // Le handler travaille pendant que la réponse est déjà partie : c'est tout l'intérêt du flux.\n  // On n'attend donc PAS sa fin avant de rendre, mais on ferme le flux s'il jette, sans quoi le\n  // client resterait suspendu sur une réponse qui ne se termine jamais.\n  const travail = Promise.resolve()\n    .then(() => handler(req, res))\n    .catch((e) => {\n      if (!reponseRendue) { statut = 500; entetes.set('content-type', 'application/json; charset=utf-8'); demarrer(); ecrire(JSON.stringify({ error: String((e && e.message) || e) })) }\n      try { ecrivain.close() } catch { /* déjà fermé par le handler */ }\n    })\n\n  // `waitUntil` garde le Worker en vie tant que le handler écrit, même après que la réponse est\n  // partie. Sans lui, un flux long serait coupé net dès le retour de cette fonction.\n  if (waitUntil) waitUntil(travail)\n\n  return reponse\n}\n\n// /api/prospect — collecte de prospects depuis la landing ZenRayProgress.\n//\n// ARCHITECTURE (option A) : fonction serverless SUR LE SITE. Le widget POST ici (même origine, zéro CORS) ;\n// le token GitHub reste CÔTÉ SERVEUR (env GITHUB_TOKEN), jamais exposé au navigateur. On écrit la ligne dans\n// DEUX endroits :\n//   1) la db ZenRayProgress  : pages/Prospect List ...db.json dans matthieuhuguet/zenray-data  (« la magie » :\n//      le prospect apparaît direct dans l'app ZenRayProgress qui lit cette db).\n//   2) un repo PRIVÉ dédié   : prospects.csv dans matthieuhuguet/zenray-prospects (export/sauvegarde CSV).\n// Read-modify-write avec retry sur conflit 409 (deux soumissions simultanées ne s'écrasent pas).\n//\n// Anti-spam léger : honeypot (champ caché « company » que seuls les robots remplissent). Le rate-limit\n// par IP (Upstash / Vercel KV) reste à câbler côté infra. Validation format email + bornes serveur.\n\nconst TOKEN = process.env.GITHUB_TOKEN\nconst OWNER = 'matthieuhuguet'\nconst DATA_REPO = 'zenray-data'\nconst DATA_BRANCH = 'main'\nconst DB_PATH = 'pages/Prospect List ZenRay Progress-5b81.db.json'\nconst PROSPECTS_REPO = 'zenray-prospects'\nconst CSV_PATH = 'prospects.csv'\n// ids de colonnes de la db (doivent matcher le schéma de la db.json)\nconst COL = { name: 'cmpy25b81', email: 'c_email', amount: 'c_amount', date: 'c_date' }\n\nconst b64e = (s) => Buffer.from(s, 'utf8').toString('base64')\nconst b64d = (s) => Buffer.from(s || '', 'base64').toString('utf8')\nconst EMAIL_RE = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/\n\nfunction gh(repo, path, init = {}) {\n  return fetch(`https://api.github.com/repos/${OWNER}/${repo}/${path}`, {\n    ...init,\n    headers: { Authorization: `Bearer ${TOKEN}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-prospect', ...(init.headers || {}) },\n  })\n}\n\n// Lit un fichier (contents API) -> { sha, text } ou { sha:null, text:null } si absent (404).\nasync function read(repo, path) {\n  const r = await gh(repo, `contents/${encodeURI(path)}?ref=main`)\n  if (r.status === 404) return { sha: null, text: null }\n  if (!r.ok) throw new Error(`read ${repo}/${path} ${r.status}`)\n  const j = await r.json()\n  return { sha: j.sha, text: b64d(j.content) }\n}\n\n// Écrit (create/update) avec retry sur conflit : on relit le sha frais et on ré-applique `mutate(text)`.\nasync function writeWithRetry(repo, path, mutate, message, tries = 5) {\n  for (let i = 0; i < tries; i++) {\n    const { sha, text } = await read(repo, path)\n    const next = mutate(text)\n    const r = await gh(repo, `contents/${encodeURI(path)}`, {\n      method: 'PUT',\n      body: JSON.stringify({ message, content: b64e(next), branch: 'main', ...(sha ? { sha } : {}) }),\n    })\n    if (r.ok) return true\n    if (r.status === 409 || r.status === 422) continue // sha périmé / course -> on relit et on retente\n    const t = await r.text()\n    throw new Error(`write ${repo}/${path} ${r.status} ${t.slice(0, 120)}`)\n  }\n  throw new Error(`write ${repo}/${path} conflit (max retries)`)\n}\n\nconst csvEscape = (v) => { const s = String(v ?? ''); return /[\",\\n]/.test(s) ? '\"' + s.replace(/\"/g, '\"\"') + '\"' : s }\n\nexport default async function handler(req, res) {\n  // CORS (la fonction est le SEUL écrivain ; permissif pour POST, utile si jamais servi cross-origin).\n  res.setHeader('Access-Control-Allow-Origin', '*')\n  res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS')\n  res.setHeader('Access-Control-Allow-Headers', 'content-type')\n  if (req.method === 'OPTIONS') { res.statusCode = 204; return res.end() }\n  if (req.method !== 'POST') { res.statusCode = 405; res.setHeader('content-type', 'application/json'); return res.end(JSON.stringify({ error: 'method' })) }\n  if (!TOKEN) { res.statusCode = 500; res.setHeader('content-type', 'application/json'); return res.end(JSON.stringify({ error: 'no-token' })) }\n\n  try {\n    let body = req.body\n    if (typeof body === 'string') { try { body = JSON.parse(body) } catch { body = {} } }\n    if (!body || typeof body !== 'object') body = {}\n    // Honeypot : champ caché « company » que seuls les robots remplissent -> on SIMULE un succès (200) SANS\n    // rien écrire (le robot croit avoir réussi, zéro pollution de la base ni du CSV). Invisible aux humains.\n    if (typeof body.company === 'string' && body.company.trim()) return json(res, 200, { ok: true })\n    const name = String(body.name || '').trim().slice(0, 120)\n    const email = String(body.email || '').trim().slice(0, 200)\n    let amount = Number(body.amount)\n    if (!name) return json(res, 400, { error: 'name' })\n    if (!EMAIL_RE.test(email)) return json(res, 400, { error: 'email' })\n    if (!Number.isFinite(amount) || amount < 1) amount = 0\n    amount = Math.min(Math.round(amount), 100000) // borne haute : un montant absurde (ex. 1e308) ne pollue plus la base / les stats\n    const date = new Date().toISOString()\n\n    // 1) db ZenRayProgress : ajoute une LIGNE (cells par id de colonne).\n    await writeWithRetry(DATA_REPO, DB_PATH, (text) => {\n      let db\n      try { db = JSON.parse(text || '{}') } catch { db = {} }\n      if (!Array.isArray(db.rows)) db.rows = []\n      const row = { id: 'r' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6), cells: {} }\n      row.cells[COL.name] = name\n      row.cells[COL.email] = email\n      row.cells[COL.amount] = amount\n      row.cells[COL.date] = date\n      db.rows.push(row)\n      return JSON.stringify(db, null, 2)\n    }, `prospect: ${email}`)\n\n    // 2) repo privé : append une ligne CSV (backup). BEST-EFFORT : un échec ici ne doit JAMAIS faire\n    //    échouer la conversion — le prospect est déjà capturé dans la db ZenRayProgress ci-dessus.\n    //    Sans ça, un souci sur le repo CSV ferait voir un échec à CHAQUE prospect (qui resoumet -> doublon db).\n    let csvOk = true\n    try {\n      await writeWithRetry(PROSPECTS_REPO, CSV_PATH, (text) => {\n        let out = text && text.length ? text : 'date,name,email,amount_usd\\n'\n        if (!out.endsWith('\\n')) out += '\\n'\n        out += [date, csvEscape(name), csvEscape(email), amount].join(',') + '\\n'\n        return out\n      }, `prospect: ${email}`)\n    } catch (e) {\n      csvOk = false\n      console.error('prospect csv backup failed:', String((e && e.message) || e).slice(0, 160))\n    }\n\n    return json(res, 200, { ok: true, ...(csvOk ? {} : { warn: 'csv-backup' }) })\n  } catch (e) {\n    console.error('prospect handler error:', String((e && e.message) || e).slice(0, 200))\n    // 500 (pas 200) -> le monitoring voit les prospects perdus sur le seul point de conversion. PAS de `detail`\n    // -> on n'expose jamais le nom d'un repo privé (ex. « zenray-prospects/prospects.csv ») au navigateur.\n    return json(res, 500, { error: 'server' })\n  }\n}\n\nfunction json(res, code, obj) { res.statusCode = code; res.setHeader('content-type', 'application/json'); res.end(JSON.stringify(obj)); return res }\n--- package ---\n{\n  \"name\": \"ZenRayWebsite\",\n  \"private\": true,\n  \"version\": \"0.0.0\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\",\n    \"lint\": \"eslint .\",\n    \"preview\": \"vite preview\"\n  },\n  \"dependencies\": {\n    \"@vercel/analytics\": \"^2.0.1\",\n    \"hls.js\": \"^1.6.16\",\n    \"react\": \"^19.2.0\",\n    \"react-dom\": \"^19.2.0\"\n  },\n  \"devDependencies\": {\n    \"@eslint/js\": \"^9.39.1\",\n    \"@types/react\": \"^19.2.5\",\n    \"@types/react-dom\": \"^19.2.3\",\n    \"@vitejs/plugin-react\": \"^5.1.1\",\n    \"eslint\": \"^9.39.1\",\n    \"eslint-plugin-react-hooks\": \"^7.0.1\",\n    \"eslint-plugin-react-refresh\": \"^0.4.24\",\n    \"globals\": \"^16.5.0\",\n    \"vite\": \"^7.2.4\"\n  }\n}\n--- vercel ---\n{\r\n  \"rewrites\": [\r\n    { \"source\": \"/(.*)\", \"destination\": \"/index.html\" }\r\n  ]\r\n}\r\n--- analytics refs ---\npackage.json:13:    \"@vercel/analytics\": \"^2.0.1\",\npackage-lock.json:11:        \"@vercel/analytics\": \"^2.0.1\",\npackage-lock.json:1447:    \"node_modules/@vercel/analytics\": {\npackage-lock.json:1449:      \"resolved\": \"https://registry.npmjs.org/@vercel/analytics/-/analytics-2.0.1.tgz\",\nsrc/components/ProspectWidget.jsx:3:import { track } from '@vercel/analytics'\nsrc/components/ProspectWidget.jsx:54:      if (r && r.ok) { setStatus('done'); try { track('prospect_submit', { amount: effectiveAmount, custom }) } catch { /* analytics best-effort : ne jamais casser la conversion */ } }\nsrc/App.jsx:3:import { Analytics } from \"@vercel/analytics/react\";\n\n--- target CLAUDE ---\n# ZenRayWebsite — Instructions Claude\n\n<!-- BEGIN:REGLE-ETAT-REPRISE -->\n## PRIORITÉ 0 — ÉTAT DE REPRISE : `state.json`, et `events.jsonl` seulement s'il éclaire (2026-08-04)\n\nPour toute tâche incomplète, y compris la gestion de cette règle elle-même, crée ou mets à jour\n`state.json` pour indiquer clairement où reprendre, et n'ajoute `events.jsonl` que lorsqu'il devient\nutile de comprendre comment cet état a été atteint.\n<!-- END:REGLE-ETAT-REPRISE -->\n\n## Règles de contenu et formatage\n\n**Séparateurs dans les titres et meta tags : jamais de | ni de —**\nDans tous les titres (title, og:title, twitter:title, document.title), meta descriptions, et tout texte visible du site : pas de barre verticale `|`, pas de em-dash `—`, pas de en-dash `–`. Utiliser la virgule `,` ou un simple espace. Plus sobre, plus professionnel.\n\nExemples corrects :\n- `Matthieu Huguet, Technical Artist 3D`\n- `Works Matthieu Huguet`\n\nExemples interdits :\n- `Matthieu Huguet — Technical Artist 3D`\n- `Works | Matthieu Huguet`\n\n## Stack\n\n- React + Vite, déployé sur Vercel (projet `zenray-productions`, team `zenrays-projects`)\n- Repo GitHub : `https://github.com/matthieuhuguet/ZenRayWebsite`\n- Domaine : `matthieuhuguet.com` (Namecheap DNS, A @ 76.76.21.21, CNAME www cname.vercel-dns.com)\n- Alias : `zenray.vercel.app` conservé actif\n- Sitemap : `https://matthieuhuguet.com/sitemap.xml` (soumis Google Search Console)\n\n## Workflow déploiement\n\n`git push origin master` suffit. Vercel détecte le push, lance `vite build`, déploie automatiquement. Ne jamais push de `dist/`.\n\n## Compatibilité navigateurs — RÈGLES ABSOLUES\n\n### Formats image — DÉCISION RADICALE 2026-05-20\n- **WebP UNIQUEMENT** : tous les `.avif` ont été virés du site (291 fichiers supprimés). WebP est universel (Safari 14+, 2020+). Plus de double format, plus de `<picture>`, plus de fallback chain.\n- **Pourquoi virer AVIF** : Safari pouvait charger un AVIF (HTTP 200) sans réussir à le décoder, sans fire d'event error. Image blanche silencieuse impossible à debugger. Le browser pick avec `<picture>` aurait dû éviter ça mais Matthieu a vu encore des boîtes noires en production = trop fragile. Décision : un seul format, le plus compatible.\n- **SmartImg** : composant qui auto-convertit toute string `*.avif` en `*.webp` au render time. Garde-fou contre les régressions futures. Pas de `<picture>`, juste un `<img>`.\n- **JPEG/PNG** : à utiliser seulement pour masks CSS, pas pour le contenu.\n- **Jamais de AVIF comme source de CSS `mask-image`** : reste valable, mais avec WebP-only c'est plus un sujet.\n\n### Formats vidéo — DÉCISION RADICALE 2026-05-20\n- **H.264 MP4 UNIQUEMENT** : tous les `_av1.mp4` ont été virés (13 fichiers). H.264 marche partout, c'est suffisant.\n- **Pattern actuel** :\n  ```html\n  <video autoPlay muted loop playsInline preload=\"metadata\">\n    <source src=\"video.mp4\" type=\"video/mp4\" />\n  </video>\n  ```\n- **AV1 MP4** : INTERDIT. Pas de double encoding. Une vidéo = une source H.264.\n- **WebM (VP8/VP9)** : INTERDIT. Safari ne supporte pas. H.264 partout.\n\n### CSS Safari\n- **`backdrop-filter: blur()`** : INTERDIT sur éléments sticky ou qui scrollent. Cause des repaints GPU massifs en Safari à chaque frame de scroll. Remplacer par un fond semi-opaque (opacity ≥ 0.95).\n- **`backdrop-filter`** sur modales : acceptable (elles sont fixes, pas de scroll), mais préférer fond opaque si possible.\n- **`mask-image: url(*.avif)`** : INTERDIT (voir section images). Utiliser gradients CSS.\n- **`transition: all`** : éviter, préférer les propriétés spécifiques (`opacity`, `transform`). `transition: all` surveille TOUTES les propriétés et peut déclencher des layouts en cascade.\n- **`height: 100%` dans flex container sans height explicite** : bug Safari classique. Toujours vérifier que le parent a une height définie ou utiliser `flex: 1` à la place.\n\n### JavaScript Safari\n- **Safari supporte** : optional chaining, nullish coalescing, `Array.at()`, `structuredClone`, `IntersectionObserver`, `ResizeObserver`, WebGL, WebGL2, WebAssembly — depuis Safari 15.4+.\n- **IntersectionObserver + dynamic content** : en Safari, quand un élément est injecté dans le DOM et observé immédiatement, l'observer peut ne pas firer si le layout n'est pas encore calculé. Toujours ajouter un check `getBoundingClientRect()` en fallback.\n\n## Performance — RÈGLES\n\n- **`backdrop-filter`** : voir section CSS Safari. Interdit sur sticky/scroll.\n- **Compteurs animés** : utiliser `requestAnimationFrame` pour la fluidité 60fps. Le coût ≈60 setState/sec est négligeable sur Mac M5 et browser-throttlé quand la tab est cachée. Décision Matthieu 2026-05-20 : la fluidité visuelle prime sur les micro-optimisations.\n- **Lazy loading** : `loading=\"lazy\"` uniquement sur les images hors viewport initial. Les images visibles au-dessus de la fold doivent rester en eager loading.\n- **GPU canvas (WebGL)** : les hooks `useZenCursor` et `useWaterRipple` sont désactivés (false). Ne pas réactiver sans mesurer l'impact Safari.\n- **jsPDF / html2canvas** : supprimés. Ne pas réintroduire. Trop lourd (572KB).\n- **Framer Motion** : limiter au minimum. Actuellement utilisé dans SlideLayout (article UE5 MCP). Préférer CSS transitions.\n- **`transition: all`** : 10+ occurrences dans le site. Chaque instance est un risque de perf. Remplacer progressivement par des transitions ciblées.\n- **CVPage** : lazy-loaded avec React.lazy + Suspense.\n\n## Encodage médias — RÈGLES\n\n### Images\n- Format cible : WebP (un seul format, plus de chain de fallback)\n- Commande single : `ffmpeg -i input.jpg -c:v libwebp -quality 80 output.webp`\n- Batch parallèle (16 cores) :\n  ```bash\n  find . -name \"*.jpg\" -o -name \"*.jpeg\" -o -name \"*.png\" | \\\n    grep -v \".DS_Store\" | xargs -P 16 -I{} sh -c \\\n    'out=\"${1%.*}.webp\"; ffmpeg -i \"$1\" -c:v libwebp -quality 80 \"$out\" && echo \"OK: $out\"' _ {}\n  ```\n- Ne JAMAIS générer d'AVIF, c'est interdit dans ce projet (cf. décision 2026-05-20).\n\n### Vidéos\n- Format unique : H.264 MP4 yuv420p (universel, Safari compatible)\n- Encoding H.264 : `ffmpeg -i input -c:v libx264 -pix_fmt yuv420p -crf 23 -preset fast -c:a aac -b:a 128k -movflags +faststart output.mp4`\n- Ne JAMAIS générer d'AV1, c'est interdit dans ce projet.\n\n## Historique des corrections Safari (à ne pas refaire)\n\n| Date | Problème | Fix |\n|------|----------|-----|\n| 2026-05-20 | Video hero noire (demo.webm VP9) | Converti en H.264 MP4, source tags |\n| 2026-05-20 | Lag au scroll (backdrop-filter navbar) | Supprimé, navBg → 0.97 opacité |\n| 2026-05-20 | Images invisibles (mask-image AVIF) | mlMask() → linear-gradient CSS |\n| 2026-05-20 | Counter loader laggy (RAF 60fps) | setInterval 20fps |\n| 2026-05-20 | Images encore noires Safari (decode silent fail) | AVIF + AV1 virés complètement, WebP/H.264 only |\n--- README candidates ---\n# React + Vite\n\nThis template provides a minimal setup to get React working in Vite with HMR and some ESLint rules.\n\nCurrently, two official plugins are available:\n\n- [@vitejs/plugin-react](https://github.com/vitejs/vite-plugin-react/blob/main/packages/plugin-react) uses [Babel](https://babeljs.io/) (or [oxc](https://oxc.rs) when used in [rolldown-vite](https://vite.dev/guide/rolldown)) for Fast Refresh\n- [@vitejs/plugin-react-swc](https://github.com/vitejs/vite-plugin-react/blob/main/packages/plugin-react-swc) uses [SWC](https://swc.rs/) for Fast Refresh\n\n## React Compiler\n\nThe React Compiler is not enabled on this template because of its impact on dev & build performances. To add it, see [this documentation](https://react.dev/learn/react-compiler/installation).\n\n## Expanding the ESLint configuration\n\nIf you are developing a production application, we recommend using TypeScript with type-aware lint rules enabled. Check out the [TS template](https://github.com/vitejs/vite/tree/main/packages/create-vite/template-react-ts) for information on how to integrate TypeScript and [`typescript-eslint`](https://typescript-eslint.io) in your project.\n--- public config candidates ---\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019ff065-c40c-7b72-b920-79f280a02a3d"}}}
