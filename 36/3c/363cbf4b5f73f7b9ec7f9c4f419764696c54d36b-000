{ action: 'tree', dir: 'pages' })\n  })\n\n  it('décode un corps JSON, et laisse les binaires en octets', async () => {\n    const vuJson = await adapterHandlerNode((rq, rs) => rs.json(rq.body),\n      req('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{\"a\":1}' }))\n    expect(await vuJson.json()).toEqual({ a: 1 })\n\n    const vuBin = await adapterHandlerNode((rq, rs) => rs.json({ octets: rq.body.length, premier: rq.body[0] }),\n      req('/api/upload', { method: 'POST', headers: { 'content-type': 'application/octet-stream' }, body: new Uint8Array([7, 8, 9]) }))\n    expect(await vuBin.json()).toEqual({ octets: 3, premier: 7 })\n  })\n\n  it('ne lit jamais le corps d’un GET', async () => {\n    // Lire `json()` sur une requête sans corps jette ; l'adaptateur doit s'en abstenir plutôt que\n    // de rattraper l'erreur, sinon un GET malformé deviendrait indistinguable d'un GET normal.\n    const r = await adapterHandlerNode((rq, rs) => rs.json({ corps: rq.body === undefined }), req('/api/page'))\n    expect(await r.json()).toEqual({ corps: true })\n  })\n\n  it('STREAME : la réponse part avant que le handler ait fini d’écrire', async () => {\n    // C'est le cas qui justifie tout le fichier. `stream.js` et `shard.js` servent des médias\n    // déchiffrés au fil de l'eau ; si l'adaptateur attendait la fin, un flux de plusieurs centaines\n    // de mégaoctets deviendrait un tampon en mémoire et ferait tomber le Worker.\n    let libere = false\n    const handler = async (rq, rs) => {\n      rs.setHeader('content-type', 'text/plain')\n      rs.write('premier')\n      await new Promise((r) => setTimeout(r, 30))\n      libere = true\n      rs.write('-second')\n      rs.end()\n    }\n    const r = await adapterHandlerNode(handler, req('/api/stream'))\n    // La réponse existe DÉJÀ alors que le handler dort encore : c'est exactement ce qu'on veut.\n    expect(libere).toBe(false)\n    expect(r.headers.get('content-type')).toBe('text/p