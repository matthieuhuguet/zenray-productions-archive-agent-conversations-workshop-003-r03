érifier le hash du bundle servi contre le build local, puis `git push`.\n\n# Configuration Cloudflare Pages. Le pendant de vercel.json, préparé le 2026-07-30 et NON DÉPLOYÉ :\n# il attend le jour où l'on bascule, et ce jour-là il ne restera qu'à reporter les variables.\n\nname = \"zenray-progress\"\npages_build_output_dir = \"dist\"\n\n# LA DATE COMPTE AUTANT QUE LE DRAPEAU.\n#\n# `nodejs_compat` donne node:fs, node:crypto, node:path et node:url — ce qui permet aux\n# quarante-quatre handlers de `server/` de tourner sans être réécrits.\n#\n# Et surtout, `nodejs_compat_populate_process_env` peuple `process.env` avec les variables et les\n# secrets du Worker. Il est actif PAR DÉFAUT à partir d'une date de compatibilité au 2025-04-01,\n# et c'est lui qui rend inutile le portage des 112 lectures de `process.env` dans le code. Une date\n# antérieure les casserait toutes en silence : elles rendraient une chaîne vide, et l'application\n# se comporterait comme si aucun jeton n'était configuré.\ncompatibility_date = \"2025-06-01\"\ncompatibility_flags = [\"nodejs_compat\"]\n\n# Les 38 variables se posent en secrets dans l'interface, ou par `wrangler pages secret put`.\n# Elles ne sont volontairement PAS listées ici : ce fichier est commité, elles ne doivent pas\n# l'être. La liste vit dans docs/HEBERGEMENT-audit-cloudflare.md, sans les valeurs.\n\n--- package ---\n{\n  \"name\": \"zenray-progress\",\n  \"private\": true,\n  \"version\": \"0.1.0\",\n  \"type\": \"module\",\n  \"description\": \"ZenRayProgress — LifeOS de Matthieu Huguet : tableau de bord d'objectifs + agenda hebdomadaire, persistant.\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\",\n    \"preview\": \"vite preview\",\n    \"test\": \"vitest run\",\n    \"test:watch\": \"vitest\",\n    \"test:music\": \"vitest run src/audio src/create --passWithNoTests\",\n    \"test:e2e\": \"playwright test\"\n  },\n  \"dependencies\": {\n    \"@blocknote/core\": \"^0.51.3\",\n    \"@blocknote/mant