{"timestamp":"2026-08-11T10:37:41.975Z","ordinal":245,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019ff066-44d7-74a2-bbfd-535dcce3d64c","call_id":"call_o8a5HNMmkR2zhfCkRynfb4AT","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"import React, { useState } from 'react'\nimport { PALETTE } from '../theme'\nimport { track } from '@vercel/analytics'\n\n// Widget de collecte de prospects pour la landing ZenRayProgress.\n// Question : \"What would you be ready to pay for this app?\" — 15$ / 30$ (ancre) / Custom (>= 15$).\n// 2 champs seulement (Nom + Email) = friction minimale. POST -> /api/prospect (fonction serveur du site).\n// DA : carte pricing macOS (inspiration Supaste). Coral = accent de marque, noir = action (téléchargement macOS).\n// S'adapte aux `colors` du thème courant (light/dark).\n\nconst FONTS = { serif: \"'AnthropicSerif', Georgia, serif\", sans: \"'AnthropicSans', sans-serif\", mono: \"'AnthropicMono', monospace\" }\nconst PRESETS = [15, 30]\nconst MIN_CUSTOM = 15\n\nexport default function ProspectWidget({ colors }) {\n  const c = colors || {}\n  const textPrimary = c.textPrimary || '#1d1d1f'\n  const textSecondary = c.textSecondary || 'rgba(60,60,67,0.6)'\n  const surface = c.surface || '#ffffff'\n  const border = c.border || 'rgba(0,0,0,0.10)'\n  const dark = (textPrimary || '').toUpperCase().startsWith('#FFF')\n  const fieldBg = dark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.02)'\n\n  const [amount, setAmount] = useState(30)       // ancre = 30\n  const [custom, setCustom] = useState(false)\n  const [customVal, setCustomVal] = useState('')\n  const [name, setName] = useState('')\n  const [email, setEmail] = useState('')\n  const [company, setCompany] = useState('')     // honeypot anti-spam : jamais visible, rempli seulement par les robots\n  const [status, setStatus] = useState('idle')   // idle | sending | done | error\n  const [err, setErr] = useState('')\n  // Chiffres du prix en Anthropic Serif Medium (choix validé).\n  const priceFont = { fontFamily: FONTS.serif, fontWeight: 500 }\n\n  const effectiveAmount = custom ? Math.max(0, Math.round(Number(customVal) || 0)) : amount\n  const emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email.trim())\n  const customOk = !custom || effectiveAmount >= MIN_CUSTOM\n  const priceTooLow = effectiveAmount < MIN_CUSTOM\n  const canSubmit = name.trim() && emailOk && customOk && effectiveAmount >= MIN_CUSTOM && status !== 'sending'\n\n  const submit = async () => {\n    if (!canSubmit) { setErr(!name.trim() ? 'Your name?' : !emailOk ? 'A valid email?' : `At least $${MIN_CUSTOM}`); return }\n    setErr(''); setStatus('sending')\n    // Timeout dur (15s) : une fonction serverless qui stalle ne doit PAS laisser le bouton \"Sending…\" à l'infini.\n    const ctrl = new AbortController()\n    const timer = setTimeout(() => ctrl.abort(), 15000)\n    try {\n      const resp = await fetch('/api/prospect', {\n        method: 'POST', headers: { 'content-type': 'application/json' },\n        body: JSON.stringify({ name: name.trim(), email: email.trim(), amount: effectiveAmount, company }),\n        signal: ctrl.signal,\n      })\n      const r = await resp.json().catch(() => null)\n      if (r && r.ok) { setStatus('done'); try { track('prospect_submit', { amount: effectiveAmount, custom }) } catch { /* analytics best-effort : ne jamais casser la conversion */ } }\n      else { setStatus('error'); setErr((r && r.error) ? `Error: ${r.error}` : 'Something went wrong — try again.') }\n    } catch (e) {\n      setStatus('error')\n      setErr(e && e.name === 'AbortError' ? 'Timed out — try again.' : 'Network error — try again.')\n    } finally {\n      clearTimeout(timer)\n    }\n  }\n\n  // ── Carte (coque commune) ────────────────────────────────────────────────\n  const shell = { position: 'relative', maxWidth: 680, margin: '0 auto', width: '100%' }\n  const card = {\n    position: 'relative', background: surface, border: `1px solid ${border}`, borderRadius: 26,\n    padding: 'clamp(26px,4vw,38px) clamp(20px,4vw,32px) clamp(22px,3vw,28px)',\n    boxShadow: dark ? '0 30px 80px -28px rgba(0,0,0,0.6)' : '0 30px 80px -26px rgba(226,118,135,0.42), 0 6px 18px rgba(0,0,0,0.05)',\n  }\n  const headerPill = {\n    position: 'absolute', top: -17, left: '50%', transform: 'translateX(-50%)', whiteSpace: 'nowrap',\n    display: 'inline-flex', alignItems: 'center', gap: 8, padding: '8px 16px', borderRadius: 99,\n    background: 'linear-gradient(135deg, #6fb6ed 0%, #4371ee 100%)', color: '#fff', fontFamily: FONTS.sans, fontWeight: 600, fontSize: 13,\n    boxShadow: '0 8px 20px rgba(67,113,238,0.32)',\n  }\n  const glyph = <img src=\"/zenrayprogress-icon.png\" alt=\"\" width=\"20\" height=\"20\" style={{ display: 'inline-block', borderRadius: 5 }} />\n\n  if (status === 'done') {\n    return (\n      <div style={shell}>\n        <div style={{ ...card, textAlign: 'center' }}>\n          <div style={headerPill}>{glyph} ZenRayProgress</div>\n          <div style={{ width: 60, height: 60, borderRadius: 99, margin: '14px auto 16px', background: PALETTE.primarySoft, display: 'grid', placeItems: 'center' }}>\n            <svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M5 12.5l4.2 4.2L19 6.5\" stroke={PALETTE.primaryDark} strokeWidth=\"2.4\" strokeLinecap=\"round\" strokeLinejoin=\"round\" /></svg>\n          </div>\n          <div style={{ fontFamily: FONTS.serif, fontWeight: 800, fontSize: 27, color: textPrimary, marginBottom: 8 }}>You're on the list.</div>\n          <div style={{ fontFamily: FONTS.sans, fontSize: 15, color: textSecondary, lineHeight: 1.6 }}>Thanks {name.trim().split(' ')[0]} — you'll receive a mail for early access in a few days.</div>\n        </div>\n      </div>\n    )\n  }\n\n  const pill = (selected) => ({\n    flex: 1, padding: '12px 6px', borderRadius: 13, cursor: 'pointer', textAlign: 'center', position: 'relative',\nimport { useState, useEffect, useRef, useMemo, useCallback, lazy, Suspense, Component, createContext, useContext } from \"react\";\nimport { createPortal } from \"react-dom\";\nimport { Analytics } from \"@vercel/analytics/react\";\nimport Button from \"./components/Button\";\nconst CVPage = lazy(() => import(\"./components/CVPage\"));\nconst ArticleRenderer = lazy(() => import(\"./articles/ArticleRenderer\"));\nimport { PALETTE, THEMES } from \"./theme\";\nimport useWaterRipple from \"./useWaterRipple\";\n\n// Garde-fou anti-écran-blanc (règle P0) : isole un échec de chunk lazy / de rendu à son sous-arbre.\n// React.lazy cache la promesse rejetée -> un soft-retry ne re-importe pas ; on propose donc un Reload\n// (index.html est en no-cache, donc le reload récupère des chunks frais après un déploiement).\nclass ChunkBoundary extends Component {\n  constructor(props) { super(props); this.state = { failed: false }; }\n  static getDerivedStateFromError() { return { failed: true }; }\n  componentDidCatch(err) { console.error(\"chunk/render error:\", (err && err.message) || err); }\n  render() {\n    if (!this.state.failed) return this.props.children;\n3:import { Analytics } from \"@vercel/analytics/react\";\n3084:      <Analytics />\n"},{"type":"input_text","text":"# Migrer ZenRayProgress sur Cloudflare, et pouvoir revenir\n\nAudit fait le 2026-07-30, après le blocage Vercel. Il répond à trois questions : ce qu'un\ndéménagement coûterait réellement, ce qui bloquerait, et si un basculement d'un hébergeur à\nl'autre en un geste est atteignable.\n\n> **Avertissement de méthode.** Les chiffres de plateformes cités ici viennent de la page\n> tarifaire lue le 2026-07-30 ou de ma connaissance arrêtée en mai 2026. Les seuils des Workers\n> (requêtes par jour, millisecondes de processeur) ne sont **pas vérifiés** et doivent l'être avant\n> tout engagement. Tout ce qui concerne le dépôt, en revanche, est mesuré.\n\n---\n\n## 1. L'inventaire réel, mesuré\n\n| Élément | Chiffre | Source |\n|---|---|---|\n| Handlers dans `server/` | **44 fichiers** | `ls server/*.js` |\n| Fonctions déclarées à Vercel | **1** (routeur catch-all `api/[...route].js`) | contournement de la limite Hobby de 12 |\n| Variables d'environnement | **38** | `grep process.env` |\n| Fichiers dans `dist/` | **2 197** | plafond Pages : 20 000, donc large |\n| Poids de `dist/` | **104 Mo** | |\n| Plus gros fichier | **30,7 Mo** (`ffmpeg-core.wasm`) | **dépasse le plafond Pages de 25 Mo** |\n| Modules Node utilisés | `crypto` (9), `url` (2), `path` (2), `fs` (2) | |\n\nCe n'est donc pas « une fonction de 145 lignes », comme je l'avais dit d'abord et à tort. C'est un\nrouteur mince devant quarante-quatre handlers.\n\n---\n\n## 2. Ce qui migre sans rien changer\n\nLa très grande majorité. Les handlers appellent `fetch` vers l'API GitHub, transforment du JSON et\nrépondent : c'est du code standard qui tourne partout.\n\n- Le front Vite, statique, servi par Pages sans aucune adaptation.\n- Tous les handlers qui n'utilisent que `fetch`, `JSON`, `URL`, `TextEncoder`.\n- Le chiffrement : `aes-256-gcm` est directement disponible en Web Crypto sous le nom `AES-GCM`.\n- Le streaming : les Workers gèrent les flux nativement, souvent mieux que les fonctions Node.\n\n---\n\n## 3. CORRECTION DU 2026-07-30 : les trois quarts de cette section étaient faux\n\nCe qui suivait a été écrit avant vérification, sur des suppositions. Trois requêtes à la\ndocumentation Cloudflare les ont démenties, et il faut lire la suite en le sachant.\n\n| Ce que j'affirmais | Ce qui est vrai | Conséquence |\n|---|---|---|\n| `node:crypto` demande une réécriture en Web Crypto | **supporté**, y compris `createHash`, `createHmac`, `randomBytes`, `createDecipheriv` | rien à réécrire |\n| « Un Worker n'a pas de système de fichiers » | **`node:fs` supporté** : mémoire, fichiers du bundle lisibles sous `/bundle`, écriture dans `/tmp` non persistante | `media-key.js` fonctionne tel quel, son repli disque étant de toute façon réservé au développement |\n| Les 38 variables demandent un portage | **`process.env` est peuplé automatiquement** par `nodejs_compat_populate_process_env`, actif par défaut depuis le 2025-04-01 | les 112 lectures de `process.env` ne bougent pas |\n\n**Le coût de la migration tombe donc de deux journées à quelques heures**, et la couche\nd'adaptation se réduit à une seule fonction au lieu de trois.\n\n**La leçon de méthode, qui vaut plus que la correction :** j'ai conçu une abstraction pour\ncontourner des contraintes que je n'avais pas vérifiées. Une abstraction écrite avant la mesure\nabstrait surtout l'ignorance de celui qui l'écrit. Trois requêtes ont fait fondre cent lignes de\ncode et une journée d'estimation.\n\n### Ce qui reste vrai de la section d'origine\n\nSeul le point 3.3 (`vercel.json` à transposer) et le point 3.4 (`@vercel/analytics`) tiennent. Le\nreste est conservé ci-dessous **à titre d'historique**, barré par le tableau ci-dessus.\n\n## 3 bis. Ce que je croyais devoir réécrire (historique, démenti)\n\n### 3.1 `node:crypto`, cinq primitives (une demi-journée)\n\n| Primitive | Où | Remplacement |\n|---|---|---|\n| `createHash` | 9 fichiers | `crypto.subtle.digest` |\n| `createHmac` | | `crypto.subtle.sign` avec une clé HMAC importée |\n| `randomBytes` | | `crypto.getRandomValues` |\n| `createDecipheriv('aes-256-gcm')` | `stream.js`, `shared-media.js` | `crypto.subtle.decrypt` en `AES-GCM` |\n| `timingSafeEqual` | `api/[...route].js` | dix lignes de comparaison à temps constant |\n\nAucune n'est un obstacle : Web Crypto couvre les cinq. La seule vigilance porte sur `AES-GCM`, où\nl'étiquette d'authentification est concaténée au chiffré par Web Crypto alors que Node la sépare.\nSe tromper là produit un déchiffrement qui échoue sans dire pourquoi.\n\n### 3.2 `node:fs`, deux fichiers, et c'est le vrai travail\n\n**Un Worker n'a pas de système de fichiers.** Deux endroits en dépendent.\n\n`server/media-key.js` lit et **écrit** un fichier de clé sur disque. L'écriture est impossible sur\nCloudflare : il faut passer par une variable d'environnement pour la lecture, et par KV si une\nrotation doit persister. C'est le point qui demande une décision, pas seulement une traduction.\n\n`server/share-og.js` lit `dist/index.html` pour y injecter les métadonnées Open Graph. Sur Pages,\ncela se fait par `env.ASSETS.fetch()`, qui remplace exactement le `includeFiles` de `vercel.json`.\n\n### 3.3 `vercel.json` (une heure)\n\nLes réécritures deviennent un fichier `_redirects`, les en-têtes un fichier `_headers`. La\npolitique de sécurité du contenu se transpose telle quelle. Le `maxDuration: 60` disparaît, les\nPages Functions ayant leurs propres limites.\n\n### 3.4 `@vercel/analytics` (dix minutes)\n\nUn import dans `src/main.jsx`, remplacé par Cloudflare Web Analytics ou simplement retiré.\n\n### 3.5 Le stockage clé-valeur (à décider)\n\nQuatre variables trahissent une dépendance : `KV_REST_API_URL`, `KV_REST_API_TOKEN`,\n`UPSTASH_REDIS_REST_URL`, `UPSTASH_REDIS_REST_TOKEN`. Upstash s'appelle en HTTP depuis n'importe\noù, donc rien ne casse ; mais si c'est Vercel KV qui sert, il faut basculer sur Cloudflare KV ou\ngarder Upstash comme service tiers commun aux deux hébergeurs. **Cette dernière voie est la bonne\nsi l'on veut le basculement en un geste** : un stockage neutre ne dépend d'aucun des deux.\n\n---\n\n## 4. Ce qui bloquait, et qui est RÉSOLU depuis le 2026-07-30\n\n`ffmpeg-core.wasm` (32,2 Mo) est sorti du déploiement et servi par le CDN npm de jsDelivr.\n`dist/` passe de 104 à 73 Mo, le plus gros fichier de 30,7 à 1,9 Mo : le plafond de 25 Mo par\nfichier de Cloudflare Pages n'est plus atteint.\n\n**Nuance qui a failli faire écarter la solution :** la limite d'environ 20 Mo de jsDelivr vaut pour\nle chemin `/gh/`, celui de nos médias. Le chemin `/npm/` sert les 32 232 419 octets en HTTP 200,\navec `application/wasm` et CORS ouvert. Vérifié, pas supposé.\n\n## 4 bis. Le raisonnement d'origine sur ce blocage (historique)\n\n### `ffmpeg-core.wasm` pèse 30,7 Mo, le plafond de Pages est de 25 Mo\n\nTrois issues, par ordre de préférence.\n\n1. **Le servir depuis jsDelivr**, exactement comme les médias le sont déjà. Le fichier est public,\n   immuable, versionné : c'est précisément le cas d'usage d'un CDN de paquets. Coût : changer une\n   URL. C'est aussi la solution qui allège le déploiement de trente mégaoctets, ce qui profite à\n   Vercel autant qu'à Cloudflare.\n2. Le mettre dans R2 et le servir par le Worker.\n3. Charger `@ffmpeg/core` depuis un registre public au moment de l'exécution.\n\n**La première voie mérite d'être faite tout de suite, indépendamment de toute migration.**\n\n---\n\n## 5. Le basculement en un geste, est-ce atteignable ?\n\nOui, et l'architecture est déjà à moitié en place, puisque `api/[...route].js` est un routeur mince\ndevant des handlers qui ne connaissent pas leur hébergeur. Il manque une couche et un pipeline.\n\n### 5.1 La couche d'adaptation\n\nUn seul fichier, `server/_platform.js`, expose les trois seules choses qui diffèrent :\n\n```\nreadAsset(chemin)   → lit un fichier livré (dist/index.html)\nsecret(nom)         → lit une variable d'environnement\nkv                  → get / set, si un stockage est nécessaire\n```\n\nLes quarante-quatre handlers ne parlent plus qu'à cette couche. Deux implémentations coexistent,\nune par hébergeur, choisies au moment du build. **Une seule règle à tenir : aucun handler\nn'importe `node:fs` ni ne lit `process.env` directement.** Elle se vérifie par une commande, donc\nelle peut devenir un test.\n\n### 5.2 Le pipeline\n\nGitHub Actions construit une fois et déploie où on lui dit, l'hébergeur cible n'étant qu'une\nvariable du workflow. Les deux déploiements peuvent même coexister en permanence, l'un servant de\nsecours à l'autre, le basculement se réduisant alors à un changement d'enregistrement DNS.\n\nC'est d'ailleurs la vraie réponse au blocage de ce mois : **un hébergeur unique est un point de\ndéfaillance unique**, et quatre jours de production figée l'ont démontré.\n\n### 5.3 Coût\n\n| Étape | Estimation |\n|---|---|\n| Sortir le wasm de 30,7 Mo vers jsDelivr | 1 h, utile immédiatement |\n| Écrire `server/_platform.js` et y faire passer les 44 handlers | 1 journée |\n| Porter les cinq primitives de `node:crypto` | 1 demi-journée |\n| Transposer `vercel.json` en `_redirects` et `_headers` | 1 h |\n| Reporter les 38 variables d'environnement | 1 h, fastidieux et sans risque |\n| Décider du sort de la clé média (`media-key.js`) | à trancher, pas à coder |\n| Workflow GitHub Actions à deux cibles | 2 h |\n\n**Environ deux journées**, dont une seule vraiment technique.\n\n---\n\n## 6. Faut-il migrer ?\n\nPas dans l'urgence, et la raison est mesurée. Le blocage de ce mois venait d'**une ligne** qui\nredemandait 3,02 Mo toutes les 25 secondes, corrigée le 2026-07-30 : la consommation est passée à\n300 octets par appel, facteur 10 553. Le plan Vercel actuel redevient largement suffisant.\n\nCe qui reste vrai en revanche, et ne dépend d'aucun correctif :\n\n- Vercel facture **les octets**, Cloudflare facture **le calcul**. Une application qui sert des\n  médias consomme des octets, donc elle joue contre le compteur de Vercel et pour celui de\n  Cloudflare.\n- Vercel bloque sur une **appréciation** (« fair use ») autant que sur un seuil. Un compteur se\n  pilote, un jugement ne se pilote pas.\n- Un hébergeur unique reste un point de défaillance unique.\n\n**La conclusion raisonnable** est donc de préparer le basculement sans l'exécuter : écrire la\ncouche d'adaptation, sortir le wasm, monter le pipeline à deux cibles. Le jour où Vercel bloque de\nnouveau, la bascule prend dix minutes au lieu de deux jours.\n\n---\n\n# ÉTAT AU 2026-07-30 : LA MIGRATION EST PRÊTE, ELLE N'EST PAS EXÉCUTÉE\n\nTout ce qui suit est écrit, testé et commité. Rien n'est déployé sur Cloudflare, et le site\ncontinue de tourner sur Vercel.\n\n## Ce qui existe désormais dans le dépôt\n\n| Fichier | Rôle | Vérifié par |\n|---|---|---|\n| `server/_platform.js` | la seule chose qui diffère entre les deux hôtes : lire un fichier livré | usage réel dans `share-og.js` |\n| `server/_cloudflare-adapter.js` | traduit `Request`/`Response` en `req`/`res` | **9 tests**, dont le streaming |\n| `functions/api/[[route]].js` | point d'entrée Cloudflare Pages | build |\n| `public/_headers` | les en-têtes de `vercel.json` | **test de parité** |\n| `public/_redirects` | les réécritures de `vercel.json` | **test de parité** |\n| `public/_routes.json` | seules `/api/*` et les trois routes de partage invoquent la fonction | **test de parité** |\n| `wrangler.toml` | `nodejs_compat` + date de compatibilité au 2025-06-01 | — |\n| `tests/hebergement.test.js` | interdit aux deux configurations de diverger | **5 tests** |\n| `.github/workflows/deploiement.yml` | publie sur l'une ou l'autre cible, à la main | — |\n\n**379 tests verts, build vert.**\n\n## Les trois garde-fous, et pourquoi chacun existe\n\n**Le test de parité.** `vercel.json` et `public/_headers` décrivent la même politique pour deux\nplateformes, et rien n'oblige techniquement à les tenir égaux. C'est exactement le danger : une\npolitique de sécurité modifiée d'un seul côté ne casse rien, ne se voit nulle part, et n'apparaît\nque le jour où l'on bascule sur l'hébergeur qu'on ne regardait pas.\n\n**`_routes.json`.** Sans lui, chaque requête statique consommerait une invocation de fonction.\nC'est la version Cloudflare du piège qui a fait exploser le compteur d'origine chez Vercel, et il\nvalait mieux le fermer avant d'y tomber une seconde fois.\n\n**Les tests de l'adaptateur.** Il ne tournera jamais sur Cloudflare avant le jour de la bascule.\nCes neuf tests sont donc la seule chose qui distingue un adaptateur qui marche d'un adaptateur qui\n--- wrangler ---\n# Configuration Cloudflare Pages. Le pendant de vercel.json, préparé le 2026-07-30 et NON DÉPLOYÉ :\n# il attend le jour où l'on bascule, et ce jour-là il ne restera qu'à reporter les variables.\n\nname = \"zenray-progress\"\npages_build_output_dir = \"dist\"\n\n# LA DATE COMPTE AUTANT QUE LE DRAPEAU.\n#\n# `nodejs_compat` donne node:fs, node:crypto, node:path et node:url — ce qui permet aux\n# quarante-quatre handlers de `server/` de tourner sans être réécrits.\n#\n# Et surtout, `nodejs_compat_populate_process_env` peuple `process.env` avec les variables et les\n# secrets du Worker. Il est actif PAR DÉFAUT à partir d'une date de compatibilité au 2025-04-01,\n# et c'est lui qui rend inutile le portage des 112 lectures de `process.env` dans le code. Une date\n# antérieure les casserait toutes en silence : elles rendraient une chaîne vide, et l'application\n# se comporterait comme si aucun jeton n'était configuré.\ncompatibility_date = \"2025-06-01\"\ncompatibility_flags = [\"nodejs_compat\"]\n\n# Les 38 variables se posent en secrets dans l'interface, ou par `wrangler pages secret put`.\n# Elles ne sont volontairement PAS listées ici : ce fichier est commité, elles ne doivent pas\n# l'être. La liste vit dans docs/HEBERGEMENT-audit-cloudflare.md, sans les valeurs.\n--- routes ---\n{\n  \"version\": 1,\n  \"include\": [\n    \"/api/*\",\n    \"/watch\",\n    \"/view\",\n    \"/folder\"\n  ],\n  \"exclude\": []\n}\n--- redirects ---\n# Transposition de la section `rewrites` de vercel.json (2026-07-30).\n# Le code 200 signifie REECRITURE et non redirection : l'URL vue par le visiteur ne change pas.\n\n# /watch, /view et /folder ne sont PLUS ici : une reecriture `_redirects` de Cloudflare Pages ne\n# sert que des fichiers statiques et ne declenche jamais une Function, si bien que ces trois lignes\n# ne faisaient rien -- et c'est pire qu'une absence, elles donnaient a lire une regle qui semblait\n# couvrir le cas. Elles vivent maintenant dans functions/{watch,view,folder}.js.\n\n# Repli d'application a page unique, EN DERNIER : toute route inconnue rend index.html, qui laisse\n# le routeur du navigateur decider. Les chemins /api/* n'arrivent jamais ici, `_routes.json` les\n# ayant deja envoyes a la fonction.\n/*  /index.html  200\n--- headers ---\n# Transposition de la section `headers` de vercel.json (2026-07-30).\n# Cloudflare Pages lit ce fichier ; Vercel lit vercel.json. Les deux doivent rester EGAUX, et\n# `hebergement.test.js` echoue s'ils divergent : deux politiques de securite qui s'ecartent en\n# silence, c'est une faille qui n'apparait que sur l'hebergeur qu'on ne regarde pas ce jour-la.\n\n/*\n  X-Content-Type-Options: nosniff\n  Referrer-Policy: strict-origin-when-cross-origin\n  Strict-Transport-Security: max-age=31536000; includeSubDomains\n  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()\n  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://cdn.jsdelivr.net https://sdk.scdn.co https://www.youtube.com https://s.ytimg.com; worker-src 'self' blob: https://cdn.jsdelivr.net; frame-src 'self' https://open.spotify.com https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com; connect-src 'self' blob: data: https://api.spotify.com https://accounts.spotify.com https://api.github.com https://raw.githubusercontent.com https://cdn.jsdelivr.net https://www.youtube.com https://*.googleapis.com https://*.google.com; img-src 'self' blob: data: https:; media-src 'self' blob: data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;\n\n# index.html JAMAIS en cache : c'est lui qui porte les URL hashees des assets. Servi depuis un\n# cache, il reference des fichiers qui n'existent plus et l'application s'ouvre sur une page\n# blanche. Incident du 2026-06-01, voir la memoire `no_blank_screen_after_rebuild`.\n/\n  Cache-Control: no-cache, no-store, must-revalidate\n\n/index.html\n  Cache-Control: no-cache, no-store, must-revalidate\n\n# Les assets portent un hash dans leur nom : ils sont immuables, donc cachables