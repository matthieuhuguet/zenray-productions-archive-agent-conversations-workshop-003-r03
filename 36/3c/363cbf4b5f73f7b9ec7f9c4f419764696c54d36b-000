er que les nouveaux chunks — JAMAIS de force-push sur un repo d'archive existant (ça effacerait les versions). Par fichier : on lit le manifeste existant, on compare le `sha256` ; inchangé -> rien (ni re-chunk ni réécriture) ; modifié/nouveau -> chunks poussés + **nouvelle entrée dans `.file.json` `versions[]` (append-only)**. Le top-level du manifeste = dernière version (rétro-compat v2). UI : `FileNodeViewer` affiche un **sélecteur de versions** (daté + taille) ; choisir une version antérieure reconstruit/télécharge CETTE version depuis son commit. Purge disque locale : toujours manuelle (jamais auto).\n383-\n384-**Aperçu QuickLook (2026-06-11) :** dans la vue Downloads, sélection au clic / flèches ↑↓ et **Espace = aperçu** (Échap/Espace ferme). L'aperçu reconstitue le fichier à la volée (`assembleBlobUrl` : raw direct ou fetch des chunks → Blob) et l'affiche selon le mime (image/vidéo/audio/pdf/texte). Cap mémoire 500 Mo (au-delà : télécharger). **Automatique** pour toute archive présente ou future (manifestes uniformes `chunks[]`+`mime`), rien à recâbler. Téléchargement ET aperçu tirent les chunks de **GitHub raw** (`raw.githubusercontent.com`), pas jsDelivr. **Overlay rendu via `createPortal(document.body)`** : une carte parent avec `backdrop-filter` piège sinon le `position:fixed` à l'intérieur d'elle (l'aperçu n'apparaissait qu'au centre du scroll) — règle générale : toute surface flottante `position:fixed` posée sous une carte à `backdrop-filter`/`transform` doit passer par un portal vers `document.body`.\n385-\n386-**Réponse type à donner à Matthieu :** confirmer l'action, lancer la commande (en arrière-plan si gros), reporter done/vérif, et rappeler que la purge locale est à sa main après contrôle dans Create/Downloads.\n\n     127 api/prospect.js\n// /api/prospect — collecte de prospects depuis la landing ZenRayProgress.\n//\n// ARCHITECTURE (option A) : fonction serverless SUR LE SITE. Le widget POST ici (même origine, zéro CORS) ;\n// le token GitHub reste CÔTÉ SERVEUR (env GITHUB_TOKEN), jamais exposé au navigateur. On écrit la ligne dans\n// DEUX endroits :\n//   1) la db ZenRayProgress  : pages/Prospect List ...db.json dans matthieuhuguet/zenray-data  (« la magie » :\n//      le prospect apparaît direct dans l'app ZenRayProgress qui lit cette db).\n//   2) un repo PRIVÉ dédié   : prospects.csv dans matthieuhuguet/zenray-prospects (export/sauvegarde CSV).\n// Read-modify-write avec retry sur conflit 409 (deux soumissions simultanées ne s'écrasent pas).\n//\n// Anti-spam léger : honeypot (champ caché « company » que seuls les robots remplissent). Le rate-limit\n// par IP (Upstash / Vercel KV) reste à câbler côté infra. Validation format email + bornes serveur.\n\nconst TOKEN = process.env.GITHUB_TOKEN\nconst OWNER = 'matthieuhuguet'\nconst DATA_REPO = 'zenray-data'\nconst DATA_BRANCH = 'main'\nconst DB_PATH = 'pages/Prospect List ZenRay Progress-5b81.db.json'\nconst PROSPECTS_REPO = 'zenray-prospects'\nconst CSV_PATH = 'prospects.csv'\n// ids de colonnes de la db (doivent matcher le schéma de la db.json)\nconst COL = { name: 'cmpy25b81', email: 'c_email', amount: 'c_amount', date: 'c_date' }\n\nconst b64e = (s) => Buffer.from(s, 'utf8').toString('base64')\nconst b64d = (s) => Buffer.from(s || '', 'base64').toString('utf8')\nconst EMAIL_RE = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/\n\nfunction gh(repo, path, init = {}) {\n  return fetch(`https://api.github.com/repos/${OWNER}/${repo}/${path}`, {\n    ...init,\n    headers: { Authorization: `Bearer ${TOKEN}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-prospect', ...(init.headers || {}) },\n  })\n}\n\n// Lit un fichier (contents API) -> { sha, text } ou { sha:null, text:null } si absent (404).\nasync function read(repo, path) {\n  const r = await gh(repo, `contents/${encodeURI(path)}?ref=main`)\n  if (r.status === 404) return { sha: null, text: null }\n  if (!r.ok) throw new Error(`read ${repo}/${path} ${r.status}`)\n  const j = await r.json()\n  return { sha: j.sha, text: b64d(j.content) }\n}\n\n// Écrit (create/update) avec retry sur conflit : on relit le sha frais et on ré-applique `mutate(text)`.\nasync function writeWithRetry(repo, path, mutate, message, tries = 5) {\n  for (let i = 0; i < tries; i++) {\n    const { sha, text } = await read(repo, path)\n    const next = mutate(text)\n    const r = await gh(repo, `contents/${encodeURI(path)}`, {\n      method: 'PUT',\n      body: JSON.stringify({ message, content: b64e(next), branch: 'main', ...(sha ? { sha } : {}) }),\n    })\n    if (r.ok) return true\n    if (r.status === 409 || r.status === 422) continue // sha périmé / course -> on relit et on retente\n    const t = await r.text()\n    throw new Error(`write ${repo}/${path} ${r.status} ${t.slice(0, 120)}`)\n  }\n  throw new Error(`write ${repo}/${path} conflit (max retries)`)\n}\n\nconst csvEscape = (v) => { const s = String(v ?? ''); return /[\",\\n]/.test(s) ? '\"' + s.replace(/\"/g, '\"\"') + '\"' : s }\n\nexport default async function handler(req, res) {\n  // CORS (la fonction est le SEUL écrivain ; permissif pour POST, utile si jamais servi cross-origin).\n  res.setHeader('Access-Control-Allow-Origin', '*')\n  res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS')\n  res.setHeader('Access-Control-Allow-Headers', 'content-type')\n  if (req.method === 'OPTIONS') { res.statusCode = 204; return res.end() }\n  if (req.method !== 'POST') { res.statusCode = 405; res.setHeader('content-type', 'application/json'); return res.end(JSON.stringify({ error: 'method' })) }\n  if (!TOKEN) { res.statusCode = 500; res.setHeader('content-type', 'application/json'); return res.end(JSON.stringify({ error: 'no-token' })) }\n\n  try {\n    let body = req.body\n    if (typeof body === 'string') { try { body = JSON.parse(body) } catch { body = {} } }\n    if (!body || typeof body !== 'object') body = {}\n    // Honeypot : champ caché « company » que seuls les robots remplissent -> on SIMULE un succès (200) SANS\n    // rien écrire (le robot croit avoir réussi, zéro pollution de la base ni du CSV). Invisible aux humains.\n    if (typeof body.company === 'string' && body.company.trim()) return json(res, 200, { ok: true })\n    const name = String(body.name || '').trim().slice(0, 120)\n    const email = String(body.email || '').trim().slice(0, 200)\n    let amount = Number(body.amount)\n    if (!name) return json(res, 400, { error: 'name' })\n    if (!EMAIL_RE.test(email)) return json(res, 400, { error: 'email' })\n    if (!Number.isFinite(amount) || amount < 1) amount = 0\n    amount = Math.min(Math.round(amount), 100000) // borne haute : un montant absurde (ex. 1e308) ne pollue plus la base / les stats\n    const date = new Date().toISOString()\n\n    // 1) db ZenRayProgress : ajoute une LIGNE (cells par id de colonne).\n    await writeWithRetry(DATA_REPO, DB_PATH, (text) => {\n      let db\n      try { db = JSON.parse(text || '{}') } catch { db = {} }\n      if (!Array.isArray(db.rows)) db.rows = []\n      const row = { id: 'r' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6), cells: {} }\n      row.cells[COL.name] = name\n      row.cells[COL.email] = email\n      row.cells[COL.amount] = amount\n      row.cells[COL.date] = date\n      db.rows.push(row)\n      return JSON.stringify(db, null, 2)\n    }, `prospect: ${email}`)\n\n    // 2) repo privé : append une ligne CSV (backup). BEST-EFFORT : un échec ici ne doit JAMAIS faire\n    //    échouer la conversion — le prospect est déjà capturé dans la db ZenRayProgress ci-dessus.\n    //    Sans ça, un souci sur le repo CSV ferait voir un échec à CHAQUE prospect (qui resoumet -> doublon db).\n    let csvOk = true\n    try {\n      await writeWithRetry(PROSPECTS_REPO, CSV_PATH, (text) => {\n        let out = text && text.length ? text : 'date,name,email,amount_usd\\n'\n        if (!out.endsWith('\\n')) out += '\\n'\n        out += [date, csvEscape(name), csvEscape(email), amount].join(',') + '\\n'\n        return out\n      }, `prospect: ${email}`)\n    } catch (e) {\n      csvOk = false\n      console.error('prospect csv backup failed:', String((e && e.message) || e).slice(0, 160))\n    }\n\n    return json(res, 200, { ok: true, ...(csvOk ? {} : { warn: 'csv-backup' }) })\n  } catch (e) {\n    console.error('prospect handler error:', String((e && e.message) || e).slice(0, 200))\n    // 500 (pas 200) -> le monitoring voit les prospects perdus sur le seul point de conversion. PAS de `detail`\n    // -> on n'expose jamais le nom d'un repo privé (ex. « zenray-prospects/prospects.csv ») au navigateur.\n    return json(res, 500, { error: 'server' })\n  }\n}\n\nfunction json(res, code, obj) { res.statusCode = code; res.setHeader('content-type', 'application/json'); res.end(JSON.stringify(obj)); return res }\n\n--- gitignore ---\nnode_modules\ndist\n.env\n.DS_Store\n.vercel\nBrandAssets/\nIcons/\n\n.env*\n.claude/\n\n--- current size ---\n1.4G\t.\n132M\tdist\n131M\tpublic\n828K\tsrc\n8.0K\tapi\n15311300 dist/projects/material-layer-system/montage_v2GTSectra.mp4\n12905891 dist/projects/procedural-grass-system/video-grass-final.mp4\n7907363 dist/projects/procedural-grass-system/wf-preview-old.mp4\n6998699 dist/projects/procedural-grass-system/video-gdc-analysis.mp4\n6491537 dist/projects/material-layer-system/StoneBlend2.mp4\n6419894 dist/projects/hda-stairs-church/demo.mp4\n5402019 dist/projects/material-layer-system/stone-blend.mp4\n5252724 dist/projects/pushvault/vid1_final.mp4\n3896901 dist/projects/material-layer-system/grass-blend.mp4\n3507298 dist/projects/substance-ornate-fabric/img10.webp\n3497281 dist/projects/procedural-grass-system/wf-first-params.mp4\n3002177 dist/projects/material-layer-system/grassBlend2.mp4\n1931546 dist/projects/pushvault/vid2_final.mp4\n1812581 dist/projects/procedural-grass-system/wf-hda-terrain.mp4\n1654284 dist/projects/louisiana-bayou-v15/blueprint-spline.webp\n1134642 dist/projects/louisiana-bayou/thumbnail.webp\n1134642 dist/projects/louisiana-bayo