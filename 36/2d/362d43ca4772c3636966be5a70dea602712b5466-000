chaque manifest enfant chunked-media { dir, parts, size, chunkSize, count, repo }.\n    25\t//\n    26\t// IMPORTANT sur le découpage des chunks hashés sans toucher /api/stream :\n    27\t//   /api/stream construit le chemin disque `m.dir + '/' + m.parts[i] + '.bin'`. Pour garder des noms\n    28\t//   HASHÉS tout en restant servi tel quel, on met `dir = media/<id>/<flux>` et `parts[i] = <sha256>`\n    29\t//   (les 64 hex). Le chemin final `media/<id>/<flux>/<sha256>.bin` est donc anonymisé (nom = hash,\n    30\t//   non séquentiel) ET 100% compatible avec le handler existant. Le deep-sharding `ab/cd/<hash>.bin`\n    31\t//   à la racine du repo demanderait une modif de /api/stream (hors périmètre, zéro régression).\n    32\t\n    33\timport { readFile, writeFile, mkdir, rm, stat } from 'node:fs/promises'\n    34\timport { existsSync } from 'node:fs'\n    35\timport { execFileSync, execSync, spawn } from 'node:child_process'\n    36\timport { createHash } from 'node:crypto'\n    37\timport path from 'node:path'\n    38\t\n    39\texport const CHUNK = 3145728 // 3 Mo, identique à /api/stream, video-transcode.mjs, universalCapture.js\n    40\tconst OWNER = process.env.CONTENT_OWNER || 'matthieuhuguet'\n    41\tconst SHARD_RE = /^zenray-media-\\d{2,}$/\n    42\t\n    43\tconst noop = () => {}\n    44\tconst sh = (cmd, a, opts = {}) => execFileSync(cmd, a, { stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 1 << 28, ...opts })\n    45\tconst newId = () => `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 9)}`\n    46\tconst sha256 = (buf) => createHash('sha256').update(buf).digest('hex')\n    47\t\n    48\texport const LANG_LABEL = { fre: 'Français', fra: 'Français', eng: 'English', jpn: '日本語', und: 'Audio', ger: 'Deutsch', deu: 'Deutsch', spa: 'Español', ita: 'Italiano' }\n    49\texport const ISO2 = {\n    50\t  fre: 'fr', fra: 'fr', eng: 'en', jpn: 'ja', ger: 'de', deu: 'de', spa: 'es',\n    51\t  ita: 'it', por: 'pt', rus: 'ru', chi: 'zh', zho: 'zh', ko