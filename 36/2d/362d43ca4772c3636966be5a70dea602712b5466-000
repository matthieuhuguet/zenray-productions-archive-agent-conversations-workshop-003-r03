────────────────────────────────────────\n   189\t// Pousse l'image chiffrée + sa vignette sur le shard public courant, renvoie le blob manifeste\n   190\t// { path:'<dest>/<rel>.img.json', content } à committer sur zenray-data par le bulk (avec les autres).\n   191\t// IMPORTANT : le commit SHA jsDelivr n'est connu qu'au flush() final. On renvoie donc un manifeste avec\n   192\t// un PLACEHOLDER de commit que le bulk RÉSOUT après flush (resolveImgManifests ci-dessous).\n   193\texport async function ingestImageBulk(absPath, rel, dest, ctx) {\n   194\t  if (!ctx.dir) await ctx.openShard()\n   195\t  const clear = await readFile(absPath)\n   196\t  const hash = sha256Hex(clear)\n   197\t  const ext = (rel.match(/\\.([a-z0-9]+)$/i) || [, 'bin'])[1].toLowerCase()\n   198\t  const { w, h } = imageDims(absPath)\n   199\t\n   200\t  // binaire principal chiffré (IV déterministe = dédup), puis DÉCOUPÉ en morceaux ≤19 Mo (uniforme, même\n   201\t  // pour une petite image -> 1 seul morceau). Chaque morceau est son propre fichier git ; le manifeste garde\n   202\t  // la liste ORDONNÉE des chemins (cdnChunks) pour que le client les concatène avant de déchiffrer.\n   203\t  const { cipher } = encryptDeterministic(clear, ctx.key, hash)\n   204\t  await ctx.reserve(cipher.length) // réserve la place du TOTAL -> tous les morceaux dans le MÊME repo\n   205\t  const chunkBufs = splitIntoChunks(cipher)\n   206\t  const cdnChunks = []\n   207\t  let repo = null\n   208\t  for (let i = 0; i < chunkBufs.length; i++) {\n   209\t    const cp = shardChunkPathFor(hash, i)\n   210\t    repo = await ctx.writeBinary(cp, chunkBufs[i])\n   211\t    cdnChunks.push(cp)\n   212\t  }\n   213\t\n   214\t  // vignette webp chiffrée (best-effort), avec son PROPRE IV (contenu distinct) — jamais chunkée (toujours petite)\n   215\t  let thumbIv = null\n   216\t  let thumbPath = null\n   217\t  const thumbBuf = makeThumbWebp(absPath, ctx.work)\n   218\t  if (thumbBuf) {\n   219\t    const tHash = sha256H