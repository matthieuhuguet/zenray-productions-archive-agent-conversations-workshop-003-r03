t      const m = /time=\\s*(\\d+):(\\d+):(\\d+(?:\\.\\d+)?)/.exec(s)\n    88\t      if (m && totalSec > 0) {\n    89\t        const sec = (+m[1]) * 3600 + (+m[2]) * 60 + parseFloat(m[3])\n    90\t        onPct(Math.max(0, Math.min(100, (sec / totalSec) * 100)))\n    91\t      }\n    92\t    })\n    93\t    p.on('error', reject)\n    94\t    p.on('close', (code) => { code === 0 ? resolve() : reject(new Error(`ffmpeg exit ${code}: ${errTail.slice(-300)}`)) })\n    95\t  })\n    96\t}\n    97\t\n    98\t// --- index de fragments fMP4 (moof -> {t, b}) -------------------------------\n    99\tfunction fragIndexOf(buf) {\n   100\t  let timescale = 0; const frags = []\n   101\t  const walk = (start, end, cb) => {\n   102\t    let p = start\n   103\t    while (p + 8 <= end) {\n   104\t      let size = buf.readUInt32BE(p); let hdr = 8\n   105\t      const type = buf.toString('latin1', p + 4, p + 8)\n   106\t      if (size === 1) { size = Number(buf.readBigUInt64BE(p + 8)); hdr = 16 }\n   107\t      if (size < 8 || p + size > end) break\n   108\t      cb(type, p, p + hdr, p + size); p += size\n   109\t    }\n   110\t  }\n   111\t  walk(0, buf.length, (type, start, cs, ce) => {\n   112\t    if (type === 'moov') walk(cs, ce, (t2, s2, c2, e2) => { if (t2 === 'trak') walk(c2, e2, (t3, s3, c3, e3) => { if (t3 === 'mdia') walk(c3, e3, (t4, s4, c4) => { if (t4 === 'mdhd') { const ver = buf[c4]; timescale = ver === 1 ? buf.readUInt32BE(c4 + 4 + 8 + 8) : buf.readUInt32BE(c4 + 4 + 4 + 4) } }) }) })\n   113\t    else if (type === 'moof') { let dt = 0; walk(cs, ce, (t2, s2, c2, e2) => { if (t2 === 'traf') walk(c2, e2, (t3, s3, c3) => { if (t3 === 'tfdt') { const ver = buf[c3]; dt = ver === 1 ? Number(buf.readBigUInt64BE(c3 + 4)) : buf.readUInt32BE(c3 + 4) } }) }); frags.push({ b: start, dt }) }\n   114\t  })\n   115\t  const ts = timescale || 1\n   116\t  return frags.map((f) => ({ t: +(f.dt / ts).toFixed(3), b: f.b }))\n   117\t}\n   118\t\n   119\t// --- chunkage HASHÉ d'un flux ------