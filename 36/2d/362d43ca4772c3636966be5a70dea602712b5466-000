)], { encoding: 'utf8' })\n   166\t    if ((cr.stdout || '').trim() !== '201') throw new Error(`création repo ${ctx.repo}: HTTP ${(cr.stdout || '?')}`)\n   167\t    git(ctx.dir, ['config', 'user.email', 'bot@zenray']); git(ctx.dir, ['config', 'user.name', 'zenray-bot'])\n   168\t    git(ctx.dir, ['config', 'http.version', 'HTTP/1.1']); git(ctx.dir, ['config', 'http.postBuffer', '524288000'])\n   169\t    git(ctx.dir, ['add', '-A']); git(ctx.dir, ['commit', '-q', '-m', 'init'])\n   170\t    git(ctx.dir, ['remote', 'add', 'origin', cloneUrl(ctx.repo)])\n   171\t    const ps = git(ctx.dir, ['push', '-q', 'origin', 'HEAD:main'], 120000)\n   172\t    if (ps.status !== 0) throw new Error('push-init shard: ' + (ps.stderr || '').slice(-200))\n   173\t    log(`  >>> repo neuf ${ctx.repo} (${ctx.vis}) créé — zéro clone, zéro check`)\n   174\t    ctx.bytes = 0; ctx.pendingBytes = 0\n   175\t  }\n   176\t\n   177\t  async function pushShard() {\n   178\t    const st = git(ctx.dir, ['status', '--porcelain'])\n   179\t    if (!st.stdout || !st.stdout.trim()) return true\n   180\t    git(ctx.dir, ['add', '-A']); git(ctx.dir, ['commit', '-q', '-m', '+vidraw'])\n   181\t    for (let a = 0; a < 12; a++) {\n   182\t      const ps = git(ctx.dir, ['push', '-q', 'origin', 'HEAD:main'], 1800000)\n   183\t      if (ps.status === 0) { ctx.pendingBytes = 0; return true }\n   184\t      log(`  vidraw push retry ${a + 1}/12 ${(ps.stderr || '').slice(-120)}`)\n   185\t      git(ctx.dir, ['pull', '--rebase', '-q', 'origin', 'main'], 600000)\n   186\t      await sleep(Math.min(60000, 3000 * (a + 1)))\n   187\t    }\n   188\t    return false\n   189\t  }\n   190\t\n   191\t  // Écrit une part (déjà hachée) dans le clone. Rollover AVANT écriture si le shard atteint le cap. Push\n   192\t  // incrémental tous les ~900 Mo (anti-RAM, anti-packfile géant). Renvoie le repo où elle a atterri.\n   193\t  //\n   194\t  // SEUIL 900 Mo (2026-07-11, relevé depuis 400 Mo, demande Matthieu de pousser plus gros