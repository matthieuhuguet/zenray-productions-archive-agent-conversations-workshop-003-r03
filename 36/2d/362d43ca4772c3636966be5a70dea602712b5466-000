le cap. Push\n   192\t  // incrémental tous les ~900 Mo (anti-RAM, anti-packfile géant). Renvoie le repo où elle a atterri.\n   193\t  //\n   194\t  // SEUIL 900 Mo (2026-07-11, relevé depuis 400 Mo, demande Matthieu de pousser plus gros pour aller plus\n   195\t  // vite). ATTENTION AU PLAFOND RÉEL : img-pipeline.mjs documente un incident DÉJÀ VÉCU — un push unique de\n   196\t  // plusieurs Go HANG (git reste à 0% CPU, aucun timeout ne le rattrape avant l'échéance de 30 min ci-dessous)\n   197\t  // -> règle éprouvée « rester sous 1 Go/commit ». Matthieu proposait 1900 Mo en pensant une limite GitHub à\n   198\t  // 2000 Mo : cette limite n'existe nulle part dans ce projet ni dans la doc GitHub — le seul plafond RÉEL et\n   199\t  // TESTÉ ici est <1 Go. 900 Mo reste sous cette marge de sécurité tout en coupant le nombre de push d'un gros\n   200\t  // lot vidéo de plus de moitié vs 400 Mo (ex. 53 Go/900 Mo ≈ 60 push contre 133 à 400 Mo). AUCUN effet sur la\n   201\t  // visibilité média-par-média : le manifeste vidéo n'est de toute façon committé qu'UNE fois par vidéo (flush\n   202\t  // final ci-dessous), ce seuil ne pilote QUE les push intermédiaires PENDANT l'écriture d'UNE SEULE vidéo.\n   203\t  async function writePart(hashedPath, buf) {\n   204\t    // Découpage ANTICIPÉ (avant le push de la part, jamais de question à GitHub) : si cette part ferait\n   205\t    // dépasser le plafond au repo courant, on pousse ce qui est en attente et on ouvre un AUTRE repo neuf.\n   206\t    if (ctx.bytes > 0 && ctx.bytes + buf.length > SHARD_CAP) { if (!await pushShard()) throw new Error('push-incr vidraw'); ctx.commitOf[ctx.repo] = git(ctx.dir, ['rev-parse', 'HEAD']).stdout.trim(); await openShard() }\n   207\t    const dst = path.join(ctx.dir, hashedPath)\n   208\t    await mkdir(path.dirname(dst), { recursive: true })\n   209\t    await writeFile(dst, buf)\n   210\t    ctx.bytes += buf.length; ctx.pendingBytes += buf.length\n   211\t    if (ctx.pendingBytes >= 900 * 1024 * 1024) { if (!await pushShard()) throw new Error('push-incr vidraw') }\n   212\t    return ctx.repo\n   213\t  }\n   214\t\n   215\t  async function flush() {\n   216\t    if (ctx.dir && existsSync(ctx.dir)) {\n   217\t      if (!await pushShard()) throw new Error('push-final vidraw ' + ctx.repo)\n   218\t      ctx.commitOf[ctx.repo] = git(ctx.dir, ['rev-parse', 'HEAD']).stdout.trim()\n   219\t      log(`  ✓ ${ctx.repo} poussé (commit ${(ctx.commitOf[ctx.repo] || '').slice(0, 7)})`)\n   220\t    }\n   221\t  }\n   222\t  // commit SHA courant du shard (pour pinner raw.github tout de suite après le flush d'UNE vidéo)\n   223\t  function headSha() { return ctx.dir ? git(ctx.dir, ['rev-parse', 'HEAD']).stdout.trim() : null }\n   224\t\n   225\t  ctx.openShard = openShard; ctx.writePart = writePart; ctx.pushShard = pushShard; ctx.flush = flush; ctx.headSha = headSha\n   226\t  return ctx\n   227\t}\n   228\t\n   229\t// ── INGESTION D'UNE VIDÉO BRUTE ───────────────────────────────────────────────────────────────────────\n   230\t// Découpe le fichier ORIGINAL en parts de 95 Mo (lecture streamée, anti-OOM), les pousse via le ctx shard,\n   231\t// pousse le poster, et renvoie le manifeste .media.json (type 'video-raw') prêt à committer sur zenray-data.\n   232\t// CONFIRMÉ EN LIGNE = ce manifeste committé (le bulk le fait), pas avant. URLs raw.github pinnées sur le commit.\n   233\texport async function ingestVideoRaw(file, { dest, base, vctx, posterCtx = null, workDir = '/tmp/zr_vidraw', log = noop }) {\n   234\t  const p = await probe(file)\n   235\t  const outDir = path.join(workDir, base.replace(/[^\\w.-]/g, '_') + '-' + Date.now().toString(36))\n   236\t  await mkdir(outDir, { recursive: true })\n   237\t\n   238\t  // 0) FASTSTART : index au début -> la lecture démarre avec la 1re part. Lossless (-c copy), pas d'encodage.\n   239\t  //    On découpe ENSUITE ce fichier (et plus l'original) pour que la part 1 contienne l'index.\n   240\t  //    p.codec transmis pour le tag hvc1 obligatoire quand la source est HEVC (lecture iPhone).\n   241\t  const srcFile = await remuxFaststart(file, outDir, log, p.codec)\n   242\t  const total = (await stat(srcFile)).size\n   243\t  const nParts = Math.ceil(total / PART)\n   244\t  log(`${base} — ${(total / 1073741824).toFixed(2)} Go, ${p.width}x${p.height} ${p.codec}, ${nParts} parts de 95 Mo (AUCUN réencodage)`)\n   245\t\n   246\t  // 1) poster (1 frame, best-effort) depuis l'original\n   247\t  const posterFile = await makePoster(file, outDir, p.duration ? p.duration / 2 : 1)\n   248\t\n   249\t  // 2) split streamé du fichier (faststart) + push part par part (jamais le fichier entier en RAM)\n   250\t  const parts = []           // { idx, repo, path, hash, size, iv }\n   251\t  const fd = await open(srcFile, 'r')\n   252\t  const b = Buffer.alloc(PART)\n   253\t  try {\n   254\t    let off = 0, idx = 0\n   255\t    while (off < total) {\n   256\t      const { bytesRead } = await fd.read(b, 0, PART, off)\n   257\t      if (!bytesRead) break\n   258\t      const slice = Buffer.from(b.subarray(0, bytesRead)) // copie : writePart est async, on réutilise b\n   259\t      const { cipher, iv } = encryptPart(slice) // AES-256-GCM, IV aléatoire par part (voir plus haut)\n   260\t      const h = sha256(cipher); const hp = partPathFor(h) // adressé par hash du CIPHERTEXT (jamais du clair)\n   261\t      const repo = await vctx.writePart(hp, cipher)\n   262\t      parts.push({ idx, repo, path: hp, hash: h, size: bytesRead, iv })\n   263\t      off += bytesRead; idx++\n   264\t      if (idx % 5 === 0 || off >= total) log(`  part ${idx}/${nParts} (${(off / 1073741824).toFixed(2)}/${(total / 1073741824).toFixed(2)} Go)`)\n   265\t    }\n   266\t  } finally { await fd.close() }\n   267\t\n   268\t  // poster en part raw (simple, toujours dispo) — petit, va dans le shard courant\n   269\t  let posterPart = null\n   270\t  if (posterFile) {\n   271\t    try {\n   272\t      const pb = await readFile(posterFile)\n   273\t      const h = sha256(pb); const hp = `${h.slice(0, 2)}/${h.slice(2, 4)}/${h}.jpg`\n   274\t      const repo = await vctx.writePart(hp, pb)\n   275\t      posterPart = { repo, path: hp }\n   276\t    } catch (e) { log(`  ⚠ poster: ${(e.message || e).toString().slice(0, 80)}`) }\n   277\t  }\n   278\t\n   279\t  // 3) flush du shard -> commit SHA connu -> URLs raw.github pinnées\n   280\t  await vctx.flush()\n   281\t  const shaOf = (repo) => vctx.commitOf[repo] || vctx.headSha()\n   282\t  const isPriv = vctx.vis === 'private'\n   283\t  const partUrls = parts.map((pt) => rawUrl(pt.repo, shaOf(pt.repo), pt.path))\n   284\t  // POSTER sur repo PRIVÉ : un <img src> ne peut pas porter de header d'authentification -> l'URL stockée\n   285\t  // dans le manifeste passe par /api/raw-proxy (le serveur, qui a le token, va chercher l'image et la sert\n   286\t  // même-origine). Petit fichier (~50 Ko), zéro impact bande passante notable. Repo public : URL raw directe.\n   287\t  const posterRaw = posterPart ? rawUrl(posterPart.repo, shaOf(posterPart.repo), posterPart.path) : null\n   288\t  const posterUrl = posterRaw ? (isPriv ? `/api/raw-proxy?u=${encodeURIComponent(posterRaw)}` : posterRaw) : null\n   289\t\n   290\t  // 4) manifeste .media.json (type 'video-raw'). offsets cumulés (EN CLAIR) -> le Service Worker mappe un\n   291\t  // Range -> part(s), déchiffre chaque part avec son iv, PUIS applique ces offsets sur le clair obtenu.\n   292\t  // private:true -> le lecteur (SW) et le téléchargement convertissent chaque URL raw en appel\n   293\t  // api.github.com (Accept: raw + token via /api/raw-token) — le repo est invisible/illisible publiquement.\n   294\t  let acc = 0\n   295\t  const partsMeta = parts.map((pt) => { const start = acc; acc += pt.size; return { url: partUrls[pt.idx], start, end: acc - 1, size: pt.size, iv: pt.iv } })\n   296\t  const manifest = {\n   297\t    type: 'video-raw', v: 1, name: path.basename(file), mime: mimeOf(file),\n   298\t    size: total, codec: p.codec, width: p.width, height: p.height, duration: p.duration,\n   299\t    parts: partsMeta, poster: posterUrl,\n   300\t    enc: true, alg: 'AES-GCM', // chaque part est chiffrée (iv par part ci-dessus) ; poster = clair (voir plus haut)\n   301\t    ...(isPriv ? { private: true } : {}),\n   302\t  }\n   303\t  const manifestPath = `${dest}/${base}.${path.basename(file).split('.').pop().toLowerCase()}.media.json`\n   304\t  await rm(outDir, { recursive: true, force: true }).catch(() => {})\n   305\t  return { manifestPath, manifest, posterUrl }\n   306\t}\n   307\t\n   308\t// ── INGESTION D'UN FICHIER QUELCONQUE (blob brut) ──────────────────────────────────────────────────────\n   309\t// Pour les fichiers NON ouvrables directement sur le site (wav, py, cube, zip, …) : on découpe le fichier\n   310\t// ORIGINAL en parts de 95 Mo (aucune transformation), on les pousse via le ctx shard, et on renvoie un\n   311\t// manifeste .file.json (type 'blob-raw'). Le téléchargement recolle les parts dans l'ordre = fichier BIT À BIT\n   312\t// identique (offsets cumulés + tailles + empreinte par part). Aucune perte. URLs raw.github pinnées sur commit.\n   313\texport async function ingestBlobRaw(file, { dest, base, vctx, log = noop }) {\n   314\t  const total = (await stat(file)).size\n   315\t  const nParts = Math.ceil(total / PART) || 1\n   316\t  log(`${base} — ${(total / 1048576).toFixed(1)} Mo, ${nParts} part(s) de 95 Mo (fichier brut, aucune transformation)`)\n   317\t  const parts = []\n   318\t  const fd = await open(file, 'r')\n   319\t  const b = Buffer.alloc(PART)\n   320\t  try {\n   321\t    let off = 0, idx = 0\n   322\t    while (off < total) {\n   323\t      const { bytesRead } = await fd.read(b, 0, PART, off)\n   324\t      if (!bytesRead) break\n   325\t      const slice = Buffer.from(b.subarray(0, bytesRead))\n   326\t      const h = sha256(slice); const hp = partPathFor(h)\n   327\t      const repo = await vctx.writePart(hp, slice)\n   328\t      parts.push({ idx, repo, path: hp, hash: h, size: bytesRead })\n   329\t      off += bytesRead; idx++\n   330\t    }\n-- IMAGE CTX + INGEST --\n     1\t// img-ingest.mjs — SIDECAR Node d'ingestion IMAGE en masse (choix A1 : sidecar pur, PAS de navigateur headless).\n     2\t//\n     3\t// EN CLAIR : quand le script d'archive en masse (archive-folder.mjs) croise une IMAGE, il NE doit PLUS la\n     4\t// découper en morceaux binaires opaques (.file.json). Une image, on sait l'afficher tout de suite. Ce module\n     5\t// reproduit en Node EXACTEMENT le pipeline image de l'app :\n     6\t//   1. chiffre l'image (AES-256-GCM, clé maître, IV déterministe = dédup) ;\n     7\t//   2. la pousse CHIFFRÉE sur un shard PUBLIC zenray-img-public-NN (servi par jsDelivr) ;\n     8\t//   3. fabrique une VRAIE vignette .webp (ffmpeg), chiffrée elle aussi ;\n     9\t//   4. rend un manifeste .img.json IDENTIQUE au schéma in-app (buildPublicImgManifest).\n    10\t// Résultat : l'image archivée s'ouvre inline dans Create, avec sa vignette, ZÉRO réassemblage.\n    11\t//\n    12\t// POURQUOI A1 (sidecar) ET PAS A2 (navigateur headless rejouant captureImage) : zéro dépendance lourde,\n    13\t// zéro risque, diff borné. Coût assumé : garder ce fichier synchrone du schéma .img.json. Si la logique\n    14\t// image diverge un jour, réévaluer A2 (noté, pas fait). Réutilise la lib CANONIQUE Scripts/lib/img-pipeline.mjs.\n    15\t//\n    16\t// CONTRAINTE DURE (héritée du modèle projet) : push par GIT (transport hors quota REST), cap dur < 5 Go/shard\n    17\t// avec rollover, jamais de token committé, public par défaut (P0 anti-fuite : chemins = hash, aucun nom humain).\n    18\t\n    19\timport { readFile, writeFile, mkdir, rm, stat } from 'node:fs/promises'\n    20\timport { spawnSync, execFileSync } from 'node:child_process'\n    21\timport path from 'node:path'\n    22\timport { existsSync, readFileSync } from 'node:fs'\n    23\timport {\n    24\t  sha256Hex, ivFromHash, encryptDeterministic, loadMasterKey,\n    25\t  shardPathFor, shardChunkPathFor, splitIntoChunks, PUBLIC_SHARD_BASE, SHARD_CAP_BYTES, shardName, jsDelivrUrl,\n    26\t  buildPublicImgManifest, GIT_ENV,\n    27\t} from './lib/img-pipeline.mjs'\n    28\t\n    29\t// OUTILS IMAGE Node : cwebp (libwebp) pour la vignette .webp ; sips (natif macOS) pour les dimensions et\n    30\t// pour décoder les formats que cwebp ne lit pas (HEIC, TIFF exotiques) en PNG intermédiaire. ffprobe reste\n    31\t// un dernier recours pour les dimensions. Tous surchargeables par env pour portabilité.\n    32\tconst CWEBP = process.env.ZR_CWEBP || '/opt/homebrew/bin/cwebp'\n    33\tconst SIPS = process.env.ZR_SIPS || '/usr/bin/sips'\n    34\tconst FFPROBE = process.env.ZR_FFPROBE || '/opt/homebrew/bin/ffprobe'\n    35\t\n    36\t// L'image est poussée TELLE QUELLE (octets d'origine chiffrés, jamais ré-encodés) : préserve la qualité,\n    37\t// garde l'idempotence par hash du clair d'origine. Seule la vignette est dérivée. Le ciphertext est ensuite\n    38\t// DÉCOUPÉ en morceaux ≤19 Mo (splitIntoChunks, lib/img-pipeline.mjs) — plus de version recompressée\n    39\t// dispPath : la reconstruction bit-exacte via jsDelivr remplace l'ancien barreau d'affichage (2026-07-07).\n    40\t\n    41\t// Mesure (w,h) : sips d'abord (natif, lit HEIC/RAW), ffprobe en repli. Best-effort : 0,0 si illisible.\n    42\tfunction imageDims(abs) {\n    43\t  try {\n    44\t    const out = execFileSync(SIPS, ['-g', 'pixelWidth', '-g', 'pixelHeight', abs], { stdio: ['ignore', 'pipe', 'ignore'], timeout: 30000 }).toString()\n    45\t    const w = (out.match(/pixelWidth:\\s*(\\d+)/) || [])[1]\n    46\t    const h = (out.match(/pixelHeight:\\s*(\\d+)/) || [])[1]\n    47\t    if (w && h) return { w: parseInt(w, 10), h: parseInt(h, 10) }\n    48\t  } catch {}\n    49\t  try {\n    50\t    const out = execFileSync(FFPROBE, ['-v', 'error', '-select_streams', 'v:0', '-show_entries', 'stream=width,height', '-of', 'csv=p=0:s=x', abs], { stdio: ['ignore', 'pipe', 'ignore'], timeout: 30000 }).toString().trim()\n    51\t    const m = out.match(/(\\d+)x(\\d+)/)\n    52\t    if (m) return { w: parseInt(m[1], 10), h: parseInt(m[2], 10) }\n    53\t  } catch {}\n    54\t  return { w: 0, h: 0 }\n    55\t}\n    56\t\n    57\t// Vignette .webp (≤384px de large, ratio préservé), comme makeThumbWebp côté app. cwebp -resize W 0 garde\n    58\t// le ratio (0 = auto). Si cwebp ne lit pas le format (HEIC/exotique), on passe par sips -> PNG temp d'abord.\n    59\t// Renvoie un Buffer webp, ou null si échec (vignette optionnelle : un échec ne casse jamais l'ingestion).\n    60\tfunction makeThumbWebp(abs, work) {\n    61\t  const tryCwebp = (src) => {\n    62\t    try {\n    63\t      const out = execFileSync(CWEBP, ['-quiet', '-q', '72', '-resize', '384', '0', src, '-o', '-'], { stdio: ['ignore', 'pipe', 'ignore'], timeout: 60000, maxBuffer: 1 << 26 })\n    64\t      return out && out.length ? out : null\n    65\t    } catch { return null }\n    66\t  }\n    67\t  // 0) PRIORITÉ : ImageMagick avec -auto-orient. cwebp IGNORE l'orientation EXIF -> les photos iPhone portrait\n    68\t  //    (EXIF RightTop/orientation 6/8) donnaient une VIGNETTE couchée alors que l'original s'affiche droit.\n    69\t  //    -auto-orient cuit la rotation dans les pixels (vignette uniquement, l'original n'est jamais touché).\n    70\t  try {\n    71\t    const out = execFileSync('magick', [abs + '[0]', '-auto-orient', '-resize', '384x', '-quality', '72', '-strip', 'webp:-'], { stdio: ['ignore', 'pipe', 'ignore'], timeout: 60000, maxBuffer: 1 << 26 })\n    72\t    if (out && out.length) return out\n    73\t  } catch {}\n    74\t  // 1) repli : cwebp direct (PNG/JPEG/TIFF/WebP) — sans correction d'orientation\n    75\t  const direct = tryCwebp(abs)\n    76\t  if (direct) return direct\n    77\t  // 2) repli : sips décode -> PNG temp -> cwebp\n    78\t  try {\n    79\t    const tmpPng = path.join(work, `thumbsrc-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 7)}.png`)\n    80\t    execFileSync(SIPS, ['-s', 'format', 'png', abs, '--out', tmpPng], { stdio: ['ignore', 'ignore', 'ignore'], timeout: 60000 })\n    81\t    const out = tryCwebp(tmpPng)\n    82\t    try { execFileSync('rm', ['-f', tmpPng]) } catch {}\n    83\t    return out\n    84\t  } catch { return null }\n    85\t}\n    86\t\n    87\t// ── CONTEXTE SHARD IMAGE PUBLIC (git push incrémental, rollover < 5 Go) ───────────────────────────────\n    88\t// Le bulk crée UN contexte partagé en début de run, le passe à chaque ingestImageBulk, puis appelle\n    89\t// flushImgShard() à la fin (push final + commit SHA pour pinner les URLs jsDelivr). Patron jumeau du shard\n    90\t// de archive-folder.mjs, mais sur la famille zenray-img-public-NN (publique, chiffrée).\n    91\texport function makeImgShardCtx({ token, owner = 'matthieuhuguet', work, repoRoot, log = console.log }) {\n    92\t  const key = loadMasterKey(repoRoot, { readFileSync })\n    93\t  if (!key) throw new Error('clé maître média introuvable (ZENRAY_MEDIA_KEY ou <repo>/.zenray-media-key) — img-ingest impossible')\n    94\t  const GENV = { ...process.env, ...GIT_ENV }\n    95\t  const cloneUrl = (repo) => `https://x-access-token:${token}@github.com/${owner}/${repo}.git`\n    96\t  const git = (dir, a, timeout = 240000) => spawnSync('git', ['-C', dir, ...a], { encoding: 'utf8', env: GENV, timeout, killSignal: 'SIGKILL' })\n    97\t\n    98\t  const ctx = {\n    99\t    token, owner, work, key, log,\n   100\t    repo: null, dir: null, bytes: 0, pending: 0,\n   101\t    commitOf: {},          // repo -> commit SHA (rempli au flush ; pour pinner jsDelivr)\n   102\t    // staged[] : { repo, hashedPath, kind:'img'|'thumb' } — info de debug seulement.\n   103\t  }\n   104\t\n   105\t  // MODÈLE 2026-07-05 (décision Matthieu, même contrat que makeVidRawShardCtx) : repo NEUF par lot,\n   106\t  // nom aléatoire zenrayshards-img-<hex12>, PUBLIC (jsDelivr exige public — seule famille publique de la\n   107\t  // convention). ZÉRO clone d'un shard existant, ZÉRO check de place distant. Le découpage au sein d'un\n   108\t  // lot géant reste anticipé par compteur LOCAL (writeBinary). Ne JAMAIS recréer un ancien nom de repo :\n   109\t  // les vieux manifestes reposent sur la redirection GitHub ancien->nouveau nom (vérifiée OK le 2026-07-05\n   110\t  // sur raw.githubusercontent.com ET jsDelivr, chemins non cachés).\n   111\t  async function openShard() {\n   112\t    const { randomBytes } = await import('node:crypto')\n   113\t    ctx.repo = `zenrayshards-img-${randomBytes(6).toString('hex')}`\n   114\t    ctx.dir = path.join(work, ctx.repo)\n   115\t    await rm(ctx.dir, { recursive: true, force: true })\n   116\t    await mkdir(ctx.dir, { recursive: true })\n   117\t    git(ctx.dir, ['init', '-q']); git(ctx.dir, ['branch', '-M', 'main'])\n   118\t    git(ctx.dir, ['config', 'user.email', 'bot@zenray']); git(ctx.dir, ['config', 'user.name', 'zenray-bot'])\n   119\t    git(ctx.dir, ['config', 'http.version', 'HTTP/1.1'])\n   120\t    await writeFile(path.join(ctx.dir, 'README.md'), '# zenrayshards (img, public)\\n\\nBinaires images chiffres AES-GCM, nommes par empreinte, servis par jsDelivr. Cle maitre hors de ce depot.\\n')\n   121\t    const cr = spawnSync('curl', ['-s', '-o', '/dev/null', '-w', '%{http_code}', '-X', 'POST', '-H', `Authorization: Bearer ${token}`, 'https://api.github.com/user/repos', '-d', JSON.stringify({ name: ctx.repo, private: false })], { encoding: 'utf8' })\n   122\t    if ((cr.stdout || '').trim() !== '201') throw new Error(`création repo ${ctx.repo}: HTTP ${(cr.stdout || '?')}`)\n   123\t    git(ctx.dir, ['add', '-A']); git(ctx.dir, ['commit', '-q', '-m', 'init'])\n   124\t    git(ctx.dir, ['remote', 'add', 'origin', cloneUrl(ctx.repo)])\n   125\t    const ps = git(ctx.dir, ['push', '-q', 'origin', 'HEAD:main'], 120000)\n   126\t    if (ps.status !== 0) throw new Error('push-init img sh