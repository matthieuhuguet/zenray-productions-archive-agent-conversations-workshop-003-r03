oad-img-list.mjs, 2026-07-11).\n    57\tif (!cand.length) { console.log('rien à uploader (tout déjà en ligne).'); process.exit(0) }\n    58\t\n    59\t// 2) upload séquentiel — MODÈLE 2026-07-05 : repo NEUF par lot (zenrayshards-vid-<hex12>, PRIVÉ),\n    60\t// zéro clone, zéro check distant. Le lot se découpe tout seul en plusieurs repos neufs si besoin\n    61\t// (compteur local anticipé avant chaque part). Chaque vidéo reste visible dès son \"✓ EN LIGNE\".\n    62\tconst vctx = makeVidRawShardCtx({ token, work: process.env.HOME + '/.zr-archive-work-vidraw', log: (...a) => console.log('   ', ...a), type: 'vid', vis: 'private' })\n    63\tawait vctx.openShard()\n    64\tlet done = 0\n    65\tfor (const c of cand) {\n    66\t  const t0 = Date.now()\n    67\t  try {\n    68\t    const base = baseOf(c.f)\n    69\t    const { manifestPath, manifest } = await ingestVideoRaw(c.f, { dest, base, vctx, workDir: '/tmp/zr_vidraw_run', log: (...a) => console.log('   ', ...a) })\n    70\t    await pushBlobs(token, DATA, [{ path: manifestPath, content: JSON.stringify(manifest), encoding: 'utf-8' }], `vidraw ${base}`, () => {})\n    71\t    done++\n    72\t    console.log(`✓ EN LIGNE [${done}/${cand.length}] ${base} · ${fmt(c.dur)} · ${manifest.parts.length} parts · ${((Date.now() - t0) / 1000).toFixed(0)}s`)\n    73\t  } catch (e) {\n    74\t    console.log(`✗ ÉCHEC ${baseOf(c.f)} : ${(e && e.message || e).toString().slice(0, 160)}`)\n    75\t  }\n    76\t}\n    77\t// NETTOYAGE (2026-07-05, question directe de Matthieu) : le clone git local du shard (potentiellement\n    78\t// plusieurs Go — un shard proche du plafond peut peser 4+ Go en clone --depth 1) n'est PLUS jamais utile\n    79\t// une fois le batch entier poussé. AVANT ce fix, il restait sur disque jusqu'au PROCHAIN lancement du\n    80\t// script (qui l'écrase avant de recloner) -> plusieurs Go qui traînent inutilement entre deux sessions.\n    81\t// Nettoyage ICI seulement (fin du batch ENTIER), jamais dans flush() : flush() est appelé une fois PAR\n    82\t// VIDÉO du lot pour figer le commit SHA -> supprimer le clone à cet endroit forcerait un reclone avant\n    83\t// chaque vidéo suivante du même lot, ce qui serait une vraie régression de performance.\n    84\tif (vctx.dir) { try { await rm(vctx.dir, { recursive: true, force: true }) } catch {} }\n    85\tconsole.log(`\\n✓✓ BATCH VIDRAW COMPLET — ${done}/${cand.length} vidéos en ligne.`)\n    86\t// BUG TROUVÉ EN PROD (2026-07-11) : sans sortie explicite, les sockets HTTPS keep-alive (fetch/undici vers\n    87\t// api.github.com) laissent le process VIVANT indéfiniment après la fin du travail -> un wrapper séquentiel\n    88\t// (`node a.mjs && node b.mjs`) ne lance jamais l'étape suivante. Voir upload-img-list.mjs pour le détail.\n    89\tprocess.exit(0)\n-- IMAGE RUNNER --\n     1\t// upload-img-list.mjs — uploade une LISTE d'images via le pipeline image (découpé en morceaux ≤19 Mo, tout\n     2\t// servi par jsDelivr, plus de raw.github pour l'original — décision Matthieu 2026-07-07).\n     3\t// Pour CHAQUE image, dans l'ORDRE, UNE PAR UNE : ingestImageBulk (chiffre + découpe + pousse morceaux +\n     4\t// vignette sur le shard) -> flush IMMÉDIAT (commit SHA connu tout de suite) -> resolveImgManifest ->\n     5\t// commit SEUL sur zenray-data -> vérif jsDelivr (thumb + morceaux) DE CETTE IMAGE -> log \"✓ EN LIGNE\".\n     6\t//\n     7\t// RÈGLE DURE (2026-07-11, demande Matthieu répétée plusieurs fois, media par media) : CHAQUE image doit\n     8\t// devenir visible dans Create DÈS qu'elle est prête, jamais après la fin du batch entier. AVANT ce fix,\n     9\t// le script ingérait TOUTES les images d'abord, flush UNE SEULE FOIS à la fin, PUIS committait TOUS les\n    10\t// manifestes d'un coup (par lots de 200), PUIS vérifiait tout d'un coup -> zéro image visible pendant\n    11\t// plusieurs minutes d'ingestion sur un gros lot, puis apparition en masse. Coût assumé du fix : UN push\n    12\t// git par image (au lieu d'un push global groupé) -> léger surcoût réseau, largement compensé par la\n    13\t// visibilité immédiate. Même patron que upload-vidraw-list.mjs (déjà correct pour les vidéos : flush interne\n    14\t// à ingestVideoRaw, manifeste committé par vidéo) — les deux scripts sont maintenant symétriques.\n    15\t//\n    16\t// RÉSILIENCE (2026-07-11, symétrique du skip déjà en place côté vidéo) : saute les images dont le manifeste\n    17\t// existe déjà sur zenray-data (relance sûre après interruption, jamais de tuile en double) ; un échec sur\n    18\t// UNE image ne casse plus tout le batch (log + continue), comme le fait déjà upload-vidraw-list.mjs.\n    19\t//\n    20\t// Usage : GITHUB_TOKEN=.. node scripts/upload-img-list.mjs \"<dest>\" \"<img1>\" \"<img2>\" ...\n    21\t\n    22\timport { makeImgShardCtx, ingestImageBulk, resolveImgManifest } from './img-ingest.mjs'\n    23\timport { jsDelivrUrl } from './lib/img-pipeline.mjs'\n    24\timport { pushBlobs } from './video-mse-lib.mjs'\n    25\timport path from 'node:path'\n    26\timport { stat } from 'node:fs/promises'\n    27\t\n    28\tconst token = process.env.GITHUB_TOKEN\n    29\tconst OWNER = process.env.CONTENT_OWNER || 'matthieuhuguet'\n    30\tconst REPO = '/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress'\n    31\tconst DATA = 'zenray-data'\n    32\tconst dest = process.argv[2]\n    33\tconst files = process.argv.slice(3)\n    34\tif (!token || !dest || !files.length) { console.error('usage: GITHUB_TOKEN=.. node upload-img-list.mjs <dest> <img...>'); process.exit(1) }\n    35\t\n    36\tconst manifestPathOf = (rel) => `${dest}/${rel}.img.json`\n    37\t// déjà en ligne ? (manifeste .img.json présent sur zenray-data). RETRIES réseau, même patron que\n    38\t// upload-vidraw-list.mjs : un timeout transitoire au démarrage ne doit pas faire sauter une image à tort.\n    39\tasync function alreadyOnline(rel) {\n    40\t  const p = manifestPathOf(rel)\n    41\t  for (let a = 0; a < 4; a++) {\n    42\t    try {\n    43\t      const r = await fetch(`https://api.github.com/repos/${OWNER}/${DATA}/contents/${encodeURIComponent(p).replace(/%2F/g, '/')}`, { headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zr' } })\n    44\t      return r.status === 200\n    45\t    } catch (e) { if (a === 3) { console.log(`  ⚠ réseau (alreadyOnline), on suppose absent: ${rel}`); return false } await new Promise((r) => setTimeout(r, 4000 * (a + 1))) }\n    46\t  }\n    47\t  return false\n    48\t}\n    49\t// Vérifie une URL jsDelivr avec retries courts (propagation CDN juste après un push tout frais).\n    50\tasync function checkUrl200(url, tries = 4, delayMs = 1500) {\n    51\t  let code = 0\n    52\t  for (let a = 0; a < tries && code !== 200; a++) { try { code = (await fetch(url)).status } catch {} ; if (code !== 200) await new Promise((r) => setTimeout(r, delayMs)) }\n    53\t  return code === 200\n    54\t}\n    55\t\n    56\tconsole.log(`\\n=== UPLOAD ${files.length} image(s) -> ${dest} ===`)\n    57\t// 1) filtrer (skip déjà en ligne), même logique que upload-vidraw-list.mjs.\n    58\tconst cand = []\n    59\tfor (const f of files) {\n    60\t  const rel = path.basename(f)\n    61\t  if (await alreadyOnline(rel)) { console.log(`  ⏭  déjà en ligne, sauté: ${rel}`); continue }\n    62\t  cand.push({ f, rel })\n    63\t}\n    64\tconsole.log(`=== À UPLOADER : ${cand.length} image(s) ===\\n`)\n    65\t// Rien à faire -> ne PAS créer de repo GitHub vide pour rien (bug annexe repéré 2026-07-11 en testant\n    66\t// le skip \"déjà en ligne\" : sans cette garde, un relancement où tout est déjà en ligne crée quand même\n    67\t// un repo zenrayshards-img-<hex> flambant neuf, jamais utilisé).\n    68\tif (!cand.length) { console.log('rien à uploader (tout déjà en ligne).'); process.exit(0) }\n    69\t\n    70\t// MODÈLE 2026-07-05 : repo image NEUF par lot (zenrayshards-img-<hex12>, public jsDelivr), zéro clone,\n    71\t// zéro check distant. Plus de ZR_START_SHARD : le nom est aléatoire, rien à chercher.\n    72\tconst ctx = makeImgShardCtx({\n    73\t  token,\n    74\t  work: process.env.HOME + '/.zr-archive-work-img',\n    75\t  repoRoot: REPO,\n    76\t  log: (...a) => console.log('   ', ...a),\n    77\t})\n    78\tawait ctx.openShard()\n    79\t\n    80\tlet done = 0, failed = 0, okThumb = 0, okChunks = 0, totalChunks = 0\n    81\tfor (const c of cand) {\n    82\t  const { f, rel } = c\n    83\t  try {\n    84\t    const sizeMo = ((await stat(f)).size / 1048576).toFixed(1)\n    85\t    const pending = await ingestImageBulk(f, rel, dest, ctx)\n    86\t    // Flush + résolution + commit DE CETTE SEULE image (voir bandeau d'en-tête) : jamais d'attente pour les suivantes.\n    87\t    await ctx.flush()\n    88\t    const sb = resolveImgManifest(pending, ctx)\n    89\t    await pushBlobs(token, DATA, [sb], `img ${rel}`, () => {})\n    90\t    const m = JSON.parse(sb.content)\n    91\t\n    92\t    let thumbOk = !m.thumb\n    93\t    if (m.thumb) { thumbOk = await checkUrl200(m.thumb); if (thumbOk) okThumb++ }\n    94\t    const chunks = Array.isArray(m.cdnChunks) ? m.cdnChunks : []\n    95\t    totalChunks += chunks.length\n    96\t    let chunksOk = 0\n    97\t    for (let i = 0; i < chunks.length; i++) {\n    98\t      const ok = await checkUrl200(jsDelivrUrl(OWNER, m.cdnRepo, m.cdnCommit, chunks[i]))\n    99\t      if (ok) { chunksOk++; okChunks++ } else console.log(`     ✗ morceau ${i + 1}/${chunks.length} jsDelivr non-200`)\n   100\t    }\n   101\t    done++\n   102\t    const allOk = thumbOk && chunksOk === chunks.length\n   103\t    console.log(`✓ EN LIGNE [${done}/${cand.length}] ${rel} (${sizeMo} Mo) · ${chunksOk}/${chunks.length} morceau(x)${m.thumb ? ' + vignette' : ''} jsDelivr ${allOk ? '✅' : '⚠ (cache lag, réessaie au refresh)'}`)\n   104\t  } catch (e) {\n   105\t    failed++\n   106\t    console.log(`✗ ÉCHEC ${rel} : ${(e && e.message || e).toString().slice(0, 160)}`)\n   107\t  }\n   108\t}\n   109\tconsole.log(`\\n✓✓ BATCH IMG COMPLET — ${done}/${cand.length} images en ligne${failed ? `, ${failed} échec(s)` : ''}, ${okThumb}/${done || 1} vignettes jsDelivr 200, ${okChunks}/${totalChunks} morceaux jsDelivr 200.`)\n   110\t// BUG TROUVÉ EN PROD (2026-07-11, run DJI 76 Go) : sans sortie explicite, le process reste VIVANT après la fin\n   111\t// du travail — les sockets HTTPS keep-alive ouverts par fetch() (undici) vers jsDelivr/api.github.com ne se\n   112\t// referment jamais tout seuls, donc Node ne vide jamais sa boucle d'événements. Un wrapper séquentiel\n   113\t// (`node a.mjs && node b.mjs`) reste alors bloqué INDÉFINIMENT sur cette ligne, sans jamais lancer l'étape\n   114\t// suivante — repéré après 9 min d'immobilité totale pendant que 3 lots vidéo (~75 Go) attendaient derrière.\n   115\tprocess.exit(0)\n-- YOUTUBE LIB --\n     1\t// youtubeLink.js — création de nœuds .media.json {type:'youtube'} à partir de liens YouTube (non répertoriés\n     2\t// ou publics). Décision de Matthieu (2026-07-02) : ses futurs clips (notamment DJI) passeront directement par\n     3\t// YouTube en non-répertorié plutôt que par le pipeline ZenRayShards — YouTube s'occupe déjà du transcodage\n     4\t// adaptatif et de l'hébergement du streaming, ZenRay n'a donc plus qu'à RÉFÉRENCER le lien : zéro octet stocké\n     5\t// côté ZenRayShards, zéro upload, zéro transcodage local, zéro coût de shard.\n     6\t//\n     7\t// ARCHITECTURE (la partie « par rapport à l'existant ») : le nœud reste un .media.json ORDINAIRE, PAS un\n     8\t// nouveau type de fichier. C'est le même contrat que les 3 variantes vidéo déjà en place (video-raw / dash /\n     9\t// hls legacy), juste un 4e discriminant `type:'youtube'`. Conséquence directe : la tuile Finder\n    10\t// (VideoMediaTile), la page de partage publique (/watch), et les commentaires par vidéo fonctionnent TOUS\n    11\t// SANS AUCUN changement — ils lisent déjà un .media.json générique par son `type`. Inventer une nouvelle\n    12\t// extension (.youtube.json) aurait dupliqué tout ce dispatch pour un gain nul.\n    13\timport { parseYouTube } from '../ref/embed.js'\n    14\timport { saveJson } from '../ref/content.js'\n    15\t\n    16\tconst sanitize = (s = '') => (s || 'video').replace(/[/\\\\]/g, '_').replace(/[^\\w.\\- ]+/g, '').trim().slice(0, 80) || 'video'\n    17\tconst rand = () => Math.random().toString(36).slice(2, 8)\n    18\t\n    19\t// oEmbed YouTube : endpoint PUBLIC, sans clé API, CORS ouvert -> titre + auteur (nom de chaîne) + vignette.\n    20\t// Best-effort : si ça échoue (vidéo privée/supprimée, réseau), on retombe sur des valeurs dérivées de l'ID —\n    21\t// jamais un échec bloquant, la vidéo reste utilisable avec un titre générique (le vrai titre reste éditable\n    22\t// dans le lecteur, comme pour n'importe quelle autre vidéo).\n    23\tasync function fetchOEmbed(url) {\n    24\t  try {\n    25\t    const r = await fetch(`https://www.youtube.com/oembed?url=${encodeURIComponent(url)}&format=json`)\n    26\t    if (!r.ok) return null\n    27\t    return await r.json()\n    28\t  } catch { return null }\n    29\t}\n    30\t\n    31\t// Construit le manifest .media.json {type:'youtube'} pour UNE vidéo. Ne fait AUCUNE écriture (pur, testable).\n    32\t// NB durée : l'oEmbed YouTube ne fournit pas la durée (limitation connue de l'API officielle sans clé) ->\n    33\t// duration:0, donc pas de badge durée sur la tuile Finder pour ces vidéos. Acceptable (cosmétique mineur) ;\n    34\t// on évite ainsi d'exiger une clé API YouTube Data v3 juste pour ce détail.\n    35\t// `opts.audioOnly` (2026-07-04) : Matthieu reposte aussi des pistes AUDIO sur YouTube (non répertorié) plutôt\n    36\t// que de les stocker dans ZenRayShards. Même manifest {type:'youtube'}, juste un discriminant en plus —\n    37\t// AUCUN nouveau type, AUCUN nouveau dispatch ailleurs (tuile/lecteur/partage) : ils lisent déjà `m.type` et le\n    38\t// lecteur (VideoPlayer2) regarde `manifest.audioOnly` pour choisir sa mise en page (widget compact vs 16:9).\n    39\texport async function buildYoutubeManifest(rawUrl, opts = {}) {\n    40\t  const parsed = parseYouTube(rawUrl)\n    41\t  if (!parsed) return null\n    42\t  const { providerId: videoId, start } = parsed\n    43\t  const canonicalUrl = `https://youtu.be/${videoId}`\n    44\t  const oembed = await fetchOEmbed(canonicalUrl)\n    45\t  return {\n    46\t    type: 'youtube', v: 1,\n    47\t    videoId, url: canonicalUrl, start: start || 0,\n    48\t    name: (oembed && oembed.title) || videoId,\n    49\t    title: (oembed && oembed.title) || videoId,\n    50\t    author: (oembed && oembed.author_name) || 'YouTube',\n    51\t    poster: `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`,\n    52\t    mime: 'video/youtube',\n    53\t    duration: 0,\n    54\t    addedAt: new Date().toISOString(),\n    55\t    ...(opts && opts.audioOnly ? { audioOnly: true } : {}),\n    56\t  }\n    57\t}\n    58\t\n    59\t// Crée le nœud .media.json dans `folder`. Renvoie {ok, name, nodePath} ou {ok:false, error, url}.\n    60\texport async function createYoutubeLinkNode(rawUrl, folder, opts = {}) {\n    61\t  const m = await buildYoutubeManifest(rawUrl, opts)\n    62\t  if (!m) return { ok: false, error: 'lien YouTube non reconnu', url: rawUrl }\n    63\t  const dest = String(folder || 'pages').replace(/\\/$/, '')\n    64\t  const nodePath = `${dest}/${sanitize(m.name)}.${rand()}.media.json`\n    65\t  const res = await saveJson(nodePath, m)\n    66\t  if (!res.ok) return { ok: false, error: res.error || \"échec d'écriture\", url: rawUrl }\n    67\t  return { ok: true, name: m.name, nodePath }\n    68\t}\n    69\t\n    70\t// BATCH (Matthieu : « je te donnerai les batchs de liens à l'avenir ») : un lien par ligne. Séquentiel (pas de\n    71\t// parallélisme ici : oEmbed + save par vidéo est déjà rapide, et ça évite de bombarder l'API oEmbed publique).\n    72\t// `opts.audioOnly` propagé tel quel à chaque nœud du lot (un batch = un seul mode, audio OU vidéo).\n    73\texport async function createYoutubeLinkNodesBatch(text, folder, onProgress, opts = {}) {\n    74\t  const urls = String(text || '').split('\\n').map((s) => s.trim()).filter(Boolean)\n    75\t  const results = []\n    76\t  for (let i = 0; i < urls.length; i++) {\n    77\t    results.push(await createYoutubeLinkNode(urls[i], folder, opts))\n    78\t    onProgress && onProgress((i + 1) / urls.length)\n    79\t  }\n    80\t  // Index de recherche : même geste que captureFiles (1 commit pour tout le lot, best-effort).\n    81\t  const nodePaths = results.filter((r) => r.ok).map((r) => r.nodePath)\n    82\t  if (nodePaths.length) {\n    83\t    try { await fetch('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'index-add', paths: nodePaths }) }) } catch {}\n    84\t  }\n    85\t  return results\n    86\t}\n-- FILE KINDS --\n     1\t// fileKinds.js — SOURCE UNIQUE extension -> MIME -> catégorie d'aperçu. Isomorphe (aucune dépendance navigateur),\n     2\t// importé À LA FOIS par l'UPLOAD (Scripts/video-raw-lib.mjs mimeOf) ET par le VIEWER (QuickLook). Une seule vérité :\n     3\t// un futur upload et son aperçu ne peuvent JAMAIS diverger sur le type. Étendre ICI = couvrir upload + lecture d'un coup.\n     4\t\n     5\t// MIME par extension (minuscule, sans le point). Exhaustif sur les formats populaires.\n     6\texport const MIME_BY_EXT = {\n     7\t  // audio\n     8\t  wav: 'audio/wav', mp3: 'audio/mpeg', m4a: 'audio/mp4', flac: 'audio/flac', ogg: 'audio/ogg', oga: 'audio/ogg',\n     9\t  aac: 'audio/aac', aiff: 'audio/aiff', aif: 'audio/aiff', opus: 'audio/opus', wma: 'audio/x-ms-wma', weba: 'audio/webm',\n    10\t  // vidéo\n    11\t  mp4: 'video/mp4', m4v: 'video/mp4', mov: 'video/quicktime', webm: 'video/webm', mkv: 'video/x-matroska',\n    12\t  avi: 'video/x-msvideo', flv: 'video/x-flv', wmv: 'video/x-ms-wmv', mpg: 'video/mpeg', mpeg: 'video/mpeg', '3gp': 'video/3gpp',\n    13\t  // image\n    14\t  jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', gif: 'image/gif', webp: 'image/webp', avif: 'image/avif',\n    15\t  bmp: 'image/bmp', svg: 'image/svg+xml', ico: 'image/x-icon', jfif: 'image/jpeg', heic: 'image/heic', heif: 'image/heif',\n    16\t  tif: 'image/tiff', tiff: 'image/tiff', dng: 'image/x-adobe-dng', psd: 'image/vnd.adobe.photoshop',\n    17\t  // documents\n    18\t  pdf: 'application/pdf', epub: 'application/epub+zip', rtf: 'application/rtf',\n    19\t  doc: 'application/msword', docx: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',\n    20\t  xls: 'application/vnd.ms-excel', xlsx: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',\n    21\t  ppt: 'application/vnd.ms-powerpoint', pptx: 'application/vnd.openxmlformats-officedocument.presentationml.presentation',\n    22\t  // texte\n    23\t  txt: 'text/plain', md: 'text/markdown', markdown: 'text/markdown', csv: 'text/csv', tsv: 'text/tab-separated-values',\n    24\t  log: 'text/plain', rtf_: 'text/plain',\n    25\t  // code (servi en text/plain pour aperçu <pre>, langage gardé à part)\n    26\t  js: 'text/javascript', mjs: 'text/javascript', cjs: 'text/javascript', ts: 'text/plain', tsx: 'text/plain', jsx: 'text/plain',\n    27\t  py: 'text/x-python', rb: 'text/x-ruby', php: 'text/x-php', java: 'text/x-java', c: 'text/x-c', h: 'text/x-c',\n    28\t  cpp: 'text/x-c++', cc: 'text/x-c++', hpp: 'text/x-c++', cs: 'text/x-csharp', go: 'text/x-go', rs: 'text/x-rust',\n    29\t  swift: 'text/x-swift', kt: 'text/x-kotlin', scala: 'text/x-scala', sh: 'text/x-sh', bash: 'text/x-sh', zsh: 'text/x-sh',\n    30\t  lua: 'text/x-lua', r: 'text/x-r', sql: 'text/x-sql', html: 'text/html', htm: 'text/html', css: 'text/css',\n    31\t  scss: 'text/x-scss', json: 'application/json', yaml: 'text/yaml', yml: 'text/yaml', toml: 'text/x-toml',\n    32\t  xml: 'text/xml', ini: 'text/p