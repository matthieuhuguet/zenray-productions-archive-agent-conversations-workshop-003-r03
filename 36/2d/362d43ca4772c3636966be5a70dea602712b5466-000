}\n   252\t\n   253\t// BACKFILL VIGNETTE SEULE : régénère uniquement la .webp (auto-orientée) + la rechiffre + la pousse, sans toucher\n   254\t// à l'original ni au reste du manifeste. Renvoie { repo, thumbPath, thumbIv } ; l'URL jsDelivr est résolue après\n   255\t// flush (commit connu). Sert à corriger les vignettes iPhone couchées (EXIF) déjà en ligne. L'ORIGINAL est intact.\n   256\texport async function regenThumbOnly(absPath, ctx) {\n   257\t  if (!ctx.dir) await ctx.openShard()\n   258\t  const thumbBuf = makeThumbWebp(absPath, ctx.work)\n   259\t  if (!thumbBuf) return null\n   260\t  const tHash = sha256Hex(thumbBuf)\n   261\t  const enc = encryptDeterministic(thumbBuf, ctx.key, tHash)\n   262\t  const thumbPath = shardPathFor(tHash, 'webp')\n   263\t  const repo = await ctx.writeBinary(thumbPath, enc.cipher)\n   264\t  return { repo, thumbPath, thumbIv: enc.iv }\n   265\t}\n   266\texport const thumbUrlForRegen = (ctx, repo, thumbPath) => jsDelivrUrl(ctx.owner, repo, ctx.commitOf[repo], thumbPath)\n-- PUSH BLOBS IMPLEMENTATION --\n   275\t        const txt = (await res.text()).slice(0, 300)\n   276\t        if (res.status < 500 && res.status !== 429) throw new Error(`GitHub ${method} ${repo}/${urlPath} -> ${res.status} ${txt}`)\n   277\t        last = new Error(`GitHub ${method} ${repo}/${urlPath} -> ${res.status} ${txt}`)\n   278\t      } catch (e) { last = e; if (e.message && /-> [1-4]\\d\\d /.test(e.message)) throw e } // 4xx (sauf 429) = définitif\n   279\t      if (attempt < 4) await new Promise((r) => setTimeout(r, 1500 * (attempt + 1)))\n   280\t    }\n   281\t    throw last\n   282\t  }\n   283\t}\n   284\t\n   285\t// Pousse une liste de blobs sur un repo via Git Data API SÛRE (base_tree + commit + ref force:false).\n   286\t// blobs = [{ path, content(base64), encoding }]. Réessaie le PATCH de ref si HEAD a bougé (non-fast-forward).\n   287\t// Exporté pour réutilisation par video-hls-lib.mjs.\n   288\texport async function pushBlobs(token, re