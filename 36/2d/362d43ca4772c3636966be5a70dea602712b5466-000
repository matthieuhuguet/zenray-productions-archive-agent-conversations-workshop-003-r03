unction saveJson(path, data, sha) {\n    25\t  const markdown = JSON.stringify(data, null, 2)\n    26\t  const r = await fetch('/api/page', {\n    27\t    method: 'POST', headers: { 'content-type': 'application/json' },\n    28\t    body: JSON.stringify({ action: 'save', path, markdown, sha: sha || undefined }),\n    29\t  }).then((x) => x.json()).catch(() => null)\n    30\t  if (!r) return { ok: false, error: 'network' }\n    31\t  if (r.error === 'conflict') return { ok: false, conflict: true }\n    32\t  if (r.error) return { ok: false, error: r.error, detail: r.detail }\n    33\t  return { ok: true, sha: r.sha }\n    34\t}\n    35\t\n    36\t// Sauve un fichier markdown (page projet .md). Même contrat que saveJson.\n    37\texport async function saveText(path, text, sha) {\n    38\t  const r = await fetch('/api/page', {\n    39\t    method: 'POST', headers: { 'content-type': 'application/json' },\n    40\t    body: JSON.stringify({ action: 'save', path, markdown: text || '', sha: sha || undefined }),\n    41\t  }).then((x) => x.json()).catch(() => null)\n    42\t  if (!r) return { ok: false, error: 'network' }\n    43\t  if (r.error === 'conflict') return { ok: false, conflict: true }\n    44\t  if (r.error) return { ok: false, error: r.error, detail: r.detail }\n    45\t  return { ok: true, sha: r.sha }\n    46\t}\n    47\t\n    48\t// Enfants directs d'un dossier (Contents API, non récursif, scalable). Renvoie [{ name, path, type }].\n    49\texport async function listChildren(dir) {\n    50\t  const r = await fetch(`/api/page?action=children&dir=${encodeURIComponent(dir)}`, { cache: 'no-store' })\n    51\t    .then((x) => x.json()).catch(() => null)\n    52\t  return (r && Array.isArray(r.entries)) ? r.entries : []\n    53\t}\n-- VIDEO SHARD / INGEST --\n     1\t// video-raw-lib.mjs — VIDÉO SANS RÉENCODAGE (« chunks bruts »).\n     2\t//\n     3\t// PRINCIPE (validé 2026-06-30, remplace le DASH+HEVC trop lent) : le fichier vidéo ORIGINAL est découpé par\n     4\t// TAILLE en parts de 95 Mo (sûr sous la limite 100 Mo de raw.githubusercontent.com), poussées telles quelles\n     5\t// sur un repo public, et servies par raw.github. AUCUN ffmpeg de transcodage : juste un ffprobe (métadonnées)\n     6\t// + 1 frame poster. Qualité = source, débit = source. Upload = temps réseau seul, zéro CPU. Coût = 0.\n     7\t//\n     8\t// LECTURE côté site : Service Worker « range-shim » (P2) — le <video> natif lit une URL virtuelle, le SW\n     9\t// traduit les requêtes Range en fetch des bonnes parts. HEVC décodé par l'OS (pas les limites MSE de Chrome).\n    10\t//\n    11\t// POURQUOI raw.github et pas jsDelivr pour la vidéo : raw.github accepte 100 Mo/fichier (jsDelivr 20). On est\n    12\t// peu de requêtes (1 spectateur) donc pas de throttle. Les IMAGES, elles, restent sur jsDelivr (CDN, gère les\n    13\t// galeries 10k requêtes ; raw.github throttle les bursts).\n    14\t\n    15\timport { open, mkdir, writeFile, readFile, rm, stat } from 'node:fs/promises'\n    16\timport { existsSync, readFileSync } from 'node:fs'\n    17\timport { execFile, spawnSync } from 'node:child_process'\n    18\timport { createHash, createCipheriv, randomBytes } from 'node:crypto'\n    19\timport path from 'node:path'\n    20\timport { fileURLToPath } from 'node:url'\n    21\timport { promisify } from 'node:util'\n    22\timport { mimeForName } from '../src/lib/fileKinds.js'\n    23\timport { loadMasterKey } from './lib/img-pipeline.mjs'\n    24\tconst execFileP = promisify(execFile)\n    25\t\n    26\tconst OWNER = process.env.CONTENT_OWNER || 'matthieuhuguet'\n    27\tconst PART = 95 * 1024 * 1024            // 95 Mo : marge sûre sous la limite 100 Mo de GitHub/raw.github\n    28\tconst SHARD_CAP = 4.0 * 1024 * 1024 * 1024 // découpage interne d'un LOT en plusieurs repos neufs (compteur LOCAL uniquement, jamais de lecture distante) — marge sûre sous la recommandation 5 Go GitHub\n    29\tconst noop = () => {}\n    30\tconst sleep = (ms) => new Promise((r) => setTimeout(r, ms))\n    31\tconst sha256 = (buf) => createHash('sha256').update(buf).digest('hex')\n    32\t// chemin d'adresse de contenu : ab/cd/<hash>.bin (dédup + arbo équilibrée)\n    33\tconst partPathFor = (h) => `${h.slice(0, 2)}/${h.slice(2, 4)}/${h}.bin`\n    34\tconst rawUrl = (repo, sha, p) => `https://raw.githubusercontent.com/${OWNER}/${repo}/${sha}/${p}`\n    35\t// mimeOf : SOURCE UNIQUE partagée avec le viewer (src/lib/fileKinds.js). Garantit que tout futur upload stocke\n    36\t// le MÊME mime que celui attendu par l'aperçu -> aucune divergence possible. Défaut application/octet-stream.\n    37\tconst mimeOf = (f) => mimeForName(path.basename(f))\n    38\t\n    39\t// ── CHIFFREMENT DES PARTS (2026-07-05) ────────────────────────────────────────────────────────────────\n    40\t// AES-256-GCM, IV aléatoire 12o PAR part, MÊME clé maître que le reste de l'app (chunked-media audio/PDF,\n    41\t// images privées — server/media-key.js, src/media/crypto.js) : un seul modèle de sécurité, une seule clé.\n    42\t// Le repo reste PUBLIC (raw.github), mais son contenu est illisible sans la clé -> \"public + chiffré\".\n    43\t// Le nom de la part sur disque est dérivé du hash du CIPHERTEXT (pas du clair) : le clair d'une part est\n    44\t// chiffré avec un IV aléatoire à chaque tentative, donc jamais déterministe -> hash-du-clair ne peut plus\n    45\t// servir d'adresse de contenu stable (une 2e tentative après crash donnerait un ciphertext différent pour\n    46\t// le même chemin, et écraserait un manifest antérieur dont l'IV ne correspondrait plus aux octets réels).\n    47\t// Hash du ciphertext = toujours unique par chiffrement -> jamais de collision, retry après crash sûr.\n    48\t// Coût : perte du dédup inter-vidéos par contenu identique (négligeable, deux vidéos distinctes ne\n    49\t// partagent jamais de chunk 95 Mo aligné identique en pratique). Le POSTER reste EN CLAIR (affiché en\n    50\t// <img src> direct dans le Finder, un décodage async pour une simple miniature serait disproportionné).\n    51\tconst REPO_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')\n    52\tlet _mediaKey = null\n    53\tfunction mediaKey() { if (!_mediaKey) _mediaKey = loadMasterKey(REPO_ROOT, { readFileSync }); return _mediaKey }\n    54\tfunction encryptPart(buf) {\n    55\t  const iv = randomBytes(12)\n    56\t  const c = createCipheriv('aes-256-gcm', mediaKey(), iv)\n    57\t  const cipher = Buffer.concat([c.update(buf), c.final(), c.getAuthTag()])\n    58\t  return { cipher, iv: iv.toString('base64') }\n    59\t}\n    60\t\n    61\tasync function probe(file) {\n    62\t  try {\n    63\t    const { stdout } = await execFileP('ffprobe', ['-v', 'error', '-select_streams', 'v:0', '-show_entries', 'stream=width,height,codec_name', '-show_entries', 'format=duration', '-of', 'json', file], { timeout: 30000 })\n    64\t    const j = JSON.parse(stdout); const s = (j.streams && j.streams[0]) || {}\n    65\t    return { width: +s.width || 0, height: +s.height || 0, codec: s.codec_name || '', duration: +((j.format && j.format.duration) || 0) || 0 }\n    66\t  } catch { return { width: 0, height: 0, codec: '', duration: 0 } }\n    67\t}\n    68\t// FASTSTART : l'index (atome 'moov') doit être AU DÉBUT pour que la lecture démarre avec la 1re part seulement.\n    69\t// Les fichiers caméra (DJI) mettent 'moov' à la FIN -> sans ça, le lecteur doit aussi chercher la dernière part.\n    70\t// On détecte l'ordre des atomes ; si 'moov' est après 'mdat', on remux `-c copy +faststart` (LOSSLESS, AUCUN\n    71\t// réencodage : flux vidéo/audio copiés octet pour octet, seul l'index est déplacé). Sinon on garde l'original.\n    72\tasync function isFaststart(file) {\n    73\t  const fd = await open(file, 'r'); const b = Buffer.alloc(16)\n    74\t  try {\n    75\t    let off = 0\n    76\t    for (let i = 0; i < 16; i++) {\n    77\t      const { bytesRead } = await fd.read(b, 0, 16, off); if (bytesRead < 8) return true\n    78\t      let size = b.readUInt32BE(0); const type = b.toString('latin1', 4, 8)\n    79\t      if (type === 'moov') return true          // index avant données -> faststart\n    80\t      if (type === 'mdat') return false         // données avant index -> PAS faststart\n    81\t      if (size === 1) size = Number(b.readBigUInt64BE(8)) // taille 64-bit\n    82\t      if (size < 8) return true\n    83\t      off += size\n    84\t    }\n    85\t  } finally { await fd.close() }\n    86\t  return true\n    87\t}\n    88\t// CONTENEUR NON-MP4 (mkv/avi/webm/ts/…) : isFaststart() lit des atomes façon ISO-BMFF (moov/mdat) — sur un\n    89\t// conteneur Matroska/EBML (structure binaire totalement différente), le résultat est indéfini et peut renvoyer\n    90\t// \"déjà faststart\" à tort, laissant passer un .mkv brut qu'AUCUN navigateur ne lit nativement (balise <video>\n    91\t// ne supporte pas Matroska, quel que soit le codec interne). Trouvé en pratique le 2026-07-05 avant un upload\n    92\t// réel de deux épisodes .mkv. Fix : on FORCE le remux vers .mp4 pour toute extension ≠ mp4/mov/m4v, sans même\n    93\t// appeler isFaststart() (le test n'a de sens que pour un conteneur déjà ISO-BMFF).\n    94\tconst MP4_LIKE = new Set(['mp4', 'mov', 'm4v'])\n    95\tasync function remuxFaststart(file, outDir, log, codec = '') {\n    96\t  const ext = path.extname(file).slice(1).toLowerCase()\n    97\t  const forceContainerRemux = !MP4_LIKE.has(ext)\n    98\t  if (!forceContainerRemux && await isFaststart(file)) { log('  (déjà faststart, pas de remux)'); return file }\n    99\t  if (forceContainerRemux) log(`  conteneur .${ext} non lisible nativement par <video> -> remux vers .mp4 (stream copy, aucun réencodage)`)\n   100\t  const out = path.join(outDir, 'faststart.mp4')\n   101\t  // -map v+a (on laisse tomber les pistes data propriétaires DJI, et toute piste sous-titres/audio secondaire,\n   102\t  // qui ne se muxent pas proprement en mp4) — AVERTISSEMENT : si la source a plusieurs pistes audio ou des\n   103\t  // sous-titres embarqués, seule la 1re piste vidéo + 1re piste audio survivent, tout le reste est perdu.\n   104\t  //\n   105\t  // BUG RÉEL iPhone (2026-07-05, Matthieu, iPhone 15 Pro) : sans -tag:v, ffmpeg tague le HEVC remuxé en\n   106\t  // \"hev1\" — valide côté spec MP4 mais REFUSÉ par Apple/AVFoundation (iOS/Safari exigent \"hvc1\", où les\n   107\t  // paramètres du codec sont dans l'entête et pas dans le flux). Résultat : vidéo HEVC illisible sur\n   108\t  // iPhone alors que l'appareil décode le H.265 nativement depuis des années. Reproduit puis vérifié par\n   109\t  // ffprobe sur le remux réel : sans le flag -> hev1, avec -> hvc1. RÈGLE PERMANENTE : tout remux HEVC\n   110\t  // vers MP4 porte -tag:v hvc1. (h264 n'est pas concerné, son tag avc1 par défaut est correct partout.)\n   111\t  const args = ['-y', '-i', file, '-map', '0:v:0', '-map', '0:a:0?', '-c', 'copy']\n   112\t  if (codec === 'hevc') args.push('-tag:v', 'hvc1')\n   113\t  args.push('-movflags', '+faststart', '-f', 'mp4', out)\n   114\t  await execFileP('ffmpeg', args, { timeout: 1800000, maxBuffer: 1 << 26 })\n   115\t  log(`  faststart : index déplacé au début (lossless, -c copy)${codec === 'hevc' ? ' + tag hvc1 (lecture iPhone/Apple)' : ''} -> démarrage dès la 1re part`)\n   116\t  return out\n   117\t}\n   118\t\n   119\t// poster : 1 frame (au milieu si durée connue), JPEG (ce ffmpeg n'a pas d'encodeur webp). Best-effort.\n   120\tasync function makePoster(file, outDir, atSec) {\n   121\t  const p = path.join(outDir, 'poster.jpg')\n   122\t  try { await execFileP('ffmpeg', ['-y', '-ss', String(Math.max(0, atSec || 1)), '-i', file, '-frames:v', '1', '-vf', 'scale=640:-2', '-q:v', '3', p], { timeout: 60000 }); return existsSync(p) ? p : null } catch { return null }\n   123\t}\n   124\t\n   125\t// ── CONTEXTE SHARD VIDÉO BRUTE (clone git persistant, push incrémental, rollover < 4,3 Go) ─────────────\n   126\t// Patron jumeau de makeImgShardCtx mais EN CLAIR (pas de chiffrement : la lecture <video> a besoin des octets\n   127\t// bruts) et pour la famille zenray-vidraw-NN. Le bulk crée UN ctx, le réutilise pour chaque vidéo, flush à la fin.\n   128\t// startShard (1-based) : index du PREMIER shard à ouvrir. >1 -> on saute les shards pleins existants et on\n   129\t// démarre sur un shard NEUF VIDE (création instantanée, ZÉRO clone de 4 Go). base : famille de repos (vidéo\n   130\t// brute par défaut ; réutilisable pour des blobs génériques 'zenray-blob-public').\n   131\t// ── NOUVEAU MODÈLE (2026-07-05, décision explicite de Matthieu) : REPO NEUF PAR LOT, ZÉRO CHECK ─────────\n   132\t// L'ancien modèle (réutiliser/cloner un shard existant + vérifier sa taille auprès de GitHub) est ABANDONNÉ :\n   133\t// il pouvait recloner des Go sur le disque (\"bug infini qui redl des trucs\") et brûlait de la bande passante\n   134\t// en vérifications. Nouveau contrat, définitif :\n   135\t//   1. Chaque LOT d'upload crée un repo GitHub NEUF, nom aléatoire façon workflow : zenrayshards-<type>-<hex12>.\n   136\t//   2. AUCUNE question posée à GitHub (\"reste-t-il de la place ?\") — jamais, ni avant ni pendant. GitHub\n   137\t//      accepte 100k repos, on en a ~300 : vérifier l'espace est contre-productif.\n   138\t//   3. Le découpage en plusieurs repos au sein d'UN lot géant est ANTICIPÉ localement : compteur d'octets\n   139\t//      local, AVANT d'écrire une part qui dépasserait le plafond -> on ouvre un AUTRE repo neuf (nouveau hex).\n   140\t//      Jamais de clone, jamais de pull, jamais de lecture distante.\n   141\t//   4. Visibilité ENCODÉE DANS LE NOM (convention dure, utilisée par le lecteur/le SW/le téléchargement) :\n   142\t//      zenrayshards-img-* = PUBLIC (jsDelivr exige public) ; tout autre type (vid/blob/pdf/doc/...) = PRIVÉ,\n   143\t//      lu via api.github.com (Accept: raw, token) — CORS vérifié OK le 2026-07-05 (authorization autorisé).\n   144\t//   5. Ne JAMAIS recréer un rep