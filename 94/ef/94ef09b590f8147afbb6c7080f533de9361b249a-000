und: #252525; color: #ccc; border-color: #444; }\n</style>\n</head>\n<body>\n<h1>CLAUDE / PLAN USAGE</h1>\n<div class=\"accounts\" id=\"accounts\"></div>\n\n<script>\nconst ACCOUNTS = [\n  'matth.flac@gmail.com',\n  'matth.huguet@gmail.com',\n  'mhzenray@gmail.com',\n  'matthieuhuguet.zenray@gmail.com',\n  'matthieu.huguet@outlook.com',\n  'matthoune@hotmail.fr',\n]\nconst LIMIT = 5 * 60 * 60 * 1000 // 5h en ms\n\nfunction getStart(email) {\n  const v = localStorage.getItem('cu:' + email)\n  return v ? parseInt(v) : null\n}\nfunction setStart(email) {\n  localStorage.setItem('cu:' + email, Date.now())\n}\n\nfunction fmt(ms) {\n  if (ms <= 0) return 'expired'\n  const h = Math.floor(ms / 3600000)\n  const m = Math.floor((ms % 3600000) / 60000)\n  const s = Math.floor((ms % 60000) / 1000)\n  return `${h}h ${String(m).padStart(2,'0')}m ${String(s).padStart(2,'0')}s`\n}\n\n// Build DOM\nconst container = document.getElementById('accounts')\nACCOUNTS.forEach(email => {\n  const card = document.createElement('div')\n  card.className = 'card'\n  card.id = 'card-' + email\n  card.innerHTML = `\n    <div class=\"card-top\">\n      <span class=\"email\">${email}</span>\n      <span class=\"status\" id=\"st-${email}\">—</span>\n    </div>\n    <div class=\"bar-bg\"><div class=\"bar-fill\" id=\"bar-${email}\" style=\"width:0%\"></div></div>\n    <div class=\"card-bottom\">\n      <span class=\"time-left\" id=\"tl-${email}\">no data</span>\n      <button onclick=\"reset('${email}')\">reset 5h</button>\n    </div>\n  `\n  container.appendChild(card)\n})\n\nfunction reset(email) { setStart(email); update() }\n\nfunction update() {\n  const now = Date.now()\n  ACCOUNTS.forEach(email => {\n    const start = getStart(email)\n    const bar = document.getElementById('bar-' + email)\n    const tl = document.getElementById('tl-' + email)\n    const st = document.getElementById('st-' + email)\n    if (!start) {\n      bar.style.width = '0%'; bar.className = 'bar-fill'\n      tl.textContent = 'no data'; st.textContent = '—'; st.className = 'status'\n      return\n    }\n    const elapsed = now - start\n    const remaining = LIMIT - elapsed\n    const pct = Math.min(100, (elapsed / LIMIT) * 100)\n    if (remaining <= 0) {\n      bar.style.width = '100%'; bar.className = 'bar-fill expired'\n      tl.textContent = 'available'; st.textContent = 'free'; st.className = 'status expired'\n    } else {\n      bar.style.width = pct + '%'\n      bar.className = 'bar-fill' + (pct > 75 ? ' warn' : '')\n      tl.textContent = fmt(remaining)\n      st.textContent = Math.round(pct) + '%'; st.className = 'status active'\n    }\n  })\n}\n\nupdate()\nsetInterval(update, 1000)\n</script>\n</body>\n</html>\n","userModified":false},"sourceToolAssistantUUID":"d03f1753-36e8-45b1-af10-7c5a0a7a4d33","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"3b0b9aa2-340f-49d4-babf-aa1c7a8c443d","version":"2.1.160","gitBranch":"main"}
