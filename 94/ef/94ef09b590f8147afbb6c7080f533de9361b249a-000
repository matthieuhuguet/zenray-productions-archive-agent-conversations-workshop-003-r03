0)\n  const s = Math.floor((ms % 60000) / 1000)\n  return `${h}h ${String(m).padStart(2,'0')}m ${String(s).padStart(2,'0')}s`\n}\n\nfunction todayVal() {\n  const d = new Date()\n  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`\n}\nfunction nowTimeVal() {\n  const d = new Date()\n  return `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`\n}\n\n// Send email via serverless function\nasync function sendNotify(account, type) {\n  try {\n    await fetch('/api/notify', {\n      method: 'POST',\n      headers: { 'content-type': 'application/json' },\n      body: JSON.stringify({ account, type, to: NOTIFY_EMAILS })\n    })\n  } catch {}\n}\n\n// Build DOM\nconst container = document.getElementById('accounts')\nACCOUNTS.forEach(email => {\n  const safeId = email.replace(/[@.]/g, '_')\n  const card = document.createElement('div')\n  card.className = 'card'\n  card.innerHTML = `\n    <div class=\"card-top\">\n      <span class=\"email\">${email}</span>\n      <span class=\"status\" id=\"st_${safeId}\">—</span>\n    </div>\n    <div class=\"bar-bg\"><div class=\"bar-fill\" id=\"bar_${safeId}\" style=\"width:0%\"></div></div>\n    <div class=\"card-bottom\">\n      <span class=\"time-left\" id=\"tl_${safeId}\">no data</span>\n      <div class=\"actions\">\n        <div class=\"timepicker\" id=\"tp_${safeId}\">\n          <input type=\"date\" id=\"tpd_${safeId}\" value=\"${todayVal()}\">\n          <input type=\"time\" id=\"tpt_${safeId}\" value=\"${nowTimeVal()}\">\n          <button class=\"confirm\" onclick=\"applyManual('${email}')\">ok</button>\n          <button onclick=\"closeTP('${email}')\">✕</button>\n        </div>\n        <button onclick=\"toggleTP('${email}')\">set time</button>\n        <button class=\"primary\" onclick=\"resetNow('${email}')\">reset now</button>\n      </div>\n    </div>\n  `\n  container.appendChild(card)\n})\n\nfunction safeId(email) { return email.r