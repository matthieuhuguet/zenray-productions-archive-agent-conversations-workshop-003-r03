..x, items: [...(x.items || []), it] } : x) }\n    }\n    setData(appliquer)\n    const res = await saveJsonWithRetry(path, appliquer, { sha: shaRef.current, data })\n    if (res.ok) shaRef.current = res.sha\n    else notify({ kind: 'error', label, title: 'Déplacement non enregistré', body: 'Réessaie, un conflit a empêché l’écriture.' })\n  }\n\n  // ── COPIER / COUPER / PARTAGER (2026-08-21) ───────────────────────────────────────────────────────\n  const blobOfItem = async (it) => {\n    const url = isRawUpload(it.path) ? rawUrl(it.path) : await (async () => {\n      const m = await readImgManifestCached(it.path)\n      return m ? await resolveFullUrl(m) : null\n    })()\n    if (!url) return null\n    return fetch(url).then((r) => (r.ok ? r.blob() : null)).catch(() => null)\n  }\n  const copier = async (it) => {\n    const blob = await blobOfItem(it)\n    if (!blob) return notify({ kind: 'error', label, title: 'Copie impossible', body: 'Image introuvable.' })\n    try {\n      await navigator.clipboard.write([new ClipboardItem({ [blob.type || 'image/webp']: blob })])\n      notify({ kind: 'info', label, title: 'Copié', body: it.name || 'Image copiée dans le presse-papiers.' })\n    } catch { notify({ kind: 'error', label, title: 'Copie impossible', body: 'Le navigateur a refusé l’accès au presse-papiers.' }) }\n  }\n  const couper = async (it) => { await copier(it); retirer(it.id) }\n  const partager = async (it) => {\n    const blob = await blobOfItem(it)\n    if (!blob) return notify({ kind: 'error', label, title: 'Partage impossible', body: 'Image introuvable.' })\n    const file = new File([blob], (it.name || 'image').replace(/\\.[a-z0-9]+$/i, '') + '.' + (blob.type.split('/')[1] || 'webp'), { type: blob.type })\n    if (navigator.canShare && navigator.canShare({ files: [file] })) {\n      try { await navigator.share({ files: [file], title: it.name || label }); return } catch { return } // annulé : pas d'erreur à montrer\n    }\n    // Repli desktop : seul un chemin uploads/ (posé par /api/img) a un lien PUBLIC stable. Un\n    // manifeste Create est chiffré au repos — rien à lier, seule l'image elle-même se partage.\n    if (isRawUpload(it.path)) {\n      const shareUrl = `${location.origin}${rawUrl(it.path)}`\n      try { await navigator.clipboard.writeText(shareUrl); notify({ kind: 'info', label, title: 'Lien copié', body: shareUrl }) }\n      catch { notify({ kind: 'error', label, title: 'Partage impossible', body: 'Copie du lien refusée.' }) }\n      return\n    }\n    await copier(it)\n    notify({ kind: 'info', label, title: 'Copié (partage indisponible)', body: 'Colle l’image où tu veux la partager.' })\n  }\n\n  // ── PONT VERS CREATE (2026-08-21) ─────────────────────────────────────────────────────────────────\n  // GalleryView est un module séparé (lazy-chargé) sans accès aux fermetures d'App.jsx. Plutôt que\n  // dupliquer `trashPath` (move + sidecar + retry) ou `runCapture` (tout le pipeline d'ingestion), on\n  // les rappelle via un événement écouté là-bas — même geste que `zr:open-page`. `resolve` rend\n  // l'appel attendable sans construire un vrai bus RPC ; un filet de 8 s évite de rester bloqué si\n  // personne n'écoute.\n  const dispatchAndWait = (name, detail) => new Promise((resolve) => {\n    window.dispatchEvent(new CustomEvent(name, { detail: { ...detail, resolve } }))\n    setTimeout(() => resolve(false), 8000)\n  })\n  const envoyerVersCreate = async (it) => {\n    const blob = await blobOfItem(it)\n    if (!blob) return notify({ kind: 'error', label, title: 'Envoi impossible', body: 'Image introuvable.' })\n    const file = new File([blob], (it.name || 'image').replace(/\\.[a-z0-9]+$/i, '') + '.' + (blob.type.split('/')[1] || 'webp'), { type: blob.type })\n    const ok = await dispatchAndWait('zr:gallery-send-to-create', { file })\n    if (ok) { retirer(it.id); notify({ label, title: 'Envoyé dans Create', body: it.name || '' }) }\n    else notify({ kind: 'error', label, title: 'Envoi échoué', body: 'Create n’a pas confirmé la réception.' })\n  }\n  const supprimerDeCreate = async (it) => {\n    if (!window.confirm(`Supprimer « ${it.name || 'cette image'} » de Create ? Elle ira dans Trash, récupérable.`)) return\n    const ok = await dispatchAndWait('zr:gallery-delete-from-create', { path: it.path })\n    if (ok) retirer(it.id)\n  }\n\n  // ── MENU CLIC DROIT (2026-08-21, demande Matthieu : l'ancien bouton « × » au survol était une seule\n  // option sans nom ni contexte — « pas logique »). Chaque action se montre ou se désactive selon ce\n  // qui a RÉELLEMENT un sens pour cet item précis, plutôt que d'exposer huit boutons dont la moitié ne\n  // font rien : un dossier ne se copie pas, un item posé par collage n'est « dans Create » nulle part\n  // à en retirer, un item déjà brut n'a rien à y envoyer une seconde fois.\n  const menuNodesFor = (it) => {\n    const isFolder = it.kind === 'folder'\n    const raw = !isFolder && isRawUpload(it.path)\n    const cibles = []\n    if (folderId) cibles.push({ id: 'to-root', label: `${label} (racine)`, icon: <Icon name=\"chevron.left\" size={14} />, action: () => deplacerVers(it, null) })\n    for (const f of rootFolders) {\n      if (folderId === f.id) continue\n      if (!folderId && f.id === it.id) continue\n      cibles.push({ id: `to-${f.id}`, label: f.name, icon: <Icon name=\"folder\" size={14} />, action: () => deplacerVers(it, f.id) })\n    }\n    return [\n      { id: 'open', label: isFolder ? 'Ouvrir' : 'Ouvrir en plein écran', icon: <Icon name=\"arrow.up.right\" size={14} />, action: () => (isFolder ? setFolderId(it.id) : setOuvert(it)) },\n      { id: 'text', label: 'Titre et note…', icon: <Icon name=\"doc.text\" size={14} />, action: () => setRenamingId(it.id) },\n      { id: 'move', label: 'Déplacer vers…', icon: <Icon name=\"folder\" size={14} />, disabled: isFolder || !cibles.length, children: isFolder ? [] : cibles },\n      !isFolder && { id: 'copy', label: 'Copier', icon: <Icon name=\"doc.text\" size={14} />, action: () => copier(it) },\n      !isFolder && { id: 'cut', label: 'Couper', icon: <Icon name=\"scissors\" size={14} />, action: () => couper(it) },\n      !isFolder && { id: 'share', label: 'Partager…', icon: <Icon name=\"arrow.up.right\" size={14} />, action: () => partager(it) },\n      { id: 'add-to', label: 'Ajouter à…', icon: <Icon name=\"photo\" size={14} />, disabled: isFolder, children: isFolder ? [] : otherGalleries.map((g) => ({\n        id: `add-${g.key}`, label: g.label, action: () => ajouterAGalerie(g.key, [{ kind: it.kind, path: it.path, name: it.name, w: it.w, h: it.h }]),\n      })) },\n      !isFolder && { id: 'to-create', label: 'Déplacer dans Create', icon: <Icon name=\"arrow.up.right\" size={14} />, disabled: !raw, action: () => envoyerVersCreate(it) },\n      { id: 'remove', label: `Retirer de ${label}`, icon: <Icon name=\"xmark\" size={14} />, action: () => retirer(it.id) },\n      !isFolder && { id: 'delete-create', label: 'Supprimer de Create', icon: <Icon name=\"trash\" size={14} />, danger: true, disabled: raw, action: () => supprimerDeCreate(it) },\n    ].filter(Boolean)\n  }\n\n  // ── UNE SEULE DÉFINITION DE TUILE, DEUX JEUX DE PARAMÈTRES (2026-08-21) ───────────────────────────\n  // Loi HDA appliquée au rendu : la grille et la table lumineuse ne diffèrent que par trois valeurs —\n  // le format de la tuile, la largeur qu'elle occupe, et ce que veut dire un lâcher dessus. Dupliquer\n  // le rendu pour ces trois-là aurait donné deux tuiles qui divergent dès le premier champ ajouté.\n  const rendreTuile = (it, aligne) => {\n    // 16:9 OU PROCHE, DONC 2 CASES en grille : une image horizontale écrasée dans une seule case\n    // devient trop petite. Seuil large (1,3) plutôt que 16:9 exact (1,78), pour capter le « proche »\n    // sans mordre sur le quasi-carré. En mode aligné, toutes les tuiles partagent le MÊME gabarit :\n    // c'est exactement ce qu'on demande à une table lumineuse, comparer des images entre elles.\n    const large = !aligne && it.kind === 'image' && it.w && it.h && it.w / it.h >= 1.3\n    const ratio = aligne ? '4 / 3' : (it.w && it.h ? `${it.w} / ${it.h}` : '4 / 5')\n    const surLigne = insert && insert.id === it.id ? insert.side : null\n    const editing = renamingId === it.id\n    const ouvrirEditeur = () => setRenamingId(it.id)\n    // GLISSER : deux sens selon la disposition, jamais deux sens dans la même vue. En grille, lâcher\n    // sur une tuile REGROUPE ; en aligné, lâcher REMET EN ORDRE. Le mode est affiché, donc le geste\n    // n'est jamais ambigu pour la main qui le fait.\n    const dragProps = aligne ? {\n      draggable: true,\n      onDragStart: onItemDragStart(it),\n      onDragOver: (e) => { if (![...e.dataTransfer.types].includes(DND_TYPE)) return; e.preventDefault(); e.stopPropagation(); setInsert({ id: it.id, side: cote(e) }) },\n      onDragLeave: () => setInsert((v) => (v && v.id === it.id ? null : v)),\n      onDrop: (e) => { const from = e.dataTransfer.getData(DND_TYPE); if (!from) return; e.preventDefault(); e.stopPropagation(); reordonner(from, it.id, cote(e) === 'right') },\n      onContextMenu: (e) => { e.preventDefault(); e.stopPropagation(); setMenu({ x: e.clientX, y: e.clientY, it }) },\n    } : {\n      draggable: true,\n      onDragStart: onItemDragStart(it),\n      onDragOver: onItemDragOver(it),\n      onDragLeave: onItemDragLeave(it),\n      onDrop: onItemDrop(it),\n      onContextMenu: (e) => { e.preventDefault(); e.stopPropagation(); setMenu({ x: e.clientX, y: e.clientY, it }) },\n      style: overId === it.id ? { outline: '2px solid #0a84ff', outlineOffset: 2, borderRadius: 4 } : undefined,\n    }\n    return (\n      <div key={it.id} className=\"zr-tap\" style={{ position: 'relative', gridColumn: large ? 'span 2' : undefined }}>\n        {/* Barre d'insertion lumineuse, reprise du Shelf : elle montre OÙ la tuile va se poser avant\n            qu'on lâche. Décalée de 5 px dans la gouttière de 10 px, donc centrée entre deux tuiles. */}\n        {surLigne && <span aria-hidden style={{ position: 'absolute', top: 0, bottom: 0, [surLigne]: -5, width: 4, borderRadius: 4, background: t.accent, boxShadow: `0 0 12px 1px ${t.accent}`, zIndex: 6 }} />}\n        {it.kind === 'image' ? (\n          <div {...dragProps}\n            style={{ width: '100%', aspectRatio: ratio, position: 'relative', borderRadius: 4, overflow: 'hidden', cursor: editing ? 'default' : 'zoom-in', ...(dragProps.style || {}) }}\n            onClick={() => { if (!editing) setOuvert(it) }}>\n            <GalleryThumb path={it.path} alt={it.name} style={{ width: '100%', height: '100%', objectFit: 'cover', display: 'block' }} />\n            <TileCaption title={it.title} note={it.note} onEdit={ouvrirEditeur} />\n            {editing ? <TileEditor item={it} onSave={(v) => enregistrerTexte(it, v)} onCancel={() => setRenamingId(null)} /> : null}\n          </div>\n        ) : (\n          <FolderTile folder={it} ratio={aligne ? '4 / 3' : '4 / 5'} editing={editing}\n            onOpen={() => { if (!editing) setFolderId(it.id) }}\n            onEdit={ouvrirEditeur}\n            onSave={(v) => enregistrerTexte(it, v)}\n            onCancel={() => setRenamingId(null)}\n            dragProps={dragProps} />\n        )}\n        <button type=\"button\" className=\"zr-gallery-remove\" title={`Retirer de ${label}`} aria-label={`Retirer de ${label}`}\n          onClick={(e) => { e.stopPropagation(); retirer(it.id) }}\n          style={{\n            position: 'absolute', top: 6, right: 6, width: 24, height: 24, borderRadius: 999,\n            border: 0, background: 'rgba(0,0,0,.55)', color: '#fff', display: 'grid', placeItems: 'center',\n            cursor: 'pointer', opacity: 0, transition: 'opacity .15s ease', zIndex: 4,\n          }}\n          onMouseEnter={(e) => e.stopPropagation()}>\n          <Icon name=\"xmark\" size={11} color=\"#fff\" />\n        </button>\n      </div>\n      </div>\n    )\n  }\n\n  return (\n    <div style={{ maxWidth: 1400, margin: '0 auto', padding: '4px 0 40px' }}>\n      {/* FIL D'ARIANE MINIMAL (2026-08-21). Volontairement PAS le composant `Crumbs` de Create : celui-là\n          est profondément couplé à sa propre navigation (colonnes façon Finder, glisser pour déplacer une\n          vraie page, historique) pour un chemin qui ne fait jamais que DEUX niveaux ici. Même famille\n          typographique que le titre existant pour rester cohérent à l'œil, sans en importer la mécanique.\n          Le segment actif EST le champ de renommage : un clic dessus l'édite, exactement comme dans Shelf. */}\n      <div style={{ marginBottom: 12, display: 'flex', alignItems: 'center', gap: 6, minHeight: 22 }}>\n        {currentFolder ? (\n          <>\n            <h1 onClick={() => setFolderId(null)} title={`Retour à ${label}`}\n              style={{ margin: 0, font: \"500 16px/1.3 var(--zr-police-sans)\", color: t.textSecondary, cursor: 'pointer' }}>{label}</h1>\n            <Icon name=\"chevron.right\" size={11} color={t.textSecondary} />\n            {renamingId === currentFolder.id ? (\n              <input autoFocus defaultValue={currentFolder.name} title=\"Renommer\"\n                onKeyDown={(e) => { if (e.key === 'Enter') e.currentTarget.blur() }}\n                onBlur={(e) => { const v = e.target.value.trim(); setRenamingId(null); if (v && v !== currentFolder.name) renommerDossier(currentFolder.id, v) }}\n                style={{ font: \"500 16px/1.3 var(--zr-police-sans)\", color: t.textPrimary, background: 'transparent', border: 'none', borderBottom: `1px solid ${t.textSecondary}`, outline: 'none', padding: 0 }} />\n            ) : (\n              <h1 onClick={() => setRenamingId(currentFolder.id)} title=\"Cliquer pour renommer\"\n                style={{ margin: 0, font: \"500 16px/1.3 var(--zr-police-sans)\", color: t.textPrimary, cursor: 'text' }}>{currentFolder.name}</h1>\n            )}\n          </>\n        ) : (\n          <h1 style={{ margin: 0, font: \"500 16px/1.3 var(--zr-police-sans)\", color: t.textSecondary }}>{label}</h1>\n        )}\n        {uploading > 0 && <span style={{ font: \"400 12px var(--zr-police-sans)\", color: t.textSecondary }}>· import {uploading}…</span>}\n        <span style={{ flex: 1 }} />\n        {/* BASCULE DE DISPOSITION. Deux segments, pas un menu : il n'y a que deux états et ils se lisent\n            en entier, donc les cacher derrière un déclencheur coûterait un clic pour rien. Texte en Inter\n            Regular 400, la règle du trio typographique pour tout ce qui est chrome d'interface. */}\n        <div role=\"group\" aria-label=\"Disposition\" style={{ display: 'inline-flex', gap: 2, padding: 2, borderRadius: 8, background: 'rgba(128,128,128,.12)' }}>\n          {[{ k: 'grid', l: 'Grille', i: 'square.grid.2x2' }, { k: 'aligned', l: 'Alignées', i: 'square.grid.3x3' }].map((m) => {\n            const on = layout === m.k\n            return (\n              <button key={m.k} type=\"button\" onClick={() => setLayout(m.k)} aria-pressed={on}\n                title={m.k === 'grid' ? 'Grille — glisser une image sur une autre forme un groupe' : 'Alignées — glisser pour remettre en ordre'}\n                style={{\n                  display: 'inline-flex', alignItems: 'center', gap: 5, padding: '3px 9px', borderRadius: 6, border: 0, cursor: 'pointer',\n                  background: on ? t.surface : 'transparent', color: on ? t.textPrimary : t.textSecondary,\n                  font: '400 12px var(--zr-police-sans)', boxShadow: on ? '0 1px 3px rgba(0,0,0,.14)' : 'none',\n                }}>\n                <Icon name={m.i} size={12} color={on ? t.textPrimary : t.textSecondary} />{m.l}\n              </button>\n            )\n          })}\n        </div>\n      </div>\n\n      <FadeIn key={folderId || 'root'}>\n        <div onDragOver={onGridDragOver} onDragLeave={onGridDragLeave} onDrop={onGridDrop}\n          style={{ borderRadius: 8, outline: dragOverGrid ? '2px dashed rgba(10,132,255,.6)' : 'none', outlineOffset: 4, transition: 'outline .12s ease' }}>\n          {data === null ? (\n            <p style={{ font: \"400 13px var(--zr-police-sans)\", color: t.textSecondary }}>lecture…</p>\n          ) : items.length === 0 ? (\n            <p style={{ font: \"400 13px/1.6 var(--zr-police-sans)\", color: t.textSecondary, maxWidth: '60ch' }}>\n              {currentFolder\n                ? 'Ce groupe est vide. Colle (⌘V) ou glisse une image ici.'\n                : <>Rien pour l’instant. Colle (⌘V) une image, glisse-la depuis le Finder, ou clic droit sur une image dans Create → « Ajouter à {label} ».</>}\n            </p>\n          ) : (\n            // 4 PAR RANGÉE MAXIMUM en grille : une vraie grille, pas un masonry en colonnes CSS\n            // (celui-ci équilibre la hauteur des colonnes, jamais 4 par rangée strictement). En aligné,\n            // `auto-fill minmax(200px, 1fr)` : le nombre de colonnes suit la largeur réelle de la fenêtre\n            // au lieu d'être figé, ce qu'exige une planche de références qu'on regarde en grand.\n            <div style={layout === 'aligned'\n              ? { display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(200px, 1fr))', gap: 10 }\n              : { display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: 3 }}>\n              {items.map((it) => rendreTuile(it, layout === 'aligned'))}\n            </div>\n          )}\n        </div>\n      </FadeIn>\n\n      {ouvert && <Lightbox path={ouvert.path} name={ouvert.name} onClose={() => setOuvert(null)} />}\n      {menu && (\n        <ActionColumnPopover t={t} open anchor={{ left: menu.x, top: menu.y, triggerTop: menu.y }}\n          onClose={() => setMenu(null)} ariaLabel=\"Actions\" columnWidth={228} maxHeight={420}\n          nodes={menuNodesFor(menu.it)} />\n      )}\n    </div>\n  )\n}\n\n// Le survol montre le bouton retirer, sauf pendant un glisser (sinon le bouton clignote sous le\n// curseur qui traverse les tuiles voisines) — délégué en CSS globalement plutôt qu'en JS par tuile.\nif (typeof document !== 'undefined' && !document.getElementById('zr-gallery-hover-css')) {\n  const s = document.createElement('style')\n  s.id = 'zr-gallery-hover-css'\n  s.textContent = '.zr-tap:hover .zr-gallery-remove{opacity:1}'\n  document.head.appendChild(s)\n}\n\n// AJOUT DEPUIS LE MENU CONTEXTUEL DE CREATE (clic droit → « Ajouter à… » → une des galeries du\n// registre). Accepte plusieurs entrées à la fois (sélection multiple). `w`/`h` copiés depuis le\n// manifeste au moment de l'ajout, PAS relus dynamiquement ensuite : la grille doit rester stable même\n// si l'image d'origine est retaillée plus tard, exactement le même choix que les vignettes en cache.\n// Cible TOUJOURS la racine de la galerie visée (jamais un groupe précis) : depuis Create, il n'existe\n// aucune notion de groupe à choisir, exactement comme avant le 2026-08-21.\nexport async function ajouterAGalerie(galleryKey, entrees) {\n  const gallery = galleryByKey(galleryKey)\n  if (!gallery) return false\n  const items = entrees.filter(Boolean).map((e) => ({\n    id: `g-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`,\n    kind: e.kind, path: e.path, name: e.name, w: e.w || null, h: e.h || null,\n    addedAt: new Date().toISOString(),\n  }))\n  if (!items.length) return false\n  const res = await saveJsonWithRetry(gallery.path, (cur) => ({\n    ...(cur || {}), v: 1, items: [...((cur && cur.items) || []), ...items],\n  }))\n  if (res.ok) {\n    window.dispatchEvent(new CustomEvent(`zr:gallery-changed:${galleryKey}`))\n    notify({ label: gallery.label, title: items.length > 1 ? `${items.length} éléments ajoutés` : `Ajouté à ${gallery.label}`, body: items.map((i) => i.name).slice(0, 3).join(', ') + (items.length > 3 ? '…' : '') })\n    return true\n  }\n  notify({ kind: 'error', label: gallery.label, title: 'Ajout non enregistré', body: String(res.error || 'échec de sauvegarde') })\n  return false\n}\n","stderr":"","aggregated_output":"    </div>\n  )\n}\n\nexport default function GalleryView({ t, galleryKey }) {\n  const gallery = galleryByKey(galleryKey)\n  const label = gallery ? gallery.label : galleryKey\n  const path = gallery && gallery.path\n  const changeEvent = `zr:gallery-changed:${galleryKey}`\n  const otherGalleries = POINTER_GALLERIES.filter((g) => g.key !== galleryKey)\n\n  const [data, setData] = React.useState(null)\n  const [ouvert, setOuvert] = React.useState(null) // item en lightbox, ou null\n  const [folderId, setFolderId] = React.useState(null) // dossier ouvert, ou null = racine\n  const [renamingId, setRenamingId] = React.useState(null)\n  const [overId, setOverId] = React.useState(null) // survol drag (surbrillance de la cible)\n  const [dragOverGrid, setDragOverGrid] = React.useState(false) // fichier Finder survolant la grille\n  const [uploading, setUploading] = React.useState(0) // compte en cours, 0 = rien\n  const [menu, setMenu] = React.useState(null) // { x, y, it } | null\n  // DISPOSITION (2026-08-21). Deux vues du MÊME contenu, jamais deux stockages : « Grille » est la\n  // planche Explore d'origine, « Alignées » est la table lumineuse — tuiles au même gabarit, remises\n  // en ordre à la main. Le mode vit en local (localStorage), par galerie : c'est une préférence de\n  // regard, pas une donnée du drive, et l'écrire sur GitHub ferait un commit par clic de bouton.\n  const [layout, setLayout] = React.useState(() => {\n    try { return localStorage.getItem(`zr:gallery:layout:${galleryKey}`) === 'aligned' ? 'aligned' : 'grid' } catch { return 'grid' }\n  })\n  React.useEffect(() => { try { localStorage.setItem(`zr:gallery:layout:${galleryKey}`, layout) } catch {} }, [layout, galleryKey])\n  const [insert, setInsert] = React.useState(null) // { id, side } — barre d'insertion du mode aligné\n  const shaRef = React.useRef(null)\n\n  React.useEffect(() => {\n    if (!path) return undefined\n    let vivant = true\n    readJson(path).then(({ data: lu, sha }) => {\n      if (!vivant) return\n      shaRef.current = sha\n      setData(lu && typeof lu === 'object' ? lu : { v: 1, items: [] })\n    }).catch(() => { if (vivant) setData({ v: 1, items: [] }) })\n    return () => { vivant = false }\n  }, [path])\n\n  // Même convention événementielle que Goals (`zr:goals-changed`) : un ajout posé ailleurs (clic\n  // droit dans Create) doit apparaître ici sans recharger la page. Un canal PAR galerie (suffixe\n  // `galleryKey`) : un ajout à Characters ne doit jamais déclencher un rechargement sur Environments.\n  React.useEffect(() => {\n    if (!path) return undefined\n    const surAjout = () => {\n      readJson(path).then(({ data: lu, sha }) => { shaRef.current = sha; if (lu) setData(lu) }).catch(() => {})\n    }\n    window.addEventListener(changeEvent, surAjout)\n    return () => window.removeEventListener(changeEvent, surAjout)\n  }, [path, changeEvent])\n\n  const rootItems = data?.items || []\n  const currentFolder = folderId ? rootItems.find((it) => it.id === folderId && it.kind === 'folder') : null\n  // Le dossier ouvert a pu être retiré ailleurs (autre onglet, sync) : on revient à la racine plutôt\n  // que d'afficher une vue fantôme sur un id qui n'existe plus.\n  React.useEffect(() => { if (folderId && data && !currentFolder) setFolderId(null) }, [folderId, data, currentFolder])\n  const items = currentFolder ? (currentFolder.items || []) : rootItems\n\n  // UN SEUL POINT DE PASSAGE pour toute mutation du niveau AFFICHÉ (racine, ou le tableau `items` d'un\n  // dossier ouvert) : jamais deux endroits qui doivent se souvenir séparément « suis-je dans un\n  // dossier ». Utilisé aussi bien pour l'état optimiste local que pour le retry anti-conflit.\n  const mutateLevel = (cur, f) => {\n    const root = (cur && cur.items) || []\n    if (!folderId) return { ...(cur || {}), v: 1, items: f(root) }\n    return { ...(cur || {}), v: 1, items: root.map((it) => (it.id === folderId && it.kind === 'folder') ? { ...it, items: f(it.items || []) } : it) }\n  }\n  const ecrire = async (f, erreurTitre) => {\n    const next = mutateLevel(data, f)\n    setData(next)\n    const res = await saveJsonWithRetry(path, (cur) => mutateLevel(cur, f), { sha: shaRef.current, data })\n    if (res.ok) shaRef.current = res.sha\n    else notify({ kind: 'error', label, title: erreurTitre, body: 'Réessaie, un conflit a empêché l’écriture.' })\n    return res.ok\n  }\n  // Rename opère sur le dossier LUI-MÊME, qui vit toujours à la racine (jamais de dossier dans un\n  // dossier) — que l'on renomme depuis la grille (dehors) ou depuis le fil d'Ariane (dedans), la\n  // cible est la même liste racine, jamais `mutateLevel` (qui viserait le CONTENU du dossier).\n  const renommerDossier = async (id, name) => {\n    const appliquer = (cur) => ({ ...(cur || {}), v: 1, items: ((cur && cur.items) || []).map((it) => it.id === id ? { ...it, name } : it) })\n    setData(appliquer)\n    const res = await saveJsonWithRetry(path, appliquer, { sha: shaRef.current, data })\n    if (res.ok) shaRef.current = res.sha\n  }\n  const retirer = (id) => ecrire((list) => list.filter((it) => it.id !== id), 'Retrait non enregistré')\n\n  // TITRE + NOTE. Un dossier vit TOUJOURS à la racine (jamais de dossier dans un dossier), donc il ne\n  // se modifie pas par `ecrire`, qui vise le niveau AFFICHÉ — la même asymétrie que `renommerDossier`\n  // juste au-dessus, et la raison pour laquelle les deux chemins restent séparés.\n  const enregistrerTexte = async (it, { name, note }) => {\n    setRenamingId(null)\n    // Groupe : le champ saisi EST son nom. Image : c'est un titre facultatif, posé à côté du `name`\n    // technique, qu'on ne touche jamais — il sert au partage, au menu et au nom de fichier exporté.\n    const champs = it.kind === 'folder' ? { name: name || '', note: note || '' } : { title: name || '', note: note || '' }\n    if (it.kind === 'folder') {\n      const appliquer = (cur) => ({ ...(cur || {}), v: 1, items: ((cur && cur.items) || []).map((x) => x.id === it.id ? { ...x, ...champs } : x) })\n      setData(appliquer)\n      const res = await saveJsonWithRetry(path, appliquer, { sha: shaRef.current, data })\n      if (res.ok) shaRef.current = res.sha\n      else notify({ kind: 'error', label, title: 'Texte non enregistré', body: 'Réessaie, un conflit a empêché l’écriture.' })\n      return\n    }\n    await ecrire((list) => list.map((x) => x.id === it.id ? { ...x, ...champs } : x), 'Texte non enregistré')\n  }\n\n  // ── REMISE EN ORDRE À LA MAIN (2026-08-21) ────────────────────────────────────────────────────────\n  // Mécanique reprise TELLE QUELLE du Shelf (src/components/Shelf.jsx, `dragApi.dropOn` et `sideOf`),\n  // qui la porte depuis des mois et qui marche : on retire l'élément de la liste, puis on le réinsère\n  // AVANT ou APRÈS la cible selon la moitié survolée. Retirer d'abord et chercher l'index ensuite\n  // n'est pas un détail de style : chercher l'index avant le retrait décale l'insertion d'un cran dès\n  // qu'on déplace un élément vers la droite, et le bug ne se voit que dans ce sens-là.\n  //\n  // POURQUOI UN MODE ET PAS UN GESTE DE PLUS. Dans la grille, lâcher une image sur une autre CRÉE UN\n  // GROUPE. Le même geste ne peut pas vouloir dire deux choses ; c'est la disposition qui tranche, et\n  // le mode est visible à l'écran, donc le geste n'est jamais ambigu.\n  const reordonner = async (fromId, targetId, after) => {\n    setInsert(null)\n    if (!fromId || fromId === targetId) return\n    await ecrire((list) => {\n      const a = [...list]\n      const fi = a.findIndex((x) => x.id === fromId)\n      if (fi < 0) return list\n      const [deplace] = a.splice(fi, 1)\n      const ti = a.findIndex((x) => x.id === targetId)\n      if (ti < 0) a.push(deplace); else a.splice(after ? ti + 1 : ti, 0, deplace)\n      return a\n    }, 'Ordre non enregistré')\n  }\n  const cote = (e) => { const r = e.currentTarget.getBoundingClientRect(); return e.clientX > r.left + r.width / 2 ? 'right' : 'left' }\n\n  // ── COLLER / GLISSER UN MÉDIA (2026-08-21) ────────────────────────────────────────────────────────\n  // Même chemin, prouvé ailleurs dans l'app (Articles, Shelf, Gallery.jsx) : conversion WebP CÔTÉ\n  // NAVIGATEUR (quasi instantanée via canvas.toBlob, contrairement à AVIF qui coûte cher à ENCODER),\n  // puis `/api/img` — déjà une route API qui écrit directement sur GitHub, jamais le pipeline CLI de\n  // l'archiveur ZenRayCloud. Encodage en parallèle par lots de 4 (CPU), envoi en SÉRIE (chaque\n  // /api/img = un commit GitHub, sérialiser évite des conflits de commit concurrents).\n  async function addFiles(fileList) {\n    const imgs = [...fileList].filter((f) => f.type && f.type.startsWith('image/'))\n    if (!imgs.length) return\n    setUploading((n) => n + imgs.length)\n    const added = []\n    const ENC = 4\n    for (let i = 0; i < imgs.length; i += ENC) {\n      const enc = await Promise.all(imgs.slice(i, i + ENC).map(async (f) => {\n        let w = 4, h = 3\n        try { const bmp = await createImageBitmap(f); w = bmp.width; h = bmp.height } catch {}\n        const webp = await fileToWebp(f).catch(() => null)\n        return webp ? { webp, w, h, name: f.name } : null\n      }))\n      for (const e of enc) {\n        if (!e) continue\n        const j = await fetch('/api/img', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ dataUrl: e.webp, dir: 'uploads' }) }).then((r) => r.json()).catch(() => null)\n        if (j && j.path) added.push({ id: `g-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`, kind: 'image', path: j.path, name: e.name, w: e.w, h: e.h, addedAt: new Date().toISOString() })\n      }\n    }\n    setUploading((n) => Math.max(0, n - imgs.length))\n    if (!added.length) return\n    await ecrire((list) => [...list, ...added], 'Import non enregistré')\n  }\n  useClipboardTarget('gallery:' + galleryKey, { onPasteImage: (files) => addFiles(files) }, true)\n  const onGridDragOver = (e) => { if (![...e.dataTransfer.types].includes('Files')) return; e.preventDefault(); setDragOverGrid(true) }\n  const onGridDragLeave = () => setDragOverGrid(false)\n  const onGridDrop = (e) => {\n    if (!e.dataTransfer.files || !e.dataTransfer.files.length) return\n    e.preventDefault(); setDragOverGrid(false)\n    addFiles(e.dataTransfer.files)\n  }\n\n  // ── GROUPES PAR GLISSER-DÉPOSER (2026-08-21) ──────────────────────────────────────────────────────\n  // Un seul niveau, jamais de dossier dans un dossier — la même règle qu'iOS. Glisser une image sur\n  // une AUTRE image crée un groupe ; glisser une image sur un groupe l'y ajoute ; un DOSSIER glissé ne\n  // s'imbrique jamais nulle part (on l'ignore silencieusement, comme iOS refuse un dossier dans un\n  // dossier sans le dire non plus).\n  const DND_TYPE = 'application/zenray-gallery-item'\n  const onItemDragStart = (it) => (e) => { e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData(DND_TYPE, it.id) }\n  const onItemDragOver = (it) => (e) => {\n    if (![...e.dataTransfer.types].includes(DND_TYPE)) return // laisse filer un glisser Finder externe\n    e.preventDefault(); e.stopPropagation(); setOverId(it.id)\n  }\n  const onItemDragLeave = (it) => () => setOverId((o) => (o === it.id ? null : o))\n  const onItemDrop = (target) => async (e) => {\n    const draggedId = e.dataTransfer.getData(DND_TYPE)\n    setOverId(null)\n    if (!draggedId || draggedId === target.id) return\n    e.preventDefault(); e.stopPropagation()\n    const dragged = items.find((x) => x.id === draggedId)\n    if (!dragged || dragged.kind === 'folder') return\n    let nouveauId = null\n    const f = target.kind === 'folder'\n      ? (list) => list.filter((x) => x.id !== draggedId).map((x) => x.id === target.id ? { ...x, items: [...(x.items || []), dragged] } : x)\n      : (list) => {\n        nouveauId = `f-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`\n        return list.filter((x) => x.id !== draggedId).map((x) => x.id === target.id\n          ? { id: nouveauId, kind: 'folder', name: 'Nouveau groupe', items: [x, dragged], addedAt: new Date().toISOString() }\n          : x)\n      }\n    const ok = await ecrire(f, 'Regroupement non enregistré')\n    if (ok && nouveauId) setRenamingId(nouveauId) // le nom se propose tout de suite, prêt à taper\n  }\n\n  // ── DÉPLACER VERS… (menu, alternative au glisser) ─────────────────────────────────────────────────\n  const rootFolders = rootItems.filter((x) => x.kind === 'folder')\n  const deplacerVers = async (it, targetFolderId) => {\n    if (it.kind === 'folder') return\n    const appliquer = (cur) => {\n      const root = (cur && cur.items) || []\n      const source = folderId\n        ? root.map((x) => x.id === folderId ? { ...x, items: (x.items || []).filter((y) => y.id !== it.id) } : x)\n        : root.filter((x) => x.id !== it.id)\n      if (targetFolderId === null) return { ...(cur || {}), v: 1, items: folderId ? [...source, it] : source }\n      return { ...(cur || {}), v: 1, items: source.map((x) => x.id === targetFolderId ? { ...x, items: [...(x.items || []), it] } : x) }\n    }\n    setData(appliquer)\n    const res = await saveJsonWithRetry(path, appliquer, { sha: shaRef.current, data })\n    if (res.ok) shaRef.current = res.sha\n    else notify({ kind: 'error', label, title: 'Déplacement non enregistré', body: 'Réessaie, un conflit a empêché l’écriture.' })\n  }\n\n  // ── COPIER / COUPER / PARTAGER (2026-08-21) ───────────────────────────────────────────────────────\n  const blobOfItem = async (it) => {\n    const url = isRawUpload(it.path) ? rawUrl(it.path) : await (async () => {\n      const m = await readImgManifestCached(it.path)\n      return m ? await resolveFullUrl(m) : null\n    })()\n    if (!url) return null\n    return fetch(url).then((r) => (r.ok ? r.blob() : null)).catch(() => null)\n  }\n  const copier = async (it) => {\n    const blob = await blobOfItem(it)\n    if (!blob) return notify({ kind: 'error', label, title: 'Copie impossible', body: 'Image introuvable.' })\n    try {\n      await navigator.clipboard.write([new ClipboardItem({ [blob.type || 'image/webp']: blob })])\n      notify({ kind: 'info', label, title: 'Copié', body: it.name || 'Image copiée dans le presse-papiers.' })\n    } catch { notify({ kind: 'error', label, title: 'Copie impossible', body: 'Le navigateur a refusé l’accès au presse-papiers.' }) }\n  }\n  const couper = async (it) => { await copier(it); retirer(it.id) }\n  const partager = async (it) => {\n    const blob = await blobOfItem(it)\n    if (!blob) return notify({ kind: 'error', label, title: 'Partage impossible', body: 'Image introuvable.' })\n    const file = new File([blob], (it.name || 'image').replace(/\\.[a-z0-9]+$/i, '') + '.' + (blob.type.split('/')[1] || 'webp'), { type: blob.type })\n    if (navigator.canShare && navigator.canShare({ files: [file] })) {\n      try { await navigator.share({ files: [file], title: it.name || label }); return } catch { return } // annulé : pas d'erreur à montrer\n    }\n    // Repli desktop : seul un chemin uploads/ (posé par /api/img) a un lien PUBLIC stable. Un\n    // manifeste Create est chiffré au repos — rien à lier, seule l'image elle-même se partage.\n    if (isRawUpload(it.path)) {\n      const shareUrl = `${location.origin}${rawUrl(it.path)}`\n      try { await navigator.clipboard.writeText(shareUrl); notify({ kind: 'info', label, title: 'Lien copié', body: shareUrl }) }\n      catch { notify({ kind: 'error', label, title: 'Partage impossible', body: 'Copie du lien refusée.' }) }\n      return\n    }\n    await copier(it)\n    notify({ kind: 'info', label, title: 'Copié (partage indisponible)', body: 'Colle l’image où tu veux la partager.' })\n  }\n\n  // ── PONT VERS CREATE (2026-08-21) ─────────────────────────────────────────────────────────────────\n  // GalleryView est un module séparé (lazy-chargé) sans accès aux fermetures d'App.jsx. Plutôt que\n  // dupliquer `trashPath` (move + sidecar + retry) ou `runCapture` (tout le pipeline d'ingestion), on\n  // les rappelle via un événement écouté là-bas — même geste que `zr:open-page`. `resolve` rend\n  // l'appel attendable sans construire un vrai bus RPC ; un filet de 8 s évite de rester bloqué si\n  // personne n'écoute.\n  const dispatchAndWait = (name, detail) => new Promise((resolve) => {\n    window.dispatchEvent(new CustomEvent(name, { detail: { ...detail, resolve } }))\n    setTimeout(() => resolve(false), 8000)\n  })\n  const envoyerVersCreate = async (it) => {\n    const blob = await blobOfItem(it)\n    if (!blob) return notify({ kind: 'error', label, title: 'Envoi impossible', body: 'Image introuvable.' })\n    const file = new File([blob], (it.name || 'image').replace(/\\.[a-z0-9]+$/i, '') + '.' + (blob.type.split('/')[1] || 'webp'), { type: blob.type })\n    const ok = await dispatchAndWait('zr:gallery-send-to-create', { file })\n    if (ok) { retirer(it.id); notify({ label, title: 'Envoyé dans Create', body: it.name || '' }) }\n    else notify({ kind: 'error', label, title: 'Envoi échoué', body: 'Create n’a pas confirmé la réception.' })\n  }\n  const supprimerDeCreate = async (it) => {\n    if (!window.confirm(`Supprimer « ${it.name || 'cette image'} » de Create ? Elle ira dans Trash, récupérable.`)) return\n    const ok = await dispatchAndWait('zr:gallery-delete-from-create', { path: it.path })\n    if (ok) retirer(it.id)\n  }\n\n  // ── MENU CLIC DROIT (2026-08-21, demande Matthieu : l'ancien bouton « × » au survol était une seule\n  // option sans nom ni contexte — « pas logique »). Chaque action se montre ou se désactive selon ce\n  // qui a RÉELLEMENT un sens pour cet item précis, plutôt que d'exposer huit boutons dont la moitié ne\n  // font rien : un dossier ne se copie pas, un item posé par collage n'est « dans Create » nulle part\n  // à en retirer, un item déjà brut n'a rien à y envoyer une seconde fois.\n  const menuNodesFor = (it) => {\n    const isFolder = it.kind === 'folder'\n    const raw = !isFolder && isRawUpload(it.path)\n    const cibles = []\n    if (folderId) cibles.push({ id: 'to-root', label: `${label} (racine)`, icon: <Icon name=\"chevron.left\" size={14} />, action: () => deplacerVers(it, null) })\n    for (const f of rootFolders) {\n      if (folderId === f.id) continue\n      if (!folderId && f.id === it.id) continue\n      cibles.push({ id: `to-${f.id}`, label: f.name, icon: <Icon name=\"folder\" size={14} />, action: () => deplacerVers(it, f.id) })\n    }\n    return [\n      { id: 'open', label: isFolder ? 'Ouvrir' : 'Ouvrir en plein écran', icon: <Icon name=\"arrow.up.right\" size={14} />, action: () => (isFolder ? setFolderId(it.id) : setOuvert(it)) },\n      { id: 'text', label: 'Titre et note…', icon: <Icon name=\"doc.text\" size={14} />, action: () => setRenamingId(it.id) },\n      { id: 'move', label: 'Déplacer vers…', icon: <Icon name=\"folder\" size={14} />, disabled: isFolder || !cibles.length, children: isFolder ? [] : cibles },\n      !isFolder && { id: 'copy', label: 'Copier', icon: <Icon name=\"doc.text\" size={14} />, action: () => copier(it) },\n      !isFolder && { id: 'cut', label: 'Couper', icon: <Icon name=\"scissors\" size={14} />, action: () => couper(it) },\n      !isFolder && { id: 'share', label: 'Partager…', icon: <Icon name=\"arrow.up.right\" size={14} />, action: () => partager(it) },\n      { id: 'add-to', label: 'Ajouter à…', icon: <Icon name=\"photo\" size={14} />, disabled: isFolder, children: isFolder ? [] : otherGalleries.map((g) => ({\n        id: `add-${g.key}`, label: g.label, action: () => ajouterAGalerie(g.key, [{ kind: it.kind, path: it.path, name: it.name, w: it.w, h: it.h }]),\n      })) },\n      !isFolder && { id: 'to-create', label: 'Déplacer dans Create', icon: <Icon name=\"arrow.up.right\" size={14} />, disabled: !raw, action: () => envoyerVersCreate(it) },\n      { id: 'remove', label: `Retirer de ${label}`, icon: <Icon name=\"xmark\" size={14} />, action: () => retirer(it.id) },\n      !isFolder && { id: 'delete-create', label: 'Supprimer de Create', icon: <Icon name=\"trash\" size={14} />, danger: true, disabled: raw, action: () => supprimerDeCreate(it) },\n    ].filter(Boolean)\n  }\n\n  // ── UNE SEULE DÉFINITION DE TUILE, DEUX JEUX DE PARAMÈTRES (2026-08-21) ───────────────────────────\n  // Loi HDA appliquée au rendu : la grille et la table lumineuse ne diffèrent que par trois valeurs —\n  // le format de la tuile, la largeur qu'elle occupe, et ce que veut dire un lâcher dessus. Dupliquer\n  // le rendu pour ces trois-là aurait donné deux tuiles qui divergent dès le premier champ ajouté.\n  const rendreTuile = (it, aligne) => {\n    // 16:9 OU PROCHE, DONC 2 CASES en grille : une image horizontale écrasée dans une seule case\n    // devient trop petite. Seuil large (1,3) plutôt que 16:9 exact (1,78), pour capter le « proche »\n    // sans mordre sur le quasi-carré. En mode aligné, toutes les tuiles partagent le MÊME gabarit :\n    // c'est exactement ce qu'on demande à une table lumineuse, comparer des images entre elles.\n    const large = !aligne && it.kind === 'image' && it.w && it.h && it.w / it.h >= 1.3\n    const ratio = aligne ? '4 / 3' : (it.w && it.h ? `${it.w} / ${it.h}` : '4 / 5')\n    const surLigne = insert && insert.id === it.id ? insert.side : null\n    const editing = renamingId === it.id\n    const ouvrirEditeur = () => setRenamingId(it.id)\n    // GLISSER : deux sens selon la disposition, jamais deux sens dans la même vue. En grille, lâcher\n    // sur une tuile REGROUPE ; en aligné, lâcher REMET EN ORDRE. Le mode est affiché, donc le geste\n    // n'est jamais ambigu pour la main qui le fait.\n    const dragProps = aligne ? {\n      draggable: true,\n      onDragStart: onItemDragStart(it),\n      onDragOver: (e) => { if (![...e.dataTransfer.types].includes(DND_TYPE)) return; e.preventDefault(); e.stopPropagation(); setInsert({ id: it.id, side: cote(e) }) },\n      onDragLeave: () => setInsert((v) => (v && v.id === it.id ? null : v)),\n      onDrop: (e) => { const from = e.dataTransfer.getData(DND_TYPE); if (!from) return; e.preventDefault(); e.stopPropagation(); reordonner(from, it.id, cote(e) === 'right') },\n      onContextMenu: (e) => { e.preventDefault(); e.stopPropagation(); setMenu({ x: e.clientX, y: e.clientY, it }) },\n    } : {\n      draggable: true,\n      onDragStart: onItemDragStart(it),\n      onDragOver: onItemDragOver(it),\n      onDragLeave: onItemDragLeave(it),\n      onDrop: onItemDrop(it),\n      onContextMenu: (e) => { e.preventDefault(); e.stopPropagation(); setMenu({ x: e.clientX, y: e.clientY, it }) },\n      style: overId === it.id ? { outline: '2px solid #0a84ff', outlineOffset: 2, borderRadius: 4 } : undefined,\n    }\n    return (\n      <div key={it.id} className=\"zr-tap\" style={{ position: 'relative', gridColumn: large ? 'span 2' : undefined }}>\n        {/* Barre d'insertion lumineuse, reprise du Shelf : elle montre OÙ la tuile va se poser avant\n            qu'on lâche. Décalée de 5 px dans la gouttière de 10 px, donc centrée entre deux tuiles. */}\n        {surLigne && <span aria-hidden style={{ position: 'absolute', top: 0, bottom: 0, [surLigne]: -5, width: 4, borderRadius: 4, background: t.accent, boxShadow: `0 0 12px 1px ${t.accent}`, zIndex: 6 }} />}\n        {it.kind === 'image' ? (\n          <div {...dragProps}\n            style={{ width: '100%', aspectRatio: ratio, position: 'relative', borderRadius: 4, overflow: 'hidden', cursor: editing ? 'default' : 'zoom-in', ...(dragProps.style || {}) }}\n            onClick={() => { if (!editing) setOuvert(it) }}>\n            <GalleryThumb path={it.path} alt={it.name} style={{ width: '100%', height: '100%', objectFit: 'cover', display: 'block' }} />\n            <TileCaption title={it.title} note={it.note} onEdit={ouvrirEditeur} />\n            {editing ? <TileEditor item={it} onSave={(v) => enregistrerTexte(it, v)} onCancel={() => setRenamingId(null)} /> : null}\n          </div>\n        ) : (\n          <FolderTile folder={it} ratio={aligne ? '4 / 3' : '4 / 5'} editing={editing}\n            onOpen={() => { if (!editing) setFolderId(it.id) }}\n            onEdit={ouvrirEditeur}\n            onSave={(v) => enregistrerTexte(it, v)}\n            onCancel={() => setRenamingId(null)}\n            dragProps={dragProps} />\n        )}\n        <button type=\"button\" className=\"zr-gallery-remove\" title={`Retirer de ${label}`} aria-label={`Retirer de ${label}`}\n          onClick={(e) => { e.stopPropagation(); retirer(it.id) }}\n          style={{\n            position: 'absolute', top: 6, right: 6, width: 24, height: 24, borderRadius: 999,\n            border: 0, background: 'rgba(0,0,0,.55)', color: '#fff', display: 'grid', placeItems: 'center',\n            cursor: 'pointer', opacity: 0, transition: 'opacity .15s ease', zIndex: 4,\n          }}\n          onMouseEnter={(e) => e.stopPropagation()}>\n          <Icon name=\"xmark\" size={11} color=\"#fff\" />\n        </button>\n      </div>\n      </div>\n    )\n  }\n\n  return (\n    <div style={{ maxWidth: 1400, margin: '0 auto', padding: '4px 0 40px' }}>\n      {/* FIL D'ARIANE MINIMAL (2026-08-21). Volontairement PAS le composant `Crumbs` de Create : celui-là\n          est profondément couplé à sa propre navigation (colonnes façon Finder, glisser pour déplacer une\n          vraie page, historique) pour un chemin qui ne fait jamais que DEUX niveaux ici. Même famille\n          typographique que le titre existant pour rester cohérent à l'œil, sans en importer la mécanique.\n          Le segment actif EST le champ de renommage : un clic dessus l'édite, exactement comme dans Shelf. */}\n      <div style={{ marginBottom: 12, display: 'flex', alignItems: 'center', gap: 6, minHeight: 22 }}>\n        {currentFolder ? (\n          <>\n            <h1 onClick={() => setFolderId(null)} title={`Retour à ${label}`}\n              style={{ margin: 0, font: \"500 16px/1.3 var(--zr-police-sans)\", color: t.textSecondary, cursor: 'pointer' }}>{label}</h1>\n            <Icon name=\"chevron.right\" size={11} color={t.textSecondary} />\n            {renamingId === currentFolder.id ? (\n              <input autoFocus defaultValue={currentFolder.name} title=\"Renommer\"\n                onKeyDown={(e) => { if (e.key === 'Enter') e.currentTarget.blur() }}\n                onBlur={(e) => { const v = e.target.value.trim(); setRenamingId(null); if (v && v !== currentFolder.name) renommerDossier(currentFolder.id, v) }}\n                style={{ font: \"500 16px/1.3 var(--zr-police-sans)\", color: t.textPrimary, background: 'transparent', border: 'none', borderBottom: `1px solid ${t.textSecondary}`, outline: 'none', padding: 0 }} />\n            ) : (\n              <h1 onClick={() => setRenamingId(currentFolder.id)} title=\"Cliquer pour renommer\"\n                style={{ margin: 0, font: \"500 16px/1.3 var(--zr-police-sans)\", color: t.textPrimary, cursor: 'text' }}>{currentFolder.name}</h1>\n            )}\n          </>\n        ) : (\n          <h1 style={{ margin: 0, font: \"500 16px/1.3 var(--zr-police-sans)\", color: t.textSecondary }}>{label}</h1>\n        )}\n        {uploading > 0 && <span style={{ font: \"400 12px var(--zr-police-sans)\", color: t.textSecondary }}>· import {uploading}…</span>}\n        <span style={{ flex: 1 }} />\n        {/* BASCULE DE DISPOSITION. Deux segments, pas un menu : il n'y a que deux états et ils se lisent\n            en entier, donc les cacher derrière un déclencheur coûterait un clic pour rien. Texte en Inter\n            Regular 400, la règle du trio typographique pour tout ce qui est chrome d'interface. */}\n        <div role=\"group\" aria-label=\"Disposition\" style={{ display: 'inline-flex', gap: 2, padding: 2, borderRadius: 8, background: 'rgba(128,128,128,.12)' }}>\n          {[{ k: 'grid', l: 'Grille', i: 'square.grid.2x2' }, { k: 'aligned', l: 'Alignées', i: 'square.grid.3x3' }].map((m) => {\n            const on = layout === m.k\n            return (\n              <button key={m.k} type=\"button\" onClick={() => setLayout(m.k)} aria-pressed={on}\n                title={m.k === 'grid' ? 'Grille — glisser une image sur une autre forme un groupe' : 'Alignées — glisser pour remettre en ordre'}\n                style={{\n                  display: 'inline-flex', alignItems: 'center', gap: 5, padding: '3px 9px', borderRadius: 6, border: 0, cursor: 'pointer',\n                  background: on ? t.surface : 'transparent', color: on ? t.textPrimary : t.textSecondary,\n                  font: '400 12px var(--zr-police-sans)', boxShadow: on ? '0 1px 3px rgba(0,0,0,.14)' : 'none',\n                }}>\n                <Icon name={m.i} size={12} color={on ? t.textPrimary : t.textSecondary} />{m.l}\n              </button>\n            )\n          })}\n        </div>\n      </div>\n\n      <FadeIn key={folderId || 'root'}>\n        <div onDragOver={onGridDragOver} onDragLeave={onGridDragLeave} onDrop={onGridDrop}\n          style={{ borderRadius: 8, outline: dragOverGrid ? '2px dashed rgba(10,132,255,.6)' : 'none', outlineOffset: 4, transition: 'outline .12s ease' }}>\n          {data === null ? (\n            <p style={{ font: \"400 13px var(--zr-police-sans)\", color: t.textSecondary }}>lecture…</p>\n          ) : items.length === 0 ? (\n            <p style={{ font: \"400 13px/1.6 var(--zr-police-sans)\", color: t.textSecondary, maxWidth: '60ch' }}>\n              {currentFolder\n                ? 'Ce groupe est vide. Colle (⌘V) ou glisse une image ici.'\n                : <>Rien pour l’instant. Colle (⌘V) une image, glisse-la depuis le Finder, ou clic droit sur une image dans Create → « Ajouter à {label} ».</>}\n            </p>\n          ) : (\n            // 4 PAR RANGÉE MAXIMUM en grille : une vraie grille, pas un masonry en colonnes CSS\n            // (celui-ci équilibre la hauteur des colonnes, jamais 4 par rangée strictement). En aligné,\n            // `auto-fill minmax(200px, 1fr)` : le nombre de colonnes suit la largeur réelle de la fenêtre\n            // au lieu d'être figé, ce qu'exige une planche de références qu'on regarde en grand.\n            <div style={layout === 'aligned'\n              ? { display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(200px, 1fr))', gap: 10 }\n              : { display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', gap: 3 }}>\n              {items.map((it) => rendreTuile(it, layout === 'aligned'))}\n            </div>\n          )}\n        </div>\n      </FadeIn>\n\n      {ouvert && <Lightbox path={ouvert.path} name={ouvert.name} onClose={() => setOuvert(null)} />}\n      {menu && (\n        <ActionColumnPopover t={t} open anchor={{ left: menu.x, top: menu.y, triggerTop: menu.y }}\n          onClose={() => setMenu(null)} ariaLabel=\"Actions\" columnWidth={228} maxHeight={420}\n          nodes={menuNodesFor(menu.it)} />\n      )}\n    </div>\n  )\n}\n\n// Le survol montre le bouton retirer, sauf pendant un glisser (sinon le bouton clignote sous le\n// curseur qui traverse les tuiles voisines) — délégué en CSS globalement plutôt qu'en JS par tuile.\nif (typeof document !== 'undefined' && !document.getElementById('zr-gallery-hover-css')) {\n  const s = document.createElement('style')\n  s.id = 'zr-gallery-hover-css'\n  s.textContent = '.zr-tap:hover .zr-gallery-remove{opacity:1}'\n  document.head.appendChild(s)\n}\n\n// AJOUT DEPUIS LE MENU CONTEXTUEL DE CREATE (clic droit → « Ajouter à… » → une des galeries du\n// registre). Accepte plusieurs entrées à la fois (sélection multiple). `w`/`h` copiés depuis le\n// manifeste au moment de l'ajout, PAS relus dynamiquement ensuite : la grille doit rester stable même\n// si l'image d'origine est retaillée plus tard, exactement le même choix que les vignettes en cache.\n// Cible TOUJOURS la racine de la galerie visée (jamais un groupe précis) : depuis Create, il n'existe\n// aucune notion de groupe à choisir, exactement comme avant le 2026-08-21.\nexport async function ajouterAGalerie(galleryKey, entrees) {\n  const gallery = galleryByKey(galleryKey)\n  if (!gallery) return false\n  const items = entrees.filter(Boolean).map((e) => ({\n    id: `g-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`,\n    kind: e.kind, path: e.path, name: e.name, w: e.w || null, h: e.h || null,\n    addedAt: new Date().toISOString(),\n  }))\n  if (!items.length) return false\n  const res = await saveJsonWithRetry(gallery.path, (cur) => ({\n    ...(cur || {}), v: 1, items: [...((cur && cur.items) || []), ...items],\n  }))\n  if (res.ok) {\n    window.dispatchEvent(new CustomEvent(`zr:gallery-changed:${galleryKey}`))\n    notify({ label: gallery.label, title: items.length > 1 ? `${items.length} éléments ajoutés` : `Ajouté à ${gallery.label}`, body: items.map((i) => i.name).slice(0, 3).join(', ') + (items.length > 3 ? '…' : '') })\n    return true\n  }\n  notify({ kind: 'error', label: gallery.label, title: 'Ajout non enregistré', body: String(res.error || 'échec de sauvegarde') })\n  return false\n}\n","exit_code":0,"duration":{"secs":0,"nanos":5708},"formatted_output":"    </div>\n  )\n}\n\nexport default function GalleryView({ t, galleryKey }) {\n  const gallery = galleryByKey(galleryKey)\n  const label = gallery ? gallery.label : galleryKey\n  const path = gallery && gallery.path\n  const changeEvent = `zr:gallery-changed:${galleryKey}`\n  const otherGalleries = POINTER_GALLERIES.filter((g) => g.key !== galleryKey)\n\n  const [data, setData] = React.useState(null)\n  const [ouvert, setOuvert] = React.useState(null) // item en lightbox, ou null\n  const [folderId, setFolderId] = React.useState(null) // dossier ouvert, ou null = racine\n  const [renamingId, setRenamingId] = React.useState(null)\n  const [overId, setOverId] = React.useState(null) // survol drag (surbrillance de la cible)\n  const [dragOverGrid, setDragOverGrid] = React.useState(false) // fichier Finder survolant la grille\n  const [uploading, setUploading] = React.useState(0) // compte en cours, 0 = rien\n  const [menu, setMenu] = React.useState(null) // { x, y, it } | null\n  // DISPOSITION (2026-08-21). Deux vues du MÊME contenu, jamais deux stockages : « Grille » est la\n  // planche Explore d'origine, « Alignées » est la table lumineuse — tuiles au même gabarit, remises\n  // en ordre à la main. Le mode vit en local (localStorage), par galerie : c'est une préférence de\n  // regard, pas une donnée du drive, et l'écrire sur GitHub ferait un commit par clic de bouton.\n  const [layout, setLayout] = React.useState(() => {\n    try { return localStorage.getItem(`zr:gallery:layout:${galleryKey}`) === 'aligned' ? 'aligned' : 'grid' } catch { return 'grid' }\n  })\n  React.useEffect(() => { try { localStorage.setItem(`zr:gallery:layout:${galleryKey}`, layout) } catch {} }, [layout, galleryKey])\n  const [insert, setInsert] = React.useState(null) // { id, side } — barre d'insertion du mode aligné\n  const shaRef = React.useRef(null)\n\n  React.useEffect(() => {\n    if (!path) return undefined\n    let vivant = true\n    readJson(path).then(({ data: lu, sha }) => {\n      if (!vivant) return\n      shaRef.current = sha\n      setData(lu && typeof lu === 'object' ? lu : { v: 1, items: [] })\n    }).catch(() => { if (vivant) setData({ v: 1, items: [] }) })\n    return () => { vivant = false }\n  }, [path])\n\n  // Même convention événementielle que Goals (`zr:goals-changed`) : un ajout posé ailleurs (clic\n  // droit dans Create) doit apparaître ici sans recharger la page. Un canal PAR galerie (suffixe\n  // `galleryKey`) : un ajout à Characters ne doit jamais déclencher un rechargement sur Environments.\n  React.useEffect(() => {\n    if (!path) return undefined\n    const surAjout = () => {\n      readJson(path).then(({ data: lu, sha }) => { shaRef.current = sha; if (lu) setData(lu) }).catch(() => {})\n    }\n    window.addEventListener(changeEvent, surAjout)\n    return () => window.removeEventListener(changeEvent, surAjout)\n  }, [path, changeEvent])\n\n  const rootItems = data?.items || []\n  const currentFolder = folderId ? rootItems.find((it) => it.id === folderId && it.kind === 'folder') : null\n  // Le dossier ouvert a pu être retiré ailleurs (autre onglet, sync) : on revient à la racine plutôt\n  // que d'afficher une vue fantôme sur un id qui n'existe plus.\n  React.useEffect(() => { if (folderId && data && !currentFolder) setFolderId(null) }, [folderId, data, currentFolder])\n  const items = currentFolder ? (currentFolder.items || []) : rootItems\n\n  // UN SEUL POINT DE PASSAGE pour toute mutation du niveau AFFICHÉ (racine, ou le tableau `items` d'un\n  // dossier ouvert) : jamais deux endroits qui doivent se souvenir séparément « suis-je dans un\n  // dossier ». Utilisé aussi bien pour l'état optimiste local que pour le retry anti-conflit.\n  const mutateLevel = (cur, f) => {\n    const root = (cur && cur.items) || []\n    if (!folderId) return { ...(cur || {}), v: 1, items: f(root) }\n    return { ...(cur || {}), v: 1, items: root.map((it) => (it.id === folderId && it.kind === 'folder') ? { ...it, items: f(it.items || []) } : it) }\n  }\n  const ecrire = async (f, erreurTitre) => {\n    const next = mutateLevel(data, f)\n    setData(next)\n    const res = await saveJsonWithRetry(path, (cur) => mutateLevel(cur, f), { sha: shaRef.current, data })\n    if (res.ok) shaRef.current = res.sha\n    else notify({ kind: 'error', label, title: erreurTitre, body: 'Réessaie, un conflit a empêché l’écriture.' })\n    return res.ok\n  }\n  // Rename opère sur le dossier LUI-MÊME, qui vit toujours à la racine (jamais de dossier dans un\n  // dossier) — que l'on renomme depuis la grille (dehors) ou depuis le fil d'Ariane (dedans), la\n  // cible est la même liste racine, jamais `mutateLevel` (qui viserait le CONTENU du dossier).\n  const renommerDossier = async (id, name) => {\n    const appliquer = (cur) => ({ ...(cur || {}), v: 1, items: ((cur && cur.items) || []).map((it) => it.id === id ? { ...it, name } : it) })\n    setData(appliquer)\n    const res = await saveJsonWithRetry(path, appliquer, { sha: shaRef.current, data })\n    if (res.ok) shaRef.current = res.sha\n  }\n  const retirer = (id) => ecrire((list) => list.filter((it) => it.id !== id), 'Retrait non enregistré')\n\n  // TITRE + NOTE. Un dossier vit TOUJOURS à la racine (jamais de dossier dans un dossier), donc il ne\n  // se modifie pas par `ecrire`, qui vise le niveau AFFICHÉ — la même asymétrie que `renommerDossier`\n  // juste au-dessus, et la raison pour laquelle les deux chemins restent séparés.\n  const enregistrerTexte = async (it, { name, note }) => {\n    setRenamingId(null)\n    // Groupe : le champ saisi EST son nom. Image : c'est un titre facultatif, posé à côté du `name`\n    // technique, qu'on ne touche jamais — il sert au partage, au menu et au nom de fichier exporté.\n    const champs = it.kind === 'folder' ? { name: name || '', note: note || '' } : { title: name || '', note: note || '' }\n    if (it.kind === 'folder') {\n      const appliquer = (cur) => ({ ...(cur || {}), v: 1, items: ((cur && cur.items) || []).map((x) => x.id === it.id ? { ...x, ...champs } : x) })\n      setData(appliquer)\n      const res = await saveJsonWithRetry(path, appliquer, { sha: shaRef.current, data })\n      if (res.ok) shaRef.current = res.sha\n      else notify({ kind: 'error', label, title: 'Texte non enregistré', body: 'Réessaie, un conflit a empêché l’écriture.' })\n      return\n    }\n    await ecrire((list) => list.map((x) => x.id === it.id ? { ...x, ...champs } : x), 'Texte non enregistré')\n  }\n\n  // ── REMISE EN ORDRE À LA MAIN (2026-08-21) ────────────────────────────────────────────────────────\n  // Mécanique reprise TELLE QUELLE du Shelf (src/components/Shelf.jsx, `dragApi.dropOn` et `sideOf`),\n  // qui la porte depuis des mois et qui marche : on retire l'élément de la liste, puis on le réinsère\n  // AVANT ou APRÈS la cible selon la moitié survolée. Retirer d'abord et chercher l'index ensuite\n  // n'est pas un détail de style : chercher l'index avant le retrait décale l'insertion d'un cran dès\n  // qu'on déplace un élément vers la droite, et le bug ne se voit que dans ce sens-là.\n  //\n  // POURQUOI UN MODE ET PAS UN GESTE DE PLUS. Dans la grille, lâcher une image sur une autre CRÉE UN\n  // GROUPE. Le même geste ne peut pas vouloir dire deux choses ; c'est la disposition qui tranche, et\n  // le mode est visible à l'écran, donc le geste n'est jamais ambigu.\n  const reordonner = async (fromId, targetId, after) => {\n    setInsert(null)\n    if (!fromId || fromId === targetId) return\n    await ecrire((list) => {\n      const a = [...list]\n      const fi = a.findIndex((x) => x.id === fromId)\n      if (fi < 0) return list\n      const [deplace] = a.splice(fi, 1)\n      const ti = a.findIndex((x) => x.id === targetId)\n      if (ti < 0) a.push(deplace); else a.splice(after ? ti + 1 : ti, 0, deplace)\n      return a\n    }, 'Ordre non enregistré')\n  }\n  const cote = (e) => { const r = e.currentTarget.getBoundingClientRect(); return e.clientX > r.left + r.width / 2 ? 'right' : 'left' }\n\n  // ── COLLER / GLISSER UN MÉDIA (2026-08-21) ────────────────────────────────────────────────────────\n  // Même chemin, prouvé ailleurs dans l'app (Articles, Shelf, Gallery.jsx) : conversion WebP CÔTÉ\n  // NAVIGATEUR (quasi instantanée via canvas.toBlob, contrairement à AVIF qui coûte cher à ENCODER),\n  // puis `/api/img` — déjà une route API qui écrit directement sur GitHub, jamais le pipeline CLI de\n  // l'archiveur ZenRayCloud. Encodage en parallèle par lots de 4 (CPU), envoi en SÉRIE (chaque\n  // /api/img = un commit GitHub, sérialiser évite des conflits de commit concurrents).\n  async function addFiles(fileList) {\n    const imgs = [...fileList].filter((f) => f.type && f.type.startsWith('image/'))\n    if (!imgs.length) return\n    setUploading((n) => n + imgs.length)\n    const added = []\n    const ENC = 4\n    for (let i = 0; i < imgs.length; i += ENC) {\n      const enc = await Promise.all(imgs.slice(i, i + ENC).map(async (f) => {\n        let w = 4, h = 3\n        try { const bmp = await createImageBitmap(f); w = bmp.width; h = bmp.height } catch {}\n        const webp = await fileToWebp(f).catch(() => null)\n        return webp ? { webp, w, h, name: f.name } : null\n      }))\n      for (const e of enc) {\n        if (!e) continue\n        const j = await fetch('/api/img', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ dataUrl: e.webp, dir: 'uploads' }) }).then((r) => r.json()).catch(() => null)\n        if (j && j.path) added.push({ id: `g-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`, kind: 'image', path: j.path, name: e.name, w: e.w, h: e.h, addedAt: new Date().toISOString() })\n      }\n    }\n    setUploading((n) => Math.max(0, n - imgs.length))\n    if (!added.length) return\n    await ecrire((list) => [...list, ...added], 'Import non enregistré')\n  }\n  useClipboardTarget('gallery:' + galleryKey, { onPasteImage: (files) => addFiles(files) }, true)\n  const onGridDragOver = (e) => { if (![...e.dataTransfer.types].includes('Files')) return; e.preventDefault(); setDragOverGrid(true) }\n  const onGridDragLeave = () => setDragOverGrid(false)\n  const onGridDrop = (e) => {\n    if (!e.dataTransfer.files || !e.dataTransfer.files.length) return\n    e.preventDefault(); setDragOverGrid(false)\n    addFiles(e.dataTransfer.files)\n  }\n\n  // ── GROUPES PAR GLISSER-DÉPOSER (2026-08-21) ──────────────────────────────────────────────────────\n  // Un seul niveau, jamais de dossier dans un dossier — la même règle qu'iOS. Glisser une image sur\n  // une AUTRE image crée un groupe ; glisser une image sur un groupe l'y ajoute ; un DOSSIER glissé ne\n  // s'imbrique jamais nulle part (on l'ignore silencieusement, comme iOS refuse un dossier dans un\n  // dossier sans le dire non plus).\n  const DND_TYPE = 'application/zenray-gallery-item'\n  const onItemDragStart = (it) => (e) => { e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData(DND_TYPE, it.id) }\n  const onItemDragOver = (it) => (e) => {\n    if (![...e.dataTransfer.types].includes(DND_TYPE)) return // laisse filer un glisser Finder externe\n    e.preventDefault(); e.stopPropagation(); setOverId(it.id)\n  }\n  const onItemDragLeave = (it) => () => setOverId((o) => (o === it.id ? null : o))\n  const onItemDrop = (target) => async (e) => {\n    const draggedId = e.dataTransfer.getData(DND_TYPE)\n    setOverId(null)\n    if (!draggedId || draggedId === target.id) return\n    e.preventDefault(); e.stopPropagation()\n    const dragged = items.find((x) => x.id === draggedId)\n    if (!dragged || dragged.kind === 'folder') return\n    let nouveauId = null\n    const f = target.kind === 'folder'\n      ? (list) => list.filter((x) => x.id !== draggedId).map((x) => x.id === target.id ? { ...x, items: [...(x.items || []), dragged] } : x)\n      : (list) => {\n        nouveauId = `f-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`\n        return list.filter((x) => x.id !== draggedId).map((x) => x.id === target.id\n          ? { id: nouveauId, kind: 'folder', name: 'Nouveau groupe', items: [x, dragged], addedAt: new Date().toISOString() }\n          : x)\n      }\n    const ok = await ecrire(f, 'Regroupement non enregistré')\n    if (ok && nouveauId) setRenamingId(nouveauId) // le nom se propose tout de suite, prêt à taper\n  }\n\n  // ── DÉPLACER VERS… (menu, alternative au glisser) ─────────────────────────────────────────────────\n  const rootFolders = rootItems.filter((x) => x.kind === 'folder')\n  const deplacerVers = async (it, targetFolderId) => {\n    if (it.kind === 'folder') return\n    const appliquer = (cur) => {\n      const root = (cur && cur.items) || []\n      const source = folderId\n        ? root.map((x) => x.id === folderId ? { ...x, items: (x.items || []).filter((y) => y.id !== it.id) } : x)\n        : root.filter((x) => x.id !== it.id)\n      if (targetFolderId === null) return { ...(cur || {}), v: 1, items: folderId ? [...source, it] : source }\n      return { ...(cur || {}), v: 1, items: source.map((x) => x.id === targetFolderId ? { ...x, items: [...(x.items || []), it] } : x) }\n    }\n    setData(appliquer)\n    const res = await saveJsonWithRetry(path, appliquer, { sha: shaRef.current, data })\n    if (res.ok) shaRef.current = res.sha\n    else notify({ kind: 'error', label, title: 'Déplacement non enregistré', body: 'Réessaie, un conflit a empêché l’écriture.' })\n  }\n\n  // ── COPIER / COUPER / PARTAGER (2026-08-21) ───────────────────────────────────────────────────────\n  const blobOfItem = async (it) => {\n    const url = isRawUpload(it.path) ? rawUrl(it.path) : await (async () => {\n      const m = await readImgManifestCached(it.path)\n      return m ? await resolveFullUrl(m) : null\n    })()\n    if (!url) return null\n    return fetch(url).then((r) => (r.ok ? r.blob() : null)).catch(() => null)\n  }\n  const copier = async (it) => {\n    const blob = await blobOfItem(it)\n    if (!blob) return notify({ kind: 'error', label, title: 'Copie impossible', body: 'Image introuvable.' })\n    try {\n      await navigator.clipboard.write([new ClipboardItem({ [blob.type || 'image/webp']: blob })])\n      notify({ kind: 'info', label, title: 'Copié', body: it.name || 'Image copiée dans le presse-papiers.' })\n    } catch { notify({ kind: 'error', label, title: 'Copie impossible', body: 'Le navigateur a refusé l’accès au presse-papiers.' }) }\n  }\n  const couper = async (it) => { await copier(it); retirer(it.id) }\n  const partager = async (it) => {\n    const blob = await blobOfItem(it)\n    if (!blob) return notify({ kind: 'error', label, title: 'Partage impossible', body: 'Image introuvable.' })\n    const file = new File([blob], (it.name || 'image').replace(/\\.[a-z0-9]+$/i, '') + '.' + (blob.type.split('/')[1] || 'webp'), { type: blob.type })\n    if (navigator.canShare && navigator.canShare({ files: [file] })) {\n      try { await navigator.share({ files: [file], title: it.name || label }); return } catch { return } // annulé : pas d'erreur à montrer\n    }\n    // Repli desktop : seul un chemin uploads/ (posé par /api/img) a un lien PUBLIC stable. Un\n    // manifeste Create est chiffré au repos — rien à lier, seule l'image elle-même se partage.\n    if (isRawUpload(it.path)) {\n      const shareUrl = `${location.origin}${rawUrl(it.path)}`\n      try { await navigator.clipboard.writeText(shareUrl); notify({ kind: 'info', label, title: 'Lien copié', body: shareUrl }) }\n      catch { notify({ kind: 'error', label, title: 'Partage impossible', body: 'Copie du lien refusée.' }) }\n      return\n    }\n    await copier(it)\n    notify({ kind: 'info', label, title: 'Copié (partage indisponible)', body: 'Colle l’image où tu veux la partager.' })\n  }\n\n  // ── PONT VERS CREATE (2026-08-21) ─────────────────────────────────────────────────────────────────\n  // GalleryView est un module séparé (lazy-chargé) sans accès aux fermetures d'App.jsx. Plutôt que\n  // dupliquer `trashPath` (move + sidecar + retry) ou `runCapture` (tout le pipeline d'ingestion), on\n  // les rappelle via un événement écouté là-bas — même geste que `zr:open-page`. `resolve` rend\n  // l'appel attendable sans construire un vrai bus RPC ; un filet de 8 s évite de rester bloqué si\n  // personne n'écoute.\n  const dispatchAndWait = (name, detail) => new Promise((resolve) => {\n    window.dispatchEvent(new CustomEvent(name, { detail: { ...detail, resolve } }))\n    setTimeout(() => resolve(false), 8000)\n  })\n  const envoyerVersCreate = async (it) => {\n    const blob = await blobOfItem(it)\n    if (!blob) return notify({ kind: 'error', label, title: 'Envoi impossible', body: 'Image introuvable.' })\n    const file = new File([blob], (it.name || 'image').replace(/\\.[a-z0-9]+$/i, '') + '.' + (blob.type.split('/')[1] || 'webp'), { type: blob.type })\n    const ok = await dispatchAndWait('zr:gallery-send-to-create', { file })\n    if (ok) { retirer(it.id); notify({ label, title: 'Envoyé dans Create', body: it.name || '' }) }\n    else notify({ kind: 'error', label, title: 'Envoi échoué', body: 'Create n’a pas confirmé la réception.' })\n  }\n  const supprimerDeCreate = async (it) => {\n    if (!window.confirm(`Supprimer « ${it.name || 'cette image'} » de Create ? Elle ira dans Trash, récupérable.`)) return\n    const ok = await dispatchAndWait('zr:gallery-delete-from-create', { path: it.path })\n    if (ok) retirer(it.id)\n  }\n\n  // ── MENU CLIC DROIT (2026-08-21, demande Matthieu : l'ancien bouton « × » au survol était une seule\n  // option sans nom ni contexte — « pas logique »). Chaque action se montre ou se désactive selon ce\n  // qui a RÉELLEMENT un sens pour cet item précis, plutôt que d'exposer huit boutons dont la moitié ne\n  // font rien : un dossier ne se copie pas, un item posé par collage n'est « dans Create » nulle part\n  // à en retirer, un item déjà brut n'a rien à y envoyer une seconde fois.\n  const menuNodesFor = (it) => {\n    const isFolder = it.kind === 'folder'\n    const raw = !isFolder && isRawUpload(it.path)\n    const cibles = []\n    if (folderId) cibles.push({ id: 'to-root', label: `${label} (racine)`, icon: <Icon name=\"chevron.left\" size={14} />, action: () => deplacerVers(it, null) })\n    for (const f of rootFolders) {\n      if (folderId === f.id) continue\n      if (!folderId && f.id === it.id) continue\n      cibles.push({ id: `to-${f.id}`, label: f.name, icon: <Icon name=\"folder\" size={14} />, action: () => deplacerVers(it, f.id) })\n    }\n    return [\n      { id: 'open', label: isFolder ? 'Ouvrir' : 'Ouvrir en plein écran', icon: <Icon name=\"arrow.up.right\" size={14} />, action: () => (isFolder ? setFolderId(it.id) : setOuvert(it)) },\n      { id: 'text', label: 'Titre et note…', icon: <Icon name=\"doc.text\" size={14} />, action: () => setRenamingId(it.id) },\n      { id: 'move', label: 'Déplacer vers…', icon: <Icon name=\"folder\" size={14} />, disabled: isFolder || !cibles.length, children: isFolder ? [] : cibles },\n      !isFolder && { id: 'copy', label: 'Copier', icon: <Icon name=\"doc.text\" size={14} />, action: () => copier(it) },\n      !isFolder && { id: 'cut', label: 'Couper', icon: <Icon name=\"scissors\" size={14} />, action: () => couper(it) },\n      !isFolder && { id: 'share', label: 'Partager…', icon: <Icon name=\"arrow.up.right\" size={14} />, action: () => partager(it) },\n      { id: 'add-to', label: 'Ajouter à…', icon: <Icon name=\"photo\" size={14} />, disabled: isFolder, children: isFolder ? [] : otherGalleries.map((g) => ({\n        id: `add-${g.key}`, label: g.label, action: () => ajouterAGalerie(g.key, [{ kind: it.kind, path: it.path, name: it.name, w: it.w, h: it.h }]),\n      })) },\n      !isFolder && { id: 'to-create', label: 'Déplacer dans Create', icon: <Icon name=\"arrow.up.right\" size={14} />, disabled: !raw, action: () => envoyerVersCreate(it) },\n      { id: 'remove', label: `Retirer de ${label}`, icon: <Icon name=\"xmark\" size={14} />, action: () => retirer(it.id) },\n      !isFolder && { id: 'delete-create', label: 'Supprimer de Create', icon: <Icon name=\"trash\" size={14} />, danger: true, disabled: raw, action: () => supprimerDeCreate(it) },\n    ].filter(Boolean)\n  }\n\n  // ── UNE SEULE DÉFINITION DE TUILE, DEUX JEUX DE PARAMÈTRES (2026-08-21) ───────────────────────────\n  // Loi HDA appliquée au rendu : la grille et la table lumineuse ne diffèrent que par trois valeurs —\n  // le format de la tuile, la largeur qu'elle occupe, et ce que veut dire un lâcher dessus. Dupliquer\n  // le rendu pour ces trois-là aurait donné deux tuiles qui divergent dès le premier champ ajouté.\n  const rendreTuile = (it, aligne) => {\n    // 16:9 OU PROCHE, DONC 2 CASES en grille : une image horizontale écrasée dans une seule case\n    // devient trop petite. Seuil large (1,3) plutôt que 16:9 exact (1,78), pour capter le « proche »\n    // sans mordre sur le quasi-carré. En mode aligné, toutes les tuiles partagent le MÊME gabarit :\n    // c'est exactement ce qu'on demande à une table lumineuse, comparer des images entre elles.\n    const large = !aligne && it.kind === 'image' && it.w && it.h && it.w / it.h >= 1.3\n    const ratio = aligne ? '4 / 3' : (it.w && it.h ? `${it.w} / ${it.h}` : '4 / 5')\n    const surLigne = insert && insert.id === it.id ? insert.side : null\n    const editing = renamingId === it.id\n    const ouvrirEditeur = () => setRenamingId(it.id)\n    // GLISSER : deux sens selon la disposition, jamais deux sens dans la même vue. En grille, lâcher\n    // sur une tuile REGROUPE ; en aligné, lâcher REMET EN ORDRE. Le mode est affiché, donc le geste\n    // n'est jamais ambigu pour la main qui le fait.\n    const dragProps = aligne ? {\n      draggable: true,\n      onDragStart: onItemDragStart(it),\n      onDragOver: (e) => { if (![...e.dataTransfer.types].includes(DND_TYPE)) return; e.preventDefault(); e.stopPropagation(); setInsert({ id: it.id, side: cote(e) }) },\n      onDragLeave: () => setInsert((v) => (v && v.id === it.id ? null : v)),\n      onDrop: (e) => { const from = e.dataTransfer.getData(DND_TYPE); if (!from) return; e.preventDefault(); e.stopPropagation(); reordonner(from, it.id, cote(e) === 'right') },\n      onContextMenu: (e) => { e.preventDefault(); e.stopPropagation(); setMenu({ x: e.clientX, y: e.clientY, it }) },\n    } : {\n      draggable: true,\n      onDragStart: onItemDragStart(it),\n      onDragOver: onItemDragOver(it),\n      onDragLeave: onItemDragLeave(it),\n      onDrop: onItemDrop(it),\n      onContextMenu: (e) => { e.preventDefault(); e.stopPropagation(); setMenu({ x: e.clientX, y: e.clientY, it }) },\n      style: overId === it.id ? { outline: '2px solid #0a84ff', outlineOffset: 2, borderRadius: 4 } : undefined,\n    }\n    return (\n      <div key={it.id} className=\"zr-tap\" style={{ position: 'relative', gridColumn: large ? 'span 2' : undefined }}>\n        {/* Barre d'insertion lumineuse, reprise du Shelf : elle montre OÙ la tuile va se poser avant\n            qu'on lâche. Décalée de 5 px dans la gouttière de 10 px, donc centrée entre deux tuiles. */}\n        {surLigne && <span aria-hidden style={{ position: 'absolute', top: 0, bottom: 0, [surLigne]: -5, width: 4, borderRadius: 4, background: t.accent, boxShadow: `0 0 12px 1px ${t.accent}`, zIndex: 6 }} />}\n        {it.kind === 'image' ? (\n          <div {...dragProps}\n            style={{ width: '100%', aspectRatio: ratio, position: 'relative', borderRadius: 4, overflow: 'hidden', cursor: editing ? 'default' : 'zoom-in', ...(dragProps.style || {}) }}\n            onClick={() => { if (!editing) setOuvert(it) }}>\n            <GalleryThumb path={it.path} alt={it.name} style={{ width: '100%', height: '100%', objectFit: 'cover', display: 'block' }} />\n            <TileCaption title={it.title} note={it.note} onEdit={ouvrirEditeur} />\n            {editing ? <TileEditor item={it} onSave={(v) => enregistrerTexte(it, v)} onCancel={() => setRenamingId(null)} /> : null}\n          </div>\n        ) : (\n          <FolderTile folder={it} ratio={aligne ? '4 / 3' : '4 / 5'} editing={editing}\n            onOpen={() => { if (!editing) setFolderId(it.id) }}\n            onEdit={ouvrirEditeur}\n            onSave={(v) => enregistrerTexte(it, v)}\n            onCancel={() => setRenamingId(null)}\n            dragProps={dragProps} />\n        )}\n        <button type=\"button\" className=\"zr-gallery-remove\" title={`Retirer de ${label}`} aria-label={`Retirer de ${label}`}\n          onClick={(e) => { e.stopPropagation(); retirer(it.id) }}\n          style={{\n            position: 'absolute', top: 6, right: 6, width: 24, height: 24, borderRadius: 999,\n            border: 0, background: 'rgba(0,0,0,.55)', color: '#fff', display: 'grid', placeItems: 'center',\n            cursor: 'pointer', opacity: 0, transition: 'opacity .15s ease', zIndex: 4,\n          }}\n          onMouseEnter={(e) => e.stopPropagation()}>\n          <Icon name=\"xmark\" size={11} color=\"#fff\" />\n        </button>\n      </div>\n      </div>\n    )\n  }\n\n  return (\n    <div style={{ maxWidth: 1400, margin: '0 auto', padding: '4px 0 40px' }}>\n      {/* FIL D'ARIANE MINIMAL (2026-08-21). Volontairement PAS le composant `Crumbs` de Create : celui-là\n          est profondément couplé à sa propre navigation (colonnes façon Finder, glisser pour déplacer une\n          vraie page, historique) pour un chemin qui ne fait jamais que DEUX niveaux ici. Même famille\n          typographique que le titre existant pour rester cohérent à l'œil, sans en importer la mécanique.\n          Le segment actif EST le champ de renommage : un clic dessus l'édite, exactement comme dans Shelf. */}\n      <div style={{ marginBottom: 12, display: 'flex', alignItems: 'center', gap: 6, minHeight: 22 }}>\n        {currentFolder ? (\n          <>\n            <h1 onClick={() => setFolderId(null)} title={`Retour à ${label}`}\n              style={{ margin: 0, font: \"500 16px/1.3 var(--zr-police-sans)\", color: t.textSecondary, cursor: 'pointer' }}>{label}</h1>\n            <Icon name=\"chevron.right\" size={11} color={t.textSecondary} />\n            {renamingId === currentFolder.id ? (\n              <input autoFocus defaultValue={currentFolder.name} title=\"Renommer\"\n                onKeyDown={(e) => { if (e.key === 'Enter') e.currentTarget.blur() }}\n                onBlur={(e) => { const v = e.target.value.trim(); setRenamingId(null); if (v && v !== currentFolder.name) renommerDossier(currentFolder.id, v) }}\n                style={{ font: \"500 16px/1.3 var(--zr-police-sans)\", color: t.textPrimary, background: 'transparent', border: 'none', borderBottom: `1px solid ${t.textSecondary}`, outline: 'none', padding: 0 }} />\n            ) : (\n              <h1 onClick={() => setRenamingId(currentFolder.id)} title=\"Cliquer pour renommer\"\n                style={{ margin: 0, font: \"500 16px/1.3 var(--zr-police-sans)\", color: t.textPrimary, cursor: 'text' }}>{currentFolder.name}</h1>\n            )}\n          </>\n        ) : (\n          <h1 style={{ margin: 0, font: \"500 16px/1.3 var(--zr-police-sans)\", color: t.textSecondary }}>{label}</h1>\n        )}\n        {uploading > 0 && <span style={{ font: \"400 12px var(--zr-police-sans)\", color: t.textSecondary }}>· import {uploading}…</span>}\n        <span style={{ flex: 1 }} />\n        {/* BASCULE DE DISPOSITION. Deux segments, pas un menu : il n'y a que deux états et ils se lisent\n            en entier, donc les cacher derrière un déclencheur coûterait un clic pour rien. Texte en Inter\n            Regular 400, la règle du trio typographique pour tout ce qui est chrome d'interface. */}\n        <div role=\"group\" aria-label=\"Disposition\" style={{ display: 'inline-flex', gap: 2, padding: 2, borderRadius: 8, background: 'rgba(128,128,128,.12)' }}>\n          {[{ k: 'grid', l: 'Grille', i: 'square.grid.2x2' }, { k: 'aligned', l: 'Alignées', i: 'square.grid.3x3' }].map((m) => {\n            const on = layout === m.k\n            return (\n              <button key={m.k} type=\"button\" onClick={() => setLayout(m.k)} aria-pressed={on}\n                title={m.k === 'grid' ? 'Grille — glisser une image sur une autre forme un groupe' : 'Alignées — glisser pour remettre en ordre'}\n                style={{\n                  display: 'inline-flex', alignItems: 'center', gap: 5, padding: '3px 9px', borderRadius: 6, border: 0, cursor: 'pointer',\n                  background: on ? t.surface : 'transparent', color: on ? t.textPrimary : t.textSecondary,\n                  font: '400 12px var(--zr-police-sans)', boxShadow: on ? '0 1px 3px rgba(0,0,0,.14)' : 'none',\n                }}>\n                <Icon name={m.i} size={12} color={on ? t.textPrimary : t.textSecondary} />{m.l}\n      