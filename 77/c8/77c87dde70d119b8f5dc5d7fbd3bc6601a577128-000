ef(new Set())\n  // finder-core-8 : retourne un booléen (succès) pour que pasteClip puisse agréger les résultats d'un cut\n  // multiple, conserver le presse-papier sur échec partiel, et notifier honnêtement (X déplacés, Y échoués).\n  // AJOUT AU CACHE DESTINATION (2026-07-06, bug réel « médias disparus ») : un déplacement n'écrivait\n  // JAMAIS le cache du dossier cible -> avec le cache désormais persistant (localStorage), ouvrir la\n  // destination montrait l'ancien listing SANS les éléments déplacés (ils semblaient perdus jusqu'à la\n  // revalidation réseau). On pousse l'entrée déplacée dans le cache cible ; si le dossier cible est\n  // AFFICHÉ (cas rare), l'écran est déjà revalidé par le loadDir de fin d'op.\n  const addToDestCache = (toFolder, entry) => {\n    if (!entry) return\n    mutateDirCache(toFolder, (es) => es.some((x) => x.dir === entry.dir) ? es : [...es, entry])\n  }\n  // opts.batch (2026-07-06, fluidité multi-déplacement) : pendant un LOT, chaque move NE déclenche NI\n  // loadTree() NI la resynchro d'échec (dropDirCache+loadDir) — la vérité serveur mi-déplacée écraserait\n  // l'état optimiste (tuiles qui réapparaissent puis clignotent, le « pas fluide » constaté). Le lot fait\n  // UNE seule resynchro à la fin. opts.entry : l'entrée d'origine, pour peupler le cache destination.\n  const movePage = async (fromPath, toFolder, opts = {}) => {\n    if (movingRef.current.has(fromPath)) { setStatus('déplacement déjà en cours…'); return false }\n    movingRef.current.add(fromPath)\n    try { return await movePageInner(fromPath, toFolder, opts) } finally { movingRef.current.delete(fromPath) }\n  }\n  const movePageInner = async (fromPath, toFolder, opts = {}) => {\n    // BUG trouvé 2026-07-01 : 'file' (archive/blob-raw, .file.json) manquait dans cette regex -> hasLeaf\n    // retombait à false pour un fichier brut -> le code le traitait comme un DOSSIER (route move-tree) au\n    // lieu d'un nœud-feuille (route move). Conséquence : fromBase gardait l'extension \".file.json\" collée\n    // au nom, newBase devenait \".../mon-fichier.file.json/mon-fichier.file.json\" (double segment), et le\n    // serveur (move-tree, générique par préfixe) déplaçait bien le blob mais SOUS un chemin cassé. Corrigé :\n    // tous les types de nœuds-feuille (page/image/média/table/canvas/embed/fichier brut) sont dans hasLeaf.\n    const hasLeaf = typeOfPath(fromPath) !== 'folder'\n    const fromBase = hasLeaf ? stripLeafExt(fromPath) : fromPath // identité du nœud (sans extension feuille)\n    const folderName = fromBase.split('/').pop()\n    if (toFolder === fromBase || (toFolder + '/').startsWith(fromBase + '/')) { setStatus('move impossible (dans soi-même)'); return false }\n    // OPTIMISTE (T11) : la tuile déplacée quitte le dossier courant -> on la retire de l'UI ET du cache tout de suite.\n    optimisticDir((es) => es.filter((x) => x.dir !== fromBase && x.contentPath !== fromPath))\n    // Détection SOUS-ARBRE (page-avec-enfants) via l'API children = FIABLE, jamais tronquée. Avant : filtre sur\n    // l'index `paths` (tronqué sur gros repo) -> des enfants pouvaient manquer -> déplacement partiel silencieux\n    // (enfants orphelins). (D4 audit). Un dossier pur (!hasLeaf) est toujours un sous-arbre.\n    let hasChildren = false\n    if (hasLeaf) {\n      // P6 — Seule une page .md peut porter un sous-arbre (X.md + X/ sous-pages). Une feuille image / média /\n      // canvas / embed / db est TERMINALE par construction (l'app ne crée jamais de sous-page dessous) : pas de\n      // GET réseau bloquant sur le chemin le plus fréquent (déplacer une image). Garde-fou ZÉRO réseau : si\n      // l'index local `paths` révèle malgré tout des descendants sous cette feuille, on sonde quand même (l'API\n      // children reste la vérité fiable, jamais tronquée) -> jamais d'enfants orphelins, même état incohérent.\n      const needProbe = /\\.md$/.test(fromPath) || pathsRef.current.some((p) => p.startsWith(fromBase + '/'))\n      if (needProbe) { const cj = await fetch(`/api/page?action=children&dir=${encodeURIComponent(fromBase)}`, { cache: 'no-store' }).then((r) => r.json()).catch(() => null); hasChildren = !!(cj && Array.isArray(cj.entries) && cj.entries.length) }\n    }\n    const isSubtree = !hasLeaf || hasChildren\n    if (!isSubtree) {\n      const to = `${toFolder}/${fromPath.split('/').pop()}`\n      if (to === fromPath) return false\n      setStatus('déplacement…')\n      const j = await moveOne(fromPath, to)\n      if (j && j.ok) {\n        remapTags(fromPath, to, false); if (cur && cur.path === fromPath) setCur({ path: to })\n        // cache DESTINATION à jour tout de suite (entrée d'origine si fournie par le lot, sinon reconstruite)\n        const moved = opts.entry ? { ...opts.entry, dir: stripLeafExt(to), contentPath: to } : { name: to.split('/').pop(), contentPath: to, hasKids: false, dir: stripLeafExt(to), type: typeOfPath(to), isDb: /\\.db\\.json$/.test(to), isMedia: /\\.media\\.json$/.test(to), isImage: /\\.img\\.json$/.test(to) }\n        addToDestCache(toFolder, moved)\n        setStatus('déplacée ✓'); if (!opts.batch) loadTree(); return true\n      }\n      setStatus(j && j.error === 'exists' ? 'nom déjà pris' : 'erreur move ' + ((j && j.error) || ''))\n      if (!opts.batch) { dropDirCache(folder); loadDir(folder) } // en lot : UNE resynchro à la fin, pas ici\n      return false\n    }\n    // SOUS-ARBRE / DOSSIER : déplacement RÉCURSIF côté serveur (move-tree). Bouge TOUS les blobs sous le\n    // préfixe en 1 commit (y compris .m3u8/.hlskey.bin/.props.json non listés dans `paths`) et réécrit les\n    // refs de chemin internes (HLS) pour ne rien casser. Robuste vs l'ancienne approche par-nœud (incomplète).\n    const newBase = `${toFolder}/${folderName}`\n    setStatus('déplacement du dossier…')\n    // Page-AVEC-enfants : on déplace AUSSI le descripteur feuille (X.md + jumeaux), pas seulement le dossier X/\n    // enfants (sinon X.md restait orphelin à la source). Le move-tree juste après bouge le sous-arbre X/.\n    if (hasLeaf) { await moveOne(fromPath, `${newBase}${fromPath.slice(fromBase.length)}`) }\n    const j = await apiPost('move-tree', { from: fromBase, to: newBase }).catch(causeApi)\n    if (j && j.ok) {\n      // MISE A JOUR DES REGISTRES EN FOND, PAR LOTS. Le serveur a deplace les raccourcis par leur sha\n      // sans toucher leur registre (sinon la limite de sous-requetes du Worker explosait). On finit\n      // le travail ici, sans bloquer l affichage : le dossier est deja deplace et les images resolvent.\n      const aSync = Array.isArray(j.placementSync) ? j.placementSync : []\n      if (aSync.length) {\n        ;(async () => {\n          for (let i = 0; i < aSync.length; i += 15) {\n            await apiPost('sync-placements', { links: aSync.slice(i, i + 15) }).catch(() => {})\n          }\n        })()\n      }\n      remapTags(fromBase, newBase, true)\n      if (cur && (cur.path === fromPath || cur.path.startsWith(fromBase + '/'))) setCur(null)\n      const moved = opts.entry ? { ...opts.entry, dir: newBase, contentPath: hasLeaf ? `${newBase}${fromPath.slice(fromBase.length)}` : null } : { name: folderName, contentPath: hasLeaf ? `${newBase}${fromPath.slice(fromBase.length)}` : null, hasKids: true, dir: newBase, type: 'folder', isDb: false, isMedia: false, isImage: false }\n      addToDestCache(toFolder, moved)\n      dropDirCache(fromBase) // l'ancien listing du sous-arbre déplacé (chemins périmés) ne doit pas resservir\n      setStatus(`dossier déplacé ✓`); if (!opts.batch) loadTree()\n      if (!opts.batch) notify({ icon: 'folder', tint: PALETTE.primary, label: 'Déplacé', title: pgPretty(folderName), body: `Dossier déplacé dans ${toFolder} — ${j.moved} fichier(s).` })\n      return true\n    }\n    setStatus('erreur move dossier ' + ((j && (j.error + (j.detail ? ' · ' + j.detail : ''))) || ''))\n    if (!opts.batch) { dropDirCache(folder); loadDir(folder) }\n    return false\n  }\n  // C21/C22 : trash d'une entrée Finder, GÉNÉRALISÉ à tous les types de nœuds (page/image/média/base).\n  // Mécanisme = corbeille restaurable (soft delete) : on COPIE le ou les fichiers du nœud sous trash/<reste>,\n  // puis on supprime l'original dans pages/. On ne touche JAMAIS les binaires :\n  //  - image (.img.json) : le binaire + vignette restent sur le shard privé (référencés par hash) -> restaurables.\n  //  - média (.media.json) : les parts media/<id>/NNN.bin restent en place (chemin absolu stable) -> restaurables.\n  //    NB : on n'utilise PAS l'action delete serveur ici (elle purge les parts = perte définitive).\n  //  - base (.db.json) : un seul fichier.\n  //  - page (.md) : le .md + ses 3 jumeaux (.blocknote/.comments/.props.json).\n  // Les fichiers d'un nœud à déplacer, selon son type.\n  const trashTwins = (contentPath) => {\n    const ty = typeOfPath(contentPath)\n    if (ty === 'page') return [contentPath, ...['.blocknote.json', '.comments.json', '.props.json'].map((e) => contentPath.replace(/\\.md$/, e))]\n    return [contentPath] // image / média / base / autres : descripteur unique\n  }\n  // Métadonnées de suppression (sidecar). On lit le descripteur PRINCIPAL pour en extraire l'empreinte du\n  // binaire (contentHash), le drive porteur (zenray-media-NN / zenray-vid-NN) et la taille. Ces infos servent\n  // à (a) l'Undo (restaurer au chemin d'origine) et (b) la suppression définitive plus tard (refcount serveur).\n  const sidecarFor = (contentPath, descriptorText) => {\n    const ty = typeOfPath(contentPath)\n    let originalRepo = null, originalDrive = null, contentHash = null, fileSize = null\n    try {\n      const m = descriptorText ? JSON.parse(descriptorText) : null\n      if (m) {\n        if (m.repo) {\n          originalRepo = m.repo\n          // Famille générique zenray-<kind>-<vis>-NN + legacy (zenray-media = img/private, zenray-vid = vid/public).\n          const gm = /^(zenray-(?:img|vid|audio|doc|table|markdown)-(?:public|private))-\\d{2,}$/.exec(m.repo)\n          originalDrive = gm ? gm[1] + '-NN'\n            : /^zenray-vid-/.test(m.repo) ? 'zenray-vid-NN'\n            : /^zenray-media-/.test(m.repo) ? 'zenray-media-NN'\n            : null\n        }\n        if (typeof m.path === 'string') { const mm = m.path.match(/([0-9a-f]{16,64})\\.[A-Za-z0-9]+$/); if (mm) contentHash = mm[1] }\n        if (typeof m.size === 'number') fileSize = m.size\n        if (m.type === 'hls' || m.type === 'chunked-media') originalDrive = originalDrive || (m.type === 'hls' ? 'zenray-vid-NN' : 'zenray-media-NN')\n      }\n    } catch {}\n    return { v: 1, originalPath: contentPath, originalRepo, originalDrive, deletedAt: new Date().toISOString(), itemType: ty, contentHash, fileSize }\n  }\n  // Déplace un nœud (et ses jumeaux) vers trash/, et dépose UN sidecar de métadonnées à côté du descripteur.\n  // Déplace un nœud (et ses jumeaux) vers trash/ via l'action serveur ATOMIQUE `move` (commitTree + retry\n  // fast-forward) -> SÛR même lancé en parallèle avec d'autres trash/déplacements. On n'utilise PLUS save+delete :\n  //  (a) `delete` sur un .media.json PURGEAIT les parts média = perte définitive ; `move` ne touche aucun binaire.\n  //  (b) save+delete = 2 commits contents-API NON retryés -> 409 en parallèle ; `move` = 1 commit retryé.\n  // On lit le descripteur principal AVANT (pour le sidecar), puis on pose le sidecar best-effort.\n  const trashPath = async (contentPath) => {\n    let primaryText = null\n    try { const r = await fetch(`/api/page?action=read&path=${encodeURIComponent(contentPath)}`, { cache: 'no-store' }).then((x) => x.json()); if (r && !r.missing) primaryText = r.markdown } catch {}\n    const baseDst = 'trash/' + contentPath.replace(/^pages\\//, '')\n    let dst = baseDst, ok = false\n    for (let n = 0; n < 50; n++) {\n      const j = await apiPost('move', { from: contentPath, to: dst }).catch(causeApi)\n      if (j && j.ok) { ok = true; break }\n      if (j && j.error === 'exists') { const [b, x] = splitTypeExt(baseDst); dst = `${b}~${n + 2}${x}`; continue } // homonyme déjà en corbeille -> suffixe d'unicité\n      break // autre erreur -> RIEN perdu (move est non destructif tant qu'il échoue : la source reste intacte)\n    }\n    if (!ok) return { ok: false }\n    const meta = sidecarFor(contentPath, primaryText)\n    await apiPost('save', { path: dst + '.zrtrash.json', markdown: JSON.stringify(meta, null, 2) }).catch(() => {})\n    return { ok: true, dst }\n  }\n  // Restaure un nœud depuis trash/ vers son chemin d'origine (utilisé par l'Undo de la grosse notification).\n  // Recopie le descripteur + ses jumeaux vers pages/, supprime les copies de trash/ ET le sidecar.\n  const restoreFromTrash = async (contentPath) => {\n    const trashRoot = 'trash/' + contentPath.replace(/^pages\\//, '')\n    const twins = typeOfPath(contentPath) === 'page'\n      ? [trashRoot, trashRoot.replace(/\\.md$/, '.blocknote.json'), trashRoot.replace(/\\.md$/, '.comments.json'), trashRoot.replace(/\\.md$/, '.props.json')]\n      : [trashRoot]\n    for (const src of twins) {\n      const r = await fetch(`/api/page?action=read&path=${encodeURIComponent(src)}`, { cache: 'no-store' }).then((x) => x.json()).catch(() => null)\n      if (r && r.sha && !r.missing) {\n        const dst = 'pages/' + src.replace(/^trash\\//, '')\n        // Même ordre, même raison qu'au-dessus : la copie doit AVOIR ABOUTI avant qu'on supprime la\n        // source. `apiPost` lève sur un échec serveur, donc la ligne suivante ne s'exécute pas.\n        await apiPost('save', { path: dst, markdown: r.markdown })\n        await apiPost('delete', { path: src, sha: r.sha })\n      }\n    }\n    // Retire le sidecar de métadonnées.\n    const sc = trashRoot + '.zrtrash.json'\n    const sr = await fetch(`/api/page?action=read&path=${encodeURIComponent(sc)}`, { cache: 'no-store' }).then((x) => x.json()).catch(() => null)\n    if (sr && sr.sha && !sr.missing) await apiPost('delete', { path: sc, sha: sr.sha }).catch(() => {})\n  }\n  // Undo groupé + bascule vers la corbeille, réutilisés par toutes les grosses notifications de suppression.\n  const undoTrash = async (paths) => { setStatus('restauration…'); for (const p of paths) await restoreFromTrash(p); setStatus('restauré ✓'); loadTree(); notify({ icon: 'arrow.uturn.backward', tint: PALETTE.primary, label: 'Corbeille', title: `${paths.length} élément(s) restauré(s)`, body: 'Remis à leur emplacement d\\'origine.' }) }\n  const openTrash = () => { try { window.dispatchEvent(new CustomEvent('zr:navigate', { detail: 'trash' })) } catch {} }\n  const trashActions = (paths) => [{ label: 'Annuler', primary: true, onClick: () => undoTrash(paths) }, { label: 'Ouvrir la corbeille', onClick: openTrash }]\n  const delEntry = async (entry) => {\n    // DOSSIER (entrée sans contentPath, ou nœud qui a des sous-pages) -> suppression RÉCURSIVE : tout le\n    // sous-arbre part à la corbeille (+ le nœud-index lui-même s'il existe). Un dossier n'a pas de binaire propre.\n    const isFolder = !entry.contentPath || entry.hasKids\n    if (isFolder) {\n      // Pas de confirm : la notification \"déplacé dans Trash\" + Undo joue ce rôle (demande de Matthieu).\n      // OPTIMISTE : on retire la tuile de l'UI IMMÉDIATEMENT (ressenti instantané), le serveur suit.\n      optimisticDir((es) => es.filter((x) => x.dir !== entry.dir))\n      if (cur && (cur.path === entry.contentPath || (cur.path || '').startsWith(entry.dir + '/'))) setCur(null)\n      setStatus('→ corbeille…')\n      // FIABLE + RAPIDE : déplacement RÉCURSIF du dossier vers trash/ en 1 commit serveur (move-tree),\n      // au lieu de boucler sur `paths` (tronqué -> ratait des dossiers -> \"delete ne marche pas\").\n      const dest = 'trash/' + entry.dir.replace(/^pages\\//, '')\n      const j = await apiPost('move-tree', { from: entry.dir, to: dest }).catch(causeApi)\n      if (j && j.ok) {\n        setStatus('dossier en corbeille ✓'); loadPathsDebounced()\n        notify({ big: true, icon: 'trash', tint: '#FF9F0A', label: 'Corbeille', title: 'Votre contenu a été déplacé dans Trash', body: `Dossier « ${pgPretty(entry.name)} » (${j.moved} fichier(s)). Récupérable : aucun binaire supprimé du drive.`, actions: [\n          { label: 'Undo', primary: true, onClick: async () => { await apiPost('move-tree', { from: dest, to: entry.dir }).catch(() => {}); loadTree() } },\n          { label: 'Open Trash', onClick: () => setView('trash') },\n        ] })\n      } else { setStatus('erreur corbeille ' + ((j && j.error) || '')); dropDirCache(folder); loadDir(folder) } // re-sync : annule l'optimiste si échec\n      return\n    }\n    optimisticDir((es) => es.filter((x) => x.dir !== entry.dir)) // OPTIMISTE (pas de confirm : Undo dans la notif)\n    if (cur && cur.path === entry.contentPath) setCur(null)\n    setStatus('→ corbeille…')\n    const res = await trashPath(entry.contentPath)\n    if (!res.ok) { setStatus('erreur corbeille — rien perdu'); dropDirCache(folder); loadDir(folder); notify({ icon: 'exclamationmark.triangle', tint: '#FF3B30', label: 'Corbeille', title: 'Mise en corbeille incomplète', body: `« ${pgPretty(entry.name)} » : conflit pendant la suppression. La tuile est ré-affichée — réessaie.`, ttl: 9000 }); return }\n    setStatus('en corbeille ✓'); loadPathsDebounced()\n    notify({ big: true, icon: 'trash', tint: '#FF9F0A', label: 'Corbeille', title: 'Votre contenu a été déplacé dans Trash', body: `« ${pgPretty(entry.name)} » est récupérable. Le binaire reste sur le drive tant que la corbeille n'est pas vidée.`, actions: trashActions([entry.contentPath]) })\n  }\n  // Nouveau dossier. Git ne stocke pas de dossier VIDE : on crée le dossier AVEC une page de départ, puis on\n  // entre dedans. La page peut être renommée/supprimée ensuite ; le dossier disparaît quand il n'a plus d'enfant.\n  // Création façon macOS Finder : PAS de popup navigateur. On crée le dossier avec un nom par défaut puis on\n  // ouvre le RENOMMAGE INLINE (input intégré) sur la nouve