rie : ajouter une entrée au registre suffit,\n// Sidebar/App/le menu contextuel s'y adaptent tout seuls.\n//\n// Le but, dans les mots de Matthieu (à propos de Design, la première des trois) : « réunir dans une\n// galerie toutes les images que je trouve intéressantes pour pouvoir composer rapidement, hyper\n// rapidement, des interfaces ». Une forme de drive, un pointeur — pas une page à lire, une grille à\n// scanner. Alimentée par clic droit sur une image OU un dossier de Create (« Ajouter à… », voir\n// App.jsx), même logique que « Envoyer vers Goals » sur une sélection de texte. Depuis le 2026-08-21,\n// alimentée AUSSI en direct : coller (⌘V) ou glisser un fichier fait un aller-retour /api/img, et deux\n// images glissées l'une sur l'autre forment un groupe, à la iOS.\n//\n// RÉFÉRENCE VISUELLE (collage IMG_5065-5067_collage.png) : grille Explore Instagram. Masonry écarté\n// au profit d'une vraie grille 4 par rangée (`repeat(4, 1fr)`, demande de Matthieu) ; les images 16:9\n// ou proches (`w/h >= 1.3`) prennent 2 colonnes pour ne pas être écrasées en hauteur, sans\n// `grid-auto-flow: dense` — si ça ne tient pas dans la rangée, ça redescend nativement à la ligne.\nimport React from 'react'\nimport { createPortal } from 'react-dom'\nimport { readJson, saveJsonWithRetry } from '../lib/saveJson.js'\nimport { notify } from './Notifications.jsx'\nimport { readImgManifestCached, resolveThumbUrl, resolveFullUrl } from './ImageNodeViewer.jsx'\nimport Icon from './Icon.jsx'\nimport { galleryByKey, POINTER_GALLERIES } from '../config/pointerGalleries.js'\nimport { fileToWebp } from '../api.js'\nimport { useClipboardTarget } from '../clipboard/ClipboardProvider.jsx'\nimport { ActionColumnPopover } from './ActionColumnMenu.jsx'\n\nconst FONTS = { sans: \"var(--zr-police-sans)\", serif: \"var(--zr-police-serif)\" }\n\n// CHEMIN BRUT (uploads/…, posé par /api/img lors d'un collage ou d'un glisser direct) CONTRE\n// CHEMIN-MANIFESTE (posé depuis Create, un .img.json à déchiffrer). Deux origines, deux résolutions :\n// un chemin brut est déjà une image servable telle quelle, le faire passer par\n// `readImgManifestCached` tenterait de JSON.parse un binaire et échouerait en silence (vignette grise\n// à vie). `uploads/` est le seul préfixe que `/api/img` écrit pour ce cas, donc le seul test fiable.\nconst isRawUpload = (p) => !!p && p.startsWith('uploads/')\nconst rawUrl = (p) => `/api/img?path=${encodeURIComponent(p)}`\n\n// VIGNETTE. `Views.jsx` exporte bien un `MediaThumb`, mais il pointe l'<img> directement sur\n// `shardThumbUrl(m)` — l'URL jsDelivr de l'objet CHIFFRÉ. Correct pour les images publiques EN CLAIR\n// (ancien schéma), faux pour le schéma actuel (public mais chiffré AES-GCM) : le navigateur reçoit des\n// octets chiffrés, pas un WebP, et affiche l'icône cassée. `resolveThumbUrl`/`resolveFullUrl`\n// (ImageNodeViewer.jsx) sont les résolveurs ASYNC prévus pour ce cas hors-hook : ils déchiffrent et\n// rendent un objectURL affichable, avec repli automatique en clair si l'image ne l'est pas.\nfunction GalleryThumb({ path, alt, style }) {\n  const raw = isRawUpload(path)\n  const [url, setUrl] = React.useState(null)\n  React.useEffect(() => {\n    if (raw) return undefined // rien à résoudre, l'URL brute suffit déjà\n    let vivant = true\n    readImgManifestCached(path).then((m) => m && resolveThumbUrl(m)).then((u) => { if (vivant && u) setUrl(u) })\n    return () => { vivant = false }\n  }, [path, raw])\n  if (raw) return <img src={rawUrl(path)} alt={alt || ''} loading=\"lazy\" style={style} />\n  if (!url) return <div style={{ ...style, background: 'rgba(128,128,128,.10)' }} />\n  return <img src={url} alt={alt || ''} loading=\"lazy\" style={style} />\n}\n\n// Tuile plein écran au clic : même manifeste en cache que la vignette (`readImgManifestCached`),\n// seule la résolution PLEINE (`resolveFullUrl`, elle aussi déchiffrée) diffère de la vignette WebP.\n// PORTÉ vers <body> : un `position: fixed` posé dans l'arbre de la page (sous le conteneur défilant\n// `overflowY: auto` de la zone de contenu, App.jsx) casse dès qu'un ancêtre gagne un\n// transform/filter/contain, retombant relatif à CET ancêtre au lieu du viewport réel — l'image\n// s'ouvre alors décalée par rapport à l'endroit cliqué. Même correctif que le popover de Plan.\nfunction Lightbox({ path, name, onClose }) {\n  const raw = isRawUpload(path)\n  const [url, setUrl] = React.useState(null)\n  React.useEffect(() => {\n    if (raw) return undefined\n    let vivant = true\n    readImgManifestCached(path).then((m) => m && resolveFullUrl(m)).then((u) => { if (vivant && u) setUrl(u) })\n    return () => { vivant = false }\n  }, [path, raw])\n  const shown = raw ? rawUrl(path) : url\n  return createPortal((\n    <div onClick={onClose} style={{\n      position: 'fixed', inset: 0, zIndex: 4000, background: 'rgba(10,10,12,.88)',\n      display: 'grid', placeItems: 'center', padding: '5vh 5vw', cursor: 'zoom-out',\n    }}>\n      <button type=\"button\" onClick={onClose} aria-label=\"Fermer\" title=\"Fermer\" style={{\n        position: 'absolute', top: 18, right: 20, width: 34, height: 34, borderRadius: 999,\n        border: 0, background: 'rgba(255,255,255,.14)', color: '#fff', display: 'grid', placeItems: 'center', cursor: 'pointer',\n      }}><Icon name=\"xmark\" size={16} color=\"#fff\" /></button>\n      {shown ? (\n        <img src={shown} alt={name || ''} style={{ maxWidth: '100%', maxHeight: '90vh', borderRadius: 3, boxShadow: '0 30px 90px -20px rgba(0,0,0,.7)' }} onClick={(e) => e.stopPropagation()} />\n      ) : (\n        <div style={{ color: 'rgba(255,255,255,.6)', font: \"400 13px var(--zr-police-sans)\" }}>chargement…</div>\n      )}\n    </div>\n  ), document.body)\n}\n\n// FONDU 0,35 s : le contenu est REMONTÉ (key=folderId côté appelant) donc React le traite comme un\n// nouvel arbre, qui démarre à opacité 0 et rejoint 1 au montage — un fondu d'entrée simple, sans\n// machine à états ni double-montage ancien/nouveau. L'ancien contenu, lui, disparaît instantanément\n// au démontage : à l'œil, la transition reste fluide (rien ne saute brutalement à pleine opacité).\nfunction FadeIn({ children }) {\n  const [on, setOn] = React.useState(false)\n  React.useEffect(() => { const r = requestAnimationFrame(() => setOn(true)); return () => cancelAnimationFrame(r) }, [])\n  return <div style={{ opacity: on ? 1 : 0, transition: 'opacity .35s ease' }}>{children}</div>\n}\n\n// JETONS DE LA LÉGENDE (2026-08-21, second passage). Un seul endroit pour les valeurs qui se jugent\n// à l'œil : loi HDA, on tourne le bouton ici et toutes les tuiles suivent, images et groupes compris.\nconst LEGENDE = {\n  fond: 'rgba(0,0,0,.5)',       // noir semi-opaque à 50 %, valeur donnée par Matthieu\n  rayonCapsule: 999,            // le titre est une PASTILLE, donc un rayon qui dépasse la hauteur\n  rayonRectangle: 6,            // la note est un RECTANGLE à peine adouci, surtout pas une pastille\n  tailleTitre: 16,              // réglé au curseur (skill design-sliders, 2026-08-21) sur les vraies\n  graisseTitre: 350,            // tuiles de Design en localhost — plus fiable qu'une valeur devinée\n  tailleNote: 14,               // 24 sorti trop gros à l'usage réel malgré le \"fois deux\" du texte\n}\n\n// LÉGENDE D'UNE TUILE (2026-08-21) — UNE SEULE DÉFINITION pour les images ET les groupes.\n//\n// Demande de Matthieu, dans ses mots : « la note c'est une DESCRIPTION, c'est pas uniquement le\n// titre ». Deux champs distincts, affichés ensemble, éditables ensemble.\n//\n// LE TITRE NE S'AFFICHE QUE S'IL EXISTE VRAIMENT, et c'est le correctif du second passage. Une image\n// importée porte déjà un `name`, hérité de son nom de fichier : l'afficher revenait à écrire\n// « Screenshot 2026-08-13 at 20.48.46 » sur chaque référence, un bruit que personne n'a demandé.\n// Un GROUPE, lui, montre toujours son nom, parce que ce nom est son identité — il sert au fil\n// d'Ariane et au menu « Déplacer vers… », il a donc forcément été choisi. D'où l'asymétrie assumée\n// des champs, écrite une bonne fois : un groupe se nomme par `name`, une image se légende par\n// `title`, et `title` n'existe que si Matthieu l'a écrit. Aucun des deux ne recopie l'autre.\n//\n// LE VOILE DÉGRADÉ A DISPARU au profit de deux fonds opaques posés derrière le texte lui-même. Il\n// servait à garantir le contraste sur une image claire ; la pastille et le rectangle le garantissent\n// mieux, et ils ne teintent plus le haut de la référence, ce qui compte sur un mur d'images qu'on\n// compare entre elles.\n//\n// FORMES IMPOSÉES : le titre est une pastille (rayon 999) en HAUT À GAUCHE, en AnthropicSerif 350 —\n// la fonte est variable, donc 350 existe réellement entre Light et Regular. La note est un rectangle\n// à coins légèrement arrondis, collé EN BAS, en Inter : c'est du texte fonctionnel, pas de\n// l'éditorial, et le trio typographique lui donne le sans. Le rectangle est CENTRÉ dans la largeur,\n// son texte reste aligné à gauche — centrer aussi le texte rendrait une description de trois lignes\n// pénible à lire.\nfunction TileCaption({ title, note, onEdit, compte = null }) {\n  if (!title && !note) return null\n  const cliquable = onEdit ? { onClick: (e) => { e.stopPropagation(); onEdit() }, title: 'Cliquer pour modifier le titre et la note', style: { cursor: 'text', pointerEvents: 'auto' } } : {}\n  return (\n    <>\n      {title ? (\n        <div style={{ position: 'absolute', top: 8, left: 8, right: 8, zIndex: 2, pointerEvents: 'none' }}>\n          <h3 {...cliquable} style={{\n            margin: 0, display: 'inline-block', maxWidth: '100%', boxSizing: 'border-box',\n            padding: '4px 11px', borderRadius: LEGENDE.rayonCapsule, background: LEGENDE.fond,\n            font: `${LEGENDE.graisseTitre} ${LEGENDE.tailleTitre}px/1.28 var(--zr-police-serif)`, color: '#fff',\n            overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap',\n            ...(cliquable.style || {}),\n          }}>{title}\n            {/* Le comptage d'un groupe vit DANS la capsule, pas à côté : posé en bas à droite comme\n                au premier passage, il passait sous le rectangle de note dès qu'un groupe en portait\n                une. Un seul élément ne peut pas se chevaucher lui-même. Nombre en Serif Regular 400,\n                la règle du trio typographique pour tout nombre visible. */}\n            {compte != null ? <span style={{ marginLeft: 7, opacity: .62, font: `400 ${LEGENDE.tailleTitre - 2}px var(--zr-police-serif)` }}>{compte}</span> : null}\n          </h3>\n        </div>\n      ) : null}\n      {note ? (\n        <div style={{ position: 'absolute', bottom: 8, left: 8, right: 8, zIndex: 2, pointerEvents: 'none', display: 'flex', justifyContent: 'center' }}>\n          <p {...cliquable} style={{\n            margin: 0, maxWidth: '100%', boxSizing: 'border-box', textAlign: 'left',\n            padding: '7px 11px', borderRadius: LEGENDE.rayonRectangle, background: LEGENDE.fond,\n            font: `400 ${LEGENDE.tailleNote}px/1.28 var(--zr-police-sans)`, color: '#fff',\n            overflow: 'hidden', display: '-webkit-box', WebkitLineClamp: 3, WebkitBoxOrient: 'vertical',\n            ...(cliquable.style || {}),\n          }}>{note}</p>\n        </div>\n      ) : null}\n    </>\n  )\n}\n\n// ÉDITEUR TITRE + NOTE — un seul composant, posé par-dessus la tuile concernée, images et groupes\n// confondus. Il remplace l'ancien champ de renommage seul : deux façons de nommer la même chose\n// auraient divergé au premier ajout de champ.\n//\n// LA FERMETURE SE TESTE SUR LA CIBLE DU FOCUS, jamais sur le simple fait de perdre le focus : passer\n// du titre à la note est un blur, et fermer là-dessus rendrait la note impossible à écrire.\n// `currentTarget.contains(relatedTarget)` distingue « je suis sorti de l'éditeur » de « je circule\n// dedans ». ⌘Entrée valide, Échap annule.\nfunction TileEditor({ item, onSave, onCancel }) {\n  // Un GROUPE se nomme par `name` (son identité : fil d'Ariane, menu « Déplacer vers… »). Une IMAGE\n  // se légende par `title`, distinct de son `name` hérité du nom de fichier. Voir TileCaption.\n  const estGroupe = item.kind === 'folder'\n  const [title, setTitle] = React.useState((estGroupe ? item.name : item.title) || '')\n  const [note, setNote] = React.useState(item.note || '')\n  const champ = {\n    width: '100%', boxSizing: 'border-box', background: 'rgba(255,255,255,.10)', color: '#fff',\n    border: '1px solid rgba(255,255,255,.22)', borderRadius: 5, padding: '5px 7px', outline: 'none',\n  }\n  return (\n    <div onClick={(e) => e.stopPropagation()} onDragStart={(e) => e.stopPropagation()}\n      onKeyDown={(e) => {\n        if (e.key === 'Escape') { e.stopPropagation(); onCancel() }\n        if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.stopPropagation(); onSave({ name: title.trim(), note: note.trim() }) }\n      }}\n      onBlur={(e) => { if (!e.currentTarget.contains(e.relatedTarget)) onSave({ name: title.trim(), note: note.trim() }) }}\n      style={{\n        position: 'absolute', inset: 0, zIndex: 5, display: 'flex', flexDirection: 'column', gap: 6,\n        padding: 10, borderRadius: 4, background: 'rgba(12,12,14,.86)',\n        backdropFilter: 'blur(10px)', WebkitBackdropFilter: 'blur(10px)',\n      }}>\n      <input autoFocus value={title} onChange={(e) => setTitle(e.target.value)} placeholder={estGroupe ? 'Nom du groupe' : 'Titre — laisse vide pour n\\u2019afficher aucun titre'}\n        aria-label=\"Titre\" style={{ ...champ, font: '350 14px var(--zr-police-serif)' }} />\n      <textarea value={note} onChange={(e) => setNote(e.target.value)} placeholder=\"Note — la description, ce que cette référence règle\"\n        aria-label=\"Note\" style={{ ...champ, flex: 1, resize: 'none', font: '400 12px/1.4 var(--zr-police-sans)' }} />\n      <div style={{ font: '400 10px var(--zr-police-sans)', color: 'rgba(255,255,255,.5)' }}>⌘↵ valider · Échap annuler</div>\n    </div>\n  )\n}\n\n// TUILE DE GROUPE — mini-collage 2×2 des images qu'il contient, comme un dossier iOS : on continue de\n// VOIR ce qu'il y a dedans plutôt que de le cacher derrière une icône abstraite. Zéro nouveau rendu :\n// les 4 cases réutilisent GalleryThumb, exactement la vignette d'une image seule.\n//\n// CE QUI DISTINGUE UN GROUPE D'UNE IMAGE, après trois passages et deux corrections de Matthieu : le\n// collage lui-même, et la pastille qui compte les éléments. RIEN D'AUTRE. J'ai essayé successivement\n// un fond clair avec marge interne, puis un biseau `zr-liquid-rim`, et les deux ont été refusés dans\n// les mêmes termes — « tu commences à ajouter plein d'effet c'est moche », puis « le gros liseré\n// moche est toujours présent ». La marge interne dessinait un cadre blanc épais que je prenais pour\n// une aide à la lecture ; sur un mur de références, elle salissait la grille entière.\n//\n// LE LISERÉ EST CELUI DE LA SIDEBAR, `.zr-ws-rim` (corrigé le 2026-08-21). J'avais d'abord posé\n// `zr-liquid-rim`, et Matthieu a tranché : « je voulais les bords liseré du sidebar thème sombre,\n// enlève le reste, tu commences à ajouter plein d'effet c'est moche ». Les deux classes sont des\n// familles opposées et c'est là que je m'étais trompé : `zr-liquid-rim` est un BISEAU pour carte\n// opaque (highlight 1,5px, ombre interne, halo, ombre portée de 32px), quand la sidebar porte un\n// simple FILET d'un pixel qu'on voit à peine. Sur une grille de références, le biseau salissait\n// toutes les tuiles à la fois. Voir `src/fonts.css`, .zr-ws-rim.\nfunction FolderTile({ folder, editing, onOpen, onEdit, onSave, onCancel, dragProps, ratio = '4 / 5' }) {\n  const kids = (folder.items || []).slice(0, 4)\n  const n = (folder.items || []).length\n  return (\n    <div {...dragProps} style={{ width: '100%', position: 'relative', ...(dragProps?.style || {}) }}>\n      <div className=\"zr-tap zr-ws-rim\" onClick={onOpen} style={{\n        width: '100%', aspectRatio: ratio