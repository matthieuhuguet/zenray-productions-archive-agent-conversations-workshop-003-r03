.path || '').startsWith(entry.dir + '/'))) setCur(null)\n      setStatus('→ corbeille…')\n      // FIABLE + RAPIDE : déplacement RÉCURSIF du dossier vers trash/ en 1 commit serveur (move-tree),\n      // au lieu de boucler sur `paths` (tronqué -> ratait des dossiers -> \"delete ne marche pas\").\n      const dest = 'trash/' + entry.dir.replace(/^pages\\//, '')\n      const j = await apiPost('move-tree', { from: entry.dir, to: dest }).catch(causeApi)\n      if (j && j.ok) {\n        setStatus('dossier en corbeille ✓'); loadPathsDebounced()\n        notify({ big: true, icon: 'trash', tint: '#FF9F0A', label: 'Corbeille', title: 'Votre contenu a été déplacé dans Trash', body: `Dossier « ${pgPretty(entry.name)} » (${j.moved} fichier(s)). Récupérable : aucun binaire supprimé du drive.`, actions: [\n          { label: 'Undo', primary: true, onClick: async () => { await apiPost('move-tree', { from: dest, to: entry.dir }).catch(() => {}); loadTree() } },\n          { label: 'Open Trash', onClick: () => setView('trash') },\n        ] })\n      } else { setStatus('erreur corbeille ' + ((j && j.error) || '')); dropDirCache(folder); loadDir(folder) } // re-sync : annule l'optimiste si échec\n      return\n    }\n    optimisticDir((es) => es.filter((x) => x.dir !== entry.dir)) // OPTIMISTE (pas de confirm : Undo dans la notif)\n    if (cur && cur.path === entry.contentPath) setCur(null)\n    setStatus('→ corbeille…')\n    const res = await trashPath(entry.contentPath)\n    if (!res.ok) { setStatus('erreur corbeille — rien perdu'); dropDirCache(folder); loadDir(folder); notify({ icon: 'exclamationmark.triangle', tint: '#FF3B30', label: 'Corbeille', title: 'Mise en corbeille incomplète', body: `« ${pgPretty(entry.name)} » : conflit pendant la suppression. La tuile est ré-affichée — réessaie.`, ttl: 9000 }); return }\n    setStatus('en corbeille ✓'); loadPathsDebounced()\n    notify({ big: true, icon: 'trash', tint: '#FF9F0A', label: 'Corbeille', title: 'Votre contenu a été déplacé dans Trash', body: `« ${pgPretty(entry.name)} » est récupérable. Le binaire reste sur le drive tant que la corbeille n'est pas vidée.`, actions: trashActions([entry.contentPath]) })\n  }\n  // Nouveau dossier. Git ne stocke pas de dossier VIDE : on crée le dossier AVEC une page de départ, puis on\n  // entre dedans. La page peut être renommée/supprimée ensuite ; le dossier disparaît quand il n'a plus d'enfant.\n  // Création façon macOS Finder : PAS de popup navigateur. On crée le dossier avec un nom par défaut puis on\n  // ouvre le RENOMMAGE INLINE (input intégré) sur la nouvelle tuile. Git ne stocke pas de dossier vide -> marqueur\n  // .zrfolder.json (filtré de l'affichage par NODE_RE, dossier vide persistant).\n  // `nameHint` + `skipRename` (ajoutés pour createFolderFromDrop, ci-dessous) : le groupement par drop fixe\n  // lui-même le nom (celui du 1er item déposé) et enchaîne aussitôt sur 2 déplacements -> pas de renommage\n  // inline qui volerait le focus pendant que les moves réseau sont en vol. Retourne { dir } (ou null sur\n  // échec) pour que l'appelant puisse enchaîner sans deviner le chemin généré.\n  // OPTIMISTE-D'ABORD (2026-07-06, perf dossiers — « toutes les features doivent s'effectuer en 0,1 s ») :\n  // AVANT, on attendait le commit GitHub (~1-3 s) AVANT d'afficher la tuile et d'ouvrir le renommage\n  // inline — c'était LE ressenti « créer un dossier est lent ». MAINTENANT : la tuile apparaît et le\n  // renommage s'ouvre à t=0 ; le commit du marqueur part EN FOND. Sur échec réseau, on retire la tuile\n  // (rollback) + resynchronisation propre — le serveur reste la seule vérité, l'optimisme n'est qu'un\n  // affichage d'avance. La promesse retournée ne se résout qu'au retour serveur : les appelants qui\n  // ENCHAÎNENT des écritures dessus (createFolderFromDrop -> moves) gardent leur ordre garanti.\n  // dir -> promesse du commit de fond du marqueur. renamePage (move-tree) et movePage doivent attendre\n  // que le dossier EXISTE côté serveur avant d'écrire dedans/dessus — l'attente est réseau-seulement,\n  // l'affichage optimiste, lui, est déjà fait.\n  const pendingFolderSave = useRef(new Map())\n  const newFolder = async (parentFolder, nameHint, skipRename) => {\n    const base = parentFolder || 'pages'\n    if ((folderEagleSource && (base === folder || base.startsWith(folder + '/'))) || [...folderEagleSourceCache.current.keys()].some((root) => base === root || base.startsWith(root + '/'))) {\n      notify({ kind: 'info', label: 'Dossier lié', title: 'Bundle en lecture seule', body: 'Crée le dossier dans la source du bundle : il apparaîtra automatiquement dans tous ses emplacements.' })\n      return null\n    }\n    // AUCUN ACCENT DANS LES NOMS DU DRIVE (règle du 2026-08-30). On retire l'accent, on ne touche à\n    // rien d'autre : « Août » devient « Aout », la casse et les espaces restent. Ce n'est pas un\n    // slug — un slug rendrait les noms méconnaissables.\n    const dir = `${base}/${sansAccent(nameHint || 'Nouveau dossier')}-${Date.now().toString(36).slice(-4)}`\n    const marker = folderMarkerPath(dir)\n    // 1) t=0 : tuile visible + index recherche + renommage inline, AVANT tout réseau.\n    if (!pathsRef.current.includes(marker)) { const merged = [...pathsRef.current, marker]; pathsRef.current = merged; setPaths(merged) }\n    if (base === folder) {\n      const entry = { name: dir.split('/').pop(), contentPath: null, hasKids: false, dir, type: 'folder', isDb: false, isMedia: false, isImage: false }\n      optimisticDir((es) => es.some((x) => x.dir === dir) ? es : [...es, entry])\n      if (!skipRename) { setSelected(new Set([dir])); setRenameVal('Nouveau dossier'); setRenaming(dir) } // renommage inline immédiat\n    } else { setFolder(base) }\n    setStatus('création du dossier…')\n    // 2) commit en fond (promesse mémorisée : rename/move sur ce dossier attendront qu'il existe côté\n    // serveur). Échec -> rollback visuel complet (tuile + index + renommage éventuel) + toast.\n    // Le spinner tourne pendant CE commit : le dossier est déjà affiché (optimiste), le spinner dit\n    // seulement que l'écriture GitHub est en cours, sans bloquer la main de Matthieu.\n    debutOccupe()\n    const savePromise = writeFolderMarker(dir)\n    pendingFolderSave.current.set(dir, savePromise)\n    let j\n    try { j = await savePromise } finally { pendingFolderSave.current.delete(dir); finOccupe() }\n    if (!j || !j.ok) {\n      setStatus('erreur ' + ((j && j.error) || ''))\n      pathsRef.current = pathsRef.current.filter((p) => p !== marker); setPaths(pathsRef.current)\n      optimisticDir((es) => es.filter((x) => x.dir !== dir))\n      setRenaming((r) => (r === dir ? null : r))\n      notify({ icon: 'exclamationmark.triangle', tint: '#FF3B30', label: 'Dossier', title: 'Création impossible', body: 'Le drive n\\'a pas confirmé — réessaie.' })\n      return null\n    }\n    setStatus('dossier créé ✓')\n    loadPathsDebounced()\n    // Même raison que dans `createFolderAt` : la tuile optimiste ci-dessus ne s'affiche que si l'on\n    // regarde le dossier parent. Créé ailleurs, le dossier n'apparaissait nulle part.\n    tick([marker])\n    return { dir }\n  }\n  // Création de dossier AU NOM EXACT (pour le dialogue « Déplacer vers… », 2026-07-12). Diffère de newFolder :\n  // pas de suffixe anti-collision (le dialogue vérifie lui-même l'existence dans l'arbre et sélectionne le\n  // dossier existant au lieu de re-créer), pas de tuile optimiste (le dossier créé n'est pas forcément dans la\n  // vue courante), pas de renommage inline. Même marqueur .zrfolder.json que newFolder (un dossier \"vide\"\n  // n'existe pour git qu'à travers ce fichier). Renvoie true/false ; l'erreur s'affiche INLINE dans le dialogue.\n  const createFolderAt = async (dir) => {\n    if ([...folderEagleSourceCache.current.keys()].some((root) => dir === root || dir.startsWith(root + '/'))) return false\n    const marker = folderMarkerPath(dir)\n    const j = await writeFolderMarker(d