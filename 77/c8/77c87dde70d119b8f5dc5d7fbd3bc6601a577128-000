se) // l'ancien listing du sous-arbre déplacé (chemins périmés) ne doit pas resservir\n      setStatus(`dossier déplacé ✓`); if (!opts.batch) loadTree()\n      if (!opts.batch) notify({ icon: 'folder', tint: PALETTE.primary, label: 'Déplacé', title: pgPretty(folderName), body: `Dossier déplacé dans ${toFolder} — ${j.moved} fichier(s).` })\n      return true\n    }\n    setStatus('erreur move dossier ' + ((j && (j.error + (j.detail ? ' · ' + j.detail : ''))) || ''))\n    if (!opts.batch) { dropDirCache(folder); loadDir(folder) }\n    return false\n  }\n  // C21/C22 : trash d'une entrée Finder, GÉNÉRALISÉ à tous les types de nœuds (page/image/média/base).\n  // Mécanisme = corbeille restaurable (soft delete) : on COPIE le ou les fichiers du nœud sous trash/<reste>,\n  // puis on supprime l'original dans pages/. On ne touche JAMAIS les binaires :\n  //  - image (.img.json) : le binaire + vignette restent sur le shard privé (référencés par hash) -> restaurables.\n  //  - média (.media.json) : les parts media/<id>/NNN.bin restent en place (chemin absolu stable) -> restaurables.\n  //    NB : on n'utilise PAS l'action delete serveur ici (elle purge les parts = perte définitive).\n  //  - base (.db.json) : un seul fichier.\n  //  - page (.md) : le .md + ses 3 jumeaux (.blocknote/.comments/.props.json).\n  // Les fichiers d'un nœud à déplacer, selon son type.\n  const trashTwins = (contentPath) => {\n    const ty = typeOfPath(contentPath)\n    if (ty === 'page') return [contentPath, ...['.blocknote.json', '.comments.json', '.props.json'].map((e) => contentPath.replace(/\\.md$/, e))]\n    return [contentPath] // image / média / base / autres : descripteur unique\n  }\n  // Métadonnées de suppression (sidecar). On lit le descripteur PRINCIPAL pour en extraire l'empreinte du\n  // binaire (contentHash), le drive porteur (zenray-media-NN / zenray-vid-NN) et la taille. Ces infos servent\n  // à (a) l'Undo (restaurer au chemin d'origine) et (b) la suppression définitive plus tard (refcount serveur).\n  const sidecarFor = (contentPath, descriptorText) => {\n    const ty = typeOfPath(contentPath)\n    let originalRepo = null, originalDrive = null, contentHash = null, fileSize = null\n    try {\n      const m = descriptorText ? JSON.parse(descriptorText) : null\n      if (m) {\n        if (m.repo) {\n          originalRepo = m.repo\n          // Famille générique zenray-<kind>-<vis>-NN + legacy (zenray-media = img/private, zenray-vid = vid/public).\n          const gm = /^(zenray-(?:img|vid|audio|doc|table|markdown)-(?:public|private))-\\d{2,}$/.exec(m.repo)\n          originalDrive = gm ? gm[1] + '-NN'\n            : /^zenray-vid-/.test(m.repo) ? 'zenray-vid-NN'\n            : /^zenray-media-/.test(m.repo) ? 'zenray-media-NN'\n            : null\n        }\n        if (typeof m.path === 'string') { const mm = m.path.match(/([0-9a-f]{16,64})\\.[A-Za-z0-9]+$/); if (mm) contentHash = mm[1] }\n        if (typeof m.size === 'number') fileSize = m.size\n        if (m.type === 'hls' || m.type === 'chunked-media') originalDrive = originalDrive || (m.type === 'hls' ? 'zenray-vid-NN' : 'zenray-media-NN')\n      }\n    } catch {}\n    return { v: 1, originalPath: contentPath, originalRepo, originalDrive, deletedAt: new Date().toISOString(), itemType: ty, contentHash, fileSize }\n  }\n  // Déplace un nœud (et ses jumeaux) vers trash/, et dépose UN sidecar de métadonnées à côté du descripteur.\n  // Déplace un nœud (et ses jumeaux) vers trash/ via l'action serveur ATOMIQUE `move` (commitTree + retry\n  // fast-forward) -> SÛR même lancé en parallèle avec d'autres trash/déplacements. On n'utilise PLUS save+delete :\n  //  (a) `delete` sur un .media.json PURGEAIT les parts média = perte définitive ; `move` ne touche aucun binaire.\n  //  (b) save+delete = 2 commits contents-API NON retryés -> 409 en parallèle ; `move` = 1 commit retryé.\n  // On lit le descripteur principal AVANT (pour le sidecar), puis on pose le sidecar best-effort.\n  const trashPath = a