 `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-progress', ...(init.headers || {}) } })\n}\n\n// Retry générique : retente sur erreur réseau et 5xx (panne GitHub transitoire).\nasync function ghRetry(fn, { tries = 4, baseMs = 600, retryOn = (r) => r.status >= 500 } = {}) {\n  let last = null\n  for (let i = 0; i < tries; i++) {\n    try { const r = await fn(); if (r.ok || !retryOn(r)) return r; last = r } catch { last = null }\n    if (i < tries - 1) await sleep(baseMs * (i + 1))\n  }\n  return last\n}\n\n// Attend que le repo réponde ET que sa branche main porte un commit (ref créée par auto_init, asynchrone).\nasync function waitShardReady(token, name, { tries = 12, delayMs = 1500 } = {}) {\n  for (let i = 0; i < tries; i++) {\n    const pr = await gh(token, `repos/${OWNER}/${name}`)\n    if (pr.ok) {\n      const rr = await gh(token, `repos/${OWNER}/${name}/git/ref/heads/${SHARD_BRANCH}`)\n      if (rr.ok) return true\n    }\n    await sleep(delayMs)\n  }\n  return false\n}\n\nconst README_BODY = `# ZenRay media shard\n\nMagasin d'assets media **prive** de l'application ZenRay.\n\nCe depot fait partie d'un drive shorde facon Git-LFS : les fichiers binaires\n(images, chunks media) sont stockes sous des noms **hashes**, repartis sur\nplusieurs depots \\`zenray-media-NN\\` quand l'un d'eux approche la limite GitHub\n(~5 Go). L'etat de remplissage est suivi dans \\`pages/.zr-drive.json\\` du depot\n\\`zenray-data\\`.\n\nNe rien committer a la main ici : toutes les ecritures passent par l'API\nserveur de ZenRay (Git Data API). Editer ce depot manuellement peut corrompre\nle drive.\n`\n\n// README d'un shard PUBLIC (drive-7) : jumeau d'upload-shard.js PUBLIC_README_BODY. Un shard public ne doit\n// JAMAIS porter le texte « dépôt privé » ni laisser entendre qu'il est interne. Aucun nom humain ici non plus.\nconst PUBLIC_README_BODY = `# ZenRay public shard\n\nDepot **public** d'assets ZenRay.\n\nLes fichiers sont nommes par leur **empreinte SHA-256** (\\`ab/cd/<hash>.<ext>\\`) accompagnes\nd'une vignette \\`.webp\\`, et servis via **jsDelivr** (cache immuable pinne sur le commit).\nAucun nom humain n'apparait : seuls des chemins hashes.\n\nQuand un shard approche ~5 Go, l'application en cree automatiquement un suivant. L'etat de\nremplissage est suivi dans un fichier d'etat du depot prive \\`zenray-data\\`.\n\nNe rien committer a la main ici : toutes les ecritures passent par l'API serveur (Git Data API).\n`\n\n// Écrase le README par défaut (créé par auto_init) par un README honnête. Best-effort.\n// drive-7 : choisit le corps selon la visibilité (pub => README public, sinon README privé), comme\n// ensureFamilyReadme d'upload-shard.js. Évite qu'un shard public se déclare « privé » sur une surface publique.\nasync function ensureShardReadme(token, name, pub = false) {\n  try {\n    let sha = null\n    const g = await gh(token, `repos/${OWNER}/${name}/contents/README.md?ref=${SHARD_BRANCH}`)\n    if (g.ok) { try { sha = (await g.json()).sha || null } catch {} }\n    const bodyText = pub ? PUBLIC_README_BODY : README_BODY\n    await ghRetry(() => gh(token, `repos/${OWNER}/${name}/contents/README.md`, {\n      method: 'PUT',\n      body: JSON.stringify({ message: 'shard: README', content: Buffer.from(bodyText, 'utf8').toString('base64'), branch: SHARD_BRANCH, ...(sha ? { sha } : {}) }),\n    }), { tries: 3, retryOn: (r) => r.status >= 500 || r.status === 409 })\n  } catch {}\n}\n\nexport default async function handler(req, res) {\n  const token = process.env.GITHUB_TOKEN\n  if (!token) return res.status(200).json({ error: 'no-token' })\n  res.setHeader('Cache-Control', 'no-store')\n\n  // POST { action:'create-shard' } -> crée le prochain repo media privé zenray-media-NN\n  if (req.method === 'POST') {\n    let body = req.body; if (typeof body === 'string') { try { body = JSON.parse(body) } catch { body = {} } }\n    if (body && body.action === 'create-shard') {\n      try {\n        // {kind,vis} optionnels : crée le prochain repo de la famille zenray-<kind>-<vis>-NN.\n        // Défaut (sans kind/vis) = comportement historique : prochain zenray-media-NN privé.\n        const kind = body.kind ? String(body.kind) : 'img'\n        const vis = body.vis ? String(body.vis) : 'private'\n        const pub = vis === 'public'\n        // RENAME (objectif 1) : plus de cas legacy. Toute famille -> zenray-<kind>-<vis>-NN, y compris img/private\n        // (zenray-img-private-NN). On scanne le PREFIXE de la famille MAIS, pour img/private, on prend aussi en\n        // compte les anciens zenray-media-NN pour calculer NN (sinon on recréerait zenray-img-private-01 alors\n        // que zenray-media-07 existe déjà -> collision de numéro). parseShard normalise les deux noms.\n        const prefix = `zenray-${kind}-${vis}`\n        // drive-4 : NN est TOUJOURS >= 2 chiffres (schéma canonique shard-naming.js : \\d{2,}, shardName pad sur 2).\n        // L'ancienne famRe en \\d+ comptait d'éventuels repos à 1 chiffre que parseShard/shardRe rejettent : un\n        // repo « compté pour le numéro » mais « invisible partout ailleurs ». On aligne sur \\d{2,} : une seule vérité.\n        const famRe = new RegExp('^' + prefix.replace(/[-]/g, '\\\\-') + '-(\\\\d{2,})$')\n        const existing = []\n        for (let page = 1; page <= 5; page++) {\n          const r = await gh(token, `user/repos?per_page=100&page=${page}&affiliation=owner`)\n          if (!r.ok) break; const arr = await r.json(); if (!Array.isArray(arr) || !arr.length) break\n          for (const x of arr) {\n            const m = famRe.exec(x.name)\n            if (m) { existing.push(parseInt(m[1], 10)); continue }\n            // Legacy de la MÊME famille (zenray-media-NN = img/private) : compte aussi pour le numéro suivant.\n            const p = parseShard(x.name)\n            if (p && p.kind === kind && p.vis === vis) existing.push(p.n)\n          }\n          if (arr.length < 100) break\n        }\n        const nextN = (existing.length ? Math.max(...existing) : 0) + 1\n        const name = shardName(kind, vis, nextN)\n        const description = pub\n          ? 'ZenRay drive — shard PUBLIC (fichiers hashés SHA-256, servis via jsDelivr, aucun nom humain)'\n          : 'ZenRay drive — shard privé (fichiers hashés SHA-256)'\n        const cr = await ghRetry(\n          () => gh(token, 'user/repos', { method: 'POST', body: JSON.stringify({ name, private: !pub, description, auto_init: true }) }),\n          { tries: 4, retryOn: (r) => r.status >= 500 } // 422 (déjà existant) traité plus bas, pas de retry.\n        )\n        if (!cr || (!cr.ok && cr.status !== 422)) { const t = cr ? await cr.text() : 'network'; return res.status(200).json({ error: 'github', detail: String(t).slice(0, 160) }) }\n        // drive-3 : un 422 signifie « le repo existe déjà » (numérotation sous-évaluée, ex. shard hors fenêtre de\n        // pagination). On NE doit PAS le maquiller en « Créé » : on le rapporte tel quel (existed:true) pour que\n        // l'UI dise « Repo déjà présent » au lieu de mentir. Le README/branche existent déjà, rien d'autre à poser.\n        const existed = !!cr && cr.status === 422\n        if (existed) return res.status(200).json({ ok: true, name, existed: true })\n        // Attendre que la branche soit prête avant de poser le README (évite un 409 sur ref absente).\n        const ready = await waitShardReady(token, name)\n        if (!ready) return res.status(200).json({ error: 'github', detail: 'shard-not-ready' })\n        await ensureShardReadme(token, name, pub)\n        return res.status(200).json({ ok: true, name })\n      } catch (e) { return res.status(200).json({ error: 'fetch' }) }\n    }\n    return res.status(400).json({ error: 'bad-action' })\n  }\n  // GET ?action=tree&repo=<name>[&prefix=ab] : ARBORESCENCE d'un repo shard (objectif 2a), lecture seule.\n  //   - sans prefix : groupe les blobs par PRÉFIXE de 2 caractères (ab/) avec compte + octets par groupe,\n 