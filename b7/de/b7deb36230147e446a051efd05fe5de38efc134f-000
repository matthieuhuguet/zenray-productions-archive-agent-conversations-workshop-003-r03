nchaient chacun leur propre load() complet\n  // (liste tous les repos + tailles) ; regroupées en un seul appel 400 ms après la dernière fin de move.\n  const loadDebounceRef = useRef(null)\n  const loadDebounced = () => { clearTimeout(loadDebounceRef.current); loadDebounceRef.current = setTimeout(load, 400) }\n\n  // ARCHIVES + VUE GROUPÉE (families de shards) : recalculé seulement quand data/showArchives changent, jamais\n  // à chaque render (ex. toggleFam, ou un état sans rapport plus haut dans l'arbre). Doit rester un hook de haut\n  // niveau (pas dans la JSX conditionnelle plus bas) pour respecter les rules of hooks.\n  const groupedShownRepos = useMemo(() => {\n    const repos = (data && data.repos) || []\n    const isArchived = (r) => { const p = parseShard(r.name); return !!p && p.kind === 'img' && p.vis === 'private' }\n    const hiddenCount = repos.filter(isArchived).length\n    const shownRepos = showArchives ? repos : repos.filter((r) => !isArchived(r))\n    const fams = new Map()\n    for (const r of shownRepos) { const f = famOf(r); if (f) { if (!fams.has(f)) fams.set(f, []); fams.get(f).push(r) } }\n    return { hiddenCount, shownRepos, fams }\n  }, [data, showArchives])\n\n  const flashToast = (msg) => { setToast(msg); setTimeout(() => setToast((c) => (c === msg ? null : c)), 2600) }\n\n  // ---- Création de repo par type + visibilité ----\n  const createShard = async () => {\n    setBusy(true); setCreateMsg(null)\n    const j = await fetch('/api/repos', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'create-shard', kind: createKind, vis: createVis }) }).then((r) => r.json()).catch(() => null)\n    setBusy(false)\n    // drive-3 : `existed:true` => le repo existait déjà (422 côté GitHub). On le DIT, on ne ment pas « Créé ».\n    if (j && j.ok) { setCreateMsg({ ok: true, text: (j.existed ? 'Repo déjà présent : ' : 'Créé : ') + j.name }); load() }\n    else setCreateMsg({ ok: false, text: 'Échec : ' + ((j && (j.error || j.detail)) || 'réseau') })\n  }\n\n  // ---- Arborescence (browse) ----\n  const openRepo = async (repo) => {\n    const p = parseShard(repo)\n    if (!p) return // zenray-data / progress : pas d'arborescence shardée\n    setOpenPrefix(null); setDlFor(null)\n    setBrowse({ repo, loading: true })\n    const j = await fetch(`/api/repos?action=tree&repo=${encodeURIComponent(repo)}`, { cache: 'no-store' }).then((r) => r.json()).catch(() => null)\n    if (!j || j.error) { setBrowse({ repo, error: (j && j.error) || 'net' }); return }\n    setBrowse({ ...j })\n  }\n  const openPrefixGroup = async (prefix) => {\n    if (!browse) return\n    setOpenPrefix({ prefix, loading: true, files: [] })\n    const j = await fetch(`/api/repos?action=tree&repo=${encodeURIComponent(browse.repo)}&prefix=${encodeURIComponent(prefix)}`, { cache: 'no-store' }).then((r) => r.json()).catch(() => null)\n    if (!j || j.error) { setOpenPrefix({ prefix, error: (j && j.error) || 'net', files: [] }); return }\n    setOpenPrefix({ prefix, files: j.files || [] })\n  }\n\n  // ---- Queue de déplacements ----\n  const runningCount = useMemo(() => moves.filter((m) => m.status === 'running').length, [moves])\n  const queuedCount = useMemo(() => moves.filter((m) => m.status === 'queued').length, [moves])\n  const movesRef = useRef(moves); movesRef.current = moves\n\n  const setMove = (id, patch) => setMoves((arr) => arr.map((m) => (m.id === id ? { ...m, ...patch } : m)))\n\n  const runMove = async (m) => {\n    setMove(m.id, { status: 'running', progress: 0.1 })\n    try {\n      const r = await fetch('/api/upload-shard', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'move-blob', srcRepo: m.srcRepo, dstRepo: m.dstRepo, paths: m.paths, hash: m.hash, sizeBytes: m.sizeBytes }) })\n      const j = await r.json().catch(() => null)\n      if (j && j.ok) {\n        // move-blob renvoie {ok:true, moved, deleted, dstRepo, sourceKept} (modèle PROXY AUTO-RÉSILIENT : le\n        // manifest n'est jamais réécrit, /api/shard retrouve le binaire sur la cible). Pas de champ `rewritten`.\n        // drive-1 : sourceKept=true => la copie a réussi mais une suppression source a échoué (binaire EN DOUBLE).\n        // On affiche alors un état distinct du succès, pas un « Déplacé » trompeur qui laisse croire l'espace libéré.\n        if (j.sourceKept) {\n          setMove(m.id, { status: 'warn', progress: 1, error: 'source-kept' })\n          flashToast(`Copié vers ${m.dstRepo} — source partiellement conservée`)\n        } else {\n          setMove(m.id, { status: 'done', progress: 1 })\n          flashToast(`Déplacé vers ${m.dstRepo}`)\n        }\n      } else {\n        // Tout échec serveur => {error:...} (status 200). La source n'est jamais supprimée avant la copie,\n        // donc une erreur ici signifie \"rien déplacé, média toujours servi\".\n        setMove(m.id, { status: 'error', progress: 1, error: (j && j.error) || ('http ' + r.status) })\n        flashToast(`Échec déplacement : ${(j && j.error) || r.status}`)\n      }\n    } catch (e) {\n      setMove(m.id, { status: 'error', progress: 1, error: 'net' })\n    }\n    // auto-purge des terminés + rafraîchir tailles (groupé : voir loadDebounced ci-dessus)\n    setTimeout(() => setMoves((arr) => arr.filter((x) => x.id !== m.id || x.status === 'running' || x.status === 'queued')), 5000)\n    loadDebounced()\n  }\n\n  // Planificateur : promeut les 'queued' tant que runningCount < MOVE_CONCURRENCY.\n  useEffect(() => {\n    if (runningCount >= MOVE_CONCURRENCY) return\n    const next = moves.find((m) => m.status === 'queued')\n    if (next) runMove(next)\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [moves, runningCount])\n\n  // Règle exacte : au-delà de 2 EN COURS + au moins 1 en attente, refuser un nouveau dépôt de move (zone grisée).\n  const moveBlocked = runningCount >= MOVE_CONCURRENCY && queuedCount >= 1\n\n  const enqueueMove = (payload) => {\n    if (moveBlocked) { flashToast('Déplacement en cours — réessaie dans un instant'); return false }\n    setMoves((arr) => [...arr, { id: nextId(), status: 'queued', progress: 0, ...payload }])\n    return true\n  }\n  const enqueueRef = useRef(enqueueMove); enqueueRef.current = enqueueMove\n\n  // Pont pour le fallback \"Déplacer vers…\" (MoveToMenu émet un CustomEvent).\n  useEffect(() => {\n    const h = (e) => enqueueRef.current(e.detail)\n    window.addEventListener('zr-enqueue-move', h)\n    return () => window.removeEventListener('zr-enqueue-move', h)\n  }, [])\n\n  // ---- DnD entre repos ----\n  const [dropTarget, setDropTarget] = useState(null) // {repo, ok:bool}\n  const onFileDragStart = (e, file) => {\n    if (!browse) return\n    const hash = hashOf(file.path)\n    const thumb = thumbPathOf(file.path)\n    const paths = [file.path, ...(thumb ? [thumb] : [])]\n    const payload = { srcRepo: browse.repo, kind: browse.kind, vis: browse.vis, paths, hash, sizeBytes: file.size }\n    e.dataTransfer.effectAllowed = 'move'\n    e.dataTransfer.setData('application/zenray-blob', JSON.stringify(payload))\n  }\n  const compatible = (payload, repoName) => {\n    if (!payload || repoName === payload.srcRepo) return false\n    const pd = parseShard(repoName)\n    return !!pd && pd.kind === payload.kind && pd.vis === payload.vis\n  }\n  const readDrag = (e) => { try { return JSON.parse(e.dataTransfer.getData('application/zenray-blob')) } catch { return null } }\n\n  const kindColor = { content: PALETTE.blue, media: PALETTE.primary, 'video-cdn': PALETTE.green, archive: PALETTE.orange, app: PALETTE.gray500 }\n  const card = { background: t.cardBg, border: t.hairline || `1px solid ${t.border}`, borderRadius: RADII.lg, boxShadow: SHADOWS.apple, padding: 18 }\n  const btnGhost = { display: 'inline-flex', alignItems: 'center', gap: 6, background: 'transparent', border: t.hairline || `1px solid ${t.border}`, borderRadius: RADII.sm, color: t.textSecondary, cursor: 'pointer', padding: '6px 11px', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)' }\n\n  return (\n    <div className=\"zr-stage\" style={{ maxWidth: 920, margin: '0 auto', borderRadius: RADII.lg, boxShadow: SHADOWS.apple, padding: 26, position: 'relative' }}>\n      <div style={{ display: 'flex', alignItems: 'center', gap: 12, marginBottom: 6 }}>\n        <span style={{ fontFamily: FONTS.sans, fontSize: 24, fontWeight: 700, color: t.textPrimary }}>Drive</span>\n        <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: t.textSecondary }}>repos GitHub · quota ~5 Go/repo</span>\n        <a href={`https://github.com/${OWNER}?tab=repositories`} target=\"_blank\" rel=\"noreferrer\" title=\"Tous mes repos GitHub\" style={{ display: 'inline-flex', alignItems: 'center', gap: 3, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: PALETTE.primary, textDecoration: 'none' }}>tous mes repos<Icon name=\"arrow.up.right\" size={11} weight={1.8} /></a>\n        <button onClick={load} title=\"Rafraîchir\" style={{ marginLeft: 'auto', ...btnGhost, padding: '6px 9px' }}><Icon name=\"arrow.clockwise\" size={15} weight={1.7} /></button>\n        <div style={{ position: 'relative' }}>\n          <button onClick={() => { setCreateOpen((v) => !v); setCreateMsg(null) }} style={{ display: 'inline-flex', alignItems: 'center', gap: 6, background: PALETTE.gradient, color: '#fff', border: 'none', borderRadius: RADII.sm, padding: '6px 14px', cursor: 'pointer', fontSize: 'var(--zr-ui-md)', fontWeight: 600, fontFamily: FONTS.sans }}><Icon name=\"plus\" size={14} weight={2} color=\"#fff\" />Nouveau repo</button>\n          {createOpen && (\n            <div style={{ position: 'absolute', right: 0, top: '110%', zIndex: 20, width: 280, ...card, padding: 14, fontFamily: FONTS.sans }}>\n              <div style={{ fontSize: 'var(--zr-ui-sm)', fontWeight: 600, color: t.textSecondary, marginBottom: 7 }}>Type</div>\n              <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6, marginBottom: 12 }}>\n                {KINDS.map((k) => (\n                  <button key={k} onClick={() => setCreateKind(k)} style={{ ...btnGhost, padding: '4px 10px', fontSize: 'var(--zr-ui-sm)', ...(createKind === k ? { background: PALETTE.primarySoft, borderColor: PALETTE.primary, color: PALETTE.primary } : {}) }}>{k}</button>\n                ))}\n              </div>\n              <div style={{ fontSize: 'var(--zr-ui-sm)', fontWeight: 600, color: t.textSecondary, marginBottom: 7 }}>Visibilité</div>\n              <div style={{ display: 'flex', gap: 6, marginBottom: 10 }}>\n                {VIS.map((v) => (\n                  <button key={v} onClick={() => setCreateVis(v)} style={{ ...btnGhost, flex: 1, justifyContent: 'center', padding: '5px 0', fontSize: 'var(--zr-ui-sm)', ...(createVis === v ? { background: PALETTE.primarySoft, borderColor: PALETTE.primary, color: PALETTE.primary } : {}) }}>{v === 'public' ? 'Public' : 'Privé'}</button>\n                ))}\n              </div>\n              {createVis === 'public' && (\n                <div style={{ fontSize: 'var(--zr-ui-xs)', color: PALETTE.orange, lineHeight: 1.5, marginBottom: 10, fontFamily: FONTS.sans }}>Public = CDN gratuit jsDelivr, fichiers hashés, AUCUN nom humain. Ne jamais y mettre de média sensible.</div>\n              )}\n              <button onClick={createShard} disabled={busy} style={{ width: '100%', background: PALETTE.gradient, color: '#fff', border: 'none', borderRadius: RADII.sm, padding: '7px 0', cursor: busy ? 'wait' : 'pointer', fontSize: 'var(--zr-ui-md)', fontWeight: 600, fontFamily: FONTS.sans }}>{busy ? 'Création…' : `Créer zenray-${createKind}-${createVis}-NN`}</button>\n              {createMsg && <div style={{ marginTop: 8, fontSize: 'var(--zr-ui-sm)', color: createMsg.ok ? PALETTE.green : PALETTE.red, fontFamily: FONTS.sans }}>{createMsg.text}</div>}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {!data && <div style={{ color: t.textSecondary, fontSize: 'var(--zr-ui-md)', padding: 20 }}>chargement…</div>}\n      {data && data.error && <div style={{ color: PALETTE.red, fontSize: 'var(--zr-ui-md)', padding: 20 }}>Erreur : {data.error}</div>}\n\n      {/* Vue ARBORESCENCE d'un repo (objectif 2a) */}\n      {browse && data && data.repos && (\n        <RepoTree\n          t={t} browse={browse} openPrefix={openPrefix}\n          onBack={() => { setBrowse(null); setOpenPrefix(null); setDlFor(null) }}\n          onOpenPrefix={openPrefixGroup}\n          onFileDragStart={onFileDragStart}\n          repos={data.repos}\n          onDownload={(path) => setDlFor({ repo: browse.repo, commit: browse.commit, path })}\n        />\n      )}\n\n      {/* Liste des repos (vue par défaut) */}\n      {!browse && data && data.repos && (() => {\n        // ARCHIVES : les shards d'IMAGES PRIVÉS (zenray-img-private-NN + legacy zenray-media-NN) ne servent PLUS\n        // rien depuis le passage tout-public (tout est sur jsDelivr). On les MASQUE de la vue (les repos restent\n        // intacts sur GitHub = sauvegarde des originaux), avec un toggle pour les réafficher au besoin.\n        // VUE GROUPÉE : les familles de shards (même kind+vis, ex. zenray-vid-public-NN) avec BEAUCOUP de repos\n        // sont repliées en UNE ligne agrégée « famille · N shards · X Go » (barre = somme), dépliables au clic.\n        // État persisté. Les repos hors-famille (zenray-data, app) et petites familles restent en lignes simples.\n        // Calcul mémoïsé dans groupedShownRepos (voir plus haut).\n        const { hiddenCount, shownRepos, fams } = groupedShownRepos\n        const GROUP_MIN = 4 // en-dessous, pas la peine de replier\n        return (\n        <>\n          <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', color: t.textSecondary, margin: '6px 0 18px' }}>{shownRepos.length} repos · {fmtMB(data.totalMB)} utilisés au total · double-clic pour explorer{hiddenCount > 0 && <> · <button onClick={() => setShowArchives((v) => !v)} style={{ background: 'transparent', border: 'none', color: PALETTE.primary, cursor: 'pointer', font: 'inherit', padding: 0 }}>{showArchives ? 'masquer' : 'afficher'} {hiddenCount} archive{hiddenCount > 1 ? 's' : ''} privée{hiddenCount > 1 ? 's' : ''}</button></>}</div>\n          <div style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>\n            {(() => {\n              const rows = []\n              const seenFam = new Set()\n              for (const r of shownRepos) {\n                const f = famOf(r)\n                if (f && fams.get(f).length >= GROUP_MIN) {\n                  if (seenFam.has(f)) continue\n                  seenFam.add(f)\n                  const list = fams.get(f)\n                  const totalGo = list.reduce((n, x) => n + x.sizeMB, 0) / 1024\n                  const open = !!openFams[f]\n                  const col = kindColor[list[0].kind] || PALETTE.gray500\n                  rows.push(\n                    <div key={`fam:${f}`} style={{ display: 'flex', flexDirection: 'column', gap: 7 }}>\n                      <div onClick={() => toggleFam(f)} style={{ display: 'flex', alignItems: 'center', gap: 8, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', cursor: 'pointer', borderRadius: RADII.sm, padding: '4px 8px', margin: '-4px -8px' }} title={open ? 'Replier la famille' : 'Déplier les shards'}>\n                        <Icon name={open ? 'chevron.down' : 'chevron.right'} size={12} weight={2} />\n                        <span style={{ width: 8, height: 8, borderRadius: 99, background: col }} />\n                        <span style={{ fontWeight: 600, color: t.textPrimary }}>{f}-*</span>\n                        <span style={{ fontSize: 'var(--zr-ui-2xs)', fontFamily: FONTS.sans, color: t.textSecondary, border: t.hairline || `1px solid ${t.border}`, borderRadius: 5, padding: '0 5px' }}>{list.length} shards</span>\n                        <span style={{ marginLeft: 'auto', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', color: t.textSecondary }}>{totalGo.toFixed(1)} Go au total</span>\n                      </div>\n                      {!open && (\n                        <div style={{ height: 8, borderRadius: 99, background: t.border, overflow: 'hidden', display: 'flex' }}>\n                          {list.map((x) => <div key={x.name} style={{ width: `${100 / list.length}%`, height: '100%', background: col, opacity: 0.35 + 0.65 * Math.min(1, x.pct / 100), borderRight: '1px solid rgba(255,255,255,.35)' }} />)}\n                        </div>\n                      )}\n                      {open && <div style={{ display: 'flex', flexDirection: 'column', gap: 14, paddingLeft: 20 }}>{list.map((x) => renderRepo(x))}</div>}\n                    </div>\n                  )\n                } else rows.push(renderRepo(r))\n              }\n              return rows\n            })()}\n          </div>\n          <div style={{ marginTop: 22, fontSize: 'var(--zr-ui-sm)', color: t.textSecondary, lineHeight: 1.6, borderTop: t.hairline || `1px solid ${t.border}`, paddingTop: 14 }}>\n            Familles par type : zenray-&lt;kind&gt;-&lt;public|private&gt;-NN. Un repo dépasse ~5 Go → nouveau shard. Fichiers hashés (noms aléatoires). Déplacement entre repos du MÊME type+visibilité uniquement.\n          </div>\n        </>\n        )\n        // Rendu d'UNE ligne repo (déplacé en function hoistée pour être utilisable par la vue groupée ci-dessus).\n        function renderRepo(r) {\n              const go = fmtMB(r.sizeMB)\n              const warn = r.pct >= 80\n              const shard = parseShard(r.name)\n              // cible de drop : surlignée selon compatibilité avec le payload en cours de drag\n              const dt = dropTarget && dropTarget.repo === r.name ? dropTarget : null\n              const dropDisabled = runningCount >= MOVE_CONCURRENCY\n              return (\n                <div\n                  key={r.name}\n                  onDoubleClick={() => openRepo(r.name)}\n                  onDragOver={shard ? (e) => {\n                    const payload = window.__zrDragPayload\n                    const ok = compatible(payload, r.name) && !dropDisabled\n                    e.preventDefault(); e.dataTransfer.dropEffect = ok ? 'move' : 'none'\n                    if (!dt || dt.ok !== ok) setDropTarget({ repo: r.name, ok })\n                  } : undefined}\n                  onDragLeave={() => setDropTarget((c) => (c && c.repo === r.name ? null : c))}\n                  onDrop={shard ? (e) => {\n                    e.preventDefault(); setDropTarget(null)\n                    const payload = readDrag(e) || window.__zrDragPayload\n                    if (!compatible(payload, r.name)) { flashToast('Type incompatible'); return }\n                    if (dropDisabled) { flashToast('Déplacement en cours — réessaie'); return }\n                    if (payload.multi) { for (const it of payload.multi) enqueueMove({ srcRepo: payload.srcRepo, dstRepo: r.name, paths: it.paths, hash: it.hash, sizeBytes: it.sizeBytes }) }\n                    else enqueueMove({ srcRepo: payload.srcRepo, dstRepo: r.name, paths: payload.paths, hash: payload.hash, sizeBytes: payload.sizeBytes })\n                  } : undefined}\n                  style={{ display: 'flex', flexDirection: 'column', gap: 7, cursor: shard ? 'pointer' : 'default', borderRadius: RADII.sm, padding: '4px 8px', margin: '-4px -8px', outline: dt ? `2px dashed ${dt.ok ? PALETTE.green : PALETTE.red}` : 'none', outlineOffset: 2, transition: 'outline-color .12s' }}\n                  title={shard ? 'Double-clic : explorer l’arborescence' : undefined}\n                >\n                  <div style={{ display: 'flex', alignItems: 'center', gap: 8, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)' }}>\n                    <span style={{ width: 8, height: 8, borderRadius: 99, background: kindColor[r.kind] || PALETTE.gray500 }} />\n                    <span style={{ fontWeight: 600, color: t.textPrimary }}>{r.name}</span>\n                    <a href={`https://github.com/${OWNER}/${r.name}`} target=\"_blank\" rel=\"noreferrer\" onClick={(e) => e.stopPropagation()} onDoubleClick={(e) => e.stopPropagation()} title=\"Ouvrir le repo sur GitHub\" style={{ display: 'inline-flex', color: t.textSecondary, lineHeight: 0 }}><Icon name=\"arrow.up.right\" size={12} weight={1.8} /></a>\n                    {r.private\n                      ? <span style={{ fontSize: 'var(--zr-ui-2xs)', fontFamily: FONTS.sans, color: t.textSecondary, border: t.hairline || `1px solid ${t.border}`, borderRadius: 5, padding: '0 5px', display: 'inline-flex', alignItems: 'center', gap: 3 }}><Icon name=\"lock\" size={9} weight={1.8} />privé</span>\n                      : <span style={{ fontSize: 'var(--zr-ui-2xs)', fontFamily: FONTS.sans, color: PALETTE.green, border: `1px solid ${PALETTE.green}`, borderRadius: 5, padding: '0 5px', display: 'inline-flex', alignItems: 'center', gap: 3 }}><Icon name=\"globe\" size={9} weight={1.8} color={PALETTE.green} />public</span>}\n                    <span style={{ marginLeft: 'auto', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', color: warn ? PALETTE.orange : t.textSecondary }}>{go} / 5 Go · {r.pct}%</span>\n                  </div>\n                  <div style={{ height: 8, borderRadius: 99, background: t.border, overflow: 'hidden' }}>\n                    <div style={{ width: `${Math.max(2, r.pct)}%`, height: '100%', background: warn ? PALETTE.orange : PALETTE.green }} />\n                  </div>\n                </div>\n              )\n        } })()}\n\n      {/* Panneau de liens de téléchargement (repo public, objectifs 4/5) */}\n      {dlFor && <DownloadPanel t={t} {...dlFor} onClose={() => setDlFor(null)} onCopied={() => flashToast('Copié')} />}\n\n      {/* Indicateur de file de déplacements + zone grisée */}\n      {moves.length > 0 && (\n        <div style={{ position: 'fixed', right: 22, bottom: 22, width: 300, zIndex: 30, ...card, padding: 12, fontFamily: FONTS.sans }}>\n          <div style={{ fontSize: 'var(--zr-ui-sm)', fontWeight: 700, color: t.textPrimary, marginBottom: 8, display: 'flex', alignItems: 'center', gap: 6 }}>\n            Déplacements\n            {moveBlocked && <span style={{ fontSize: 'var(--zr-ui-2xs)', fontFamily: FONTS.sans, color: PALETTE.orange, marginLeft: 'auto' }}>file pleine (max {MOVE_CONCURRENCY})</span>}\n          </div>\n          {moves.map((m) => (\n            <div key={m.id} style={{ marginBottom: 8 }}>\n              <div style={{ display: 'flex', alignItems: 'center', gap: 6, fontSize: 'var(--zr-ui-xs)', fontFamily: FONTS.sans, color: t.textSecondary }}>\n                <span style={{ color: m.status === 'error' ? PALETTE.red : m.status === 'warn' ? PALETTE.orange : m.status === 'done' ? PALETTE.green : t.textPrimary }}>{m.srcRepo} → {m.dstRepo}</span>\n                <span style={{ marginLeft: 'auto' }}>{m.status === 'queued' ? 'en attente' : m.status === 'running' ? '…' : m.status === 'done' ? 'ok' : m.status === 'warn' ? 'source conservée' : (m.error || 'err')}</span>\n","exit_code":0,"duration":{"secs":0,"nanos":8083},"formatted_output":"import React, { useEffect, useMemo, useRef, useState } from 'react'\nimport { PALETTE, RADII, SHADOWS } from '../theme.js'\nimport Icon from './Icon.jsx'\nimport { buildJsDelivrUrl, OWNER, parseShard, KINDS, VIS } from '../capture/shardNaming.js'\n\n// C204 — Drive Dashboard façon Google Drive :\n//  (1) liste des repos du drive + barres de remplissage (existant)\n//  (2) double-clic sur un repo -> arborescence des fichiers (lazy, via /api/repos?action=tree)\n//  (3) bouton \"Nouveau repo\" par TYPE + visibilité -> POST /api/repos {action:'create-shard',kind,vis}\n//  (4) drag-and-drop / \"Déplacer vers…\" d'un fichier entre repos MÊME type+vis (move-blob),\n//      via une QUEUE concurrence max 2 + zone grisée \"déplacement en cours\"\n//  (5) liens de téléchargement (jsDelivr/raw + commandes curl/sparse-checkout/degit) sur les repos PUBLICS\n//\n// Règle archi : tout passe par les PETITES ops REST du serveur (tree, move-blob 1-2 fichiers, create-shard).\n// Le BULK reste hors UI (scripts git). Anti-fuite : seuls des chemins hachés ab/cd/<sha> sont affichés.\nconst FONTS = { sans: \"var(--zr-police-sans)\", serif: \"var(--zr-police-serif)\" }\nconst MOVE_CONCURRENCY = 2\n\nconst fmtBytes = (b) => {\n  const n = Number(b || 0)\n  if (n >= 1024 * 1024 * 1024) return (n / 1024 / 1024 / 1024).toFixed(2) + ' Go'\n  if (n >= 1024 * 1024) return (n / 1024 / 1024).toFixed(1) + ' Mo'\n  if (n >= 1024) return (n / 1024).toFixed(0) + ' Ko'\n  return n + ' o'\n}\nconst fmtMB = (mb) => (mb >= 1024 ? (mb / 1024).toFixed(2) + ' Go' : mb + ' Mo')\n\n// La vignette .webp jumelle d'un binaire haché ab/cd/<sha>.<ext> = ab/cd/<sha>.webp.\nconst thumbPathOf = (binPath) => {\n  const m = /^(\\w{2}\\/\\w{2}\\/[0-9a-f]+)\\.[^.]+$/.exec(binPath)\n  return m ? `${m[1]}.webp` : null\n}\nconst hashOf = (binPath) => {\n  const m = /\\/([0-9a-f]+)\\.[^.]+$/.exec(binPath)\n  return m ? m[1] : null\n}\n\nlet _idSeq = 0\nconst nextId = () => `mv${Date.now().toString(36)}${(_idSeq++).toString(36)}`\n\n// Famille d'un shard (même kind+vis, ex. zenray-vid-public-NN) -- pure, ne dépend que de parseShard.\n// Remontée au niveau module (bug réel 2026-07-16 : définie seulement dans le useMemo groupedShownRepos,\n// donc \"famOf is not defined\" au premier rendu groupé, cette fonction étant aussi appelée hors de ce scope).\nconst famOf = (r) => { const p = parseShard(r.name); if (!p) return null; if (p.v2) return `zenrayshards-${p.kind}`; return `zenray-${p.legacy === 'media' ? 'media' : p.legacy === 'vid' ? 'vid' : p.kind + '-' + p.vis}` }\n\nexport default function DriveDashboard({ t }) {\n  const [data, setData] = useState(null)\n  const [busy, setBusy] = useState(false)\n  const [createOpen, setCreateOpen] = useState(false)\n  const [createKind, setCreateKind] = useState('img')\n  const [createVis, setCreateVis] = useState('private')\n  const [showArchives, setShowArchives] = useState(false) // afficher/masquer les shards img privés (archives, plus servies)\n  // Familles de shards dépliées dans la vue groupée (ex. { 'zenray-vid-public': true }). Persisté.\n  const [openFams, setOpenFams] = useState(() => { try { return JSON.parse(localStorage.getItem('zr:drive:openFams')) || {} } catch { return {} } })\n  const toggleFam = (f) => setOpenFams((o) => { const n = { ...o, [f]: !o[f] }; try { localStorage.setItem('zr:drive:openFams', JSON.stringify(n)) } catch {} return n })\n  const [createMsg, setCreateMsg] = useState(null)\n  const [browse, setBrowse] = useState(null) // {repo,kind,vis,private,commit,truncated,totalFiles,totalBytes,groups}\n  const [openPrefix, setOpenPrefix] = useState(null) // {prefix, files, loading}\n  const [moves, setMoves] = useState([])\n  const [dlFor, setDlFor] = useState(null) // {repo, commit, path} pour panneau de liens\n  const [toast, setToast] = useState(null)\n\n  const load = () => fetch('/api/repos', { cache: 'no-store' }).then((r) => r.json()).then(setData).catch(() => setData({ error: 'net' }))\n  useEffect(() => { load() }, [])\n  // Plusieurs déplacements terminant à quelques ms d'écart déclenchaient chacun leur propre load() complet\n  // (liste tous les repos + tailles) ; regroupées en un seul appel 400 ms après la dernière fin de move.\n  const loadDebounceRef = useRef(null)\n  const loadDebounced = () => { clearTimeout(loadDebounceRef.current); loadDebounceRef.current = setTimeout(load, 400) }\n\n  // ARCHIVES + VUE GROUPÉE (families de shards) : recalculé seulement quand data/showArchives changent, jamais\n  // à chaque render (ex. toggleFam, ou un état sans rapport plus haut dans l'arbre). Doit rester un hook de haut\n  // niveau (pas dans la JSX conditionnelle plus bas) pour respecter les rules of hooks.\n  const groupedShownRepos = useMemo(() => {\n    const repos = (data && data.repos) || []\n    const isArchived = (r) => { const p = parseShard(r.name); return !!p && p.kind === 'img' && p.vis === 'private' }\n    const hiddenCount = repos.filter(isArchived).length\n    const shownRepos = showArchives ? repos : repos.filter((r) => !isArchived(r))\n    const fams = new Map()\n    for (const r of shownRepos) { const f = famOf(r); if (f) { if (!fams.has(f)) fams.set(f, []); fams.get(f).push(r) } }\n    return { hiddenCount, shownRepos, fams }\n  }, [data, showArchives])\n\n  const flashToast = (msg) => { setToast(msg); setTimeout(() => setToast((c) => (c === msg ? null : c)), 2600) }\n\n  // ---- Création de repo par type + visibilité ----\n  const createShard = async () => {\n    setBusy(true); setCreateMsg(null)\n    const j = await fetch('/api/repos', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'create-shard', kind: createKind, vis: createVis }) }).then((r) => r.json()).catch(() => null)\n    setBusy(false)\n    // drive-3 : `existed:true` => le repo existait déjà (422 côté GitHub). On le DIT, on ne ment pas « Créé ».\n    if (j && j.ok) { setCreateMsg({ ok: true, text: (j.existed ? 'Repo déjà présent : ' : 'Créé : ') + j.name }); load() }\n    else setCreateMsg({ ok: false, text: 'Échec : ' + ((j && (j.error || j.detail)) || 'réseau') })\n  }\n\n  // ---- Arborescence (browse) ----\n  const openRepo = async (repo) => {\n    const p = parseShard(repo)\n    if (!p) return // zenray-data / progress : pas d'arborescence shardée\n    setOpenPrefix(null); setDlFor(null)\n    setBrowse({ repo, loading: true })\n    const j = await fetch(`/api/repos?action=tree&repo=${encodeURIComponent(repo)}`, { cache: 'no-store' }).then((r) => r.json()).catch(() => null)\n    if (!j || j.error) { setBrowse({ repo, error: (j && j.error) || 'net' }); return }\n    setBrowse({ ...j })\n  }\n  const openPrefixGroup = async (prefix) => {\n    if (!browse) return\n    setOpenPrefix({ prefix, loading: true, files: [] })\n    const j = await fetch(`/api/repos?action=tree&repo=${encodeURIComponent(browse.repo)}&prefix=${encodeURIComponent(prefix)}`, { cache: 'no-store' }).then((r) => r.json()).catch(() => null)\n    if (!j || j.error) { setOpenPrefix({ prefix, error: (j && j.error) || 'net', files: [] }); return }\n    setOpenPrefix({ prefix, files: j.files || [] })\n  }\n\n  // ---- Queue de déplacements ----\n  const runningCount = useMemo(() => moves.filter((m) => m.status === 'running').length, [moves])\n  const queuedCount = useMemo(() => moves.filter((m) => m.status === 'queued').length, [moves])\n  const movesRef = useRef(moves); movesRef.current = moves\n\n  const setMove = (id, patch) => setMoves((arr) => arr.map((m) => (m.id === id ? { ...m, ...patch } : m)))\n\n  const runMove = async (m) => {\n    setMove(m.id, { status: 'running', progress: 0.1 })\n    try {\n      const r = await fetch('/api/upload-shard', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'move-blob', srcRepo: m.srcRepo, dstRepo: m.dstRepo, paths: m.paths, hash: m.hash, sizeBytes: m.sizeBytes }) })\n      const j = await r.json().catch(() => null)\n      if (j && j.ok) {\n        // move-blob renvoie {ok:true, moved, deleted, dstRepo, sourceKept} (modèle PROXY AUTO-RÉSILIENT : le\n        // manifest n'est jamais réécrit, /api/shard retrouve le binaire sur la cible). Pas de champ `rewritten`.\n        // drive-1 : sourceKept=true => la copie a réussi mais une suppression source a échoué (binaire EN DOUBLE).\n        // On affiche alors un état distinct du succès, pas un « Déplacé » trompeur qui laisse croire l'espace libéré.\n        if (j.sourceKept) {\n          setMove(m.id, { status: 'warn', progress: 1, error: 'source-kept' })\n          flashToast(`Copié vers ${m.dstRepo} — source partiellement conservée`)\n        } else {\n          setMove(m.id, { status: 'done', progress: 1 })\n          flashToast(`Déplacé vers ${m.dstRepo}`)\n        }\n      } else {\n        // Tout échec serveur => {error:...} (status 200). La source n'est jamais supprimée avant la copie,\n        // donc une erreur ici signifie \"rien déplacé, média toujours servi\".\n        setMove(m.id, { status: 'error', progress: 1, error: (j && j.error) || ('http ' + r.status) })\n        flashToast(`Échec déplacement : ${(j && j.error) || r.status}`)\n      }\n    } catch (e) {\n      setMove(m.id, { status: 'error', progress: 1, error: 'net' })\n    }\n    // auto-purge des terminés + rafraîchir tailles (groupé : voir loadDebounced ci-dessus)\n    setTimeout(() => setMoves((arr) => arr.filter((x) => x.id !== m.id || x.status === 'running' || x.status === 'queued')), 5000)\n    loadDebounced()\n  }\n\n  // Planificateur : promeut les 'queued' tant que runningCount < MOVE_CONCURRENCY.\n  useEffect(() => {\n    if (runningCount >= MOVE_CONCURRENCY) return\n    const next = moves.find((m) => m.status === 'queued')\n    if (next) runMove(next)\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [moves, runningCount])\n\n  // Règle exacte : au-delà de 2 EN COURS + au moins 1 en attente, refuser un nouveau dépôt de move (zone grisée).\n  const moveBlocked = runningCount >= MOVE_CONCURRENCY && queuedCount >= 1\n\n  const enqueueMove = (payload) => {\n    if (moveBlocked) { flashToast('Déplacement en cours — réessaie dans un instant'); return false }\n    setMoves((arr) => [...arr, { id: nextId(), status: 'queued', progress: 0, ...payload }])\n    return true\n  }\n  const enqueueRef = useRef(enqueueMove); enqueueRef.current = enqueueMove\n\n  // Pont pour le fallback \"Déplacer vers…\" (MoveToMenu émet un CustomEvent).\n  useEffect(() => {\n    const h = (e) => enqueueRef.current(e.detail)\n    window.addEventListener('zr-enqueue-move', h)\n    return () => window.removeEventListener('zr-enqueue-move', h)\n  }, [])\n\n  // ---- DnD entre repos ----\n  const [dropTarget, setDropTarget] = useState(null) // {repo, ok:bool}\n  const onFileDragStart = (e, file) => {\n    if (!browse) return\n    const hash = hashOf(file.path)\n    const thumb = thumbPathOf(file.path)\n    const paths = [file.path, ...(thumb ? [thumb] : [])]\n    const payload = { srcRepo: browse.repo, kind: browse.kind, vis: browse.vis, paths, hash, sizeBytes: file.size }\n    e.dataTransfer.effectAllowed = 'move'\n    e.dataTransfer.setData('application/zenray-blob', JSON.stringify(payload))\n  }\n  const compatible = (payload, repoName) => {\n    if (!payload || repoName === payload.srcRepo) return false\n    const pd = parseShard(repoName)\n    return !!pd && pd.kind === payload.kind && pd.vis === payload.vis\n  }\n  const readDrag = (e) => { try { return JSON.parse(e.dataTransfer.getData('application/zenray-blob')) } catch { return null } }\n\n  const kindColor = { content: PALETTE.blue, media: PALETTE.primary, 'video-cdn': PALETTE.green, archive: PALETTE.orange, app: PALETTE.gray500 }\n  const card = { background: t.cardBg, border: t.hairline || `1px solid ${t.border}`, borderRadius: RADII.lg, boxShadow: SHADOWS.apple, padding: 18 }\n  const btnGhost = { display: 'inline-flex', alignItems: 'center', gap: 6, background: 'transparent', border: t.hairline || `1px solid ${t.border}`, borderRadius: RADII.sm, color: t.textSecondary, cursor: 'pointer', padding: '6px 11px', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)' }\n\n  return (\n    <div className=\"zr-stage\" style={{ maxWidth: 920, margin: '0 auto', borderRadius: RADII.lg, boxShadow: SHADOWS.apple, padding: 26, position: 'relative' }}>\n      <div style={{ display: 'flex', alignItems: 'center', gap: 12, marginBottom: 6 }}>\n        <span style={{ fontFamily: FONTS.sans, fontSize: 24, fontWeight: 700, color: t.textPrimary }}>Drive</span>\n        <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: t.textSecondary }}>repos GitHub · quota ~5 Go/repo</span>\n        <a href={`https://github.com/${OWNER}?tab=repositories`} target=\"_blank\" rel=\"noreferrer\" title=\"Tous mes repos GitHub\" style={{ display: 'inline-flex', alignItems: 'center', gap: 3, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: PALETTE.primary, textDecoration: 'none' }}>tous mes repos<Icon name=\"arrow.up.right\" size={11} weight={1.8} /></a>\n        <button onClick={load} title=\"Rafraîchir\" style={{ marginLeft: 'auto', ...btnGhost, padding: '6px 9px' }}><Icon name=\"arrow.clockwise\" size={15} weight={1.7} /></button>\n        <div style={{ position: 'relative' }}>\n          <button onClick={() => { setCreateOpen((v) => !v); setCreateMsg(null) }} style={{ display: 'inline-flex', alignItems: 'center', gap: 6, background: PALETTE.gradient, color: '#fff', border: 'none', borderRadius: RADII.sm, padding: '6px 14px', cursor: 'pointer', fontSize: 'var(--zr-ui-md)', fontWeight: 600, fontFamily: FONTS.sans }}><Icon name=\"plus\" size={14} weight={2} color=\"#fff\" />Nouveau repo</button>\n          {createOpen && (\n            <div style={{ position: 'absolute', right: 0, top: '110%', zIndex: 20, width: 280, ...card, padding: 14, fontFamily: FONTS.sans }}>\n              <div style={{ fontSize: 'var(--zr-ui-sm)', fontWeight: 600, color: t.textSecondary, marginBottom: 7 }}>Type</div>\n              <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6, marginBottom: 12 }}>\n                {KINDS.map((k) => (\n                  <button key={k} onClick={() => setCreateKind(k)} style={{ ...btnGhost, padding: '4px 10px', fontSize: 'var(--zr-ui-sm)', ...(createKind === k ? { background: PALETTE.primarySoft, borderColor: PALETTE.primary, color: PALETTE.primary } : {}) }}>{k}</button>\n                ))}\n              </div>\n              <div style={{ fontSize: 'var(--zr-ui-sm)', fontWeight: 600, color: t.textSecondary, marginBottom: 7 }}>Visibilité</div>\n              <div style={{ display: 'flex', gap: 6, marginBottom: 10 }}>\n                {VIS.map((v) => (\n                  <button key={v} onClick={() => setCreateVis(v)} style={{ ...btnGhost, flex: 