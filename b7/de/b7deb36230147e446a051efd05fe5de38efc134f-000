groups.get(g) || { prefix: g, files: 0, bytes: 0 }\n            cur.files++; cur.bytes += Number(b.size || 0)\n            groups.set(g, cur)\n            totalFiles++; totalBytes += Number(b.size || 0)\n          }\n          const out = [...groups.values()].sort((a, b) => a.prefix.localeCompare(b.prefix))\n          return res.status(200).json({ ok: true, repo, kind: p?.kind || null, vis: p?.vis || null, private: p?.vis !== 'public', commit, truncated: false, totalFiles, totalBytes, groups: out })\n        }\n        // FALLBACK robuste : tree racine non-récursif (dossiers de préfixe seulement), compteurs lazy.\n        const rootR = await gh(token, `repos/${OWNER}/${repo}/git/trees/${commit}`)\n        if (!rootR.ok) return res.status(200).json({ error: 'github', detail: 'tree' })\n        const dirs = ((await rootR.json()).tree || []).filter((x) => x.type === 'tree' && /^[0-9a-f]{2}$/.test(x.path))\n        const out = dirs.map((d) => ({ prefix: d.path, files: null, bytes: null })).sort((a, b) => a.prefix.localeCompare(b.prefix))\n        return res.status(200).json({ ok: true, repo, kind: p?.kind || null, vis: p?.vis || null, private: p?.vis !== 'public', commit, truncated: true, lazy: true, totalFiles: null, totalBytes: null, groups: out })\n      }\n\n      // Feuilles sous un préfixe donné.\n      if (!/^[0-9a-f]{2}$/.test(prefix)) return res.status(200).json({ error: 'bad-prefix' })\n      // 1) trouver le sha du sous-arbre <prefix> à la racine (1 appel non récursif).\n      const rootR = await gh(token, `repos/${OWNER}/${repo}/git/trees/${commit}`)\n      if (!rootR.ok) return res.status(200).json({ error: 'github', detail: 'root-tree' })\n      const rootEntry = ((await rootR.json()).tree || []).find((x) => x.type === 'tree' && x.path === prefix)\n      if (!rootEntry) return res.status(200).json({ ok: true, repo, prefix, commit, files: [] })\n      // 2) sous-arbre récursif du préfixe (petit : 1/256e du repo).\n      const subR = await gh(token, `repos/${OWNER}/${repo}/git/trees/${rootEntry.sha}?recursive=1`)\n      if (!subR.ok) return res.status(200).json({ error: 'github', detail: 'sub-tree' })\n      const sj = await subR.json()\n      const files = (sj.tree || []).filter((x) => x.type === 'blob').map((x) => ({ path: `${prefix}/${x.path}`, size: Number(x.size || 0) }))\n      return res.status(200).json({ ok: true, repo, prefix, commit, truncated: !!sj.truncated, files })\n    } catch (e) { return res.status(200).json({ error: 'fetch' }) }\n  }\n\n  try {\n    // tous les repos du compte (paginé), on garde ceux du drive ZenRay\n    const repos = []\n    for (let page = 1; page <= 5; page++) {\n      const r = await gh(token, `user/repos?per_page=100&page=${page}&affiliation=owner`)\n      if (!r.ok) break\n      const arr = await r.json()\n      if (!Array.isArray(arr) || !arr.length) break\n      for (const x of arr) repos.push(x)\n      if (arr.length < 100) break\n    }\n    // Affichage : 'video-cdn' pour les shards vidéo, 'media' pour tout autre shard (img/audio/doc/table/markdown),\n    // 'content' pour zenray-data, 'app' sinon. parseShard couvre nouveau schéma ET legacy.\n    const driveKind = (name) => {\n      if (name === 'zenray-data') return 'content'\n      const p = parseShard(name)\n      if (p) return p.kind === 'vid' ? 'video-cdn' : p.kind === 'archive' ? 'archive' : 'media'\n      return 'app'\n    }\n    const drive = repos\n      .filter((x) => x.name === 'zenray-data' || x.name === 'zenray-progress' || x.name === 'ZenRayProgress' || shardRe.test(x.name))\n      .map((x) => ({ name: x.name, private: !!x.private, sizeMB: +((x.size || 0) / 1024).toFixed(1), limitMB: LIMIT_MB, pct: Math.min(100, Math.round(((x.size || 0) / 1024) / LIMIT_MB * 100)), kind: driveKind(x.name) }))\n      .sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true })) // tri numérique : -100 APRÈS -99 (alpha le rangeait entre -10 et -11, la liste semblait s'arrêter à 99)\n    const totalMB = +drive.reduc