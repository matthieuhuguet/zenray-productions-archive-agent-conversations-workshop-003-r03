raw-token, lui, RESTE gated\n    50\t// (même surface que media-key : servi au client authentifié uniquement quand le gate est actif).\n    51\t// Une balise DOM ne peut pas envoyer x-zr-auth, mais elle ne demande jamais une écriture.\n    52\t// Les routes publiques sont donc explicitement limitées à GET/HEAD. En particulier, `media`\n    53\t// n'est jamais ici : ses trois actions écrivent des blobs ou un manifeste GitHub.\n    54\tconst PUBLIC_READ_ROUTES = new Set(['img', 'stream', 'shard', 'hls', 'hls-key', 'hls-download-info', 'hls-cli', 'hls-download-script', 'shared-media', 'share-og', 'share-cover', 'raw-proxy', 'spotify-search', 'youtube-search', 'youtube-search-v3'])\n    55\texport const isPublicReadRoute = (req, name) => ['GET', 'HEAD'].includes(String(req.method || 'GET').toUpperCase()) && PUBLIC_READ_ROUTES.has(name)\n    56\t\n    57\texport async function authOk(req, name) {\n    58\t  if (!API_SECRET) return true\n    59\t  if (isPublicReadRoute(req, name)) return true\n    60\t  // La résolution d'un jeton de partage est publique. Son émission et sa révocation restent protégées par\n    61\t  // x-zr-auth, comme toutes les écritures de l'app.\n    62\t  if (name === 'share-token' && (req.method || 'GET').toUpperCase() === 'GET') return true\n    63\t  // COMMENTAIRES VIDÉO : lecture ET écriture publiques (un visiteur d'un lien /watch commente sans le code\n    64\t  // du drive). Le contenu écrit est borné à { videoPath, name, text } sous pages/_comments/, rien de sensible.\n    65\t  if (name === 'video-comment') return true\n    66\t  const h = (req.headers && req.headers['x-zr-auth']) || (req.query && req.query.auth) || ''\n    67\t  if (typeof h === 'string' && h.length === API_SECRET.length) {\n    68\t    try { if (timingSafeEqual(Buffer.from(h), Buffer.from(API_SECRET))) return true } catch {}\n    69\t  }\n    70\t\n    71\t  // PARTAGE PUBLIC : une lecture page/tree anonyme doit désormais prouver qu'un partage a réellement été émis.\n    72\t  // Les anciens liens base64 restent acceptés uniquement quand leur cible correspond exactement au path demandé.\n    73\t  const method = (req.method || 'GET').toUpperCase()\n    74\t  if (name === 'page' && method === 'GET') {\n    75\t    const q = req.query || {}\n    76\t    const action = (q.action || '').toString()\n    77\t    const path = (q.path || '').toString()\n    78\t    const dir = (q.dir || '').toString()\n    79\t    const requested = action === 'read' && isShareTarget(inferShareKind(path), path) ? path\n    80\t      : action === 'tree' && isShareTarget('folder', dir) ? dir\n    81\t        // A placement must be inside the signed folder before page.js resolves it.\n    82\t        // page.js then re-checks the canonical target with this same token.\n    83\t        : action === 'resolve-link' && isShareTarget(inferShareKind(path), path) ? path\n    84\t        : ''\n    85\t    if (requested) return authorizeShareAccess((q.share || '').toString(), requested)\n    86\t  }\n    87\t  return false\n    88\t}\n    89\t\n    90\tconst routes = {\n    91\t  page: pageHandler,\n    92\t  img: imgHandler,\n    93\t  media: mediaHandler,\n    94\t  stream: streamHandler,\n    95\t  shard: shardHandler,\n    96\t  repos: reposHandler,\n    97\t  'upload-shard': uploadShardHandler,\n    98\t  publish: publishHandler,\n    99\t  state: stateHandler,\n   100\t  unfurl: unfurlHandler,\n   101\t  upload: uploadHandler,\n   102\t  hls: hlsHandler,\n   103\t  'hls-key': hlsKeyHandler,\n   104\t  'hls-download-info': hlsDownloadInfoHandler,\n   105\t  'hls-cli': hlsCliHandler,\n   106\t  'hls-download-script': hlsDownloadScriptHandler,\n   107\t  'upload-cmd': uploadCmdHandler,\n   108\t  'upload-vid': uploadVidHandler,\n   109\t  cmdlog: cmdlogHandler,\n   110\t  'media-key': mediaKeyHandler,\n   111\t  'raw-token': rawTokenHandler, // token de LECTURE des repos privés zenrayshards-* (SW vidéo + download) — gated comme media-key\n   112\t  'raw-proxy': rawProxyHandler, // <img> des posters privés (une balise img ne peut pas porter de header) — servi comme src DOM\n   113\t  'shelf-img': shelfImgHandler,   // télécharge une image et la stocke en repo public (jsDelivr)\n   114\t  'shelf-search': shelfSearchHandler, // recherche de posters via API média (RAWG/TMDB/AniList)\n   115\t  'spotify-search': spotifySearchHandler, // recherche catalogue Spotify (Client Credentials, app-only) pour ZenRay Audio\n   116\t  'youtube-search': youtubeSearchHandler, // recherche YouTube sans clé Google Cloud (endpoint innertube public)\n   117\t  'youtube-search-v3': youtubeSearchV3Handler, // recherche YouTube API officielle Data v3 (feature sidebar -> Create, clé requise)\n   118\t  doc: docHandler,                // lecture live read-only d'un .md (repo Memory/.claude) — Documents\n   119\t  tree: treeHandler,              // liste les .md d'un repo perso — mode « parcourir tout »\n   120\t  'video-comment': videoCommentHandler, // commentaires publics sous une vidéo (lecteur + page /watch)\n   121\t  'shared-media': sharedMediaHandler,   // déchiffre côté serveur une image publique+chiffrée -> octets clairs (fix partage image + source OG)\n   122\t  'share-cover': shareCoverHandler,  // mosaïque d'aperçu d'un dossier partagé, composée par le navigateur\n   123\t  'share-og': shareOgHandler,           // sert dist/index.html avec les balises Open Graph du média partagé (WhatsApp/Notion/iMessage)\n   124\t  'share-token': shareTokenHandler,     // émet/résout/révoque les jetons opaques de partage v1\n   125\t}\n   126\t\n   127\t// Vercel n'applique `export const config` que sur le fichier de fonction réellement déployé\n   128\t// (= ce routeur). media.js et upload-shard.js déclaraient un bodyParser à 8mb ; on relève donc\n   129\t// la limite ici à 8mb pour TOUT le routeur, sinon les uploads chunkés (parts 3 Mo) seraient\n   130\t// rejetés en 413. ATTENTION : la plateforme impose malgré tout un plafond effectif proche de 4,5 Mo ;\n   131\t// universalCapture conserve donc des parts de 3 Mo. Ne jamais relever CHUNK_SIZE en se fiant au « 8mb ».\n   132\t// Les autres routes ne sont pas impactées par une limite déclarative plus haute.\n   133\texport const config = { api: { bodyParser: { sizeLimit: '8mb' } } }\n   134\t\n   135\texport default async function handler(req, res) {\n   136\t  // Le segment dynamique est nommé `route` (fichier [...route].js) et NON `path`, pour ne PAS écraser\n   137\t  // le paramètre de requête ?path= utilisé par les handlers (img/shard/hls/stream/page read).\n   138\t  // Vercel expose le segment catch-all sous la clé \"...route\" (avec les 3 points), PAS \"route\".\n   139\t  // local-server.mjs, lui, injecte req.query.route. On lit donc les deux pour marcher des deux côtés.\n   140\t  let parts = req.query.route ?? req.query['...route']\n   141\t  if (typeof parts === 'string') parts = parts.split('/')\n   142\t  const name = Array.isArray(parts) ? parts[0] : parts\n   143\t  const target = name && routes[name]\n   144\t  if (!target) return res.status(404).json({ error: 'not-found', route: name || null })\n   145\t  if (!(await authOk(req, name))) return res.status(401).json({ error: 'unauthorized' })\n   146\t  return target(req, res)\n   147\t}\n"},{"type":"input_text","text":"===== server test patterns =====\n// L'adaptateur Cloudflare, éprouvé contre des handlers de trois lignes.\n//\n// Il ne sera jamais exécuté sur Cloudflare avant le jour où l'on bascule. Ces tests sont donc la\n// SEULE chose qui distingue un adaptateur qui marche d'un adaptateur qui a l'air de marcher, et\n// c'est pour cela qu'ils existent avant tout déploiement plutôt qu'après le premier incident.\nimport { describe, it, expect } from 'vitest'\nimport { adapterHandlerNode } from './_cloudflare-adapter.js'\n\nconst req = (url, init) => new Request(`https://exemple.test${url}`, init)\n\ndescribe('adaptateur Cloudflare', () => {\n  it('traduit une réponse JSON, son statut et ses en-têtes', async () => {\n    const handler = (rq, rs) => rs.status(201).setHeader('x-essai', 'oui').json({ ok: true, methode: rq.method })\n    const r = await adapterHandlerNode(handler, req('/api/page'))\n    expect(r.status).toBe(201)\n    expect(r.headers.get('x-essai')).toBe('oui')\n    expect(r.headers.get('content-type')).toContain('application/json')\n    expect(await r.json()).toEqual({ ok: true, methode: 'GET' })\n  })\n\n  it('expose la chaîne de requête sous forme d’objet, comme le fait Vercel', async () => {\n    const handler = (rq, rs) => rs.json(rq.query)\n    const r = await adapterHandlerNode(handler, req('/api/page?action=tree&dir=pages'))\n    expect(await r.json()).toEqual({ action: 'tree', dir: 'pages' })\n  })\n\n  it('décode un corps JSON, et laisse les binaires en octets', async () => {\n    const vuJson = await adapterHandlerNode((rq, rs) => rs.json(rq.body),\n      req('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{\"a\":1}' }))\n    expect(await vuJson.json()).toEqual({ a: 1 })\n\n    const vuBin = await adapterHandlerNode((rq, rs) => rs.json({ octets: rq.body.length, premier: rq.body[0] }),\n      req('/api/upload', { method: 'POST', headers: { 'content-type': 'application/octet-stream' }, body: new Uint8Array([7, 8, 9]) }))\n    expect(await vuBin.json()).toEqual({ octets: 3, premier: 7 })\n  })\n\n  it('ne lit jamais le corps d’un GET', async () => {\n    // Lire `json()` sur une requête sans corps jette ; l'adaptateur doit s'en abstenir plutôt que\n    // de rattraper l'erreur, sinon un GET malformé deviendrait indistinguable d'un GET normal.\n    const r = await adapterHandlerNode((rq, rs) => rs.json({ corps: rq.body === undefined }), req('/api/page'))\n    expect(await r.json()).toEqual({ corps: true })\n  })\n\n  it('STREAME : la réponse part avant que le handler ait fini d’écrire', async () => {\n    // C'est le cas qui justifie tout le fichier. `stream.js` et `shard.js` servent des médias\n    // déchiffrés au fil de l'eau ; si l'adaptateur attendait la fin, un flux de plusieurs centaines\n    // de mégaoctets deviendrait un tampon en mémoire et ferait tomber le Worker.\n    let libere = false\n    const handler = async (rq, rs) => {\n      rs.setHeader('content-type', 'text/plain')\n      rs.write('premier')\n      await new Promise((r) => setTimeout(r, 30))\n      libere = true\n      rs.write('-second')\n      rs.end()\n    }\n    const r = await adapterHandlerNode(handler, req('/api/stream'))\n    // La réponse existe DÉJÀ alors que le handler dort encore : c'est exactement ce qu'on veut.\n    expect(libere).toBe(false)\n    expect(r.headers.get('content-type')).toBe('text/plain')\n    expect(await r.text()).toBe('premier-second')\n    expect(libere).toBe(true)\n  })\n\n  it('rend un 500 lisible quand le handler jette avant d’avoir répondu', async () => {\n    const r = await adapterHandlerNode(() => { throw new Error('cassé') }, req('/api/page'))\n    expect(r.status).toBe(500)\n    expect((await r.json()).error).toContain('cassé')\n  })\n\n  it('ferme le flux quand le handler jette APRÈS avoir commencé à écrire', async () => {\n    // Sans cette fermeture, le client resterait suspendu sur une réponse qui ne se termine jamais,\n    // ce qui est pire qu'une erreur : une erreur se voit, une attente infinie passe pour de la\n    // lenteur.\n    const handler = (rq, rs) => { rs.write('debut'); throw new Error('coupé en vol') }\n    const r = await adapterHandlerNode(handler, req('/api/stream'))\n    expect(r.status).toBe(200)\n    expect(await r.text()).toBe('debut')\n  })\n\n  it('accepte plusieurs valeurs pour un même en-tête', async () => {\n    const handler = (rq, rs) => rs.setHeader('set-cookie', ['a=1', 'b=2']).end('')\n    const r = await adapterHandlerNode(handler, req('/api/page'))\n    expect(r.headers.get('set-cookie')).toContain('a=1')\n    expect(r.headers.get('set-cookie')).toContain('b=2')\n  })\n\n  it('expose statusCode et headersSent comme Node', async () => {\n    const vu = {}\n    const handler = (rq, rs) => {\n      vu.avant = rs.headersSent\n      rs.statusCode = 418\n      rs.end('')\n      vu.apres = rs.headersSent\n    }\n    const r = await adapterHandlerNode(handler, req('/api/page'))\n    expect(vu).toEqual({ avant: false, apres: true })\n    expect(r.status).toBe(418)\n  })\n\n  it('TRANSMET les paramètres de route, sans quoi le routeur ne trouve rien', async () => {\n    // La panne du premier déploiement Cloudflare, le 2026-07-31 : le routeur lit `req.query.route`,\n    // Vercel le remplit depuis le nom de fichier, Cloudflare le passe dans `context.params`, et\n    // l'adaptateur ne le transmettait pas. Tout répondait « not-found, route: null ».\n    const handler = (rq, rs) => rs.json({ route: rq.query.route, action: rq.query.action })\n    const r = await adapterHandlerNode(handler, req('/api/page?action=tree'), undefined, { route: ['page'] })\n    expect(await r.json()).toEqual({ route: ['page'], action: 'tree' })\n  })\n\n  it('rend un 304 SANS corps, sinon la plateforme rejette la réponse', async () => {\n    // Trouvé en production le 2026-08-01 : l'arborescence répondait 500 à toute requête conditionnelle,\n    // parce qu'un corps était attaché à un statut qui n'en admet pas. Conséquence invisible et chère :\n    // le client retombait sur les 3,16 Mo complets à chaque ouverture, le 304 ne servant jamais.\n    const r = await adapterHandlerNode((rq, rs) => rs.status(304).end(), req('/api/page?action=tree'))\n    expect(r.status).toBe(304)\n    expect(r.body).toBeNull()\n  })\n\n  it('rend un 204 sans corps, même règle', async () => {\n    const r = await adapterHandlerNode((rq, rs) => rs.status(204).end(), req('/api/x'))\n    expect(r.status).toBe(204)\n    expect(r.body).toBeNull()\n  })\n})\nimport { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'\nimport stream from '../../server/stream.js'\n\nconst manifest = {\n  type: 'audio',\n  mediaKind: 'audio',\