let i = 0; i < tries; i++) {\n    27\t    const pr = await gh(token, `repos/${OWNER}/${name}`)\n    28\t    if (pr.ok) {\n    29\t      const rr = await gh(token, `repos/${OWNER}/${name}/git/ref/heads/${SHARD_BRANCH}`)\n    30\t      if (rr.ok) return true\n    31\t    }\n    32\t    await sleep(delayMs)\n    33\t  }\n    34\t  return false\n    35\t}\n    36\t\n    37\tconst README_BODY = `# ZenRay media shard\n    38\t\n    39\tMagasin d'assets media **prive** de l'application ZenRay.\n    40\t\n    41\tCe depot fait partie d'un drive shorde facon Git-LFS : les fichiers binaires\n    42\t(images, chunks media) sont stockes sous des noms **hashes**, repartis sur\n    43\tplusieurs depots \\`zenray-media-NN\\` quand l'un d'eux approche la limite GitHub\n    44\t(~5 Go). L'etat de remplissage est suivi dans \\`pages/.zr-drive.json\\` du depot\n    45\t\\`zenray-data\\`.\n    46\t\n    47\tNe rien committer a la main ici : toutes les ecritures passent par l'API\n    48\tserveur de ZenRay (Git Data API). Editer ce depot manuellement peut corrompre\n    49\tle drive.\n    50\t`\n    51\t\n    52\t// README d'un shard PUBLIC (drive-7) : jumeau d'upload-shard.js PUBLIC_README_BODY. Un shard public ne doit\n    53\t// JAMAIS porter le texte « dépôt privé » ni laisser entendre qu'il est interne. Aucun nom humain ici non plus.\n    54\tconst PUBLIC_README_BODY = `# ZenRay public shard\n    55\t\n    56\tDepot **public** d'assets ZenRay.\n    57\t\n    58\tLes fichiers sont nommes par leur **empreinte SHA-256** (\\`ab/cd/<hash>.<ext>\\`) accompagnes\n    59\td'une vignette \\`.webp\\`, et servis via **jsDelivr** (cache immuable pinne sur le commit).\n    60\tAucun nom humain n'apparait : seuls des chemins hashes.\n    61\t\n    62\tQuand un shard approche ~5 Go, l'application en cree automatiquement un suivant. L'etat de\n    63\tremplissage est suivi dans un fichier d'etat du depot prive \\`zenray-data\\`.\n    64\t\n    65\tNe rien committer a la main ici : toutes les ecritures passent par l'API serveur (Git Data API).\n    66\t`\n    67\t\n    68\t// Écrase le README par défaut (créé par auto_init) par un README honnête. Best-effort.\n    69\t// drive-7 : choisit le corps selon la visibilité (pub => README public, sinon README privé), comme\n    70\t// ensureFamilyReadme d'upload-shard.js. Évite qu'un shard public se déclare « privé » sur une surface publique.\n    71\tasync function ensureShardReadme(token, name, pub = false) {\n    72\t  try {\n    73\t    let sha = null\n    74\t    const g = await gh(token, `repos/${OWNER}/${name}/contents/README.md?ref=${SHARD_BRANCH}`)\n    75\t    if (g.ok) { try { sha = (await g.json()).sha || null } catch {} }\n    76\t    const bodyText = pub ? PUBLIC_README_BODY : README_BODY\n    77\t    await ghRetry(() => gh(token, `repos/${OWNER}/${name}/contents/README.md`, {\n    78\t      method: 'PUT',\n    79\t      body: JSON.stringify({ message: 'shard: README', content: Buffer.from(bodyText, 'utf8').toString('base64'), branch: SHARD_BRANCH, ...(sha ? { sha } : {}) }),\n    80\t    }), { tries: 3, retryOn: (r) => r.status >= 500 || r.status === 409 })\n    81\t  } catch {}\n    82\t}\n    83\t\n    84\texport default async function handler(req, res) {\n    85\t  const token = process.env.GITHUB_TOKEN\n    86\t  if (!token) return res.status(200).json({ error: 'no-token' })\n    87\t  res.setHeader('Cache-Control', 'no-store')\n    88\t\n    89\t  // POST { action:'create-shard' } -> crée le prochain repo media privé zenray-media-NN\n    90\t  if (req.method === 'POST') {\n    91\t    let body = req.body; if (typeof body === 'string') { try { body = JSON.parse(body) } catch { body = {} } }\n    92\t    if (body && body.action === 'create-shard') {\n    93\t      try {\n    94\t        // {kind,vis} optionnels : crée le prochain repo de la famille zenray-<kind>-<vis>-NN.\n    95\t        // Défaut (sans kind/vis) = comportement historique : prochain zenray-media-NN privé.\n    96\t        const kind = body.kind ? String(body.kind) : 'img'\n    97\t        const vis = body.vis ? String(body.vis) : 'private'\n    98\t        const pub = vis === 'public'\n    99\t        // RENAME (objectif 1) : plus de cas legacy. Toute famille -> zenray-<kind>-<vis>-NN, y compris img/private\n   100\t        // (zenray-img-private-NN). On scanne le PREFIXE de la famille MAIS, pour img/private, on prend aussi en\n   101\t        // compte les anciens zenray-media-NN pour calculer NN (sinon on recréerait zenray-img-private-01 alors\n   102\t        // que zenray-media-07 existe déjà -> collision de numéro). parseShard normalise les deux noms.\n   103\t        const prefix = `zenray-${kind}-${vis}`\n   104\t        // drive-4 : NN est TOUJOURS >= 2 chiffres (schéma canonique shard-naming.js : \\d{2,}, shardName pad sur 2).\n   105\t        // L'ancienne famRe en \\d+ comptait d'éventuels repos à 1 chiffre que parseShard/shardRe rejettent : un\n   106\t        // repo « compté pour le numéro » mais « invisible partout ailleurs ». On aligne sur \\d{2,} : une seule vérité.\n   107\t        const famRe = new RegExp('^' + prefix.replace(/[-]/g, '\\\\-') + '-(\\\\d{2,})$')\n   108\t        const existing = []\n   109\t        for (let page = 1; page <= 5; page++) {\n   110\t          const r = await gh(token, `user/repos?per_page=100&page=${page}&affiliation=owner`)\n   111\t          if (!r.ok) break; const arr = await r.json(); if (!Array.isArray(arr) || !arr.length) break\n   112\t          for (const x of arr) {\n   113\t            const m = famRe.exec(x.name)\n   114\t            if (m) { existing.push(parseInt(m[1], 10)); continue }\n   115\t            // Legacy de la MÊME famille (zenray-media-NN = img/private) : compte aussi pour le numéro suivant.\n   116\t            const p = parseShard(x.name)\n   117\t            if (p && p.kind === kind && p.vis === vis) existing.push(p.n)\n   118\t          }\n   119\t          if (arr.length < 100) break\n   120\t        }\n   121\t        const nextN = (existing.length ? Math.max(...existing) : 0) + 1\n   122\t        const name = shardName(kind, vis, nextN)\n   123\t        const description = pub\n   124\t          ? 'ZenRay drive — shard PUBLIC (fichiers hashés SHA-256, servis via jsDelivr, aucun nom humain)'\n   125\t          : 'ZenRay drive — shard privé (fichiers hashés SHA-256)'\n   126\t        const cr = await ghRetry(\n   127\t          () => gh(token, 'user/repos', { method: 'POST', body: JSON.stringify({ name, private: !pub, description, auto_init: true }) }),\n   128\t          { tries: 4, retryOn: (r) => r.status >= 500 } // 422 (déjà existant) traité plus bas, pas de retry.\n   129\t        )\n   130\t        if (!cr || (!cr.ok && cr.status !== 422)) { const t = cr ? await cr.text() : 'network'; return res.status(200).json({ error: 'github', detail: String(t).slice(0, 160) }) }\n   131\t        // drive-3 : un 422 signifie « le repo existe déjà » (numérotation sous-évaluée, ex. shard hors fenêtre de\n   132\t        // pagination). On NE doit PAS le maquiller en « Créé » : on le rapporte tel quel (existed:true) pour que\n   133\t        // l'UI dise « Repo déjà présent » au lieu de mentir. Le README/branche existent déjà, rien d'autre à poser.\n   134\t        const existed = !!cr && cr.status === 422\n   135\t        if (existed) return res.status(200).json({ ok: true, name, existed: true })\n   136\t        // Attendre que la branche soit prête avant de poser le README (évite un 409 sur ref absente).\n   137\t        const ready = await waitShardReady(token, name)\n   138\t        if (!ready) return res.status(200).json({ error: 'github', detail: 'shard-not-ready' })\n   139\t        await ensureShardReadme(token, name, pub)\n   140\t        return res.status(200).json({ ok: true, name })\n   141\t      } catch (e) { return res.status(200).json({ error: 'fetch' }) }\n   142\t    }\n   143\t    return res.status(400).json({ error: 'bad-action' })\n   144\t  }\n   145\t  // GET ?action=tree&repo=<name>[&prefix=ab] : ARBORESCENCE d'un repo shard (objectif 2a), lecture seule.\n   146\t  //   - sans prefix : groupe les blobs par PRÉFIXE de 2 caractères (ab/) avec compte + octets par groupe,\n   147\t  //     + totaux + commit HEAD (pour pinner jsDelivr côté client). 1 seul appel git/trees?recursive=1.\n   148\t  //   - avec prefix : liste les feuilles (blobs) sous ce préfixe {path,size}. Si l'arbre complet était tronqué,\n   149\t  //     on va chercher le SOUS-ARBRE du préfixe par son sha (1 appel) au lieu du récursif complet.\n   150\t  // Petite op REST (lecture d'UN arbre) -> conforme à la règle BULK-via-git (jamais de boucle par fichier).\n   151\t  if (req.method === 'GET' && req.query && req.query.action === 'tree') {\n   152\t    try {\n   153\t      const repo = String(req.query.repo || '')\n   154\t      if (!shardRe.test(repo)) return res.status(200).json({ error: 'bad-repo' })\n   155\t      const prefix = req.query.prefix ? String(req.query.prefix) : null\n   156\t      const p = parseShard(repo)\n   157\t\n   158\t      // HEAD commit (pour pin jsDelivr) — pattern déjà utilisé pour waitShardReady.\n   159\t      const refR = await gh(token, `repos/${OWNER}/${repo}/git/ref/heads/${SHARD_BRANCH}`)\n   160\t      if (!refR.ok) return res.status(200).json({ error: 'github', detail: 'ref' })\n   161\t      const commit = (await refR.json()).object.sha\n   162\t\n   163\t      if (!prefix) {\n   164\t        // GROS REPO : le git tree RÉCURSIF peut être tronqué (>100k entrées / 7 Mo) OU échouer. On tente\n   165\t        // d'abord le récursif (compteurs exacts) ; en cas d'échec OU de troncature, on RETOMBE sur le tree\n   166\t        // RACINE non-récursif (≤256 dossiers de préfixe, toujours léger, jamais en erreur) : groupes SANS\n   167\t        // compteurs (lazy:true), les compteurs se calculent à l'ouverture d'un préfixe (drill-down).\n   168\t        const tr = await gh(token, `repos/${OWNER}/${repo}/git/trees/${SHARD_BRANCH}?recursive=1`)\n   169\t        let tj = tr.ok ? await tr.json() : null\n   170\t        if (tj && !tj.truncated) {\n   171\t          const blobs = (tj.tree || []).filter((x) => x.type === 'blob' && /^[0-9a-f]{2}\\//.test(x.path))\n   172\t          const groups = new Map()\n   173\t          let totalFiles = 0, totalBytes = 0\n   174\t          for (const b of blobs) {\n   175\t            const g = b.path.slice(0, 2)\n   176\t            const cur = groups.get(g) || { prefix: g, files: 0, bytes: 0 }\n   177\t            cur.files++; cur.bytes += Number(b.size || 0)\n   178\t            groups.set(g, cur)\n   179\t            totalFiles++; totalBytes += Number(b.size || 0)\n   180\t          }\n   181\t          const out = [...groups.values()].sort((a, b) => a.prefix.localeCompare(b.prefix))\n   182\t          return res.status(200).json({ ok: true, repo, kind: p?.kind || null, vis: p?.vis || null, private: p?.vis !== 'public', commit, truncated: false, totalFiles, totalBytes, groups: out })\n   183\t        }\n   184\t        // FALLBACK robuste : tree racine non-récursif (dossiers de préfixe seulement), compteurs lazy.\n   185\t        const rootR = await gh(token, `repos/${OWNER}/${repo}/git/trees/${commit}`)\n   186\t        if (!rootR.ok) return res.status(200).json({ error: 'github', detail: 'tree' })\n   187\t        const dirs = ((await rootR.json()).tree || []).filter((x) => x.type === 'tree' && /^[0-9a-f]{2}$/.test(x.path))\n   188\t        const out = dirs.map((d) => ({ prefix: d.path, files: null, bytes: null })).sort((a, b) => a.prefix.localeCompare(b.prefix))\n   189\t        return res.status(200).json({ ok: true, repo, kind: p?.kind || null, vis: p?.vis || null, private: p?.vis !== 'public', commit, truncated: true, lazy: true, totalFiles: null, totalBytes: null, groups: out })\n   190\t      }\n   191\t\n   192\t      // Feuilles sous un préfixe donné.\n   193\t      if (!/^[0-9a-f]{2}$/.test(prefix)) return res.status(200).json({ error: 'bad-prefix' })\n   194\t      // 1) trouver le sha du sous-arbre <prefix> à la racine (1 appel non récursif).\n   195\t      const rootR = await gh(token, `repos/${OWNER}/${repo}/git/trees/${commit}`)\n   196\t      if (!rootR.ok) return res.status(200).json({ error: 'github', detail: 'root-tree' })\n   197\t      const rootEntry = ((await rootR.json()).tree || []).find((x) => x.type === 'tree' && x.path === prefix)\n   198\t      if (!rootEntry) return res.status(200).json({ ok: true, repo, prefix, commit, files: [] })\n   199\t      // 2) sous-arbre récursif du préfixe (petit : 1/256e du repo).\n   200\t      const subR = await gh(token, `repos/${OWNER}/${repo}/git/trees/${rootEntry.sha}?recursive=1`)\n   201\t      if (!subR.ok) return res.status(200).json({ error: 'github', detail: 'sub-tree' })\n   202\t      const sj = await subR.json()\n   203\t      const files = (sj.tree || []).filter((x) => x.type === 'blob').map((x) => ({ path: `${prefix}/${x.path}`, size: Number(x.size || 0) }))\n   204\t      return res.status(200).json({ ok: true, repo, prefix, commit, truncated: !!sj.truncated, files })\n   205\t    } catch (e) { return res.status(200).json({ error: 'fetch' }) }\n   206\t  }\n   207\t\n   208\t  try {\n   209\t    // tous les repos du compte (paginé), on garde ceux du drive ZenRay\n   210\t    const repos = []\n   211\t    for (let page = 1; page <= 5; page++) {\n   212\t      const r = await gh(token, `user/repos?per_page=100&page=${page}&affiliation=owner`)\n   213\t      if (!r.ok) break\n   214\t      const arr = await r.json()\n   215\t      if (!Array.isArray(arr) || !arr.length) break\n   216\t      for (const x of arr) repos.push(x)\n   217\t      if (arr.length < 100) break\n   218\t    }\n   219\t    // Affichage : 'video-cdn' pour les shards vidéo, 'media' pour tout autre shard (img/audio/doc/table/markdown),\n   220\t    // 'content' pour zenray-data, 'app' sinon. parseShard couvre nouveau schéma ET legacy.\n   221\t    const driveKind = (name) =