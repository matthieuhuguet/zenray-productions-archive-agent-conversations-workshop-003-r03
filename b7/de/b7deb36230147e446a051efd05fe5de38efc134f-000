wnloadScriptHandler from '../server/hls-download-script.js'\n    21\timport uploadCmdHandler from '../server/upload-cmd.js'\n    22\timport uploadVidHandler from '../server/upload-vid.js'\n    23\timport cmdlogHandler from '../server/cmdlog-api.js'\n    24\timport mediaKeyHandler from '../server/media-key.js'\n    25\timport rawTokenHandler from '../server/raw-token.js'\n    26\timport rawProxyHandler from '../server/raw-proxy.js'\n    27\timport shelfImgHandler from '../server/shelf-img.js'\n    28\timport shelfSearchHandler from '../server/shelf-search.js'\n    29\timport spotifySearchHandler from '../server/spotify-search.js'\n    30\timport youtubeSearchHandler from '../server/youtube-search.js'\n    31\timport youtubeSearchV3Handler from '../server/youtube-search-v3.js'\n    32\timport docHandler from '../server/doc.js'\n    33\timport treeHandler from '../server/tree.js'\n    34\timport videoCommentHandler from '../server/video-comment.js'\n    35\timport sharedMediaHandler from '../server/shared-media.js'\n    36\timport shareOgHandler from '../server/share-og.js'\n    37\timport shareCoverHandler from '../server/share-cover.js'\n    38\timport shareTokenHandler, { authorizeShareAccess, inferShareKind, isShareTarget } from '../server/share-token.js'\n    39\timport { timingSafeEqual } from 'node:crypto'\n    40\t\n    41\t// GATE APPLICATIF (sécurité, audit famille A). Quand ZENRAY_API_SECRET est défini (prod), chaque appel /api/*\n    42\t// SENSIBLE doit porter le header `x-zr-auth: <secret>` (sinon 401). Ça remplace la dépendance au seul toggle\n    43\t// Vercel : la clé maître (media-key), les écritures (page/upload-*/publish/state) et la gestion de repos sont\n    44\t// fermées par défaut. EXEMPTÉS : les endpoints servis comme src DOM (<img>/<video>/hls.js) qui NE PEUVENT PAS\n    45\t// porter de header custom — leur contenu est chiffré sur CDN public ou derrière la protection de déploiement.\n    46\t// Si ZENRAY_API_SECRET est ABSENT (dev local, serveur loopback) -> gate DÉSACTIVÉ, rien ne change.\n    47\tconst API_SECRET = process.env.ZENRAY_API_SECRET || ''\n    48\t// raw-proxy est EXEMPTÉ du gate (servi comme src DOM <img>, ne peut pas porter x-zr-auth) : il ne sert que\n    49\t// des binaires pinnés par commit du compte owner (posters), pas de secret. raw-token, lui, RESTE gated\n    50\t// (même surface que media-key : servi au client authentifié uniquement quand le gate est actif).\n    51\t// Une balise DOM ne peut pas envoyer x-zr-auth, mais elle ne demande jamais une écriture.\n    52\t// Les routes publiques sont donc explicitement limitées à GET/HEAD. En particulier, `media`\n    53\t// n'est jamais ici : ses trois actions écrivent des blobs ou un manifeste GitHub.\n    54\tconst PUBLIC_READ_ROUTES = new Set(['img', 'stream', 'shard', 'hls', 'hls-key', 'hls-download-info', 'hls-cli', 'hls-download-script', 'shared-media', 'share-og', 'share-cover', 'raw-proxy', 'spotify-search', 'youtube-search', 'youtube-search-v3'])\n    55\texport const isPublicReadRoute = (req, name) => ['GET', 'HEAD'].includes(String(req.method || 'GET').toUpperCase()) && PUBLIC_READ_ROUTES.has(name)\n    56\t\n    57\texport async function authOk(req, name) {\n    58\t  if (!API_SECRET) return true\n    59\t  if (isPublicReadRoute(req, name)) return true\n    60\t  // La résolution d'un jeton de partage est publique. Son émission et sa révocation restent protégées par\n    61\t  // x-zr-auth, comme toutes les écritures de l'app.\n    62\t  if (name === 'share-token' && (req.method || 'GET').toUpperCase() === 'GET') return true\n    63\t  // COMMENTAIRES VIDÉO : lecture ET écriture publiques (un visiteur d'un lien /watch commente sans le code\n    64\t  // du drive). Le contenu écrit est borné à { videoPath, name, text } sous pages/_comments/, rien de sensible.\n    65\t  if (name === 'video-comment') return true\n    66\t  const h = (req.headers && req.headers['x-zr-auth']) || (req.query && req.query.auth) || ''\n    67\t  