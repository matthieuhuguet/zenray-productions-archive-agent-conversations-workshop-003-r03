| note !== (task.note || '') }\n  const onCommitRef = useRef(onCommit)\n  onCommitRef.current = onCommit\n  useEffect(() => () => {\n    const draft = draftRef.current\n    if (draft.changed) onCommitRef.current({ title: draft.title.trim() || 'Untitled', note: draft.note })\n  }, [])\n  const commitNow = () => {\n    const draft = draftRef.current\n    if (draft.changed) onCommit({ title: draft.title.trim() || 'Untitled', note: draft.note })\n  }\n  const status = statusOf(task, today)\n  const images = imagesOf(task)\n  const deletable = canDeleteTask(task)\n  // Le titre suit EXACTEMENT le verrou d'engagement de la corbeille, pas une règle à lui : si une tâche\n  // de plus de quatre heures ne peut plus être supprimée, la renommer serait la même échappatoire par\n  // un autre chemin. En deçà, l'erreur de frappe se corrige librement.\n  const refuseTitle = () => {\n    const el = titleInputRef.current\n    if (!el || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return\n    // ANIMATION PILOTÉE, PAS UNE CLASSE CSS. Rejouer une animation par ajout et retrait de classe\n    // demande de laisser passer une image entre les deux, donc un `requestAnimationFrame`, donc un\n    // état React et un minuteur à nettoyer : quatre pièces mobiles pour un clignotement. L'API\n    // d'animation le fait en un appel, et surtout elle se MESURE (`el.getAnimations()`), alors\n    // qu'une classe posée pendant une frame ne se vérifie pas.\n    // `cancel()` avant de rejouer : sans lui, un second refus pendant le clignotement ne produit\n    // rien du tout, et l'interface paraît morte au moment précis où elle doit répondre.\n    for (const a of el.getAnimations()) a.cancel()\n    el.animate(\n      [{ opacity: 1, filter: 'none' }, { opacity: 0.5, filter: 'contrast(0.4)' }, { opacity: 1, filter: 'none' }],\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019fb96c-aed5-7df1-86c4-15e2ad76354e"}}}
