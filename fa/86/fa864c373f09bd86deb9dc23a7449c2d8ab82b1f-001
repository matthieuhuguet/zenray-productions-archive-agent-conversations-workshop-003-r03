r (const list of map.values()) {\n      list.sort((a, b) => (a.startTime || '99:99').localeCompare(b.startTime || '99:99'))\n    }\n    return map\n  }, [board])\n  // La pile Missed deadlines REPART À NEUF chaque mois (retour Matthieu 2026-07-20) : seules les\n  // échéances manquées du MOIS CALENDAIRE COURANT s'accumulent ici -- celles des mois précédents\n  // restent orange dans leurs cellules, mais ne hantent plus la boîte de réception indéfiniment.\n  const monthStartIso = `${today.slice(0, 7)}-01`\n  const overdueTasks = useMemo(() => (board?.tasks || []).filter((task) => statusOf(task, today).key === 'late' && task.date >= monthStartIso), [board, today, monthStartIso])\n\n  // Garde de séquence (2026-07-20, la moitié serveur du bug \"l'écriture se désagrège\") : le résultat\n  // d'un save GitHub (1-2 s de round-trip) ne ré-écrase le board QUE s'il est encore le plus récent --\n  // sinon un res.data périmé annulait les modifications faites pendant le vol (frappes, coche, rescue).\n  const saveSeqRef = useRef(0)\n  const persist = (mutateFn) => {\n    setBoard((prev) => mutateFn(prev || emptyBoard()))\n    const seq = ++saveSeqRef.current\n    saveJsonWithRetry(path, (cur) => mutateFn(cur && cur.type === 'plan' ? cur : emptyBoard()))\n      .then((res) => { if (res.ok && seq === saveSeqRef.current) setBoard(res.data) })\n  }\n  const updateTask = (taskId, patch) => persist((cur) => ({ ...cur, tasks: cur.tasks.map((tk) => (tk.id === taskId ? { ...tk, ...patch } : tk)) }))\n\n  // ── Bloc de détail Lego Fusion 2x2 -- chorégraphie et timings EXACTS de la référence ──────────────\n/* ── Anthropic Fonts ───────────────────────────────────────────── */\n\n@font-face {\n  font-family: 'AnthropicSans';\n  src: url('/fonts/AnthropicSans-Romans.woff2') format('woff2'),\n       url('/fonts/AnthropicSans.ttf') format('truetype');\n  font-weight: 100 900;\n  font-style: normal;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: 'AnthropicSans';\n  src: url('/fonts