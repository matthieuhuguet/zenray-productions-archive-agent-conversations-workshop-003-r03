 cursor: pointer; background-size: cover; background-position: center; background-color: color-mix(in srgb, var(--g9-fg) 8%, transparent); transition: filter .16s ease; }\n.zrp-image-picker-grid button:hover { filter: brightness(1.12); }\n.zrp-image-picker-note { grid-column: 1 / -1; padding: 8px 2px; color: var(--g9-muted); font-size: 12px; font-weight: 300; }\n\n.zrp-loading { padding: 40px; text-align: center; color: var(--g9-muted); font-size: 12px; font-weight: 300; }\n\n@media (max-width: 900px) {\n  .zrp-toolbar { grid-template-columns: 1fr auto; }\n  .zrp-nav { grid-column: 1/-1; grid-row: 2; justify-content: center; }\n  .zrp-day { min-height: 104px; }\n}\n@media (max-width: 720px) {\n  .zrp-popover { position: fixed; left: 10px; right: 10px; top: auto; bottom: 12px; width: auto; }\n  .zrp-schedule-row { grid-template-columns: 1fr; }\n  .zrp-selected-date { min-width: 124px; padding-inline: 10px; font-size: 12px; }\n}\n\n/* Vue \"un jour = un slot plein écran\" (mobile, retour Matthieu 2026-07-20 : la grille 7 colonnes du\n   mois entier était illisible en dessous de 680px, cellules quasi vides). Remplace ENTIÈREMENT\n   .zrp-calendar sous 680px -- pas une variante compactée de la grille, une piste horizontale à\n   ancrage (scroll-snap) où chaque jour de buildMonthGrid occupe 100% de la largeur. La navigation\n   Today/‹ › du toolbar (stepDay/goToday, INCHANGÉE) reste la source de vérité de `selectedIso` ; un\n   effet React scrolle la piste jusqu'au jour sélectionné, et le swipe manuel remonte l'info dans\n   l'autre sens (onStripScroll -> setSelectedIso) -- synchro bidirectionnelle, voir PlanBoard.jsx. */\n.zrp-mobile-days { display: none; }\n@media (max-width: 680px) {\n  .zrp-shell { padding: 10px; }\n  .zrp-stage { padding: 7px; border-radius: 23px; }\n  .zrp-toolbar { gap: 8px; padding: 0 4px 8px; }\n  .zrp-brand { font-size: 13px; }\n  .zrp-detail-title { font-size: 15px; }\n  .zrp-overdue-dock { padding: 8px; border-radius: 15px; }\n\n  .zrp-calend