ing-right: 25px; }\nsrc/create/PlanBoard.css:458:.zrp-task-time { flex: 0 0 auto; font-size: 10.5px; font-weight: 500; font-variant-numeric: tabular-nums;\nsrc/create/PlanBoard.css:519:  .zrp-score-value { min-width: 30px; padding-inline: 9px; }\nsrc/create/PlanBoard.css:540:  .zrp-mobile-day-tasks .zrp-task { min-height: 46px; padding: 10px 11px; font-size: 13.5px; }\nsrc/create/PlanBoard.css:541:  .zrp-mobile-day-tasks .zrp-task-title { -webkit-line-clamp: 3; font-size: 13.5px; }\nsrc/create/PlanBoard.css:545:@media (prefers-reduced-motion: reduce) {\n.zrp-popover-row { display: flex; align-items: center; justify-content: flex-end; gap: 8px; margin-top: 12px; }\n.zrp-add { min-width: 68px; }\n\n.zrp-menu-item { width: 100%; min-height: 36px; display: flex; align-items: center; justify-content: space-between; padding: 0 9px; border: 0; border-radius: 10px; color: var(--g9-fg); background: transparent; font-size: 12px; font-weight: 300; cursor: pointer; }\n.zrp-menu-item:hover { background: color-mix(in srgb, var(--g9-fg) 8%, transparent); }\n.zrp-switch { width: 28px; height: 17px; padding: 2px; border-radius: 999px; background: var(--g9-soft); }\n.zrp-switch::after { content: ''; display: block; width: 13px; height: 13px; border-radius: 50%; background: #fff; transition: transform .16s ease; }\n.zrp-menu-item.zrp-on .zrp-switch { background: var(--zrp-blue); }\n.zrp-menu-item.zrp-on .zrp-switch::after { transform: translateX(11px); }\n\n/* Calendrier : liseré complet, pas d'ombre (override tardif de la référence). */\n.zrp-calendar {\n  position: relative; overflow: hidden; border-radius: 22px; background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));\n  box-shadow: var(--zrp-rim);\n}\n.zrp-weekdays { display: grid; grid-template-columns: repeat(7,1fr); padding: 10px 8px 7px; }\n.zrp-weekdays span { padding: 0 9px; color: var(--g9-soft); font-size: 12px; font-weight: 400; text-transform: uppercase; letter-spacing: .08em; }\n.zrp-grid { position: relative; display: grid; grid-template-columns: repeat(7, minmax(0,1fr)); gap: 7px; padding: 0 8px 8px; }\n\n/* Case du jour : fond verre PERMANENT (pas seulement au survol) + liseré haut/bas SANS côtés ni ombre\n   -- exactement l'override .v11-plan-day du bloc feedback-polish de la référence. */\n.zrp-day {\n  position: relative; min-height: 126px; padding: 9px; border: 0; border-radius: 17px; color: var(--g9-fg);\n  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));\n  box-shadow: var(--g9-outer-line), inset 0 1px 0 var(--g9-rim-main), inset 0 -1px 0 var(--g9-rim-main),\n    inset 0 2px 0 var(--g9-rim-soft), inset 0 -2px 0 var(--g9-rim-soft);\n  cursor: pointer; text-align: left; transition: filter .16s ease, opacity 150ms ease, transform 150ms cubic-bezier(.16,1,.3,1);\n}\n.zrp-day:hover { filter: brightness(1.06); }\n.zrp-day.zrp-selected { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--zrp-blue) 68%, transparent), inset 0 1px 0 var(--g9-rim-main), inset 0 -1px 0 var(--g9-rim-main); }\n.zrp-day.zrp-outside { opacity: .34; }\n.zrp-day.zrp-today .zrp-day-num { background: var(--zrp-blue); color: #fff; }\n.zrp-day.zrp-absorbed { opacity: 0; pointer-events: none; transform: scale(.985); }\n.zrp-day-num { width: 25px; height: 25px; display: grid; place-items: center; border-radius: 999px; font-size: 12px; font-weight: 400; color: var(--g9-muted); }\n.zrp-day-tasks { display: grid; gap: 5px; margin-top: 7px; }\n\n/* Tuile de tâche neutre : liseré volontairement ASYMÉTRIQUE (rim-main haut, rim-soft bas -- override\n   .v11-plan-goal de la référence), qui la distingue des tuiles colorées (symétriques 4 côtés). */\n.zrp-task {\n  /* align-items/align-content: center (retour Matthieu 2026-07-20) : la pastille de check (et sa ligne)\n     est centrée VERTICALEMENT dans la tuile, toujours alignée à gauche -- plus collée en haut à gauche\n     comme le align-items:start du premier passage. */\n  position: relative; display: grid; grid-template-columns: 15px minmax(0,1fr); align-items: center; align-content: center; gap: 5px;\n  min-height: 38px; padding: 6px 7px; overflow: hidden; border: 0; border-radius: 10px; width: 100%;\n  color: var(--g9-fg); background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b)); font-size: 12px; font-weight: 400;\n  text-align: left; cursor: pointer;\n  box-shadow: var(--g9-outer-line), inset 0 1px 0 var(--g9-rim-main), inset 0 -1px 0 var(--g9-rim-soft);\n}\n.zrp-task:hover { filter: brightness(1.06); }\n.zrp-task input[type=\"checkbox\"] { appearance: none; width: 14px; height: 14px; margin: 0; border-radius: 999px; border: 1px solid var(--g9-soft); display: grid; place-items: center; cursor: pointer; }\n.zrp-task input[type=\"checkbox\"]:checked { border-color: var(--zrp-green); background: var(--zrp-green); }\n.zrp-task input[type=\"checkbox\"]:checked::after { content: '✓'; font-size: 9px; color: #fff; line-height: 1; }\n/* LE TITRE PREND TOUTE LA LARGEUR DÈS QU'UNE HEURE EST AFFICHÉE (régression corrigée le 2026-08-01).\n   `.zrp-task` est une grille à DEUX colonnes, `15px` pour la case à cocher et le reste pour le titre.\n   En ajoutant l'heure comme troisième enfant le 2026-07-30, je n'ai pas touché à la grille : la case\n   prenait la colonne 1, l'heure la colonne 2, et le titre repartait à la ligne DANS LA COLONNE DE\n   15 px. D'où des capsules affichant une lettre par ligne suivie de points de suspension, symptôme\n   qui ressemblait à une troncature du texte alors que c'était un défaut de placement.\n   `:has()` plutôt qu'une règle constante : sans heure, les enfants ne sont que deux et le titre doit\n   rester à droite de la case, sur la même ligne. La règle est donc conditionnelle, comme le cas. */\n.zrp-task:has(.zrp-task-time) .zrp-task-title { grid-column: 1 / -1; }\n.zrp-task-title { display: -webkit-box; overflow: hidden; text-overflow: ellipsis; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-height: 1.22; letter-spacing: -.005em; }\n\n/* 3 états couleur (jamais d'autre) : vert = terminé à temps, violet = terminé en retard, orange = en\n   retard non terminé. Liseré SYMÉTRIQUE 4 côtés pour les 3 (\"no left notch\", v13). */\n.zrp-task.zrp-done, .zrp-task.zrp-late-complete, .zrp-task.zrp-late { box-shadow: var(--zrp-rim); }\n.zrp-task.zrp-done {\n  padding-right: 27px;\n  background: linear-gradient(135deg, color-mix(in srgb, var(--zrp-green) 28%, var(--g9-glass-a)), color-mix(in srgb, var(--zrp-green) 17%, var(--g9-glass-b)));\n}\n.zrp-task.zrp-done::after { content: '✦'; position: absolute; right: 9px; top: 50%; transform: translateY(-50%); font-size: 11px; color: color-mix(in srgb, var(--zrp-green) 78%, white); }\n.zrp-task.zrp-late-complete {\n  padding-right: 7px;\n  background: linear-gradient(135deg, color-mix(in srgb, var(--zrp-violet) 27%, var(--g9-glass-a)), color-mix(in srgb, var(--zrp-violet) 16%, var(--g9-glass-b)));\n}\n.zrp-task.zrp-late {\n  background: linear-gradient(135deg, color-mix(in srgb, var(--zrp-orange) 34%, var(--g9-glass-a)), color-mix(in srgb, var(--zrp-orange) 22%, var(--g9-glass-b)));\n}\n.zrp-task.zrp-late input[type=\"checkbox\"] { border-color: color-mix(in srgb, var(--zrp-orange) 72%, white); }\n/* Publication : planifiée = fond ROSE pâle (même recette color-mix que les tuiles vert/violet),\n   dépassée = ROUGE pâle (remplace l'orange pour ces tâches spéciales), liseré symétrique. */\n.zrp-task.zrp-publish, .zrp-task.zrp-publish-late { box-shadow: var(--zrp-rim); }\n.zrp-task.zrp-publish {\n  background: linear-gradient(135deg, color-mix(in srgb, var(--zrp-pink) 26%, var(--g9-glass-a)), color-mix(in srgb, var(--zrp-pink) 15%, var(--g9-glass-b)));\n}\n.zrp-task.zrp-publish-late {\n  background: linear-gradient(135deg, color-mix(in srgb, var(--zrp-red) 32%, var(--g9-glass-a)), color-mix(in srgb, var(--zrp-red) 20%, var(--g9-glass-b)));\n}\n.zrp-task.zrp-publish-late input[type=\"checkbox\"] { border-color: color-mix(in srgb, var(--zrp-red) 72%, white); }\n/* Publ